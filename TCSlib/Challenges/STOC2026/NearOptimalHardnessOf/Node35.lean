/-!
## Hardness for fully regular k-partite k-CSPs

Starting from k-partite hardness, one (i) duplicates every constraint `q`
times, with `q = ⌈k² R^{3k}⌉`, (ii) for each part `V_i` in turn replaces each
vertex `v` by a cloud given by a `q`-regular bipartite expander between the
`deg(v)` constraint occurrences at `v` and `deg(v)` new vertices, which makes
part `i` `q`-regular, multiplies other degrees by `q`, preserves completeness
and loses at most `C√(R^{k-1}/q)` in soundness (expander mixing +
Cauchy–Schwarz), and (iii) balances the partwise regular result by taking
`d_i` copies of each vertex in part `i` and all index vectors, giving common
degree `∏ d_i` and exactly the same value.

Main theorem: `TCSChallenge.NearOptimalHardnessOfApproximatingKCSP.node_35.fully_regular_gap_core`.
-/

namespace TCSChallenge.NearOptimalHardnessOfApproximatingKCSP.node_35

/-- A k-partite k-CSP: parts `V 0, …, V (k-1)`, constraints indexed by `E`
(multiplicities = repeated indices), each with one vertex from each part and a
predicate on `Alph^k`. -/
structure PCSP (k : ℕ) (V : Fin k → Type) (E Alph : Type) where
  scope : E → (j : Fin k) → V j
  pred : E → (Fin k → Alph) → Bool

variable {k : ℕ}

/-- Constraint `e` is satisfied by the assignment `A`. -/
def Sat {V : Fin k → Type} {E Alph : Type} (I : PCSP k V E Alph)
    (A : (j : Fin k) → V j → Alph) (e : E) : Prop :=
  I.pred e (fun j => A j (I.scope e j)) = true

/-- `val_A(Ψ)`: the fraction of constraints satisfied by `A`. -/
def satFrac {V : Fin k → Type} {E Alph : Type} [Fintype E] (I : PCSP k V E Alph)
    (A : (j : Fin k) → V j → Alph) : ℝ :=
  ((Finset.univ.filter (fun e => Sat I A e)).card : ℝ) / (Fintype.card E : ℝ)

/-- `val(Ψ) ≥ c`. -/
def ValAtLeast {V : Fin k → Type} {E Alph : Type} [Fintype E] (I : PCSP k V E Alph)
    (c : ℝ) : Prop :=
  ∃ A : (j : Fin k) → V j → Alph, c ≤ satFrac I A

/-- `val(Ψ) ≤ s`. -/
def ValAtMost {V : Fin k → Type} {E Alph : Type} [Fintype E] (I : PCSP k V E Alph)
    (s : ℝ) : Prop :=
  ∀ A : (j : Fin k) → V j → Alph, satFrac I A ≤ s

/-- Degree of `v ∈ V_j`, counting constraint multiplicities. -/
def deg {V : Fin k → Type} {E Alph : Type} [Fintype E] (I : PCSP k V E Alph)
    (j : Fin k) (v : V j) : ℕ :=
  (Finset.univ.filter (fun e => I.scope e j = v)).card

/-- "fully regular if every vertex in V has the same degree". -/
def FullyRegular {V : Fin k → Type} {E Alph : Type} [Fintype E] (I : PCSP k V E Alph) :
    Prop :=
  ∃ D : ℕ, ∀ (j : Fin k) (v : V j), deg I j v = D

/-- Partwise regular with degree `d j` on part `j`. -/
def PartwiseRegular {V : Fin k → Type} {E Alph : Type} [Fintype E] (I : PCSP k V E Alph)
    (d : Fin k → ℕ) : Prop :=
  ∀ (j : Fin k) (v : V j), deg I j v = d j

/-- `Ω` is a uniform cover of `Ψ`: vertex maps `φ_j` and a constraint map `ψ`
preserving scopes and predicates, every constraint of `Ψ` having exactly `N > 0`
preimages. -/
def IsUniformCover {V V' : Fin k → Type} {E E' Alph : Type} [Fintype E']
    (Ω : PCSP k V' E' Alph) (Ψ : PCSP k V E Alph) : Prop :=
  ∃ (φ : (j : Fin k) → V' j → V j) (ψ : E' → E) (N : ℕ), 0 < N ∧
    (∀ (e' : E') (j : Fin k), φ j (Ω.scope e' j) = Ψ.scope (ψ e') j) ∧
    (∀ e' : E', Ω.pred e' = Ψ.pred (ψ e')) ∧
    ∀ e : E, (Finset.univ.filter (fun e' => ψ e' = e)).card = N

/-- Fact 2 (existence part): "whenever N ≥ D ≥ 2, a D-regular bipartite graph H
with N vertices on each side … satisfies |e_H(X,Y) − D|X||Y|/N| ≤ C√(D|X||Y|)". -/
def ExpanderFact (C : ℝ) : Prop :=
  ∀ N D : ℕ, 2 ≤ D → D ≤ N →
    ∃ H : Fin N → Fin N → Bool,
      (∀ x, (Finset.univ.filter (fun y => H x y = true)).card = D) ∧
      (∀ y, (Finset.univ.filter (fun x => H x y = true)).card = D) ∧
      ∀ X Y : Finset (Fin N),
        |(((X ×ˢ Y).filter (fun p => H p.1 p.2 = true)).card : ℝ)
            - (D : ℝ) * X.card * Y.card / N|
          ≤ C * Real.sqrt ((D : ℝ) * X.card * Y.card)

/-! ## Duplication -/

/-- Duplicate every constraint `q` times. -/
def dup {V : Fin k → Type} {E Alph : Type} (I : PCSP k V E Alph) (q : ℕ) :
    PCSP k V (E × Fin q) Alph where
  scope := fun p => I.scope p.1
  pred := fun p => I.pred p.1

/-- Duplication preserves every satisfaction fraction and multiplies degrees by `q`. [NearOptimalHardnessOf, node_35] -/
theorem dup_spec {V : Fin k → Type} {E Alph : Type} [Fintype E] (I : PCSP k V E Alph)
    (q : ℕ) (hq : 0 < q) :
    (∀ A, satFrac (dup I q) A = satFrac I A) ∧
    ∀ (j : Fin k) (v : V j), deg (dup I q) j v = q * deg I j v := by
  sorry

/-! ## One-part expander cloud replacement -/

/-- Cloud vertices: `v ∈ V_j` is replaced by `{v} × Fin (n j v)`. -/
abbrev CloudVert {V : Fin k → Type} (n : (j : Fin k) → V j → ℕ) (j : Fin k) : Type :=
  Σ v : V j, Fin (n j v)

/-- New constraints `e_u`: an old constraint `e` together with, for each part,
a cloud vertex adjacent (in the expander of that vertex) to the occurrence `e`. -/
abbrev CloudEdge {V : Fin k → Type} {E Alph : Type} (I : PCSP k V E Alph)
    (n : (j : Fin k) → V j → ℕ) (H : (j : Fin k) → (v : V j) → E → Fin (n j v) → Bool) :
    Type :=
  {p : Σ e : E, ((j : Fin k) → Fin (n j (I.scope e j))) //
    ∀ j : Fin k, H j (I.scope p.1 j) p.1 (p.2 j) = true}

/-- The cloud replacement instance; constraint `e_u` keeps the predicate of `e`. -/
def cloudReplace {V : Fin k → Type} {E Alph : Type} (I : PCSP k V E Alph)
    (n : (j : Fin k) → V j → ℕ) (H : (j : Fin k) → (v : V j) → E → Fin (n j v) → Bool) :
    PCSP k (CloudVert n) (CloudEdge I n H) Alph where
  scope := fun p j => ⟨I.scope p.1.1 j, p.1.2 j⟩
  pred := fun p => I.pred p.1.1

/-- The cloud data replaces only part `i`, by a `q`-regular bipartite expander
`H_v` between the `m_v = deg(v)` occurrences at `v` and `m_v` cloud vertices
satisfying the mixing inequality with constant `C`; other parts are unchanged
(one cloud vertex, adjacent to everything). -/
def OnePartSpec {V : Fin k → Type} {E Alph : Type} [Fintype E] (I : PCSP k V E Alph)
    (i : Fin k) (q : ℕ) (C : ℝ) (n : (j : Fin k) → V j → ℕ)
    (H : (j : Fin k) → (v : V j) → E → Fin (n j v) → Bool) : Prop :=
  (∀ j : Fin k, j ≠ i → ∀ v : V j, n j v = 1 ∧ ∀ e u, H j v e u = true) ∧
  (∀ v : V i, n i v = deg I i v) ∧
  (∀ (v : V i) (e : E), I.scope e i = v →
      (Finset.univ.filter (fun u => H i v e u = true)).card = q) ∧
  (∀ (v : V i) (u : Fin (n i v)),
      (Finset.univ.filter (fun e => I.scope e i = v ∧ H i v e u = true)).card = q) ∧
  ∀ (v : V i) (X : Finset E) (Y : Finset (Fin (n i v))), (∀ e ∈ X, I.scope e i = v) →
    |(((X ×ˢ Y).filter (fun p => H i v p.1 p.2 = true)).card : ℝ)
        - (q : ℝ) * X.card * Y.card / (n i v : ℝ)|
      ≤ C * Real.sqrt ((q : ℝ) * X.card * Y.card)

/-- Rubric 1: if every vertex of part `i` has degree `≥ q ≥ 2`, Fact 2 provides
cloud data meeting `OnePartSpec`. [NearOptimalHardnessOf, node_35] -/
theorem onePart_spec_exists {V : Fin k → Type} {E Alph : Type} [Fintype E]
    (I : PCSP k V E Alph) (i : Fin k) (q : ℕ) (hq : 2 ≤ q) (C : ℝ)
    (hexp : ExpanderFact C) (hdeg : ∀ v : V i, q ≤ deg I i v) :
    ∃ (n : (j : Fin k) → V j → ℕ) (H : (j : Fin k) → (v : V j) → E → Fin (n j v) → Bool),
      OnePartSpec I i q C n H := by
  sorry

/-- Rubric 1: degrees after one-part replacement: cloud vertices of part `i`
have degree `q`; vertices of other parts have their degree multiplied by `q`. [NearOptimalHardnessOf, node_35] -/
theorem onePart_degrees {V : Fin k → Type} {E Alph : Type} [Fintype E]
    (I : PCSP k V E Alph) (i : Fin k) (q : ℕ) (C : ℝ) (n : (j : Fin k) → V j → ℕ)
    (H : (j : Fin k) → (v : V j) → E → Fin (n j v) → Bool) (hspec : OnePartSpec I i q C n H) :
    (∀ x : CloudVert n i, deg (cloudReplace I n H) i x = q) ∧
    (∀ j : Fin k, j ≠ i → ∀ x : CloudVert n j,
      deg (cloudReplace I n H) j x = q * deg I j x.1) ∧
    Fintype.card (CloudEdge I n H) = q * Fintype.card E := by
  sorry

/-- Rubric 1: completeness: labelling every cloud vertex `(v,u)` by `A(v)`
preserves the satisfied fraction. [NearOptimalHardnessOf, node_35] -/
theorem onePart_completeness {V : Fin k → Type} {E Alph : Type} [Fintype E]
    (I : PCSP k V E Alph) (i : Fin k) (q : ℕ) (hq : 0 < q) (C : ℝ)
    (n : (j : Fin k) → V j → ℕ) (H : (j : Fin k) → (v : V j) → E → Fin (n j v) → Bool)
    (hspec : OnePartSpec I i q C n H) (A : (j : Fin k) → V j → Alph) :
    satFrac (cloudReplace I n H) (fun j x => A j x.1) = satFrac I A := by
  sorry

/-- Rubric 2: mixing-based soundness (1):
`val(Ω') ≤ val(Ω) + C√(R^{k-1}/q)`. [NearOptimalHardnessOf, node_35] -/
theorem onePart_soundness {V : Fin k → Type} {E : Type} [Fintype E] [Nonempty E]
    {R : ℕ} (I : PCSP k V E (Fin R)) (i : Fin k) (q : ℕ) (hq : 0 < q) (C : ℝ) (hC : 0 ≤ C)
    (n : (j : Fin k) → V j → ℕ) (H : (j : Fin k) → (v : V j) → E → Fin (n j v) → Bool)
    (hspec : OnePartSpec I i q C n H)
    (A' : (j : Fin k) → CloudVert n j → Fin R) :
    ∃ A : (j : Fin k) → V j → Fin R,
      satFrac (cloudReplace I n H) A'
        ≤ satFrac I A + C * Real.sqrt ((R : ℝ) ^ (k - 1) / (q : ℝ)) := by
  sorry

/-- Rubric 3: iterating the one-part construction over all parts of an
instance of minimum degree `≥ q` gives a partwise regular uniform cover with
`d_j = q^{k-j}` (parts indexed from `0`) and soundness loss at most
`k·C√(R^{k-1}/q)`. [NearOptimalHardnessOf, node_35] -/
theorem iterate_partwise_regular {V : Fin k → Type} {E : Type} [Fintype E] [Nonempty E]
    {R : ℕ} (Ψ : PCSP k V E (Fin R)) (q : ℕ) (hq : 2 ≤ q) (C : ℝ) (hC : 0 ≤ C)
    (hexp : ExpanderFact C) (hdeg : ∀ (j : Fin k) (v : V j), q ≤ deg Ψ j v) :
    ∃ (V' : Fin k → Type) (E' : Type) (_ : Fintype E') (Ω : PCSP k V' E' (Fin R)),
      PartwiseRegular Ω (fun j => q ^ (k - (j : ℕ))) ∧ IsUniformCover Ω Ψ ∧
      ∀ A' : (j : Fin k) → V' j → Fin R, ∃ A : (j : Fin k) → V j → Fin R,
        satFrac Ω A' ≤ satFrac Ψ A + (k : ℝ) * C * Real.sqrt ((R : ℝ) ^ (k - 1) / (q : ℝ)) := by
  sorry

/-! ## Exact balancing of a partwise regular instance -/

/-- Replace every `v ∈ V_j` by copies `(v,a)`, `a ∈ [d_j]`, and every
constraint `(v_1,…,v_k)` by the constraints `((v_1,a_1),…,(v_k,a_k))` for all
index vectors `a ∈ [d_1]×⋯×[d_k]`, with the same predicate. -/
def balance {V : Fin k → Type} {E Alph : Type} (I : PCSP k V E Alph) (d : Fin k → ℕ) :
    PCSP k (fun j => V j × Fin (d j)) (E × ((j : Fin k) → Fin (d j))) Alph where
  scope := fun p j => (I.scope p.1 j, p.2 j)
  pred := fun p => I.pred p.1

/-- Rubric 4: the balanced instance has common degree `D = ∏_j d_j`. [NearOptimalHardnessOf, node_35] -/
theorem balance_fullyRegular {V : Fin k → Type} {E Alph : Type} [Fintype E]
    (I : PCSP k V E Alph) (d : Fin k → ℕ) (hreg : PartwiseRegular I d) :
    ∀ (j : Fin k) (x : V j × Fin (d j)), deg (balance I d) j x = ∏ l : Fin k, d l := by
  sorry

/-- Rubric 4: value equality in both directions: the lift of `A` has the same
fraction, and every assignment of the balanced instance is dominated by some
assignment `A_a` of the original (partition into index-vector blocks). [NearOptimalHardnessOf, node_35] -/
theorem balance_value {V : Fin k → Type} {E Alph : Type} [Fintype E]
    (I : PCSP k V E Alph) (d : Fin k → ℕ) (hd : ∀ j, 0 < d j) :
    (∀ A : (j : Fin k) → V j → Alph,
        satFrac (balance I d) (fun j x => A j x.1) = satFrac I A) ∧
    ∀ A' : (j : Fin k) → V j × Fin (d j) → Alph, ∃ A : (j : Fin k) → V j → Alph,
        satFrac (balance I d) A' ≤ satFrac I A := by
  sorry

/-- Main theorem (combinatorial core of the NP-hardness for fully regular
instances). Fix `k ≥ 2`, `ε, δ > 0` and the expander constant `C` of Fact 2.
There is `ρ > 0` (the parameter fed to Fact 1) such that for all sufficiently
large `R`, every k-partite k-CSP `Ψ` over `[R]` with at least one constraint
has a fully regular k-partite uniform cover `Ω` over `[R]` with
YES: `val Ψ ≥ 1-δ → val Ω ≥ 1-δ` and
NO: `val Ψ ≤ R^{-(1-ρ)(k-1)} → val Ω ≤ R^{-(1-ε)(k-1)}`. [NearOptimalHardnessOf, node_35] -/
theorem fully_regular_gap_core (hk : 2 ≤ k) (ε δ : ℝ) (hε : 0 < ε) (hδ : 0 < δ)
    (C : ℝ) (hC : 0 ≤ C) (hexp : ExpanderFact C) :
    ∃ ρ : ℝ, 0 < ρ ∧ ∃ R₀ : ℕ, ∀ R : ℕ, R₀ ≤ R →
      ∀ (V : Fin k → Type) (E : Type) [Fintype E] [Nonempty E] (Ψ : PCSP k V E (Fin R)),
        ∃ (V' : Fin k → Type) (E' : Type) (_ : Fintype E') (Ω : PCSP k V' E' (Fin R)),
          FullyRegular Ω ∧ IsUniformCover Ω Ψ ∧
          (ValAtLeast Ψ (1 - δ) → ValAtLeast Ω (1 - δ)) ∧
          (ValAtMost Ψ ((R : ℝ) ^ (-(1 - ρ) * ((k : ℝ) - 1))) →
            ValAtMost Ω ((R : ℝ) ^ (-(1 - ε) * ((k : ℝ) - 1)))) := by
  sorry

