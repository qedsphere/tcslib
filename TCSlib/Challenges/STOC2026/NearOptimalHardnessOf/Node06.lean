/-!
## Hardness of K-Dimensional Matching within K/(8+ε)

Chaining the (assumed) NP-hardness of the q-partite q-CSP gap problem, the
randomized degree-bounding transformation (soundness `q(1+λ)/((γ-1)(1-λ)²R)`)
and the exact encoding into `qR`-dimensional matching (`val(Π) = M·val(Ψ)`),
one obtains a gap of `c/s` between YES and NO matching numbers, where
`c = 1-δ-3λ`. With `q = 4`, `γ = 3(1-η)` and `K = 4R` this ratio equals
`K·F(η,δ,λ)` with `F → 1/8`, so for small positive parameters it exceeds
`K/(8+ε)`, and an `K/(8+ε)`-approximation would decide the gap problem.

Main theorem: `TCSChallenge.NearOptimalHardnessOfApproximatingKCSP.node_06.kdm_gap_core`.
-/

namespace TCSChallenge.NearOptimalHardnessOfApproximatingKCSP.node_06

/-- A hypergraph on vertex type `W` with edge index type `Ed`, together with a
labelling of the vertices by `K` parts. -/
structure HyperInstance (K : ℕ) (W Ed : Type) where
  part : W → Fin K
  edge : Ed → Finset W

/-- "A K-Dimensional Matching instance is a K-partite hypergraph with edges of
size at most K": every edge has at most `K` vertices, all in distinct parts. -/
def IsKDimMatchingInstance {K : ℕ} {W Ed : Type} (P : HyperInstance K W Ed) : Prop :=
  ∀ x : Ed, (P.edge x).card ≤ K ∧ Set.InjOn P.part (↑(P.edge x) : Set W)

/-- A set of edges is a matching if its edges are pairwise vertex-disjoint. -/
def IsMatching {K : ℕ} {W Ed : Type} (P : HyperInstance K W Ed) (S : Finset Ed) : Prop :=
  ∀ x ∈ S, ∀ y ∈ S, x ≠ y → Disjoint (P.edge x) (P.edge y)

/-- "its value is its maximum matching size". -/
def matchingNumber {K : ℕ} {W Ed : Type} [Fintype Ed] (P : HyperInstance K W Ed) : ℕ :=
  (Finset.univ.filter (fun S : Finset Ed => IsMatching P S)).sup Finset.card

/-- "a factor-ρ approximation algorithm always returns a feasible solution of
value at least OPT/ρ": `S` is a matching with `OPT ≤ ρ·|S|`. -/
def IsApproxMatching {K : ℕ} {W Ed : Type} [Fintype Ed] (P : HyperInstance K W Ed)
    (ρ : ℝ) (S : Finset Ed) : Prop :=
  IsMatching P S ∧ (matchingNumber P : ℝ) ≤ ρ * (S.card : ℝ)

/-- `γ = (1-η)(q-1)`, the soundness exponent fed to the degree-bounding step. -/
def gammaPar (q η : ℝ) : ℝ := (1 - η) * (q - 1)

/-- Completeness after degree bounding: `c = 1 - δ - 3λ`. -/
def complPar (δ lam : ℝ) : ℝ := 1 - δ - 3 * lam

/-- Soundness after degree bounding: `s = q(1+λ)/((γ-1)(1-λ)²R)`. -/
def soundPar (q γ lam R : ℝ) : ℝ := q * (1 + lam) / ((γ - 1) * (1 - lam) ^ 2 * R)

/-- The exact coefficient of `K` in the gap ratio for `q = 4`:
`F(η,δ,λ) = (1-δ-3λ)(2-3η)(1-λ)²/(16(1+λ))`. -/
def gapCoeff (η δ lam : ℝ) : ℝ :=
  (1 - δ - 3 * lam) * (2 - 3 * η) * (1 - lam) ^ 2 / (16 * (1 + lam))

/-- Rubric 1/2: with `K = qR`, the gap ratio `c/s` equals
`K·(1-δ-3λ)(γ-1)(1-λ)²/(q²(1+λ))`. [NearOptimalHardnessOf, node_06] -/
theorem gap_ratio_formula (q η δ lam R : ℝ) (hq : 0 < q) (hR : 0 < R)
    (hγ : 1 < gammaPar q η) (hlam0 : 0 ≤ lam) (hlam1 : lam < 1) :
    complPar δ lam / soundPar q (gammaPar q η) lam R
      = (q * R) * ((1 - δ - 3 * lam) * (gammaPar q η - 1) * (1 - lam) ^ 2
          / (q ^ 2 * (1 + lam))) := by
  sorry

/-- Rubric 2: the limiting coefficient `(q-2)/q²` is maximized over `q ≥ 4` at
`q = 4`, where it equals `1/8`. [NearOptimalHardnessOf, node_06] -/
theorem arity_optimization (q : ℝ) (hq : 4 ≤ q) : (q - 2) / q ^ 2 ≤ 1 / 8 := by
  sorry

/-- Rubric 2: at `q = 4` the gap coefficient is `gapCoeff`, i.e. `c/s = 4R·F`. [NearOptimalHardnessOf, node_06] -/
theorem gap_ratio_q4 (η δ lam R : ℝ) (hR : 0 < R) (hη : η < 1 / 3)
    (hlam0 : 0 ≤ lam) (hlam1 : lam < 1) :
    complPar δ lam / soundPar 4 (gammaPar 4 η) lam R = (4 * R) * gapCoeff η δ lam := by
  sorry

/-- Rubric 3: exact parameter control. For every `ε > 0` there are strictly
positive `η, δ, λ` with `γ = 3(1-η) ≥ 2`, `c > 0` and `F(η,δ,λ) > 1/(8+ε)`. [NearOptimalHardnessOf, node_06] -/
theorem exists_parameters (ε : ℝ) (hε : 0 < ε) :
    ∃ η δ lam : ℝ, 0 < η ∧ 0 < δ ∧ 0 < lam ∧ lam < 1 ∧
      2 ≤ gammaPar 4 η ∧ 0 < complPar δ lam ∧ 1 / (8 + ε) < gapCoeff η δ lam := by
  sorry

/-- Rubric 4: the threshold test. If `α < c/s` and `M > 0`, then on a matching
instance with matching number `≥ M·c` every `α`-approximate matching has size
`> M·s`, and on one with matching number `≤ M·s` every matching has size `≤ M·s`. [NearOptimalHardnessOf, node_06] -/
theorem threshold_test {K : ℕ} {W Ed : Type} [Fintype Ed] (P : HyperInstance K W Ed)
    (M : ℕ) (hM : 0 < M) (c s α : ℝ) (hs : 0 < s) (hα : 0 < α) (hgap : α < c / s)
    (S : Finset Ed) (hS : IsApproxMatching P α S) :
    ((M : ℝ) * c ≤ (matchingNumber P : ℝ) → (M : ℝ) * s < (S.card : ℝ)) ∧
    ((matchingNumber P : ℝ) ≤ (M : ℝ) * s → (S.card : ℝ) ≤ (M : ℝ) * s) := by
  sorry

/-- Main theorem (combinatorial core of "for every ε > 0 there is K such that,
unless NP ⊆ BPP, K-Dimensional Matching cannot be approximated within
K/(8+ε)"). There are positive parameters `η, δ, λ` with `γ = 3(1-η) ≥ 2` and
`c = 1-δ-3λ > 0` such that for arbitrarily large primes `R`, with `K = 4R`,
`s = 4(1+λ)/((γ-1)(1-λ)²R)` and `α = K/(8+ε)`: the gap satisfies `c/s > α`,
and on every `K`-dimensional matching instance with `M > 0` whose matching
number is `≥ M·c` (YES) or `≤ M·s` (NO), comparing the size of any
`α`-approximate matching with `M·s` decides which case holds. [NearOptimalHardnessOf, node_06] -/
theorem kdm_gap_core (ε : ℝ) (hε : 0 < ε) :
    ∃ η δ lam : ℝ, 0 < η ∧ 0 < δ ∧ 0 < lam ∧ lam < 1 ∧
      2 ≤ gammaPar 4 η ∧ 0 < complPar δ lam ∧
      ∀ R₀ : ℕ, ∃ R : ℕ, R₀ ≤ R ∧ Nat.Prime R ∧
        ((4 * R : ℕ) : ℝ) / (8 + ε)
            < complPar δ lam / soundPar 4 (gammaPar 4 η) lam (R : ℝ) ∧
        ∀ (W Ed : Type) [Fintype Ed] (P : HyperInstance (4 * R) W Ed) (M : ℕ),
          IsKDimMatchingInstance P → 0 < M →
          ∀ S : Finset Ed, IsApproxMatching P (((4 * R : ℕ) : ℝ) / (8 + ε)) S →
            ((M : ℝ) * complPar δ lam ≤ (matchingNumber P : ℝ) →
                (M : ℝ) * soundPar 4 (gammaPar 4 η) lam (R : ℝ) < (S.card : ℝ)) ∧
            ((matchingNumber P : ℝ) ≤ (M : ℝ) * soundPar 4 (gammaPar 4 η) lam (R : ℝ) →
                (S.card : ℝ) ≤ (M : ℝ) * soundPar 4 (gammaPar 4 η) lam (R : ℝ)) := by
  sorry

end TCSChallenge.NearOptimalHardnessOfApproximatingKCSP.node_06
