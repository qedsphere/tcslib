/-!
## From k-CSP hardness to k-partite k-CSP hardness

Given a k-CSP `I` on variables `V` with constraints indexed by `E`, the
instance `I⋆` has variables `V × Fin k` (part `t` is `V × {t}`) and one
constraint `(e, π)` for every original constraint `e` and permutation
`π ∈ S_k`, with scope `t ↦ (u_{π t}, t)` and predicate
`a ↦ Φ_e(a ∘ π⁻¹)`. Then `val I⋆ ≥ val I`, and random decoding
`A(v) = B(v, I_v)` shows `val I ≥ (k!/k^k) val I⋆`.

Main theorem: `TCSChallenge.NearOptimalHardnessOfApproximatingKCSP.node_31.partite_promise_preservation`.
-/

namespace TCSChallenge.NearOptimalHardnessOfApproximatingKCSP.node_31

/-- "A k-CSP instance consists of a finite variable set V, an alphabet Σ, and a
multiset of constraints. Each constraint e has an ordered scope (u_1,…,u_k)
… and a predicate Φ_e : Σ^k → {0,1}." Constraints are indexed by `E`
(so repetitions model the multiset). -/
structure CSP (k : ℕ) (V E Alph : Type) where
  scope : E → Fin k → V
  pred : E → (Fin k → Alph) → Bool

/-- "ordered scope (u_1,…,u_k) of distinct variables". -/
def HasDistinctScopes {k : ℕ} {V E Alph : Type} (I : CSP k V E Alph) : Prop :=
  ∀ e : E, Function.Injective (I.scope e)

/-- Constraint `e` is satisfied by the assignment `A`. -/
def Sat {k : ℕ} {V E Alph : Type} (I : CSP k V E Alph) (A : V → Alph) (e : E) : Prop :=
  I.pred e (fun j => A (I.scope e j)) = true

/-- The fraction of constraints satisfied by `A`. -/
def satFrac {k : ℕ} {V E Alph : Type} [Fintype E] (I : CSP k V E Alph) (A : V → Alph) : ℝ :=
  ((Finset.univ.filter (fun e => Sat I A e)).card : ℝ) / (Fintype.card E : ℝ)

/-- `val(I) ≥ c`: some assignment satisfies at least a `c` fraction. -/
def ValAtLeast {k : ℕ} {V E Alph : Type} [Fintype E] (I : CSP k V E Alph) (c : ℝ) : Prop :=
  ∃ A : V → Alph, c ≤ satFrac I A

/-- `val(I) ≤ s`: every assignment satisfies at most an `s` fraction. -/
def ValAtMost {k : ℕ} {V E Alph : Type} [Fintype E] (I : CSP k V E Alph) (s : ℝ) : Prop :=
  ∀ A : V → Alph, satFrac I A ≤ s

/-- "The instance is k-partite if V admits a partition V_1 ⊔ ⋯ ⊔ V_k such that
the j-th variable in the ordered scope of every constraint belongs to V_j." -/
def IsKPartite {k : ℕ} {V E Alph : Type} (I : CSP k V E Alph) : Prop :=
  ∃ part : V → Fin k, ∀ e : E, ∀ j : Fin k, part (I.scope e j) = j

/-- The partite construction: variables `(v, t)`, constraints `(e, π)` with
scope `((u_{π 1},1),…,(u_{π k},k))` and predicate
`Φ⋆_{e,π}(a) = Φ_e(a_{π⁻¹ 1},…,a_{π⁻¹ k})`. -/
def partiteLift {k : ℕ} {V E Alph : Type} (I : CSP k V E Alph) :
    CSP k (V × Fin k) (E × Equiv.Perm (Fin k)) Alph where
  scope := fun p t => (I.scope p.1 (p.2 t), t)
  pred := fun p a => I.pred p.1 (fun j => a (p.2.symm j))

/-- Rubric 1: `I⋆` is k-partite (part of `(v, t)` is `t`). [NearOptimalHardnessOf, node_31] -/
theorem partiteLift_isKPartite {k : ℕ} {V E Alph : Type} (I : CSP k V E Alph) :
    IsKPartite (partiteLift I) := by
  sorry

/-- Rubric 1: `I⋆` has exactly `k!` times as many constraints. [NearOptimalHardnessOf, node_31] -/
theorem partiteLift_card {k : ℕ} {V E : Type} [Fintype E] :
    Fintype.card (E × Equiv.Perm (Fin k)) = Fintype.card E * Nat.factorial k := by
  sorry

/-- Rubric 2: completeness. The lift `A⋆(v,t) = A(v)` satisfies exactly the
same fraction of constraints. [NearOptimalHardnessOf, node_31] -/
theorem partiteLift_completeness {k : ℕ} {V E Alph : Type} [Fintype E]
    (I : CSP k V E Alph) (A : V → Alph) :
    satFrac (partiteLift I) (fun p => A p.1) = satFrac I A := by
  sorry

/-- Rubric 3: soundness decoding. For every assignment `B` to `I⋆` there is an
assignment `A` to `I` with `satFrac I A ≥ (k!/k^k)·satFrac I⋆ B`. [NearOptimalHardnessOf, node_31] -/
theorem partiteLift_soundness {k : ℕ} {V E Alph : Type} [Fintype E]
    (I : CSP k V E Alph) (hI : HasDistinctScopes I) (B : V × Fin k → Alph) :
    ∃ A : V → Alph,
      ((Nat.factorial k : ℝ) / ((k : ℝ) ^ k)) * satFrac (partiteLift I) B ≤ satFrac I A := by
  sorry

/-- Rubric 4: absorbing the constant `k^k/k!` into the exponent slack. [NearOptimalHardnessOf, node_31] -/
theorem constant_absorption (k : ℕ) (hk : 1 ≤ k) (ε : ℝ) (hε : 0 < ε) :
    ∃ R₀ : ℕ, ∀ R : ℕ, R₀ ≤ R →
      ((k : ℝ) ^ k / (Nat.factorial k : ℝ)) * (R : ℝ) ^ (-(1 - ε / 2) * ((k : ℝ) - 1))
        ≤ (R : ℝ) ^ (-(1 - ε) * ((k : ℝ) - 1)) := by
  sorry

/-- Main theorem (combinatorial core; rubric 5). For every `ε, δ > 0` and all
sufficiently large `R`, the construction `I ↦ I⋆` maps k-CSPs over an alphabet
of size `R` (with distinct scopes and at least one constraint) to k-partite
k-CSPs over the same alphabet, sending YES instances (`val ≥ 1-δ`) to YES
instances and NO instances of the unrestricted premise with parameter `ε/2`
(`val ≤ R^{-(1-ε/2)(k-1)}`) to NO instances (`val ≤ R^{-(1-ε)(k-1)}`). [NearOptimalHardnessOf, node_31] -/
theorem partite_promise_preservation (k : ℕ) (hk : 1 ≤ k) (ε δ : ℝ)
    (hε : 0 < ε) (hδ : 0 < δ) :
    ∃ R₀ : ℕ, ∀ R : ℕ, R₀ ≤ R →
      ∀ (V E : Type) [Fintype E] [Nonempty E] (I : CSP k V E (Fin R)),
        HasDistinctScopes I →
        IsKPartite (partiteLift I) ∧
        (ValAtLeast I (1 - δ) → ValAtLeast (partiteLift I) (1 - δ)) ∧
        (ValAtMost I ((R : ℝ) ^ (-(1 - ε / 2) * ((k : ℝ) - 1))) →
          ValAtMost (partiteLift I) ((R : ℝ) ^ (-(1 - ε) * ((k : ℝ) - 1)))) := by
  sorry

end TCSChallenge.NearOptimalHardnessOfApproximatingKCSP.node_31
