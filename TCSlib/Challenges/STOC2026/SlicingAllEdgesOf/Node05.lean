/-!
## Slicing all edges of the hypercube needs `≳ n^{2/3}/(log n)^{4/3}` hyperplanes

`Q_n` is the graph on `{-1,1}^n` with edges between points differing in one coordinate.
An affine hyperplane `{x : ⟨v,x⟩ = t}` (`v ≠ 0`) *dissects* an edge when the two endpoints
lie in different open halfspaces, i.e. `(⟨v,a⟩ - t)(⟨v,b⟩ - t) < 0`. `H(n)` is the minimum
number of hyperplanes dissecting every edge of `Q_n`.

Main theorem `slicing_lower_bound`: there is an absolute `c > 0` with
`H(n) ≥ c · n^{2/3} / (log n)^{4/3}` for all `n ≥ 3`.
-/

namespace TCSChallenge.SlicingAllEdgesOfAnNCube.node_05

/-- The `±1` value of a Boolean coordinate: `true ↦ 1`, `false ↦ -1`. -/
def sgn (b : Bool) : ℝ := if b then 1 else -1

/-- The point of `{-1,1}^n ⊂ ℝ^n` encoded by `x : Fin n → Bool`. -/
def toPoint {n : ℕ} (x : Fin n → Bool) : Fin n → ℝ := fun k => sgn (x k)

/-- The linear form `⟨v, x⟩` evaluated at a cube vertex. -/
def form {n : ℕ} (v : Fin n → ℝ) (x : Fin n → Bool) : ℝ := ∑ k, v k * toPoint x k

/-- The neighbour of `x` across coordinate `k` ("differ in one coordinate"). -/
def flipCoord {n : ℕ} (x : Fin n → Bool) (k : Fin n) : Fin n → Bool :=
  Function.update x k (!x k)

/-- "The endpoints of that edge lie in different open halfspaces determined by the
hyperplane" `⟨v,x⟩ = t`: the edge `{x, flipCoord x k}` is dissected by `(v, t)`. -/
def Dissects {n : ℕ} (v : Fin n → ℝ) (t : ℝ) (x : Fin n → Bool) (k : Fin n) : Prop :=
  (form v x - t) * (form v (flipCoord x k) - t) < 0

/-- A family of `m` affine hyperplanes `⟨v_ℓ, x⟩ = t_ℓ` with `v_ℓ ≠ 0` dissecting every edge
of `Q_n`. -/
def DissectsAllEdges {n m : ℕ} (h : Fin m → (Fin n → ℝ) × ℝ) : Prop :=
  (∀ ℓ, (h ℓ).1 ≠ 0) ∧ ∀ (x : Fin n → Bool) (k : Fin n), ∃ ℓ, Dissects (h ℓ).1 (h ℓ).2 x k

/-- "`H(n)` is the minimum number of affine hyperplanes needed to dissect every edge of
`Q_n`." (The set is nonempty, see `dissecting_family_exists`.) -/
def H (n : ℕ) : ℕ :=
  sInf {m : ℕ | ∃ h : Fin m → (Fin n → ℝ) × ℝ, DissectsAllEdges h}

/-- The product distribution `μ_p` on sign vectors with `E X_k = p_k`:
`μ_p(x) = ∏_k (1 + p_k x_k)/2`. -/
def biasedProb {n : ℕ} (p : Fin n → ℝ) (x : Fin n → Bool) : ℝ :=
  ∏ k, (1 + p k * sgn (x k)) / 2

/-- `Pr_{X ∼ μ_p}[|⟨w, X⟩ - t| < a]`. -/
def smallBallProb {n : ℕ} (w p : Fin n → ℝ) (t a : ℝ) : ℝ :=
  ∑ x ∈ Finset.univ.filter (fun x : Fin n → Bool => |form w x - t| < a), biasedProb p x

/-- `j` is an occupied scale of `w`: the block `K_w(j) = {k : 2^{-j-1} < |w_k| ≤ 2^{-j}}`
is nonempty. -/
def OccupiedScale {n : ℕ} (w : Fin n → ℝ) (j : ℕ) : Prop :=
  ∃ k, (2 : ℝ)⁻¹ ^ (j + 1) < |w k| ∧ |w k| ≤ (2 : ℝ)⁻¹ ^ j

/-- A probability vector on the finite set of (vertex, coordinate) pairs, i.e. a
distribution on (oriented) edges of `Q_n`. -/
def IsEdgeDistribution {n : ℕ} (μ : (Fin n → Bool) × Fin n → ℝ) : Prop :=
  (∀ e, 0 ≤ μ e) ∧ ∑ e, μ e = 1

/-- Probability under `μ` that the sampled edge is dissected by `⟨v,x⟩ = t`. -/
def crossProb {n : ℕ} (μ : (Fin n → Bool) × Fin n → ℝ) (v : Fin n → ℝ) (t : ℝ) : ℝ :=
  ∑ e ∈ Finset.univ.filter (fun e : (Fin n → Bool) × Fin n => Dissects v t e.1 e.2), μ e

/-- Sanity: the `n` coordinate hyperplanes `x_k = 0` dissect every edge, so `H(n)` is the
infimum of a nonempty set. [SlicingAllEdgesOf, node_05] -/
theorem dissecting_family_exists (n : ℕ) :
    ∃ m, ∃ h : Fin m → (Fin n → ℝ) × ℝ, DissectsAllEdges h := by
  sorry

/-- Rubric 1, inequality (1): one-scale anti-concentration for moderately biased signs.
If `‖p‖_∞ ≤ 1/2` and at least `q ≥ 1` coefficients of `w` have absolute value `≥ a > 0`,
then `Q(a, ⟨w, X⟩) ≤ C/√q` for `X ∼ μ_p`. [SlicingAllEdgesOf, node_05] -/
theorem one_scale_anticoncentration :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ (n q : ℕ) (w p : Fin n → ℝ) (a t : ℝ),
      (∀ k, |p k| ≤ 1 / 2) → 0 < a → 1 ≤ q →
      q ≤ (Finset.univ.filter (fun k => a ≤ |w k|)).card →
      smallBallProb w p t a ≤ C / Real.sqrt q := by
  sorry

/-- Rubric 2, inequality (3): anti-concentration from many occupied scales. There is a
constant `L` such that with `B = L + ⌈log₂(8n)⌉`, if `|w_k| ≤ 1`, `‖p‖_∞ ≤ 1/2`, and at
least `r·B` occupied scales `j` of `w` satisfy `2^{-j-1} ≥ a`, then
`Q(a, ⟨w, X⟩) ≤ 2^{-r}`. [SlicingAllEdgesOf, node_05] -/
theorem multiscale_anticoncentration :
    ∃ L : ℕ, ∀ (n r : ℕ) (w p : Fin n → ℝ) (a t : ℝ),
      1 ≤ n → (∀ k, |w k| ≤ 1) → (∀ k, |p k| ≤ 1 / 2) → 0 < a →
      (∃ S : Finset ℕ, r * (L + ⌈Real.logb 2 (8 * n)⌉₊) ≤ S.card ∧
        ∀ j ∈ S, OccupiedScale w j ∧ a ≤ (2 : ℝ)⁻¹ ^ (j + 1)) →
      smallBallProb w p t a ≤ (2 : ℝ)⁻¹ ^ r := by
  sorry

/-- Rubric 3–5, inequality (15): for any `m ≥ 1` unit normals there is ONE edge
distribution, common to all hyperplanes with these normals, under which every hyperplane
`⟨v_ℓ, x⟩ = t` (any `t`) dissects the sampled edge with probability
`≤ C₁ √m (log n)² / n`. [SlicingAllEdgesOf, node_05] -/
theorem exists_common_edge_distribution :
    ∃ C₁ : ℝ, 0 < C₁ ∧ ∀ (n m : ℕ) (v : Fin m → Fin n → ℝ),
      3 ≤ n → 1 ≤ m → (∀ ℓ, ∑ k, v ℓ k ^ 2 = 1) →
      ∃ μ : (Fin n → Bool) × Fin n → ℝ, IsEdgeDistribution μ ∧
        ∀ (ℓ : Fin m) (t : ℝ),
          crossProb μ (v ℓ) t ≤ C₁ * Real.sqrt m * Real.log n ^ 2 / n := by
  sorry

/-- Rubric 6, family form: any `m` hyperplanes dissecting all edges of `Q_n` (`n ≥ 3`)
satisfy `m ≥ c · n^{2/3} / (log n)^{4/3}` for an absolute `c > 0`. [SlicingAllEdgesOf, node_05] -/
theorem dissecting_family_lower_bound :
    ∃ c : ℝ, 0 < c ∧ ∀ (n m : ℕ) (h : Fin m → (Fin n → ℝ) × ℝ),
      3 ≤ n → DissectsAllEdges h →
      c * (n : ℝ) ^ ((2 : ℝ) / 3) / Real.log n ^ ((4 : ℝ) / 3) ≤ m := by
  sorry

/-- Main theorem: there is an absolute constant `c > 0` such that for every `n ≥ 3`,
`H(n) ≥ c · n^{2/3} / (log n)^{4/3}` (natural logarithm). [SlicingAllEdgesOf, node_05] -/
theorem slicing_lower_bound :
    ∃ c : ℝ, 0 < c ∧ ∀ n : ℕ, 3 ≤ n →
      c * (n : ℝ) ^ ((2 : ℝ) / 3) / Real.log n ^ ((4 : ℝ) / 3) ≤ (H n : ℝ) := by
  sorry

end TCSChallenge.SlicingAllEdgesOfAnNCube.node_05
