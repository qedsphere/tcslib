/-!
## Lower bounds on the iteration number of k-dimensional Weisfeiler–Leman

For a finite simple graph `X` and `k ≥ 2`, the round-`r` colour `χ^r_X(ā)` of a tuple
`ā ∈ V(X)^k` is defined by `χ⁰_X(ā)` = equality/adjacency type of `ā`, and
`χ^{r+1}_X(ā) = (χ^r_X(ā), {{(χ^r_X(ā[v/1]), …, χ^r_X(ā[v/k])) : v ∈ V(X)}})`.
Colours are formal objects of a type `WLColor k r` independent of the graph, so colours of
different graphs are compared literally. k-WL distinguishes `G` and `H` in round `r` when
the multisets of round-`r` colours of their `k`-tuples differ. The iteration number of `X`
is the least `r` with `χ^r_X` and `χ^{r+1}_X` inducing the same partition of `V(X)^k`.

Main theorem `exists_long_wl_pairs`: there is an absolute `c > 0` such that for all
`k ≥ 2` and `n ≥ c (k log k)²` there are graphs `G_n, H_n` on the same number
`N ≤ c k² n` of vertices that k-WL eventually distinguishes, but not in any round
`r < n^{k/2}`. Corollary `iterationNumber_lower_bound`: for fixed `k`, the maximum
iteration number over graphs with at most `N` vertices is `Ω(N^{k/2})`.
-/

namespace TCSChallenge.CompressingCFIGraphsAnd.node_37

/-- The type of round-`r` colours of `k`-tuples. "Colors are formal objects, compared
identically across graphs." Round 0: for each pair of coordinates `(i, j)`, the pair
(`a_i = a_j`, `a_i a_j ∈ E`). Round `r+1`: the previous colour together with the multiset
of `k`-tuples of round-`r` colours. -/
def WLColor (k : ℕ) : ℕ → Type
  | 0 => Fin k → Fin k → Bool × Bool
  | r + 1 => WLColor k r × Multiset (Fin k → WLColor k r)

open Classical in
/-- `χ^r_X(ā)`: "`χ⁰_X(ā)` record[s] all equality and adjacency relations among its
coordinates", and `χ^{r+1}_X(ā) = (χ^r_X(ā), {{(χ^r_X(ā[v/1]), …, χ^r_X(ā[v/k])) : v ∈ V(X)}})`,
where `ā[v/i]` is `Function.update ā i v`. -/
noncomputable def wlColor {V : Type} [Fintype V] (G : SimpleGraph V) (k : ℕ) :
    (r : ℕ) → (Fin k → V) → WLColor k r
  | 0, a =>
      ((fun i j => (decide (a i = a j), decide (G.Adj (a i) (a j))) :
        Fin k → Fin k → Bool × Bool))
  | r + 1, a =>
      ((wlColor G k r a,
        (Finset.univ : Finset V).val.map
          (fun v => fun i => wlColor G k r (Function.update a i v))) :
        WLColor k r × Multiset (Fin k → WLColor k r))

/-- The multiset of round-`r` colours of all `k`-tuples of `X`. -/
noncomputable def wlHistogram {V : Type} [Fintype V] (G : SimpleGraph V) (k r : ℕ) :
    Multiset (WLColor k r) :=
  (Finset.univ : Finset (Fin k → V)).val.map (wlColor G k r)

/-- "The k-dimensional Weisfeiler–Leman procedure distinguishes two graphs in round `r`
when the multisets of colors of their k-tuples at that round differ." -/
def WLDistinguishesAt {V W : Type} [Fintype V] [Fintype W]
    (k : ℕ) (G : SimpleGraph V) (H : SimpleGraph W) (r : ℕ) : Prop :=
  wlHistogram G k r ≠ wlHistogram H k r

/-- `χ^r_X` and `χ^{r+1}_X` induce the same partition of `V(X)^k`. -/
def WLStableAt {V : Type} [Fintype V] (k : ℕ) (G : SimpleGraph V) (r : ℕ) : Prop :=
  ∀ a b : Fin k → V, (wlColor G k r a = wlColor G k r b ↔
    wlColor G k (r + 1) a = wlColor G k (r + 1) b)

/-- "Its iteration number on X is the least nonnegative integer r such that χ^r_X and
χ^{r+1}_X induce the same partition of V(X)^k." (`sInf` on `ℕ`; well defined by
`exists_wlStableAt`.) -/
noncomputable def iterationNumber {V : Type} [Fintype V] (k : ℕ) (G : SimpleGraph V) : ℕ :=
  sInf {r : ℕ | WLStableAt k G r}

/-- The iteration number is well defined: some round is stable. [CompressingCFIGraphsAnd, node_37] -/
theorem exists_wlStableAt {V : Type} [Fintype V] (k : ℕ) (G : SimpleGraph V) :
    ∃ r : ℕ, WLStableAt k G r := by
  sorry

/-- Distinction persists: a pair distinguished in round `r` is distinguished in round `r+1`. [CompressingCFIGraphsAnd, node_37] -/
theorem wlDistinguishesAt_succ {V W : Type} [Fintype V] [Fintype W]
    (k : ℕ) (G : SimpleGraph V) (H : SimpleGraph W) (r : ℕ)
    (h : WLDistinguishesAt k G H r) : WLDistinguishesAt k G H (r + 1) := by
  sorry

/-- "A pair whose first distinguishing round is R forces an iteration number at least R−1 on
one of its two members." [CompressingCFIGraphsAnd, node_37] -/
theorem iterationNumber_ge_of_firstDistinguishing {V W : Type} [Fintype V] [Fintype W]
    (k : ℕ) (G : SimpleGraph V) (H : SimpleGraph W) (R : ℕ)
    (hR : WLDistinguishesAt k G H R) (hfirst : ∀ r < R, ¬ WLDistinguishesAt k G H r) :
    R - 1 ≤ iterationNumber k G ∨ R - 1 ≤ iterationNumber k H := by
  sorry

/-- **Main theorem.** There is an absolute constant `c > 0` such that for every `k ≥ 2` and
every `n ≥ c (k log k)²` there are finite simple graphs `G_n, H_n` with
`|V(G_n)| = |V(H_n)| ≤ c k² n` that are eventually distinguished by k-WL, but whose first
distinguishing round is at least `n^{k/2}`. [CompressingCFIGraphsAnd, node_37] -/
theorem exists_long_wl_pairs :
    ∃ c : ℝ, 0 < c ∧ ∀ k : ℕ, 2 ≤ k → ∀ n : ℕ,
      c * ((k : ℝ) * Real.log (k : ℝ)) ^ 2 ≤ (n : ℝ) →
      ∃ N : ℕ, ∃ G H : SimpleGraph (Fin N),
        (N : ℝ) ≤ c * (k : ℝ) ^ 2 * (n : ℝ) ∧
        (∃ r : ℕ, WLDistinguishesAt k G H r) ∧
        ∀ r : ℕ, (r : ℝ) < (n : ℝ) ^ ((k : ℝ) / 2) → ¬ WLDistinguishesAt k G H r := by
  sorry

/-- **Corollary.** For every fixed `k ≥ 2`, the maximum iteration number of k-WL over graphs
with at most `N` vertices is `Ω(N^{k/2})` as `N → ∞`. [CompressingCFIGraphsAnd, node_37] -/
theorem iterationNumber_lower_bound (k : ℕ) (hk : 2 ≤ k) :
    ∃ C : ℝ, 0 < C ∧ ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
      ∃ M : ℕ, M ≤ N ∧ ∃ G : SimpleGraph (Fin M),
        C * (N : ℝ) ^ ((k : ℝ) / 2) ≤ (iterationNumber k G : ℝ) := by
  sorry

end TCSChallenge.CompressingCFIGraphsAnd.node_37
