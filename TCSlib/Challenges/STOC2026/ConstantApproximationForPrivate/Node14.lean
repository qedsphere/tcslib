/-!
## Single-item auctions with private interdependent valuations

`n` bidders; bidder `i` privately knows a signal `s_i ∈ S_i` and a valuation function
`v_i : ∏_j S_j → ℝ_{≥0}`. A direct mechanism maps reported `(s, v)` to allocation
probabilities `x_i` and expected payments `p_i`.

Main theorems (all at the end of the file):
* `known_bound_mechanism`: for every `d ∈ [1, n]` there is a feasible EPIC-IR mechanism on
  the `d`-self-bounding domain with approximation factor `4(d+1) ln 2`;
* `unknown_bound_mechanism`: one feasible EPIC-IR mechanism on all nonnegative valuations
  whose factor on `d`-self-bounding profiles is `8(d+1) ln 2`, for all `d ∈ [1,n]` at once;
* `monotone_sos_mechanism`, `sos_mechanism`: factors `8 ln 2 < 5.55` and `12 ln 2 < 8.32`;
* `lower_bound_linear_in_d`: any uniform factor on public `d`-self-bounding valuations is
  at least `d`.
-/

namespace TCSChallenge.ConstantApproximationForPrivate.node_14

/-! ## Shared definitions (identical in all files of this paper) -/

/-- A valuation function `v : S → ℝ` on signal profiles `S = ∏_{j} S_j`. -/
abbrev Val {n : ℕ} (S : Fin n → Type) : Type := (∀ j, S j) → ℝ

/-- The coordinate infimum `inf_{t ∈ S_i} f(t, s_{-i})`. -/
def coordInf {n : ℕ} {S : Fin n → Type} (f : Val S) (s : ∀ j, S j) (i : Fin n) : ℝ :=
  ⨅ t : S i, f (Function.update s i t)

/-- "`f` is `d`-self-bounding": `f ≥ 0` and
`∑_{i=1}^n (f(s) − inf_{t∈S_i} f(t,s_{-i})) ≤ d f(s)` for every `s ∈ S`. -/
def IsSelfBounding {n : ℕ} {S : Fin n → Type} (d : ℝ) (f : Val S) : Prop :=
  (∀ s, 0 ≤ f s) ∧ ∀ s, ∑ i, (f s - coordInf f s i) ≤ d * f s

/-- The domain of `d`-self-bounding valuations. -/
def SBDomain {n : ℕ} (S : Fin n → Type) (d : ℝ) : Set (Val S) :=
  {f | IsSelfBounding d f}

/-- Truncated logarithm `L_c(t) = max{0, min{1, log₂(t/c)}}` for `c, t > 0`;
`L_c(0) = 0`; `L_0(t) = 1` for `t > 0`. -/
def truncLog (c t : ℝ) : ℝ :=
  if t ≤ 0 then 0 else if c ≤ 0 then 1 else max 0 (min 1 (Real.logb 2 (t / c)))

/-- Randomly shifted power-of-two rounding: `f_r(0) = 0` and
`f_r(w) = 2^{r + ⌊log₂ w − r⌋}` for `w > 0`. -/
def roundGrid (r w : ℝ) : ℝ :=
  if w ≤ 0 then 0 else (2 : ℝ) ^ (r + (⌊Real.logb 2 w - r⌋ : ℝ))

/-- Lexicographic comparison of bidder-labelled numbers: `(a, i)` beats `(b, j)` under
rounding `r` and priority `π` if `f_r(a) > f_r(b)`, or they tie and `i` has the higher
priority (`π j < π i`). -/
def Beats {n : ℕ} (r : ℝ) (π : Equiv.Perm (Fin n)) (a : ℝ) (i : Fin n) (b : ℝ) (j : Fin n) :
    Prop :=
  roundGrid r b < roundGrid r a ∨ (roundGrid r a = roundGrid r b ∧ π j < π i)

/-! ## Single-item mechanisms -/

/-- A direct mechanism: allocation probabilities and expected payments as functions of the
reported signals `s` and reported valuation functions `v`. -/
structure Mechanism {n : ℕ} (S : Fin n → Type) where
  alloc : (∀ j, S j) → (Fin n → Val S) → Fin n → ℝ
  pay : (∀ j, S j) → (Fin n → Val S) → Fin n → ℝ

/-- Feasibility on a domain: `x_i ≥ 0` and `∑_i x_i ≤ 1` at every admissible report. -/
def Feasible {n : ℕ} {S : Fin n → Type} (D : Set (Val S)) (M : Mechanism S) : Prop :=
  ∀ (s : ∀ j, S j) (v : Fin n → Val S), (∀ j, v j ∈ D) →
    (∀ i, 0 ≤ M.alloc s v i) ∧ ∑ i, M.alloc s v i ≤ 1

/-- EPIC-IR on a domain: for every admissible true profile `(s, v)`, bidder `i`, and
admissible alternative report `(s'_i, v'_i)`, truthful utility is at least deviating
utility, and truthful utility is nonnegative. -/
def EPICIR {n : ℕ} {S : Fin n → Type} (D : Set (Val S)) (M : Mechanism S) : Prop :=
  ∀ (s : ∀ j, S j) (v : Fin n → Val S), (∀ j, v j ∈ D) → ∀ i : Fin n,
    (∀ (s' : S i) (v' : Val S), v' ∈ D →
      M.alloc (Function.update s i s') (Function.update v i v') i * v i s
          - M.pay (Function.update s i s') (Function.update v i v') i
        ≤ M.alloc s v i * v i s - M.pay s v i) ∧
    0 ≤ M.alloc s v i * v i s - M.pay s v i

/-- Approximation factor at most `α` on a domain: `∑_i x_i v_i(s) ≥ max_i v_i(s) / α`,
written multiplicatively as `v_i(s) ≤ α ∑_j x_j v_j(s)` for every `i`. -/
def ApproxWithin {n : ℕ} {S : Fin n → Type} (D : Set (Val S)) (M : Mechanism S) (α : ℝ) :
    Prop :=
  ∀ (s : ∀ j, S j) (v : Fin n → Val S), (∀ j, v j ∈ D) →
    ∀ i, v i s ≤ α * ∑ j, M.alloc s v j * v j s

/-! ## The explicit candidate rule -/

/-- `c_i(r, π) = 1` iff `w_i > 0` and `f_r(w_i) >_π f_r(b_j^i)` for every `j ≠ i`, where
`B j` stands for `b_j^i = inf_{t ∈ S_i} v_j(t, s_{-i})`. -/
def IsCandidate {n : ℕ} (w : Fin n → ℝ) (B : Fin n → ℝ) (i : Fin n) (r : ℝ)
    (π : Equiv.Perm (Fin n)) : Prop :=
  0 < w i ∧ ∀ j, j ≠ i → Beats r π (w i) i (B j) j

/-- `q_i = E_{r ∼ U[0,1), π uniform}[c_i(r,π)]`, with `b_j^i = coordInf (v j) s i`. -/
def candMass {n : ℕ} {S : Fin n → Type} (s : ∀ j, S j) (v : Fin n → Val S) (i : Fin n) : ℝ :=
  (1 / (n.factorial : ℝ)) * ∑ π : Equiv.Perm (Fin n),
    ∫ r in (0 : ℝ)..1,
      (if IsCandidate (fun k => v k s) (fun j => coordInf (v j) s i) i r π then (1 : ℝ) else 0)

/-! ## Lemma stubs (rubric items) -/

/-- Rubric 1: the allocation depends on bidder `i`'s report only through `w_i = v_i(s)`:
changing `i`'s signal and function while keeping the realized value leaves `q_i` fixed. [ConstantApproximationForPrivate, node_14] -/
theorem candMass_depends_only_on_value {n : ℕ} {S : Fin n → Type}
    (s : ∀ j, S j) (v : Fin n → Val S) (i : Fin n) (s' : S i) (v' : Val S)
    (h : v' (Function.update s i s') = v i s) :
    candMass (Function.update s i s') (Function.update v i v') i = candMass s v i := by
  sorry

/-- Payment identity (1): for a monotone nonnegative allocation curve `a`, the payment
`p(w) = w a(w) − ∫_0^w a` makes truthful scalar reporting optimal and IR. [ConstantApproximationForPrivate, node_14] -/
theorem myerson_payment (a : ℝ → ℝ) (ha : Monotone a) (ha0 : ∀ t, 0 ≤ a t)
    (y z : ℝ) (hy : 0 ≤ y) (hz : 0 ≤ z) :
    y * a z - (z * a z - ∫ t in (0 : ℝ)..z, a t)
        ≤ y * a y - (y * a y - ∫ t in (0 : ℝ)..y, a t) ∧
      0 ≤ y * a y - (y * a y - ∫ t in (0 : ℝ)..y, a t) := by
  sorry

/-- Identity (2): `Pr_r[f_r(a) > f_r(b)] = L_b(a)` for `a, b ≥ 0`. [ConstantApproximationForPrivate, node_14] -/
theorem prob_round_gt (a b : ℝ) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    (∫ r in (0 : ℝ)..1, (if roundGrid r b < roundGrid r a then (1 : ℝ) else 0))
      = truncLog b a := by
  sorry

/-- Inequality (3): `L_b(u) ≤ 2(u − b)/u` for `0 ≤ b ≤ u`, `u > 0`. [ConstantApproximationForPrivate, node_14] -/
theorem truncLog_le_two_drop (b u : ℝ) (hb : 0 ≤ b) (hbu : b ≤ u) (hu : 0 < u) :
    truncLog b u ≤ 2 * (u - b) / u := by
  sorry

/-- Inequality (4): for a `d`-self-bounding `f` with `f(s) > 0`,
`∑_i L_{inf_i f}(f(s)) ≤ 2d`. [ConstantApproximationForPrivate, node_14] -/
theorem sum_truncLog_le {n : ℕ} {S : Fin n → Type} (d : ℝ) (f : Val S)
    (hf : IsSelfBounding d f) (s : ∀ j, S j) (hs : 0 < f s) :
    ∑ i, truncLog (coordInf f s i) (f s) ≤ 2 * d := by
  sorry

/-- Rubric 2, estimate (6): total candidate mass `∑_i q_i ≤ 2(d+1)`. [ConstantApproximationForPrivate, node_14] -/
theorem candMass_sum_le {n : ℕ} {S : Fin n → Type} (d : ℝ) (hd : 1 ≤ d)
    (s : ∀ j, S j) (v : Fin n → Val S) (hv : ∀ j, v j ∈ SBDomain S d) :
    ∑ i, candMass s v i ≤ 2 * (d + 1) := by
  sorry

/-- Welfare estimate: `∑_i q_i w_i ≥ max_i w_i / (2 ln 2)` for nonnegative valuations. [ConstantApproximationForPrivate, node_14] -/
theorem candMass_welfare {n : ℕ} {S : Fin n → Type}
    (s : ∀ j, S j) (v : Fin n → Val S) (hv : ∀ j, ∀ t, 0 ≤ v j t) (i : Fin n) :
    v i s ≤ 2 * Real.log 2 * ∑ j, candMass s v j * v j s := by
  sorry

/-! ## SOS valuations -/

/-- Submodular over signals: for every `i`, `a ≤ b` in `S_i` and `u_{-i} ≤ z_{-i}`,
`f(b, z_{-i}) − f(a, z_{-i}) ≤ f(b, u_{-i}) − f(a, u_{-i})`. -/
def IsSOS {n : ℕ} {S : Fin n → Type} [∀ i, LinearOrder (S i)] (f : Val S) : Prop :=
  ∀ (i : Fin n) (a b : S i), a ≤ b → ∀ u z : (∀ j, S j), (∀ j, j ≠ i → u j ≤ z j) →
    f (Function.update z i b) - f (Function.update z i a)
      ≤ f (Function.update u i b) - f (Function.update u i a)

/-- Coordinatewise nondecreasing. -/
def IsMonotoneVal {n : ℕ} {S : Fin n → Type} [∀ i, LinearOrder (S i)] (f : Val S) : Prop :=
  ∀ s t : (∀ j, S j), (∀ j, s j ≤ t j) → f s ≤ f t

/-- Domain of monotone nonnegative SOS valuations. -/
def MonoSOSDomain {n : ℕ} (S : Fin n → Type) [∀ i, LinearOrder (S i)] : Set (Val S) :=
  {f | (∀ s, 0 ≤ f s) ∧ IsSOS f ∧ IsMonotoneVal f}

/-- Domain of arbitrary nonnegative SOS valuations. -/
def SOSDomain {n : ℕ} (S : Fin n → Type) [∀ i, LinearOrder (S i)] : Set (Val S) :=
  {f | (∀ s, 0 ≤ f s) ∧ IsSOS f}

/-- Rubric 3: monotone nonnegative SOS functions are 1-self-bounding. [ConstantApproximationForPrivate, node_14] -/
theorem monoSOS_selfBounding {n : ℕ} {S : Fin n → Type} [∀ i, LinearOrder (S i)]
    [∀ i, Nonempty (S i)] (f : Val S) (hf : f ∈ MonoSOSDomain S) :
    IsSelfBounding 1 f := by
  sorry

/-- Rubric 3: nonnegative SOS functions are 2-self-bounding. [ConstantApproximationForPrivate, node_14] -/
theorem SOS_selfBounding {n : ℕ} {S : Fin n → Type} [∀ i, LinearOrder (S i)]
    [∀ i, Nonempty (S i)] (f : Val S) (hf : f ∈ SOSDomain S) :
    IsSelfBounding 2 f := by
  sorry

/-- The numerical constants: `8 ln 2 < 5.55` and `12 ln 2 < 8.32`. [ConstantApproximationForPrivate, node_14] -/
theorem numeric_constants : 8 * Real.log 2 < 5.55 ∧ 12 * Real.log 2 < 8.32 := by
  sorry

/-! ## Lower bound with public valuations -/

/-- Signals-only mechanism with public valuation profile: allocation and payment
depend only on the reported signals. -/
def PublicFeasible {n : ℕ} {S : Fin n → Type} (x : (∀ j, S j) → Fin n → ℝ) : Prop :=
  ∀ s, (∀ i, 0 ≤ x s i) ∧ ∑ i, x s i ≤ 1

/-- EPIC-IR with public valuations `v`: only signal deviations. -/
def PublicEPICIR {n : ℕ} {S : Fin n → Type} (v : Fin n → Val S)
    (x p : (∀ j, S j) → Fin n → ℝ) : Prop :=
  ∀ (s : ∀ j, S j) (i : Fin n),
    (∀ s' : S i, x (Function.update s i s') i * v i s - p (Function.update s i s') i
        ≤ x s i * v i s - p s i) ∧
    0 ≤ x s i * v i s - p s i

/-- Approximation factor `α` with public valuations `v`. -/
def PublicApprox {n : ℕ} {S : Fin n → Type} (v : Fin n → Val S)
    (x : (∀ j, S j) → Fin n → ℝ) (α : ℝ) : Prop :=
  ∀ (s : ∀ j, S j) (i : Fin n), v i s ≤ α * ∑ j, x s j * v j s

/-- The hard instance: `m` bidders with signals in `Bool` and
`v_i(s) = ∏_{j ≠ i} s_j + ε s_i`. -/
def lbVal (m : ℕ) (ε : ℝ) (i : Fin m) : Val (fun _ : Fin m => Bool) :=
  fun s => (∏ j ∈ Finset.univ.erase i, (if s j then (1 : ℝ) else 0))
    + ε * (if s i then (1 : ℝ) else 0)

/-- Rubric 4: the hard valuations are `r`-self-bounding with `r + 1` bidders. [ConstantApproximationForPrivate, node_14] -/
theorem lbVal_selfBounding (r : ℕ) (hr : 1 ≤ r) (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1)
    (i : Fin (r + 1)) : IsSelfBounding (r : ℝ) (lbVal (r + 1) ε i) := by
  sorry

/-- Rubric 4: on the hard instance, any feasible EPIC-IR α-approximation has
`α ≥ m / (1 + m ε)` with `m = r + 1`. [ConstantApproximationForPrivate, node_14] -/
theorem lbVal_factor (r : ℕ) (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1) (α : ℝ) (hα : 0 < α)
    (x p : (∀ _ : Fin (r + 1), Bool) → Fin (r + 1) → ℝ)
    (hF : PublicFeasible x) (hIC : PublicEPICIR (lbVal (r + 1) ε) x p)
    (hA : PublicApprox (lbVal (r + 1) ε) x α) :
    ((r : ℝ) + 1) / (1 + ((r : ℝ) + 1) * ε) ≤ α := by
  sorry

/-! ## Main theorems -/

/-- Known common bound `d ∈ [1, n]`: a feasible EPIC-IR mechanism on `d`-self-bounding
valuations with approximation factor `4(d+1) ln 2`. [ConstantApproximationForPrivate, node_14] -/
theorem known_bound_mechanism {n : ℕ} (S : Fin n → Type) [∀ i, Nonempty (S i)]
    (d : ℝ) (hd1 : 1 ≤ d) (hdn : d ≤ n) :
    ∃ M : Mechanism S, Feasible (SBDomain S d) M ∧ EPICIR (SBDomain S d) M ∧
      ApproxWithin (SBDomain S d) M (4 * (d + 1) * Real.log 2) := by
  sorry

/-- Unknown bound: a single mechanism, feasible and EPIC-IR on all nonnegative valuations
(which are exactly the `n`-self-bounding ones), with factor `8(d+1) ln 2` on every profile of
`d`-self-bounding valuations, simultaneously for all `d ∈ [1, n]`. [ConstantApproximationForPrivate, node_14] -/
theorem unknown_bound_mechanism {n : ℕ} (S : Fin n → Type) [∀ i, Nonempty (S i)]
    (hn : 1 ≤ n) :
    ∃ M : Mechanism S, Feasible (SBDomain S n) M ∧ EPICIR (SBDomain S n) M ∧
      ∀ d : ℝ, 1 ≤ d → d ≤ n →
        ApproxWithin (SBDomain S d) M (8 * (d + 1) * Real.log 2) := by
  sorry

/-- Monotone SOS valuations: factor `8 ln 2`. [ConstantApproximationForPrivate, node_14] -/
theorem monotone_sos_mechanism {n : ℕ} (S : Fin n → Type) [∀ i, LinearOrder (S i)]
    [∀ i, Nonempty (S i)] (hn : 1 ≤ n) :
    ∃ M : Mechanism S, Feasible (MonoSOSDomain S) M ∧ EPICIR (MonoSOSDomain S) M ∧
      ApproxWithin (MonoSOSDomain S) M (8 * Real.log 2) := by
  sorry

/-- Arbitrary nonnegative SOS valuations: factor `12 ln 2` (for `n ≥ 2` apply the `d = 2`
mechanism; for `n = 1` allocating for free is optimal). [ConstantApproximationForPrivate, node_14] -/
theorem sos_mechanism {n : ℕ} (S : Fin n → Type) [∀ i, LinearOrder (S i)]
    [∀ i, Nonempty (S i)] (hn : 1 ≤ n) :
    ∃ M : Mechanism S, Feasible (SOSDomain S) M ∧ EPICIR (SOSDomain S) M ∧
      ApproxWithin (SOSDomain S) M (12 * Real.log 2) := by
  sorry

/-- Lower bound `Ω(d)`: if every public profile of `d`-self-bounding valuations on
`⌊d⌋ + 1` bidders with Boolean signals admits a feasible signals-only EPIC-IR mechanism with
factor `α`, then `α ≥ d` (in fact `α ≥ ⌊d⌋ + 1`). [ConstantApproximationForPrivate, node_14] -/
theorem lower_bound_linear_in_d (d : ℝ) (hd : 1 ≤ d) (α : ℝ) (hα : 0 < α)
    (h : ∀ v : Fin (⌊d⌋₊ + 1) → Val (fun _ : Fin (⌊d⌋₊ + 1) => Bool),
      (∀ i, IsSelfBounding d (v i)) →
      ∃ x p : (∀ _ : Fin (⌊d⌋₊ + 1), Bool) → Fin (⌊d⌋₊ + 1) → ℝ,
        PublicFeasible x ∧ PublicEPICIR v x p ∧ PublicApprox v x α) :
    (⌊d⌋₊ : ℝ) + 1 ≤ α := by
  sorry

end TCSChallenge.ConstantApproximationForPrivate.node_14
