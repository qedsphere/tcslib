/-!
## Multi-unit auctions with private interdependent, self-bounding valuations

`m` identical items, `n` unit-demand bidders. Bidder `i` privately knows a signal
`s_i ∈ S_i` and a `d`-self-bounding valuation function `v_i : ∏_j S_j → ℝ_{≥0}`.
A randomized direct mechanism picks a random set `W` of at most `m` winners and charges
expected payments.

Main theorem `multiUnit_constant_approx`: there is a universal `C > 0` such that for all
`n, m ≥ 1`, signal sets and `d ∈ [1, n]` there is an EPIC-IR mechanism, ex-post feasible,
with `E[∑_{i ∈ W} v_i(s)] ≥ max_{|A| ≤ m} ∑_{i ∈ A} v_i(s) / (C d)` on every admissible
truthful profile. The explicit version `multiUnit_explicit_factor` has factor
`8(d+1) ln 2 ≤ 16 ln 2 · d`.
-/

namespace TCSChallenge.ConstantApproximationForPrivate.node_28

/-! ## Shared definitions (identical in all files of this paper) -/

/-- A valuation function `v : S → ℝ` on signal profiles `S = ∏_{j} S_j`. -/
abbrev Val {n : ℕ} (S : Fin n → Type) : Type := (∀ j, S j) → ℝ

/-- The coordinate infimum `inf_{t ∈ S_i} f(t, s_{-i})`. -/
def coordInf {n : ℕ} {S : Fin n → Type} (f : Val S) (s : ∀ j, S j) (i : Fin n) : ℝ :=
  ⨅ t : S i, f (Function.update s i t)

/-- "`f` is `d`-self-bounding": `f ≥ 0` and
`∑_{i=1}^n (f(s) − inf_{t∈S_i} f(t,s_{-i})) ≤ d f(s)` for every `s ∈ S`. -/
def IsSelfBounding {n : ℕ} {S : Fin n → Type} (d : ℝ) (f : Val S) : Prop :=
  (∀ s, 0 ≤ f s) ∧ ∀ s, ∑ i, (f s - coordInf f s i) ≤ d * f s

/-- The domain of `d`-self-bounding valuations. -/
def SBDomain {n : ℕ} (S : Fin n → Type) (d : ℝ) : Set (Val S) :=
  {f | IsSelfBounding d f}

/-- Truncated logarithm `L_c(t) = max{0, min{1, log₂(t/c)}}` for `c, t > 0`;
`L_c(0) = 0`; `L_0(t) = 1` for `t > 0`. -/
def truncLog (c t : ℝ) : ℝ :=
  if t ≤ 0 then 0 else if c ≤ 0 then 1 else max 0 (min 1 (Real.logb 2 (t / c)))

/-- Randomly shifted power-of-two rounding: `f_r(0) = 0` and
`f_r(w) = 2^{r + ⌊log₂ w − r⌋}` for `w > 0`. -/
def roundGrid (r w : ℝ) : ℝ :=
  if w ≤ 0 then 0 else (2 : ℝ) ^ (r + (⌊Real.logb 2 w - r⌋ : ℝ))

/-- Lexicographic comparison of bidder-labelled numbers: `(a, i)` beats `(b, j)` under
rounding `r` and priority `π` if `f_r(a) > f_r(b)`, or they tie and `i` has the higher
priority (`π j < π i`). -/
def Beats {n : ℕ} (r : ℝ) (π : Equiv.Perm (Fin n)) (a : ℝ) (i : Fin n) (b : ℝ) (j : Fin n) :
    Prop :=
  roundGrid r b < roundGrid r a ∨ (roundGrid r a = roundGrid r b ∧ π j < π i)

/-! ## Multi-unit mechanisms -/

/-- A randomized direct mechanism for `m` identical items: a lottery (weights on winner
sets) and expected payments, as functions of reported signals and valuation functions. -/
structure MultiMechanism {n : ℕ} (S : Fin n → Type) where
  lottery : (∀ j, S j) → (Fin n → Val S) → Finset (Fin n) → ℝ
  pay : (∀ j, S j) → (Fin n → Val S) → Fin n → ℝ

/-- Allocation probability `x_i = Pr[i ∈ W]`. -/
def MultiMechanism.alloc {n : ℕ} {S : Fin n → Type} (M : MultiMechanism S)
    (s : ∀ j, S j) (v : Fin n → Val S) (i : Fin n) : ℝ :=
  ∑ W ∈ Finset.univ.filter (fun W : Finset (Fin n) => i ∈ W), M.lottery s v W

/-- Expected welfare `E[∑_{i ∈ W} v_i(s)]`. -/
def MultiMechanism.welfare {n : ℕ} {S : Fin n → Type} (M : MultiMechanism S)
    (s : ∀ j, S j) (v : Fin n → Val S) : ℝ :=
  ∑ W : Finset (Fin n), M.lottery s v W * ∑ i ∈ W, v i s

/-- Ex-post feasibility: the lottery is a probability distribution on sets of at most `m`
distinct winners, at every admissible report. -/
def MFeasible {n : ℕ} {S : Fin n → Type} (m : ℕ) (D : Set (Val S)) (M : MultiMechanism S) :
    Prop :=
  ∀ (s : ∀ j, S j) (v : Fin n → Val S), (∀ j, v j ∈ D) →
    (∀ W, 0 ≤ M.lottery s v W) ∧ (∑ W, M.lottery s v W = 1) ∧
    ∀ W : Finset (Fin n), m < W.card → M.lottery s v W = 0

/-- EPIC-IR on a domain, for joint signal/function deviations. -/
def MEPICIR {n : ℕ} {S : Fin n → Type} (D : Set (Val S)) (M : MultiMechanism S) : Prop :=
  ∀ (s : ∀ j, S j) (v : Fin n → Val S), (∀ j, v j ∈ D) → ∀ i : Fin n,
    (∀ (s' : S i) (v' : Val S), v' ∈ D →
      M.alloc (Function.update s i s') (Function.update v i v') i * v i s
          - M.pay (Function.update s i s') (Function.update v i v') i
        ≤ M.alloc s v i * v i s - M.pay s v i) ∧
    0 ≤ M.alloc s v i * v i s - M.pay s v i

/-! ## The explicit filtering rule -/

/-- Multi-unit candidate condition: `w_i > 0` and `(f_r(w_i), π_i) > (f_r(q_{ji}), π_j)` for
at least `n − m` bidders `j ≠ i`, where `B j = q_{ji} = inf_{t ∈ S_i} v_j(t, s_{-i})`. -/
def IsCandidateM {n : ℕ} (m : ℕ) (w : Fin n → ℝ) (B : Fin n → ℝ) (i : Fin n) (r : ℝ)
    (π : Equiv.Perm (Fin n)) : Prop :=
  0 < w i ∧
    n - m ≤ (Finset.univ.filter (fun j : Fin n => j ≠ i ∧ Beats r π (w i) i (B j) j)).card

/-- `E_{r,π}[c_i]` for the multi-unit candidate indicator. -/
def candMassM {n : ℕ} {S : Fin n → Type} (m : ℕ) (s : ∀ j, S j) (v : Fin n → Val S)
    (i : Fin n) : ℝ :=
  (1 / (n.factorial : ℝ)) * ∑ π : Equiv.Perm (Fin n),
    ∫ r in (0 : ℝ)..1,
      (if IsCandidateM m (fun k => v k s) (fun j => coordInf (v j) s i) i r π
        then (1 : ℝ) else 0)

/-! ## Lemma stubs (rubric items) -/

/-- Identity (1): `Pr_r[f_r(a) > f_r(b)] = L(a, b)` for `a > 0`, `b ≥ 0`. [ConstantApproximationForPrivate, node_28] -/
theorem prob_round_gt (a b : ℝ) (ha : 0 < a) (hb : 0 ≤ b) :
    (∫ r in (0 : ℝ)..1, (if roundGrid r b < roundGrid r a then (1 : ℝ) else 0))
      = truncLog b a := by
  sorry

/-- Inequality (2): `L(a, c) ≤ L(a, b) + L(b, c)` for `a, b > 0`, `c ≥ 0`. [ConstantApproximationForPrivate, node_28] -/
theorem truncLog_triangle (a b c : ℝ) (ha : 0 < a) (hb : 0 < b) (hc : 0 ≤ c) :
    truncLog c a ≤ truncLog b a + truncLog c b := by
  sorry

/-- Inequality (3): a `d`-self-bounding `v` with `w = v(s) > 0` has
`∑_i L(w, inf_i v) ≤ 2d`. [ConstantApproximationForPrivate, node_28] -/
theorem sum_truncLog_le {n : ℕ} {S : Fin n → Type} (d : ℝ) (f : Val S)
    (hf : IsSelfBounding d f) (s : ∀ j, S j) (hs : 0 < f s) :
    ∑ i, truncLog (coordInf f s i) (f s) ≤ 2 * d := by
  sorry

/-- Rubric 4: `x_i` depends on bidder `i`'s report only through `w_i = v_i(s)`. [ConstantApproximationForPrivate, node_28] -/
theorem candMassM_depends_only_on_value {n : ℕ} {S : Fin n → Type} (m : ℕ)
    (s : ∀ j, S j) (v : Fin n → Val S) (i : Fin n) (s' : S i) (v' : Val S)
    (h : v' (Function.update s i s') = v i s) :
    candMassM m (Function.update s i s') (Function.update v i v') i = candMassM m s v i := by
  sorry

/-- Rubric 4: payments `p(w) = w g(w) − ∫_0^w g` implement a monotone scalar allocation
curve `g` truthfully and individually rationally. [ConstantApproximationForPrivate, node_28] -/
theorem myerson_payment (g : ℝ → ℝ) (hg : Monotone g) (hg0 : ∀ t, 0 ≤ g t)
    (y z : ℝ) (hy : 0 ≤ y) (hz : 0 ≤ z) :
    y * g z - (z * g z - ∫ t in (0 : ℝ)..z, g t)
        ≤ y * g y - (y * g y - ∫ t in (0 : ℝ)..y, g t) ∧
      0 ≤ y * g y - (y * g y - ∫ t in (0 : ℝ)..y, g t) := by
  sorry

/-- Rubric 3, estimate (12): `∑_i E[c_i] ≤ 4(d+1) m`. [ConstantApproximationForPrivate, node_28] -/
theorem candMassM_sum_le {n : ℕ} {S : Fin n → Type} (m : ℕ) (hm : 1 ≤ m) (hmn : m ≤ n)
    (d : ℝ) (hd : 1 ≤ d) (s : ∀ j, S j) (v : Fin n → Val S) (hv : ∀ j, v j ∈ SBDomain S d) :
    ∑ i, candMassM m s v i ≤ 4 * (d + 1) * m := by
  sorry

/-- Rubric 5: any `x ∈ [0,1]^n` with `∑ x_i ≤ m` is the marginal vector of a lottery over
sets of at most `m` winners. [ConstantApproximationForPrivate, node_28] -/
theorem dependent_rounding {n : ℕ} (m : ℕ) (x : Fin n → ℝ) (hx0 : ∀ i, 0 ≤ x i)
    (hx1 : ∀ i, x i ≤ 1) (hsum : ∑ i, x i ≤ m) :
    ∃ P : Finset (Fin n) → ℝ, (∀ W, 0 ≤ P W) ∧ (∑ W, P W = 1) ∧
      (∀ W : Finset (Fin n), m < W.card → P W = 0) ∧
      ∀ i, ∑ W ∈ Finset.univ.filter (fun W : Finset (Fin n) => i ∈ W), P W = x i := by
  sorry

/-- Rubric 6: for every `A` with `|A| ≤ m`,
`∑_{i∈A} v_i(s) ≤ 2 ln 2 · ∑_i E[c_i] v_i(s)` (top-`m` rounded bidders are candidates and
`E_r[f_r(w)] = w / (2 ln 2)`). [ConstantApproximationForPrivate, node_28] -/
theorem candMassM_welfare {n : ℕ} {S : Fin n → Type} (m : ℕ)
    (s : ∀ j, S j) (v : Fin n → Val S) (hv : ∀ j, ∀ t, 0 ≤ v j t)
    (A : Finset (Fin n)) (hA : A.card ≤ m) :
    ∑ i ∈ A, v i s ≤ 2 * Real.log 2 * ∑ i, candMassM m s v i * v i s := by
  sorry

/-! ## Main theorems -/

/-- Explicit factor: for `n, m ≥ 1` and `d ∈ [1, n]` there is an ex-post feasible EPIC-IR
mechanism with `OPT ≤ 8(d+1) ln 2 · E[welfare]` on every admissible truthful profile. [ConstantApproximationForPrivate, node_28] -/
theorem multiUnit_explicit_factor {n : ℕ} (S : Fin n → Type) [∀ i, Nonempty (S i)]
    (m : ℕ) (hm : 1 ≤ m) (d : ℝ) (hd1 : 1 ≤ d) (hdn : d ≤ n) :
    ∃ M : MultiMechanism S, MFeasible m (SBDomain S d) M ∧ MEPICIR (SBDomain S d) M ∧
      ∀ (s : ∀ j, S j) (v : Fin n → Val S), (∀ j, v j ∈ SBDomain S d) →
        ∀ A : Finset (Fin n), A.card ≤ m →
          ∑ i ∈ A, v i s ≤ 8 * (d + 1) * Real.log 2 * M.welfare s v := by
  sorry

/-- Main theorem: a universal constant `C` such that every instance admits an ex-post
feasible EPIC-IR mechanism with `E[∑_{i ∈ W} v_i(s)] ≥ max_{|A| ≤ m} ∑_{i∈A} v_i(s) / (C d)`. [ConstantApproximationForPrivate, node_28] -/
theorem multiUnit_constant_approx :
    ∃ C : ℝ, 0 < C ∧ ∀ (n m : ℕ) (S : Fin n → Type), (∀ i, Nonempty (S i)) →
      1 ≤ n → 1 ≤ m → ∀ d : ℝ, 1 ≤ d → d ≤ n →
        ∃ M : MultiMechanism S, MFeasible m (SBDomain S d) M ∧ MEPICIR (SBDomain S d) M ∧
          ∀ (s : ∀ j, S j) (v : Fin n → Val S), (∀ j, v j ∈ SBDomain S d) →
            ∀ A : Finset (Fin n), A.card ≤ m →
              ∑ i ∈ A, v i s ≤ C * d * M.welfare s v := by
  sorry

end TCSChallenge.ConstantApproximationForPrivate.node_28
