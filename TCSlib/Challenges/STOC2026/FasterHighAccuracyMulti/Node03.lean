/-!
## High-accuracy maximum-throughput multicommodity flow via a centred circulation LP

A directed simple graph `G = (V, E)` with capacities `u`, and `k` terminal pairs
`(s_i, t_i)`. A feasible routing has nonnegative flows `f_i`, values `F_i ≥ 0`, net outflow
`F_i` at `s_i`, `-F_i` at `t_i`, `0` elsewhere, and `∑_i f_i(e) ≤ u_e`. `OPT` is the maximum
throughput `∑_i F_i`.

The algorithm rounds capacities to `w_e = ⌊u_e/β⌋` with `β = ε/(4m)`, adds a hub vertex `h`
(here `none : Option V`) with arcs `v → h`, `h → v` of capacity `H = 2k + 2 m B₀ + 1`, and
costs `c_i(t_i → h) = -1`, `c_i(h → s_i) = 0`, all other hub arcs `+1`, original arcs `0`.
The zero-demand circulation LP has minimum cost `-OPT_w`. An explicit exactly-centred
primal–dual point exists for an auxiliary objective `c⁰`; after tracking to
`T = 512 H (k+2)` the objective may be switched to `c`; tracking down to `τ = 1/(8D)`,
`D = (k+1) M`, gives gap `< 1/4`, and extraction yields an exactly feasible routing.

Main theorem: `main_correctness`. Lemma stubs follow the rubric.
-/

namespace TCSChallenge.FasterHighAccuracyMulti.node_03

/-! ## Original instance -/

/-- Net outflow at `v` of an arc function `g` supported on the arc set `A`:
`∑_{a ∈ A, tail a = v} g a - ∑_{a ∈ A, head a = v} g a`. -/
def netOut {α : Type} [DecidableEq α] (A : Finset (α × α)) (g : α × α → ℝ) (v : α) : ℝ :=
  ∑ a ∈ A.filter (fun a => a.1 = v), g a - ∑ a ∈ A.filter (fun a => a.2 = v), g a

/-- "a simple directed graph": no loops (multi-edges are excluded by `E` being a finset of
ordered pairs). -/
def IsSimpleDigraph {V : Type} (E : Finset (V × V)) : Prop :=
  ∀ e ∈ E, e.1 ≠ e.2

/-- "A feasible routing consists of nonnegative edge flows f_i and values F_i ≥ 0 such that
commodity i has net outflow F_i at s_i, net outflow −F_i at t_i, and zero net outflow
elsewhere, with ∑_i f_i(e) ≤ u_e on every edge. A commodity with coincident terminals is
required to have value zero." Flows are supported on `E`. -/
def IsFeasibleRouting {V : Type} [DecidableEq V] {k : ℕ} (E : Finset (V × V))
    (s t : Fin k → V) (u : V × V → ℝ) (f : Fin k → V × V → ℝ) (F : Fin k → ℝ) : Prop :=
  (∀ i a, 0 ≤ f i a) ∧
  (∀ i a, a ∉ E → f i a = 0) ∧
  (∀ i, 0 ≤ F i) ∧
  (∀ i, s i = t i → F i = 0) ∧
  (∀ i v, netOut E (f i) v = (if v = s i then F i else 0) - (if v = t i then F i else 0)) ∧
  (∀ a ∈ E, ∑ i, f i a ≤ u a)

/-- "Let OPT be the maximum possible throughput ∑_i F_i." -/
def OPT {V : Type} [DecidableEq V] {k : ℕ} (E : Finset (V × V)) (s t : Fin k → V)
    (u : V × V → ℝ) : ℝ :=
  sSup {r : ℝ | ∃ f F, IsFeasibleRouting E s t u f F ∧ r = ∑ i, F i}

/-- Rounded integer capacities `w_e = ⌊u_e / β⌋`. -/
def roundCap {V : Type} (β : ℝ) (u : V × V → ℝ) : V × V → ℕ :=
  fun e => ⌊u e / β⌋₊

/-! ## The augmented circulation LP on `Option V` (hub `h = none`) -/

/-- Arcs of the augmented graph: original arcs, plus `v → h` and `h → v` for every `v`. -/
def augArcs {V : Type} [Fintype V] [DecidableEq V] (E : Finset (V × V)) :
    Finset (Option V × Option V) :=
  E.image (fun e => ((some e.1 : Option V), (some e.2 : Option V))) ∪
    (Finset.univ.image (fun v : V => ((some v : Option V), (none : Option V))) ∪
      Finset.univ.image (fun v : V => ((none : Option V), (some v : Option V))))

/-- Capacities: original arcs keep `w_e`; "every new arc capacity H". -/
def augCap {V : Type} (w : V × V → ℕ) (H : ℝ) : Option V × Option V → ℝ
  | (some a, some b) => (w (a, b) : ℝ)
  | _ => H

/-- "c_i(v→h) = −1 if v = t_i, and +1 otherwise; c_i(h→v) = 0 if v = s_i, and +1
otherwise"; original arcs cost zero. -/
def augCost {V : Type} [DecidableEq V] {k : ℕ} (s t : Fin k → V) (i : Fin k) :
    Option V × Option V → ℝ
  | (some v, none) => if v = t i then -1 else 1
  | (none, some v) => if v = s i then 0 else 1
  | _ => 0

/-- The hub capacity `H = 2k + 2 m B₀ + 1`, `B₀ = max_e w_e`. -/
def hubCap {V : Type} (E : Finset (V × V)) (k : ℕ) (w : V × V → ℕ) : ℝ :=
  2 * (k : ℝ) + 2 * (E.card : ℝ) * ((E.sup w : ℕ) : ℝ) + 1

/-- Primal feasibility of `x = (g_1, …, g_k, q)` for the zero-demand `k`-commodity
circulation LP: "each commodity is conserved at every vertex", `q = v − ∑_i g_i` is the
capacity slack, `x ≥ 0`. -/
def IsCirculation {W : Type} [DecidableEq W] {k : ℕ} (A : Finset (W × W)) (cap : W × W → ℝ)
    (g : Fin k → W × W → ℝ) (q : W × W → ℝ) : Prop :=
  (∀ i a, 0 ≤ g i a) ∧ (∀ a, 0 ≤ q a) ∧
  (∀ i a, a ∉ A → g i a = 0) ∧
  (∀ i v, netOut A (g i) v = 0) ∧
  (∀ a ∈ A, ∑ i, g i a + q a = cap a)

/-- Objective value `∑_i ∑_a c_i(a) g_i(a)` (capacity slacks have cost zero). -/
def circCost {W : Type} {k : ℕ} (A : Finset (W × W)) (c : Fin k → W × W → ℝ)
    (g : Fin k → W × W → ℝ) : ℝ :=
  ∑ i, ∑ a ∈ A, c i a * g i a

/-- Minimum circulation cost. -/
def minCirc {W : Type} [DecidableEq W] {k : ℕ} (A : Finset (W × W)) (cap : W × W → ℝ)
    (c : Fin k → W × W → ℝ) : ℝ :=
  sInf {r : ℝ | ∃ g q, IsCirculation A cap g q ∧ r = circCost A c g}

/-- A primal–dual point: primal `(g, q)`, vertex potentials `p_i` for the conservation
rows and `z` for the capacity rows. -/
structure PDPoint (W : Type) (k : ℕ) where
  g : Fin k → W × W → ℝ
  q : W × W → ℝ
  p : Fin k → W → ℝ
  z : W × W → ℝ

/-- Standard-form dual slack of the flow coordinate `g_i(a)`:
`c_i(a) − p_i(tail a) + p_i(head a) − z_a`. -/
def slackF {W : Type} {k : ℕ} (c : Fin k → W × W → ℝ) (x : PDPoint W k) (i : Fin k)
    (a : W × W) : ℝ :=
  c i a - x.p i a.1 + x.p i a.2 - x.z a

/-- Dual slack of the capacity-slack coordinate `q_a` (cost zero): `−z_a`. -/
def slackQ {W : Type} {k : ℕ} (x : PDPoint W k) (a : W × W) : ℝ :=
  - x.z a

/-- Dual objective `∑_a z_a cap_a` (conservation right-hand sides are zero). -/
def dualObj {W : Type} {k : ℕ} (A : Finset (W × W)) (cap : W × W → ℝ) (x : PDPoint W k) :
    ℝ :=
  ∑ a ∈ A, x.z a * cap a

/-- Primal–dual feasible with `x > 0`, `s > 0`, and `‖xs/τ − 1‖_∞ ≤ δ`
(coordinatewise over the actual LP coordinates `(i, a)`, `a ∈ A`, and `q_a`, `a ∈ A`). -/
def IsCentered {W : Type} [DecidableEq W] {k : ℕ} (A : Finset (W × W)) (cap : W × W → ℝ)
    (c : Fin k → W × W → ℝ) (x : PDPoint W k) (τ δ : ℝ) : Prop :=
  IsCirculation A cap x.g x.q ∧
  (∀ i, ∀ a ∈ A, 0 < x.g i a ∧ 0 < slackF c x i a ∧
      |x.g i a * slackF c x i a / τ - 1| ≤ δ) ∧
  (∀ a ∈ A, 0 < x.q a ∧ 0 < slackQ x a ∧ |x.q a * slackQ x a / τ - 1| ≤ δ)

/-! ## The explicit centred initial point -/

/-- `b(v)`: net outflow of the original-edge flow `w_e/(k+1)` (identical for all commodities). -/
def baseImbalance {V : Type} [DecidableEq V] (E : Finset (V × V)) (k : ℕ) (w : V × V → ℕ)
    (v : V) : ℝ :=
  netOut E (fun e => (w e : ℝ) / ((k : ℝ) + 1)) v

/-- "f_i^0(e) = w_e/(k+1)" on original edges, "f_i^0(v→h) = 1 + max{−b_i(v),0},
f_i^0(h→v) = 1 + max{b_i(v),0}". -/
def initFlow {V : Type} [DecidableEq V] (E : Finset (V × V)) (k : ℕ) (w : V × V → ℕ) :
    Option V × Option V → ℝ
  | (some x, some y) => if (x, y) ∈ E then (w (x, y) : ℝ) / ((k : ℝ) + 1) else 0
  | (some v, none) => 1 + max (-(baseImbalance E k w v)) 0
  | (none, some v) => 1 + max (baseImbalance E k w v) 0
  | (none, none) => 0

/-- "Set q^0 equal to the remaining capacity." -/
def initSlack {V : Type} [DecidableEq V] (E : Finset (V × V)) (k : ℕ) (w : V × V → ℕ)
    (H : ℝ) (a : Option V × Option V) : ℝ :=
  augCap w H a - (k : ℝ) * initFlow E k w a

/-- The initial primal–dual point: `g_i = f^0`, `q = q^0`, `p_i^0 = 0`, `z_e^0 = −1/q^0(e)`. -/
def initPoint {V : Type} [DecidableEq V] (E : Finset (V × V)) (k : ℕ) (w : V × V → ℕ)
    (H : ℝ) : PDPoint (Option V) k where
  g := fun _ => initFlow E k w
  q := initSlack E k w H
  p := fun _ _ => 0
  z := fun a => -1 / initSlack E k w H a

/-- The auxiliary objective "c_i^0(e) = 1/f_i^0(e) − 1/q^0(e)". -/
def initCost {V : Type} [DecidableEq V] (E : Finset (V × V)) (k : ℕ) (w : V × V → ℕ)
    (H : ℝ) : Fin k → Option V × Option V → ℝ :=
  fun _ a => 1 / initFlow E k w a - 1 / initSlack E k w H a

/-! ## Rubric 1: rounding, encoding and exact extraction -/

/-- Step 1: "βQ ≥ OPT − mβ", with `Q` the optimum for capacities `w_e = ⌊u_e/β⌋`
(stated with the scaled capacities `β w_e`). [FasterHighAccuracyMulti, node_03] -/
theorem rounding_loss {V : Type} [DecidableEq V] {k : ℕ} (E : Finset (V × V))
    (s t : Fin k → V) (u : V × V → ℝ) (hu : ∀ e, 0 ≤ u e) (β : ℝ) (hβ : 0 < β) :
    OPT E s t (fun e => β * (roundCap β u e : ℝ)) ≥ OPT E s t u - (E.card : ℝ) * β := by
  sorry

/-- Exact extraction: every circulation of the augmented LP yields an exactly feasible
original routing, obtained only by deleting flow, of throughput at least minus its cost. [FasterHighAccuracyMulti, node_03] -/
theorem extraction {V : Type} [Fintype V] [DecidableEq V] {k : ℕ} (E : Finset (V × V))
    (hE : IsSimpleDigraph E) (s t : Fin k → V) (hst : ∀ i, s i ≠ t i)
    (w : V × V → ℕ) (H : ℝ) (g : Fin k → Option V × Option V → ℝ)
    (q : Option V × Option V → ℝ) (hg : IsCirculation (augArcs E) (augCap w H) g q) :
    ∃ f F, IsFeasibleRouting E s t (fun e => (w e : ℝ)) f F ∧
      (∀ i, ∀ e ∈ E, f i e ≤ g i ((some e.1 : Option V), (some e.2 : Option V))) ∧
      - circCost (augArcs E) (augCost s t) g ≤ ∑ i, F i := by
  sorry

/-- Encoding: the minimum circulation cost equals `−Q`. [FasterHighAccuracyMulti, node_03] -/
theorem encoding_minCirc {V : Type} [Fintype V] [DecidableEq V] {k : ℕ}
    (E : Finset (V × V)) (hE : IsSimpleDigraph E) (s t : Fin k → V)
    (hst : ∀ i, s i ≠ t i) (w : V × V → ℕ) :
    minCirc (augArcs E) (augCap w (hubCap E k w)) (augCost s t) =
      - OPT E s t (fun e => (w e : ℝ)) := by
  sorry

/-! ## Rubric 2: explicit centred initialization -/

/-- The explicit point is strictly positive, feasible, exactly centred at parameter `1` for
the auxiliary objective, has coordinates in `[1/(k+1), H]`, and `|c⁰| ≤ k+1`. [FasterHighAccuracyMulti, node_03] -/
theorem init_centered {V : Type} [Fintype V] [DecidableEq V] {k : ℕ} (hk : 1 ≤ k)
    (E : Finset (V × V)) (hE : IsSimpleDigraph E) (w : V × V → ℕ)
    (hw : ∀ e ∈ E, 1 ≤ w e) :
    let H := hubCap E k w
    let A := augArcs E
    IsCentered A (augCap w H) (initCost E k w H) (initPoint E k w H) 1 0 ∧
    (∀ a ∈ A, 1 / ((k : ℝ) + 1) ≤ initFlow E k w a ∧ initFlow E k w a ≤ H ∧
        1 / ((k : ℝ) + 1) ≤ initSlack E k w H a ∧ initSlack E k w H a ≤ H) ∧
    (∀ i, ∀ a ∈ A, |initCost E k w H i a| ≤ (k : ℝ) + 1) := by
  sorry

/-! ## Rubric 3: valid objective change at `T = 512 H (k+2)` -/

/-- Replacing `c⁰` by `c` at parameter `T = 512 H (k+2)` keeps the point positive and in the
`1/64` neighbourhood (the primal and `p, z` are unchanged; only the slacks move). [FasterHighAccuracyMulti, node_03] -/
theorem objective_switch {V : Type} [Fintype V] [DecidableEq V] {k : ℕ} (hk : 1 ≤ k)
    (E : Finset (V × V)) (hE : IsSimpleDigraph E) (s t : Fin k → V) (w : V × V → ℕ)
    (hw : ∀ e ∈ E, 1 ≤ w e) (x : PDPoint (Option V) k)
    (hx : IsCentered (augArcs E) (augCap w (hubCap E k w)) (initCost E k w (hubCap E k w)) x
      (512 * hubCap E k w * ((k : ℝ) + 2)) (1 / 128)) :
    IsCentered (augArcs E) (augCap w (hubCap E k w)) (augCost s t) x
      (512 * hubCap E k w * ((k : ℝ) + 2)) (1 / 64) := by
  sorry

/-! ## Rubric 4: gap identity and final accuracy -/

/-- Primal–dual gap identity: `cᵀx − dual objective = xᵀs`. [FasterHighAccuracyMulti, node_03] -/
theorem gap_identity {W : Type} [DecidableEq W] {k : ℕ} (A : Finset (W × W))
    (cap : W × W → ℝ) (c : Fin k → W × W → ℝ) (x : PDPoint W k)
    (hx : IsCirculation A cap x.g x.q) :
    circCost A c x.g - dualObj A cap x =
      ∑ i, ∑ a ∈ A, x.g i a * slackF c x i a + ∑ a ∈ A, x.q a * slackQ x a := by
  sorry

/-- At `τ = 1/(8D)`, `D = (k+1)|A|` (the actual number of primal coordinates), a `1/128`-
centred point has cost `< −Q + 1/4`. [FasterHighAccuracyMulti, node_03] -/
theorem final_accuracy {V : Type} [Fintype V] [DecidableEq V] {k : ℕ} (E : Finset (V × V))
    (hE : IsSimpleDigraph E) (s t : Fin k → V) (hst : ∀ i, s i ≠ t i) (w : V × V → ℕ)
    (x : PDPoint (Option V) k)
    (hx : IsCentered (augArcs E) (augCap w (hubCap E k w)) (augCost s t) x
      (1 / (8 * (((k : ℝ) + 1) * ((augArcs E).card : ℝ)))) (1 / 128)) :
    circCost (augArcs E) (augCost s t) x.g < - OPT E s t (fun e => (w e : ℝ)) + 1 / 4 := by
  sorry

/-! ## Rubric 5: coordinate bounds (first tracking call) and exponent arithmetic -/

/-- The comparison identity `(*)`: for two feasible primal–dual points of the same objective,
`x̄ᵀs + xᵀs̄ = xᵀs + x̄ᵀs̄`. [FasterHighAccuracyMulti, node_03] -/
theorem cross_identity {W : Type} [DecidableEq W] {k : ℕ} (A : Finset (W × W))
    (cap : W × W → ℝ) (c : Fin k → W × W → ℝ) (x y : PDPoint W k)
    (hx : IsCirculation A cap x.g x.q) (hy : IsCirculation A cap y.g y.q) :
    (∑ i, ∑ a ∈ A, y.g i a * slackF c x i a + ∑ a ∈ A, y.q a * slackQ x a) +
      (∑ i, ∑ a ∈ A, x.g i a * slackF c y i a + ∑ a ∈ A, x.q a * slackQ y a) =
    (∑ i, ∑ a ∈ A, x.g i a * slackF c x i a + ∑ a ∈ A, x.q a * slackQ x a) +
      (∑ i, ∑ a ∈ A, y.g i a * slackF c y i a + ∑ a ∈ A, y.q a * slackQ y a) := by
  sorry

/-- First-call bounds: for `1 ≤ t' ≤ T` and a `1/32`-centred point for `c⁰`, every slack is
at most `3 D T (k+1)`, and every coordinate and slack is bounded below by a polynomial
reciprocal (`x_j ≥ t'/(2·3DT(k+1))`, `s_j ≥ t'/(2H)`). [FasterHighAccuracyMulti, node_03] -/
theorem first_call_bounds {V : Type} [Fintype V] [DecidableEq V] {k : ℕ} (hk : 1 ≤ k)
    (E : Finset (V × V)) (hE : IsSimpleDigraph E) (w : V × V → ℕ)
    (hw : ∀ e ∈ E, 1 ≤ w e) (x : PDPoint (Option V) k) (t' : ℝ)
    (ht1 : 1 ≤ t') (htT : t' ≤ 512 * hubCap E k w * ((k : ℝ) + 2))
    (hx : IsCentered (augArcs E) (augCap w (hubCap E k w)) (initCost E k w (hubCap E k w))
      x t' (1 / 32)) :
    let H := hubCap E k w
    let T := 512 * H * ((k : ℝ) + 2)
    let D := ((k : ℝ) + 1) * ((augArcs E).card : ℝ)
    let c0 := initCost E k w H
    (∀ i, ∀ a ∈ augArcs E,
        x.g i a ≤ H ∧ slackF c0 x i a ≤ 3 * D * T * ((k : ℝ) + 1) ∧
        t' / (2 * (3 * D * T * ((k : ℝ) + 1))) ≤ x.g i a ∧ t' / (2 * H) ≤ slackF c0 x i a) ∧
    (∀ a ∈ augArcs E,
        x.q a ≤ H ∧ slackQ x a ≤ 3 * D * T * ((k : ℝ) + 1) ∧
        t' / (2 * (3 * D * T * ((k : ℝ) + 1))) ≤ x.q a ∧ t' / (2 * H) ≤ slackQ x a) := by
  sorry

/-- Matrix-exponent simplification: with `μ_*` as assumed, the three power terms of
`A_{μ_*}(n)` are together at most `3 n^{ω − 1/2}` for `n ≥ 1`. [FasterHighAccuracyMulti, node_03] -/
theorem exponent_simplification (ω : ℝ) (ω11 : ℝ → ℝ) (μs : ℝ) (h0 : 0 ≤ μs) (h1 : μs ≤ 1)
    (hA : ω11 μs - μs / 2 ≤ ω - 1 / 2) (hB : 1 + μs ≤ ω - 1 / 2) (n : ℝ) (hn : 1 ≤ n) :
    n ^ (ω - 1 / 2) + n ^ (ω11 μs - μs / 2) + n ^ (1 + μs) ≤ 3 * n ^ (ω - 1 / 2) := by
  sorry

/-! ## Main theorem: end-to-end correctness of the reduction -/

/-- With `β = ε/(4m)`, `w = ⌊u/β⌋`, edges with `w_e = 0` deleted, hub capacity
`H = 2k + 2mB₀ + 1` and final parameter `τ = 1/(8D)`, `D = (k+1)M`: any primal–dual point
that is `1/128`-centred at `τ` for the throughput costs yields, by extraction and rescaling
by `β`, an exactly feasible routing for the original capacities of throughput
`≥ OPT − ε`, using at most `β` times the hub-LP flow on each original edge. [FasterHighAccuracyMulti, node_03] -/
theorem main_correctness {V : Type} [Fintype V] [DecidableEq V] {k : ℕ}
    (E : Finset (V × V)) (hE : IsSimpleDigraph E) (hEne : E.Nonempty)
    (s t : Fin k → V) (hst : ∀ i, s i ≠ t i) (u : V × V → ℝ) (hu : ∀ e, 0 ≤ u e)
    (ε : ℝ) (hε : 0 < ε) :
    let β := ε / (4 * (E.card : ℝ))
    let w := roundCap β u
    let E' := E.filter (fun e => 1 ≤ w e)
    let H := hubCap E' k w
    let A := augArcs E'
    let τ := 1 / (8 * (((k : ℝ) + 1) * (A.card : ℝ)))
    ∀ x : PDPoint (Option V) k, IsCentered A (augCap w H) (augCost s t) x τ (1 / 128) →
      ∃ f F, IsFeasibleRouting E s t u f F ∧
        OPT E s t u - ε ≤ ∑ i, F i ∧
        (∀ i, ∀ e ∈ E', f i e ≤ β * x.g i ((some e.1 : Option V), (some e.2 : Option V))) := by
  sorry

end TCSChallenge.FasterHighAccuracyMulti.node_03
