/-!
## Functional inverse witnesses have small roABPs over a fixed finite field

Let `F` be a fixed finite field with `q` elements. If `f ∈ F[x₁,…,xₙ]` is computed by a
read-once oblivious ABP (roABP) of size `S` in the order `x₁ < ⋯ < xₙ` and `f` has no zero on
the Boolean cube, then there is a multilinear `g` with `g(a) f(a) = 1` on `{0,1}ⁿ`, computed by
an roABP of size `S^{O_q(1)}` in the same order. Moreover `1 - g f` lies in the Boolean ideal,
which yields an `IPS_LIN'` certificate `C(x,y,z) = g(x) y + ∑ Qᵢ(x) zᵢ` whose placeholder-free
part `C(x,y,0) = g(x) y` is multilinear with a small roABP in the order `x₁ < ⋯ < xₙ < y`.
Consequently, for a family of such `f` with polynomial-size roABPs, the hardness premise
of the functional lower-bound method fails.

Main theorems: `functional_inverse_roABP` and `functional_method_barrier`.
-/

open MvPolynomial

namespace TCSChallenge.LowerBoundsAgainstThe.node_26

/-- A read-once oblivious algebraic branching program in the variable order
`x₀ < x₁ < ⋯ < x_{n-1}` (layer `i` reads only variable `i`): "a layered directed acyclic graph
whose edges from layer `i-1` to layer `i` are labelled by univariate polynomials in `xᵢ`".
Modelled in matrix form: a source vector `src`, layer matrices of univariate polynomials
`layer i`, and a sink vector `snk`, all of the common width `width`. -/
structure RoABP (F : Type) [Field F] (n : ℕ) where
  width : ℕ
  src : Fin width → F
  snk : Fin width → F
  layer : Fin n → Matrix (Fin width) (Fin width) (Polynomial F)

variable {F : Type} [Field F]

/-- The matrix of layer `i` with its univariate labels substituted by the variable `xᵢ`. -/
def RoABP.layerMat {n : ℕ} (P : RoABP F n) (i : Fin n) :
    Matrix (Fin P.width) (Fin P.width) (MvPolynomial (Fin n) F) :=
  Matrix.of fun j k => Polynomial.aeval (X i : MvPolynomial (Fin n) F) (P.layer i j k)

/-- "It computes the sum, over all source-to-sink paths, of the products of the edge labels
along the path": `uᵀ M₁(x₁) ⋯ Mₙ(xₙ) v`, the product taken in the variable order. -/
def RoABP.eval {n : ℕ} (P : RoABP F n) : MvPolynomial (Fin n) F :=
  dotProduct (fun j => C (P.src j))
    ((List.ofFn fun i => P.layerMat i).prod.mulVec (fun j => C (P.snk j)))

/-- "Its size includes the graph and the explicit descriptions of its edge labels":
the width plus the number of coefficients of all edge labels. -/
def RoABP.size {n : ℕ} (P : RoABP F n) : ℕ :=
  P.width + ∑ i, ∑ j, ∑ k, ((P.layer i j k).natDegree + 1)

/-- The Boolean point `a ∈ {0,1}ⁿ` as a point of `Fⁿ`. -/
def boolPt {n : ℕ} (a : Fin n → Bool) : Fin n → F :=
  fun i => if a i then 1 else 0

/-- `p` is multilinear: every variable has degree at most one. -/
def IsMultilinear {σ : Type} (p : MvPolynomial σ F) : Prop :=
  ∀ i, p.degreeOf i ≤ 1

/-- `f(a) ≠ 0` for every `a ∈ {0,1}ⁿ`. -/
def NonzeroOnCube {n : ℕ} (f : MvPolynomial (Fin n) F) : Prop :=
  ∀ a : Fin n → Bool, eval (boolPt a) f ≠ 0

/-- "A functional inverse witness for `f` is a polynomial `g` satisfying `g(a) f(a) = 1` for
every `a ∈ {0,1}ⁿ`." -/
def IsFunctionalInverse {n : ℕ} (f g : MvPolynomial (Fin n) F) : Prop :=
  ∀ a : Fin n → Bool, eval (boolPt a) g * eval (boolPt a) f = 1

/-- The Boolean axiom `bᵢ = xᵢ² - xᵢ`. -/
def boolAxiom {n : ℕ} (i : Fin n) : MvPolynomial (Fin n) F :=
  X i ^ 2 - X i

/-- The Boolean ideal `⟨x₁² - x₁, …, xₙ² - xₙ⟩`. -/
def boolIdeal (F : Type) [Field F] (n : ℕ) : Ideal (MvPolynomial (Fin n) F) :=
  Ideal.span (Set.range (boolAxiom (F := F) (n := n)))

/-- Certificate variables: `Sum.inl i` is `xᵢ`, `Sum.inr none` is the placeholder `y` for `f`,
and `Sum.inr (some i)` is the Boolean placeholder `zᵢ` for `bᵢ`. -/
abbrev CertVar (n : ℕ) : Type := Fin n ⊕ Option (Fin n)

/-- `C` is an `IPS_LIN'` certificate for `f = b₁ = ⋯ = bₙ = 0`:
`C(x,0,0) = 0` and `C(x, f(x), b₁(x), …, bₙ(x)) = 1`. -/
def IsIPSCert {n : ℕ} (f : MvPolynomial (Fin n) F) (cert : MvPolynomial (CertVar n) F) :
    Prop :=
  bind₁ (Sum.elim X (fun _ => (0 : MvPolynomial (Fin n) F))) cert = 0 ∧
  bind₁ (Sum.elim X (fun o => Option.elim o f boolAxiom)) cert = 1

/-- `C(x,y,z) = g(x) y + ∑ᵢ Qᵢ(x) zᵢ`. -/
def linCert {n : ℕ} (g : MvPolynomial (Fin n) F) (Q : Fin n → MvPolynomial (Fin n) F) :
    MvPolynomial (CertVar n) F :=
  rename Sum.inl g * X (Sum.inr none) +
    ∑ i, rename Sum.inl (Q i) * X (Sum.inr (some i))

/-- The placeholder-free part `C(x,y,0)`, as a polynomial in the `n + 1` variables
`x₀ < ⋯ < x_{n-1} < y` (with `y = Fin.last n`). -/
def placeholderFree {n : ℕ} (cert : MvPolynomial (CertVar n) F) :
    MvPolynomial (Fin (n + 1)) F :=
  bind₁ (Sum.elim (fun i => X (Fin.castSucc i))
    (fun o => Option.elim o (X (Fin.last n)) (fun _ => 0))) cert

/-! ## Lemma stubs (rubric items) -/

/-- Rubric 1 (finite-field inverse): pointwise, `f(a)^{q-2} f(a) = f(a)^{q-1} = 1` on the cube.
This is only an equality on the Boolean cube, not a polynomial identity. [LowerBoundsAgainstThe, node_26] -/
theorem pow_isFunctionalInverse [Fintype F] {n : ℕ} (f : MvPolynomial (Fin n) F)
    (hf : NonzeroOnCube f) :
    IsFunctionalInverse f (f ^ (Fintype.card F - 2)) := by
  sorry

/-- Rubric 2 (roABP power construction): Kronecker powers of the layer matrices give an
roABP in the same order, of width `r^k`, computing `f^k`. [LowerBoundsAgainstThe, node_26] -/
theorem roABP_pow {n : ℕ} (P : RoABP F n) (hw : 1 ≤ P.width) (k : ℕ) :
    ∃ P' : RoABP F n, P'.width = P.width ^ k ∧ P'.eval = P.eval ^ k ∧
      P'.size ≤ (k + 1) * P.size ^ (k + 1) := by
  sorry

/-- Rubric 3 (multilinear witness construction): replacing each layer `Nᵢ(t)` by the affine
interpolant `Nᵢ(0) + (Nᵢ(1) - Nᵢ(0)) t` gives an roABP of the same width with affine labels,
whose output is multilinear and agrees with the original on `{0,1}ⁿ`. [LowerBoundsAgainstThe, node_26] -/
theorem roABP_multilinearize {n : ℕ} (P : RoABP F n) :
    ∃ P' : RoABP F n, P'.width = P.width ∧
      (∀ i j k, (P'.layer i j k).natDegree ≤ 1) ∧
      IsMultilinear P'.eval ∧
      (∀ a : Fin n → Bool, eval (boolPt a) P'.eval = eval (boolPt a) P.eval) ∧
      P'.size ≤ P.width + 2 * n * P.width ^ 2 := by
  sorry

/-- A multilinear polynomial vanishing on the whole Boolean cube is zero. [LowerBoundsAgainstThe, node_26] -/
theorem multilinear_eq_zero_of_vanish {n : ℕ} (R : MvPolynomial (Fin n) F)
    (hR : IsMultilinear R) (hvan : ∀ a : Fin n → Bool, eval (boolPt a) R = 0) :
    R = 0 := by
  sorry

/-- Rubric 4 (IPS semantics): a polynomial vanishing on `{0,1}ⁿ` lies in the Boolean ideal. [LowerBoundsAgainstThe, node_26] -/
theorem mem_boolIdeal_of_vanish {n : ℕ} (p : MvPolynomial (Fin n) F)
    (hvan : ∀ a : Fin n → Bool, eval (boolPt a) p = 0) :
    p ∈ boolIdeal F n := by
  sorry

/-- Appending one layer labelled by `y` to an roABP for `g` computes `g(x) y` in the order
`x₀ < ⋯ < x_{n-1} < y`, with the same width. [LowerBoundsAgainstThe, node_26] -/
theorem roABP_append_y {n : ℕ} (P : RoABP F n) :
    ∃ P' : RoABP F (n + 1), P'.width = P.width ∧
      P'.eval = rename Fin.castSucc P.eval * X (Fin.last n) ∧
      P'.size ≤ P.size + 2 * P.width ^ 2 := by
  sorry

/-! ## Main theorems -/

/-- Main theorem. There is a constant `c` depending only on the fixed finite field `F` such that,
for every roABP `P` (size `S`) computing an `f` with no zero on `{0,1}ⁿ`, there are
* a multilinear functional inverse witness `g` with an roABP `Pg` in the same order,
  `size Pg ≤ c * S ^ c`;
* polynomials `Q₁,…,Qₙ` such that `C = g y + ∑ Qᵢ zᵢ` is an `IPS_LIN'` certificate for
  `f = b₁ = ⋯ = bₙ = 0`;
* an roABP `Py` in the order `x₁ < ⋯ < xₙ < y` computing the multilinear polynomial
  `C(x,y,0) = g(x) y`, with `size Py ≤ c * S ^ c`.
No bound is claimed for the placeholder-dependent terms `Qᵢ zᵢ`. [LowerBoundsAgainstThe, node_26] -/
theorem functional_inverse_roABP (F : Type) [Field F] [Fintype F] :
    ∃ c : ℕ, ∀ (n : ℕ) (P : RoABP F n), NonzeroOnCube P.eval →
      ∃ (Pg : RoABP F n) (Q : Fin n → MvPolynomial (Fin n) F) (Py : RoABP F (n + 1)),
        IsMultilinear Pg.eval ∧
        IsFunctionalInverse P.eval Pg.eval ∧
        Pg.size ≤ c * P.size ^ c ∧
        IsIPSCert P.eval (linCert Pg.eval Q) ∧
        placeholderFree (linCert Pg.eval Q) = rename Fin.castSucc Pg.eval * X (Fin.last n) ∧
        IsMultilinear (placeholderFree (linCert Pg.eval Q)) ∧
        Py.eval = placeholderFree (linCert Pg.eval Q) ∧
        Py.size ≤ c * P.size ^ c := by
  sorry

/-- Barrier conclusion. For any family `fₙ` with polynomial-size roABPs and no zeros on the
Boolean cube, the premise of the functional method — "every functional inverse witness of
`fₙ` has superpolynomial roABP complexity" — is false: there is a polynomial bound
`n ^ k' + k'` met by roABPs of some functional inverse witnesses, for all `n`. [LowerBoundsAgainstThe, node_26] -/
theorem functional_method_barrier (F : Type) [Field F] [Fintype F]
    (P : ∀ n : ℕ, RoABP F n) (k : ℕ)
    (hsize : ∀ n, (P n).size ≤ n ^ k + k)
    (hnz : ∀ n, NonzeroOnCube (P n).eval) :
    ¬ (∀ k' : ℕ, ∃ n : ℕ, ∀ Pg : RoABP F n,
        IsFunctionalInverse (P n).eval Pg.eval → n ^ k' + k' < Pg.size) := by
  sorry

end TCSChallenge.LowerBoundsAgainstThe.node_26
