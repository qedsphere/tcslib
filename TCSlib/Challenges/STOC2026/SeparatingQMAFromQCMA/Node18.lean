/-!
## Quasi-even condensates rarely occupy `v` guessed positions

`ℓ` bosons in `2^n` modes. A momentum Fock state with occupations `u` is an
`(r,o)`-quasi-even condensate if `u_0 ≥ ℓ - r` and at most `o` nonzero momenta have odd
occupation; `Q_{r,o}` projects onto their span. On `G ⊗ S`, with `G` spanned by distinct
tuples `z = (z_1, …, z_v)`, `Π_succ = ∑_z |z⟩⟨z| ⊗ P_z` where `P_z` is the event that all
positions `z_i` are occupied.

Main theorem `succ_compressed_bound`: `‖Q_{r,v/4} Π_succ Q_{r,v/4}‖ ≤ 2 (4v(r³+vr²)√ℓ / 2^{n/4})^v`
for `4 ∣ v`, `v ≤ 2^n`, `1 ≤ r ≤ ℓ`.
-/

namespace TCSChallenge.SeparatingQMAFromQCMA.node_18

/-- Mode labels `{0,1}^n`. -/
abbrev Mode (n : ℕ) := Fin n → Bool

/-- First-quantized configurations of `ℓ` bosons. -/
abbrev Config (n ℓ : ℕ) := Fin ℓ → Mode n

/-- Occupation of mode `z` in a configuration (`#{i | x_i = z}`). -/
def occ {n ℓ : ℕ} (x : Config n ℓ) (z : Mode n) : ℕ :=
  (Finset.univ.filter (fun i : Fin ℓ => x i = z)).card

/-- Bosonic (permutation-symmetric) wavefunctions. -/
def IsSymmetric {n ℓ : ℕ} (ψ : Config n ℓ → ℂ) : Prop :=
  ∀ (σ : Equiv.Perm (Fin ℓ)) (x : Config n ℓ), ψ (x ∘ σ) = ψ x

/-- Squared Euclidean norm. -/
def nsq {ι : Type} [Fintype ι] (ψ : ι → ℂ) : ℝ := ∑ i, Complex.normSq (ψ i)

/-- `(-1)^{x · z}` for single modes. -/
def sgn {n : ℕ} (x z : Mode n) : ℂ :=
  (-1 : ℂ) ^ (Finset.univ.filter (fun j : Fin n => (x j && z j) = true)).card

/-- Position ↔ momentum change of basis on each boson, from
`a_z = 2^{-n/2} ∑_x (-1)^{x·z} b_x`: the `ℓ`-fold tensor power of `H^{⊗n}` (an involution). -/
def fourier {n ℓ : ℕ} (ψ : Config n ℓ → ℂ) : Config n ℓ → ℂ :=
  fun k => ((1 / Real.sqrt ((2 : ℝ) ^ (n * ℓ)) : ℝ) : ℂ) *
    ∑ x : Config n ℓ, (∏ i, sgn (x i) (k i)) * ψ x

/-- Momentum occupations `u` (given as a momentum tuple `k`) form an `(r,o)`-quasi-even
condensate: `u_{0^n} ≥ ℓ - r` and at most `o` labels `k ≠ 0^n` have odd occupation. -/
def QuasiEven {n ℓ : ℕ} (r o : ℕ) (k : Config n ℓ) : Prop :=
  ℓ - r ≤ occ k (fun _ => false) ∧
  (Finset.univ.filter (fun m : Mode n => m ≠ (fun _ => false) ∧ occ k m % 2 = 1)).card ≤ o

/-- `Q_{r,o}`: keep only quasi-even momentum components. -/
def projQ {n ℓ : ℕ} (r o : ℕ) (ψ : Config n ℓ → ℂ) : Config n ℓ → ℂ :=
  fourier (fun k => if QuasiEven r o k then fourier ψ k else 0)

/-- `P_z`: the event that every position `z_1, …, z_v` is occupied. -/
def projOcc {n ℓ v : ℕ} (z : Fin v → Mode n) (ψ : Config n ℓ → ℂ) : Config n ℓ → ℂ :=
  fun x => if ∀ i, 0 < occ x (z i) then ψ x else 0

/-- The factorial-moment majorant `∏_i n̂_{z_i}` (position number operators, diagonal). -/
def momentOp {n ℓ v : ℕ} (z : Fin v → Mode n) (ψ : Config n ℓ → ℂ) : Config n ℓ → ℂ :=
  fun x => ((∏ i, occ x (z i) : ℕ) : ℂ) * ψ x

/-- Real quadratic form `⟨ψ, M ψ⟩` for a diagonal nonnegative multiplier. -/
def momentForm {n ℓ v : ℕ} (z : Fin v → Mode n) (ψ : Config n ℓ → ℂ) : ℝ :=
  ∑ x, ((∏ i, occ x (z i) : ℕ) : ℝ) * Complex.normSq (ψ x)

/-- Ordered tuples of distinct positions (the basis of the guess register `G`). -/
abbrev Guess (n v : ℕ) := {z : Fin v → Mode n // Function.Injective z}

/-- `𝓑(n, ℓ, r, v) = 2 (4v(r³ + v r²) √ℓ / 2^{n/4})^v`. -/
def bound (n ℓ r v : ℕ) : ℝ :=
  2 * ((4 * (v : ℝ) * ((r : ℝ) ^ 3 + v * (r : ℝ) ^ 2) * Real.sqrt ℓ) /
    (2 : ℝ) ^ ((n : ℝ) / 4)) ^ v

/-- Event-to-moment domination `P_z ⪯ ∏_i n̂_{z_i}` (as quadratic forms). [SeparatingQMAFromQCMA, node_18] -/
theorem projOcc_le_moment {n ℓ v : ℕ} (z : Fin v → Mode n) (ψ : Config n ℓ → ℂ) :
    nsq (projOcc z ψ) ≤ momentForm z ψ := by
  sorry

/-- `Q_{r,o}` preserves the bosonic subspace and is idempotent. [SeparatingQMAFromQCMA, node_18] -/
theorem projQ_symm_idem {n ℓ : ℕ} (r o : ℕ) (ψ : Config n ℓ → ℂ) (hψ : IsSymmetric ψ) :
    IsSymmetric (projQ r o ψ) ∧ projQ r o (projQ r o ψ) = projQ r o ψ := by
  sorry

/-- Central fixed-tuple estimate:
`‖Q_{r,v/4} (∏_i n̂_{z_i}) Q_{r,v/4}‖ ≤ 𝓑(n,ℓ,r,v)` for every distinct tuple `z`,
stated as a quadratic-form bound on bosonic vectors. [SeparatingQMAFromQCMA, node_18] -/
theorem fixed_tuple_moment {n ℓ r v : ℕ} (hn : 1 ≤ n) (hv : 1 ≤ v) (h4 : 4 ∣ v)
    (hv2 : v ≤ 2 ^ n) (hr : 1 ≤ r) (hrl : r ≤ ℓ) (z : Guess n v)
    (ψ : Config n ℓ → ℂ) (hψ : IsSymmetric ψ) :
    momentForm z.1 (projQ r (v / 4) ψ) ≤ bound n ℓ r v * nsq ψ := by
  sorry

/-- Main theorem: `‖Q_{r,v/4} Π_succ Q_{r,v/4}‖_op ≤ 𝓑(n,ℓ,r,v)`, in the form
`∑_z ‖P_z Q Φ_z‖² ≤ 𝓑 ∑_z ‖Φ_z‖²` for every `Φ ∈ G ⊗ Sym^ℓ` (coherent over guesses). [SeparatingQMAFromQCMA, node_18] -/
theorem succ_compressed_bound {n ℓ r v : ℕ} (hn : 1 ≤ n) (hv : 1 ≤ v) (h4 : 4 ∣ v)
    (hv2 : v ≤ 2 ^ n) (hr : 1 ≤ r) (hrl : r ≤ ℓ)
    (Φ : Guess n v → Config n ℓ → ℂ) (hΦ : ∀ z, IsSymmetric (Φ z)) :
    ∑ z : Guess n v, nsq (projOcc z.1 (projQ r (v / 4) (Φ z))) ≤
      bound n ℓ r v * ∑ z : Guess n v, nsq (Φ z) := by
  sorry

end TCSChallenge.SeparatingQMAFromQCMA.node_18
