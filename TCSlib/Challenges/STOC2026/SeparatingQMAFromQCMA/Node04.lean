/-!
## A one-query-per-filter verifier for the spectral norm `‖Π_U H^{⊗n} Π_S‖²`

For Boolean oracles `S, U : {0,1}^n → {0,1}`, `A_{S,U} = Π_U H^{⊗n} Π_S` and
`F(S,U) = max_{‖ψ‖=1} ‖A_{S,U} ψ‖²`. Each projector `Π_S` is realized from one controlled
phase query by the flag gadget `(H ⊗ I) · c-Q_S · (H ⊗ I)` applied to `|0⟩ ⊗ ψ`: the
flag-`1` branch equals `(I - Q_S)/2 ψ = Π_S ψ`. The base verifier keeps the flag-`1`
branch of the `S`-gadget, applies `H^{⊗n}`, then keeps the flag-`1` branch of the
`U`-gadget; its acceptance probability is `‖A_{S,U} ψ‖²`.

Main theorem `base_verifier_gap`: if `α ≤ F(S,U)` some unit witness is accepted with
probability `≥ α`; if `F(S,U) ≤ β` every (mixed) witness is accepted with probability `≤ β`.
-/

namespace TCSChallenge.SeparatingQMAFromQCMA.node_04

/-! The computational basis of `n` qubits is TCSlib's `BoolCube n = Fin n → Bool`. -/

/-- The sign `(-1)^{x · z}` of the Hadamard transform. -/
def hadSign {n : ℕ} (x z : BoolCube n) : ℂ :=
  (-1 : ℂ) ^ (Finset.univ.filter (fun i : Fin n => (x i && z i) = true)).card

/-- `H^{⊗n}` with entries `2^{-n/2} (-1)^{x·z}`. -/
def hadamardN (n : ℕ) : Matrix (BoolCube n) (BoolCube n) ℂ :=
  fun x z => ((1 / Real.sqrt (2 ^ n) : ℝ) : ℂ) * hadSign x z

/-- `Π_S = ∑_{x : S(x)=1} |x⟩⟨x|`. -/
def projOf {n : ℕ} (S : BoolCube n → Bool) : Matrix (BoolCube n) (BoolCube n) ℂ :=
  Matrix.diagonal fun x => if S x then 1 else 0

/-- `A_{S,U} = Π_U H^{⊗n} Π_S`. -/
def opA {n : ℕ} (S U : BoolCube n → Bool) : Matrix (BoolCube n) (BoolCube n) ℂ :=
  projOf U * hadamardN n * projOf S

/-- Squared Euclidean norm `‖ψ‖₂²` (the Pi-type norm is the sup norm, so we spell it out). -/
def nsq {ι : Type} [Fintype ι] (ψ : ι → ℂ) : ℝ := ∑ i, Complex.normSq (ψ i)

/-- `F(S,U) = max_{⟨ψ|ψ⟩ = 1} ‖A_{S,U} ψ‖₂²` (a supremum over unit vectors). -/
def Fval {n : ℕ} (S U : BoolCube n → Bool) : ℝ :=
  ⨆ ψ : {ψ : BoolCube n → ℂ // nsq ψ = 1}, nsq (opA S U *ᵥ ψ.1)

/-- Controlled phase query on `flag ⊗ witness`: `|b, x⟩ ↦ (-1)^{b · S(x)} |b, x⟩`. -/
def cPhase {n : ℕ} (S : BoolCube n → Bool) : Matrix (Bool × BoolCube n) (Bool × BoolCube n) ℂ :=
  Matrix.diagonal fun p => if (p.1 && S p.2) = true then -1 else 1

/-- Hadamard on the flag qubit, identity on the witness: `H ⊗ I`. -/
def flagHad (n : ℕ) : Matrix (Bool × BoolCube n) (Bool × BoolCube n) ℂ :=
  fun p q => if p.2 = q.2 then
    ((1 / Real.sqrt 2 : ℝ) : ℂ) * (if (p.1 && q.1) = true then -1 else 1) else 0

/-- The membership-filter gadget `(H ⊗ I) · c-Q_S · (H ⊗ I)` (one oracle query). -/
def gadget {n : ℕ} (S : BoolCube n → Bool) : Matrix (Bool × BoolCube n) (Bool × BoolCube n) ℂ :=
  flagHad n * cPhase S * flagHad n

/-- `|0⟩ ⊗ ψ`. -/
def withFlag0 {n : ℕ} (ψ : BoolCube n → ℂ) : Bool × BoolCube n → ℂ :=
  fun p => if p.1 then 0 else ψ p.2

/-- The (unnormalized) flag-`1` branch of a flag ⊗ witness vector. -/
def flag1Branch {n : ℕ} (φ : Bool × BoolCube n → ℂ) : BoolCube n → ℂ := fun x => φ (true, x)

/-- Unnormalized state on the accepting branch of the base verifier:
S-gadget (keep flag 1), then `H^{⊗n}`, then U-gadget (keep flag 1). -/
def acceptBranch {n : ℕ} (S U : BoolCube n → Bool) (ψ : BoolCube n → ℂ) : BoolCube n → ℂ :=
  flag1Branch (gadget U *ᵥ withFlag0
    (hadamardN n *ᵥ flag1Branch (gadget S *ᵥ withFlag0 ψ)))

/-- Acceptance probability of the base verifier on a pure witness `ψ`. -/
def acceptProb {n : ℕ} (S U : BoolCube n → Bool) (ψ : BoolCube n → ℂ) : ℝ :=
  nsq (acceptBranch S U ψ)

/-- Acceptance probability on a mixed witness `ρ`: `Re tr(A†A ρ)`, i.e. the expectation of
the accepting POVM element `A_{S,U}^† A_{S,U}`. -/
def mixedAccept {n : ℕ} (S U : BoolCube n → Bool) (ρ : Matrix (BoolCube n) (BoolCube n) ℂ) : ℝ :=
  (Matrix.trace ((opA S U)ᴴ * opA S U * ρ)).re

/-- Density matrices: positive semidefinite with unit trace. -/
def IsDensity {n : ℕ} (ρ : Matrix (BoolCube n) (BoolCube n) ℂ) : Prop :=
  ρ.PosSemidef ∧ Matrix.trace ρ = 1

/-- Gadget lemma: the flag-`1` branch of `gadget S (|0⟩ ⊗ ψ)` is `(I - Q_S)/2 ψ = Π_S ψ`. [SeparatingQMAFromQCMA, node_04] -/
theorem gadget_flag1 {n : ℕ} (S : BoolCube n → Bool) (ψ : BoolCube n → ℂ) :
    flag1Branch (gadget S *ᵥ withFlag0 ψ) = projOf S *ᵥ ψ := by
  sorry

/-- Base acceptance identity: `p_ψ = ‖A_{S,U} ψ‖₂²`. [SeparatingQMAFromQCMA, node_04] -/
theorem acceptProb_eq {n : ℕ} (S U : BoolCube n → Bool) (ψ : BoolCube n → ℂ) :
    acceptProb S U ψ = nsq (opA S U *ᵥ ψ) := by
  sorry

/-- The maximum defining `F(S,U)` is attained (finite dimension). [SeparatingQMAFromQCMA, node_04] -/
theorem Fval_attained {n : ℕ} (S U : BoolCube n → Bool) :
    ∃ ψ : BoolCube n → ℂ, nsq ψ = 1 ∧ nsq (opA S U *ᵥ ψ) = Fval S U := by
  sorry

/-- Variational bound: every unit witness has `‖A ψ‖² ≤ F(S,U)`. [SeparatingQMAFromQCMA, node_04] -/
theorem nsq_le_Fval {n : ℕ} (S U : BoolCube n → Bool) (ψ : BoolCube n → ℂ) (hψ : nsq ψ = 1) :
    nsq (opA S U *ᵥ ψ) ≤ Fval S U := by
  sorry

/-- Mixed witnesses: for every density matrix, `Re tr(A†A ρ) ≤ F(S,U)`. [SeparatingQMAFromQCMA, node_04] -/
theorem mixedAccept_le_Fval {n : ℕ} (S U : BoolCube n → Bool)
    (ρ : Matrix (BoolCube n) (BoolCube n) ℂ) (hρ : IsDensity ρ) :
    mixedAccept S U ρ ≤ Fval S U := by
  sorry

/-- Pure states as density matrices: `mixedAccept (|ψ⟩⟨ψ|) = acceptProb ψ`. [SeparatingQMAFromQCMA, node_04] -/
theorem mixedAccept_pure {n : ℕ} (S U : BoolCube n → Bool) (ψ : BoolCube n → ℂ) :
    mixedAccept S U (Matrix.vecMulVec ψ (star ψ)) = acceptProb S U ψ := by
  sorry

/-- Main theorem (base verifier): completeness `α` and soundness `β` against mixed witnesses,
under the promise `F ≥ α` or `F ≤ β` with `0 ≤ β < α ≤ 1`. [SeparatingQMAFromQCMA, node_04] -/
theorem base_verifier_gap {n : ℕ} (hn : 1 ≤ n) (S U : BoolCube n → Bool) (α β : ℝ)
    (hβ : 0 ≤ β) (hαβ : β < α) (hα : α ≤ 1) :
    (α ≤ Fval S U → ∃ ψ : BoolCube n → ℂ, nsq ψ = 1 ∧ α ≤ acceptProb S U ψ) ∧
    (Fval S U ≤ β →
      (∀ ψ : BoolCube n → ℂ, nsq ψ = 1 → acceptProb S U ψ ≤ β) ∧
      (∀ ρ : Matrix (BoolCube n) (BoolCube n) ℂ, IsDensity ρ → mixedAccept S U ρ ≤ β)) := by
  sorry

end TCSChallenge.SeparatingQMAFromQCMA.node_04
