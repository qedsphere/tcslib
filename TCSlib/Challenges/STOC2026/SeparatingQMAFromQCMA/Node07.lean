/-!
## Cumulative sampling with one guessed classical witness

`CumulativeSampler^U` draws one uniform `w ∈ {0,1}^q`, then runs `v` stages; stage `i`
calls `Extract^U(w, Δ_i)` with `Δ_i` the set of earlier candidates and appends the output.
Its law on output sequences `(x_0, …, x_{v-1})` is `2^{-q} ∑_w ∏_i P w Δ_i x_i`.

Main theorem `cumulativeSampler_bound`: the probability of outputting `v` distinct elements
of `S` is at least `2^{-q} (1/(36 t²))^v`.
-/

namespace TCSChallenge.SeparatingQMAFromQCMA.node_07

/-- The domain `D = {0,1}^n`. -/
abbrev Dom (n : ℕ) := Fin n → Bool

/-- `P` is a valid law for `Extract^U(w, Δ)`: a probability vector on `D` whose support
avoids `Δ` ("returns a candidate `x ∈ D \ Δ`"). -/
def IsExtractLaw {n q : ℕ} (P : (Fin q → Bool) → Finset (Dom n) → Dom n → ℝ) : Prop :=
  (∀ w Δ x, 0 ≤ P w Δ x) ∧ (∀ w Δ x, x ∈ Δ → P w Δ x = 0) ∧
  (∀ w Δ, ∑ x, P w Δ x = 1)

/-- The extraction guarantee: whenever `w` is good, `Δ ⊆ S` and `(Δ,U)` is a no instance,
`Pr[x ∈ S \ Δ] ≥ p`. -/
def ExtractGuarantee {n q : ℕ} (P : (Fin q → Bool) → Finset (Dom n) → Dom n → ℝ)
    (S : Finset (Dom n)) (good : (Fin q → Bool) → Prop) (NoInst : Finset (Dom n) → Prop)
    (p : ℝ) : Prop :=
  ∀ w, good w → ∀ Δ : Finset (Dom n), Δ ⊆ S → NoInst Δ →
    p ≤ ∑ x ∈ (S \ Δ), P w Δ x

/-- The exclusion set of stage `i`: the candidates returned at stages `j < i`. -/
def prefixSet {n k : ℕ} (xs : Fin k → Dom n) (i : Fin k) : Finset (Dom n) :=
  (Finset.univ.filter (fun j : Fin k => j < i)).image xs

/-- Probability, for a fixed witness `w`, that the `k`-stage sampler outputs exactly `xs`
(fresh executions of Extract at each stage). -/
def runProb {n q k : ℕ} (P : (Fin q → Bool) → Finset (Dom n) → Dom n → ℝ)
    (w : Fin q → Bool) (xs : Fin k → Dom n) : ℝ :=
  ∏ i, P w (prefixSet xs i) (xs i)

/-- For a fixed witness, probability that `k` stages output `k` distinct elements of `S`. -/
def stageSuccess {n q : ℕ} (P : (Fin q → Bool) → Finset (Dom n) → Dom n → ℝ)
    (S : Finset (Dom n)) (w : Fin q → Bool) (k : ℕ) : ℝ :=
  ∑ xs ∈ Finset.univ.filter
      (fun xs : Fin k → Dom n => Function.Injective xs ∧ ∀ i, xs i ∈ S),
    runProb P w xs

/-- Success probability of `CumulativeSampler^U` with a uniformly guessed witness. -/
def samplerSuccess {n q : ℕ} (P : (Fin q → Bool) → Finset (Dom n) → Dom n → ℝ)
    (S : Finset (Dom n)) (v : ℕ) : ℝ :=
  (1 / (2 : ℝ) ^ q) * ∑ w : Fin q → Bool, stageSuccess P S w v

/-- Distinctness: every output sequence of positive probability is injective
(Extract avoids the stored exclusion list). [SeparatingQMAFromQCMA, node_07] -/
theorem runProb_pos_injective {n q k : ℕ} (P : (Fin q → Bool) → Finset (Dom n) → Dom n → ℝ)
    (hP : IsExtractLaw P) (w : Fin q → Bool) (xs : Fin k → Dom n)
    (hpos : 0 < runProb P w xs) : Function.Injective xs := by
  sorry

/-- Successful-prefix induction: for a good witness, `k ≤ v` stages all succeed with
probability at least `p^k` (each prefix of successes leaves `Δ ⊆ S`, `|Δ| < v`). [SeparatingQMAFromQCMA, node_07] -/
theorem stageSuccess_ge {n q : ℕ} (P : (Fin q → Bool) → Finset (Dom n) → Dom n → ℝ)
    (S : Finset (Dom n)) (good : (Fin q → Bool) → Prop) (NoInst : Finset (Dom n) → Prop)
    (p : ℝ) (v : ℕ) (hP : IsExtractLaw P) (hp : 0 ≤ p)
    (hext : ExtractGuarantee P S good NoInst p)
    (hstrong : ∀ Δ : Finset (Dom n), Δ ⊆ S → Δ.card ≤ v → NoInst Δ)
    (w : Fin q → Bool) (hw : good w) (k : ℕ) (hk : k ≤ v) :
    p ^ k ≤ stageSuccess P S w k := by
  sorry

/-- Main theorem: `Pr[CumulativeSampler^U outputs v distinct elements of S]
≥ 2^{-q} (1/(36 t²))^v`. [SeparatingQMAFromQCMA, node_07] -/
theorem cumulativeSampler_bound {n q t v : ℕ} (ht : 1 ≤ t)
    (P : (Fin q → Bool) → Finset (Dom n) → Dom n → ℝ)
    (S : Finset (Dom n)) (good : (Fin q → Bool) → Prop) (NoInst : Finset (Dom n) → Prop)
    (hP : IsExtractLaw P)
    (hext : ExtractGuarantee P S good NoInst (1 / (36 * (t : ℝ) ^ 2)))
    (hyes : ∃ w, good w)
    (hstrong : ∀ Δ : Finset (Dom n), Δ ⊆ S → Δ.card ≤ v → NoInst Δ) :
    (1 / (2 : ℝ) ^ q) * (1 / (36 * (t : ℝ) ^ 2)) ^ v ≤ samplerSuccess P S v := by
  sorry

