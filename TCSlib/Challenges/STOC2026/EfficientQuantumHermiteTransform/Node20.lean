/-!
## Efficient quantum Hermite transform: correctness core (node_20)

We prepare `∑ₙ αₙ |0⟩_I |ψₙ⟩_B |0⟩_W` from `∑ₙ αₙ |n⟩_I |0⟩_B |0⟩_W`, where `|ψₙ⟩` is the
sampled, unnormalised Hermite function on the grid `x_j = j √(2π/M)`.

The circuit is `C = Q^† · Amp`, where
* `Q = (F ⊗ I) · (controlled S_r's) · (F ⊗ I)` is the coherent spectral-labelling circuit
  (`spectralSelector`) built from the shifted evolutions `S_r` and the QFT `F` over `ℤ_M`,
  using the input register `I` as its phase register;
* `Amp` is the block-diagonal fixed-point amplification of the selector `A`.

Linear algebra is done concretely: states are vectors `X → ℂ`, operators are matrices,
the Euclidean norm is `vnorm`. The main theorem is `hermite_transform_correct`.
-/

namespace TCSChallenge.EfficientQuantumHermiteTransform.node_20

open Matrix

/-! ## Vectors, norms, registers -/

/-- Euclidean norm of a state vector ("All state errors are measured in Euclidean norm"). -/
def vnorm {ι : Type} [Fintype ι] (v : ι → ℂ) : ℝ :=
  Real.sqrt (∑ i, Complex.normSq (v i))

/-- Hermitian inner product `⟨v|w⟩` (conjugate-linear in the first argument). -/
def cinner {ι : Type} [Fintype ι] (v w : ι → ℂ) : ℂ :=
  ∑ i, star (v i) * w i

/-- Computational basis vector `|k⟩` of an `M`-dimensional register (zero if `k ≥ M`). -/
def basisNat (M k : ℕ) : Fin M → ℂ :=
  fun j => if (j : ℕ) = k then 1 else 0

/-- Tensor product `|u⟩_I ⊗ |v⟩` with the first factor an `M`-dimensional register. -/
def tensorI {M : ℕ} {Y : Type} (u : Fin M → ℂ) (v : Y → ℂ) : Fin M × Y → ℂ :=
  fun x => u x.1 * v x.2

/-- `|b⟩_B ⊗ |w₀⟩_W`: a grid-register state with the workspace in its clean state `w₀`. -/
def withWork {M : ℕ} {W : Type} [DecidableEq W] (b : Fin M → ℂ) (w0 : W) :
    Fin M × W → ℂ :=
  fun p => b p.1 * (if p.2 = w0 then 1 else 0)

/-- An operator on `I ⊗ Y` is block diagonal with respect to the index register `I`. -/
def IsBlockDiag {M : ℕ} {Y : Type} (F : Matrix (Fin M × Y) (Fin M × Y) ℂ) : Prop :=
  ∀ x y : Fin M × Y, x.1 ≠ y.1 → F x y = 0

/-- Extend an operator on `I ⊗ B` by the identity on the workspace `W`. -/
def liftIB {M : ℕ} {W : Type} [DecidableEq W]
    (Q : Matrix (Fin M × Fin M) (Fin M × Fin M) ℂ) :
    Matrix (Fin M × Fin M × W) (Fin M × Fin M × W) ℂ :=
  fun x y => Q (x.1, x.2.1) (y.1, y.2.1) * (if x.2.2 = y.2.2 then 1 else 0)

/-! ## Sampled Hermite states -/

/-- Physicists' Hermite polynomial `H_n(x) = 2^{n/2} He_n(√2 x)`, where Mathlib's
`Polynomial.hermite` is the probabilists' `He_n`. -/
def physHermite (n : ℕ) (x : ℝ) : ℝ :=
  (2 : ℝ) ^ ((n : ℝ) / 2) *
    ((Polynomial.hermite n).map (Int.castRingHom ℝ)).eval (Real.sqrt 2 * x)

/-- "`ψ_n(x) = (-1)^n / √(2^n n! √π) · e^{-x²/2} H_n(x)`". -/
def hermiteFn (n : ℕ) (x : ℝ) : ℝ :=
  (-1 : ℝ) ^ n / Real.sqrt ((2 : ℝ) ^ n * (n.factorial : ℝ) * Real.sqrt Real.pi) *
    Real.exp (-(x ^ 2) / 2) * physHermite n x

/-- Grid point "`x_j = j √(2π/M)`" for `j ∈ {-M/2, …, M/2-1}`; the register basis
state `j' : Fin M` stands for the grid label `j = j' - M/2`. -/
def gridPoint (M : ℕ) (j : Fin M) : ℝ :=
  (((j : ℕ) : ℝ) - ((M / 2 : ℕ) : ℝ)) * Real.sqrt (2 * Real.pi / M)

/-- "`|ψ_n⟩ = (2π/M)^{1/4} ∑_{j=-M/2}^{M/2-1} ψ_n(x_j) |j⟩`". -/
def hermiteState (M n : ℕ) : Fin M → ℂ :=
  fun j => (((2 * Real.pi / M) ^ ((1 : ℝ) / 4) * hermiteFn n (gridPoint M j) : ℝ) : ℂ)

/-! ## The spectral-labelling circuit -/

/-- Quantum Fourier transform over `ℤ_M`: `F |ℓ⟩ = M^{-1/2} ∑_k e^{2πi kℓ/M} |k⟩`. -/
def qft (M : ℕ) : Matrix (Fin M) (Fin M) ℂ :=
  fun k l => ((Real.sqrt M)⁻¹ : ℂ) *
    Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (((k : ℕ) * (l : ℕ) : ℕ) : ℂ) / (M : ℂ))

/-- `F ⊗ I` acting on the phase register `R` (first factor) of `R ⊗ B`. -/
def liftR {M : ℕ} (F : Matrix (Fin M) (Fin M) ℂ) :
    Matrix (Fin M × Fin M) (Fin M × Fin M) ℂ :=
  fun x y => F x.1 y.1 * (if x.2 = y.2 then 1 else 0)

/-- For `ℓ = ∑_j ℓ_j 2^j`, the product of the `S_r` with `ℓ_r = 1`. -/
def bitProd {M : ℕ} (m : ℕ) (S : Fin m → Matrix (Fin M) (Fin M) ℂ) (ℓ : ℕ) :
    Matrix (Fin M) (Fin M) ℂ :=
  (List.ofFn (fun r : Fin m => if Nat.testBit ℓ (r : ℕ) = true then S r else 1)).prod

/-- "Apply `S_j` controlled on the bit `ℓ_j`": block diagonal in the phase register. -/
def ctrlEvol {M : ℕ} (m : ℕ) (S : Fin m → Matrix (Fin M) (Fin M) ℂ) :
    Matrix (Fin M × Fin M) (Fin M × Fin M) ℂ :=
  fun x y => if x.1 = y.1 then bitProd m S (x.1 : ℕ) x.2 y.2 else 0

/-- The coherent spectral-labelling circuit `Q`: create the uniform superposition on `R`
(`F|0⟩`), apply the controlled shifted evolutions, then Fourier transform `R`. -/
def spectralSelector {M : ℕ} (m : ℕ) (S : Fin m → Matrix (Fin M) (Fin M) ℂ) :
    Matrix (Fin M × Fin M) (Fin M × Fin M) ℂ :=
  liftR (qft M) * ctrlEvol m S * liftR (qft M)

/-! ## Rubric lemma stubs -/

/-- Rubric 1 (coherent spectral selector, hybrid bound). With `D_r χ_k = e^{-2πi 2^r k/M} χ_k`
and `‖(S_r − D_r) Π_K‖ ≤ σ/m`, the selector maps `|0⟩_R |χ_k⟩` to `|k⟩_R |χ_k⟩` up to
error `σ`, uniformly (as an operator bound) on `|0⟩ ⊗ span{χ_0,…,χ_K}`. [EfficientQuantumHermiteTransform, node_20] -/
theorem spectral_selector_hybrid
    (m M K : ℕ) (hm : 1 ≤ m) (hM : M = 2 ^ m) (hKM : K < M) (σ : ℝ) (hσ : 0 ≤ σ)
    (χ : ℕ → Fin M → ℂ)
    (horth : ∀ k l : ℕ, k ≤ K → l ≤ K → cinner (χ k) (χ l) = if k = l then 1 else 0)
    (S Dm : Fin m → Matrix (Fin M) (Fin M) ℂ)
    (hS : ∀ r, S r ∈ Matrix.unitaryGroup (Fin M) ℂ)
    (hD : ∀ r, Dm r ∈ Matrix.unitaryGroup (Fin M) ℂ)
    (hDeig : ∀ (r : Fin m) (k : ℕ), k ≤ K →
      Dm r *ᵥ χ k = Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I *
        (((2 ^ (r : ℕ) * k : ℕ)) : ℂ) / (M : ℂ))) • χ k)
    (hSD : ∀ (r : Fin m) (c : Fin (K + 1) → ℂ),
      vnorm ((S r - Dm r) *ᵥ ∑ k : Fin (K + 1), c k • χ (k : ℕ)) ≤ σ / m * vnorm c) :
    ∀ c : Fin (K + 1) → ℂ,
      vnorm (spectralSelector m S *ᵥ
          (∑ k : Fin (K + 1), c k • tensorI (basisNat M 0) (χ (k : ℕ)))
        - ∑ k : Fin (K + 1), c k • tensorI (basisNat M (k : ℕ)) (χ (k : ℕ)))
        ≤ σ * vnorm c := by
  sorry

/-- Rubric 2 (good-branch analysis, normalisation step): if the good vector is within `4σ`
of `β χ` with `β ∈ [δ, 1]` real and `σ ≤ δ/16`, then its norm is at least `3δ/4` and its
normalisation is within `16σ/δ` of `χ` (no unknown phase is introduced). [EfficientQuantumHermiteTransform, node_20] -/
theorem good_branch_normalize {ι : Type} [Fintype ι]
    (g χ : ι → ℂ) (β δ σ : ℝ) (hχ : vnorm χ = 1) (hδ : 0 < δ) (hβ : δ ≤ β) (hβ1 : β ≤ 1)
    (hσ0 : 0 ≤ σ) (hσ : σ ≤ δ / 16) (hg : vnorm (g - (β : ℂ) • χ) ≤ 4 * σ) :
    3 * δ / 4 ≤ vnorm g ∧ vnorm (((vnorm g)⁻¹ : ℂ) • g - χ) ≤ 16 * σ / δ := by
  sorry

/-- Rubric 3 (coherent amplification preserves superpositions): a block-diagonal operator
that is `η`-accurate on every block `|n⟩ ⊗ s` is `η`-accurate on every normalised
superposition, with no `√N` loss. [EfficientQuantumHermiteTransform, node_20] -/
theorem blockDiag_superposition {M : ℕ} {Y : Type} [Fintype Y]
    (F : Matrix (Fin M × Y) (Fin M × Y) ℂ) (hF : IsBlockDiag F)
    (N : ℕ) (hNM : N ≤ M) (s : Y → ℂ) (t : ℕ → Y → ℂ) (η : ℝ)
    (hη : ∀ n : ℕ, n < N →
      vnorm (F *ᵥ tensorI (basisNat M n) s - tensorI (basisNat M n) (t n)) ≤ η)
    (α : Fin N → ℂ) (hα : ∑ n, Complex.normSq (α n) = 1) :
    vnorm (F *ᵥ (∑ n : Fin N, α n • tensorI (basisNat M (n : ℕ)) s)
      - ∑ n : Fin N, α n • tensorI (basisNat M (n : ℕ)) (t (n : ℕ))) ≤ η := by
  sorry

/-- Rubric 4 (index erasure): if the unitary `Q` maps `|0⟩|χ_k⟩` to `|k⟩|χ_k⟩` up to an
operator-norm error `τ` on `|0⟩ ⊗ span χ`, then `Q^†` maps `∑ c_k |k⟩|χ_k⟩|w₀⟩` to
`∑ c_k |0⟩|χ_k⟩|w₀⟩` up to error `τ ‖c‖`, uniformly on superpositions. [EfficientQuantumHermiteTransform, node_20] -/
theorem index_erasure {M K : ℕ} {W : Type} [Fintype W] [DecidableEq W] (w0 : W)
    (Q : Matrix (Fin M × Fin M) (Fin M × Fin M) ℂ)
    (hQu : Q ∈ Matrix.unitaryGroup (Fin M × Fin M) ℂ)
    (χ : ℕ → Fin M → ℂ) (τ : ℝ)
    (hQ : ∀ c : Fin (K + 1) → ℂ,
      vnorm (Q *ᵥ (∑ k : Fin (K + 1), c k • tensorI (basisNat M 0) (χ (k : ℕ)))
        - ∑ k : Fin (K + 1), c k • tensorI (basisNat M (k : ℕ)) (χ (k : ℕ))) ≤ τ * vnorm c) :
    ∀ c : Fin (K + 1) → ℂ,
      vnorm ((liftIB (W := W) Q)ᴴ *ᵥ
          (∑ k : Fin (K + 1), c k • tensorI (basisNat M (k : ℕ)) (withWork (χ (k : ℕ)) w0))
        - ∑ k : Fin (K + 1), c k • tensorI (basisNat M 0) (withWork (χ (k : ℕ)) w0))
        ≤ τ * vnorm c := by
  sorry

/-- Comparison with the sampled Hermite states (Cauchy–Schwarz):
`‖∑ αₙ (χₙ − ψₙ)‖ ≤ √N σ`. [EfficientQuantumHermiteTransform, node_20] -/
theorem superposition_comparison {M N : ℕ} (χ ψ : ℕ → Fin M → ℂ) (σ : ℝ)
    (hclose : ∀ n : ℕ, n < N → vnorm (χ n - ψ n) ≤ σ)
    (α : Fin N → ℂ) (hα : ∑ n, Complex.normSq (α n) = 1) :
    vnorm (∑ n : Fin N, α n • (χ (n : ℕ) - ψ (n : ℕ))) ≤ Real.sqrt N * σ := by
  sorry

/-- Rubric 5 (parameters): with `σ = min{δ/16, δε/(100√D)}`, `η = ε/4` and `N ≤ D`, the
accumulated error `η + 16σ/δ + σ + √N σ` is at most `ε`. [EfficientQuantumHermiteTransform, node_20] -/
theorem parameter_choice (ε δ : ℝ) (D N : ℕ) (hε : 0 < ε) (hδ : 0 < δ) (hδ1 : δ ≤ 1)
    (hD : 1 ≤ D) (hND : N ≤ D) (σ : ℝ)
    (hσ : σ = min (δ / 16) (δ * ε / (100 * Real.sqrt D))) :
    ε / 4 + 16 * σ / δ + σ + Real.sqrt N * σ ≤ ε := by
  sorry

/-! ## Main theorem -/

/-- **Efficient quantum Hermite transform (correctness).** Let `M = 2^m`, `N ≤ D ≤ K < M`,
`0 < ε ≤ 1/4`, `δ ∈ (0,1]` the universal overlap constant and
`σ = min{δ/16, δε/(100√D)}`. Assume the implementation guarantees: orthonormal `χ_0,…,χ_K`
with `‖χ_n − ψ_n‖ ≤ σ` for `n < D`; shifted evolutions `S_r` with unitary extensions `D_r`
of the stated eigenphases and `‖(S_r − D_r)Π_K‖ ≤ σ/m`; a block-diagonal selector `A`
with block-diagonal good projector `Π_G` whose good branch on `|n⟩|0⟩|0⟩` is within `4σ`
of `β_n |n⟩|χ_n⟩|0⟩`, `β_n ∈ [δ,1]`; and a block-diagonal unitary `Amp` (one common
fixed-point phase sequence) mapping each `|n⟩|0⟩|0⟩` within `ε/4` of the normalised good
branch. Then `C = Q^† · Amp`, with `Q` the spectral-labelling circuit, satisfies
`‖C ∑ αₙ |n⟩|0⟩|0⟩ − |0⟩ (∑ αₙ |ψₙ⟩) |0⟩‖ ≤ ε` for every normalised `α`. [EfficientQuantumHermiteTransform, node_20] -/
theorem hermite_transform_correct
    (m M K D N : ℕ) (hm : 1 ≤ m) (hM : M = 2 ^ m) (hN : 1 ≤ N) (hND : N ≤ D)
    (hDK : D ≤ K) (hKM : K < M)
    (ε δ σ : ℝ) (hε : 0 < ε) (hε' : ε ≤ 1 / 4) (hδ : 0 < δ) (hδ1 : δ ≤ 1)
    (hσ : σ = min (δ / 16) (δ * ε / (100 * Real.sqrt D)))
    -- spectral states `χ_k`
    (χ : ℕ → Fin M → ℂ)
    (horth : ∀ k l : ℕ, k ≤ K → l ≤ K → cinner (χ k) (χ l) = if k = l then 1 else 0)
    (hclose : ∀ n : ℕ, n < D → vnorm (χ n - hermiteState M n) ≤ σ)
    -- shifted evolutions `S_r` and their ideal extensions `D_r`
    (S Dm : Fin m → Matrix (Fin M) (Fin M) ℂ)
    (hS : ∀ r, S r ∈ Matrix.unitaryGroup (Fin M) ℂ)
    (hD : ∀ r, Dm r ∈ Matrix.unitaryGroup (Fin M) ℂ)
    (hDeig : ∀ (r : Fin m) (k : ℕ), k ≤ K →
      Dm r *ᵥ χ k = Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I *
        (((2 ^ (r : ℕ) * k : ℕ)) : ℂ) / (M : ℂ))) • χ k)
    (hSD : ∀ (r : Fin m) (c : Fin (K + 1) → ℂ),
      vnorm ((S r - Dm r) *ᵥ ∑ k : Fin (K + 1), c k • χ (k : ℕ)) ≤ σ / m * vnorm c)
    -- workspace, selector, good projector, amplified selector
    (W : Type) [Fintype W] [DecidableEq W] (w0 : W)
    (A PG Amp : Matrix (Fin M × Fin M × W) (Fin M × Fin M × W) ℂ)
    (hAu : A ∈ Matrix.unitaryGroup (Fin M × Fin M × W) ℂ)
    (hAblock : IsBlockDiag A) (hPGblock : IsBlockDiag PG)
    (hgood : ∀ n : ℕ, n < N → ∃ β : ℝ, δ ≤ β ∧ β ≤ 1 ∧
      vnorm (PG *ᵥ (A *ᵥ tensorI (basisNat M n) (withWork (basisNat M 0) w0))
        - (β : ℂ) • tensorI (basisNat M n) (withWork (χ n) w0)) ≤ 4 * σ)
    (hAmpu : Amp ∈ Matrix.unitaryGroup (Fin M × Fin M × W) ℂ)
    (hAmpblock : IsBlockDiag Amp)
    (hAmp : ∀ n : ℕ, n < N →
      vnorm (Amp *ᵥ tensorI (basisNat M n) (withWork (basisNat M 0) w0)
        - ((vnorm (PG *ᵥ (A *ᵥ tensorI (basisNat M n) (withWork (basisNat M 0) w0))))⁻¹ : ℂ)
          • (PG *ᵥ (A *ᵥ tensorI (basisNat M n) (withWork (basisNat M 0) w0)))) ≤ ε / 4) :
    ∀ α : Fin N → ℂ, ∑ n, Complex.normSq (α n) = 1 →
      vnorm (((liftIB (W := W) (spectralSelector m S))ᴴ * Amp) *ᵥ
          (∑ n : Fin N, α n • tensorI (basisNat M (n : ℕ)) (withWork (basisNat M 0) w0))
        - tensorI (basisNat M 0)
            (withWork (∑ n : Fin N, α n • hermiteState M (n : ℕ)) w0)) ≤ ε := by
  sorry

end TCSChallenge.EfficientQuantumHermiteTransform.node_20
