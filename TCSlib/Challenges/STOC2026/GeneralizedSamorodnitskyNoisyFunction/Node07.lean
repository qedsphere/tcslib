/-!
## Endpoint (`∞ → geometric Bernoulli`) noisy-function inequality

`Ω` is finite with `|Ω| ≥ 2` and a fully supported probability `μ`, `μ* = min μ`. On
`Ω^n` (`Fin n → Ω`), `T_{i,a} f = a f + (1-a) E_{x_i} f`, `T_𝐚 = T_{1,a_1} ⋯ T_{n,a_n}`,
`T_ρ = T_{(ρ,…,ρ)}`. For `-μ*/(1-μ*) ≤ ρ ≤ 1` put
`λ = ln(ρ/μ* + 1 - ρ)/ln(1/μ*)` if `ρ ≥ 0` and `λ = -ln(1-ρ)/ln(1-μ*)` if `ρ < 0`.
With `σ ∈ {0,1}^n` i.i.d. Bernoulli(λ),

`‖T_ρ f‖_∞ ≤ exp (E_σ ln ‖T_σ f‖_∞)` for every nonnegative `f`  (`main_theorem`),

where the right side is `0` if some `σ` of positive probability has `‖T_σ f‖_∞ = 0`.
-/

namespace TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_07

variable {Ω : Type} [Fintype Ω]

/-- Fully supported probability weights on `Ω`. -/
def IsFullProb (μ : Ω → ℝ) : Prop :=
  (∀ x, 0 < μ x) ∧ ∑ x, μ x = 1

/-- `μs` is `μ* = min_{x ∈ Ω} μ(x)`. -/
def IsMinWeight (μ : Ω → ℝ) (μs : ℝ) : Prop :=
  (∃ x, μ x = μs) ∧ ∀ x, μs ≤ μ x

/-- One-coordinate operator on `Ω^n`:
`(T_{i,a} f)(x) = a f(x) + (1-a) ∑_z μ(z) f(x_1,…,x_{i-1},z,x_{i+1},…,x_n)`. -/
def opT {n : ℕ} (μ : Ω → ℝ) (i : Fin n) (a : ℝ) (f : (Fin n → Ω) → ℝ) :
    (Fin n → Ω) → ℝ :=
  fun x => a * f x + (1 - a) * ∑ z, μ z * f (Function.update x i z)

/-- `T_𝐚 f = T_{1,a_1}(T_{2,a_2}(⋯ T_{n,a_n} f))`. -/
def opTvec {n : ℕ} (μ : Ω → ℝ) (a : Fin n → ℝ) (f : (Fin n → Ω) → ℝ) :
    (Fin n → Ω) → ℝ :=
  (List.ofFn (fun i : Fin n => i)).foldr (fun i g => opT μ i (a i) g) f

/-- `‖g‖_{x:∞} = max_𝐱 |g(𝐱)|`. -/
def supNorm {n : ℕ} (g : (Fin n → Ω) → ℝ) : ℝ := ⨆ x, |g x|

/-- The parameter `λ(μ, ρ)` (with `μs = μ*`). -/
def lam (μs ρ : ℝ) : ℝ :=
  if 0 ≤ ρ then Real.log (ρ * (1 / μs) + 1 - ρ) / Real.log (1 / μs)
  else -(Real.log (1 - ρ) / Real.log (1 - μs))

/-- Probability of `σ ∈ {0,1}^n` under i.i.d. Bernoulli(`l`) coordinates. -/
def bernWeight {n : ℕ} (l : ℝ) (σ : Fin n → Bool) : ℝ :=
  ∏ i, (if σ i then l else 1 - l)

/-- `T_σ` uses the noise vector `a_i = 1` if `σ_i = 1` and `a_i = 0` otherwise. -/
def sigmaVec {n : ℕ} (σ : Fin n → Bool) : Fin n → ℝ :=
  fun i => if σ i then 1 else 0

/-- `‖T_σ f‖_{x:∞, σ:0} = exp (E_σ ln ‖T_σ f‖_{x:∞})`, with the limiting convention: the value
is `0` if some `σ` of positive probability has `‖T_σ f‖_{x:∞} = 0`. -/
def geomBernNorm {n : ℕ} (μ : Ω → ℝ) (l : ℝ) (f : (Fin n → Ω) → ℝ) : ℝ :=
  if ∃ σ : Fin n → Bool, 0 < bernWeight l σ ∧ supNorm (opTvec μ (sigmaVec σ) f) = 0 then 0
  else Real.exp (∑ σ : Fin n → Bool,
    bernWeight l σ * Real.log (supNorm (opTvec μ (sigmaVec σ) f)))

/-- `0 ≤ λ(μ, ρ) ≤ 1` on the allowed range of `ρ`. [GeneralizedSamorodnitskyNoisyFunction, node_07] -/
theorem lam_mem_Icc (μ : Ω → ℝ) (hμ : IsFullProb μ) (hcard : 2 ≤ Fintype.card Ω)
    (μs : ℝ) (hμs : IsMinWeight μ μs) (ρ : ℝ)
    (hρl : -(μs / (1 - μs)) ≤ ρ) (hρu : ρ ≤ 1) :
    0 ≤ lam μs ρ ∧ lam μs ρ ≤ 1 := by
  sorry

/-- Kernel positivity: for `-μ*/(1-μ*) ≤ ρ ≤ 1`, `T_{i,ρ}` maps nonnegative functions to
nonnegative functions (diagonal coefficient `μ(x) + ρ(1-μ(x)) ≥ 0`). [GeneralizedSamorodnitskyNoisyFunction, node_07] -/
theorem opT_nonneg {n : ℕ} (μ : Ω → ℝ) (hμ : IsFullProb μ) (μs : ℝ) (hμs : IsMinWeight μ μs)
    (hcard : 2 ≤ Fintype.card Ω) (ρ : ℝ) (hρl : -(μs / (1 - μs)) ≤ ρ) (hρu : ρ ≤ 1)
    (i : Fin n) (f : (Fin n → Ω) → ℝ) (hf : ∀ x, 0 ≤ f x) (x : Fin n → Ω) :
    0 ≤ opT μ i ρ f x := by
  sorry

/-- Scalar monotonicity: for `0 < ρ < 1`, `t ↦ ln(1 - ρ + ρ t) / ln t` is nondecreasing on
`t > 1` (certificate: convexity of `z ln z`). [GeneralizedSamorodnitskyNoisyFunction, node_07] -/
theorem logRatio_monotone (ρ : ℝ) (h0 : 0 < ρ) (h1 : ρ < 1) (t₁ t₂ : ℝ)
    (ht₁ : 1 < t₁) (ht : t₁ ≤ t₂) :
    Real.log (1 - ρ + ρ * t₁) / Real.log t₁ ≤ Real.log (1 - ρ + ρ * t₂) / Real.log t₂ := by
  sorry

/-- Sharp one-coordinate estimate: for nonnegative `h : Ω → ℝ` with mean `m = ∑ μ h` and
maximum `M`, `max_x (T_ρ h)(x) ≤ m^{1-λ} M^λ`, where `(T_ρ h)(x) = ρ h(x) + (1-ρ) m`. [GeneralizedSamorodnitskyNoisyFunction, node_07] -/
theorem one_coord_estimate (μ : Ω → ℝ) (hμ : IsFullProb μ) (hcard : 2 ≤ Fintype.card Ω)
    (μs : ℝ) (hμs : IsMinWeight μ μs) (ρ : ℝ)
    (hρl : -(μs / (1 - μs)) ≤ ρ) (hρu : ρ ≤ 1)
    (h : Ω → ℝ) (hh : ∀ x, 0 ≤ h x) (x : Ω) :
    ρ * h x + (1 - ρ) * ∑ z, μ z * h z
      ≤ (∑ z, μ z * h z) ^ (1 - lam μs ρ) * (⨆ y, h y) ^ (lam μs ρ) := by
  sorry

/-- Max/geometric-mean swap in the valid direction: for a finite family `g σ y ≥ 0` and
probability weights `w σ`, `max_y GM_σ g(σ, y) ≤ GM_σ max_y g(σ, y)` (geometric means with
the zero convention). [GeneralizedSamorodnitskyNoisyFunction, node_07] -/
theorem max_geom_swap {S Y : Type} [Fintype S] [Fintype Y] [Nonempty Y]
    (w : S → ℝ) (hw0 : ∀ s, 0 ≤ w s) (hw1 : ∑ s, w s = 1)
    (g : S → Y → ℝ) (hg : ∀ s y, 0 ≤ g s y) (y : Y) :
    (if ∃ s, 0 < w s ∧ g s y = 0 then 0
      else Real.exp (∑ s, w s * Real.log (g s y)))
      ≤ (if ∃ s, 0 < w s ∧ (⨆ y', g s y') = 0 then 0
          else Real.exp (∑ s, w s * Real.log (⨆ y', g s y'))) := by
  sorry

/-- **Main theorem.** For every nonnegative `f` on `Ω^n` and `-μ*/(1-μ*) ≤ ρ ≤ 1`,
`‖T_ρ f‖_{x:∞} ≤ ‖T_σ f‖_{x:∞, σ:0}` with `σ_i` i.i.d. Bernoulli(`λ(μ, ρ)`). [GeneralizedSamorodnitskyNoisyFunction, node_07] -/
theorem main_theorem (n : ℕ) (hn : 1 ≤ n) (μ : Ω → ℝ) (hμ : IsFullProb μ)
    (hcard : 2 ≤ Fintype.card Ω) (μs : ℝ) (hμs : IsMinWeight μ μs) (ρ : ℝ)
    (hρl : -(μs / (1 - μs)) ≤ ρ) (hρu : ρ ≤ 1)
    (f : (Fin n → Ω) → ℝ) (hf : ∀ x, 0 ≤ f x) :
    supNorm (opTvec μ (fun _ => ρ) f) ≤ geomBernNorm μ (lam μs ρ) f := by
  sorry

end TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_07
