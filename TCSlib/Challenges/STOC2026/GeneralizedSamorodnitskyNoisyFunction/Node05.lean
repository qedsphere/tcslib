/-!
## Tensorization of noisy mixed-norm inequalities with random noise parameters

`(Ω_i, μ_i)` are finite fully supported probability spaces, `T_{i,a} f = a f + (1-a) E_{X_i} f`,
`T_ρ = T_{1,ρ_1} ⋯ T_{n,ρ_n}` for a random parameter vector `ρ` with independent coordinates.
For `r ≤ p ≤ q ≤ s ≤ ∞`, if every coordinate satisfies
`‖T_{i,ρ_i} g‖_{X_i:q, ρ_i:s} ≤ ‖T_{i,σ_i} g‖_{X_i:p, σ_i:r}` then every `f` satisfies
`‖T_ρ f‖_{X:q, ρ:s} ≤ ‖T_σ f‖_{X:p, σ:r}` (`tensorization`), and the nonnegative variant holds
under positivity preservation (`tensorization_nonneg`).
-/

namespace TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_05

open Finset

/-- The generalized mean `M_{Z,a}(H)` of a function `H ≥ 0` on a finite probability space
`(Z, w)`: `(E H^a)^{1/a}` for `a ≠ 0, ∞`, `exp(E log H)` for `a = 0`, `max H` for `a = ∞`,
"using the usual limiting conventions at zeros". -/
noncomputable def genMean {Z : Type} [Fintype Z] (w : Z → ℝ) (a : WithTop ℝ) (H : Z → ℝ) : ℝ :=
  match a with
  | none => ⨆ z, H z
  | some b =>
    if b = 0 then
      (if ∃ z, H z = 0 then 0 else Real.exp (∑ z, w z * Real.log (H z)))
    else if b < 0 ∧ ∃ z, H z = 0 then 0
    else (∑ z, w z * H z ^ b) ^ (1 / b)

/-- A finite fully supported probability vector. -/
def IsFullProb {Z : Type} [Fintype Z] (w : Z → ℝ) : Prop := (∀ z, 0 < w z) ∧ ∑ z, w z = 1

/-- Variables of the joint space: `X i` is the `i`-th spatial coordinate, `P i` the `i`-th
noise-parameter coordinate. -/
inductive Var (n : ℕ) where
  | X : Fin n → Var n
  | P : Fin n → Var n

variable {n : ℕ} {Ω : Fin n → Type} [∀ i, Fintype (Ω i)]

/-- Averaging out one variable with exponent `a` (applied to `|H|`). The result is a function on
the joint space that no longer depends on that variable. -/
noncomputable def meanOut {K : Fin n → Type} [∀ i, Fintype (K i)]
    (μ : ∀ i, Ω i → ℝ) (π : ∀ i, K i → ℝ) (v : Var n) (a : WithTop ℝ)
    (H : (∀ i, Ω i) → (∀ i, K i) → ℝ) : (∀ i, Ω i) → (∀ i, K i) → ℝ :=
  match v with
  | .X i => fun x k => genMean (μ i) a (fun y => |H (Function.update x i y) k|)
  | .P i => fun x k => genMean (π i) a (fun c => |H x (Function.update k i c)|)

/-- Mixed mean `‖H‖_{Z_1:a_1,…,Z_k:a_k} = M_{Z_k,a_k}(⋯ M_{Z_1,a_1}(|H|) ⋯)`, evaluated left to
right, read off at the base point `(x₀, k₀)`. -/
noncomputable def mixedNorm {K : Fin n → Type} [∀ i, Fintype (K i)]
    (μ : ∀ i, Ω i → ℝ) (π : ∀ i, K i → ℝ) (L : List (Var n × WithTop ℝ))
    (H : (∀ i, Ω i) → (∀ i, K i) → ℝ) (x₀ : ∀ i, Ω i) (k₀ : ∀ i, K i) : ℝ :=
  (L.foldl (fun G e => meanOut μ π e.1 e.2 G) H) x₀ k₀

/-- The variable list `X:a, ρ:b`, i.e. `X_1:a, …, X_n:a, ρ_1:b, …, ρ_n:b`. -/
def normList (n : ℕ) (a b : WithTop ℝ) : List (Var n × WithTop ℝ) :=
  List.ofFn (fun i : Fin n => (Var.X i, a)) ++ List.ofFn (fun i : Fin n => (Var.P i, b))

/-- `(E_{X_i} f)(x) = ∑_y μ_i(y) f(x with x_i := y)`. -/
noncomputable def condAvg (μ : ∀ i, Ω i → ℝ) (i : Fin n) (f : (∀ j, Ω j) → ℝ) :
    (∀ j, Ω j) → ℝ :=
  fun x => ∑ y : Ω i, μ i y * f (Function.update x i y)

/-- `T_{i,a} f = a f + (1-a) E_{X_i} f`. -/
noncomputable def noiseCoord (μ : ∀ i, Ω i → ℝ) (i : Fin n) (a : ℝ) (f : (∀ j, Ω j) → ℝ) :
    (∀ j, Ω j) → ℝ :=
  fun x => a * f x + (1 - a) * condAvg μ i f x

/-- `T_a f = T_{1,a_1} ⋯ T_{n,a_n} f` for a deterministic parameter vector `a`. -/
noncomputable def noiseVec (μ : ∀ i, Ω i → ℝ) (a : Fin n → ℝ) (f : (∀ j, Ω j) → ℝ) :
    (∀ j, Ω j) → ℝ :=
  (List.ofFn (fun i : Fin n => i)).foldr (fun i g => noiseCoord μ i (a i) g) f

/-- `T_ρ f` as a function of `(X, ρ)`: at atoms `k`, the parameter is `ρ_i = v i (k i)`. -/
noncomputable def noiseRand {K : Fin n → Type} (μ : ∀ i, Ω i → ℝ) (v : ∀ i, K i → ℝ)
    (f : (∀ j, Ω j) → ℝ) : (∀ j, Ω j) → (∀ i, K i) → ℝ :=
  fun x k => noiseVec μ (fun i => v i (k i)) f x

/-- One-coordinate operator `T_a g = a g + (1-a) E g` on `(Z, m)`. -/
noncomputable def noise1 {Z : Type} [Fintype Z] (m : Z → ℝ) (a : ℝ) (g : Z → ℝ) : Z → ℝ :=
  fun y => a * g y + (1 - a) * ∑ y', m y' * g y'

/-- One-coordinate mixed norm `‖T_{τ} g‖_{X:a, τ:b}` for a random parameter `τ` with atoms `C`,
masses `π`, values `v`. -/
noncomputable def oneNorm {Z C : Type} [Fintype Z] [Fintype C] (m : Z → ℝ) (π : C → ℝ)
    (v : C → ℝ) (a b : WithTop ℝ) (g : Z → ℝ) : ℝ :=
  genMean π b (fun c => genMean m a (fun y => |noise1 m (v c) g y|))

/-- Rubric 2: monotonicity of generalized means. [GeneralizedSamorodnitskyNoisyFunction, node_05] -/
theorem genMean_mono {Z : Type} [Fintype Z] (w : Z → ℝ) (hw : IsFullProb w) (a : WithTop ℝ)
    (H H' : Z → ℝ) (h0 : ∀ z, 0 ≤ H z) (hle : ∀ z, H z ≤ H' z) :
    genMean w a H ≤ genMean w a H' := by sorry

/-- Rubrics 1, 3, 5: adjacent interchange (generalized Minkowski). For `a ≤ b`,
`‖H‖_{Z:a, W:b} ≤ ‖H‖_{W:b, Z:a}`. [GeneralizedSamorodnitskyNoisyFunction, node_05] -/
theorem genMean_interchange {Z W : Type} [Fintype Z] [Fintype W] (wZ : Z → ℝ) (wW : W → ℝ)
    (hZ : IsFullProb wZ) (hW : IsFullProb wW) (a b : WithTop ℝ) (hab : a ≤ b)
    (H : Z → W → ℝ) :
    genMean wW b (fun w => genMean wZ a (fun z => |H z w|)) ≤
      genMean wZ a (fun z => genMean wW b (fun w => |H z w|)) := by sorry

/-- Rubric 5: means with equal exponents commute. [GeneralizedSamorodnitskyNoisyFunction, node_05] -/
theorem genMean_comm {Z W : Type} [Fintype Z] [Fintype W] (wZ : Z → ℝ) (wW : W → ℝ)
    (hZ : IsFullProb wZ) (hW : IsFullProb wW) (a : WithTop ℝ) (H : Z → W → ℝ) :
    genMean wW a (fun w => genMean wZ a (fun z => |H z w|)) =
      genMean wZ a (fun z => genMean wW a (fun w => |H z w|)) := by sorry

/-- Rubric 1: operators on distinct coordinates commute. [GeneralizedSamorodnitskyNoisyFunction, node_05] -/
theorem noiseCoord_comm (μ : ∀ i, Ω i → ℝ) (i j : Fin n) (a b : ℝ) (f : (∀ l, Ω l) → ℝ) :
    noiseCoord μ i a (noiseCoord μ j b f) = noiseCoord μ j b (noiseCoord μ i a f) := by sorry

/-- **Main theorem (tensorization).** If `r ≤ p ≤ q ≤ s` and every coordinate satisfies `(*)`,
then `‖T_ρ f‖_{X:q,ρ:s} ≤ ‖T_σ f‖_{X:p,σ:r}` for every `f`. [GeneralizedSamorodnitskyNoisyFunction, node_05] -/
theorem tensorization
    (μ : ∀ i, Ω i → ℝ) (hμ : ∀ i, IsFullProb (μ i))
    {Kρ Kσ : Fin n → Type} [∀ i, Fintype (Kρ i)] [∀ i, Fintype (Kσ i)]
    (πρ : ∀ i, Kρ i → ℝ) (hπρ : ∀ i, IsFullProb (πρ i)) (vρ : ∀ i, Kρ i → ℝ)
    (πσ : ∀ i, Kσ i → ℝ) (hπσ : ∀ i, IsFullProb (πσ i)) (vσ : ∀ i, Kσ i → ℝ)
    (r p q s : WithTop ℝ) (hrp : r ≤ p) (hpq : p ≤ q) (hqs : q ≤ s)
    (hbase : ∀ (i : Fin n) (g : Ω i → ℝ),
      oneNorm (μ i) (πρ i) (vρ i) q s g ≤ oneNorm (μ i) (πσ i) (vσ i) p r g)
    (f : (∀ j, Ω j) → ℝ) (x₀ : ∀ i, Ω i) (kρ₀ : ∀ i, Kρ i) (kσ₀ : ∀ i, Kσ i) :
    mixedNorm μ πρ (normList n q s) (noiseRand μ vρ f) x₀ kρ₀ ≤
      mixedNorm μ πσ (normList n p r) (noiseRand μ vσ f) x₀ kσ₀ := by sorry

/-- **Main theorem (nonnegative form).** If `(*)` holds only for nonnegative `g` and every
`T_{i,a}`, `a ∈ supp(ρ_i) ∪ supp(σ_i)`, preserves nonnegativity, then `(**)` holds for every
nonnegative `f`. [GeneralizedSamorodnitskyNoisyFunction, node_05] -/
theorem tensorization_nonneg
    (μ : ∀ i, Ω i → ℝ) (hμ : ∀ i, IsFullProb (μ i))
    {Kρ Kσ : Fin n → Type} [∀ i, Fintype (Kρ i)] [∀ i, Fintype (Kσ i)]
    (πρ : ∀ i, Kρ i → ℝ) (hπρ : ∀ i, IsFullProb (πρ i)) (vρ : ∀ i, Kρ i → ℝ)
    (πσ : ∀ i, Kσ i → ℝ) (hπσ : ∀ i, IsFullProb (πσ i)) (vσ : ∀ i, Kσ i → ℝ)
    (r p q s : WithTop ℝ) (hrp : r ≤ p) (hpq : p ≤ q) (hqs : q ≤ s)
    (hbase : ∀ (i : Fin n) (g : Ω i → ℝ), (∀ y, 0 ≤ g y) →
      oneNorm (μ i) (πρ i) (vρ i) q s g ≤ oneNorm (μ i) (πσ i) (vσ i) p r g)
    (hposρ : ∀ (i : Fin n) (c : Kρ i) (g : Ω i → ℝ), (∀ y, 0 ≤ g y) →
      ∀ y, 0 ≤ noise1 (μ i) (vρ i c) g y)
    (hposσ : ∀ (i : Fin n) (c : Kσ i) (g : Ω i → ℝ), (∀ y, 0 ≤ g y) →
      ∀ y, 0 ≤ noise1 (μ i) (vσ i c) g y)
    (f : (∀ j, Ω j) → ℝ) (hf : ∀ x, 0 ≤ f x)
    (x₀ : ∀ i, Ω i) (kρ₀ : ∀ i, Kρ i) (kσ₀ : ∀ i, Kσ i) :
    mixedNorm μ πρ (normList n q s) (noiseRand μ vρ f) x₀ kρ₀ ≤
      mixedNorm μ πσ (normList n p r) (noiseRand μ vσ f) x₀ kσ₀ := by sorry

end TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_05
