/-!
## Sharp Samorodnitsky-type inequality with Bernoulli(λ) noise on a finite product space

`(Ω, μ)` is a finite fully supported probability space with `|Ω| ≥ 2`, `μ* = min μ`,
`2 ≤ q < ∞`, `0 ≤ ρ ≤ 1`, and
`λ = ln[μ*(1+ρ(1/μ*-1))^q + (1-μ*)(1-ρ)^q] / ((q-1) ln(1/μ*))`.
On `(Ωⁿ, μ^{⊗n})`, `T_{i,t} f = t f + (1-t) E_i f`, `T_a = T_{1,a_1}⋯T_{n,a_n}`. With `σ_i`
i.i.d. Bernoulli(λ), the main theorem `noisy_le_bernoulli_mixed` states
`‖T_ρ f‖_{L_q} ≤ ‖T_σ f‖_{x:q,σ:0}` for nonnegative `f`; `lambda_mem_Icc` gives `0 ≤ λ ≤ 1`,
`tight_one_coord` the equality case for `n = 1`, and `trivial_space` the case `|Ω| = 1`.
-/

namespace TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_06

open Finset

variable {Ω : Type} [Fintype Ω]

/-- `μ* = min_{x ∈ Ω} μ(x)`. -/
noncomputable def muStar [Nonempty Ω] (μ : Ω → ℝ) : ℝ :=
  univ.inf' univ_nonempty μ

/-- `λ = ln[μ*(1+ρ(1/μ*-1))^q + (1-μ*)(1-ρ)^q] / ((q-1) ln(1/μ*))`. -/
noncomputable def lam [Nonempty Ω] (μ : Ω → ℝ) (q ρ : ℝ) : ℝ :=
  Real.log (muStar μ * (1 + ρ * (1 / muStar μ - 1)) ^ q + (1 - muStar μ) * (1 - ρ) ^ q) /
    ((q - 1) * Real.log (1 / muStar μ))

/-- Product measure `μ^{⊗n}(x) = ∏ μ(x_i)`. -/
noncomputable def prodMeas {n : ℕ} (μ : Ω → ℝ) (x : Fin n → Ω) : ℝ :=
  ∏ i, μ (x i)

/-- `E_x F = ∑_x μ^{⊗n}(x) F(x)`. -/
noncomputable def expect {n : ℕ} (μ : Ω → ℝ) (F : (Fin n → Ω) → ℝ) : ℝ :=
  ∑ x, prodMeas μ x * F x

/-- Conditional averaging in coordinate `i`: `(E_i f)(x) = ∑_y μ(y) f(x with x_i := y)`. -/
noncomputable def condAvg {n : ℕ} (μ : Ω → ℝ) (i : Fin n) (f : (Fin n → Ω) → ℝ) :
    (Fin n → Ω) → ℝ :=
  fun x => ∑ y, μ y * f (Function.update x i y)

/-- `T_{i,t} f = t f + (1-t) E_i f`. -/
noncomputable def noiseCoord {n : ℕ} (μ : Ω → ℝ) (i : Fin n) (t : ℝ)
    (f : (Fin n → Ω) → ℝ) : (Fin n → Ω) → ℝ :=
  fun x => t * f x + (1 - t) * condAvg μ i f x

/-- `T_a = T_{1,a_1} ⋯ T_{n,a_n}` (the factors commute). -/
noncomputable def noiseVec {n : ℕ} (μ : Ω → ℝ) (a : Fin n → ℝ)
    (f : (Fin n → Ω) → ℝ) : (Fin n → Ω) → ℝ :=
  (List.ofFn (fun i : Fin n => i)).foldr (fun i g => noiseCoord μ i (a i) g) f

/-- `‖F‖_{L_q(μ^{⊗n})} = (E_x |F|^q)^{1/q}`. -/
noncomputable def lqNorm {n : ℕ} (μ : Ω → ℝ) (q : ℝ) (F : (Fin n → Ω) → ℝ) : ℝ :=
  (expect μ (fun x => |F x| ^ q)) ^ (1 / q)

/-- Probability of `σ ∈ {0,1}ⁿ` under i.i.d. Bernoulli(λ). -/
noncomputable def bernProb {n : ℕ} (l : ℝ) (σ : Fin n → Bool) : ℝ :=
  ∏ i, if σ i then l else 1 - l

/-- `T_σ f`, i.e. `T_{(σ_1,…,σ_n)} f` with `σ_i ∈ {0,1}`. -/
noncomputable def noiseBern {n : ℕ} (μ : Ω → ℝ) (σ : Fin n → Bool)
    (f : (Fin n → Ω) → ℝ) : (Fin n → Ω) → ℝ :=
  noiseVec μ (fun i => if σ i then 1 else 0) f

/-- `‖H‖_{x:q,σ:0} = exp(E_σ ln (E_x H(x,σ)^q)^{1/q})`, understood as `0` when the logarithmic
average is `-∞` (some `σ` of positive probability has zero inner norm). -/
noncomputable def mixedNormQ0 {n : ℕ} (μ : Ω → ℝ) (q l : ℝ)
    (H : (Fin n → Bool) → (Fin n → Ω) → ℝ) : ℝ :=
  if ∃ σ, 0 < bernProb l σ ∧ lqNorm μ q (H σ) = 0 then 0
  else Real.exp (∑ σ, bernProb l σ * Real.log (lqNorm μ q (H σ)))

/-- Fully supported probability measure on `Ω`. -/
def IsFullProb (μ : Ω → ℝ) : Prop := (∀ x, 0 < μ x) ∧ ∑ x, μ x = 1

/-- Rubric 3: `0 ≤ λ ≤ 1`. [GeneralizedSamorodnitskyNoisyFunction, node_06] -/
theorem lambda_mem_Icc [Nonempty Ω] (μ : Ω → ℝ) (hμ : IsFullProb μ)
    (hcard : 2 ≤ Fintype.card Ω) (q ρ : ℝ) (hq : 2 ≤ q) (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) :
    0 ≤ lam μ q ρ ∧ lam μ q ρ ≤ 1 := by sorry

/-- Rubric 1 & 3: the sharp one-coordinate estimate
`‖T_ρ f‖_q ≤ ‖f‖_1^{1-λ} ‖f‖_q^λ` for nonnegative `f` on `Ω` (`n = 1`). [GeneralizedSamorodnitskyNoisyFunction, node_06] -/
theorem one_coord_estimate [Nonempty Ω] (μ : Ω → ℝ) (hμ : IsFullProb μ)
    (hcard : 2 ≤ Fintype.card Ω) (q ρ : ℝ) (hq : 2 ≤ q) (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (f : (Fin 1 → Ω) → ℝ) (hf : ∀ x, 0 ≤ f x) :
    lqNorm μ q (noiseVec μ (fun _ => ρ) f) ≤
      lqNorm μ 1 f ^ (1 - lam μ q ρ) * lqNorm μ q f ^ lam μ q ρ := by sorry

/-- Rubric 3: in one coordinate the Bernoulli geometric norm is `‖f‖_1^{1-λ} ‖f‖_q^λ`. [GeneralizedSamorodnitskyNoisyFunction, node_06] -/
theorem bern_norm_one_coord (μ : Ω → ℝ) (hμ : IsFullProb μ) (q l : ℝ) (hq : 2 ≤ q)
    (hl0 : 0 ≤ l) (hl1 : l ≤ 1) (f : (Fin 1 → Ω) → ℝ) (hf : ∀ x, 0 ≤ f x) :
    mixedNormQ0 μ q l (fun σ => noiseBern μ σ f) =
      lqNorm μ 1 f ^ (1 - l) * lqNorm μ q f ^ l := by sorry

/-- **Main theorem.** For every `n ≥ 1` and nonnegative `f : Ωⁿ → ℝ`,
`‖T_ρ f‖_{L_q(μ^{⊗n})} ≤ ‖T_σ f‖_{x:q,σ:0}` with `σ_i` i.i.d. Bernoulli(λ). [GeneralizedSamorodnitskyNoisyFunction, node_06] -/
theorem noisy_le_bernoulli_mixed [Nonempty Ω] (μ : Ω → ℝ) (hμ : IsFullProb μ)
    (hcard : 2 ≤ Fintype.card Ω) (q ρ : ℝ) (hq : 2 ≤ q) (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (n : ℕ) (hn : 1 ≤ n) (f : (Fin n → Ω) → ℝ) (hf : ∀ x, 0 ≤ f x) :
    lqNorm μ q (noiseVec μ (fun _ => ρ) f) ≤
      mixedNormQ0 μ q (lam μ q ρ) (fun σ => noiseBern μ σ f) := by sorry

/-- Rubric 4 (tightness): for `n = 1`, equality holds for `f = c · 1_{x*}` with `c > 0`,
`μ(x*) = μ*`. [GeneralizedSamorodnitskyNoisyFunction, node_06] -/
theorem tight_one_coord [Nonempty Ω] [DecidableEq Ω] (μ : Ω → ℝ) (hμ : IsFullProb μ)
    (hcard : 2 ≤ Fintype.card Ω) (q ρ : ℝ) (hq : 2 ≤ q) (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1)
    (xstar : Ω) (hxstar : μ xstar = muStar μ) (c : ℝ) (hc : 0 < c) :
    lqNorm μ q (noiseVec μ (fun _ => ρ) (fun x : Fin 1 → Ω => if x 0 = xstar then c else 0)) =
      mixedNormQ0 μ q (lam μ q ρ)
        (fun σ => noiseBern μ σ (fun x : Fin 1 → Ω => if x 0 = xstar then c else 0)) := by sorry

/-- Rubric 4 (degenerate space): if `|Ω| = 1` the inequality holds for every `λ ∈ [0,1]`. [GeneralizedSamorodnitskyNoisyFunction, node_06] -/
theorem trivial_space (μ : Ω → ℝ) (hμ : IsFullProb μ) (hcard : Fintype.card Ω = 1)
    (q ρ l : ℝ) (hq : 2 ≤ q) (hρ0 : 0 ≤ ρ) (hρ1 : ρ ≤ 1) (hl0 : 0 ≤ l) (hl1 : l ≤ 1)
    (n : ℕ) (hn : 1 ≤ n) (f : (Fin n → Ω) → ℝ) (hf : ∀ x, 0 ≤ f x) :
    lqNorm μ q (noiseVec μ (fun _ => ρ) f) ≤
      mixedNormQ0 μ q l (fun σ => noiseBern μ σ f) := by sorry

end TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_06
