/-!
## Swapping adjacent generalized means

Coordinates `j : Fin n` carry finite sets `Ω j` with fully supported probability weights
`μ j`. For `s ∈ ℝ ∪ {∞}` (here `WithTop ℝ`, with `⊤ = ∞`) the generalized mean in
coordinate `j` is `(E h^s)^{1/s}` for `s ≠ 0`, `exp (E log h)` for `s = 0`, and `max h`
for `s = ∞`, with the conventions `log 0 = -∞` and "a mean of order `s ≤ 0` is `0` when its
input vanishes at a (positive-mass) point". Mixed means `‖f‖_{x_{j_1}:s_1,…,x_{j_k}:s_k}`
apply these operators from left to right to `|f|`.

Main theorem `adjacent_swap`: for `1 ≤ i ≤ n-1`, `p ≤ q`, and arbitrary other exponents,
`‖f‖_{…, x_i:p, x_{i+1}:q, …} ≤ ‖f‖_{…, x_{i+1}:q, x_i:p, …}`.
-/

namespace TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_04

/-- Fully supported probability weights on a finite set. -/
def IsFullProb {X : Type} [Fintype X] (w : X → ℝ) : Prop :=
  (∀ x, 0 < w x) ∧ ∑ x, w x = 1

/-- The generalized mean `M_s h` of a nonnegative `h : X → ℝ` w.r.t. weights `w`:
* `s = ∞`: `max_x h x`;
* `s > 0`: `(∑ w h^s)^{1/s}`;
* `s = 0`: `exp (∑ w log h)`, and `0` if `h` vanishes somewhere (`log 0 = -∞`);
* `s < 0`: `(∑ w h^s)^{1/s}`, and `0` if `h` vanishes somewhere (the paper's convention;
  all points have positive mass since `w` is fully supported). -/
def genMean {X : Type} [Fintype X] (w : X → ℝ) (s : WithTop ℝ) (h : X → ℝ) : ℝ :=
  match s with
  | none => ⨆ x, h x
  | some r =>
    if 0 < r then (∑ x, w x * h x ^ r) ^ (1 / r)
    else if ∃ x, h x = 0 then 0
    else if r = 0 then Real.exp (∑ x, w x * Real.log (h x))
    else (∑ x, w x * h x ^ r) ^ (1 / r)

variable {n : ℕ} {Ω : Fin n → Type} [∀ j, Fintype (Ω j)]

/-- `M_{x_j : s}` acting on a function on the product `∏ Ω_j`: average out coordinate `j`
(the result no longer depends on `x_j`). -/
def meanOp (μ : (j : Fin n) → Ω j → ℝ) (j : Fin n) (s : WithTop ℝ)
    (g : ((k : Fin n) → Ω k) → ℝ) : ((k : Fin n) → Ω k) → ℝ :=
  fun x => genMean (μ j) s (fun z => g (Function.update x j z))

/-- `‖f‖_{x_{j_1}:s_1,…,x_{j_k}:s_k} := M_{x_{j_k}:s_k} ⋯ M_{x_{j_1}:s_1} |f|`, with the list
processed from left to right. -/
def mixedMean (μ : (j : Fin n) → Ω j → ℝ) (L : List (Fin n × WithTop ℝ))
    (f : ((k : Fin n) → Ω k) → ℝ) : ((k : Fin n) → Ω k) → ℝ :=
  L.foldl (fun g js => meanOp μ js.1 js.2 g) (fun x => |f x|)

/-- The exponent list `x_{τ 0} : e (τ 0), …, x_{τ (n-1)} : e (τ (n-1))`. -/
def orderedList (τ : Equiv.Perm (Fin n)) (e : Fin n → WithTop ℝ) :
    List (Fin n × WithTop ℝ) :=
  List.ofFn (fun k : Fin n => (τ k, e (τ k)))

/-- Pointwise monotonicity of every generalized mean (including `s ≤ 0` and `s = ∞`)
on nonnegative inputs. [GeneralizedSamorodnitskyNoisyFunction, node_04] -/
theorem genMean_mono {X : Type} [Fintype X] [Nonempty X] (w : X → ℝ) (hw : IsFullProb w)
    (s : WithTop ℝ) (h₁ h₂ : X → ℝ) (h0 : ∀ x, 0 ≤ h₁ x) (hle : ∀ x, h₁ x ≤ h₂ x) :
    genMean w s h₁ ≤ genMean w s h₂ := by
  sorry

/-- Mean-versus-average comparison, convex regime: for `r ≥ 1` the power mean in `b` of the
`a`-average is at most the `a`-average of the power means (Minkowski). [GeneralizedSamorodnitskyNoisyFunction, node_04] -/
theorem powerMean_avg_le {A B : Type} [Fintype A] [Fintype B] (α : A → ℝ) (β : B → ℝ)
    (hα : IsFullProb α) (hβ : IsFullProb β) (r : ℝ) (hr : 1 ≤ r)
    (h : A → B → ℝ) (hpos : ∀ a b, 0 < h a b) :
    genMean β (r : WithTop ℝ) (fun b => ∑ a, α a * h a b)
      ≤ ∑ a, α a * genMean β (r : WithTop ℝ) (fun b => h a b) := by
  sorry

/-- Mean-versus-average comparison, concave regime: for `r ≤ 1`, `r ≠ 0`, and strictly
positive inputs the comparison reverses. [GeneralizedSamorodnitskyNoisyFunction, node_04] -/
theorem avg_powerMean_le {A B : Type} [Fintype A] [Fintype B] (α : A → ℝ) (β : B → ℝ)
    (hα : IsFullProb α) (hβ : IsFullProb β) (r : ℝ) (hr : r ≤ 1) (hr0 : r ≠ 0)
    (h : A → B → ℝ) (hpos : ∀ a b, 0 < h a b) :
    ∑ a, α a * genMean β (r : WithTop ℝ) (fun b => h a b)
      ≤ genMean β (r : WithTop ℝ) (fun b => ∑ a, α a * h a b) := by
  sorry

/-- Two-coordinate swap for nonnegative functions on `A × B` (all exponents, including
`0` and `∞`, and inputs with zeros): averaging first in `a` with exponent `p` and then in
`b` with exponent `q ≥ p` is at most doing it in the opposite order. [GeneralizedSamorodnitskyNoisyFunction, node_04] -/
theorem two_coord_swap {A B : Type} [Fintype A] [Fintype B] (α : A → ℝ) (β : B → ℝ)
    (hα : IsFullProb α) (hβ : IsFullProb β) (p q : WithTop ℝ) (hpq : p ≤ q)
    (g : A → B → ℝ) (hg : ∀ a b, 0 ≤ g a b) :
    genMean β q (fun b => genMean α p (fun a => g a b))
      ≤ genMean α p (fun a => genMean β q (fun b => g a b)) := by
  sorry

/-- Positive-floor regularization: `M_s (max h ε) → M_s h` as `ε ↓ 0`, for nonnegative `h`
and every exponent `s`. [GeneralizedSamorodnitskyNoisyFunction, node_04] -/
theorem genMean_floor_tendsto {X : Type} [Fintype X] [Nonempty X] (w : X → ℝ)
    (hw : IsFullProb w) (s : WithTop ℝ) (h : X → ℝ) (h0 : ∀ x, 0 ≤ h x) :
    Filter.Tendsto (fun ε : ℝ => genMean w s (fun x => max (h x) ε))
      (nhdsWithin 0 (Set.Ioi 0)) (nhds (genMean w s h)) := by
  sorry

/-- **Main theorem.** For `i, i+1` adjacent coordinates (`i.val + 1 < n`), exponents
`e` with `e i = p ≤ q = e (i+1)`, and any `f`,
`‖f‖_{x_1:e_1, …, x_i:p, x_{i+1}:q, …, x_n:e_n} ≤ ‖f‖_{x_1:e_1, …, x_{i+1}:q, x_i:p, …, x_n:e_n}`
(both sides are constants; we state the inequality at every point `x`). [GeneralizedSamorodnitskyNoisyFunction, node_04] -/
theorem adjacent_swap (hn : 2 ≤ n) (μ : (j : Fin n) → Ω j → ℝ)
    (hμ : ∀ j, IsFullProb (μ j))
    (i : Fin n) (hi : i.val + 1 < n) (e : Fin n → WithTop ℝ)
    (hpq : e i ≤ e ⟨i.val + 1, hi⟩)
    (f : ((k : Fin n) → Ω k) → ℝ) (x : (k : Fin n) → Ω k) :
    mixedMean μ (orderedList (Equiv.refl (Fin n)) e) f x
      ≤ mixedMean μ (orderedList (Equiv.swap i ⟨i.val + 1, hi⟩) e) f x := by
  sorry

end TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_04
