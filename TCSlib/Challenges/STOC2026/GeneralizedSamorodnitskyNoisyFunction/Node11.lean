/-!
## The two-point extremal law for the logarithmic moment ratio

Let `q ≥ 2`, `0 < ρ < 1`, `α > 0`. For a finitely supported nonzero random variable `X` with
`E X = 0` and `-1 ≤ X ≤ α`, put
`R_{q,ρ}(X) = ln E(1+ρX)^q / ln E(1+X)^q`.
Let `X_α` take value `α` with probability `1/(1+α)` and `-1` with probability `α/(1+α)`.
The main theorem `ratio_le_extremal_and_eq_iff` states `R_{q,ρ}(X) ≤ R_{q,ρ}(X_α)` with equality
iff `X` and `X_α` have the same law.
-/

namespace TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_11

open Finset

/-- A finitely supported random variable: atoms `ι`, masses `w`, values `x`. -/
structure FinRV (ι : Type) [Fintype ι] where
  w : ι → ℝ
  x : ι → ℝ
  w_pos : ∀ i, 0 < w i
  w_sum : ∑ i, w i = 1

variable {ι : Type} [Fintype ι]

/-- "`E X = 0`, `-1 ≤ X ≤ α`, `X` nonzero": the admissibility conditions of the problem. -/
def Admissible (α : ℝ) (X : FinRV ι) : Prop :=
  (∑ i, X.w i * X.x i = 0) ∧ (∀ i, -1 ≤ X.x i ∧ X.x i ≤ α) ∧ (∃ i, X.x i ≠ 0)

/-- `E (1 + t X)^q`. -/
noncomputable def moment (q t : ℝ) (X : FinRV ι) : ℝ :=
  ∑ i, X.w i * (1 + t * X.x i) ^ q

/-- `R_{q,ρ}(X) = ln E(1+ρX)^q / ln E(1+X)^q`. -/
noncomputable def ratio (q ρ : ℝ) (X : FinRV ι) : ℝ :=
  Real.log (moment q ρ X) / Real.log (moment q 1 X)

/-- `P(X = t)`, the point mass of the law of `X` at `t`. -/
noncomputable def lawMass (X : FinRV ι) (t : ℝ) : ℝ :=
  ∑ i ∈ univ.filter (fun i => X.x i = t), X.w i

/-- The extremal law `X_α`: `P(X_α = α) = 1/(1+α)`, `P(X_α = -1) = α/(1+α)`
(atom `true` carries `α`, atom `false` carries `-1`). -/
noncomputable def Xalpha (α : ℝ) (hα : 0 < α) : FinRV Bool where
  w := fun b => if b then 1 / (1 + α) else α / (1 + α)
  x := fun b => if b then α else -1
  w_pos := by sorry
  w_sum := by sorry

/-- Bregman remainder `g(s,y,z) = (1+sy)^q - (1+sz)^q + q s (z-y) (1+sz)^{q-1}`. -/
noncomputable def bregman (q s y z : ℝ) : ℝ :=
  (1 + s * y) ^ q - (1 + s * z) ^ q + q * s * (z - y) * (1 + s * z) ^ (q - 1)

/-- `h(y,z) = g(1,y,z) / g(ρ,y,z)` (for `y ≠ z`). -/
noncomputable def bregmanRatio (q ρ y z : ℝ) : ℝ :=
  bregman q 1 y z / bregman q ρ y z

/-- Moment `N(t;x,y)` of the two-point mean-zero law on `{x, -y x}` with masses
`y/(1+y)` and `1/(1+y)`. -/
noncomputable def twoPointMoment (q t x y : ℝ) : ℝ :=
  (y * (1 + t * x) ^ q + (1 - t * y * x) ^ q) / (1 + y)

/-- The ratio `ln N(ρ;x,y) / ln N(1;x,y)` for the two-point law on `{x, -y x}`. -/
noncomputable def twoPointRatio (q ρ x y : ℝ) : ℝ :=
  Real.log (twoPointMoment q ρ x y) / Real.log (twoPointMoment q 1 x y)

/-- Rubric 1: the logarithms are positive: `E(1+tX)^q > 1` for `0 < t ≤ 1`. [GeneralizedSamorodnitskyNoisyFunction, node_11] -/
theorem one_lt_moment (q t α : ℝ) (hq : 2 ≤ q) (ht0 : 0 < t) (ht1 : t ≤ 1)
    (X : FinRV ι) (hX : Admissible α X) : 1 < moment q t X := by sorry

/-- Rubric 1: the quadratic case `q = 2`, including the equality case. [GeneralizedSamorodnitskyNoisyFunction, node_11] -/
theorem quadratic_case (ρ α : ℝ) (hρ0 : 0 < ρ) (hρ1 : ρ < 1) (hα : 0 < α)
    (X : FinRV ι) (hX : Admissible α X) :
    ratio 2 ρ X ≤ ratio 2 ρ (Xalpha α hα) ∧
      (ratio 2 ρ X = ratio 2 ρ (Xalpha α hα) ↔
        ∀ t : ℝ, lawMass X t = lawMass (Xalpha α hα) t) := by sorry

/-- Rubric 2: for fixed `z ≥ -1`, `y ↦ h(y,z)` is strictly increasing on `[-1, ∞) \ {z}`. [GeneralizedSamorodnitskyNoisyFunction, node_11] -/
theorem bregmanRatio_strictMono (q ρ z : ℝ) (hq : 2 < q) (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hz : -1 ≤ z) (y₁ y₂ : ℝ) (hy₁ : -1 ≤ y₁) (hlt : y₁ < y₂) (h₁ : y₁ ≠ z) (h₂ : y₂ ≠ z) :
    bregmanRatio q ρ y₁ z < bregmanRatio q ρ y₂ z := by sorry

/-- Rubric 3: for fixed `x > 0`, the two-point ratio increases strictly in `y ∈ (0, 1/x]`
(pushing the negative atom `-y x` towards `-1`). [GeneralizedSamorodnitskyNoisyFunction, node_11] -/
theorem twoPointRatio_strictMonoOn_y (q ρ x : ℝ) (hq : 2 < q) (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hx : 0 < x) : StrictMonoOn (fun y => twoPointRatio q ρ x y) (Set.Ioc 0 (1 / x)) := by sorry

/-- Rubric 4: with the negative atom at `-1` (`y = 1/x`), the ratio increases strictly in `x > 0`. [GeneralizedSamorodnitskyNoisyFunction, node_11] -/
theorem twoPointRatio_strictMonoOn_x (q ρ : ℝ) (hq : 2 < q) (hρ0 : 0 < ρ) (hρ1 : ρ < 1) :
    StrictMonoOn (fun x => twoPointRatio q ρ x (1 / x)) (Set.Ioi 0) := by sorry

/-- **Main theorem.** `R_{q,ρ}(X) ≤ R_{q,ρ}(X_α)` for every admissible `X`, with equality iff `X`
and `X_α` have the same distribution. [GeneralizedSamorodnitskyNoisyFunction, node_11] -/
theorem ratio_le_extremal_and_eq_iff (q ρ α : ℝ) (hq : 2 ≤ q) (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (hα : 0 < α) (X : FinRV ι) (hX : Admissible α X) :
    ratio q ρ X ≤ ratio q ρ (Xalpha α hα) ∧
      (ratio q ρ X = ratio q ρ (Xalpha α hα) ↔
        ∀ t : ℝ, lawMass X t = lawMass (Xalpha α hα) t) := by sorry

end TCSChallenge.GeneralizedSamorodnitskyNoisyFunction.node_11
