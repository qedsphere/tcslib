/-!
## Certified approximation of acceptance probabilities of ordered branching programs

An ordered branching program `B` has layers `V_0, …, V_L` (layer `i` is `Fin (B.width i)`),
an initial vertex in `V_0`, and from every vertex of a nonfinal layer two labelled edges
into the next layer. `reachProb B i v` is the probability `p_v` of reaching `v` under
independent uniform edge labels, and `accProb B = Σ_{v ∈ F} p_v`.

With `τ = 1/(10N³)`, `h = 1/(100N⁴)`, a table `q` *passes* if `|q_{v₀} − 1| ≤ τ` (and every
other initial-layer entry is within `τ` of `0`) and every later vertex satisfies
`|q_v − ½ Σ_{(u,b) → v} q_u| ≤ τ`. The main theorem `certified_decision` states:
for a program of length and width at most `N ≥ 2` with a single initial vertex,
* rounding the exact probabilities at any shift gives a passing table (termination of the
  search), and
* every passing table `q` (whatever produced it) has `|Σ_{v∈F} q_v − p(B)| ≤ 1/(8N)`, so
  thresholding at `1/2` outputs `0` when `p(B) ≤ 1/4` and `1` when `p(B) ≥ 3/4`.
-/

namespace TCSChallenge.CertifiedHardnessVsRandomness.node_04

/-- "An ordered branching program has layers V_0, ..., V_L, a single initial vertex in V_0,
and two outgoing edges, labeled 0 and 1, from every vertex in a nonfinal layer to the next
layer." Layer `i` is `Fin (width i)`; `accept` is the designated set `F ⊆ V_L`. -/
structure OBP where
  len : ℕ
  width : ℕ → ℕ
  start : Fin (width 0)
  next : (i : ℕ) → Fin (width i) → Bool → Fin (width (i + 1))
  accept : Fin (width len) → Bool

namespace OBP

/-- The state reached after reading the bits `y 0, …, y (i-1)`. -/
def stateAfter (B : OBP) (y : ℕ → Bool) : (i : ℕ) → Fin (B.width i)
  | 0 => B.start
  | i + 1 => B.next i (stateAfter B y i) (y i)

/-- Extend a finite input `x : Fin L → Bool` to a bit stream (padding with `false`). -/
def ext {L : ℕ} (x : Fin L → Bool) : ℕ → Bool :=
  fun k => if h : k < L then x ⟨k, h⟩ else false

/-- The output label of the terminal vertex reached on the stream `y`. -/
def outputOn (B : OBP) (y : ℕ → Bool) : Bool :=
  B.accept (B.stateAfter y B.len)

/-- "Write p_v for the probability of reaching vertex v": reachability probabilities under
independent uniform edge labels, defined layer by layer. -/
def reachProb (B : OBP) : (i : ℕ) → Fin (B.width i) → ℝ
  | 0, v => if v = B.start then 1 else 0
  | i + 1, w => ∑ v : Fin (B.width i), ∑ b : Bool,
      if B.next i v b = w then reachProb B i v / 2 else 0

/-- "p(B) = Σ_{v∈F} p_v." -/
def accProb (B : OBP) : ℝ :=
  ∑ v : Fin (B.width B.len), if B.accept v then B.reachProb B.len v else 0

/-- "B has length and width at most N", with a single initial vertex. -/
def Bounded (B : OBP) (N : ℕ) : Prop :=
  B.width 0 = 1 ∧ B.len ≤ N ∧ ∀ i, i ≤ B.len → B.width i ≤ N

end OBP

open OBP

/-- A purported table of probabilities `q_v`, one real per vertex. -/
abbrev Table (B : OBP) : Type := (i : ℕ) → Fin (B.width i) → ℝ

/-- "Σ_{v∈F} q_v": the value returned by the search for a table. -/
def tableValue (B : OBP) (q : Table B) : ℝ :=
  ∑ v : Fin (B.width B.len), if B.accept v then q B.len v else 0

/-- The local residual at a vertex `w` of layer `i+1`:
"q_w − (1/2) Σ_{(u,b): edge b from u leads to w} q_u". -/
def residual (B : OBP) (q : Table B) (i : ℕ) (w : Fin (B.width (i + 1))) : ℝ :=
  q (i + 1) w - (1 / 2) * ∑ u : Fin (B.width i), ∑ b : Bool,
    if B.next i u b = w then q i u else 0

/-- The local certificate check with tolerance `τ`:
"At the initial vertex v_0, |q_{v_0} − 1| ≤ τ. For every v in a layer after the initial layer,
|q_v − (1/2) Σ q_u| ≤ τ." (Initial-layer entries other than `v₀` must be within `τ` of 0;
under `Bounded` the initial layer is `{v₀}`.) -/
def Passes (B : OBP) (τ : ℝ) (q : Table B) : Prop :=
  (∀ v : Fin (B.width 0), |q 0 v - (if v = B.start then 1 else 0)| ≤ τ) ∧
  ∀ i, i < B.len → ∀ w : Fin (B.width (i + 1)), |residual B q i w| ≤ τ

/-- `τ = 1/(10N³)`. -/
def tau (N : ℕ) : ℝ := 1 / (10 * (N : ℝ) ^ 3)

/-- `H = 100N⁴`, `h = 1/H`. -/
def hstep (N : ℕ) : ℝ := 1 / (100 * (N : ℝ) ^ 4)

/-- "D_i = Σ_{v∈V_i} |q_v − p_v|". -/
def layerErr (B : OBP) (q : Table B) (i : ℕ) : ℝ :=
  ∑ v : Fin (B.width i), |q i v - B.reachProb i v|

/-- `clip_[0,1]`. -/
def clip01 (x : ℝ) : ℝ := max 0 (min 1 x)

/-- "k(C,j) = floor((p(C)+r_j)/h)". -/
def roundIdx (h r p : ℝ) : ℤ := ⌊(p + r) / h⌋

/-- "q(C,j) = clip_[0,1](h k(C,j) − r_j)". -/
def roundVal (h r p : ℝ) : ℝ := clip01 (h * (roundIdx h r p : ℝ) - r)

/-- "dist(x, hℤ) > γ". -/
def FarFromGrid (h γ x : ℝ) : Prop := ∀ z : ℤ, γ < |x - (z : ℝ) * h|

/-- `K = 8(N+1)²`. -/
def numShifts (N : ℕ) : ℕ := 8 * (N + 1) ^ 2

/-- `Δ = h/K`, the spacing of the shifts `r_j = jΔ`. -/
def shiftGap (N : ℕ) : ℝ := hstep N / (numShifts N : ℝ)

/-- The rounded table at shift index `j`, built from the exact probabilities. -/
def roundedTable (B : OBP) (N j : ℕ) : Table B :=
  fun i v => roundVal (hstep N) ((j : ℝ) * shiftGap N) (B.reachProb i v)

/-! ### Rubric item 1: the locally verifiable certificate -/

/-- Completeness: "if |q_v − p_v| ≤ h for every v, … all checks pass." [CertifiedHardnessVsRandomness, node_04] -/
theorem passes_of_accurate (B : OBP) (N : ℕ) (hN : 2 ≤ N) (hB : B.Bounded N)
    (q : Table B)
    (hq : ∀ i, i ≤ B.len → ∀ v : Fin (B.width i), |q i v - B.reachProb i v| ≤ hstep N) :
    Passes B (tau N) q := by
  sorry

/-- Layer recursion: "D_0 ≤ τ, D_i ≤ D_{i−1} + |V_i|τ", in closed form. [CertifiedHardnessVsRandomness, node_04] -/
theorem layerErr_le (B : OBP) (τ : ℝ) (q : Table B) (hpass : Passes B τ q)
    (h0 : B.width 0 = 1) (i : ℕ) (hi : i ≤ B.len) :
    layerErr B q i ≤ τ * ∑ j ∈ Finset.range (i + 1), (B.width j : ℝ) := by
  sorry

/-- Soundness (1): every passing table, of any provenance, satisfies
"|Σ_{v∈F} q_v − p(B)| ≤ 1/(8N)". [CertifiedHardnessVsRandomness, node_04] -/
theorem passes_sound (B : OBP) (N : ℕ) (hN : 2 ≤ N) (hB : B.Bounded N)
    (q : Table B) (hpass : Passes B (tau N) q) :
    |tableValue B q - B.accProb| ≤ 1 / (8 * (N : ℝ)) := by
  sorry

/-! ### Rubric item 2: stable rounding and one good shift -/

/-- (2): "For every C and j, including those at rounding boundaries, |q(C,j) − p(C)| ≤ h." [CertifiedHardnessVsRandomness, node_04] -/
theorem roundVal_close (h r p : ℝ) (hh : 0 < h) (hr0 : 0 ≤ r) (hrh : r < h)
    (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    |roundVal h r p - p| ≤ h := by
  sorry

/-- Stability away from boundaries: under promise (3), any estimate `a` with
`|a − p| < γ` rounds to the same index `k(C,j)`. [CertifiedHardnessVsRandomness, node_04] -/
theorem roundIdx_stable (h γ r p a : ℝ) (hh : 0 < h) (hγ : 0 < γ)
    (hfar : FarFromGrid h γ (p + r)) (ha : |a - p| < γ) :
    roundIdx h r a = roundIdx h r p := by
  sorry

/-- "There is a single shift j for which (3) holds simultaneously for all C_v":
for at most `N²+1` probabilities, some `j < K = 8(N+1)²` makes every `p_m + jΔ` farther
than `γ = Δ/4` from `hℤ`. [CertifiedHardnessVsRandomness, node_04] -/
theorem exists_good_shift (N M : ℕ) (hN : 2 ≤ N) (hM : M ≤ N ^ 2 + 1)
    (p : Fin M → ℝ) (hp : ∀ m, 0 ≤ p m ∧ p m ≤ 1) :
    ∃ j : ℕ, j < numShifts N ∧
      ∀ m, FarFromGrid (hstep N) (shiftGap N / 4) (p m + (j : ℝ) * shiftGap N) := by
  sorry

/-! ### Main theorem: termination and correctness core of the universal search -/

/-- For a program of length and width at most `N ≥ 2` with one initial vertex:
(a) for every shift `j < K` the exactly rounded table passes the check (so the exhaustive
candidate makes the search halt unconditionally), and
(b) every passing table `q` yields the correct decision: thresholding
`E = Σ_{v∈F} q_v` at `1/2` outputs `0` when `p(B) ≤ 1/4` and `1` when `p(B) ≥ 3/4`. [CertifiedHardnessVsRandomness, node_04] -/
theorem certified_decision (B : OBP) (N : ℕ) (hN : 2 ≤ N) (hB : B.Bounded N) :
    (∀ j, j < numShifts N → Passes B (tau N) (roundedTable B N j)) ∧
    (∀ q : Table B, Passes B (tau N) q →
      (B.accProb ≤ 1 / 4 → tableValue B q < 1 / 2) ∧
      (3 / 4 ≤ B.accProb → 1 / 2 < tableValue B q)) := by
  sorry

end TCSChallenge.CertifiedHardnessVsRandomness.node_04
