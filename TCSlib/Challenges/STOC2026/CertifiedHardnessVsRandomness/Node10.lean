/-!
## Derandomizing ordered branching programs: approximate or reconstruct

Let `B` be an ordered branching program of length `n` and width at most `n`, and let
`G : {0,1}^s → {0,1}^n`. For `v ∈ V_i` and a bit `b`, `a_{v,b}` counts seeds `z` such that
`B` reaches `v` on `G(z)_{1..i}` and `G(z)_{i+1} = b`; `d_v = a_{v,1} − a_{v,0}` and
`A_i = Σ_{v∈V_i} |d_v|`. The test at layer `i` is `4n A_i ≤ 2^s`.

The main theorem `approximate_or_reconstruct` states:
* if every test passes, the generator average `q = 2^{-s} #{z : B(G z) = 1}` satisfies
  `|q − 2^{-n} Σ_x B(x)| ≤ 1/4`;
* if the test at layer `i < n` fails, the truncation of `B` at layer `i`, labelled by the
  sign of `d_v`, is a program of length `i < n` and size `≤ n²` whose next-bit correlation
  exceeds `1/(4n)`, so the supplied reconstruction `R` returns a circuit of size
  `≤ 2^{εm}` computing `f_m` everywhere.
-/

namespace TCSChallenge.CertifiedHardnessVsRandomness.node_10

/-- "An ordered branching program has layers V_0, ..., V_L, a single initial vertex in V_0,
and two outgoing edges, labeled 0 and 1, from every vertex in a nonfinal layer to the next
layer." Layer `i` is `Fin (width i)`; `accept` is the designated set `F ⊆ V_L`. -/
structure OBP where
  len : ℕ
  width : ℕ → ℕ
  start : Fin (width 0)
  next : (i : ℕ) → Fin (width i) → Bool → Fin (width (i + 1))
  accept : Fin (width len) → Bool

namespace OBP

/-- The state reached after reading the bits `y 0, …, y (i-1)`. -/
def stateAfter (B : OBP) (y : ℕ → Bool) : (i : ℕ) → Fin (B.width i)
  | 0 => B.start
  | i + 1 => B.next i (stateAfter B y i) (y i)

/-- Extend a finite input `x : Fin L → Bool` to a bit stream (padding with `false`). -/
def ext {L : ℕ} (x : Fin L → Bool) : ℕ → Bool :=
  fun k => if h : k < L then x ⟨k, h⟩ else false

/-- The output label of the terminal vertex reached on the stream `y`. -/
def outputOn (B : OBP) (y : ℕ → Bool) : Bool :=
  B.accept (B.stateAfter y B.len)

/-- "Write p_v for the probability of reaching vertex v": reachability probabilities under
independent uniform edge labels, defined layer by layer. -/
def reachProb (B : OBP) : (i : ℕ) → Fin (B.width i) → ℝ
  | 0, v => if v = B.start then 1 else 0
  | i + 1, w => ∑ v : Fin (B.width i), ∑ b : Bool,
      if B.next i v b = w then reachProb B i v / 2 else 0

/-- "p(B) = Σ_{v∈F} p_v." -/
def accProb (B : OBP) : ℝ :=
  ∑ v : Fin (B.width B.len), if B.accept v then B.reachProb B.len v else 0

/-- "B has length and width at most N", with a single initial vertex. -/
def Bounded (B : OBP) (N : ℕ) : Prop :=
  B.width 0 = 1 ∧ B.len ≤ N ∧ ∀ i, i ≤ B.len → B.width i ≤ N

end OBP

open OBP

/-- "Its size is its total number of vertices": `Σ_{j ≤ len} |V_j|`. -/
def size (P : OBP) : ℕ := ∑ j ∈ Finset.range (P.len + 1), P.width j

/-- "B is an ordered branching program of length n and width at most n". -/
def LenWidth (B : OBP) (n : ℕ) : Prop := B.len = n ∧ ∀ i, i ≤ n → B.width i ≤ n

/-- "2^{-n} Σ_{x∈{0,1}^n} B(x)". -/
def unifAvg (B : OBP) (n : ℕ) : ℝ :=
  ((Finset.univ.filter (fun x : Fin n → Bool => B.outputOn (ext x) = true)).card : ℝ) /
    (2 : ℝ) ^ n

/-- The generator acceptance average `q = |{z : B(G(z)) = 1}| / 2^s`. -/
def genAvg {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) : ℝ :=
  ((Finset.univ.filter (fun z : Fin s → Bool => B.outputOn (ext (G z)) = true)).card : ℝ) /
    (2 : ℝ) ^ s

/-- "a_{v,b} = |{z : B reaches v after reading G(z)_{1..i}, and G(z)_{i+1} = b}|". -/
def cnt {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) (i : ℕ)
    (v : Fin (B.width i)) (b : Bool) : ℕ :=
  (Finset.univ.filter (fun z : Fin s → Bool =>
    B.stateAfter (ext (G z)) i = v ∧ ext (G z) i = b)).card

/-- "d_v = a_{v,1} − a_{v,0}". -/
def imb {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) (i : ℕ)
    (v : Fin (B.width i)) : ℤ :=
  (cnt B G i v true : ℤ) - (cnt B G i v false : ℤ)

/-- "A_i = Σ_{v∈V_i} |d_v|". -/
def aggImb {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) (i : ℕ) : ℤ :=
  ∑ v : Fin (B.width i), |imb B G i v|

/-- The test (1) at layer `i`: "4n A_i ≤ D", `D = 2^s`. -/
def TestPasses {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) (i : ℕ) : Prop :=
  4 * (n : ℤ) * aggImb B G i ≤ (2 : ℤ) ^ s

/-- "q_i(v)": the probability of reaching `v` after the first `i` bits of `G(U_s)`. -/
def genReach {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) (i : ℕ)
    (v : Fin (B.width i)) : ℝ :=
  ((Finset.univ.filter (fun z : Fin s → Bool => B.stateAfter (ext (G z)) i = v)).card : ℝ) /
    (2 : ℝ) ^ s

/-- "L_i = Σ_{v∈V_i} |p_i(v) − q_i(v)|". -/
def distErr {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) (i : ℕ) : ℝ :=
  ∑ v : Fin (B.width i), |B.reachProb i v - genReach B G i v|

/-- "Construct a program P of length i by retaining B's layers and transitions through V_i
and assigning each v in V_i the terminal label ℓ(v) = 1 if d_v ≥ 0, and ℓ(v) = 0 if d_v < 0." -/
def predictor {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) (i : ℕ) : OBP :=
  { len := i, width := B.width, start := B.start, next := B.next,
    accept := fun v => decide (0 ≤ imb B G i v) }

/-- "Pr_z[P(G(z)_{1..i}) = G(z)_{i+1}]" for a program `P` of length `i = P.len`. -/
def predSuccess {s n : ℕ} (P : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) : ℝ :=
  ((Finset.univ.filter (fun z : Fin s → Bool =>
    P.outputOn (ext (G z)) = ext (G z) P.len)).card : ℝ) / (2 : ℝ) ^ s

/-- "E_z[(-1)^{P(G_N(z)_{1..i}) + G_N(z)_{i+1}}]" with `i = P.len`. -/
def nextBitCorr {s n : ℕ} (P : OBP) (G : (Fin s → Bool) → (Fin n → Bool)) : ℝ :=
  (∑ z : Fin s → Bool,
    (if P.outputOn (ext (G z)) = ext (G z) P.len then (1 : ℝ) else -1)) / (2 : ℝ) ^ s

/-! ### Rubric items 1–2: the soundness invariant -/

/-- "Under independent uniform input … aggregating edges … L_{i+1} ≤ L_i + A_i/D." [CertifiedHardnessVsRandomness, node_10] -/
theorem distErr_succ_le {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool))
    (i : ℕ) (hi : i < n) :
    distErr B G (i + 1) ≤ distErr B G i + (aggImb B G i : ℝ) / (2 : ℝ) ^ s := by
  sorry

/-- The uniform average equals the reachability-probability acceptance probability. [CertifiedHardnessVsRandomness, node_10] -/
theorem unifAvg_eq_accProb (B : OBP) (n : ℕ) (hlen : B.len = n) :
    unifAvg B n = B.accProb := by
  sorry

/-- "If every check (1) passes, … |E[B] − E_z[B(G(z))]| ≤ L_n ≤ 1/4." [CertifiedHardnessVsRandomness, node_10] -/
theorem genAvg_close {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool))
    (hn : 1 ≤ n) (hB : LenWidth B n) (hpass : ∀ i, i < n → TestPasses B G i) :
    |genAvg B G - unifAvg B n| ≤ 1 / 4 := by
  sorry

/-! ### Rubric item 3: predictor extraction -/

/-- "Its total prediction success probability is exactly 1/2 + A_i/(2D)." [CertifiedHardnessVsRandomness, node_10] -/
theorem predSuccess_eq {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool))
    (i : ℕ) (hi : i < n) :
    predSuccess (predictor B G i) G = 1 / 2 + (aggImb B G i : ℝ) / (2 * (2 : ℝ) ^ s) := by
  sorry

/-- From a failed test, the predictor has success `> 1/2 + 1/(8n)`, i.e. correlation
`> 1/(4n)`, length `i < n` and at most `n²` vertices. [CertifiedHardnessVsRandomness, node_10] -/
theorem predictor_good {s n : ℕ} (B : OBP) (G : (Fin s → Bool) → (Fin n → Bool))
    (hn : 1 ≤ n) (hB : LenWidth B n) (i : ℕ) (hi : i < n) (hfail : ¬ TestPasses B G i) :
    (predictor B G i).len = i ∧ size (predictor B G i) ≤ n ^ 2 ∧
    1 / 2 + 1 / (8 * (n : ℝ)) < predSuccess (predictor B G i) G ∧
    1 / (4 * (n : ℝ)) < nextBitCorr (predictor B G i) G := by
  sorry

/-! ### Main theorem -/

/-- The two-branch guarantee of the explicit algorithm. `R` is the supplied reconstruction:
on any program `P` of length `< n` and size `≤ n²` with next-bit correlation `> 1/(4n)` on
`G`, it returns a circuit of size `≤ 2^{εm}` computing `f` on every input. [CertifiedHardnessVsRandomness, node_10] -/
theorem approximate_or_reconstruct {s n m : ℕ} (ε : ℝ) (hε : 0 < ε)
    (G : (Fin s → Bool) → (Fin n → Bool))
    (f : (Fin m → Bool) → Bool)
    (Circ : Type) (evalC : Circ → (Fin m → Bool) → Bool) (sizeC : Circ → ℕ)
    (R : OBP → Circ)
    (hR : ∀ P : OBP, P.len < n → size P ≤ n ^ 2 → 1 / (4 * (n : ℝ)) < nextBitCorr P G →
      (sizeC (R P) : ℝ) ≤ (2 : ℝ) ^ (ε * (m : ℝ)) ∧ ∀ x, evalC (R P) x = f x)
    (B : OBP) (hn : 1 ≤ n) (hB : LenWidth B n) :
    ((∀ i, i < n → TestPasses B G i) → |genAvg B G - unifAvg B n| ≤ 1 / 4) ∧
    (∀ i, i < n → ¬ TestPasses B G i →
      (sizeC (R (predictor B G i)) : ℝ) ≤ (2 : ℝ) ^ (ε * (m : ℝ)) ∧
      ∀ x, evalC (R (predictor B G i)) x = f x) := by
  sorry

end TCSChallenge.CertifiedHardnessVsRandomness.node_10
