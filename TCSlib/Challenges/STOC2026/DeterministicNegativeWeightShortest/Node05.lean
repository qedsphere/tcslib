/-!
## Lower bound for clustered path covers

For a subgraph `H ⊆ G` and an SCC `C` of `H`, `diam_H(C) = max dist_{H[C]}(u,v)`. `H` is
`D`-clustered if every SCC has `diam_H(C) ≤ D`. A family `H₁,…,H_z` covers all `d`-paths if
every simple directed path with exactly `d` edges lies inside some `H_i`.

Main theorem `clustered_path_cover_lower_bound`: there are absolute `c, C > 0` such that for all
reals `m, λ ≥ 1` there is a digraph `G` with `|E(G)| ≤ C m` and `d ≥ 1` such that every family
of `dλ`-clustered subgraphs covering all `d`-paths has `∑ |E(H_i)| ≥ c m √(m/λ)`.
-/

namespace TCSChallenge.DeterministicNegativeWeightShortestPaths.node_05

variable {V : Type}

/-- Directed reachability `u ⇝ v` using edges of `H`. -/
def Reach (H : Finset (V × V)) (u v : V) : Prop :=
  Relation.ReflTransGen (fun x y => (x, y) ∈ H) u v

/-- The strongly connected component of `u` in `H`: all `x` with `u ⇝ x` and `x ⇝ u`. -/
def SCC (H : Finset (V × V)) (u : V) : Set V :=
  {x | Reach H u x ∧ Reach H x u}

/-- A walk with `k` edges in `H[S]`: consecutive vertices joined by `H`-edges and every vertex
in `S`. -/
def IsWalkIn (H : Finset (V × V)) (S : Set V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  (∀ i : Fin k, (p i.castSucc, p i.succ) ∈ H) ∧ ∀ i, p i ∈ S

/-- "`H` is `D`-clustered if `diam_H(C) ≤ D` for every strongly connected component `C` of
`H`", where `diam_H(C) = max{dist_{H[C]}(u,v) : u,v ∈ C}` and distances count edges. -/
def IsClustered (H : Finset (V × V)) (D : ℝ) : Prop :=
  ∀ u v : V, v ∈ SCC H u →
    ∃ k : ℕ, (k : ℝ) ≤ D ∧ ∃ p : Fin (k + 1) → V,
      IsWalkIn H (SCC H u) p ∧ p 0 = u ∧ p (Fin.last k) = v

/-- "A directed `d`-path is a simple directed path with exactly `d` edges." -/
def IsDPath (E : Finset (V × V)) (d : ℕ) (p : Fin (d + 1) → V) : Prop :=
  Function.Injective p ∧ ∀ i : Fin d, (p i.castSucc, p i.succ) ∈ E

/-- "`H₁,…,H_z` covers all `d`-paths if every directed `d`-path `P` in `G` satisfies
`E(P) ⊆ E(H_i)` for some `i`." -/
def CoversDPaths (E : Finset (V × V)) {z : ℕ} (H : Fin z → Finset (V × V)) (d : ℕ) : Prop :=
  ∀ p : Fin (d + 1) → V, IsDPath E d p →
    ∃ i : Fin z, ∀ j : Fin d, (p j.castSucc, p j.succ) ∈ H i

/-- Rubric 3 (diameter obstruction, generic form): if `u, v` are mutually reachable in `H` but
every `H`-walk from `u` to `v` has more than `D` edges, then `H` is not `D`-clustered. [DeterministicNegativeWeightShortest, node_05] -/
theorem not_clustered_of_long (H : Finset (V × V)) (D : ℝ) (u v : V)
    (huv : Reach H u v) (hvu : Reach H v u)
    (hlong : ∀ (k : ℕ) (p : Fin (k + 1) → V), (∀ i : Fin k, (p i.castSucc, p i.succ) ∈ H) →
      p 0 = u → p (Fin.last k) = v → D < (k : ℝ)) :
    ¬ IsClustered H D := by
  sorry

/-- Rubric 5 (incidence count): `∑_i |E(H_i)| ≥ ∑_{e ∈ S} |{i : e ∈ E(H_i)}|`. [DeterministicNegativeWeightShortest, node_05] -/
theorem incidence_count {n z : ℕ} (H : Fin z → Finset (Fin n × Fin n))
    (S : Finset (Fin n × Fin n)) :
    ∑ e ∈ S, (Finset.univ.filter (fun i : Fin z => e ∈ H i)).card ≤ ∑ i, (H i).card := by
  sorry

/-- `⌊x⌋ ≥ x/2` for `x ≥ 1` (used for `M = ⌊m⌋` and `L = ⌊√(m/λ)⌋`). [DeterministicNegativeWeightShortest, node_05] -/
theorem half_le_floor (x : ℝ) (hx : 1 ≤ x) : x / 2 ≤ (⌊x⌋₊ : ℝ) := by
  sorry

/-- Main theorem. [DeterministicNegativeWeightShortest, node_05] -/
theorem clustered_path_cover_lower_bound :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧ ∀ m lam : ℝ, 1 ≤ m → 1 ≤ lam →
      ∃ (n : ℕ) (E : Finset (Fin n × Fin n)) (d : ℕ),
        (∀ e ∈ E, e.1 ≠ e.2) ∧ (E.card : ℝ) ≤ C * m ∧ 0 < d ∧
        ∀ (z : ℕ) (H : Fin z → Finset (Fin n × Fin n)),
          (∀ i, H i ⊆ E) → (∀ i, IsClustered (H i) ((d : ℝ) * lam)) →
          CoversDPaths E H d →
          c * m * Real.sqrt (m / lam) ≤ ∑ i, ((H i).card : ℝ) := by
  sorry

