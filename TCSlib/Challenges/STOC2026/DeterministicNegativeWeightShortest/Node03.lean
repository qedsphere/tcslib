/-!
## Negative-weight SSSP in `O(m log⁸ n log(nW))`: the accounting

A *restricted* `N`-vertex instance has weights in `{-1,0,…,N}`, every directed cycle `C`
has `w(C)/|C| ≥ 1` (equivalently `w(C) ≥ |C|`), and a zero-weight edge from the source to
every other vertex. The recursive routine `R(H,k)` obeys the recurrence
`T(M,k) ≤ T((1+1/ℓ)M, ⌈k/2⌉) + c M ℓ⁷` with `ℓ = max{1, ⌈log₂ N⌉}`, and no recursion once
`k ≤ L`. The challenge:

* `restricted_minWalk_negEdges_le`: `k = N` is a legal initial parameter;
* `restricted_recurrence_solution`: the recurrence gives `T(M,N) = O(M ℓ⁸)`;
* `general_sssp_time_bound` (main theorem): composing with the `q = O(log(nW))`-stage
  scaling procedure gives total cost `O(m log⁸ n log(nW))`.
-/

namespace TCSChallenge.DeterministicNegativeWeightShortestPaths.node_03

/-! ## Restricted instances and minimum-weight walks -/

/-- A directed graph `G = (V, E, w)` with integer edge weights. Only `w` on `E` matters. -/
structure WDigraph (V : Type) where
  edges : Finset (V × V)
  weight : V × V → ℤ

variable {V : Type}

/-- A walk with `k` edges, given by its vertex sequence `p 0, …, p k`; consecutive vertices
are joined by edges of `G`. -/
def IsWalk (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  ∀ i : Fin k, (p i.castSucc, p i.succ) ∈ G.edges

/-- Total weight `w(P)` of a walk. -/
def walkWeight (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : ℤ :=
  ∑ i : Fin k, G.weight (p i.castSucc, p i.succ)

/-- Number of negative-weight edges (with multiplicity) on a walk. -/
def negEdgeCount (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : ℕ :=
  (Finset.univ.filter (fun i : Fin k => G.weight (p i.castSucc, p i.succ) < 0)).card

/-- A directed cycle `C` with `|C| = k ≥ 1` edges: a closed walk whose first `k` vertices are
distinct. -/
def IsDirectedCycle (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  1 ≤ k ∧ IsWalk G p ∧ p 0 = p (Fin.last k) ∧
    Function.Injective (fun i : Fin k => p i.castSucc)

/-- "An `N`-vertex instance is called restricted if all edge weights belong to
`{-1,0,1,…,N}`, every directed cycle `C` satisfies `w(C)/|C| ≥ 1`, and the source has a
zero-weight edge to every other vertex." (`w(C)/|C| ≥ 1` is written as `|C| ≤ w(C)`.) -/
def IsRestricted [Fintype V] (G : WDigraph V) (s : V) : Prop :=
  (∀ e ∈ G.edges, -1 ≤ G.weight e ∧ G.weight e ≤ (Fintype.card V : ℤ)) ∧
  (∀ (k : ℕ) (p : Fin (k + 1) → V), IsDirectedCycle G p → (k : ℤ) ≤ walkWeight G p) ∧
  (∀ v : V, v ≠ s → (s, v) ∈ G.edges ∧ G.weight (s, v) = 0)

/-- `p` is a minimum-weight walk from `s` to `v`: no `s`–`v` walk is lighter. -/
def IsMinWalk (G : WDigraph V) (s v : V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  IsWalk G p ∧ p 0 = s ∧ p (Fin.last k) = v ∧
    ∀ (k' : ℕ) (q : Fin (k' + 1) → V), IsWalk G q → q 0 = s → q (Fin.last k') = v →
      walkWeight G p ≤ walkWeight G q

/-- Every vertex has a finite distance: a minimum-weight source walk exists. [DeterministicNegativeWeightShortest, node_03] -/
theorem restricted_exists_minWalk [Fintype V] (G : WDigraph V) (s : V)
    (hG : IsRestricted G s) (v : V) :
    ∃ (k : ℕ) (p : Fin (k + 1) → V), IsMinWalk G s v p := by
  sorry

/-- Rubric 1: cycles have positive weight, so minimum-weight walks are simple paths. [DeterministicNegativeWeightShortest, node_03] -/
theorem restricted_minWalk_injective [Fintype V] (G : WDigraph V) (s v : V)
    (hG : IsRestricted G s) {k : ℕ} (p : Fin (k + 1) → V) (hp : IsMinWalk G s v p) :
    Function.Injective p := by
  sorry

/-- Rubric 1: every minimum-weight source walk has at most `N` negative edges, so `R(H, N)`
meets its promise. [DeterministicNegativeWeightShortest, node_03] -/
theorem restricted_minWalk_negEdges_le [Fintype V] (G : WDigraph V) (s v : V)
    (hG : IsRestricted G s) {k : ℕ} (p : Fin (k + 1) → V) (hp : IsMinWalk G s v p) :
    negEdgeCount G p ≤ Fintype.card V := by
  sorry

/-! ## The cost recurrence -/

/-- `ℓ = max{1, ⌈log₂ N⌉}` (`Nat.clog 2 N = ⌈log₂ N⌉`). -/
def ellOf (N : ℕ) : ℕ := max 1 (Nat.clog 2 N)

/-- The cost recurrence of `R(H,k)`: `T M k` is the worst-case cost on instances with at most
`M` edges and parameter `k`. For `k > L`:
`T(M,k) ≤ T((1+1/ℓ)M, ⌈k/2⌉) + c M ℓ⁷`; for `k ≤ L`: `T(M,k) ≤ c M ℓ⁷`.
(`(k + 1) / 2` is `⌈k/2⌉` in truncating ℕ division.) -/
def SatisfiesRecurrence (T : ℝ → ℕ → ℝ) (ℓ : ℕ) (c L : ℝ) : Prop :=
  (∀ (M : ℝ) (k : ℕ), 0 ≤ M → L < (k : ℝ) →
      T M k ≤ T ((1 + 1 / (ℓ : ℝ)) * M) ((k + 1) / 2) + c * M * (ℓ : ℝ) ^ 7) ∧
  (∀ (M : ℝ) (k : ℕ), 0 ≤ M → (k : ℝ) ≤ L → T M k ≤ c * M * (ℓ : ℝ) ^ 7)

/-- Iterated ceiling halving: if `k ≤ 2^j` then after `i ≤ j` halvings `k_i ≤ 2^(j-i)`; in
particular after `j` levels `k_j ≤ 1` (depth `O(log N)`). [DeterministicNegativeWeightShortest, node_03] -/
theorem iterate_halfCeil_le (j i k : ℕ) (hk : k ≤ 2 ^ j) (hi : i ≤ j) :
    (fun x : ℕ => (x + 1) / 2)^[i] k ≤ 2 ^ (j - i) := by
  sorry

/-- `(1 + 1/ℓ)^ℓ ≤ e`, so the edge blow-up over all levels is `O(1)`. [DeterministicNegativeWeightShortest, node_03] -/
theorem one_add_inv_pow_le_exp (ℓ : ℕ) (hℓ : 1 ≤ ℓ) :
    (1 + 1 / (ℓ : ℝ)) ^ ℓ ≤ Real.exp 1 := by
  sorry

/-- `N ≤ 2^ℓ` for `ℓ = max{1, ⌈log₂ N⌉}`. [DeterministicNegativeWeightShortest, node_03] -/
theorem le_two_pow_ellOf (N : ℕ) : N ≤ 2 ^ ellOf N := by
  sorry

/-- Rubrics 2–3: the recurrence solves to `T(M,k) ≤ e·c·(ℓ+1)·ℓ⁷·M` for all `k ≤ 2^ℓ`,
i.e. restricted SSSP costs `O(M ℓ⁸)`. [DeterministicNegativeWeightShortest, node_03] -/
theorem restricted_recurrence_solution (T : ℝ → ℕ → ℝ) (ℓ : ℕ) (c L : ℝ)
    (hℓ : 1 ≤ ℓ) (hc : 0 ≤ c) (hL : 1 ≤ L) (hT : SatisfiesRecurrence T ℓ c L)
    (M : ℝ) (hM : 0 ≤ M) (k : ℕ) (hk : k ≤ 2 ^ ℓ) :
    T M k ≤ Real.exp 1 * c * ((ℓ : ℝ) + 1) * (ℓ : ℝ) ^ 7 * M := by
  sorry

/-! ## Main theorem: composition with the scaling procedure -/

/-- Rubric 4 (main theorem). Let `Tr N` be the cost function of the restricted routine on
`N`-vertex instances, satisfying the recurrence with `ℓ = ellOf N` (threshold `L N ≥ 1`).
The scaling procedure has `q ≤ c₂ log(nW)` stages; stage `j` calls `R(H_j, N_j)` on a
restricted instance with `1 ≤ N_j ≤ b n` vertices and `M_j ≤ a m` edges, and the extra work
is `c₁ m q`. Then the total cost is `O(m log⁸ n log(nW))` with a constant `K` depending only
on `c, a, b, c₁, c₂`. [DeterministicNegativeWeightShortest, node_03] -/
theorem general_sssp_time_bound (c a b c₁ c₂ : ℝ) (hc : 0 ≤ c) (ha : 0 ≤ a) (hb : 1 ≤ b)
    (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) :
    ∃ K : ℝ, ∀ (Tr : ℕ → ℝ → ℕ → ℝ) (L : ℕ → ℝ),
      (∀ N, 1 ≤ L N) → (∀ N, SatisfiesRecurrence (Tr N) (ellOf N) c (L N)) →
      ∀ (n m W : ℕ), 2 ≤ n → 1 ≤ m → 1 ≤ W →
      ∀ (q : ℕ) (Ns : Fin q → ℕ) (Ms : Fin q → ℝ),
        (q : ℝ) ≤ c₂ * Real.log ((n : ℝ) * W) →
        (∀ j, 1 ≤ Ns j ∧ (Ns j : ℝ) ≤ b * n) →
        (∀ j, 0 ≤ Ms j ∧ Ms j ≤ a * m) →
        ∑ j, Tr (Ns j) (Ms j) (Ns j) + c₁ * m * q ≤
          K * m * Real.log n ^ 8 * Real.log ((n : ℝ) * W) := by
  sorry

end TCSChallenge.DeterministicNegativeWeightShortestPaths.node_03
