/-!
## Lindahl equilibria are `e^{-1/e}`-approximate for budget-weighted Nash welfare

Agents `N` (finite), `m` divisible public goods, budgets `B_i > 0`, concave utilities
`u_i ≥ 0` with `u_i(0) = 0`. For `G(z) = (∏ u_i(z)^{B_i})^{1/B}` with `B = ∑ B_i`: if
`(x, (p_i))` is a Lindahl equilibrium (each `x` maximizes `u_i` on `⟨p_i,z⟩ ≤ B_i`,
`∑ p_i ≤ 1`, `⟨1 - ∑ p_i, x⟩ = 0`), and `y` maximizes `G` on `∑_j z_j ≤ B`, then
`G(x) ≥ e^{-1/e} G(y)`.

Main theorem: `lindahl_nsw_approx`.
-/

namespace TCSChallenge.FisherMeetsLindahlA.node_16

/-- Total budget `B = ∑_i B_i`. -/
def totalBudget {N : Type} [Fintype N] (B : N → ℝ) : ℝ := ∑ i, B i

/-- Budget-weighted geometric mean `G(z) = (∏_i u_i(z)^{B_i})^{1/B}`. -/
def nashWelfare {N : Type} [Fintype N] {m : ℕ} (u : N → (Fin m → ℝ) → ℝ) (B : N → ℝ)
    (z : Fin m → ℝ) : ℝ :=
  (∏ i, u i z ^ B i) ^ (1 / totalBudget B)

/-- Model hypotheses: `B_i > 0`, each `u_i` concave on `ℝ^m_{≥0}`, nonnegative there,
and `u_i(0) = 0`. -/
structure IsPublicGoodsMarket {N : Type} [Fintype N] (m : ℕ)
    (u : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) : Prop where
  budget_pos : ∀ i, 0 < B i
  concave : ∀ i, ConcaveOn ℝ (Set.Ici (0 : Fin m → ℝ)) (u i)
  nonneg : ∀ i, ∀ z : Fin m → ℝ, 0 ≤ z → 0 ≤ u i z
  zero : ∀ i, u i 0 = 0

/-- Lindahl equilibrium: `x ≥ 0`, `p_i ≥ 0`,
`x ∈ argmax {u_i(z) : z ≥ 0, ⟨p_i,z⟩ ≤ B_i}` for every `i`,
`∑_i p_i ≤ 1` coordinatewise and `⟨1 - ∑_i p_i, x⟩ = 0`. -/
structure IsLindahlEquilibrium {N : Type} [Fintype N] {m : ℕ}
    (u : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (x : Fin m → ℝ) (p : N → Fin m → ℝ) : Prop where
  x_nonneg : 0 ≤ x
  p_nonneg : ∀ i, 0 ≤ p i
  affordable : ∀ i, dotProduct (p i) x ≤ B i
  optimal : ∀ i, ∀ z : Fin m → ℝ, 0 ≤ z → dotProduct (p i) z ≤ B i → u i z ≤ u i x
  price_le_one : ∀ j, ∑ i, p i j ≤ 1
  complementary : dotProduct (fun j => 1 - ∑ i, p i j) x = 0

/-- `y ∈ argmax {G(z) : z ≥ 0, ∑_j z_j ≤ B}`. -/
def IsNSWMaximizer {N : Type} [Fintype N] {m : ℕ}
    (u : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (y : Fin m → ℝ) : Prop :=
  0 ≤ y ∧ ∑ j, y j ≤ totalBudget B ∧
    ∀ z : Fin m → ℝ, 0 ≤ z → ∑ j, z j ≤ totalBudget B →
      nashWelfare u B z ≤ nashWelfare u B y

/-- Rubric 1: affordable comparison. With `C_i = ⟨p_i, y⟩`, if `C_i ≤ B_i` then
`u_i(x) ≥ u_i(y)`, and if `C_i > B_i` then `u_i(x) ≥ (B_i / C_i) u_i(y)`. [FisherMeetsLindahlA, node_16] -/
theorem affordable_comparison {N : Type} [Fintype N] {m : ℕ}
    (u : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (hM : IsPublicGoodsMarket m u B)
    (x : Fin m → ℝ) (p : N → Fin m → ℝ) (hE : IsLindahlEquilibrium u B x p)
    (y : Fin m → ℝ) (hy : 0 ≤ y) (i : N) :
    (dotProduct (p i) y ≤ B i → u i y ≤ u i x) ∧
    (B i < dotProduct (p i) y → B i / dotProduct (p i) y * u i y ≤ u i x) := by sorry

/-- Rubric 3: aggregate expenditure `∑_i ⟨p_i, y⟩ ≤ B` from `∑_i p_{ij} ≤ 1`, `y ≥ 0`,
`∑_j y_j ≤ B`. [FisherMeetsLindahlA, node_16] -/
theorem aggregate_expenditure_le {N : Type} [Fintype N] {m : ℕ}
    (B : N → ℝ) (p : N → Fin m → ℝ) (hp : ∀ j, ∑ i, p i j ≤ 1)
    (y : Fin m → ℝ) (hy : 0 ≤ y) (hyB : ∑ j, y j ≤ totalBudget B) :
    ∑ i, dotProduct (p i) y ≤ totalBudget B := by sorry

/-- Rubric 4 (scalar part): `z log(1/z) ≤ 1/e` on `(0,1]`. [FisherMeetsLindahlA, node_16] -/
theorem mul_log_inv_le_inv_exp (z : ℝ) (hz0 : 0 < z) (hz1 : z ≤ 1) :
    z * Real.log (1 / z) ≤ 1 / Real.exp 1 := by sorry

/-- Rubric 2: logarithmic aggregation. For `B_i > 0`, `C_i ≥ 0` with `∑ C_i ≤ ∑ B_i`,
`(1/B) ∑_i B_i log max{1, C_i/B_i} ≤ 1/e`. [FisherMeetsLindahlA, node_16] -/
theorem log_sum_bound {N : Type} [Fintype N] (B C : N → ℝ) (hB : ∀ i, 0 < B i)
    (hC : ∀ i, 0 ≤ C i) (hsum : ∑ i, C i ≤ totalBudget B) :
    (1 / totalBudget B) * ∑ i, B i * Real.log (max 1 (C i / B i)) ≤ 1 / Real.exp 1 := by
  sorry

/-- Main theorem: `G(x) ≥ e^{-1/e} G(y)`. [FisherMeetsLindahlA, node_16] -/
theorem lindahl_nsw_approx {N : Type} [Fintype N] [Nonempty N] {m : ℕ}
    (u : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (hM : IsPublicGoodsMarket m u B)
    (x : Fin m → ℝ) (p : N → Fin m → ℝ) (hE : IsLindahlEquilibrium u B x p)
    (y : Fin m → ℝ) (hy : IsNSWMaximizer u B y) :
    Real.exp (-(1 / Real.exp 1)) * nashWelfare u B y ≤ nashWelfare u B x := by sorry

end TCSChallenge.FisherMeetsLindahlA.node_16
