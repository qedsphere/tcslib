/-!
## First welfare theorem for Lindahl equilibria with public chores

Agents `N` (finite), chores `M = Fin m`, budgets `B_i > 0`, disutilities `d_i`.
A Lindahl equilibrium `(x, (p_i))` has `p_i · x = B_i`, `x` minimizing `d_i` over
`{z ≥ 0 | p_i · z = B_i}`, and `∑_i p_{ij} = 1` for every chore `j`.
The equilibrium allocation is weakly Pareto-optimal in
`𝒜 = {z ≥ 0 | ∑_j z_j = ∑_i B_i}` when all `d_i` are non-decreasing, and Pareto-optimal
when all `d_i` are increasing.

Main theorems: `lindahl_weakly_pareto`, `lindahl_pareto`.
-/

namespace TCSChallenge.FisherMeetsLindahlA.node_34

/-- `d` is non-decreasing on `ℝ^m_{≥0}`: `z ≤ w` implies `d z ≤ d w`. -/
def NonDecreasing {m : ℕ} (d : (Fin m → ℝ) → ℝ) : Prop :=
  ∀ z w : Fin m → ℝ, 0 ≤ z → z ≤ w → d z ≤ d w

/-- `d` is increasing on `ℝ^m_{≥0}`: `z ≤ w`, `z ≠ w` imply `d z < d w`. -/
def Increasing {m : ℕ} (d : (Fin m → ℝ) → ℝ) : Prop :=
  ∀ z w : Fin m → ℝ, 0 ≤ z → z ≤ w → z ≠ w → d z < d w

/-- Feasible allocations `𝒜 = {z ∈ ℝ^m_{≥0} : ∑_j z_j = ∑_i B_i}`. -/
def feasibleSet {N : Type} [Fintype N] (m : ℕ) (B : N → ℝ) : Set (Fin m → ℝ) :=
  {z | 0 ≤ z ∧ ∑ j, z j = ∑ i, B i}

/-- Lindahl equilibrium for public chores: `x ≥ 0`, `p_i ≥ 0`, `p_i · x = B_i`,
`d_i(x) ≤ d_i(z)` whenever `z ≥ 0` and `p_i · z = B_i`, and `∑_i p_{ij} = 1`. -/
structure IsLindahlEquilibrium {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (x : Fin m → ℝ) (p : N → Fin m → ℝ) : Prop where
  x_nonneg : 0 ≤ x
  p_nonneg : ∀ i, 0 ≤ p i
  earning : ∀ i, dotProduct (p i) x = B i
  optimal : ∀ i, ∀ z : Fin m → ℝ, 0 ≤ z → dotProduct (p i) z = B i → d i x ≤ d i z
  price_sum : ∀ j, ∑ i, p i j = 1

/-- Weak Pareto-optimality: `x ∈ 𝒜` and no `y ∈ 𝒜` has `d_i(y) < d_i(x)` for all `i`. -/
def WeaklyParetoOptimal {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (x : Fin m → ℝ) : Prop :=
  x ∈ feasibleSet m B ∧ ¬ ∃ y ∈ feasibleSet m B, ∀ i, d i y < d i x

/-- Pareto-optimality: `x ∈ 𝒜` and no `y ∈ 𝒜` has `d_i(y) ≤ d_i(x)` for all `i` with
strict inequality for some agent. -/
def ParetoOptimal {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (x : Fin m → ℝ) : Prop :=
  x ∈ feasibleSet m B ∧
    ¬ ∃ y ∈ feasibleSet m B, (∀ i, d i y ≤ d i x) ∧ ∃ k, d k y < d k x

/-- Rubric 1a: the equilibrium allocation is socially feasible. [FisherMeetsLindahlA, node_34] -/
theorem equilibrium_mem_feasible {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (x : Fin m → ℝ) (p : N → Fin m → ℝ)
    (hE : IsLindahlEquilibrium d B x p) : x ∈ feasibleSet m B := by sorry

/-- Rubric 1b: aggregate identity `∑_i p_i · y = ∑_j y_j` when `∑_i p_{ij} = 1`. [FisherMeetsLindahlA, node_34] -/
theorem sum_expenditure_eq {N : Type} [Fintype N] {m : ℕ} (p : N → Fin m → ℝ)
    (hp : ∀ j, ∑ i, p i j = 1) (y : Fin m → ℝ) :
    ∑ i, dotProduct (p i) y = ∑ j, y j := by sorry

/-- Rubric 2: under non-decreasing `d_i`, a strict improvement `d_i(y) < d_i(x)` with
`y ≥ 0` forces `p_i · y < B_i`. [FisherMeetsLindahlA, node_34] -/
theorem expenditure_lt_of_strict {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (hB : ∀ i, 0 < B i)
    (x : Fin m → ℝ) (p : N → Fin m → ℝ) (hE : IsLindahlEquilibrium d B x p)
    (i : N) (hd : NonDecreasing (d i)) (y : Fin m → ℝ) (hy : 0 ≤ y)
    (hlt : d i y < d i x) : dotProduct (p i) y < B i := by sorry

/-- Rubric 4: under increasing `d_i`, a weak improvement `d_i(y) ≤ d_i(x)` with `y ≥ 0`
forces `p_i · y ≤ B_i`. [FisherMeetsLindahlA, node_34] -/
theorem expenditure_le_of_weak {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (hB : ∀ i, 0 < B i)
    (x : Fin m → ℝ) (p : N → Fin m → ℝ) (hE : IsLindahlEquilibrium d B x p)
    (i : N) (hd : Increasing (d i)) (y : Fin m → ℝ) (hy : 0 ≤ y)
    (hle : d i y ≤ d i x) : dotProduct (p i) y ≤ B i := by sorry

/-- Rubric 5: with `p_k · y ≤ B_k`, a strict improver has `p_k · y < B_k`. [FisherMeetsLindahlA, node_34] -/
theorem expenditure_lt_of_strict_of_le {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (B : N → ℝ)
    (x : Fin m → ℝ) (p : N → Fin m → ℝ) (hE : IsLindahlEquilibrium d B x p)
    (k : N) (y : Fin m → ℝ) (hy : 0 ≤ y) (hle : dotProduct (p k) y ≤ B k)
    (hlt : d k y < d k x) : dotProduct (p k) y < B k := by sorry

/-- Main theorem (a): with non-decreasing disutilities, every Lindahl equilibrium
allocation is weakly Pareto-optimal. [FisherMeetsLindahlA, node_34] -/
theorem lindahl_weakly_pareto {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (hB : ∀ i, 0 < B i)
    (hd : ∀ i, NonDecreasing (d i))
    (x : Fin m → ℝ) (p : N → Fin m → ℝ) (hE : IsLindahlEquilibrium d B x p) :
    WeaklyParetoOptimal d B x := by sorry

/-- Main theorem (b): with increasing disutilities, every Lindahl equilibrium allocation
is Pareto-optimal. [FisherMeetsLindahlA, node_34] -/
theorem lindahl_pareto {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (B : N → ℝ) (hB : ∀ i, 0 < B i)
    (hd : ∀ i, Increasing (d i))
    (x : Fin m → ℝ) (p : N → Fin m → ℝ) (hE : IsLindahlEquilibrium d B x p) :
    ParetoOptimal d B x := by sorry

end TCSChallenge.FisherMeetsLindahlA.node_34
