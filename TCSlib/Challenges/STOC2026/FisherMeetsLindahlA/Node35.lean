/-!
## Fisher–Lindahl duality for chores (node_35)

Agents `N` (a finite type), chores `Fin m`, earning requirements `B i > 0`,
disutilities `d i : (Fin m → ℝ) → ℝ` convex, non-decreasing and not
identically zero on the nonnegative orthant.

* Lindahl equilibrium of the public-chores market: a shared bundle `x` and
  personalized prices `p i` such that `x` minimizes `d i` on
  `{x' ≥ 0 | ⟨p i, x'⟩ = B i}` for every `i`, and `∑ i, p i j = 1`.
* Indirect disutility `h i q = inf {d i z | z ≥ 0, ⟨q, z⟩ = B i}` and
  `d̃ i q = 1 / h i q` with `1/0 = +∞` (valued in `ℝ≥0∞`).
* Fisher equilibrium of the dual private-chores market: allocations `x̃ i` and
  a common price `p̃` such that `x̃ i` minimizes `d̃ i` on
  `{y ≥ 0 | ⟨p̃, y⟩ = B i}`, and `∑ i, x̃ i j = 1`.

Main theorem `lindahl_iff_fisher`: `(x, p)` is a Lindahl equilibrium iff
`(x̃, p̃) := (p, x)` is a Fisher equilibrium.
-/

namespace TCSChallenge.FisherMeetsLindahlA.node_35

/-- `⟨a, b⟩ = ∑_{j ∈ M} a_j b_j`. -/
def ip {m : ℕ} (a b : Fin m → ℝ) : ℝ := ∑ j, a j * b j

/-- "`d_i : ℝ^m_{≥0} → ℝ_{≥0}` is convex, coordinatewise non-decreasing, and
not identically zero." -/
def IsChoreDisutility {m : ℕ} (d : (Fin m → ℝ) → ℝ) : Prop :=
  ConvexOn ℝ {x : Fin m → ℝ | 0 ≤ x} d ∧
  (∀ x : Fin m → ℝ, 0 ≤ x → 0 ≤ d x) ∧
  (∀ x y : Fin m → ℝ, 0 ≤ x → x ≤ y → d x ≤ d y) ∧
  (∃ x : Fin m → ℝ, 0 ≤ x ∧ d x ≠ 0)

/-- Indirect disutility `h_i(q, B) = min_{z ≥ 0 : ⟨q, z⟩ = B} d_i(z)`, written as
an infimum over the feasible set. -/
def indirect {m : ℕ} (d : (Fin m → ℝ) → ℝ) (q : Fin m → ℝ) (B : ℝ) : ℝ :=
  sInf (d '' {z : Fin m → ℝ | 0 ≤ z ∧ ip q z = B})

/-- `d̃_i(q) = 1 / h_i(q, B_i)`, with the extended-value convention `1/0 = +∞`. -/
def dualDisutility {m : ℕ} (d : (Fin m → ℝ) → ℝ) (q : Fin m → ℝ) (B : ℝ) : ENNReal :=
  (ENNReal.ofReal (indirect d q B))⁻¹

/-- Agent optimality in the public-chores market:
`x ∈ argmin_{x' ≥ 0 : ⟨p_i, x'⟩ = B_i} d_i(x')`. -/
def LindahlOpt {m : ℕ} (d : (Fin m → ℝ) → ℝ) (B : ℝ) (p x : Fin m → ℝ) : Prop :=
  0 ≤ x ∧ ip p x = B ∧
    ∀ x' : Fin m → ℝ, 0 ≤ x' → ip p x' = B → d x ≤ d x'

/-- Agent optimality in the private-chores market:
`y ∈ argmin_{y' ≥ 0 : ⟨p̃, y'⟩ = B_i} d̃_i(y')`. -/
def FisherOpt {m : ℕ} (d : (Fin m → ℝ) → ℝ) (B : ℝ) (pt y : Fin m → ℝ) : Prop :=
  0 ≤ y ∧ ip pt y = B ∧
    ∀ y' : Fin m → ℝ, 0 ≤ y' → ip pt y' = B →
      dualDisutility d y B ≤ dualDisutility d y' B

/-- Lindahl equilibrium `(x, {p_i})` of the public-chores market `𝓛`. -/
def IsLindahlEq {N : Type} [Fintype N] {m : ℕ} (d : N → (Fin m → ℝ) → ℝ)
    (B : N → ℝ) (x : Fin m → ℝ) (p : N → Fin m → ℝ) : Prop :=
  0 ≤ x ∧ (∀ i, 0 ≤ p i) ∧ (∀ i, LindahlOpt (d i) (B i) (p i) x) ∧
    ∀ j : Fin m, ∑ i, p i j = 1

/-- Fisher equilibrium `({x̃_i}, p̃)` of the dual private-chores market `𝓕`. -/
def IsFisherEq {N : Type} [Fintype N] {m : ℕ} (d : N → (Fin m → ℝ) → ℝ)
    (B : N → ℝ) (xt : N → Fin m → ℝ) (pt : Fin m → ℝ) : Prop :=
  0 ≤ pt ∧ (∀ i, 0 ≤ xt i) ∧ (∀ i, FisherOpt (d i) (B i) pt (xt i)) ∧
    ∀ j : Fin m, ∑ i, xt i j = 1

/-- Weak duality: any bundle feasible for `h(q, B)` bounds it from above. [FisherMeetsLindahlA, node_35] -/
theorem indirect_le_of_feasible {m : ℕ} (d : (Fin m → ℝ) → ℝ)
    (hd : IsChoreDisutility d) (B : ℝ) (q z : Fin m → ℝ)
    (hz : 0 ≤ z) (hqz : ip q z = B) :
    indirect d q B ≤ d z := by
  sorry

/-- Recovery identity (with attainment): for a nonzero bundle `x ≥ 0` and
`B > 0`, `d(x) = max_{q ≥ 0 : ⟨x, q⟩ = B} h(q, B)`. [FisherMeetsLindahlA, node_35] -/
theorem recovery {m : ℕ} (d : (Fin m → ℝ) → ℝ) (hd : IsChoreDisutility d)
    (B : ℝ) (hB : 0 < B) (x : Fin m → ℝ) (hx : 0 ≤ x) (hx0 : x ≠ 0) :
    (∀ q : Fin m → ℝ, 0 ≤ q → ip x q = B → indirect d q B ≤ d x) ∧
    ∃ q : Fin m → ℝ, 0 ≤ q ∧ ip x q = B ∧ indirect d q B = d x := by
  sorry

/-- Common certificate: when `⟨p, x⟩ = B`, public optimality of `x` under `p`
is equivalent to `h(p, B) = d(x)`. [FisherMeetsLindahlA, node_35] -/
theorem lindahlOpt_iff_certificate {m : ℕ} (d : (Fin m → ℝ) → ℝ)
    (hd : IsChoreDisutility d) (B : ℝ) (hB : 0 < B) (p x : Fin m → ℝ)
    (hp : 0 ≤ p) (hx : 0 ≤ x) (hpx : ip p x = B) :
    LindahlOpt d B p x ↔ indirect d p B = d x := by
  sorry

/-- Local optimizer correspondence for a fixed agent: `x` minimizes `d` on the
earning hyperplane of `p` iff `p` minimizes `d̃` on the earning hyperplane of
`x` (reciprocal order reversal: minimizers of `1/h` are maximizers of `h`). [FisherMeetsLindahlA, node_35] -/
theorem lindahlOpt_iff_fisherOpt {m : ℕ} (d : (Fin m → ℝ) → ℝ)
    (hd : IsChoreDisutility d) (B : ℝ) (hB : 0 < B) (p x : Fin m → ℝ)
    (hp : 0 ≤ p) (hx : 0 ≤ x) :
    LindahlOpt d B p x ↔ FisherOpt d B x p := by
  sorry

/-- **Fisher–Lindahl duality for chores.** `(x, {p_i})` is a Lindahl
equilibrium of `𝓛` iff `({x̃_i}, p̃) = ({p_i}, x)` is a Fisher equilibrium of
the dual private-chores market `𝓕`. [FisherMeetsLindahlA, node_35] -/
theorem lindahl_iff_fisher {N : Type} [Fintype N] {m : ℕ}
    (d : N → (Fin m → ℝ) → ℝ) (hd : ∀ i, IsChoreDisutility (d i))
    (B : N → ℝ) (hB : ∀ i, 0 < B i)
    (x : Fin m → ℝ) (p : N → Fin m → ℝ) :
    IsLindahlEq d B x p ↔ IsFisherEq d B p x := by
  sorry

end TCSChallenge.FisherMeetsLindahlA.node_35
