/-!
## Recovering a quasi-concave utility from its indirect utility

Let `X = ℝ^m_{≥0}`, and let `u : X → ℝ_{≥0}` be continuous, non-decreasing, locally
non-satiated and quasi-concave. With `v(p,B) = sup {u y | y ∈ X, ⟨p,y⟩ ≤ B}`, for every
`B > 0` and every `x ∈ X \ {0}`,
`u(x) = inf {v(p,B) | p ∈ X, ⟨p,x⟩ ≤ B}`.

Main theorem: `utility_eq_inf_indirect`.
-/

namespace TCSChallenge.FisherMeetsLindahlA.node_07

/-- The nonnegative orthant `X = ℝ^m_{≥0}`, ordered coordinatewise. -/
def orthant (m : ℕ) : Set (Fin m → ℝ) := {y | 0 ≤ y}

/-- Hypotheses on `u`: nonnegative, continuous on `X`, non-decreasing
("if `y ≤ z` then `u y ≤ u z`"), locally non-satiated ("every neighborhood of every
`x ∈ X`, in the subspace topology on `X`, contains some `y` with `u y > u x`"), and
quasi-concave ("`u(θ y + (1-θ) z) ≥ min {u y, u z}`"). -/
structure IsRegularUtility (m : ℕ) (u : (Fin m → ℝ) → ℝ) : Prop where
  nonneg : ∀ y ∈ orthant m, 0 ≤ u y
  cont : ContinuousOn u (orthant m)
  mono : ∀ y z, y ∈ orthant m → y ≤ z → u y ≤ u z
  nonsat : ∀ x ∈ orthant m, ∀ U ∈ nhdsWithin x (orthant m),
    ∃ y ∈ U, y ∈ orthant m ∧ u x < u y
  quasiconcave : ∀ y ∈ orthant m, ∀ z ∈ orthant m, ∀ θ : ℝ, 0 ≤ θ → θ ≤ 1 →
    min (u y) (u z) ≤ u (θ • y + (1 - θ) • z)

/-- Indirect utility `v(p,B) = sup {u(y) : y ∈ X, ⟨p,y⟩ ≤ B}`, valued in `[0,+∞]`
(here `EReal`). -/
def indirectUtility {m : ℕ} (u : (Fin m → ℝ) → ℝ) (p : Fin m → ℝ) (B : ℝ) : EReal :=
  sSup ((fun y => ((u y : ℝ) : EReal)) '' {y | y ∈ orthant m ∧ dotProduct p y ≤ B})

/-- The infimum `inf {v(p,B) : p ∈ X, ⟨p,x⟩ ≤ B}`. -/
def infIndirect {m : ℕ} (u : (Fin m → ℝ) → ℝ) (x : Fin m → ℝ) (B : ℝ) : EReal :=
  sInf ((fun p => indirectUtility u p B) '' {p | p ∈ orthant m ∧ dotProduct p x ≤ B})

/-- Rubric 1: every admissible price makes `x` affordable, so `v(p,B) ≥ u(x)`. [FisherMeetsLindahlA, node_07] -/
theorem le_indirectUtility {m : ℕ} (u : (Fin m → ℝ) → ℝ) (B : ℝ)
    (x p : Fin m → ℝ) (hx : x ∈ orthant m) (hpx : dotProduct p x ≤ B) :
    ((u x : ℝ) : EReal) ≤ indirectUtility u p B := by sorry

/-- Rubric 2: a nearby higher level `α` with `u x < α < u x + η` whose (closed) upper
contour set `{y ∈ X | α ≤ u y}` is nonempty, closed, convex and excludes `x`. [FisherMeetsLindahlA, node_07] -/
theorem exists_higher_level {m : ℕ} (u : (Fin m → ℝ) → ℝ) (hu : IsRegularUtility m u)
    (x : Fin m → ℝ) (hx : x ∈ orthant m) (η : ℝ) (hη : 0 < η) :
    ∃ α : ℝ, u x < α ∧ α < u x + η ∧
      {y | y ∈ orthant m ∧ α ≤ u y}.Nonempty ∧
      IsClosed {y | y ∈ orthant m ∧ α ≤ u y} ∧
      Convex ℝ {y | y ∈ orthant m ∧ α ≤ u y} ∧
      x ∉ {y | y ∈ orthant m ∧ α ≤ u y} := by sorry

/-- Rubric 3: a strictly separating normal of `x` from an upper contour set
`{y ∈ X | α ≤ u y}` (with `u x < α`, set nonempty) can be chosen coordinatewise
nonnegative. [FisherMeetsLindahlA, node_07] -/
theorem exists_nonneg_separator {m : ℕ} (u : (Fin m → ℝ) → ℝ) (hu : IsRegularUtility m u)
    (x : Fin m → ℝ) (hx : x ∈ orthant m) (α : ℝ) (hα : u x < α)
    (hne : {y | y ∈ orthant m ∧ α ≤ u y}.Nonempty) :
    ∃ (p : Fin m → ℝ) (γ : ℝ), p ∈ orthant m ∧ dotProduct p x < γ ∧
      ∀ y, y ∈ orthant m → α ≤ u y → γ ≤ dotProduct p y := by sorry

/-- Rubric 4: rescaling the separator gives an admissible price `q` with `v(q,B) ≤ α`. [FisherMeetsLindahlA, node_07] -/
theorem exists_price_indirect_le {m : ℕ} (u : (Fin m → ℝ) → ℝ) (hu : IsRegularUtility m u)
    (B : ℝ) (hB : 0 < B) (x : Fin m → ℝ) (hx : x ∈ orthant m) (α : ℝ) (hα : u x < α)
    (hne : {y | y ∈ orthant m ∧ α ≤ u y}.Nonempty) :
    ∃ q : Fin m → ℝ, q ∈ orthant m ∧ dotProduct q x ≤ B ∧
      indirectUtility u q B ≤ ((α : ℝ) : EReal) := by sorry

/-- Main theorem: for every `B > 0` and every `x ∈ X \ {0}`,
`u(x) = inf_{p ∈ X, ⟨p,x⟩ ≤ B} v(p,B)`. [FisherMeetsLindahlA, node_07] -/
theorem utility_eq_inf_indirect (m : ℕ) (hm : 1 ≤ m) (u : (Fin m → ℝ) → ℝ)
    (hu : IsRegularUtility m u) (B : ℝ) (hB : 0 < B) (x : Fin m → ℝ)
    (hx : x ∈ orthant m) (hx0 : x ≠ 0) :
    ((u x : ℝ) : EReal) = infIndirect u x B := by sorry

end TCSChallenge.FisherMeetsLindahlA.node_07
