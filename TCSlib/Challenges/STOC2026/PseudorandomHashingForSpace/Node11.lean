/-!
## A recursive pairwise-hashing PRG fools small finite-state machines

Blocks are `Σ = {0,1}^n` (`Blk n = Fin n → Bool`), hash descriptions are `{0,1}^d`
(`Desc d`), and `H z : Σ → Σ` is a pairwise independent family. The recursive generator is
`G_0(x) = x`, `G_r(x) = G_{r-1}(h_{r-1}^{(0)}(x)) ∘ ⋯ ∘ G_{r-1}(h_{r-1}^{(b-1)}(x))`
(`gen`). The seed is a root `x` and `b k` descriptions; `F_{n,b,k}` maps it to `G_k(x)`.

A deterministic finite-state machine `(S, τ)` started in `q` reads the blocks left to right.
Main theorem `main_tv_bound`: there are absolute `c, C > 0` such that whenever
`b^k ≤ 2^{cn}` and `|S| ≤ 2^{cn}`, the statistical distance `statDist` between the terminal-state
law under `F(U_m)` and under `U_n^{⊗ b^k}` is at most `C · 2^{-cn}`.
-/

namespace TCSChallenge.PseudorandomHashingForSpace.node_11

/-- A block `x ∈ Σ = {0,1}^n`. -/
abbrev Blk (n : ℕ) := Fin n → Bool

/-- A hash description `z ∈ {0,1}^{d}`. -/
abbrev Desc (d : ℕ) := Fin d → Bool

/-- "for every distinct x,y∈Σ and every u,v∈Σ,
`|{z∈{0,1}^{d(n)} : h_z(x)=u and h_z(y)=v}| = 2^{d(n)−2n}`" (multiplied out by `2^{2n}`). -/
def IsPairwiseIndep {n d : ℕ} (H : Desc d → Blk n → Blk n) : Prop :=
  ∀ x y : Blk n, x ≠ y → ∀ u v : Blk n,
    (Finset.univ.filter (fun z : Desc d => H z x = u ∧ H z y = v)).card * 2 ^ (2 * n) = 2 ^ d

/-- The recursive generator `G_r(x; h_0,…,h_{r-1})`, with `hs ℓ a` the description of
`h_ℓ^{(a)}`: `G_0(x) = x` and `G_{r+1}(x) = ◦_{a<b} G_r(h_r^{(a)}(x))`, concatenated in
increasing order of `a`. -/
def gen {n d : ℕ} (H : Desc d → Blk n → Blk n) (b : ℕ) (hs : ℕ → ℕ → Desc d) :
    ℕ → Blk n → List (Blk n)
  | 0, x => [x]
  | r + 1, x => (List.ofFn (fun a : Fin b => gen H b hs r (H (hs r a) x))).flatten

/-- The descriptions `z_ℓ^{(a)}` (`ℓ < k`, `a < b`) of a seed, extended by a dummy value
outside the index range so that `gen` can be applied. -/
def extendDescs {d : ℕ} (k b : ℕ) (z : Fin k → Fin b → Desc d) : ℕ → ℕ → Desc d :=
  fun l a => if h : l < k ∧ a < b then z ⟨l, h.1⟩ ⟨a, h.2⟩ else fun _ => false

/-- "A seed consists of x∈Σ and descriptions z_ℓ^(a)∈{0,1}^{d(n)} for 0≤ℓ<k and 0≤a<b." -/
abbrev Seed (n d b k : ℕ) := Blk n × (Fin k → Fin b → Desc d)

/-- `F_{n,b,k}`: the seed `(x, z)` is mapped to `G_k(x; h_0,…,h_{k-1})`. -/
def prg {n d : ℕ} (H : Desc d → Blk n → Blk n) (b k : ℕ) (σ : Seed n d b k) : List (Blk n) :=
  gen H b (extendDescs k b σ.2) k σ.1

/-- Terminal state of the machine `τ : S × Σ → S` started in `q` on the input `w`. -/
def run {n : ℕ} {S : Type} (τ : S → Blk n → S) (q : S) (w : List (Blk n)) : S :=
  w.foldl τ q

/-- `Law_q(F_{n,b,k}(U_m))`: law of the terminal state on a uniform seed (pushforward of the
uniform seed distribution under `σ ↦ run τ q (F(σ))`). -/
def lawGen {n d : ℕ} (H : Desc d → Blk n → Blk n) (b k : ℕ) {S : Type} [Fintype S]
    (τ : S → Blk n → S) (q : S) : FinDist S :=
  FinDist.map (fun σ : Seed n d b k => run τ q (prg H b k σ)) (FinDist.uniform (Seed n d b k))

/-- `Law_q(U_n^{⊗ b^k})`: law of the terminal state on `b^k` independent uniform blocks
(pushforward of the uniform distribution on `Σ^L`). -/
def lawUnif {n : ℕ} (L : ℕ) {S : Type} [Fintype S] (τ : S → Blk n → S) (q : S) : FinDist S :=
  FinDist.map (fun w : Fin L → Blk n => run τ q (List.ofFn w)) (FinDist.uniform (Fin L → Blk n))

/-- Block `j` read off by base-`b` digits: at level `r+1` the digit `j / b^r` selects the
hash `h_r^{(j / b^r)}` and the remainder `j % b^r` is processed at level `r`. -/
def blockAt {n d : ℕ} (H : Desc d → Blk n → Blk n) (b : ℕ) (hs : ℕ → ℕ → Desc d) :
    ℕ → ℕ → Blk n → Blk n
  | 0, _, x => x
  | r + 1, j, x => blockAt H b hs r (j % b ^ r) (H (hs r (j / b ^ r)) x)

/-- For a vector `h = (h^{(0)},…,h^{(b-1)})` of descriptions and `A ⊆ Σ^b`,
`Z_A(h) = Pr_{x∼U_n}[h(x) ∈ A]`. -/
def hitFrac {n d b : ℕ} (H : Desc d → Blk n → Blk n) (A : Finset (Fin b → Blk n))
    (hv : Fin b → Desc d) : ℝ :=
  ((Finset.univ.filter (fun x : Blk n => (fun a => H (hv a) x) ∈ A)).card : ℝ) / 2 ^ n

/-- `ρ(A) = |A| / N^b` with `N = 2^n`. -/
def density {n b : ℕ} (A : Finset (Fin b → Blk n)) : ℝ :=
  (A.card : ℝ) / 2 ^ (n * b)

/-- Rubric 1 (inequality (1)): Chebyshev bound from pairwise independence,
`Pr_h[|Z_A − ρ(A)| > α] ≤ ρ(A)/(Nα²)`. [PseudorandomHashingForSpace, node_11] -/
theorem concentration {n d b : ℕ} (H : Desc d → Blk n → Blk n) (hH : IsPairwiseIndep H)
    (A : Finset (Fin b → Blk n)) (α : ℝ) (hα : 0 < α) :
    ((Finset.univ.filter
        (fun hv : Fin b → Desc d => α < |hitFrac H A hv - density A|)).card : ℝ) /
      (Fintype.card (Fin b → Desc d) : ℝ) ≤ density A / (2 ^ n * α ^ 2) := by
  sorry

/-- Matrix-power estimate in the max-row-sum norm: if `‖M‖, ‖N‖ ≤ 1` and `‖M − N‖ ≤ η`
then `‖M^b − N^b‖ ≤ b η`. [PseudorandomHashingForSpace, node_11] -/
theorem rowNorm_pow_sub_le {S : Type} [Fintype S] [DecidableEq S] (M N : Matrix S S ℝ)
    (hM : ∀ i, ∑ j, |M i j| ≤ 1) (hN : ∀ i, ∑ j, |N i j| ≤ 1) (η : ℝ)
    (hMN : ∀ i, ∑ j, |(M - N) i j| ≤ η) (b : ℕ) :
    ∀ i, ∑ j, |(M ^ b - N ^ b) i j| ≤ b * η := by
  sorry

/-- The generator at depth `r` outputs `b^r` blocks. [PseudorandomHashingForSpace, node_11] -/
theorem gen_length {n d : ℕ} (H : Desc d → Blk n → Blk n) (b : ℕ) (hs : ℕ → ℕ → Desc d)
    (r : ℕ) (x : Blk n) : (gen H b hs r x).length = b ^ r := by
  sorry

/-- Rubric 5 (local evaluation, combinatorial core): block `j` equals
`h_0^{(j_0)}(h_1^{(j_1)}(⋯ h_{k-1}^{(j_{k-1})}(x)⋯))`. [PseudorandomHashingForSpace, node_11] -/
theorem gen_getElem?_eq_blockAt {n d : ℕ} (H : Desc d → Blk n → Blk n) (b : ℕ)
    (hs : ℕ → ℕ → Desc d) (r : ℕ) (x : Blk n) (j : ℕ) (hj : j < b ^ r) :
    (gen H b hs r x)[j]? = some (blockAt H b hs r j x) := by
  sorry

/-- Rubric 5 (seed length): `m = n + b k d`. [PseudorandomHashingForSpace, node_11] -/
theorem seed_card (n d b k : ℕ) : Fintype.card (Seed n d b k) = 2 ^ (n + b * k * d) := by
  sorry

/-- Seed length `O(bkn)` when `d ≤ D n`. [PseudorandomHashingForSpace, node_11] -/
theorem seed_length_le (n d b k D : ℕ) (hd : d ≤ D * n) (hn : 1 ≤ n) (hb : 2 ≤ b)
    (hk : 1 ≤ k) : n + b * k * d ≤ (D + 1) * b * k * n := by
  sorry

/-- Main theorem: absolute `c, C > 0` such that for `b^k ≤ 2^{cn}`, every machine with
`|S| ≤ 2^{cn}` and every start state `q`,
`TV(Law_q(F_{n,b,k}(U_m)), Law_q(U_n^{⊗b^k})) ≤ C · 2^{−cn}`. [PseudorandomHashingForSpace, node_11] -/
theorem main_tv_bound :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧
      ∀ (n d b k : ℕ) (H : Desc d → Blk n → Blk n), IsPairwiseIndep H →
        2 ≤ b → 1 ≤ k → (b : ℝ) ^ k ≤ (2 : ℝ) ^ (c * n) →
        ∀ (S : Type) [Fintype S] (τ : S → Blk n → S),
          (Fintype.card S : ℝ) ≤ (2 : ℝ) ^ (c * n) →
          ∀ q : S, statDist (lawGen H b k τ q) (lawUnif (b ^ k) τ q) ≤ C * (2 : ℝ) ^ (-(c * n)) := by
  sorry

end TCSChallenge.PseudorandomHashingForSpace.node_11
