/-!
## One-way lower bound for augmented sparse set-disjointness

Alice holds `k`-element sets `X₁,…,Xₜ ⊆ [n]`; Bob holds `k`-element sets `Y₁,…,Yₜ`, an index
`i`, and the prefix `X₁,…,X_{i−1}`; after one message from Alice he outputs `Disj(Xᵢ,Yᵢ)`.
Main theorem `main_lower_bound`: there are universal `δ₀ ∈ (0,1/2)` and `c > 0` such that for
all `t, k, n` with `n ≥ k²`, every protocol of error `≤ δ₀` has cost `≥ c t k log₂ k`.
Indices are 0-based (`Fin t`, `Fin n`).
-/

namespace TCSChallenge.PseudorandomHashingForSpace.node_27

open TCSlib.InformationTheory

/-- A `t`-tuple of subsets of `[n]`. -/
abbrev SetsTuple (t n : ℕ) := Fin t → Finset (Fin n)

/-- Every set of the tuple has exactly `k` elements. -/
def ValidTuple {t n : ℕ} (k : ℕ) (X : SetsTuple t n) : Prop := ∀ j, (X j).card = k

/-- `Disj(A,B) = 1` iff `A ∩ B = ∅`. -/
def disj {n : ℕ} (A B : Finset (Fin n)) : Bool := decide (Disjoint A B)

/-- Bob's prefix information `X₁,…,X_{i−1}` (entries at positions `≥ i` are erased). -/
def prefixOf {t n : ℕ} (X : SetsTuple t n) (i : Fin t) : SetsTuple t n :=
  fun j => if j < i then X j else ∅

/-- A randomized one-way protocol with random tape `ω : Ω`. Alice's message depends only on
her tuple and the tape; Bob's output on the message, his tuple, `i`, the prefix and the tape. -/
structure OneWayProtocol (Ω : Type) [Fintype Ω] (t n : ℕ) where
  /-- distribution of the random tape -/
  μ : FinDist Ω
  /-- Alice's binary message -/
  msg : Ω → SetsTuple t n → List Bool
  /-- Bob's output: tape, message, `Y`, `i`, prefix of `X` -/
  out : Ω → List Bool → SetsTuple t n → Fin t → SetsTuple t n → Bool

/-- Probability that Bob's output is incorrect on input `(X; Y, i, X_{<i})`. -/
def errorAt {Ω : Type} [Fintype Ω] {t n : ℕ} (P : OneWayProtocol Ω t n)
    (X Y : SetsTuple t n) (i : Fin t) : ℝ :=
  ∑ ω, if P.out ω (P.msg ω X) Y i (prefixOf X i) ≠ disj (X i) (Y i) then P.μ ω else 0

/-- "Their error is the maximum, over all valid inputs, of the probability that Bob's output
is incorrect" is at most `δ`. -/
def HasErrorLE {Ω : Type} [Fintype Ω] {t n : ℕ} (P : OneWayProtocol Ω t n) (k : ℕ) (δ : ℝ) :
    Prop :=
  ∀ X Y : SetsTuple t n, ValidTuple k X → ValidTuple k Y → ∀ i, errorAt P X Y i ≤ δ

/-- "communication cost is the maximum message length over all valid inputs and all random
choices" is at most `L`. -/
def CostLE {Ω : Type} [Fintype Ω] {t n : ℕ} (P : OneWayProtocol Ω t n) (k L : ℕ) : Prop :=
  ∀ ω X, ValidTuple k X → (P.msg ω X).length ≤ L

/-- Rubric 1–2: universal `b, a > 0` and, for every `k ≥ 2`, families `𝒳, 𝒴` of `k`-subsets
of `[k²]` with `log₂|𝒳| ≥ b k log₂ k`, `|𝒴| ≤ a k log₂ k`, and `X ↦ (Disj(X,Y))_{Y∈𝒴}`
injective on `𝒳`. [PseudorandomHashingForSpace, node_27] -/
theorem separating_families :
    ∃ b a : ℝ, 0 < b ∧ 0 < a ∧ ∀ k : ℕ, 2 ≤ k →
      ∃ 𝒳 𝒴 : Finset (Finset (Fin (k ^ 2))),
        (∀ X ∈ 𝒳, X.card = k) ∧ (∀ Y ∈ 𝒴, Y.card = k) ∧
        b * k * Real.logb 2 k ≤ Real.logb 2 𝒳.card ∧
        (𝒴.card : ℝ) ≤ a * k * Real.logb 2 k ∧
        ∀ X ∈ 𝒳, ∀ X' ∈ 𝒳, (∀ Y ∈ 𝒴, disj X Y = disj X' Y) → X = X' := by
  sorry

/-- A protocol of error `< 1/2` must send at least one bit when `k ≥ 2` (and `n ≥ k²`). [PseudorandomHashingForSpace, node_27] -/
theorem cost_pos {Ω : Type} [Fintype Ω] (t k n : ℕ) (ht : 1 ≤ t) (hk : 2 ≤ k)
    (hn : k ^ 2 ≤ n) (P : OneWayProtocol Ω t n) (δ : ℝ) (hδ : δ < 1 / 2)
    (herr : HasErrorLE P k δ) : ¬ CostLE P k 0 := by
  sorry

/-- Main theorem: universal `δ₀ ∈ (0,1/2)` and `c > 0` with communication cost
`≥ c t k log₂ k` for every protocol of error at most `δ₀`, whenever `n ≥ k²`. [PseudorandomHashingForSpace, node_27] -/
theorem main_lower_bound :
    ∃ δ₀ c : ℝ, 0 < δ₀ ∧ δ₀ < 1 / 2 ∧ 0 < c ∧
      ∀ (t k n : ℕ), 1 ≤ t → 1 ≤ k → k ^ 2 ≤ n →
        ∀ (Ω : Type) [Fintype Ω] (P : OneWayProtocol Ω t n),
          HasErrorLE P k δ₀ → ∀ L : ℕ, CostLE P k L →
            c * t * k * Real.logb 2 k ≤ L := by
  sorry

end TCSChallenge.PseudorandomHashingForSpace.node_27
