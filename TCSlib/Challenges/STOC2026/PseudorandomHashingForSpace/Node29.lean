/-!
## Max-norm estimation under a heavy-coordinate promise

Let `x ∈ ℤ^d` (`d ≥ 2`) with `|x_i| ≤ d^K` and `‖x‖_∞ ≥ c‖x‖₂`.  The algorithm
hashes `x` into `m` buckets with a pairwise independent `h` and four-wise independent signs
`s`, giving `y = Lx`, `y_j = ∑_{h(i)=j} s(i) x_i`, feeds `y` into a pseudorandom CountSketch
with parameters `t, r, b`, and outputs `Est = max_j |ŷ_j|`.

The main theorem `maxNorm_estimation` states: for suitable constants and parameters with
`(r t + b log_b m)` words `= O(ε⁻²)` and update cost `r log_b m = O(log(1/ε))`, every
hashing family with the stated independence and every sketch with the stated tail bound
yields `Pr[|Est − ‖x‖_∞| ≤ ε‖x‖₂] ≥ 9/10`.

Lemma stubs: the heavy set has at most `4/c²` elements; the localization claim for signed
hashing; a union bound for the sketch tail on a fixed bucket set; the deterministic
max-composition step; and the calibration `η = ε √log(1/ε)`.
-/

namespace TCSChallenge.PseudorandomHashingForSpace.node_29

/-- Euclidean norm `‖y‖₂` of an integer vector. -/
def l2 {ι : Type} [Fintype ι] (y : ι → ℤ) : ℝ :=
  Real.sqrt (∑ i, ((y i : ℝ)) ^ 2)

/-- Max-norm `‖y‖_∞ = max_i |y_i|` of an integer vector (`0` on an empty index type). -/
def linf {ι : Type} [Fintype ι] (y : ι → ℤ) : ℝ :=
  ⨆ i, |(y i : ℝ)|

/-- "these functions define a linear aggregation `(Lx)_j = ∑_{i : h(i)=j} s(i) x_i`". -/
def reduce {d m : ℕ} (h : Fin d → Fin m) (s : Fin d → ℤ) (x : Fin d → ℤ) : Fin m → ℤ :=
  fun j => ∑ i ∈ Finset.univ.filter (fun i => h i = j), s i * x i

/-- "a pairwise independent function `h : [d] → [m]`", for a uniformly random seed `ω ∈ Ω`:
for distinct `i, i'` the pair `(h(i), h(i'))` is uniform on `[m]²`. -/
def PairwiseIndepHash {Ω : Type} [Fintype Ω] {d m : ℕ} (h : Ω → Fin d → Fin m) : Prop :=
  ∀ i i' : Fin d, i ≠ i' → ∀ a a' : Fin m,
    (Finset.univ.filter (fun ω => h ω i = a ∧ h ω i' = a')).card * m ^ 2 = Fintype.card Ω

/-- "a four-wise independent function `s : [d] → {−1, 1}`": values are `±1` and on any
`k ≤ 4` distinct coordinates the sign pattern is uniform. -/
def FourwiseIndepSigns {Ω : Type} [Fintype Ω] {d : ℕ} (s : Ω → Fin d → ℤ) : Prop :=
  (∀ ω i, s ω i = 1 ∨ s ω i = -1) ∧
  ∀ k : ℕ, k ≤ 4 → ∀ f : Fin k → Fin d, Function.Injective f →
    ∀ σ : Fin k → ℤ, (∀ l, σ l = 1 ∨ σ l = -1) →
      (Finset.univ.filter (fun ω => ∀ l, s ω (f l) = σ l)).card * 2 ^ k = Fintype.card Ω

/-- The pseudorandom CountSketch guarantee: for every fixed `y ∈ ℤ^m` with entries at most
`Mag` in absolute value (the implementation regime), every `j`, and every `α ∈ [0,1]`,
`Pr[|ŷ_j − y_j| > α‖y‖₂/√t] ≤ 2 exp(−κ α² r) + d^{−B}` over the sketch seed. -/
def SketchTail {Ω : Type} [Fintype Ω] (κ B : ℝ) (d m t r : ℕ) (Mag : ℝ)
    (est : Ω → (Fin m → ℤ) → Fin m → ℝ) : Prop :=
  ∀ y : Fin m → ℤ, (∀ j, |(y j : ℝ)| ≤ Mag) → ∀ j : Fin m, ∀ α : ℝ, 0 ≤ α → α ≤ 1 →
    ((Finset.univ.filter
        (fun ω => α * l2 y / Real.sqrt t < |est ω y j - (y j : ℝ)|)).card : ℝ)
      ≤ (2 * Real.exp (-κ * α ^ 2 * r) + (d : ℝ) ^ (-B)) * Fintype.card Ω

/-- The output rule `Est = max_{j ∈ [m]} |ŷ_j|`. -/
def Est {m : ℕ} (yhat : Fin m → ℝ) : ℝ :=
  ⨆ j, |yhat j|

/-- "coordinates of magnitude at least `(c/2)‖x‖₂`". -/
def heavySet {d : ℕ} (c : ℝ) (x : Fin d → ℤ) : Finset (Fin d) :=
  Finset.univ.filter (fun i => c / 2 * l2 x ≤ |(x i : ℝ)|)

/-- Localization event: heavy buckets keep their magnitudes up to `A η² ‖x‖₂`, every
bucket outside the image of the heavy set has magnitude at most `(c/2 + A η²)‖x‖₂`, and
`‖Lx‖₂ ≤ 2‖x‖₂`. -/
def Localized {d m : ℕ} (c A η : ℝ) (x : Fin d → ℤ) (h : Fin d → Fin m) (s : Fin d → ℤ) :
    Prop :=
  (∀ i ∈ heavySet c x, |(|(reduce h s x (h i) : ℝ)| - |(x i : ℝ)|)| ≤ A * η ^ 2 * l2 x) ∧
  (∀ j : Fin m, j ∉ (heavySet c x).image h →
      |(reduce h s x j : ℝ)| ≤ (c / 2 + A * η ^ 2) * l2 x) ∧
  l2 (reduce h s x) ≤ 2 * l2 x

/-- At most `4/c²` coordinates have magnitude `≥ (c/2)‖x‖₂`. [PseudorandomHashingForSpace, node_29] -/
theorem heavySet_card {d : ℕ} (c : ℝ) (hc0 : 0 < c) (x : Fin d → ℤ) (hx : x ≠ 0) :
    ((heavySet c x).card : ℝ) ≤ 4 / c ^ 2 := by
  sorry

/-- Structural localization for signed hashing (proved via a finer threshold `~η⁴‖x‖₂`,
isolation of the coordinates above it, and a fourth-moment bound on the residual). [PseudorandomHashingForSpace, node_29] -/
theorem localization (c : ℝ) (hc0 : 0 < c) (hc1 : c ≤ 1) :
    ∃ A : ℝ, 0 < A ∧ ∃ p : ℕ, ∀ η : ℝ, 0 < η → η ≤ 1 / 2 →
      ∀ (d m : ℕ), A * (1 / η) ^ p ≤ (m : ℝ) →
      ∀ (x : Fin d → ℤ) (Ωh Ωs : Type) [Fintype Ωh] [Fintype Ωs]
        (h : Ωh → Fin d → Fin m) (s : Ωs → Fin d → ℤ),
        PairwiseIndepHash h → FourwiseIndepSigns s →
        (39 / 40 : ℝ) * Fintype.card (Ωh × Ωs) ≤
          ((Finset.univ.filter
              (fun ω : Ωh × Ωs => Localized c A η x (h ω.1) (s ω.2))).card : ℝ) := by
  sorry

/-- Union bound of the sketch tail over a fixed bucket set `S` (used with `S = univ`, `α = 1`
for coarse accuracy and with `S = h(heavy set)`, `α ~ 1/√log(1/η)` for fine accuracy,
after conditioning on the hashing seed). [PseudorandomHashingForSpace, node_29] -/
theorem sketch_union_bound {Ω : Type} [Fintype Ω] (κ B Mag : ℝ) (d m t r : ℕ)
    (est : Ω → (Fin m → ℤ) → Fin m → ℝ) (hT : SketchTail κ B d m t r Mag est)
    (y : Fin m → ℤ) (hy : ∀ j, |(y j : ℝ)| ≤ Mag) (S : Finset (Fin m))
    (α : ℝ) (hα0 : 0 ≤ α) (hα1 : α ≤ 1) :
    ((Finset.univ.filter
        (fun ω => ∃ j ∈ S, α * l2 y / Real.sqrt t < |est ω y j - (y j : ℝ)|)).card : ℝ)
      ≤ S.card * (2 * Real.exp (-κ * α ^ 2 * r) + (d : ℝ) ^ (-B)) * Fintype.card Ω := by
  sorry

/-- Deterministic max-composition: if buckets outside `S` are at most `θ`, all estimates
have error `≤ γ`, estimates on `S` have error `≤ φ`, and `θ + γ ≤ M − φ` where `M` is the
largest true magnitude on `S`, then `|max_j |ŷ_j| − M| ≤ φ`. [PseudorandomHashingForSpace, node_29] -/
theorem max_composition {m : ℕ} (y : Fin m → ℤ) (yhat : Fin m → ℝ) (S : Finset (Fin m))
    (hS : S.Nonempty) (θ γ φ : ℝ)
    (hout : ∀ j, j ∉ S → |(y j : ℝ)| ≤ θ)
    (hcoarse : ∀ j, |yhat j - (y j : ℝ)| ≤ γ)
    (hfine : ∀ j ∈ S, |yhat j - (y j : ℝ)| ≤ φ)
    (hsep : θ + γ ≤ S.sup' hS (fun j => |(y j : ℝ)|) - φ) :
    |Est yhat - S.sup' hS (fun j => |(y j : ℝ)|)| ≤ φ := by
  sorry

/-- Calibration: with `η = ε √log(1/ε)`, the sketch size `η⁻² log(1/η)` is `O(ε⁻²)`. [PseudorandomHashingForSpace, node_29] -/
theorem calibration (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1 / 2) :
    (1 / (ε * Real.sqrt (Real.log (1 / ε)))) ^ 2 *
        Real.log (1 / (ε * Real.sqrt (Real.log (1 / ε)))) ≤ 2 / ε ^ 2 := by
  sorry

/-- **Main theorem.** Constants `C, B` depend on `c, K` and the absolute sketch constant `κ`.
For every `d ≥ 2` and `ε ∈ (0, 1/2)` with `1/ε² < d` there are parameters `m, t, r, b` with
sketch space `(r t + b log_b m) ≤ C/ε²` words, update cost `r log_b m ≤ C log(1/ε)`, and
`m ≤ C d^C`, such that for every promised vector, every independent hashing/sign family
and every sketch with the CountSketch tail guarantee, `Est = max_j |ŷ_j|` satisfies
`Pr[|Est − ‖x‖_∞| ≤ ε‖x‖₂] ≥ 9/10` over the product of the three independent seeds. [PseudorandomHashingForSpace, node_29] -/
theorem maxNorm_estimation (c : ℝ) (hc0 : 0 < c) (hc1 : c ≤ 1) (K : ℕ)
    (κ : ℝ) (hκ : 0 < κ) :
    ∃ C : ℝ, 0 < C ∧ ∃ B : ℝ, 0 < B ∧
    ∀ d : ℕ, 2 ≤ d → ∀ ε : ℝ, 0 < ε → ε < 1 / 2 → 1 / ε ^ 2 < (d : ℝ) →
    ∃ m t r b : ℕ, 2 ≤ m ∧ 1 ≤ t ∧ 1 ≤ r ∧ 2 ≤ b ∧ b ≤ m ∧
      ((r * t : ℕ) : ℝ) + b * Real.logb b m ≤ C / ε ^ 2 ∧
      (r : ℝ) * Real.logb b m ≤ C * Real.log (1 / ε) ∧
      (m : ℝ) ≤ C * (d : ℝ) ^ C ∧
      ∀ x : Fin d → ℤ, (∀ i, |x i| ≤ (d : ℤ) ^ K) → c * l2 x ≤ linf x →
      ∀ (Ωh Ωs Ωc : Type) [Fintype Ωh] [Fintype Ωs] [Fintype Ωc]
        (h : Ωh → Fin d → Fin m) (s : Ωs → Fin d → ℤ)
        (est : Ωc → (Fin m → ℤ) → Fin m → ℝ),
        PairwiseIndepHash h → FourwiseIndepSigns s →
        SketchTail κ B d m t r ((d : ℝ) ^ (K + 1)) est →
        (9 / 10 : ℝ) * Fintype.card (Ωh × Ωs × Ωc) ≤
          ((Finset.univ.filter (fun ω : Ωh × Ωs × Ωc =>
              |Est (est ω.2.2 (reduce (h ω.1) (s ω.2.1) x)) - linf x| ≤ ε * l2 x)).card : ℝ) := by
  sorry

end TCSChallenge.PseudorandomHashingForSpace.node_29
