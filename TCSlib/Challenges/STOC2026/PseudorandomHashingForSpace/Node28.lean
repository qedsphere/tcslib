/-!
## Space lower bound for `ℓ∞` estimation with `ε‖x‖₂` additive error in turnstile streams

A turnstile stream is a list of updates `(j, Δ)`; starting from `x = 0 ∈ ℤ^d` each update
adds `Δ` to `x_j`. Main theorem `main_space_lower_bound`: there are absolute `δ₀, c > 0`
such that for every `d ≥ 2` and `6 ((log d)/d)^{1/4} ≤ ε < 1`, any randomized one-pass
algorithm with `Pr[|Z − ‖x‖∞| ≤ ε‖x‖₂] ≥ 1 − δ₀` on every stream whose coordinates stay
bounded by `d` uses at least `c ε^{−2} log(1/ε) log d` bits.

Lemma stubs: the generic augmented-index information bound (1) of the reference proof, and
the norm gap of the multiscale encoding.
-/

namespace TCSChallenge.PseudorandomHashingForSpace.node_28

/-- A turnstile update `(j, Δ)`. -/
abbrev Update (d : ℕ) := Fin d × ℤ

/-- "each update replaces x_j by x_j + Δ". -/
def applyUpdate {d : ℕ} (x : Fin d → ℤ) (u : Update d) : Fin d → ℤ :=
  Function.update x u.1 (x u.1 + u.2)

/-- The vector after processing the stream from `x = 0`. -/
def finalVec {d : ℕ} (σ : List (Update d)) : Fin d → ℤ :=
  σ.foldl applyUpdate 0

/-- "every coordinate has magnitude at most d after every update". -/
def BoundedStream (d : ℕ) (σ : List (Update d)) : Prop :=
  ∀ m, m ≤ σ.length → ∀ j, |finalVec (σ.take m) j| ≤ (d : ℤ)

/-- A randomized one-pass streaming algorithm with `s` bits of state and random tape `ω`. -/
structure StreamAlg (Ω : Type) (d s : ℕ) where
  /-- initial state -/
  init : Ω → Fin (2 ^ s)
  /-- state update on one stream update -/
  step : Ω → Fin (2 ^ s) → Update d → Fin (2 ^ s)
  /-- real output `Z` at the end of the stream -/
  out : Ω → Fin (2 ^ s) → ℝ

/-- The output `Z` on tape `ω` and stream `σ`. -/
def runAlg {Ω : Type} {d s : ℕ} (A : StreamAlg Ω d s) (ω : Ω) (σ : List (Update d)) : ℝ :=
  A.out ω (σ.foldl (A.step ω) (A.init ω))

/-- `‖x‖∞ = max_j |x_j|` (`0` when `d = 0`). -/
def linfNorm {d : ℕ} (x : Fin d → ℤ) : ℝ :=
  ((Finset.univ.sup (fun j => (x j).natAbs) : ℕ) : ℝ)

/-- `‖x‖₂ = (Σ_j x_j²)^{1/2}`. -/
def l2Norm {d : ℕ} (x : Fin d → ℤ) : ℝ :=
  Real.sqrt (∑ j, ((x j : ℝ)) ^ 2)

/-- `Pr_{ω ∼ μ}[|Z − ‖x‖∞| ≤ ε‖x‖₂]` on the stream `σ`. -/
def successProb {Ω : Type} [Fintype Ω] {d s : ℕ} (A : StreamAlg Ω d s) (μ : FinDist Ω) (ε : ℝ)
    (σ : List (Update d)) : ℝ :=
  ∑ ω, if |runAlg A ω σ - linfNorm (finalVec σ)| ≤ ε * l2Norm (finalVec σ) then μ ω else 0

/-- Binary entropy `h(p) = −p log₂ p − (1−p) log₂(1−p)`. -/
def binEnt (p : ℝ) : ℝ := -(p * Real.logb 2 p) - (1 - p) * Real.logb 2 (1 - p)

/-- One-way augmented-index protocol for a finite set `S` with response functions
`f₁,…,f_m`: Alice holds `X ∈ S^t`; Bob holds `i`, `j` and the prefix `X_{<i}` (as `some`
below `i`, `none` elsewhere) and must output `f_j(X_i)`. -/
structure AugProtocol (Ω : Type) [Fintype Ω] (S : Type) (t m : ℕ) where
  /-- distribution of the random tape -/
  μ : FinDist Ω
  /-- Alice's message -/
  msg : Ω → (Fin t → S) → List Bool
  /-- Bob's output -/
  out : Ω → List Bool → Fin t → Fin m → (Fin t → Option S) → Bool

/-- Rubric 1 (information bound (1)): if the response vector `(f_j)_j` is injective on `S`,
every protocol of worst-case error `≤ δ ≤ 1/2` and message length `≤ L` has
`L + 1 ≥ t (log₂|S| − m h(δ))` (the `+1` accounts for the fewer than `2^{L+1}` binary
strings of length `≤ L`; the reference writes `s ≥ …` with `s` the entropy bound). [PseudorandomHashingForSpace, node_28] -/
theorem augIndex_info_bound {Ω S : Type} [Fintype Ω] [Fintype S] (t m : ℕ)
    (f : Fin m → S → Bool) (hf : Function.Injective (fun x : S => fun j => f j x))
    (P : AugProtocol Ω S t m) (δ : ℝ) (hδ0 : 0 ≤ δ) (hδ : δ ≤ 1 / 2)
    (herr : ∀ (X : Fin t → S) (i : Fin t) (j : Fin m),
      (∑ ω, if P.out ω (P.msg ω X) i j (fun l => if l < i then some (X l) else none)
          ≠ f j (X i) then P.μ ω else 0) ≤ δ)
    (L : ℕ) (hL : ∀ ω X, (P.msg ω X).length ≤ L) :
    (t : ℝ) * (Real.logb 2 (Fintype.card S) - m * binEnt δ) ≤ L + 1 := by
  sorry

/-- The vector Bob ends with in the multiscale reduction (0-based blocks): blocks `< i`
erased, block `i` equal to `w(1_{A_i} + 1_B)` with `w = 10^{t−1−i}`, later blocks
`10^{t−1−j} 1_{A_j}`. -/
def multiscaleVec {t n : ℕ} (A : Fin t → Finset (Fin n)) (i : Fin t) (B : Finset (Fin n)) :
    Fin t × Fin n → ℤ :=
  fun p =>
    if p.1 < i then 0
    else if p.1 = i then
      (10 : ℤ) ^ (t - 1 - (i : ℕ)) * ((if p.2 ∈ A i then 1 else 0) + (if p.2 ∈ B then 1 else 0))
    else (10 : ℤ) ^ (t - 1 - (p.1 : ℕ)) * (if p.2 ∈ A p.1 then 1 else 0)

/-- Rubric 3: the `w` versus `2w` infinity-norm gap and `‖v‖₂² < 5 k w²`. [PseudorandomHashingForSpace, node_28] -/
theorem multiscale_norm_gap {t n k : ℕ} (A : Fin t → Finset (Fin n)) (i : Fin t)
    (B : Finset (Fin n)) (hk : 1 ≤ k) (hA : ∀ j, (A j).card = k) (hB : B.card = k) :
    let v := multiscaleVec A i B
    let w : ℤ := (10 : ℤ) ^ (t - 1 - (i : ℕ))
    (Finset.univ.sup (fun p => (v p).natAbs) : ℕ) =
        (if Disjoint (A i) B then w.natAbs else 2 * w.natAbs) ∧
      (∑ p, ((v p : ℝ)) ^ 2) < 5 * k * ((w : ℝ)) ^ 2 := by
  sorry

/-- Main theorem: absolute `δ₀, c > 0` such that for `d ≥ 2` and
`6((log d)/d)^{1/4} ≤ ε < 1`, every algorithm meeting the guarantee on all bounded streams
uses `s ≥ c ε^{−2} log(1/ε) log d` bits. [PseudorandomHashingForSpace, node_28] -/
theorem main_space_lower_bound :
    ∃ δ₀ c : ℝ, 0 < δ₀ ∧ 0 < c ∧
      ∀ (d : ℕ), 2 ≤ d → ∀ ε : ℝ,
        6 * (Real.logb 2 d / d) ^ ((1 : ℝ) / 4) ≤ ε → ε < 1 →
        ∀ (Ω : Type) [Fintype Ω] (s : ℕ) (A : StreamAlg Ω d s) (μ : FinDist Ω),
          (∀ σ : List (Update d), BoundedStream d σ → 1 - δ₀ ≤ successProb A μ ε σ) →
          c * (1 / ε ^ 2) * Real.logb 2 (1 / ε) * Real.logb 2 d ≤ s := by
  sorry

end TCSChallenge.PseudorandomHashingForSpace.node_28
