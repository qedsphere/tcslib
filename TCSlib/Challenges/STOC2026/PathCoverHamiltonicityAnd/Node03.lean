/-!
## Path cover vs. independence number, FPT certificate (node_03)

Let `G` be a finite simple graph. A path cover is a family of vertex-disjoint paths
(possibly single vertices) whose vertex sets partition `V(G)`; `pc(G)` is the minimum
size of a path cover and `α(G)` the independence number. For every `k ≥ 1` the paper
gives an algorithm that outputs a path cover `P` together with either a certificate that
`P` is minimum or an independent set `I` with `|I| = |P| + k`; in the latter case
`|P| ≤ α(G) - k`.

Paths are lists of vertices (`List V`), path covers are lists of paths. The main
theorem is `main_theorem`; `case_b_bound` is the deduction `|P| ≤ α(G) - k`.
-/

namespace TCSChallenge.PathCoverHamiltonicityAnd.node_03

variable {V : Type} [Fintype V] [DecidableEq V]

/-- "a path": a nonempty list of distinct vertices, consecutive vertices adjacent in `G`.
A single vertex is a path with no edges. -/
def IsPathList (G : SimpleGraph V) (p : List V) : Prop :=
  p ≠ [] ∧ p.Nodup ∧
    ∀ i j : Fin p.length, j.val = i.val + 1 → G.Adj (p.get i) (p.get j)

/-- "A path cover of G is a family of pairwise vertex-disjoint paths, possibly including
paths with no edges, whose vertex sets partition V(G)": every member is a path and every
vertex lies on exactly one member. Its cardinality is `P.length`. -/
def IsPathCover (G : SimpleGraph V) (P : List (List V)) : Prop :=
  (∀ p ∈ P, IsPathList G p) ∧ ∀ v : V, P.countP (fun p => decide (v ∈ p)) = 1

/-- `pc(G)`, the minimum cardinality of a path cover of `G`. -/
def pathCoverNumber (G : SimpleGraph V) : ℕ :=
  sInf {m : ℕ | ∃ P : List (List V), IsPathCover G P ∧ P.length = m}

/-- "a certificate that P is a minimum path cover": `P` is a path cover and no path cover
has fewer paths. -/
def IsMinimumPathCover (G : SimpleGraph V) (P : List (List V)) : Prop :=
  IsPathCover G P ∧ ∀ Q : List (List V), IsPathCover G Q → P.length ≤ Q.length

/-- Vertex set of a path. -/
def vset (p : List V) : Set V := {v | v ∈ p}

/-- "Endpoint" of a path: its first or its last vertex. -/
def IsEndpoint (p : List V) (v : V) : Prop :=
  p.head? = some v ∨ p.getLast? = some v

/-- "Call P_i special if it is a singleton, consists of one edge, or its two endpoints are
adjacent in G. Call it usual otherwise." -/
def IsSpecial (G : SimpleGraph V) (p : List V) : Prop :=
  p.length ≤ 2 ∨ ∃ s t : V, p.head? = some s ∧ p.getLast? = some t ∧ G.Adj s t

/-- Endpoint joining is unavailable: no endpoint of one path is adjacent to an endpoint of
another path. -/
def NoEndpointJoin (G : SimpleGraph V) (P : List (List V)) : Prop :=
  ∀ i j : Fin P.length, i ≠ j → ∀ e f : V,
    IsEndpoint (P.get i) e → IsEndpoint (P.get j) f → ¬ G.Adj e f

/-- First special-path transformation unavailable: no vertex of a special path with at least
two edges is adjacent to an endpoint of another path. -/
def NoSpecialAttach (G : SimpleGraph V) (P : List (List V)) : Prop :=
  ∀ i j : Fin P.length, i ≠ j → IsSpecial G (P.get i) → 3 ≤ (P.get i).length →
    ∀ u e : V, u ∈ P.get i → IsEndpoint (P.get j) e → ¬ G.Adj u e

/-- Second special-path transformation unavailable: no edge between two distinct special
paths each having at least two edges. -/
def NoSpecialSpecial (G : SimpleGraph V) (P : List (List V)) : Prop :=
  ∀ i j : Fin P.length, i ≠ j →
    IsSpecial G (P.get i) → 3 ≤ (P.get i).length →
    IsSpecial G (P.get j) → 3 ≤ (P.get j).length →
    ∀ u w : V, u ∈ P.get i → w ∈ P.get j → ¬ G.Adj u w

/-- Three-path transformation unavailable: there are no distinct special paths `A`, `B`,
a usual path `R`, and edges `ax`, `by` with `a ∈ A`, `b ∈ B`, distinct `x, y ∈ R`. -/
def NoThreePath (G : SimpleGraph V) (P : List (List V)) : Prop :=
  ∀ a b r : Fin P.length, a ≠ b → a ≠ r → b ≠ r →
    IsSpecial G (P.get a) → IsSpecial G (P.get b) → ¬ IsSpecial G (P.get r) →
    ∀ va vb x y : V, va ∈ P.get a → vb ∈ P.get b → x ∈ P.get r → y ∈ P.get r → x ≠ y →
      ¬ (G.Adj va x ∧ G.Adj vb y)

/-- "no transformation applies". -/
def Irreducible (G : SimpleGraph V) (P : List (List V)) : Prop :=
  NoEndpointJoin G P ∧ NoSpecialAttach G P ∧ NoSpecialSpecial G P ∧ NoThreePath G P

/-- Number of usual paths of the cover. -/
def numUsual (G : SimpleGraph V) (P : List (List V)) : ℕ :=
  (Finset.univ.filter (fun i : Fin P.length => ¬ IsSpecial G (P.get i))).card

/-- Number of special paths whose vertex sets do not induce cliques. -/
def numNonCliqueSpecial (G : SimpleGraph V) (P : List (List V)) : ℕ :=
  (Finset.univ.filter (fun i : Fin P.length =>
    IsSpecial G (P.get i) ∧ ¬ G.IsClique (vset (P.get i)))).card

/-- `C` is a clique whose vertex set is a connected component of `G - Z`: it is a
nonempty clique avoiding `Z` and every neighbour of a vertex of `C` lies in `C` or in `Z`. -/
def IsCliqueComponentMinus (G : SimpleGraph V) (Z : Finset V) (C : Set V) : Prop :=
  C.Nonempty ∧ (∀ v ∈ C, v ∉ Z) ∧ G.IsClique C ∧
    ∀ v ∈ C, ∀ w : V, G.Adj v w → w ∈ C ∨ w ∈ Z

/-! ### Rubric item 1: endpoint phase and first certificate -/

/-- After endpoint joining is exhausted, if at least `k` paths are usual then there is an
independent set of size `m + k`. [PathCoverHamiltonicityAnd, node_03] -/
theorem endpoint_certificate (G : SimpleGraph V) (k : ℕ) (P : List (List V))
    (hP : IsPathCover G P) (hJ : NoEndpointJoin G P) (hu : k ≤ numUsual G P) :
    ∃ I : Finset V, G.IsIndepSet (I : Set V) ∧ I.card = P.length + k := by
  sorry

/-! ### Rubric item 2: consequences of exhausting the reroutings -/

/-- Exhaustion of endpoint joining and the two special-path transformations: distinct
special paths are anticomplete. [PathCoverHamiltonicityAnd, node_03] -/
theorem special_anticomplete (G : SimpleGraph V) (P : List (List V))
    (hP : IsPathCover G P) (hJ : NoEndpointJoin G P) (hA : NoSpecialAttach G P)
    (hS : NoSpecialSpecial G P) (i j : Fin P.length) (hij : i ≠ j)
    (hi : IsSpecial G (P.get i)) (hj : IsSpecial G (P.get j))
    (u w : V) (hu : u ∈ P.get i) (hw : w ∈ P.get j) : ¬ G.Adj u w := by
  sorry

/-- Second certificate: with fewer than `k` usual paths and at least `2k` non-clique special
paths, there is an independent set of size `m + k`. [PathCoverHamiltonicityAnd, node_03] -/
theorem nonclique_certificate (G : SimpleGraph V) (k : ℕ) (P : List (List V))
    (hP : IsPathCover G P) (hirr : Irreducible G P) (hu : numUsual G P < k)
    (hnc : 2 * k ≤ numNonCliqueSpecial G P) :
    ∃ I : Finset V, G.IsIndepSet (I : Set V) ∧ I.card = P.length + k := by
  sorry

/-- The three-path transformation preserves path covers and does not increase the number
of paths: from distinct special `A`, `B`, usual `R` with edges `ax`, `by` (`x ≠ y` on `R`)
one obtains a path cover whose length is at most the old one and which has strictly fewer
special paths when the length is unchanged. [PathCoverHamiltonicityAnd, node_03] -/
theorem three_path_transformation (G : SimpleGraph V) (P : List (List V))
    (hP : IsPathCover G P) (hJ : NoEndpointJoin G P) (hA : NoSpecialAttach G P)
    (a b r : Fin P.length) (hab : a ≠ b) (har : a ≠ r) (hbr : b ≠ r)
    (ha : IsSpecial G (P.get a)) (hb : IsSpecial G (P.get b))
    (hr : ¬ IsSpecial G (P.get r)) (va vb x y : V) (hva : va ∈ P.get a)
    (hvb : vb ∈ P.get b) (hx : x ∈ P.get r) (hy : y ∈ P.get r) (hxy : x ≠ y)
    (hax : G.Adj va x) (hby : G.Adj vb y) :
    ∃ Q : List (List V), IsPathCover G Q ∧
      (Q.length < P.length ∨
        (Q.length = P.length ∧
          (Finset.univ.filter (fun i : Fin Q.length => IsSpecial G (Q.get i))).card <
          (Finset.univ.filter (fun i : Fin P.length => IsSpecial G (P.get i))).card)) := by
  sorry

/-! ### Rubric item 3: irreducible structure -/

/-- In an irreducible cover with fewer than `k` usual paths and fewer than `2k` non-clique
special paths there is `Z` with `|Z| < k` such that at least `m - 4k` current paths have
vertex sets that are clique components of `G - Z`. [PathCoverHamiltonicityAnd, node_03] -/
theorem irreducible_structure (G : SimpleGraph V) (k : ℕ) (hk : 1 ≤ k)
    (P : List (List V)) (hP : IsPathCover G P) (hirr : Irreducible G P)
    (hu : numUsual G P < k) (hnc : numNonCliqueSpecial G P < 2 * k) :
    ∃ Z : Finset V, Z.card < k ∧ ∃ S : Finset (Fin P.length),
      P.length ≤ S.card + 4 * k ∧
      ∀ i ∈ S, IsSpecial G (P.get i) ∧ IsCliqueComponentMinus G Z (vset (P.get i)) := by
  sorry

/-! ### Rubric item 4: lifting -/

/-- Lifting optimal covers: if `D` is a family of `r` pairwise disjoint cliques, each a
component of `G - Z`, and some minimum path cover of `G` contains a path on each member
of `D` (the guarantee of auxiliary result (i)), then
`pc(G) = pc(G - ⋃ D) + r`. [PathCoverHamiltonicityAnd, node_03] -/
theorem lift_minimum (G : SimpleGraph V) (Z : Finset V) (r : ℕ) (D : Fin r → Set V)
    (hD : ∀ i, IsCliqueComponentMinus G Z (D i))
    (hdisj : ∀ i j, i ≠ j → Disjoint (D i) (D j))
    (hmin : ∃ P : List (List V), IsMinimumPathCover G P ∧
      ∀ i, ∃ p ∈ P, vset p = D i) :
    pathCoverNumber G =
      pathCoverNumber (G.induce {v : V | ∀ i, v ∉ D i}) + r := by
  sorry

/-- Lifting independent-set certificates: an independent set `I'` of `G - ⋃ D`, minus `Z`,
together with one vertex from each deleted clique, is independent in `G`. [PathCoverHamiltonicityAnd, node_03] -/
theorem lift_independent (G : SimpleGraph V) (Z : Finset V) (r : ℕ) (D : Fin r → Set V)
    (hD : ∀ i, IsCliqueComponentMinus G Z (D i))
    (hdisj : ∀ i j, i ≠ j → Disjoint (D i) (D j))
    (I' : Finset V) (hI'D : ∀ v ∈ I', ∀ i, v ∉ D i)
    (hI' : G.IsIndepSet (I' : Set V)) (z : Fin r → V) (hz : ∀ i, z i ∈ D i) :
    G.IsIndepSet ((I' \ Z : Set V) ∪ Set.range z) := by
  sorry

/-! ### Main theorem -/

/-- For every `k ≥ 1` and every finite graph `G`, there is a path cover `P` such that
either (a) `P` is a minimum path cover, or (b) there is an independent set `I` with
`|I| = |P| + k`. (The paper's algorithm, with running time `2^{k^{O(k⁴)}} n^{O(1)}`,
outputs such a pair; the running time is not captured.) [PathCoverHamiltonicityAnd, node_03] -/
theorem main_theorem (k : ℕ) (hk : 1 ≤ k) (G : SimpleGraph V) :
    ∃ P : List (List V), IsPathCover G P ∧
      (IsMinimumPathCover G P ∨
        ∃ I : Finset V, G.IsIndepSet (I : Set V) ∧ I.card = P.length + k) := by
  sorry

/-- "Deduce in case (b) that |P| ≤ α(G) - k." [PathCoverHamiltonicityAnd, node_03] -/
theorem case_b_bound (k : ℕ) (G : SimpleGraph V) (P : List (List V))
    (I : Finset V) (hI : G.IsIndepSet (I : Set V)) (hcard : I.card = P.length + k) :
    P.length + k ≤ G.indepNum ∧ P.length ≤ G.indepNum - k := by
  sorry

end TCSChallenge.PathCoverHamiltonicityAnd.node_03
