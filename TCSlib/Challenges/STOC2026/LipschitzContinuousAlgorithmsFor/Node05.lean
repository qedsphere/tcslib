/-!
## Deterministic approximate shortest paths have unbounded weighted Lipschitz constant

A deterministic algorithm `A` returns a simple `s`–`t` path `A(G,s,t,w)` on every finite
multigraph with distinct, connected `s ≠ t` and nonnegative weights `w`, with
`w(A(G,w)) ≤ ρ · OPT_G(w)` for a constant `ρ ≥ 1`. With the weighted output representation
`Φ_w(F)(e) = w(e) 𝟙_{e∈F}` and the `ℓ₁` norm, the main theorem `main` says there is one fixed
graph on which
`sup_{w ≠ w'} ‖Φ_w(A(G,w)) − Φ_{w'}(A(G,w'))‖₁ / ‖w − w'‖₁ = ∞`.
-/

namespace TCSChallenge.LipschitzContinuousAlgorithmsForGraphProblems.node_05

/-- A finite undirected multigraph with vertex set `Fin n` and edge set `Fin m`; edge `e`
joins the (unordered) endpoints `ends e`. "Parallel edges are regarded as distinct":
two edge labels may carry the same endpoints. -/
structure Multigraph where
  n : ℕ
  m : ℕ
  ends : Fin m → Sym2 (Fin n)

namespace Multigraph

variable (G : Multigraph)

/-- "`w ∈ [0,∞)^E`": all edge weights are nonnegative. -/
def Nonneg (w : Fin G.m → ℝ) : Prop := ∀ e, 0 ≤ w e

/-- "`w(F) = ∑_{e∈F} w(e)`". -/
def weight (w : Fin G.m → ℝ) (F : Finset (Fin G.m)) : ℝ := ∑ e ∈ F, w e

/-- The weighted output representation "`Φ_w(F)(e) = w(e) 𝟙_{e∈F}`" (also written
`x_w(F)`). -/
def weightedOutput (w : Fin G.m → ℝ) (F : Finset (Fin G.m)) : Fin G.m → ℝ :=
  fun e => if e ∈ F then w e else 0

/-- "`‖x‖₁ = ∑_{e∈E} |x(e)|`". -/
def l1 (x : Fin G.m → ℝ) : ℝ := ∑ e, |x e|

/-- `P` is a probability distribution on edge subsets supported on the family `S`. -/
def IsDistOn (P : Finset (Fin G.m) → ℝ) (S : Finset (Fin G.m) → Prop) : Prop :=
  (∀ F, 0 ≤ P F) ∧ (∑ F, P F = 1) ∧ ∀ F, ¬ S F → P F = 0

/-- "`γ` is a probability distribution on pairs with marginals `P` and `Q`". -/
def IsCoupling (γ : Finset (Fin G.m) × Finset (Fin G.m) → ℝ)
    (P Q : Finset (Fin G.m) → ℝ) : Prop :=
  (∀ x, 0 ≤ γ x) ∧ (∀ F, ∑ F', γ (F, F') = P F) ∧ (∀ F', ∑ F, γ (F, F') = Q F')

/-- The weighted transportation (earth mover's) distance
"`W_{w,w'}(P,Q) = inf_{γ∈Γ(P,Q)} E_{(F,F')∼γ} ‖x_w(F) − x_{w'}(F')‖₁`". -/
def transportCost (w w' : Fin G.m → ℝ) (P Q : Finset (Fin G.m) → ℝ) : ℝ :=
  sInf {c : ℝ | ∃ γ, G.IsCoupling γ P Q ∧
    c = ∑ x, γ x * G.l1 (G.weightedOutput w x.1 - G.weightedOutput w' x.2)}

end Multigraph

/-- The witness graph used in all three reference proofs: two vertices `0, 1` joined by the
two distinct parallel edges `e₁ = 0` and `e₂ = 1`. -/
abbrev twoParallel : Multigraph := ⟨2, 2, fun _ => Sym2.mk (0, 1)⟩

namespace Multigraph

variable (G : Multigraph)

/-- "`F` is (the edge set of) a simple `s`–`t` path": there are pairwise distinct vertices
`s = v₀, v₁, …, v_k = t` and edges `e₁, …, e_k` with `e_i` joining `v_{i-1}` and `v_i`,
and `F = {e₁, …, e_k}`. -/
def IsSimplePath (s t : Fin G.n) (F : Finset (Fin G.m)) : Prop :=
  ∃ (k : ℕ) (vtx : Fin (k + 1) → Fin G.n) (edg : Fin k → Fin G.m),
    Function.Injective vtx ∧ vtx 0 = s ∧ vtx (Fin.last k) = t ∧
    (∀ i : Fin k, G.ends (edg i) = Sym2.mk (vtx i.castSucc, vtx i.succ)) ∧
    F = Finset.univ.image edg

end Multigraph

/-- A deterministic shortest-path algorithm: returns an edge set `A(G,s,t,w)` on every input. -/
abbrev PathAlgorithm : Type :=
  (G : Multigraph) → Fin G.n → Fin G.n → (Fin G.m → ℝ) → Finset (Fin G.m)

/-- "`A` returns a simple `s`–`t` path on every valid input and `w(A(G,w)) ≤ ρ OPT_G(w)`":
for all multigraphs with distinct `s, t` joined by a path and all `w ≥ 0`. -/
def IsRhoApprox (ρ : ℝ) (A : PathAlgorithm) : Prop :=
  ∀ (G : Multigraph) (s t : Fin G.n), s ≠ t → (∃ P, G.IsSimplePath s t P) →
    ∀ w : Fin G.m → ℝ, G.Nonneg w →
      G.IsSimplePath s t (A G s t w) ∧
      ∀ P, G.IsSimplePath s t P → G.weight w (A G s t w) ≤ ρ * G.weight w P

/-- The weight family `w⁽ⁱ⁾(e₁) = i/k`, `w⁽ⁱ⁾(e₂) = 1 − i/k` on `twoParallel`. -/
def stepWeight (k i : ℕ) : Fin twoParallel.m → ℝ :=
  fun e => if e = 0 then (i : ℝ) / k else 1 - (i : ℝ) / k

/-- Rubric 2: at a zero-optimum endpoint instance the approximation guarantee forces the
unique zero-weight path: `A(G,w⁽⁰⁾) = {e₁}` and `A(G,w⁽ᵏ⁾) = {e₂}`. [LipschitzContinuousAlgorithmsFor, node_05] -/
theorem forced_endpoints (ρ : ℝ) (hρ : 1 ≤ ρ) (A : PathAlgorithm) (hA : IsRhoApprox ρ A)
    (k : ℕ) (hk : 2 ≤ k) :
    A twoParallel 0 1 (stepWeight k 0) = {0} ∧ A twoParallel 0 1 (stepWeight k k) = {1} := by
  sorry

/-- Rubric 3: there is an index `1 ≤ j ≤ k` where the output switches from `{e₁}` to `{e₂}`. [LipschitzContinuousAlgorithmsFor, node_05] -/
theorem transition_exists (ρ : ℝ) (hρ : 1 ≤ ρ) (A : PathAlgorithm) (hA : IsRhoApprox ρ A)
    (k : ℕ) (hk : 2 ≤ k) :
    ∃ j : ℕ, 1 ≤ j ∧ j ≤ k ∧
      A twoParallel 0 1 (stepWeight k (j - 1)) = {0} ∧
      A twoParallel 0 1 (stepWeight k j) = {1} := by
  sorry

/-- Rubric 4: at such a transition, input distance is `2/k` and weighted output distance is
`1 − 1/k`. [LipschitzContinuousAlgorithmsFor, node_05] -/
theorem transition_distances (k j : ℕ) (hk : 2 ≤ k) (hj1 : 1 ≤ j) (hjk : j ≤ k) :
    twoParallel.l1 (stepWeight k j - stepWeight k (j - 1)) = 2 / k ∧
    twoParallel.l1 (twoParallel.weightedOutput (stepWeight k (j - 1)) {0} -
      twoParallel.weightedOutput (stepWeight k j) {1}) = 1 - 1 / k := by
  sorry

/-- Main theorem: for every deterministic `ρ`-approximate `s`–`t` path algorithm there is a
fixed graph on which the weighted Lipschitz constant `L_G(A)` is infinite. [LipschitzContinuousAlgorithmsFor, node_05] -/
theorem main (ρ : ℝ) (hρ : 1 ≤ ρ) (A : PathAlgorithm) (hA : IsRhoApprox ρ A) :
    ∃ (G : Multigraph) (s t : Fin G.n), s ≠ t ∧ (∃ P, G.IsSimplePath s t P) ∧
      ∀ L : ℝ, ∃ w w' : Fin G.m → ℝ, G.Nonneg w ∧ G.Nonneg w' ∧ w ≠ w' ∧
        L * G.l1 (w - w') <
          G.l1 (G.weightedOutput w (A G s t w) - G.weightedOutput w' (A G s t w')) := by
  sorry

end TCSChallenge.LipschitzContinuousAlgorithmsForGraphProblems.node_05
