/-!
## Approximate randomized MST algorithms have Lipschitz constant `Ω(1/ε)`

A randomized spanning-tree algorithm assigns to each connected multigraph `G` and `w ≥ 0`
a distribution `P_{G,w}` on spanning trees with `E_{T∼P_{G,w}} w(T) ≤ (1+ε) OPT(G,w)`.
With `x_w(T)_e = w(e) 𝟙_{e∈T}` and the weighted transportation distance
`W_{w,w'}(P,Q) = inf_γ E_γ ‖x_w(T) − x_{w'}(T')‖₁`, the main theorem `main` gives absolute
`c, ε₀ > 0` with `Lip(A) ≥ c/ε` for every `ε ∈ (0, ε₀]` and every such `A`.
-/

namespace TCSChallenge.LipschitzContinuousAlgorithmsForGraphProblems.node_21

/-- A finite undirected multigraph with vertex set `Fin n` and edge set `Fin m`; edge `e`
joins the (unordered) endpoints `ends e`. "Parallel edges are regarded as distinct":
two edge labels may carry the same endpoints. -/
structure Multigraph where
  n : ℕ
  m : ℕ
  ends : Fin m → Sym2 (Fin n)

namespace Multigraph

variable (G : Multigraph)

/-- "`w ∈ [0,∞)^E`": all edge weights are nonnegative. -/
def Nonneg (w : Fin G.m → ℝ) : Prop := ∀ e, 0 ≤ w e

/-- "`w(F) = ∑_{e∈F} w(e)`". -/
def weight (w : Fin G.m → ℝ) (F : Finset (Fin G.m)) : ℝ := ∑ e ∈ F, w e

/-- The weighted output representation "`Φ_w(F)(e) = w(e) 𝟙_{e∈F}`" (also written
`x_w(F)`). -/
def weightedOutput (w : Fin G.m → ℝ) (F : Finset (Fin G.m)) : Fin G.m → ℝ :=
  fun e => if e ∈ F then w e else 0

/-- "`‖x‖₁ = ∑_{e∈E} |x(e)|`". -/
def l1 (x : Fin G.m → ℝ) : ℝ := ∑ e, |x e|

/-- `P` is a probability distribution on edge subsets supported on the family `S`. -/
def IsDistOn (P : Finset (Fin G.m) → ℝ) (S : Finset (Fin G.m) → Prop) : Prop :=
  (∀ F, 0 ≤ P F) ∧ (∑ F, P F = 1) ∧ ∀ F, ¬ S F → P F = 0

/-- "`γ` is a probability distribution on pairs with marginals `P` and `Q`". -/
def IsCoupling (γ : Finset (Fin G.m) × Finset (Fin G.m) → ℝ)
    (P Q : Finset (Fin G.m) → ℝ) : Prop :=
  (∀ x, 0 ≤ γ x) ∧ (∀ F, ∑ F', γ (F, F') = P F) ∧ (∀ F', ∑ F, γ (F, F') = Q F')

/-- The weighted transportation (earth mover's) distance
"`W_{w,w'}(P,Q) = inf_{γ∈Γ(P,Q)} E_{(F,F')∼γ} ‖x_w(F) − x_{w'}(F')‖₁`". -/
def transportCost (w w' : Fin G.m → ℝ) (P Q : Finset (Fin G.m) → ℝ) : ℝ :=
  sInf {c : ℝ | ∃ γ, G.IsCoupling γ P Q ∧
    c = ∑ x, γ x * G.l1 (G.weightedOutput w x.1 - G.weightedOutput w' x.2)}

end Multigraph

/-- The witness graph used in all three reference proofs: two vertices `0, 1` joined by the
two distinct parallel edges `e₁ = 0` and `e₂ = 1`. -/
abbrev twoParallel : Multigraph := ⟨2, 2, fun _ => Sym2.mk (0, 1)⟩

namespace Multigraph

variable (G : Multigraph)

/-- The simple graph on `Fin n` underlying the edge set `F` (loops dropped, parallel edges
merged). -/
def underlying (F : Finset (Fin G.m)) : SimpleGraph (Fin G.n) :=
  SimpleGraph.fromRel (fun u v => ∃ e ∈ F, G.ends e = Sym2.mk (u, v))

/-- "`G` is connected". -/
def IsConnected : Prop := (G.underlying Finset.univ).Connected

/-- "`T ∈ T(G)`": `T` spans and connects all vertices and has exactly `n − 1` edges. -/
def IsSpanningTree (T : Finset (Fin G.m)) : Prop :=
  (G.underlying T).Connected ∧ T.card + 1 = G.n

end Multigraph

/-- A randomized spanning-tree algorithm: `A G w T` is the probability `P_{G,w}(T)`. -/
abbrev RandAlgorithm : Type :=
  (G : Multigraph) → (Fin G.m → ℝ) → Finset (Fin G.m) → ℝ

/-- "`P_{G,w}` is a distribution on `T(G)` and `∑_T P_{G,w}(T) w(T) ≤ (1+ε) OPT(G,w)`" for
every connected `G` and every `w ≥ 0`. -/
def IsExpApproxST (ε : ℝ) (A : RandAlgorithm) : Prop :=
  ∀ (G : Multigraph), G.IsConnected → ∀ w : Fin G.m → ℝ, G.Nonneg w →
    G.IsDistOn (A G w) G.IsSpanningTree ∧
    ∀ T, G.IsSpanningTree T → ∑ F, A G w F * G.weight w F ≤ (1 + ε) * G.weight w T

/-- The witness graph is connected. [LipschitzContinuousAlgorithmsFor, node_21] -/
theorem twoParallel_connected : twoParallel.IsConnected := by
  sorry

/-- Rubric 1: at the tied weights `w ≡ 1`, some edge's tree `{eᵢ}` has probability `≥ 1/2`
(no symmetry of `A` is assumed). [LipschitzContinuousAlgorithmsFor, node_21] -/
theorem baseline_half (ε : ℝ) (A : RandAlgorithm) (hA : IsExpApproxST ε A) :
    ∃ i : Fin twoParallel.m, 1 / 2 ≤ A twoParallel (fun _ => 1) {i} := by
  sorry

/-- Rubric 2: if `w'(eᵢ) = 1` and `w'(e_{3−i}) = 1 − 10ε`, the expected guarantee forces
`Pr[A(G,w') = {e_{3−i}}] ≥ 9/10 + ε`. [LipschitzContinuousAlgorithmsFor, node_21] -/
theorem approx_forces_shift (ε : ℝ) (hε : 0 < ε) (hε1 : ε ≤ 1 / 100) (A : RandAlgorithm)
    (hA : IsExpApproxST ε A) (i j : Fin twoParallel.m) (hij : i ≠ j) :
    9 / 10 + ε ≤
      A twoParallel (fun e => if e = j then 1 - 10 * ε else 1) {j} := by
  sorry

/-- Rubric 3: coupling-independent lower bound. For distributions `P, Q` and any edge `e`,
`W_{w,w'}(P,Q) ≥ E_Q[x_{w'}(T')_e] − E_P[x_w(T)_e]`. [LipschitzContinuousAlgorithmsFor, node_21] -/
theorem transport_ge_coord (G : Multigraph) (S S' : Finset (Fin G.m) → Prop)
    (P Q : Finset (Fin G.m) → ℝ) (hP : G.IsDistOn P S) (hQ : G.IsDistOn Q S')
    (w w' : Fin G.m → ℝ) (e : Fin G.m) :
    (∑ F', Q F' * G.weightedOutput w' F' e) - (∑ F, P F * G.weightedOutput w F e) ≤
      G.transportCost w w' P Q := by
  sorry

/-- Main theorem: absolute `c, ε₀ > 0` such that every randomized spanning-tree algorithm
with expected approximation ratio `1 + ε`, `ε ∈ (0, ε₀]`, has `Lip(A) ≥ c/ε`. [LipschitzContinuousAlgorithmsFor, node_21] -/
theorem main :
    ∃ c : ℝ, 0 < c ∧ ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∀ ε : ℝ, 0 < ε → ε ≤ ε₀ →
      ∀ A : RandAlgorithm, IsExpApproxST ε A → ∀ L : ℝ, L < c / ε →
        ∃ (G : Multigraph) (w w' : Fin G.m → ℝ), G.IsConnected ∧ G.Nonneg w ∧
          G.Nonneg w' ∧ w ≠ w' ∧
          L * G.l1 (w - w') < G.transportCost w w' (A G w) (A G w') := by
  sorry

end TCSChallenge.LipschitzContinuousAlgorithmsForGraphProblems.node_21
