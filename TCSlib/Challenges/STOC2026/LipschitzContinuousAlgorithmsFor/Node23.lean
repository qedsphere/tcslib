/-!
## Approximate randomized maximum-weight matching has Lipschitz constant `Ω(α)`

A randomized algorithm assigns to every finite loopless multigraph `G` and `w ≥ 0` a
distribution `μ_{G,w}` on matchings with `E_{M∼μ_{G,w}} w(M) ≥ α OPT(G,w)`. With the weighted
earth mover's distance `EM_w = inf_π E_π ∑_e |w(e)𝟙_{e∈M} − w'(e)𝟙_{e∈M'}|`, the main
theorem `main` gives an absolute `c > 0` with `L(A) ≥ cα` for all `α ∈ (0,1]` and all `A`.
-/

namespace TCSChallenge.LipschitzContinuousAlgorithmsForGraphProblems.node_23

/-- A finite undirected multigraph with vertex set `Fin n` and edge set `Fin m`; edge `e`
joins the (unordered) endpoints `ends e`. "Parallel edges are regarded as distinct":
two edge labels may carry the same endpoints. -/
structure Multigraph where
  n : ℕ
  m : ℕ
  ends : Fin m → Sym2 (Fin n)

namespace Multigraph

variable (G : Multigraph)

/-- "`w ∈ [0,∞)^E`": all edge weights are nonnegative. -/
def Nonneg (w : Fin G.m → ℝ) : Prop := ∀ e, 0 ≤ w e

/-- "`w(F) = ∑_{e∈F} w(e)`". -/
def weight (w : Fin G.m → ℝ) (F : Finset (Fin G.m)) : ℝ := ∑ e ∈ F, w e

/-- The weighted output representation "`Φ_w(F)(e) = w(e) 𝟙_{e∈F}`" (also written
`x_w(F)`). -/
def weightedOutput (w : Fin G.m → ℝ) (F : Finset (Fin G.m)) : Fin G.m → ℝ :=
  fun e => if e ∈ F then w e else 0

/-- "`‖x‖₁ = ∑_{e∈E} |x(e)|`". -/
def l1 (x : Fin G.m → ℝ) : ℝ := ∑ e, |x e|

/-- `P` is a probability distribution on edge subsets supported on the family `S`. -/
def IsDistOn (P : Finset (Fin G.m) → ℝ) (S : Finset (Fin G.m) → Prop) : Prop :=
  (∀ F, 0 ≤ P F) ∧ (∑ F, P F = 1) ∧ ∀ F, ¬ S F → P F = 0

/-- "`γ` is a probability distribution on pairs with marginals `P` and `Q`". -/
def IsCoupling (γ : Finset (Fin G.m) × Finset (Fin G.m) → ℝ)
    (P Q : Finset (Fin G.m) → ℝ) : Prop :=
  (∀ x, 0 ≤ γ x) ∧ (∀ F, ∑ F', γ (F, F') = P F) ∧ (∀ F', ∑ F, γ (F, F') = Q F')

/-- The weighted transportation (earth mover's) distance
"`W_{w,w'}(P,Q) = inf_{γ∈Γ(P,Q)} E_{(F,F')∼γ} ‖x_w(F) − x_{w'}(F')‖₁`". -/
def transportCost (w w' : Fin G.m → ℝ) (P Q : Finset (Fin G.m) → ℝ) : ℝ :=
  sInf {c : ℝ | ∃ γ, G.IsCoupling γ P Q ∧
    c = ∑ x, γ x * G.l1 (G.weightedOutput w x.1 - G.weightedOutput w' x.2)}

end Multigraph

/-- The witness graph used in all three reference proofs: two vertices `0, 1` joined by the
two distinct parallel edges `e₁ = 0` and `e₂ = 1`. -/
abbrev twoParallel : Multigraph := ⟨2, 2, fun _ => Sym2.mk (0, 1)⟩

namespace Multigraph

variable (G : Multigraph)

/-- "`G` is loopless": no edge has equal endpoints. -/
def IsLoopless : Prop := ∀ e, ¬ (G.ends e).IsDiag

/-- "`M ∈ ℳ(G)`": distinct edges of `M` have pairwise disjoint endpoints. -/
def IsMatching (M : Finset (Fin G.m)) : Prop :=
  ∀ e ∈ M, ∀ e' ∈ M, e ≠ e' → ∀ v, v ∈ G.ends e → v ∉ G.ends e'

end Multigraph

/-- A randomized matching algorithm: `A G w M` is the probability `μ_{G,w}(M)`. -/
abbrev RandAlgorithm : Type :=
  (G : Multigraph) → (Fin G.m → ℝ) → Finset (Fin G.m) → ℝ

/-- "`μ_{G,w}` is a distribution on `ℳ(G)` and `E_{M∼μ_{G,w}}[w(M)] ≥ α OPT(G,w)`" for every
loopless `G` and every `w ≥ 0`. -/
def IsExpApproxMatching (α : ℝ) (A : RandAlgorithm) : Prop :=
  ∀ (G : Multigraph), G.IsLoopless → ∀ w : Fin G.m → ℝ, G.Nonneg w →
    G.IsDistOn (A G w) G.IsMatching ∧
    ∀ M, G.IsMatching M → α * G.weight w M ≤ ∑ F, A G w F * G.weight w F

/-- The weight vector `wᵢ` with `wᵢ(eᵢ) = 1` and `wᵢ(e_{3−i}) = 0`. -/
def indicatorWeight (i : Fin twoParallel.m) : Fin twoParallel.m → ℝ :=
  fun e => if e = i then 1 else 0

/-- The witness graph is loopless. [LipschitzContinuousAlgorithmsFor, node_23] -/
theorem twoParallel_loopless : twoParallel.IsLoopless := by
  sorry

/-- Rubric 2: `pᵢ = Pr[eᵢ ∈ A(G,wᵢ)] ≥ α`. [LipschitzContinuousAlgorithmsFor, node_23] -/
theorem prob_ge_alpha (α : ℝ) (A : RandAlgorithm) (hA : IsExpApproxMatching α A)
    (i : Fin twoParallel.m) :
    α ≤ ∑ F, A twoParallel (indicatorWeight i) F * (if i ∈ F then 1 else 0) := by
  sorry

/-- Rubric 3: for every coupling `π` of `μ_{G,w₀}` and `μ_{G,w₁}`, the expected weighted
distance equals `p₀ + p₁` (pointwise `d = 𝟙_{e₀∈M₀} + 𝟙_{e₁∈M₁}`). [LipschitzContinuousAlgorithmsFor, node_23] -/
theorem coupling_cost_eq (α : ℝ) (A : RandAlgorithm) (hA : IsExpApproxMatching α A)
    (π : Finset (Fin twoParallel.m) × Finset (Fin twoParallel.m) → ℝ)
    (hπ : twoParallel.IsCoupling π (A twoParallel (indicatorWeight 0))
      (A twoParallel (indicatorWeight 1))) :
    ∑ x, π x * twoParallel.l1 (twoParallel.weightedOutput (indicatorWeight 0) x.1 -
        twoParallel.weightedOutput (indicatorWeight 1) x.2) =
      (∑ F, A twoParallel (indicatorWeight 0) F * (if (0 : Fin twoParallel.m) ∈ F then 1 else 0)) +
      (∑ F, A twoParallel (indicatorWeight 1) F * (if (1 : Fin twoParallel.m) ∈ F then 1 else 0)) := by
  sorry

/-- Rubric 3/4: `EM_w((μ_{G,w₀},w₀),(μ_{G,w₁},w₁)) ≥ 2α`. [LipschitzContinuousAlgorithmsFor, node_23] -/
theorem transport_ge_two_alpha (α : ℝ) (A : RandAlgorithm) (hA : IsExpApproxMatching α A) :
    2 * α ≤ twoParallel.transportCost (indicatorWeight 0) (indicatorWeight 1)
      (A twoParallel (indicatorWeight 0)) (A twoParallel (indicatorWeight 1)) := by
  sorry

/-- Main theorem: there is an absolute `c > 0` such that every randomized `α`-approximate
(in expectation) maximum-weight matching algorithm has `L(A) ≥ cα`. [LipschitzContinuousAlgorithmsFor, node_23] -/
theorem main :
    ∃ c : ℝ, 0 < c ∧ ∀ α : ℝ, 0 < α → α ≤ 1 →
      ∀ A : RandAlgorithm, IsExpApproxMatching α A → ∀ L : ℝ, L < c * α →
        ∃ (G : Multigraph) (w w' : Fin G.m → ℝ), G.IsLoopless ∧ G.Nonneg w ∧
          G.Nonneg w' ∧ w ≠ w' ∧
          L * G.l1 (w - w') < G.transportCost w w' (A G w) (A G w') := by
  sorry

end TCSChallenge.LipschitzContinuousAlgorithmsForGraphProblems.node_23
