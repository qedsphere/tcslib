/-! ## Shared lattice framework (identical in all files of this paper) -/

/-- The ambient Euclidean space `ℝⁿ`. -/
abbrev E (n : ℕ) : Type := EuclideanSpace ℝ (Fin n)

/-- Gram matrix `(⟨b i, b j⟩)_{i,j}` of a finite family of vectors. -/
def gram {n k : ℕ} (b : Fin k → E n) : Matrix (Fin k) (Fin k) ℝ :=
  Matrix.of fun i j => inner ℝ (b i) (b j)

/-- `b` is a lattice basis of `L`: `ℝ`-linearly independent and `L = ℤ b₁ + ⋯ + ℤ b_k`. -/
def IsLatticeBasis {n k : ℕ} (L : Submodule ℤ (E n)) (b : Fin k → E n) : Prop :=
  LinearIndependent ℝ b ∧ L = Submodule.span ℤ (Set.range b)

/-- "A lattice": a subgroup of `ℝⁿ` generated by linearly independent vectors. -/
def IsLattice {n : ℕ} (L : Submodule ℤ (E n)) : Prop :=
  ∃ k : ℕ, ∃ b : Fin k → E n, IsLatticeBasis L b

/-- `span(L)`, the real span of a lattice. -/
def spanR {n : ℕ} (L : Submodule ℤ (E n)) : Submodule ℝ (E n) :=
  Submodule.span ℝ (L : Set (E n))

/-- `rank(L) = dim span(L)`. -/
def latRank {n : ℕ} (L : Submodule ℤ (E n)) : ℕ :=
  Module.finrank ℝ (spanR L)

/-- "`det(L)` denotes its covolume in `span(L)`, with `det({0}) = 1`":
`√det(Gram(b))` for a (chosen) lattice basis `b`; `0` for non-lattices (never used). -/
def latDet {n : ℕ} (L : Submodule ℤ (E n)) : ℝ :=
  if h : ∃ k : ℕ, ∃ b : Fin k → E n, IsLatticeBasis L b then
    Real.sqrt (Matrix.det (gram (Classical.choose (Classical.choose_spec h))))
  else 0

/-- Normalized determinant `nd(L) = det(L)^{1/rank(L)}`. -/
def nd {n : ℕ} (L : Submodule ℤ (E n)) : ℝ :=
  latDet L ^ ((1 : ℝ) / (latRank L : ℝ))

/-- Orthogonal projection `Π_W : ℝⁿ → ℝⁿ` onto a subspace `W`. -/
def proj {n : ℕ} (W : Submodule ℝ (E n)) (v : E n) : E n :=
  haveI : CompleteSpace W := FiniteDimensional.complete ℝ W
  W.starProjection v

/-- The projected lattice `Π_W L` (the `ℤ`-span of the projected points). -/
def projLat {n : ℕ} (W : Submodule ℝ (E n)) (L : Submodule ℤ (E n)) : Submodule ℤ (E n) :=
  Submodule.span ℤ (proj W '' (L : Set (E n)))

/-- Euclidean quotient `L / M = Π_{span(M)^⊥} L`. -/
def orthQuot {n : ℕ} (L M : Submodule ℤ (E n)) : Submodule ℤ (E n) :=
  projLat (Submodule.orthogonal (spanR M)) L

/-- Dual lattice in `span(L)`: `L* = {y ∈ span(L) : ⟨y, x⟩ ∈ ℤ ∀ x ∈ L}`
(written as a `ℤ`-span of that set, which is already a subgroup). -/
def dualLat {n : ℕ} (L : Submodule ℤ (E n)) : Submodule ℤ (E n) :=
  Submodule.span ℤ {y : E n | y ∈ spanR L ∧ ∀ x ∈ L, ∃ z : ℤ, inner ℝ y x = (z : ℝ)}

/-- Scaled lattice `a • L`. -/
def scaleLat {n : ℕ} (a : ℝ) (L : Submodule ℤ (E n)) : Submodule ℤ (E n) :=
  Submodule.span ℤ ((fun v => a • v) '' (L : Set (E n)))

/-- "A sublattice `M ⊂ L` is primitive if `M = L ∩ span(M)`." -/
def IsPrimitive {n : ℕ} (M L : Submodule ℤ (E n)) : Prop :=
  M ≤ L ∧ ∀ v ∈ L, v ∈ spanR M → v ∈ M

/-- Covering radius `μ(L, H) = inf {s > 0 : L + sH ⊇ span(L)}`. -/
def covRad {n : ℕ} (L : Submodule ℤ (E n)) (H : Set (E n)) : ℝ :=
  sInf {s : ℝ | 0 < s ∧ ∀ x ∈ spanR L, ∃ v ∈ L, ∃ h ∈ H, x = v + s • h}

/-- `H` is a convex body in the subspace `F`: compact, convex, contained in `F`, with
nonempty interior relative to `F`. -/
def IsBodyIn {n : ℕ} (H : Set (E n)) (F : Submodule ℝ (E n)) : Prop :=
  H ⊆ (F : Set (E n)) ∧ Convex ℝ H ∧ IsCompact H ∧
    ∃ c ∈ H, ∃ r : ℝ, 0 < r ∧ ∀ y ∈ F, dist y c ≤ r → y ∈ H

/-- `x` lies in the interior of `H` relative to `F`. -/
def IsRelInterior {n : ℕ} (x : E n) (H : Set (E n)) (F : Submodule ℝ (E n)) : Prop :=
  ∃ r : ℝ, 0 < r ∧ ∀ y ∈ F, dist y x ≤ r → y ∈ H

/-- `d`-dimensional volume of `S ∩ W`, measured in `W` with its induced Euclidean structure. -/
def volIn {n : ℕ} (W : Submodule ℝ (E n)) (S : Set (E n)) : ℝ :=
  (MeasureTheory.volume {y : W | (y : E n) ∈ S}).toReal

/-- "A nonzero subspace `W ⊂ span(L)` is admissible for `L` if `Π_W L` is a lattice of
rank `dim W`." -/
def IsAdmissible {n : ℕ} (L : Submodule ℤ (E n)) (W : Submodule ℝ (E n)) : Prop :=
  W ≠ ⊥ ∧ W ≤ spanR L ∧
    ∃ b : Fin (Module.finrank ℝ W) → E n, IsLatticeBasis (projLat W L) b

/-- `R_W(L, H) = (det(Π_W L) / Vol_{dim W}(Π_W H))^{1/dim W}`. -/
def Rval {n : ℕ} (L : Submodule ℤ (E n)) (H : Set (E n)) (W : Submodule ℝ (E n)) : ℝ :=
  (latDet (projLat W L) / volIn W (proj W '' H)) ^ ((1 : ℝ) / (Module.finrank ℝ W : ℝ))

/-- The symmetric part `(H - x) ∩ (-H + x)` of `H` about `x`. -/
def symmPart {n : ℕ} (H : Set (E n)) (x : E n) : Set (E n) :=
  {z : E n | x + z ∈ H ∧ x - z ∈ H}

/-- Difference body `K - K`. -/
def diffBody {n : ℕ} (K : Set (E n)) : Set (E n) :=
  {z : E n | ∃ x ∈ K, ∃ y ∈ K, z = x - y}

/-- Polar body `Q° = {y : ⟨y, x⟩ ≤ 1 ∀ x ∈ Q}`. -/
def polar {n : ℕ} (Q : Set (E n)) : Set (E n) :=
  {y : E n | ∀ x ∈ Q, inner ℝ y x ≤ 1}

/-- `λ₁(M, Q) = min_{v ∈ M \ {0}} ‖v‖_Q` (Minkowski functional = Mathlib's `gauge`). -/
def lambda1 {n : ℕ} (M : Submodule ℤ (E n)) (Q : Set (E n)) : ℝ :=
  sInf {g : ℝ | ∃ v ∈ M, v ≠ 0 ∧ g = gauge Q v}

/-- "`L` is `t`-stable if `nd(N) ≥ 1/t` for every positive-rank sublattice `N` of either
`L` or `L*`." -/
def IsTStable {n : ℕ} (t : ℝ) (L : Submodule ℤ (E n)) : Prop :=
  IsLattice L ∧ ∀ N : Submodule ℤ (E n), (N ≤ L ∨ N ≤ dualLat L) → N ≠ ⊥ → 1 / t ≤ nd N

/-- Scale `a_j = nd(F_{j+1} / F_j)` of the `j`-th filtration quotient. -/
def filtScale {n s : ℕ} (F : Fin (s + 1) → Submodule ℤ (E n)) (j : Fin s) : ℝ :=
  nd (orthQuot (F j.succ) (F j.castSucc))

/-- A `t`-stable filtration `0 = F₀ ⊊ ⋯ ⊊ F_s = L` by primitive sublattices with strictly
increasing scales `a_j` and every `a_j⁻¹ (F_{j+1}/F_j)` `t`-stable. -/
def IsTStableFiltration {n : ℕ} (t : ℝ) (L : Submodule ℤ (E n)) (s : ℕ)
    (F : Fin (s + 1) → Submodule ℤ (E n)) : Prop :=
  F 0 = ⊥ ∧ F (Fin.last s) = L ∧ StrictMono F ∧ (∀ i, IsPrimitive (F i) L) ∧
    StrictMono (filtScale F) ∧
    ∀ j : Fin s, IsTStable t (scaleLat (filtScale F j)⁻¹ (orthQuot (F j.succ) (F j.castSucc)))

/-- Well-separated: `a_i ≤ a_{i+2} / 2`. -/
def IsWellSeparated {n s : ℕ} (F : Fin (s + 1) → Submodule ℤ (E n)) : Prop :=
  ∀ i j : Fin s, i.val + 2 = j.val → filtScale F i ≤ filtScale F j / 2

/-- The lattice `Λ = B ℤⁿ` generated by the columns of a rational matrix `B`. -/
def ratLattice {n : ℕ} (B : Matrix (Fin n) (Fin n) ℚ) : Submodule ℤ (E n) :=
  Submodule.span ℤ (Set.range fun j : Fin n => WithLp.toLp 2 (fun i : Fin n => (B i j : ℝ)))

/-! # A flatness-type bound `μ(Λ,K) · λ₁(Λ*, (K-K)°) ≤ C n log²(2n)`

For a full-rank lattice `Λ ⊂ ℝⁿ` and a convex body `K` (compact, convex, nonempty interior),
main theorem `covRad_mul_lambda1_le`. The lemma stubs are the splitting inequality (1),
the large-rank partial covering bound (13), the subspace duality estimate (12), and the
comparison of dual minima under quotient projection used in the dimension-halving step.
-/

/-- Splitting inequality (1): `Δ = Γ ∩ V` primitive, `0` in the relative interior of `S`,
`Q ⊆ S` symmetric with `Q ∩ V` a body in `V`:
`μ(Γ,S) ≤ μ(Δ, Q ∩ V) + μ(Π_{V^⊥}Γ, Π_{V^⊥}S)`. [TheSubspaceFlatnessConjecture, node_10] -/
theorem covRad_split {n : ℕ} (Γ Δ : Submodule ℤ (E n)) (S Q : Set (E n))
    (hΓ : IsLattice Γ) (hΔ : IsPrimitive Δ Γ) (hS : IsBodyIn S (spanR Γ))
    (h0 : IsRelInterior 0 S (spanR Γ)) (hQS : Q ⊆ S) (hQsymm : ∀ z ∈ Q, -z ∈ Q)
    (hQV : IsBodyIn (Q ∩ (spanR Δ : Set (E n))) (spanR Δ)) :
    covRad Γ S ≤ covRad Δ (Q ∩ (spanR Δ : Set (E n))) +
      covRad (orthQuot Γ Δ) (proj (Submodule.orthogonal (spanR Δ)) '' S) := by
  sorry

/-- Large-rank partial covering (13): for a lattice `Γ` of rank `m ≥ 1` and a body `S` in its
span there are a relative-interior point `x` (the barycenter in the paper) and a primitive
`Δ ⊂ Γ` of rank `≥ m/2` with
`μ(Δ, ((S-x) ∩ (x-S)) ∩ span Δ) · λ₁(Γ*, (S-S)°) ≤ C₀ m log²(2m)`. [TheSubspaceFlatnessConjecture, node_10] -/
theorem large_rank_partial_covering :
    ∃ C₀ : ℝ, 0 < C₀ ∧ ∀ (n : ℕ) (Γ : Submodule ℤ (E n)) (S : Set (E n)),
      IsLattice Γ → 1 ≤ latRank Γ → IsBodyIn S (spanR Γ) →
      ∃ (x : E n) (Δ : Submodule ℤ (E n)),
        IsRelInterior x S (spanR Γ) ∧ IsPrimitive Δ Γ ∧ latRank Γ ≤ 2 * latRank Δ ∧
        covRad Δ (symmPart S x ∩ (spanR Δ : Set (E n))) *
            lambda1 (dualLat Γ) (polar (diffBody S)) ≤
          C₀ * (latRank Γ : ℝ) * Real.log (2 * (latRank Γ : ℝ)) ^ 2 := by
  sorry

/-- Subspace duality estimate (12): for a full-rank `Γ`, a convex body `S` and an admissible
`W`, `R_W(Γ,S) · λ₁(Γ*, (S-S)°) ≤ C dim W`. [TheSubspaceFlatnessConjecture, node_10] -/
theorem Rval_mul_lambda1_le :
    ∃ C : ℝ, 0 < C ∧ ∀ (n : ℕ) (Γ : Submodule ℤ (E n)) (S : Set (E n))
      (W : Submodule ℝ (E n)),
      (∃ b : Fin n → E n, IsLatticeBasis Γ b) → Convex ℝ S → IsCompact S →
      (interior S).Nonempty → IsAdmissible Γ W →
      Rval Γ S W * lambda1 (dualLat Γ) (polar (diffBody S)) ≤
        C * (Module.finrank ℝ W : ℝ) := by
  sorry

/-- Dual minima only grow under quotient projection:
`λ₁((Γ/Δ)*, (Π S - Π S)°) ≥ λ₁(Γ*, (S-S)°)` with `Π = Π_{span(Δ)^⊥}`. [TheSubspaceFlatnessConjecture, node_10] -/
theorem lambda1_quot_ge {n : ℕ} (Γ Δ : Submodule ℤ (E n)) (S : Set (E n))
    (hΓ : IsLattice Γ) (hΔ : IsPrimitive Δ Γ) (hS : IsBodyIn S (spanR Γ))
    (hne : Δ ≠ Γ) :
    lambda1 (dualLat Γ) (polar (diffBody S)) ≤
      lambda1 (dualLat (orthQuot Γ Δ))
        (polar (diffBody (proj (Submodule.orthogonal (spanR Δ)) '' S))) := by
  sorry

/-- **Main theorem.** For `n ≥ 1`, a full-rank lattice `Λ ⊂ ℝⁿ` and a compact convex `K` with
nonempty interior, `μ(Λ,K) · λ₁(Λ*, (K-K)°) ≤ C n log²(2n)`. [TheSubspaceFlatnessConjecture, node_10] -/
theorem covRad_mul_lambda1_le :
    ∃ C : ℝ, 0 < C ∧ ∀ (n : ℕ), 1 ≤ n → ∀ (Λ : Submodule ℤ (E n)) (K : Set (E n)),
      (∃ b : Fin n → E n, IsLatticeBasis Λ b) → Convex ℝ K → IsCompact K →
      (interior K).Nonempty →
      covRad Λ K * lambda1 (dualLat Λ) (polar (diffBody K)) ≤
        C * (n : ℝ) * Real.log (2 * (n : ℝ)) ^ 2 := by
  sorry

end TCSChallenge.TheSubspaceFlatnessConjecture.node_10
