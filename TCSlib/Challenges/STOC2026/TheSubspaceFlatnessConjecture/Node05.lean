/-!
## Covering radius versus the Kannan–Lovász volume parameter

For a full-rank lattice `Λ ⊆ ℝⁿ` and a compact convex body `K ⊆ ℝⁿ` with nonempty interior
(no symmetry assumed), let `μ(Λ,K) = inf {r ≥ 0 : Λ + rK = ℝⁿ}` be the covering radius and

  `μ_KL(Λ,K) = sup_{F ≠ 0 admissible} (det Π_F(Λ) / Vol_{dim F}(Π_F K))^{1 / dim F}`,

where `F` is admissible if `Π_F(Λ)` is a full-rank lattice in `F`. The main theorem
`main_theorem` states that there is a universal `C` with

  `μ_KL(Λ,K) ≤ μ(Λ,K) ≤ C log₂³(2n) μ_KL(Λ,K)`.

All objects live in `ℝⁿ = EuclideanSpace ℝ (Fin n)`; lattices and bodies in a subspace `V`
are subsets of `ℝⁿ` contained in `V`, so the recursion on subspaces/quotients can be stated
uniformly (`covRadIn`, `muKLIn`).
-/

namespace TCSChallenge.TheSubspaceFlatnessConjecture.node_05

open MeasureTheory

/-- The ambient Euclidean space `ℝⁿ`. -/
abbrev Eucl (n : ℕ) : Type := EuclideanSpace ℝ (Fin n)

/-- "write `Π_F` for orthogonal projection onto `F`": the image `Π_V(S)`, described
proof-free by `y ∈ V` and `x - y ∈ Vᗮ` for some `x ∈ S`. -/
def projSet {n : ℕ} (V : Submodule ℝ (Eucl n)) (S : Set (Eucl n)) : Set (Eucl n) :=
  {y | y ∈ V ∧ ∃ x ∈ S, x - y ∈ Vᗮ}

/-- `b` is a basis of the lattice `L`, which is full rank in the subspace `V`:
`dim V` linearly independent vectors of `V` whose integer span is `L`. -/
def IsLatticeBasisIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (L : Set (Eucl n))
    (b : Fin (Module.finrank ℝ V) → Eucl n) : Prop :=
  (∀ i, b i ∈ V) ∧ LinearIndependent ℝ b ∧
    L = ((Submodule.span ℤ (Set.range b) : Submodule ℤ (Eucl n)) : Set (Eucl n))

/-- `L` is a full-rank lattice in the subspace `V`. -/
def IsLatticeIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (L : Set (Eucl n)) : Prop :=
  ∃ b : Fin (Module.finrank ℝ V) → Eucl n, IsLatticeBasisIn V L b

/-- `Λ ⊆ ℝⁿ` is a full-rank lattice. -/
def IsFullLattice {n : ℕ} (Λ : Set (Eucl n)) : Prop :=
  IsLatticeIn (⊤ : Submodule ℝ (Eucl n)) Λ

/-- Covolume of the lattice spanned by linearly independent `b`: `√ det (Gram matrix)`
("lattice determinants are covolumes in their linear spans"). -/
def gramDet {n k : ℕ} (b : Fin k → Eucl n) : ℝ :=
  Real.sqrt (Matrix.det (Matrix.of fun i j => inner ℝ (b i) (b j)))

/-- Euclidean `dim V`-dimensional volume of `S ∩ V`, computed with the Haar measure of the
inner-product space `↥V` normalized by orthonormal bases. -/
def volIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (S : Set (Eucl n)) : ℝ :=
  (volume {y : V | (y : Eucl n) ∈ S}).toReal

/-- `S` is a convex body in the subspace `V`: contained in `V`, compact, convex, with
nonempty interior relative to `V`. -/
def IsBodyIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (S : Set (Eucl n)) : Prop :=
  S ⊆ (V : Set (Eucl n)) ∧ IsCompact S ∧ Convex ℝ S ∧
    ∃ x ∈ S, ∃ ε > (0 : ℝ), ∀ y ∈ V, dist y x < ε → y ∈ S

/-- `K ⊆ ℝⁿ` is a compact convex body with nonempty interior. -/
def IsConvexBody {n : ℕ} (K : Set (Eucl n)) : Prop :=
  IsBodyIn (⊤ : Submodule ℝ (Eucl n)) K

/-- The origin lies in the interior of `S` relative to `V`. -/
def ZeroInRelInt {n : ℕ} (V : Submodule ℝ (Eucl n)) (S : Set (Eucl n)) : Prop :=
  ∃ ε > (0 : ℝ), ∀ y ∈ V, ‖y‖ < ε → y ∈ S

/-- Origin symmetry. -/
def IsSymm {n : ℕ} (S : Set (Eucl n)) : Prop :=
  ∀ x ∈ S, -x ∈ S

/-- `-A`. -/
def negSet {n : ℕ} (A : Set (Eucl n)) : Set (Eucl n) :=
  {x | -x ∈ A}

/-- `S + a`. -/
def translateSet {n : ℕ} (a : Eucl n) (S : Set (Eucl n)) : Set (Eucl n) :=
  {y | ∃ x ∈ S, y = x + a}

/-- `c · S` (used for `L / r = r⁻¹ · L`). -/
def scaleSet {n : ℕ} (c : ℝ) (S : Set (Eucl n)) : Set (Eucl n) :=
  {y | ∃ x ∈ S, y = c • x}

/-- "`μ(Λ,K) := inf {r ≥ 0 : Λ + rK = ℝⁿ}`", relative to a subspace `V`:
`inf {r ≥ 0 : ∀ x ∈ V, x ∈ L + rK}`. -/
def covRadIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (L K : Set (Eucl n)) : ℝ :=
  sInf {r : ℝ | 0 ≤ r ∧ ∀ x ∈ V, ∃ v ∈ L, ∃ k ∈ K, x = v + r • k}

/-- The covering radius `μ(Λ,K)` in `ℝⁿ`. -/
def coveringRadius {n : ℕ} (Λ K : Set (Eucl n)) : ℝ :=
  covRadIn (⊤ : Submodule ℝ (Eucl n)) Λ K

/-- The ratio `(det Π_W(L) / Vol_{dim W}(Π_W K))^{1/dim W}`, with `det Π_W(L)` computed from a
lattice basis `b` of `Π_W(L)` (the Gram determinant does not depend on the basis). -/
def klRatio {n : ℕ} (W : Submodule ℝ (Eucl n)) (b : Fin (Module.finrank ℝ W) → Eucl n)
    (K : Set (Eucl n)) : ℝ :=
  (gramDet b / volIn W (projSet W K)) ^ ((1 : ℝ) / (Module.finrank ℝ W : ℝ))

/-- Admissible witnesses inside `V`: a nonzero subspace `W ≤ V` together with a lattice basis
of `Π_W(L)` ("`F` admissible if `Π_F(Λ)` is a full-rank lattice in `F`"). -/
def KLWitness {n : ℕ} (V : Submodule ℝ (Eucl n)) (L : Set (Eucl n)) : Type :=
  {p : (W : Submodule ℝ (Eucl n)) × (Fin (Module.finrank ℝ W) → Eucl n) //
    p.1 ≤ V ∧ p.1 ≠ ⊥ ∧ IsLatticeBasisIn p.1 (projSet p.1 L) p.2}

/-- `μ_KL(L,K)` for a lattice `L` and a body `K` in the subspace `V`. -/
def muKLIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (L K : Set (Eucl n)) : ℝ :=
  ⨆ p : KLWitness V L, klRatio p.1.1 p.1.2 K

/-- `μ_KL(Λ,K)` in `ℝⁿ`. -/
def muKL {n : ℕ} (Λ K : Set (Eucl n)) : ℝ :=
  muKLIn (⊤ : Submodule ℝ (Eucl n)) Λ K

/-- "`ℓ_S := (E ‖g‖_S²)^{1/2}`", `g` standard Gaussian in `V`, `‖x‖_S` the gauge of `S`;
the Gaussian expectation is written with the explicit density on `↥V`. -/
def ellIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (S : Set (Eucl n)) : ℝ :=
  Real.sqrt (∫ y : V, gauge S (y : Eucl n) ^ 2 *
    ((2 * Real.pi) ^ (-(Module.finrank ℝ V : ℝ) / 2) * Real.exp (-(‖(y : Eucl n)‖ ^ 2) / 2)))

/-- "`S° := {y ∈ E : ⟨x,y⟩ ≤ 1 for all x ∈ S}`", polar inside `V`. -/
def polarIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (S : Set (Eucl n)) : Set (Eucl n) :=
  {y | y ∈ V ∧ ∀ x ∈ S, inner ℝ x y ≤ 1}

/-- "`L* := {y ∈ E : ⟨y,x⟩ ∈ ℤ for all x ∈ L}`", dual lattice inside `V`. -/
def dualIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (L : Set (Eucl n)) : Set (Eucl n) :=
  {y | y ∈ V ∧ ∀ x ∈ L, ∃ z : ℤ, inner ℝ y x = (z : ℝ)}

/-- "every nonzero sublattice `M` of `L` satisfies `nd(M) = det(M)^{1/rank M} ≥ t`";
a nonzero sublattice is the integer span of `k ≥ 1` linearly independent vectors of `L`. -/
def AllSublatticesND {n : ℕ} (L : Set (Eucl n)) (t : ℝ) : Prop :=
  ∀ (k : ℕ) (c : Fin k → Eucl n), 1 ≤ k → LinearIndependent ℝ c → (∀ i, c i ∈ L) →
    t ≤ gramDet c ^ ((1 : ℝ) / (k : ℝ))

/-- Image of `S ⊆ V` under a linear automorphism `T` of `V`. -/
def imageIn {n : ℕ} {V : Submodule ℝ (Eucl n)} (T : V ≃ₗ[ℝ] V) (S : Set (Eucl n)) :
    Set (Eucl n) :=
  {z | ∃ y : V, (y : Eucl n) ∈ S ∧ z = ((T y : V) : Eucl n)}

/-- "`A` has barycenter zero" (in `V`). -/
def BarycenterZeroIn {n : ℕ} (V : Submodule ℝ (Eucl n)) (A : Set (Eucl n)) : Prop :=
  (∫ y in {y : V | (y : Eucl n) ∈ A}, (y : Eucl n)) = 0

/-! ## Supplied analytic estimates (taken as known; stated as stubs) -/

/-- Supplied estimate 1 (geometric position): every origin-symmetric body `S` in an
`m`-dimensional space has a linear image with `ℓ_{TS} ℓ_{(TS)°} ≤ C m log(2m)`. [TheSubspaceFlatnessConjecture, node_05] -/
theorem fact_position :
    ∃ C : ℝ, 0 < C ∧ ∀ (N : ℕ) (V : Submodule ℝ (Eucl N)) (S : Set (Eucl N)),
      V ≠ ⊥ → IsBodyIn V S → IsSymm S →
      ∃ T : V ≃ₗ[ℝ] V,
        ellIn V (imageIn T S) * ellIn V (polarIn V (imageIn T S)) ≤
          C * (Module.finrank ℝ V : ℝ) * Real.logb 2 (2 * (Module.finrank ℝ V : ℝ)) := by
  sorry

/-- Supplied estimate 2: if every nonzero sublattice of `L/r` and of `(L/r)*` has
normalized determinant `≥ 1/2`, then `μ(L,S) ≤ C r log(2m) ℓ_S`. [TheSubspaceFlatnessConjecture, node_05] -/
theorem fact_covering_from_nd :
    ∃ C : ℝ, 0 < C ∧ ∀ (N : ℕ) (V : Submodule ℝ (Eucl N)) (L S : Set (Eucl N)) (r : ℝ),
      V ≠ ⊥ → IsLatticeIn V L → IsBodyIn V S → IsSymm S → 0 < r →
      AllSublatticesND (scaleSet r⁻¹ L) (1 / 2) →
      AllSublatticesND (dualIn V (scaleSet r⁻¹ L)) (1 / 2) →
      covRadIn V L S ≤
        C * r * Real.logb 2 (2 * (Module.finrank ℝ V : ℝ)) * ellIn V S := by
  sorry

/-- Supplied estimate 3: for a body `A` with barycenter zero, `Q = A ∩ (-A)`, and every nonzero
subspace `F ≤ V` of dimension `d`,
`Vol_d(Π_F A)^{1/d} ≤ C (m/d)^6 ℓ_{Q°} / d`. [TheSubspaceFlatnessConjecture, node_05] -/
theorem fact_projected_volume :
    ∃ C : ℝ, 0 < C ∧ ∀ (N : ℕ) (V : Submodule ℝ (Eucl N)) (A : Set (Eucl N)),
      V ≠ ⊥ → IsBodyIn V A → BarycenterZeroIn V A →
      ∀ F : Submodule ℝ (Eucl N), F ≤ V → F ≠ ⊥ →
        volIn F (projSet F A) ^ ((1 : ℝ) / (Module.finrank ℝ F : ℝ)) ≤
          C * ((Module.finrank ℝ V : ℝ) / (Module.finrank ℝ F : ℝ)) ^ 6 *
            ellIn V (polarIn V (A ∩ negSet A)) / (Module.finrank ℝ F : ℝ) := by
  sorry

/-! ## Rubric lemma stubs -/

/-- Compatibility / normalization: translating the body by a vector of `V` changes neither the
covering radius nor the Kannan–Lovász parameter. [TheSubspaceFlatnessConjecture, node_05] -/
theorem translate_invariance {n : ℕ} (V : Submodule ℝ (Eucl n)) (L K : Set (Eucl n))
    (a : Eucl n) (ha : a ∈ V) :
    covRadIn V L (translateSet a K) = covRadIn V L K ∧
      muKLIn V L (translateSet a K) = muKLIn V L K := by
  sorry

/-- Lower inequality, witness by witness: projecting a covering gives a covering of `Π_F`, and a
body covering with a lattice has volume at least the covolume. [TheSubspaceFlatnessConjecture, node_05] -/
theorem klRatio_le_coveringRadius {n : ℕ} (hn : 1 ≤ n) (Λ K : Set (Eucl n))
    (hΛ : IsFullLattice Λ) (hK : IsConvexBody K)
    (p : KLWitness (⊤ : Submodule ℝ (Eucl n)) Λ) :
    klRatio p.1.1 p.1.2 K ≤ coveringRadius Λ K := by
  sorry

/-- Gluing along a primitive subspace `U` (spanned by `L ∩ U`):
`μ(L,K) ≤ μ(L ∩ U, K ∩ U) + μ(Π_{U^⊥}L, Π_{U^⊥}K)`, quotient realized in `V ⊓ Uᗮ`.
The origin is assumed in the relative interior of `K` so that the section is a body. [TheSubspaceFlatnessConjecture, node_05] -/
theorem gluing {n : ℕ} (V U : Submodule ℝ (Eucl n)) (L K : Set (Eucl n))
    (hUV : U ≤ V) (hL : IsLatticeIn V L) (hK : IsBodyIn V K) (h0 : ZeroInRelInt V K)
    (hprim : Submodule.span ℝ (L ∩ (U : Set (Eucl n))) = U) :
    covRadIn V L K ≤
      covRadIn U (L ∩ (U : Set (Eucl n))) (K ∩ (U : Set (Eucl n))) +
        covRadIn (V ⊓ Uᗮ) (projSet (V ⊓ Uᗮ) L) (projSet (V ⊓ Uᗮ) K) := by
  sorry

/-- Primitivity makes the quotient discrete: the projection of `L` to `V ⊓ Uᗮ` is a full-rank
lattice there. [TheSubspaceFlatnessConjecture, node_05] -/
theorem primitive_quotient_isLattice {n : ℕ} (V U : Submodule ℝ (Eucl n)) (L : Set (Eucl n))
    (hUV : U ≤ V) (hL : IsLatticeIn V L)
    (hprim : Submodule.span ℝ (L ∩ (U : Set (Eucl n))) = U) :
    IsLatticeIn (V ⊓ Uᗮ) (projSet (V ⊓ Uᗮ) L) ∧ IsLatticeIn U (L ∩ (U : Set (Eucl n))) := by
  sorry

/-- Gaussian monotonicity for sections (conditioning + Jensen): `ℓ_{S ∩ U} ≤ ℓ_S`. [TheSubspaceFlatnessConjecture, node_05] -/
theorem ell_section_le {n : ℕ} (V U : Submodule ℝ (Eucl n)) (S : Set (Eucl n))
    (hUV : U ≤ V) (hS : IsBodyIn V S) (hsymm : IsSymm S) (h0 : ZeroInRelInt V S) :
    ellIn U (S ∩ (U : Set (Eucl n))) ≤ ellIn V S := by
  sorry

/-- Gaussian monotonicity for projections: `ℓ_{Π_W S} ≤ ℓ_S`. [TheSubspaceFlatnessConjecture, node_05] -/
theorem ell_proj_le {n : ℕ} (V W : Submodule ℝ (Eucl n)) (S : Set (Eucl n))
    (hWV : W ≤ V) (hS : IsBodyIn V S) (hsymm : IsSymm S) (h0 : ZeroInRelInt V S) :
    ellIn W (projSet W S) ≤ ellIn V S := by
  sorry

/-- Benchmark preservation: projecting to the quotient along a primitive subspace does not
increase the Kannan–Lovász parameter (nested orthogonal projections compose). [TheSubspaceFlatnessConjecture, node_05] -/
theorem muKL_quotient_le {n : ℕ} (V U : Submodule ℝ (Eucl n)) (L K : Set (Eucl n))
    (hUV : U ≤ V) (hL : IsLatticeIn V L) (hK : IsBodyIn V K)
    (hprim : Submodule.span ℝ (L ∩ (U : Set (Eucl n))) = U) :
    muKLIn (V ⊓ Uᗮ) (projSet (V ⊓ Uᗮ) L) (projSet (V ⊓ Uᗮ) K) ≤ muKLIn V L K := by
  sorry

/-- Key local step (first rank crossing of a scale-separated primitive filtration, combined with
the three supplied estimates): for a centered body there is a primitive subspace `U` with
`2 dim U ≥ dim V` whose section covering cost is at most `C log²(2m) μ_KL(L,K)`. [TheSubspaceFlatnessConjecture, node_05] -/
theorem large_section_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ (N : ℕ) (V : Submodule ℝ (Eucl N)) (L K : Set (Eucl N)),
      V ≠ ⊥ → IsLatticeIn V L → IsBodyIn V K → BarycenterZeroIn V K →
      ∃ U : Submodule ℝ (Eucl N), U ≤ V ∧ U ≠ ⊥ ∧
        Submodule.span ℝ (L ∩ (U : Set (Eucl N))) = U ∧
        Module.finrank ℝ V ≤ 2 * Module.finrank ℝ U ∧
        covRadIn U (L ∩ (U : Set (Eucl N))) (K ∩ (U : Set (Eucl N))) ≤
          C * Real.logb 2 (2 * (Module.finrank ℝ V : ℝ)) ^ 2 * muKLIn V L K := by
  sorry

/-- Base case: in dimension one the covering radius equals the interval-length volume bound. [TheSubspaceFlatnessConjecture, node_05] -/
theorem base_case_dim_one {n : ℕ} (V : Submodule ℝ (Eucl n)) (L K : Set (Eucl n))
    (hV : Module.finrank ℝ V = 1) (hL : IsLatticeIn V L) (hK : IsBodyIn V K) :
    covRadIn V L K = muKLIn V L K := by
  sorry

/-! ## Main theorem -/

/-- `μ_KL(Λ,K) ≤ μ(Λ,K) ≤ C log₂³(2n) μ_KL(Λ,K)` for every full-rank lattice `Λ ⊆ ℝⁿ` and every
compact convex body `K` with nonempty interior (no symmetry assumption), `C` universal. [TheSubspaceFlatnessConjecture, node_05] -/
theorem main_theorem :
    ∃ C : ℝ, 0 < C ∧ ∀ (n : ℕ) (Λ K : Set (Eucl n)), 1 ≤ n →
      IsFullLattice Λ → IsConvexBody K →
      muKL Λ K ≤ coveringRadius Λ K ∧
        coveringRadius Λ K ≤ C * Real.logb 2 (2 * (n : ℝ)) ^ 3 * muKL Λ K := by
  sorry

end TCSChallenge.TheSubspaceFlatnessConjecture.node_05
