/-!
## Uniform apex-minor exclusion in tree decompositions of K₀-minor-free graphs

Fix a graph `K₀`. There is a constant `c_apices` and an apex graph `K`, both depending only
on `K₀`, such that every finite graph `G` with no `K₀` minor has a tree decomposition
`(T, (B_t))` together with sets `A_t ⊆ B_t` with `|A_t| ≤ c_apices` and
`torso(t) − A_t` containing no `K` minor, for every node `t`.

The main theorem is `exists_apex_excluded_torso_decomposition`; the stronger variant
`exists_augmentedGrid_excluded_torso_decomposition` names the apex graph as an augmented
grid (a `k × k` grid plus one vertex adjacent to all grid vertices).
-/

namespace TCSChallenge.PlanarAndMinorFree.node_23

/-- "A minor model consists of pairwise vertex-disjoint connected branch sets, one for each
vertex of the modeled graph, with an edge between the appropriate branch sets for every
modeled edge." `HasMinor G H` means `G` contains `H` as a minor. -/
def HasMinor {V W : Type} (G : SimpleGraph V) (H : SimpleGraph W) : Prop :=
  ∃ f : W → Set V,
    (∀ w, (G.induce (f w)).Connected) ∧
    (∀ w w', w ≠ w' → Disjoint (f w) (f w')) ∧
    (∀ w w', H.Adj w w' → ∃ x ∈ f w, ∃ y ∈ f w', G.Adj x y)

/-- The complete graph `K₅`. -/
def K5 : SimpleGraph (Fin 5) := ⊤

/-- The complete bipartite graph `K₃,₃`. -/
def K33 : SimpleGraph (Fin 3 ⊕ Fin 3) := completeBipartiteGraph (Fin 3) (Fin 3)

/-- Planarity of a finite graph, via Wagner's theorem: no `K₅` minor and no `K₃,₃` minor. -/
def IsPlanar {V : Type} (G : SimpleGraph V) : Prop :=
  ¬ HasMinor G K5 ∧ ¬ HasMinor G K33

/-- "An apex graph is a graph that becomes planar after deleting at most one vertex." -/
def IsApex {V : Type} (G : SimpleGraph V) : Prop :=
  IsPlanar G ∨ ∃ v : V, IsPlanar (G.induce {x | x ≠ v})

/-- "A tree decomposition covers every vertex and edge of `G`, and the nodes whose bags
contain any fixed vertex form a connected subtree." Tree nodes are `Fin m`. -/
def IsTreeDecomp {V : Type} {m : ℕ} (G : SimpleGraph V) (T : SimpleGraph (Fin m))
    (B : Fin m → Finset V) : Prop :=
  T.IsTree ∧
  (∀ v : V, ∃ t, v ∈ B t) ∧
  (∀ u v : V, G.Adj u v → ∃ t, u ∈ B t ∧ v ∈ B t) ∧
  (∀ v : V, (T.induce {t | v ∈ B t}).Connected)

/-- "The torso `torso(t)` is obtained from `G[B_t]` by making `B_t ∩ B_u` a clique for each
neighbor `u` of `t` in `T`." Modelled as a graph on all of `V`; only its restriction to
`B t` (via `induce`) is used, so vertices outside the bag play no role. -/
def torso {V : Type} {m : ℕ} (G : SimpleGraph V) (T : SimpleGraph (Fin m))
    (B : Fin m → Finset V) (t : Fin m) : SimpleGraph V :=
  SimpleGraph.fromRel fun x y =>
    x ∈ B t ∧ y ∈ B t ∧ (G.Adj x y ∨ ∃ u, T.Adj t u ∧ x ∈ B u ∧ y ∈ B u)

/-- The `k × k` grid: `(a,b) ~ (c,d)` iff they differ by one in exactly one coordinate. -/
def grid (k : ℕ) : SimpleGraph (Fin k × Fin k) :=
  SimpleGraph.fromRel fun p q =>
    (p.1 = q.1 ∧ p.2.val + 1 = q.2.val) ∨ (p.2 = q.2 ∧ p.1.val + 1 = q.1.val)

/-- "Square grids augmented by one new vertex adjacent to every grid vertex"; the new vertex
is `none`. -/
def augmentedGrid (k : ℕ) : SimpleGraph (Option (Fin k × Fin k)) :=
  SimpleGraph.fromRel fun x y =>
    match x, y with
    | some p, some q => (grid k).Adj p q
    | none, some _ => True
    | _, _ => False

/-- The conclusion of the target theorem for a given bound `c` and excluded graph `K`. -/
def ExcludedTorsoDecomposition {WK : Type} (c : ℕ) (K : SimpleGraph WK)
    {V : Type} [DecidableEq V] (G : SimpleGraph V) : Prop :=
  ∃ (m : ℕ) (T : SimpleGraph (Fin m)) (B A : Fin m → Finset V),
    IsTreeDecomp G T B ∧
    ∀ t : Fin m, A t ⊆ B t ∧ (A t).card ≤ c ∧
      ¬ HasMinor ((torso G T B t).induce (↑(B t \ A t) : Set V)) K

