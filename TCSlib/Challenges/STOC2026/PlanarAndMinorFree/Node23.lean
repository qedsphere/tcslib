/-- Minor containment is transitive. [PlanarAndMinorFree, node_23] -/
theorem hasMinor_trans {U V W : Type} (G : SimpleGraph U) (H : SimpleGraph V)
    (J : SimpleGraph W) (hGH : HasMinor G H) (hHJ : HasMinor H J) : HasMinor G J := by
  sorry

/-- Every grid is planar. [PlanarAndMinorFree, node_23] -/
theorem grid_isPlanar (k : ℕ) : IsPlanar (grid k) := by
  sorry

/-- "Every member [of the augmented-grid family] is an apex graph": deleting the added
vertex leaves a grid. [PlanarAndMinorFree, node_23] -/
theorem augmentedGrid_isApex (k : ℕ) : IsApex (augmentedGrid k) := by
  sorry

/-- Augmented grids are nested under minors. [PlanarAndMinorFree, node_23] -/
theorem augmentedGrid_minor_mono (k l : ℕ) (hkl : k ≤ l) :
    HasMinor (augmentedGrid l) (augmentedGrid k) := by
  sorry

/-- Every (finite) apex graph is a minor of a sufficiently large augmented grid (planar
graphs are grid minors; the apex vertex is modelled by the added vertex). [PlanarAndMinorFree, node_23] -/
theorem apex_hasMinor_augmentedGrid (n : ℕ) (K : SimpleGraph (Fin n)) (hK : IsApex K) :
    ∃ k : ℕ, HasMinor (augmentedGrid k) K := by
  sorry

/-- Variant of the target with the apex graph made explicit: some augmented grid,
whose side length depends only on `K₀`, is excluded from every torso minus `A_t`. [PlanarAndMinorFree, node_23] -/
theorem exists_augmentedGrid_excluded_torso_decomposition
    (n₀ : ℕ) (K₀ : SimpleGraph (Fin n₀)) :
    ∃ c k : ℕ, ∀ (V : Type) [Fintype V] [DecidableEq V] (G : SimpleGraph V),
      ¬ HasMinor G K₀ → ExcludedTorsoDecomposition c (augmentedGrid k) G := by
  sorry

/-! ## Main theorem -/

/-- Fix `K₀`. There exist a constant `c_apices` and an apex graph `K` (both depending only
on `K₀`) such that every finite graph `G` with no `K₀` minor has a tree decomposition with
sets `A_t ⊆ B_t`, `|A_t| ≤ c_apices`, and `torso(t) − A_t` containing no `K` minor. [PlanarAndMinorFree, node_23] -/
theorem exists_apex_excluded_torso_decomposition (n₀ : ℕ) (K₀ : SimpleGraph (Fin n₀)) :
    ∃ (c k : ℕ) (K : SimpleGraph (Fin k)), IsApex K ∧
      ∀ (V : Type) [Fintype V] [DecidableEq V] (G : SimpleGraph V),
        ¬ HasMinor G K₀ → ExcludedTorsoDecomposition c K G := by
  sorry

