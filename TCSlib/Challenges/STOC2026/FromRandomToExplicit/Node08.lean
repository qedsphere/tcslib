/-!
## Subspace designs imply avoidance of local profiles above the threshold rate

Let `C : 𝔽_q^k → (𝔽_q^s)^n` be injective linear of rate `R = k/(sn)`, with coordinate maps
`π_i`, such that every subspace `E ≤ 𝔽_q^k` with `1 ≤ dim E ≤ b` satisfies
`∑_i dim(E ∩ ker π_i) ≤ (R + μ) n dim E`. For a local profile `𝒱 = (V_1, …, V_n)` of subspaces
of `𝔽_q^b`, with threshold `R_𝒱` defined by the potential inequalities over
`ℒ_Dist(𝔽_q^b)`, the main theorem `not_contains_of_rate_le` states that
`R ≤ R_𝒱 - μ - 1/n` implies `C` does not contain `𝒱`.
-/

namespace TCSChallenge.FromRandomToExplicit.node_08

open Module

/-- The `i`-th coordinate map `π_i : 𝔽_q^k → 𝔽_q^s` of the code `C`. -/
def coordMap {F : Type} [Field F] {k n s : ℕ}
    (C : (Fin k → F) →ₗ[F] (Fin n → Fin s → F)) (i : Fin n) :
    (Fin k → F) →ₗ[F] (Fin s → F) :=
  (LinearMap.proj i).comp C

/-- The rate `R = k / (s n)` as a real number. -/
def rate (k n s : ℕ) : ℝ := (k : ℝ) / ((s : ℝ) * (n : ℝ))

/-- "every subspace `E ≤ 𝔽_q^k` with `1 ≤ dim E ≤ b` satisfies
`∑_{i=1}^n dim(E ∩ ker π_i) ≤ (R+μ) n dim E`." -/
def IsSlackedDesign {F : Type} [Field F] {k n s : ℕ}
    (C : (Fin k → F) →ₗ[F] (Fin n → Fin s → F)) (b : ℕ) (μ : ℝ) : Prop :=
  ∀ E : Submodule F (Fin k → F), 1 ≤ finrank F E → finrank F E ≤ b →
    ((∑ i : Fin n, finrank F ↥(E ⊓ LinearMap.ker (coordMap C i)) : ℕ) : ℝ)
      ≤ (rate k n s + μ) * (n : ℝ) * (finrank F E : ℝ)

/-- "`C` contains `𝒱` if there exist pairwise distinct messages `f_1, …, f_b ∈ 𝔽_q^k`, not all
zero, such that `(π_i(f_1)[j], …, π_i(f_b)[j]) ∈ V_i` for every `i ∈ [n]` and `j ∈ [s]`." -/
def Contains {F : Type} [Field F] {k n s b : ℕ}
    (C : (Fin k → F) →ₗ[F] (Fin n → Fin s → F))
    (V : Fin n → Submodule F (Fin b → F)) : Prop :=
  ∃ f : Fin b → (Fin k → F), Function.Injective f ∧ (∃ a, f a ≠ 0) ∧
    ∀ (i : Fin n) (j : Fin s), (fun a : Fin b => C (f a) i j) ∈ V i

/-- `ℒ_Dist(𝔽_q^b)`: "nonzero subspaces `U ≤ 𝔽_q^b` such that for every distinct
`a, a' ∈ [b]` there is some `u ∈ U` with `u_a ≠ u_{a'}`." -/
def LDist {F : Type} [Field F] {b : ℕ} (U : Submodule F (Fin b → F)) : Prop :=
  U ≠ ⊥ ∧ ∀ a a' : Fin b, a ≠ a' → ∃ u ∈ U, u a ≠ u a'

/-- The potential inequality for the pair `W ⊊ U` at rate `r`:
`∑_i (dim(V_i ∩ U) - dim(V_i ∩ W)) ≤ (1 - r) n (dim U - dim W)` (real arithmetic). -/
def PotentialIneq {F : Type} [Field F] {n b : ℕ}
    (V : Fin n → Submodule F (Fin b → F)) (U W : Submodule F (Fin b → F)) (r : ℝ) : Prop :=
  (∑ i : Fin n, ((finrank F ↥(V i ⊓ U) : ℝ) - (finrank F ↥(V i ⊓ W) : ℝ)))
    ≤ (1 - r) * (n : ℝ) * ((finrank F U : ℝ) - (finrank F W : ℝ))

/-- The threshold property at rate `r`: "for every `U ∈ ℒ_Dist(𝔽_q^b)` there exists
`W ⊊ U` such that [the potential inequality holds]". -/
def ThresholdProp {F : Type} [Field F] {n b : ℕ}
    (V : Fin n → Submodule F (Fin b → F)) (r : ℝ) : Prop :=
  ∀ U : Submodule F (Fin b → F), LDist U → ∃ W : Submodule F (Fin b → F), W < U ∧
    PotentialIneq V U W r

/-- `R_𝒱 := max { r ∈ [0,1] : ThresholdProp 𝒱 r }`, written as a supremum (attained). -/
def thresholdRate {F : Type} [Field F] {n b : ℕ}
    (V : Fin n → Submodule F (Fin b → F)) : ℝ :=
  sSup {r : ℝ | 0 ≤ r ∧ r ≤ 1 ∧ ThresholdProp V r}

/-- The witness subspace `U ≤ 𝔽_q^b`: the image of `x ↦ (⟨f_1, x⟩, …, ⟨f_b, x⟩)`, i.e. the range
of the `b × k` matrix whose rows are `f_1, …, f_b`. Its dimension equals `dim span(f_1,…,f_b)`;
it plays the role of the paper's `colspan(M)`. -/
def witnessSubspace {F : Type} [Field F] {k b : ℕ} (f : Fin b → (Fin k → F)) :
    Submodule F (Fin b → F) :=
  LinearMap.range (Matrix.of (fun (a : Fin b) (x : Fin k) => f a x)).mulVecLin

/-- The threshold property is inherited by every smaller rate; in particular it holds at
every `r ≤ R_𝒱` (the supremum is attained). [FromRandomToExplicit, node_08] -/
theorem thresholdProp_of_le_thresholdRate {F : Type} [Field F] [Fintype F] {n b : ℕ}
    (hn : 1 ≤ n) (V : Fin n → Submodule F (Fin b → F)) (r : ℝ)
    (hr : r ≤ thresholdRate V) : ThresholdProp V r := by
  sorry

/-- Rubric 1 (witness-to-subspace reduction). For a bad tuple `f`, the subspace
`U = witnessSubspace f` lies in `ℒ_Dist` and has `dim U = dim span(f_1, …, f_b)`. [FromRandomToExplicit, node_08] -/
theorem witness_subspace_mem_LDist {F : Type} [Field F] [Fintype F] {k b : ℕ}
    (f : Fin b → (Fin k → F)) (hinj : Function.Injective f) (hnz : ∃ a, f a ≠ 0) :
    LDist (witnessSubspace f) ∧
      finrank F ↥(witnessSubspace f)
        = finrank F ↥(Submodule.span F (Set.range f)) := by
  sorry

/-- Rubrics 2–4 (extraction, local annihilation, rank calculation). If `f` witnesses that `C`
contains `𝒱`, `U` is the witness subspace of rubric 1 and `W < U`, then there is a message
subspace `N' ≤ span(f)` with `dim N' = dim U - dim W` such that for every `i`,
`dim(N' ∩ ker π_i) ≥ (dim U - dim W) - (dim(V_i ∩ U) - dim(V_i ∩ W))`. [FromRandomToExplicit, node_08] -/
theorem extraction {F : Type} [Field F] [Fintype F] {k n s b : ℕ}
    (C : (Fin k → F) →ₗ[F] (Fin n → Fin s → F))
    (V : Fin n → Submodule F (Fin b → F))
    (f : Fin b → (Fin k → F))
    (hloc : ∀ (i : Fin n) (j : Fin s), (fun a : Fin b => C (f a) i j) ∈ V i)
    (U W : Submodule F (Fin b → F))
    (hU : U = witnessSubspace f)
    (hWU : W < U) :
    ∃ N' : Submodule F (Fin k → F), N' ≤ Submodule.span F (Set.range f) ∧
      finrank F N' + finrank F W = finrank F U ∧
      ∀ i : Fin n,
        ((finrank F U : ℤ) - (finrank F W : ℤ))
            - ((finrank F ↥(V i ⊓ U) : ℤ) - (finrank F ↥(V i ⊓ W) : ℤ))
          ≤ (finrank F ↥(N' ⊓ LinearMap.ker (coordMap C i)) : ℤ) := by
  sorry

/-- **Main theorem.** If `C` is injective of rate `R = k/(sn)` and is a `(b, μ)`-slacked
subspace design, then `R ≤ R_𝒱 - μ - 1/n` implies that `C` does not contain `𝒱`. [FromRandomToExplicit, node_08] -/
theorem not_contains_of_rate_le {F : Type} [Field F] [Fintype F] {k n s b : ℕ}
    (hn : 1 ≤ n) (hs : 1 ≤ s) (μ : ℝ)
    (C : (Fin k → F) →ₗ[F] (Fin n → Fin s → F)) (hC : Function.Injective C)
    (hdesign : IsSlackedDesign C b μ)
    (V : Fin n → Submodule F (Fin b → F))
    (hrate : rate k n s ≤ thresholdRate V - μ - 1 / (n : ℝ)) :
    ¬ Contains C V := by
  sorry

end TCSChallenge.FromRandomToExplicit.node_08
