/-!
## Random linear maps are subspace designs with high probability

Let `E : 𝔽_q^k → (𝔽_q^s)^n` be a uniformly random linear map, `R = k/(sn)`, and
`H_i = ker(π_i ∘ E)`. `E` is `(d, A)` subspace designable if every `d`-dimensional
`U ≤ 𝔽_q^k` has `∑_i dim(H_i ∩ U) ≤ A`. The main theorem `prob_subspace_designable` states
that for `d < s`, `k ≤ sn`, `ε ∈ (0,1)`,
`Pr[E is (d, (R+ε) d n) subspace designable] ≥ 1 - q^{-ε s d n + 3 d² n + 3 n}`.
-/

namespace TCSChallenge.FromRandomToExplicit.node_10

open Module

/-- The encoder is given by its `n` blocks: `M i : 𝔽_q^{k×s}`, with `π_i(E x) = (M i)ᵀ x`. -/
abbrev Encoder (F : Type) (k n s : ℕ) : Type := Fin n → Fin k → Fin s → F

/-- `H_i = ker(π_i ∘ E) = ker((M i)ᵀ)`. -/
def kerBlock {F : Type} [Field F] {k n s : ℕ} (M : Encoder F k n s) (i : Fin n) :
    Submodule F (Fin k → F) :=
  LinearMap.ker (Matrix.of (M i)).transpose.mulVecLin

/-- "`E` is `(d, A)` subspace designable if every `d`-dimensional subspace `U ⊆ 𝔽_q^k`
satisfies `∑_{i=1}^n dim(H_i ∩ U) ≤ A`." -/
def SubspaceDesignable {F : Type} [Field F] {k n s : ℕ} (M : Encoder F k n s)
    (d : ℕ) (A : ℝ) : Prop :=
  ∀ U : Submodule F (Fin k → F), finrank F U = d →
    ((∑ i : Fin n, finrank F ↥(kerBlock M i ⊓ U) : ℕ) : ℝ) ≤ A

/-- `R = k / (s n)`. -/
def rate (k n s : ℕ) : ℝ := (k : ℝ) / ((s : ℝ) * (n : ℝ))

/-- Rubric 1 (rank reformulation). For a full-column-rank `B ∈ 𝔽_q^{k×d}` with image `U`,
`dim(ker(Mᵀ) ∩ U) = d - rank(Mᵀ B)`. [FromRandomToExplicit, node_10] -/
theorem finrank_ker_inf_range_eq {F : Type} [Field F] [Fintype F] {k s d : ℕ}
    (M : Matrix (Fin k) (Fin s) F) (B : Matrix (Fin k) (Fin d) F) (hB : B.rank = d) :
    finrank F ↥(LinearMap.ker M.transpose.mulVecLin ⊓ LinearMap.range B.mulVecLin)
      + (M.transpose * B).rank = d := by
  sorry

/-- Rubric 2a (uniformity). For full-column-rank `B`, the map `M ↦ Mᵀ B` has fibres of
equal size, so `Mᵀ B` is uniform on `𝔽_q^{s×d}` when `M` is uniform. [FromRandomToExplicit, node_10] -/
theorem card_fiber_transpose_mul {F : Type} [Field F] [Fintype F] {k s d : ℕ}
    (B : Matrix (Fin k) (Fin d) F) (hB : B.rank = d) (P : Fin s → Fin d → F) :
    Fintype.card {M : Fin k → Fin s → F //
        (Matrix.of M).transpose * B = Matrix.of P} * Fintype.card F ^ (s * d)
      = Fintype.card F ^ (k * s) := by
  sorry

/-- Rubric 2b (rank count). The number of rank-`a` matrices in `𝔽_q^{s×d}` is at most
`C(d,a) q^{s a + a (d - a)}`. [FromRandomToExplicit, node_10] -/
theorem card_rank_eq_le {F : Type} [Field F] [Fintype F] (s d a : ℕ) (ha : a ≤ d) :
    Fintype.card {P : Fin s → Fin d → F // (Matrix.of P).rank = a}
      ≤ Nat.choose d a * Fintype.card F ^ (s * a + a * (d - a)) := by
  sorry

/-- Rubric 3 (fixed-subspace failure bound). For `c = R + ε < 1`, `d < s`, and a fixed
full-column-rank `B`, the fraction of encoders with `∑_i rank(M_iᵀ B) < (1 - c) d n` is at most
`q^{-c s d n + 3 d² n + 3 n}`. [FromRandomToExplicit, node_10] -/
theorem fixed_subspace_failure {F : Type} [Field F] [Fintype F] {k n s d : ℕ}
    (hd : 1 ≤ d) (hds : d < s) (c : ℝ) (hc0 : 0 ≤ c) (hc1 : c < 1)
    (B : Matrix (Fin k) (Fin d) F) (hB : B.rank = d) :
    ((Finset.univ.filter (fun M : Encoder F k n s =>
        ((∑ i : Fin n, ((Matrix.of (M i)).transpose * B).rank : ℕ) : ℝ)
          < (1 - c) * (d : ℝ) * (n : ℝ))).card : ℝ)
      / (Fintype.card (Encoder F k n s) : ℝ)
      ≤ (Fintype.card F : ℝ) ^
          (-(c * (s : ℝ) * (d : ℝ) * (n : ℝ)) + 3 * (d : ℝ) ^ 2 * (n : ℝ) + 3 * (n : ℝ)) := by
  sorry

/-- **Main theorem.** With `q = |F|`, `k ≤ s n`, `d < s`, `ε ∈ (0,1)` and `R = k/(sn)`,
`Pr_E[E is (d, (R+ε) d n) subspace designable] ≥ 1 - q^{-ε s d n + 3 d² n + 3 n}`. [FromRandomToExplicit, node_10] -/
theorem prob_subspace_designable {F : Type} [Field F] [Fintype F] {k n s d : ℕ}
    (hk : 1 ≤ k) (hn : 1 ≤ n) (hs : 1 ≤ s) (hd : 1 ≤ d)
    (hks : k ≤ s * n) (hds : d < s) (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1) :
    1 - (Fintype.card F : ℝ) ^
          (-(ε * (s : ℝ) * (d : ℝ) * (n : ℝ)) + 3 * (d : ℝ) ^ 2 * (n : ℝ) + 3 * (n : ℝ))
      ≤ ((Finset.univ.filter (fun M : Encoder F k n s =>
            SubspaceDesignable M d ((rate k n s + ε) * (d : ℝ) * (n : ℝ)))).card : ℝ)
        / (Fintype.card (Encoder F k n s) : ℝ) := by
  sorry

end TCSChallenge.FromRandomToExplicit.node_10
