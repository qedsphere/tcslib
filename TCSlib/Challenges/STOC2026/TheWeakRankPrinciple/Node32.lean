/-!
## Reversible naming of the zeros of a concatenated low-degree code

Fix a prime `p`, a finite field `F` (playing `F_q`, `q = p^r`) with an `F_p`-algebra
structure, and parameters `n, h` with `10·n·h ≤ q`. A message `X ∈ F_p^s` is placed on the
grid `H^n ⊆ F^n` via an injection `ι : [s] → [h]^n` and interpolated (Lagrange, individual
degree `< h`) to `X̃ : F^n → F`. The codeword is indexed by `(v, u) ∈ F^n × F` and
`Enc(X)_{(v,u)} = L(X̃(v) · u)` for a nonzero `F_p`-linear functional `L : F → F_p`,
so `ℓ = q^{n+1}`.

For a zero coordinate `(v,u)` of `Enc(X)` with `X_{i₁} ≠ 0` (anchor `a = H(ι i₁)`):
* inner zero (`X̃(v) ≠ 0`): label = index of `v` · (q/p) + rank of `u` in the ordered
  kernel list of `u ↦ L(X̃(v) u)` (length `q/p`);
* outer zero (`X̃(v) = 0`, so `v ≠ a`): write `v = a + t·d` with `d` the canonical
  direction of `v - a` (first nonzero coordinate `1`); label =
  `q^{n+1}/p + ((index of d)·⌊q/10⌋ + rank of t among roots on the line)·q + index of u`.

`ψ̃` parses the label and re-enumerates the same lists. The main theorem
`zero_labels_reversible` states, for every `X`, `i₁` with `X_{i₁} ≠ 0` and every zero
coordinate `i`, that `φ̃(X,i₁,i) < ⌊0.9ℓ⌋` and `ψ̃(X,i₁,φ̃(X,i₁,i)) = i`.
-/

namespace TCSChallenge.TheWeakRankPrinciple.node_32

/-- Data of the concatenated code: grid points `H : [h] → F`, the message placement
`ι : [s] → [h]^n`, and the inner functional `L : F → F_p` ("balanced linear inner
encoding" `u ↦ IP(y, u) = L(y·u)`). No proof fields; axioms are in `CodeData.Valid`. -/
structure CodeData (p : ℕ) (F : Type) [Field F] [Algebra (ZMod p) F] (n h s : ℕ) where
  H : Fin h → F
  ι : Fin s → Fin n → Fin h
  L : F →ₗ[ZMod p] ZMod p

variable {p : ℕ} [Fact p.Prime] {F : Type} [Field F] [Fintype F] [Algebra (ZMod p) F]
  {n h s : ℕ}

/-- Parameter regime: injective grid and placement, nonzero inner functional, `n, h ≥ 1`,
"`nh < q/10`" in the form `10·n·h ≤ q`, and `q = p^r` with `r ≥ 1`. -/
def CodeData.Valid (C : CodeData p F n h s) : Prop :=
  Function.Injective C.H ∧ Function.Injective C.ι ∧ C.L ≠ 0 ∧ 1 ≤ n ∧ 1 ≤ h ∧
    10 * n * h ≤ Fintype.card F ∧ ∃ r : ℕ, 1 ≤ r ∧ Fintype.card F = p ^ r

/-- Lagrange basis polynomial on the grid `H`: `δ_b(t) = ∏_{b' ≠ b} (t - H b')/(H b - H b')`. -/
def CodeData.lag (C : CodeData p F n h s) (b : Fin h) (t : F) : F :=
  ∏ b' ∈ Finset.univ.filter (fun b' => b' ≠ b), (t - C.H b') / (C.H b - C.H b')

/-- "interpolate the padded message to a polynomial `X̃` of individual degree less than `h`":
`X̃(v) = ∑_j X_j · ∏_k δ_{ι(j)_k}(v_k)` (zero padding on unused grid points). -/
def CodeData.interp (C : CodeData p F n h s) (X : Fin s → ZMod p) (v : Fin n → F) : F :=
  ∑ j : Fin s, algebraMap (ZMod p) F (X j) * ∏ k : Fin n, C.lag (C.ι j k) (v k)

/-- Coordinates of the codeword: `(v, u) ∈ F^n × F`; `ℓ = q^{n+1}`. -/
abbrev Coord (K : Type) (m : ℕ) := (Fin m → K) × K

/-- "`Enc(X)_{(v,u)} := IP(X̃(v), u)`" with `IP(y,u) = L(y·u)`. -/
def CodeData.enc (C : CodeData p F n h s) (X : Fin s → ZMod p) (c : Coord F n) : ZMod p :=
  C.L (C.interp X c.1 * c.2)

/-- Block length `ℓ = q^{n+1}`. -/
def blockLen (K : Type) [Fintype K] (m : ℕ) : ℕ := Fintype.card K ^ (m + 1)

/-- Anchor point `a = H(ι(i₁)) ∈ F^n`. -/
def CodeData.anchor (C : CodeData p F n h s) (i₁ : Fin s) : Fin n → F :=
  fun k => C.H (C.ι i₁ k)

/-- Fixed canonical order on `F` (input independent). -/
def fieldList (K : Type) [Fintype K] : List K := Finset.univ.toList

/-- Fixed canonical order on `F^n`. -/
def pointList (K : Type) [Fintype K] (m : ℕ) : List (Fin m → K) := Finset.univ.toList

/-- Canonical projective representative: first nonzero coordinate equal to `1`. -/
def IsCanonDir (d : Fin n → F) : Prop :=
  ∃ k : Fin n, d k = 1 ∧ ∀ j : Fin n, j < k → d j = 0

/-- Fixed canonical order on canonical directions (there are `1 + q + ⋯ + q^{n-1}`). -/
def dirList (K : Type) [Field K] [Fintype K] (m : ℕ) : List (Fin m → K) :=
  (Finset.univ.filter (fun d : Fin m → K => IsCanonDir d)).toList

/-- First nonzero coordinate of `w`, if any. -/
def firstNZ (w : Fin n → F) : Option (Fin n) :=
  (List.ofFn (fun j : Fin n => j)).find? (fun j => decide (w j ≠ 0))

/-- "Canonically represent the direction of `v - a` by scaling its first nonzero
coordinate to `1`." -/
def canonDir (w : Fin n → F) : Fin n → F :=
  match firstNZ w with
  | some k => (w k)⁻¹ • w
  | none => 0

/-- Line parameter `t` with `w = t • canonDir w` (the first nonzero coordinate of `w`). -/
def lineParam (w : Fin n → F) : F :=
  match firstNZ w with
  | some k => w k
  | none => 0

/-- Ordered zero set of the inner functional `u ↦ L(y·u)`. -/
def CodeData.kerList (C : CodeData p F n h s) (y : F) : List F :=
  (fieldList F).filter (fun u => decide (C.L (y * u) = 0))

/-- Ordered roots of `t ↦ X̃(a + t·d)` on the line through the anchor in direction `d`. -/
def CodeData.rootList (C : CodeData p F n h s) (X : Fin s → ZMod p) (i₁ : Fin s)
    (d : Fin n → F) : List F :=
  (fieldList F).filter (fun t => decide (C.interp X (C.anchor i₁ + t • d) = 0))

/-- Size of the inner-zero label block: `q^{n+1}/p` (exact since `q = p^r`). -/
def innerBlock (K : Type) [Fintype K] (p' m : ℕ) : ℕ := Fintype.card K ^ (m + 1) / p'

/-- Root-rank radix `⌊q/10⌋` (≥ `n(h-1)+1` under `10nh ≤ q`). -/
def rootRadix (K : Type) [Fintype K] : ℕ := Fintype.card K / 10

/-- The compression function `φ̃(X, i₁, (v,u))`. -/
def CodeData.phi (C : CodeData p F n h s) (X : Fin s → ZMod p) (i₁ : Fin s)
    (c : Coord F n) : ℕ :=
  let q := Fintype.card F
  let v := c.1
  let u := c.2
  if C.interp X v ≠ 0 then
    (pointList F n).idxOf v * (q / p) + (C.kerList (C.interp X v)).idxOf u
  else
    let w := v - C.anchor i₁
    let d := canonDir w
    let t := lineParam w
    innerBlock F p n +
      ((dirList F n).idxOf d * rootRadix F + (C.rootList X i₁ d).idxOf t) * q +
      (fieldList F).idxOf u

/-- The decoding function `ψ̃(X, i₁, c)`: parse the tag and re-enumerate. -/
def CodeData.psi (C : CodeData p F n h s) (X : Fin s → ZMod p) (i₁ : Fin s)
    (c : ℕ) : Coord F n :=
  let q := Fintype.card F
  if c < innerBlock F p n then
    let v := (pointList F n).getD (c / (q / p)) 0
    (v, (C.kerList (C.interp X v)).getD (c % (q / p)) 0)
  else
    let c' := c - innerBlock F p n
    let u := (fieldList F).getD (c' % q) 0
    let m := c' / q
    let d := (dirList F n).getD (m / rootRadix F) 0
    let t := (C.rootList X i₁ d).getD (m % rootRadix F) 0
    (C.anchor i₁ + t • d, u)

/-! ## Lemma stubs -/

/-- Parameter regime: for `s` large there are `n, h, r` with `h^n ≥ s`, `10nh ≤ q = p^r`,
`q ≤ log² s` and `ℓ = q^{n+1} ≤ s^C` (polynomial block length). [TheWeakRankPrinciple, node_32] -/
theorem parameter_regime (p' : ℕ) [Fact p'.Prime] :
    ∃ Cexp s₀ : ℕ, ∀ s' : ℕ, s₀ ≤ s' →
      ∃ n' h' r : ℕ, 1 ≤ n' ∧ 1 ≤ h' ∧ 1 ≤ r ∧ s' ≤ h' ^ n' ∧ 10 * n' * h' ≤ p' ^ r ∧
        p' ^ r ≤ (Nat.log 2 s') ^ 2 ∧ (p' ^ r) ^ (n' + 1) ≤ s' ^ Cexp := by
  sorry

/-- `F_p`-linearity: `Enc(aX + bY) = a Enc(X) + b Enc(Y)`. [TheWeakRankPrinciple, node_32] -/
theorem enc_linear (C : CodeData p F n h s) (a b : ZMod p) (X Y : Fin s → ZMod p) :
    C.enc (a • X + b • Y) = a • C.enc X + b • C.enc Y := by
  sorry

/-- Interpolation reproduces the message at the anchor: `X̃(H(ι i₁)) = X_{i₁}`. [TheWeakRankPrinciple, node_32] -/
theorem interp_anchor (C : CodeData p F n h s) (hC : C.Valid) (X : Fin s → ZMod p)
    (i₁ : Fin s) : C.interp X (C.anchor i₁) = algebraMap (ZMod p) F (X i₁) := by
  sorry

/-- Balanced inner code: for `y ≠ 0` the kernel of `u ↦ L(y·u)` has exactly `q/p` elements. [TheWeakRankPrinciple, node_32] -/
theorem kerList_length (C : CodeData p F n h s) (hC : C.Valid) (y : F) (hy : y ≠ 0) :
    (C.kerList y).length = Fintype.card F / p := by
  sorry

/-- Line restriction: if `X̃(a) ≠ 0`, the restriction to any line through `a` is a nonzero
univariate polynomial of degree `≤ n(h-1)`, hence has at most `n(h-1)` roots. [TheWeakRankPrinciple, node_32] -/
theorem rootList_length_le (C : CodeData p F n h s) (hC : C.Valid) (X : Fin s → ZMod p)
    (i₁ : Fin s) (hX : C.interp X (C.anchor i₁) ≠ 0) (d : Fin n → F) :
    (C.rootList X i₁ d).length ≤ n * (h - 1) := by
  sorry

/-- Direction count: `1 + q + ⋯ + q^{n-1} ≤ 2 q^{n-1}`. [TheWeakRankPrinciple, node_32] -/
theorem dirList_length_le (hn : 1 ≤ n) (hq : 2 ≤ Fintype.card F) :
    (dirList F n).length ≤ 2 * Fintype.card F ^ (n - 1) := by
  sorry

/-- Canonicalization is reversible: for `w ≠ 0`, `canonDir w` is a canonical direction and
`w = lineParam w • canonDir w` with `lineParam w ≠ 0`. [TheWeakRankPrinciple, node_32] -/
theorem canonDir_spec (w : Fin n → F) (hw : w ≠ 0) :
    IsCanonDir (canonDir w) ∧ lineParam w ≠ 0 ∧ lineParam w • canonDir w = w := by
  sorry

/-- Label-space arithmetic: `q^{n+1}/p + 2q^{n-1}·⌊q/10⌋·q ≤ ⌊0.9 q^{n+1}⌋`. [TheWeakRankPrinciple, node_32] -/
theorem label_space_bound (hn : 1 ≤ n) (hq10 : 10 ≤ Fintype.card F) :
    innerBlock F p n + 2 * Fintype.card F ^ (n - 1) * rootRadix F * Fintype.card F
      ≤ 9 * blockLen F n / 10 := by
  sorry

/-- Inner-zero case: label lies in the first block and decodes correctly. [TheWeakRankPrinciple, node_32] -/
theorem inner_case (C : CodeData p F n h s) (hC : C.Valid) (X : Fin s → ZMod p)
    (i₁ : Fin s) (c : Coord F n) (hy : C.interp X c.1 ≠ 0) (hz : C.enc X c = 0) :
    C.phi X i₁ c < innerBlock F p n ∧ C.psi X i₁ (C.phi X i₁ c) = c := by
  sorry

/-- Outer-zero case: label lies in the second block, below `⌊0.9ℓ⌋`, and decodes correctly. [TheWeakRankPrinciple, node_32] -/
theorem outer_case (C : CodeData p F n h s) (hC : C.Valid) (X : Fin s → ZMod p)
    (i₁ : Fin s) (hX : X i₁ ≠ 0) (c : Coord F n) (hy : C.interp X c.1 = 0) :
    innerBlock F p n ≤ C.phi X i₁ c ∧ C.phi X i₁ c < 9 * blockLen F n / 10 ∧
      C.psi X i₁ (C.phi X i₁ c) = c := by
  sorry

/-! ## Main theorem -/

/-- **Reversible naming of zero coordinates.** For every message `X`, every `i₁` with
`X_{i₁} ≠ 0` and every coordinate `i` with `Enc(X)_i = 0`:
`φ̃(X,i₁,i) ∈ [⌊0.9ℓ⌋]` and `ψ̃(X,i₁,φ̃(X,i₁,i)) = i`. [TheWeakRankPrinciple, node_32] -/
theorem zero_labels_reversible (C : CodeData p F n h s) (hC : C.Valid)
    (X : Fin s → ZMod p) (i₁ : Fin s) (i : Coord F n)
    (hX : X i₁ ≠ 0) (hz : C.enc X i = 0) :
    C.phi X i₁ i < 9 * blockLen F n / 10 ∧ C.psi X i₁ (C.phi X i₁ i) = i := by
  sorry

/-- Consequence (relative distance ≥ 0.1): a nonzero message has at most `⌊0.9ℓ⌋` zero
coordinates. [TheWeakRankPrinciple, node_32] -/
theorem zero_count_le (C : CodeData p F n h s) (hC : C.Valid) (X : Fin s → ZMod p)
    (hX : X ≠ 0) :
    (Finset.univ.filter (fun c : Coord F n => C.enc X c = 0)).card
      ≤ 9 * blockLen F n / 10 := by
  sorry

end TCSChallenge.TheWeakRankPrinciple.node_32
