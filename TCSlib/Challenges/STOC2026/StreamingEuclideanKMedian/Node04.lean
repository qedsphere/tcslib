/-!
## Online sensitivities of Euclidean `(k,z)`-clustering on a grid

Points `x₀, …, x_{n-1}` lie in `[Δ]^d = {1,…,Δ}^d` (repetitions allowed). For a nonempty set
`C` of at most `k` centers in `ℝ^d`, `dist(x, C) = min_{c ∈ C} ‖x - c‖₂`. The online
sensitivity of the `t`-th point is

  `σ_t = sup_C dist(x_t, C)^z / ∑_{j ≤ t} dist(x_j, C)^z`   (0/0 := 0).

Main theorem `sum_onlineSensitivity_le`: there is a universal `A > 0` such that for all
positive integers `n, d, Δ, k`, every real `z ≥ 1` and every grid sequence,

  `∑_{t} σ_t ≤ A · 2^{2z} · k · (max 1 (ln (n d Δ)))²`.
-/

namespace TCSChallenge.StreamingEuclideanKMedian.node_04

/-- Euclidean distance `‖u - v‖₂` on `ℝ^d` (written out; the Pi norm is the sup norm). -/
def eDist {d : ℕ} (u v : Fin d → ℝ) : ℝ :=
  Real.sqrt (∑ i, (u i - v i) ^ 2)

/-- A grid point of `[Δ]^d` viewed in `ℝ^d`. -/
def toReal {d : ℕ} (p : Fin d → ℕ) : Fin d → ℝ := fun i => (p i : ℝ)

/-- "`(x₁,…,xₙ)` is any sequence in `[Δ]^d = {1,…,Δ}^d`": coordinates of the first `n`
points lie in `{1,…,Δ}`. -/
def OnGrid {d : ℕ} (n Δ : ℕ) (x : ℕ → Fin d → ℕ) : Prop :=
  ∀ j, j < n → ∀ i, 1 ≤ x j i ∧ x j i ≤ Δ

/-- "`dist(x,C) = min_{c∈C} ‖x−c‖₂`" (only used for nonempty `C`). -/
def distSet {d : ℕ} (y : Fin d → ℝ) (C : Finset (Fin d → ℝ)) : ℝ :=
  ⨅ c : C, eDist y (c : Fin d → ℝ)

/-- Admissible center sets: "`C ⊂ ℝ^d, 1 ≤ |C| ≤ k`". -/
def Admissible {d : ℕ} (k : ℕ) (C : Finset (Fin d → ℝ)) : Prop :=
  C.Nonempty ∧ C.card ≤ k

/-- The prefix cost `∑_{j ≤ t} dist(x_j, C)^z` (0-indexed prefix `x₀,…,x_t`). -/
def prefixCost {d : ℕ} (z : ℝ) (x : ℕ → Fin d → ℕ) (C : Finset (Fin d → ℝ)) (t : ℕ) : ℝ :=
  ∑ j ∈ Finset.range (t + 1), distSet (toReal (x j)) C ^ z

/-- The online sensitivity
"`σ_t = sup_{1≤|C|≤k} dist(x_t,C)^z / ∑_{j=1}^t dist(x_j,C)^z`, zero denominator ⇒ zero". -/
def onlineSensitivity {d : ℕ} (k : ℕ) (z : ℝ) (x : ℕ → Fin d → ℕ) (t : ℕ) : ℝ :=
  ⨆ C : {C : Finset (Fin d → ℝ) // Admissible k C},
    distSet (toReal (x t)) C.1 ^ z / prefixCost z x C.1 t

/-- The optimal prefix cost "`A_t = min_{1≤|C|≤k} ∑_{j=1}^t dist(x_j,C)^z`". -/
def optCost {d : ℕ} (k : ℕ) (z : ℝ) (x : ℕ → Fin d → ℕ) (t : ℕ) : ℝ :=
  ⨅ C : {C : Finset (Fin d → ℝ) // Admissible k C}, prefixCost z x C.1 t

/-- Harmonic number `H_n = ∑_{j=1}^n 1/j`. -/
def harmonicNum (n : ℕ) : ℝ :=
  ∑ i ∈ Finset.range n, 1 / ((i : ℝ) + 1)

/-- Number of occurrences of the location `x_t` among `x₀,…,x_t`. -/
def occCount {d : ℕ} (x : ℕ → Fin d → ℕ) (t : ℕ) : ℕ :=
  ((Finset.range (t + 1)).filter (fun j => x j = x t)).card

/-- For a fixed assignment `π`, "`m_t = |{j ≤ t : π(j) = π(t)}|`". -/
def assignCount {d : ℕ} (π : ℕ → Fin d → ℝ) (t : ℕ) : ℕ :=
  ((Finset.range (t + 1)).filter (fun j => π j = π t)).card

/-! ## Rubric 1: zero-cost prefixes and objective range -/

/-- `σ_t ≤ 1/m_t` with `m_t` the multiplicity of `x_t` in the prefix (used on the
zero-cost initial segment). [StreamingEuclideanKMedian, node_04] -/
theorem onlineSensitivity_le_inv_occCount {d : ℕ} (k : ℕ) (z : ℝ) (hk : 1 ≤ k) (hz : 1 ≤ z)
    (x : ℕ → Fin d → ℕ) (t : ℕ) :
    onlineSensitivity k z x t ≤ 1 / (occCount x t : ℝ) := by
  sorry

/-- `A_t = 0` iff the prefix has at most `k` distinct locations. [StreamingEuclideanKMedian, node_04] -/
theorem optCost_eq_zero_iff {d : ℕ} (n Δ k : ℕ) (z : ℝ) (hk : 1 ≤ k) (hz : 1 ≤ z)
    (x : ℕ → Fin d → ℕ) (hx : OnGrid n Δ x) (t : ℕ) (ht : t < n) :
    optCost k z x t = 0 ↔ ((Finset.range (t + 1)).image x).card ≤ k := by
  sorry

/-- Positive optimal costs are at least `2^{1-z}` (grid points are at distance `≥ 1`). [StreamingEuclideanKMedian, node_04] -/
theorem optCost_pos_lower {d : ℕ} (n Δ k : ℕ) (z : ℝ) (hk : 1 ≤ k) (hz : 1 ≤ z)
    (x : ℕ → Fin d → ℕ) (hx : OnGrid n Δ x) (t : ℕ) (ht : t < n)
    (hpos : 0 < optCost k z x t) :
    (2 : ℝ) ^ (1 - z) ≤ optCost k z x t := by
  sorry

/-- Upper bound `A_t ≤ n (√d Δ)^z` (single center at `x₁`). [StreamingEuclideanKMedian, node_04] -/
theorem optCost_upper {d : ℕ} (n Δ k : ℕ) (z : ℝ) (hk : 1 ≤ k) (hz : 1 ≤ z)
    (x : ℕ → Fin d → ℕ) (hx : OnGrid n Δ x) (t : ℕ) (ht : t < n) :
    optCost k z x t ≤ (n : ℝ) * (Real.sqrt d * Δ) ^ z := by
  sorry

/-! ## Rubric 3: fixed assignment and uniform sensitivity estimate -/

/-- Within a phase `[a, b]` with `0 < A_a` and `A_b ≤ 2 A_a`, fix an optimal center set `K`
for the prefix ending at `b` and a nearest-center assignment `π` (fixed throughout the phase).
With `w_t = ‖x_t - π(t)‖^z` and `m_t = |{j ≤ t : π j = π t}|`, uniformly in the query:
`σ_t ≤ 3^{z-1} (w_t / A_a + 3 / m_t)`. [StreamingEuclideanKMedian, node_04] -/
theorem onlineSensitivity_le_fixedAssignment {d : ℕ} (k : ℕ) (z : ℝ) (hk : 1 ≤ k)
    (hz : 1 ≤ z) (x : ℕ → Fin d → ℕ) (a b t : ℕ) (hab : a ≤ t) (htb : t ≤ b)
    (hApos : 0 < optCost k z x a) (hAb : optCost k z x b ≤ 2 * optCost k z x a)
    (K : Finset (Fin d → ℝ)) (hK : Admissible k K)
    (hKopt : prefixCost z x K b = optCost k z x b)
    (π : ℕ → Fin d → ℝ) (hπK : ∀ j, j ≤ b → π j ∈ K)
    (hπnear : ∀ j, j ≤ b → eDist (toReal (x j)) (π j) = distSet (toReal (x j)) K) :
    onlineSensitivity k z x t ≤
      (3 : ℝ) ^ (z - 1) * (eDist (toReal (x t)) (π t) ^ z / optCost k z x a
        + 3 / (assignCount π t : ℝ)) := by
  sorry

/-! ## Rubric 4: harmonic bound for prefix-cluster counts -/

/-- For any assignment taking at most `k` values on `[0, n)`, and any interval `[a, b]`,
`∑_{t∈[a,b]} 1/m_t ≤ k H_n` with `m_t` the prefix (not final) cluster count. [StreamingEuclideanKMedian, node_04] -/
theorem sum_inv_assignCount_le {d : ℕ} (k n a b : ℕ) (hb : b < n) (π : ℕ → Fin d → ℝ)
    (hπ : ((Finset.range (b + 1)).image π).card ≤ k) :
    ∑ t ∈ Finset.Icc a b, 1 / (assignCount π t : ℝ) ≤ k * harmonicNum n := by
  sorry

/-! ## Main theorem -/

/-- **Online sensitivity sum bound.** There is a universal constant `A > 0` such that for all
positive integers `n, d, Δ, k`, every real `z ≥ 1` and every sequence in `[Δ]^d`,
`∑_{t} σ_t ≤ A · 2^{2z} · k · (max{1, ln(n d Δ)})²`. [StreamingEuclideanKMedian, node_04] -/
theorem sum_onlineSensitivity_le :
    ∃ A : ℝ, 0 < A ∧
      ∀ (n d Δ k : ℕ), 1 ≤ n → 1 ≤ d → 1 ≤ Δ → 1 ≤ k →
      ∀ (z : ℝ), 1 ≤ z →
      ∀ (x : ℕ → Fin d → ℕ), OnGrid n Δ x →
        ∑ t ∈ Finset.range n, onlineSensitivity k z x t ≤
          A * (2 : ℝ) ^ (2 * z) * (k : ℝ) *
            (max 1 (Real.log ((n : ℝ) * d * Δ))) ^ 2 := by
  sorry

end TCSChallenge.StreamingEuclideanKMedian.node_04
