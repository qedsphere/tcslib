/-!
## Two-source extractors for `O(log n)` min-entropy

For every constant `ε > 0` there are `c > 1` and a family
`TExt_n : {0,1}^n × {0,1}^n → {0,1}` (`n ≥ 2`) such that for independent `X, Y` on `{0,1}^n`
with `H∞(X), H∞(Y) ≥ c log n`, `Δ(TExt_n(X,Y), U_1) ≤ ε`.

Random variables are modelled as `TCSlib.InformationTheory.FinDist` on `Fin n → ZMod 2`;
independence is `FinDist.prod`; `H∞(X) ≥ k` is `FinDist.HasMinEntropy X k`
(every atom `≤ 2^(-k)`); `Δ` is `statDist`. Logarithms are `Real.logb 2`.

The three black boxes of the problem appear as lemma stubs `toolI_seeded_extractor`,
`toolII_advice_breaker`, `toolIII_conversion`. Rubric items appear as
`cond_entropy_bound`, `fingerprint_collision`, `seeded_nm_extractor_log`.
Main theorem: `two_source_extractor_log_entropy`.
-/

namespace TCSChallenge.TwoSourceExtractorsFor.node_28

open TCSlib.InformationTheory

/-- `{0,1}^n`, as vectors over `F₂`. -/
abbrev BitStr (n : ℕ) : Type := Fin n → ZMod 2

/-- "a map on two independent n-bit sources whose output is ε-close to uniform whenever both
sources have min-entropy at least k": for all independent `X, Y` with `H∞ ≥ k`,
`Δ(f(X,Y), U_1) ≤ ε`. -/
def IsTwoSourceExt {n : ℕ} (f : BitStr n → BitStr n → Bool) (k ε : ℝ) : Prop :=
  ∀ X Y : FinDist (BitStr n), FinDist.HasMinEntropy X k → FinDist.HasMinEntropy Y k →
    statDist (FinDist.map (fun p : BitStr n × BitStr n => f p.1 p.2) (FinDist.prod X Y))
      (FinDist.uniform Bool) ≤ ε

/-- Strong seeded `t`-non-malleable extractor (Tool III hypothesis): "for every X with
H∞(X) ≥ K, an independent uniform S ∈ {0,1}^d, and arbitrary maps A_1,…,A_t with A_i(s) ≠ s,
Δ((M(X,S),M(X,A_1(S)),…,M(X,A_t(S)),S), (U_1,M(X,A_1(S)),…,M(X,A_t(S)),S)) ≤ δ." -/
def IsSeededNMExt {N d : ℕ} (t : ℕ) (M : BitStr N → BitStr d → Bool) (K δ : ℝ) : Prop :=
  ∀ X : FinDist (BitStr N), FinDist.HasMinEntropy X K →
  ∀ A : Fin t → BitStr d → BitStr d, (∀ i s, A i s ≠ s) →
    statDist
      (FinDist.map (fun p : BitStr N × BitStr d =>
          (M p.1 p.2, (fun i : Fin t => M p.1 (A i p.2)), p.2))
        (FinDist.prod X (FinDist.uniform (BitStr d))))
      (FinDist.map (fun u : Bool × (BitStr N × BitStr d) =>
          (u.1, (fun i : Fin t => M u.2.1 (A i u.2.2)), u.2.2))
        (FinDist.prod (FinDist.uniform Bool) (FinDist.prod X (FinDist.uniform (BitStr d)))))
      ≤ δ

/-! ### Black boxes supplied by the problem -/

/-- **Tool I** (strong seeded extractor). There is an absolute `A` such that for `N, D ≥ 1`,
`η ∈ (0,1/2)`, `K ≥ 2D + A log(1/η)` there is `E : {0,1}^N × {0,1}^s → {0,1}^D`,
`s ≤ ⌈A log(N/η)⌉`, with `Δ((E(X,U_s),U_s),(U_D,U_s)) ≤ η` whenever `H∞(X) ≥ K`. [TwoSourceExtractorsFor, node_28] -/
theorem toolI_seeded_extractor :
    ∃ A : ℝ, 0 < A ∧ ∀ (N D : ℕ) (η K : ℝ), 0 < N → 0 < D → 0 < η → η < 1 / 2 →
      2 * (D : ℝ) + A * Real.logb 2 (1 / η) ≤ K →
      ∃ s : ℕ, s ≤ ⌈A * Real.logb 2 ((N : ℝ) / η)⌉₊ ∧
        ∃ E : BitStr N → BitStr s → BitStr D,
          ∀ X : FinDist (BitStr N), FinDist.HasMinEntropy X K →
            statDist
              (FinDist.map (fun p : BitStr N × BitStr s => (E p.1 p.2, p.2))
                (FinDist.prod X (FinDist.uniform (BitStr s))))
              (FinDist.prod (FinDist.uniform (BitStr D)) (FinDist.uniform (BitStr s))) ≤ η := by
  sorry

/-- **Tool II** (advice-dependent high-entropy correlation breaker). For each `t ≥ 1` there is
`C_t` such that for `a, D ≥ 1`, `η ∈ (0,1/2)`, `D ≥ C_t(a + log(1/η))`, there are maps
`G_j : {0,1}^D × {0,1}^D → {0,1}`, `j ∈ [2^a]`, with: for independent vectors `(P_0..P_t)`,
`(Q_0..Q_t)` with `H∞(P_0), H∞(Q_0) ≥ 0.9D` and indices with `j_0 ∉ {j_1..j_t}`,
`Δ((B_0,B_1..B_t,Q_0),(U_1,B_1..B_t,Q_0)) ≤ η` where `B_i = G_{j_i}(P_i,Q_i)`. [TwoSourceExtractorsFor, node_28] -/
theorem toolII_advice_breaker (t : ℕ) (ht : 0 < t) :
    ∃ Ct : ℝ, 0 < Ct ∧ ∀ (a D : ℕ) (η : ℝ), 0 < a → 0 < D → 0 < η → η < 1 / 2 →
      Ct * ((a : ℝ) + Real.logb 2 (1 / η)) ≤ (D : ℝ) →
      ∃ G : Fin (2 ^ a) → BitStr D → BitStr D → Bool,
        ∀ P Q : FinDist (Fin (t + 1) → BitStr D),
          FinDist.HasMinEntropy (FinDist.map (fun p : Fin (t + 1) → BitStr D => p 0) P)
            ((0.9 : ℝ) * (D : ℝ)) →
          FinDist.HasMinEntropy (FinDist.map (fun q : Fin (t + 1) → BitStr D => q 0) Q)
            ((0.9 : ℝ) * (D : ℝ)) →
          ∀ j : Fin (t + 1) → Fin (2 ^ a), (∀ i : Fin t, j 0 ≠ j i.succ) →
            statDist
              (FinDist.map
                (fun pq : (Fin (t + 1) → BitStr D) × (Fin (t + 1) → BitStr D) =>
                  (G (j 0) (pq.1 0) (pq.2 0),
                   (fun i : Fin t => G (j i.succ) (pq.1 i.succ) (pq.2 i.succ)), pq.2 0))
                (FinDist.prod P Q))
              (FinDist.map
                (fun u : Bool × ((Fin (t + 1) → BitStr D) × (Fin (t + 1) → BitStr D)) =>
                  (u.1, (fun i : Fin t => G (j i.succ) (u.2.1 i.succ) (u.2.2 i.succ)), u.2.2 0))
                (FinDist.prod (FinDist.uniform Bool) (FinDist.prod P Q)))
              ≤ η := by
  sorry

/-- **Tool III** (seeded non-malleable extractor ⟹ two-source extractor). If for every `N ≥ 2`,
`t ≥ 1`, `δ ∈ (0,1)` there are `d, K ≤ F(N,t,δ)` and a strong seeded `t`-non-malleable
extractor `M : {0,1}^N × {0,1}^d → {0,1}` for entropy `K` and error `δ`, then for every
`ε₀ ∈ (0,1/2)` there are `t ≥ 1`, `b ≥ 1` and a one-bit two-source extractor with error `ε₀` and
entropy threshold `F(n,t,n^(-b))`. [TwoSourceExtractorsFor, node_28] -/
theorem toolIII_conversion (F : ℕ → ℕ → ℝ → ℝ) (hFpos : ∀ N t δ, 0 < F N t δ)
    (hF : ∀ (N t : ℕ) (δ : ℝ), 2 ≤ N → 0 < t → 0 < δ → δ < 1 →
      ∃ d K : ℕ, (d : ℝ) ≤ F N t δ ∧ (K : ℝ) ≤ F N t δ ∧
        ∃ M : BitStr N → BitStr d → Bool, IsSeededNMExt t M (K : ℝ) δ) :
    ∀ ε₀ : ℝ, 0 < ε₀ → ε₀ < 1 / 2 → ∃ t b : ℕ, 0 < t ∧ 1 ≤ b ∧
      ∃ TExt : (n : ℕ) → BitStr n → BitStr n → Bool,
        ∀ n : ℕ, 2 ≤ n → IsTwoSourceExt (TExt n) (F n t ((n : ℝ) ^ (-(b : ℝ)))) ε₀ := by
  sorry

/-! ### Rubric lemmas -/

/-- Conditional entropy bound: if `H∞(W) ≥ h` and `V = g(W)` takes at most `2^ℓ` values, then
the values `v` with `Pr[V=v] < β 2^(-ℓ)` carry total mass `≤ β`, and at every other value
`Pr[W=w | V=v] ≤ 2^(-(h - ℓ - log(1/β)))`. [TwoSourceExtractorsFor, node_28] -/
theorem cond_entropy_bound {α ι : Type*} [Fintype α] [Fintype ι] [DecidableEq ι]
    (W : FinDist α) (g : α → ι) (h ℓ β : ℝ) (hW : FinDist.HasMinEntropy W h)
    (hcard : (Fintype.card ι : ℝ) ≤ (2 : ℝ) ^ ℓ) (hβ : 0 < β) :
    (∑ v ∈ Finset.univ.filter (fun v => FinDist.map g W v < β * (2 : ℝ) ^ (-ℓ)),
        FinDist.map g W v) ≤ β ∧
    ∀ w : α, β * (2 : ℝ) ^ (-ℓ) ≤ FinDist.map g W (g w) →
      W w / FinDist.map g W (g w) ≤ (2 : ℝ) ^ (-(h - ℓ - Real.logb 2 (1 / β))) := by
  sorry

/-- Finite-field fingerprint, inequality (3): for `u ≠ v ∈ {0,1}^d`, the polynomials
`∑ u_j z^j` and `∑ v_j z^j` agree on at most `d - 1` points of a finite field. [TwoSourceExtractorsFor, node_28] -/
theorem fingerprint_collision {F : Type*} [Field F] [Fintype F] [DecidableEq F]
    (d : ℕ) (u v : BitStr d) (huv : u ≠ v) :
    (Finset.univ.filter (fun z : F =>
        ∑ j : Fin d, ((u j).val : F) * z ^ (j : ℕ) =
          ∑ j : Fin d, ((v j).val : F) * z ^ (j : ℕ))).card ≤ d - 1 := by
  sorry

/-- Rubric items 1–4: for each fixed `t ≥ 1` there are strong seeded `t`-non-malleable
extractors whose seed length `d` and entropy `K` are both `≤ M_t (1 + log N + log(1/δ))`
(equation (11) of the reference answer). [TwoSourceExtractorsFor, node_28] -/
theorem seeded_nm_extractor_log (t : ℕ) (ht : 0 < t) :
    ∃ Mt : ℝ, 0 < Mt ∧ ∀ (N : ℕ) (δ : ℝ), 2 ≤ N → 0 < δ → δ < 1 →
      ∃ d K : ℕ,
        (d : ℝ) ≤ Mt * (1 + Real.logb 2 (N : ℝ) + Real.logb 2 (1 / δ)) ∧
        (K : ℝ) ≤ Mt * (1 + Real.logb 2 (N : ℝ) + Real.logb 2 (1 / δ)) ∧
        ∃ M : BitStr N → BitStr d → Bool, IsSeededNMExt t M (K : ℝ) δ := by
  sorry

/-! ### Main theorem -/

/-- For every `ε > 0` there are `c > 1` and a family `TExt_n` (`n ≥ 2`) such that for
independent `X, Y` on `{0,1}^n` with `H∞(X), H∞(Y) ≥ c log n`, `Δ(TExt_n(X,Y), U_1) ≤ ε`.
(Explicitness is not captured.) [TwoSourceExtractorsFor, node_28] -/
theorem two_source_extractor_log_entropy :
    ∀ ε : ℝ, 0 < ε → ∃ c : ℝ, 1 < c ∧
      ∃ TExt : (n : ℕ) → BitStr n → BitStr n → Bool,
        ∀ n : ℕ, 2 ≤ n → IsTwoSourceExt (TExt n) (c * Real.logb 2 (n : ℝ)) ε := by
  sorry

end TCSChallenge.TwoSourceExtractorsFor.node_28
