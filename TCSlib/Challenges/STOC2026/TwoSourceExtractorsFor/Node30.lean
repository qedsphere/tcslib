/-!
## Extractors for sumset sources at `O(log n)` min-entropy

For every constant `ε > 0` there are `c > 1` and a family `SumsetExt_n : {0,1}^n → {0,1}`
(`n ≥ 2`) with `Δ(SumsetExt_n(X+Y), U_1) ≤ ε` for all independent `(n,k)`-sources `X, Y`,
`k ≥ c log n`; addition is coordinatewise over `F₂`.

Distributions are `TCSlib.InformationTheory.FinDist` on `Fin n → ZMod 2`, independence is
`FinDist.prod`, `H∞ ≥ k` is `FinDist.HasMinEntropy · k`, `Δ` is `statDist`.

`OrdinaryBreaker` is the assertion `B(N,D;k,ℓ,a,ρ)`, `AffineBreaker` is `A(n,d;k,T,a,ρ)`.
The four supplied tools are stubs `tool_reduction`, `tool_equal_length_breaker`,
`tool_seeded_extractor`, `tool_affine_transform`; rubric items are `cond_entropy_bound`,
`ordinary_breaker_exists`, `affine_breaker_resource_bound`.
Main theorem: `sumset_extractor_log_entropy`.
-/

namespace TCSChallenge.TwoSourceExtractorsFor.node_30

open TCSlib.InformationTheory

/-- `{0,1}^n` as `F₂^n`; `+` is coordinatewise addition over `F₂`. -/
abbrev BitStr (n : ℕ) : Type := Fin n → ZMod 2

/-- `Δ(G(X+Y), U_1) ≤ ε` for every pair of independent `(n,k)`-sources `X, Y`. -/
def IsSumsetExt {n : ℕ} (G : BitStr n → Bool) (k ε : ℝ) : Prop :=
  ∀ X Y : FinDist (BitStr n), FinDist.HasMinEntropy X k → FinDist.HasMinEntropy Y k →
    statDist (FinDist.map (fun p : BitStr n × BitStr n => G (p.1 + p.2)) (FinDist.prod X Y))
      (FinDist.uniform Bool) ≤ ε

/-- `B(N,D;k,ℓ,a,ρ)`: there is `F : {0,1}^N × {0,1}^D × {0,1}^a → {0,1}` with
`Δ((F(X,Y,α),F(X′,Y′,α′),Y,Y′),(U₁,F(X′,Y′,α′),Y,Y′)) ≤ ρ` whenever `(X,X′)` and `(Y,Y′)` are
independent pairs, `H∞(X) ≥ k`, `H∞(Y) ≥ ℓ`, and `α ≠ α′`. -/
def OrdinaryBreaker (N D : ℕ) (k ℓ : ℝ) (a : ℕ) (ρ : ℝ) : Prop :=
  ∃ F : BitStr N → BitStr D → BitStr a → Bool,
    ∀ (XX : FinDist (BitStr N × BitStr N)) (YY : FinDist (BitStr D × BitStr D)),
      FinDist.HasMinEntropy (FinDist.map (fun p : BitStr N × BitStr N => p.1) XX) k →
      FinDist.HasMinEntropy (FinDist.map (fun p : BitStr D × BitStr D => p.1) YY) ℓ →
      ∀ α α' : BitStr a, α ≠ α' →
        statDist
          (FinDist.map (fun p : (BitStr N × BitStr N) × (BitStr D × BitStr D) =>
              (F p.1.1 p.2.1 α, F p.1.2 p.2.2 α', p.2.1, p.2.2)) (FinDist.prod XX YY))
          (FinDist.map (fun u : Bool × ((BitStr N × BitStr N) × (BitStr D × BitStr D)) =>
              (u.1, F u.2.1.2 u.2.2.2 α', u.2.2.1, u.2.2.2))
            (FinDist.prod (FinDist.uniform Bool) (FinDist.prod XX YY)))
          ≤ ρ

/-- `A(n,d;k,T,a,ρ)`: there is `F : {0,1}^n × {0,1}^d × {0,1}^a → {0,1}` such that, whenever
`X_i = A_i + B_i` (`0 ≤ i ≤ T`), `(A_0..A_T)` is independent of `(B_0..B_T,Y_0..Y_T)`,
`H∞(A_0) ≥ k`, `Y_0` is uniform, and the fixed advice satisfies `α_0 ≠ α_i` (`1 ≤ i ≤ T`),
`Δ((F(X_0,Y_0,α_0),(F(X_i,Y_i,α_i))_i,(Y_i)_i),(U_1,(F(X_i,Y_i,α_i))_i,(Y_i)_i)) ≤ ρ`. -/
def AffineBreaker (n d : ℕ) (k : ℝ) (T a : ℕ) (ρ : ℝ) : Prop :=
  ∃ F : BitStr n → BitStr d → BitStr a → Bool,
    ∀ (AA : FinDist (Fin (T + 1) → BitStr n))
      (BY : FinDist ((Fin (T + 1) → BitStr n) × (Fin (T + 1) → BitStr d))),
      FinDist.HasMinEntropy (FinDist.map (fun A : Fin (T + 1) → BitStr n => A 0) AA) k →
      FinDist.map (fun p : (Fin (T + 1) → BitStr n) × (Fin (T + 1) → BitStr d) => p.2 0) BY =
        FinDist.uniform (BitStr d) →
      ∀ α : Fin (T + 1) → BitStr a, (∀ i : Fin T, α 0 ≠ α i.succ) →
        statDist
          (FinDist.map
            (fun p : (Fin (T + 1) → BitStr n) ×
                ((Fin (T + 1) → BitStr n) × (Fin (T + 1) → BitStr d)) =>
              (F (p.1 0 + p.2.1 0) (p.2.2 0) (α 0),
               (fun i : Fin T => F (p.1 i.succ + p.2.1 i.succ) (p.2.2 i.succ) (α i.succ)),
               p.2.2))
            (FinDist.prod AA BY))
          (FinDist.map
            (fun u : Bool × ((Fin (T + 1) → BitStr n) ×
                ((Fin (T + 1) → BitStr n) × (Fin (T + 1) → BitStr d))) =>
              (u.1,
               (fun i : Fin T =>
                  F (u.2.1 i.succ + u.2.2.1 i.succ) (u.2.2.2 i.succ) (α i.succ)),
               u.2.2.2))
            (FinDist.prod (FinDist.uniform Bool) (FinDist.prod AA BY)))
          ≤ ρ

/-! ### Supplied tools -/

/-- **Reduction.** If `f n T σ a` bounds `d, k` for which `A(n,d;k,T,a,σ)` holds, there is an
absolute `C₀ > 1` such that for every `ε ∈ (0,1/2)` there are `t ≥ 1`, `q ≥ 2`, `R ≥ 1` with: for
all large `n`, `L = log n`, positive integers `C, k̄` with `k̄ ≥ f_n(Ct, n^(-q), ⌈qL + log C⌉)`,
`K = ⌈R(Ct k̄ + L)⌉` and `C ≥ C₀ (log(K/L))²`, there is `G_n` with `Δ(G_n(X+Y),U₁) ≤ ε` for all
independent `(n,K)`-sources. [TwoSourceExtractorsFor, node_30] -/
theorem tool_reduction (f : ℕ → ℕ → ℝ → ℕ → ℝ)
    (hf : ∀ (n T : ℕ) (σ : ℝ) (a : ℕ), 2 ≤ n → 0 < T → 0 < σ → σ < 1 / 2 →
      ∃ d k : ℕ, (d : ℝ) ≤ f n T σ a ∧ (k : ℝ) ≤ f n T σ a ∧ AffineBreaker n d (k : ℝ) T a σ) :
    ∃ C₀ : ℝ, 1 < C₀ ∧ ∀ ε : ℝ, 0 < ε → ε < 1 / 2 →
      ∃ t q : ℕ, 1 ≤ t ∧ 2 ≤ q ∧ ∃ R : ℝ, 1 ≤ R ∧ ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n →
        ∀ C kbar : ℕ, 0 < C → 0 < kbar →
          f n (C * t) ((n : ℝ) ^ (-(q : ℝ)))
              ⌈(q : ℝ) * Real.logb 2 (n : ℝ) + Real.logb 2 (C : ℝ)⌉₊ ≤ (kbar : ℝ) →
          C₀ * (Real.logb 2
              ((⌈R * (((C * t * kbar : ℕ) : ℝ) + Real.logb 2 (n : ℝ))⌉₊ : ℝ) /
                Real.logb 2 (n : ℝ))) ^ 2 ≤ (C : ℝ) →
          ∃ G : BitStr n → Bool,
            IsSumsetExt G (⌈R * (((C * t * kbar : ℕ) : ℝ) + Real.logb 2 (n : ℝ))⌉₊ : ℝ) ε := by
  sorry

/-- **Equal-length high-entropy breaker.** `B(D,D;0.9D,0.9D,a,ρ)` holds whenever
`D ≥ A(a + log(1/ρ))`, for an absolute `A ≥ 1`. [TwoSourceExtractorsFor, node_30] -/
theorem tool_equal_length_breaker :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (D a : ℕ) (ρ : ℝ), 0 < ρ → ρ < 1 →
      A * ((a : ℝ) + Real.logb 2 (1 / ρ)) ≤ (D : ℝ) →
      OrdinaryBreaker D D ((0.9 : ℝ) * (D : ℝ)) ((0.9 : ℝ) * (D : ℝ)) a ρ := by
  sorry

/-- **Strong seeded extractor.** For an absolute `A ≥ 1`, every `m ≤ k - A log(1/ρ)` has
`E : {0,1}^n × {0,1}^r → {0,1}^m`, `r = ⌈A log(n/ρ)⌉`, with `Δ((E(X,S),S),(U_m,S)) ≤ ρ` for every
`(n,k)`-source `X` and independent uniform `S`. [TwoSourceExtractorsFor, node_30] -/
theorem tool_seeded_extractor :
    ∃ A : ℝ, 1 ≤ A ∧ ∀ (n m : ℕ) (k ρ : ℝ), 1 ≤ n → 0 < ρ → ρ < 1 →
      (m : ℝ) ≤ k - A * Real.logb 2 (1 / ρ) →
      ∃ E : BitStr n → BitStr ⌈A * Real.logb 2 ((n : ℝ) / ρ)⌉₊ → BitStr m,
        ∀ X : FinDist (BitStr n), FinDist.HasMinEntropy X k →
          statDist
            (FinDist.map
              (fun p : BitStr n × BitStr ⌈A * Real.logb 2 ((n : ℝ) / ρ)⌉₊ => (E p.1 p.2, p.2))
              (FinDist.prod X (FinDist.uniform (BitStr ⌈A * Real.logb 2 ((n : ℝ) / ρ)⌉₊))))
            (FinDist.prod (FinDist.uniform (BitStr m))
              (FinDist.uniform (BitStr ⌈A * Real.logb 2 ((n : ℝ) / ρ)⌉₊))) ≤ ρ := by
  sorry

/-- **Ordinary-to-affine transformation.** If `B(n,d;d,d,a,ρ)` holds for every `d ≥ H`
(`H = h(n,a,ρ)`), then for an absolute `B ≥ 1` and every `T ≥ 1` there are `d, k` with
`A(n,d;k,T,a,BTρ)`, `k ≤ B[T H + T² log(n/ρ)]`, `d ≤ B[T H + T log³(T+1) log(n/ρ)]`. [TwoSourceExtractorsFor, node_30] -/
theorem tool_affine_transform :
    ∃ B : ℝ, 1 ≤ B ∧ ∀ (n a : ℕ) (ρ H : ℝ), 1 ≤ n → 0 < ρ → ρ < 1 →
      (∀ d : ℕ, H ≤ (d : ℝ) → OrdinaryBreaker n d (d : ℝ) (d : ℝ) a ρ) →
      ∀ T : ℕ, 0 < T → ∃ d k : ℕ,
        AffineBreaker n d (k : ℝ) T a (B * (T : ℝ) * ρ) ∧
        (k : ℝ) ≤ B * ((T : ℝ) * H + (T : ℝ) ^ 2 * Real.logb 2 ((n : ℝ) / ρ)) ∧
        (d : ℝ) ≤ B * ((T : ℝ) * H +
          (T : ℝ) * (Real.logb 2 ((T : ℝ) + 1)) ^ 3 * Real.logb 2 ((n : ℝ) / ρ)) := by
  sorry

/-! ### Rubric lemmas -/

/-- Conditional entropy bound (4): if `H∞(W) ≥ h` and `J = g(W)` takes at most `2^ℓ` values, the
values `j` with `Pr[J=j] < β 2^(-ℓ)` have total mass `≤ β`, and at every other value
`Pr[W=w | J=j] ≤ 2^(-(h - ℓ - log(1/β)))`. [TwoSourceExtractorsFor, node_30] -/
theorem cond_entropy_bound {α ι : Type*} [Fintype α] [Fintype ι] [DecidableEq ι]
    (W : FinDist α) (g : α → ι) (h ℓ β : ℝ) (hW : FinDist.HasMinEntropy W h)
    (hcard : (Fintype.card ι : ℝ) ≤ (2 : ℝ) ^ ℓ) (hβ : 0 < β) :
    (∑ v ∈ Finset.univ.filter (fun v => FinDist.map g W v < β * (2 : ℝ) ^ (-ℓ)),
        FinDist.map g W v) ≤ β ∧
    ∀ w : α, β * (2 : ℝ) ^ (-ℓ) ≤ FinDist.map g W (g w) →
      W w / FinDist.map g W (g w) ≤ (2 : ℝ) ^ (-(h - ℓ - Real.logb 2 (1 / β))) := by
  sorry

/-- Rubric items 1–3: a uniform-seed ordinary breaker with threshold `O(a + log(n/η))`
(equation (7)): `B(n,d;d,d,a,η)` holds whenever `d ≥ M(a + log(n/η))`. [TwoSourceExtractorsFor, node_30] -/
theorem ordinary_breaker_exists :
    ∃ M : ℝ, 0 < M ∧ ∀ (n a d : ℕ) (η : ℝ), 1 ≤ n → 0 < η → η < 1 / 2 →
      M * ((a : ℝ) + Real.logb 2 ((n : ℝ) / η)) ≤ (d : ℝ) →
      OrdinaryBreaker n d (d : ℝ) (d : ℝ) a η := by
  sorry

/-- Rubric item 4, equation (8): a common resource bound for affine breakers,
`f_n(T,σ,a) = J[T a + (T² + T log³(T+1)) log(n(T+1)/σ)]`. [TwoSourceExtractorsFor, node_30] -/
theorem affine_breaker_resource_bound :
    ∃ J : ℝ, 1 ≤ J ∧ ∀ (n T a : ℕ) (σ : ℝ), 2 ≤ n → 0 < T → 0 < σ → σ < 1 / 2 →
      ∃ d k : ℕ,
        (d : ℝ) ≤ J * ((T : ℝ) * (a : ℝ) +
          ((T : ℝ) ^ 2 + (T : ℝ) * (Real.logb 2 ((T : ℝ) + 1)) ^ 3) *
            Real.logb 2 ((n : ℝ) * ((T : ℝ) + 1) / σ)) ∧
        (k : ℝ) ≤ J * ((T : ℝ) * (a : ℝ) +
          ((T : ℝ) ^ 2 + (T : ℝ) * (Real.logb 2 ((T : ℝ) + 1)) ^ 3) *
            Real.logb 2 ((n : ℝ) * ((T : ℝ) + 1) / σ)) ∧
        AffineBreaker n d (k : ℝ) T a σ := by
  sorry

/-! ### Main theorem -/

/-- For every `ε > 0` there are `c > 1` and `SumsetExt_n : {0,1}^n → {0,1}` (`n ≥ 2`) with
`Δ(SumsetExt_n(X+Y), U₁) ≤ ε` for all independent `(n,k)`-sources `X, Y` with `k ≥ c log n`.
(Explicitness is not captured.) [TwoSourceExtractorsFor, node_30] -/
theorem sumset_extractor_log_entropy :
    ∀ ε : ℝ, 0 < ε → ∃ c : ℝ, 1 < c ∧ ∃ SumsetExt : (n : ℕ) → BitStr n → Bool,
      ∀ n : ℕ, 2 ≤ n → ∀ k : ℝ, c * Real.logb 2 (n : ℝ) ≤ k →
        IsSumsetExt (SumsetExt n) k ε := by
  sorry

end TCSChallenge.TwoSourceExtractorsFor.node_30
