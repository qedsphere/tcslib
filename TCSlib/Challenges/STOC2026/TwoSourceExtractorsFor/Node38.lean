/-!
## Non-malleable codes against affine tampering from a restricted affine
# non-malleable extractor

We work over `𝔽₂ = ZMod 2` with blocks `V n = Fin n → ZMod 2`.  An affine
tampering map is `x ↦ A x + b`.  An affine source is uniform on an affine
subspace `v + W`, with entropy `finrank W`.  Given distributions (simulators,
joint laws taken as hypotheses, uniform laws) are TCSlib `FinDist`s; computed
laws (encoder, push-forwards, joint and conditional laws) are plain vectors
`α → ℝ` (checked with the local `IsProbVec` where needed).  `Δ` is total
variation distance `½ ∑ |p - q|` on vectors (`tv`; it agrees with TCSlib's
`statDist` on `FinDist`s, but its arguments here are mostly computed vectors).

The supplied primitive (`RestrictedNMExt`) is an extractor `E : V n → V r`
that is non-malleable against affine maps *without fixed points on the source*,
for sources of dimension `≥ (1-γ) n`, with error `2^{-cn}`.  It has balanced,
nonempty fibres.

Construction (for `k ≤ r`):
* `Dec x` = the first `k` bits of `E x` (`decPrefix`);
* `Enc s` = uniform element of `Dec⁻¹(s)` (`encDist`), sampled by drawing the
  remaining `r - k` output bits uniformly and calling the fibre sampler of `E`
  (`twoStepDist`).

Intermediate claims (lemma stubs, in proof order):
1. `ordinary_extraction` – the restricted guarantee gives ordinary extraction.
2. `affine_decomposition` – the uniform input space splits into ≤ ⌊γn/2⌋
   fixed-point-free affine pieces of dimension ≥ n - ⌊γn/2⌋ plus a residual
   that is either a large fixed-point affine piece (or empty) or has
   probability ≤ 2^{-⌊γn/2⌋}.
3. `joint_simulation` – for uniform `X` and every affine `f`,
   `(E X, E (f X))` is `2^{-cn} + (n+1) 2^{-⌊γn/2⌋}`-close to
   `(U, copy(S, U))` with `S` independent of `U`.
4. `tv_push_le` – data processing (projection to the first `k` bits).
5. `twoStep_eq_encDist`, `perfect_correctness` – encoder correctness.
6. `conditioning_loss` – conditioning a joint statement with exactly uniform
   first marginal on `D = s` costs a factor `2^k`.
7. `parameter_budget` – for `0 < ρ < min{a, c/2, γ/4}` the final error is
   `2^{-Ω(n)}`.

Main theorems: `nm_code_explicit` (explicit error
`2^k (2^{-cn} + (n+1) 2^{-⌊γn/2⌋})` for `k = ⌊ρ n⌋`) and `nm_code_exists`
(constant rate, error `2^{-δ k}`).
-/

namespace TCSChallenge.TwoSourceExtractorsFor.node_38

open TCSlib.InformationTheory

/-- Blocks of length `n` over `𝔽₂`. -/
abbrev V (n : ℕ) : Type := Fin n → ZMod 2

/-! ## Distributions and total variation distance -/

/-- A probability vector on a finite type (used only for computed laws such as
the encoder law; given distributions are `FinDist`s). -/
def IsProbVec {α : Type} [Fintype α] (p : α → ℝ) : Prop :=
  (∀ a, 0 ≤ p a) ∧ ∑ a, p a = 1

/-- Total variation distance `Δ(p, q) = ½ ∑ |p a - q a|`. -/
def tv {α : Type} [Fintype α] (p q : α → ℝ) : ℝ :=
  (1 / 2) * ∑ a, |p a - q a|

/-- Push-forward of a (probability) vector along a deterministic map. -/
def push {α β : Type} [Fintype α] (g : α → β) (p : α → ℝ) : β → ℝ :=
  fun b => ∑ a, if g a = b then p a else 0

/-- Uniform distribution on a finset `T` (zero outside). -/
def unifOn {α : Type} (T : Finset α) : α → ℝ :=
  fun x => if x ∈ T then 1 / (T.card : ℝ) else 0

/-! ## Affine maps and affine sources -/

/-- "An affine tampering map on blocks of length `n` is any function
`f(x) = Ax + b`." -/
structure AffMap (n : ℕ) where
  A : Matrix (Fin n) (Fin n) (ZMod 2)
  b : V n

/-- Evaluation of an affine map. -/
def AffMap.apply {n : ℕ} (f : AffMap n) (x : V n) : V n :=
  f.A.mulVec x + f.b

/-- Support `v + W` of the affine source determined by `W` and `v`. -/
def affSupp {n : ℕ} (W : Submodule (ZMod 2) (V n)) (v : V n) : Finset (V n) :=
  Finset.univ.filter (fun x => x - v ∈ W)

/-- Law of `(E X, E (f X))` for `X` uniform on `T`. -/
def jointReal {n r : ℕ} (E : V n → V r) (f : AffMap n) (T : Finset (V n)) :
    V r × V r → ℝ :=
  fun z => ((T.filter (fun x => E x = z.1 ∧ E (f.apply x) = z.2)).card : ℝ) / T.card

/-- Law of `(U_r, E (f X))` with `U_r` uniform and independent of `X`. -/
def jointIdeal {n r : ℕ} (E : V n → V r) (f : AffMap n) (T : Finset (V n)) :
    V r × V r → ℝ :=
  fun z => (1 / (2 : ℝ) ^ r) *
    (((T.filter (fun x => E (f.apply x) = z.2)).card : ℝ) / T.card)

/-- The supplied primitive: "`Δ((E(X), E(f(X))), (U_r, E(f(X)))) ≤ 2^{-cn}`
whenever `X` is an affine source of dimension at least `(1-γ)n` and `f` is
affine with `f(x) ≠ x` for every `x` in the support of `X`." -/
def RestrictedNMExt {n r : ℕ} (E : V n → V r) (γ c : ℝ) : Prop :=
  ∀ (W : Submodule (ZMod 2) (V n)) (v : V n) (f : AffMap n),
    (1 - γ) * (n : ℝ) ≤ (Module.finrank (ZMod 2) W : ℝ) →
    (∀ x ∈ affSupp W v, f.apply x ≠ x) →
    tv (jointReal E f (affSupp W v)) (jointIdeal E f (affSupp W v))
      ≤ (2 : ℝ) ^ (-(c * n))

/-- Fibre `E⁻¹(z)`. -/
def fibre {α β : Type} [Fintype α] (E : α → β) (z : β) : Finset α :=
  Finset.univ.filter (fun x => E x = z)

/-- "All fibres `E⁻¹(z)` are nonempty and have equal cardinality." -/
def BalancedFibres {α β : Type} [Fintype α] (E : α → β) : Prop :=
  (∀ z, (fibre E z).Nonempty) ∧ ∀ z z', (fibre E z).card = (fibre E z').card

/-! ## The code -/

/-- Decoder: "return the first `k` bits of `E_n`". -/
def decPrefix {n r k : ℕ} (E : V n → V r) (hk : k ≤ r) (x : V n) : V k :=
  fun i => E x (Fin.castLE hk i)

/-- Prefix of an output string. -/
def prefixOf {r k : ℕ} (hk : k ≤ r) (z : V r) : V k :=
  fun i => z (Fin.castLE hk i)

/-- Encoder law: `Enc(s)` is uniform on the decoder fibre `Dec⁻¹(s)`. -/
def encDist {n k : ℕ} (Dec : V n → V k) (s : V k) : V n → ℝ :=
  unifOn (fibre Dec s)

/-- Law of the two-step encoder: choose `z` uniformly among outputs with
prefix `s` (i.e. the remaining `r - k` bits uniformly), then sample an exactly
uniform element of `E⁻¹(z)` with the supplied sampler. -/
def twoStepDist {n r k : ℕ} (E : V n → V r) (hk : k ≤ r) (s : V k) : V n → ℝ :=
  fun x => ∑ z : V r, unifOn (fibre (prefixOf hk) s) z * unifOn (fibre E z) x

/-- Law of `Dec(f(Enc(s)))`. -/
def tamperedDecDist {n k : ℕ} (Dec : V n → V k) (f : AffMap n) (s : V k) :
    V k → ℝ :=
  push (fun x => Dec (f.apply x)) (encDist Dec s)

/-- Law of `copy(S, s)`; `none` plays the role of `same⋆`. -/
def copyDist {k : ℕ} (S : FinDist (Option (V k))) (s : V k) : V k → ℝ :=
  fun y => S (some y) + (if y = s then S none else 0)

/-- Non-malleability against all affine maps with error `ε`: "for every affine
map `f` there exists `S_f` on `𝔽₂^k ∪ {same⋆}`, with distribution independent
of the message, such that for every `s`,
`Δ(Dec(f(Enc(s))), copy(S_f, s)) ≤ ε`." -/
def IsAffineNMCode {n k : ℕ} (Dec : V n → V k) (ε : ℝ) : Prop :=
  ∀ f : AffMap n, ∃ S : FinDist (Option (V k)),
    ∀ s : V k, tv (tamperedDecDist Dec f s) (copyDist S s) ≤ ε

/-- Simulated joint law `(U, copy(S, U))` with `U` uniform on `V m` and
independent of `S`. -/
def simJoint {m : ℕ} (S : FinDist (Option (V m))) : V m × V m → ℝ :=
  fun z => (1 / (2 : ℝ) ^ m) * copyDist S z.1 z.2

/-- Conditional law of the second coordinate of a joint vector `p` given that
the first coordinate equals `s`. -/
def condSnd {α β : Type} [Fintype α] [Fintype β] (p : α × β → ℝ) (s : α) :
    β → ℝ :=
  fun y => p (s, y) / ∑ y', p (s, y')

/-! ## Intermediate claims -/

/-- Step 1: "the restricted guarantee implies ordinary extraction on every
permitted affine source: apply it with a nonzero translation and take the first
marginal." [TwoSourceExtractorsFor, node_38] -/
theorem ordinary_extraction {n r : ℕ} (E : V n → V r) (γ c : ℝ)
    (hn : 1 ≤ n) (hE : RestrictedNMExt E γ c)
    (W : Submodule (ZMod 2) (V n)) (v : V n)
    (hW : (1 - γ) * (n : ℝ) ≤ (Module.finrank (ZMod 2) W : ℝ)) :
    tv (push E (unifOn (affSupp W v))) (FinDist.uniform (V r)).prob
      ≤ (2 : ℝ) ^ (-(c * n)) := by
  sorry

/-- Step 2: affine decomposition of the displacement `f(x) - x = (A - I)x + b`
with budget `B` (used with `B = ⌊γ n / 2⌋`): at most `B` affine pieces, each of
dimension `≥ n - B` and free of fixed points, plus a residual set that consists
of fixed points and is empty or a fixed affine piece of dimension `≥ n - B`, or
else has at most `2^{n-B}` elements. Every input lies in exactly one part. [TwoSourceExtractorsFor, node_38] -/
theorem affine_decomposition {n : ℕ} (f : AffMap n) (B : ℕ) (hB : B ≤ n) :
    ∃ (m : ℕ) (P : Fin m → Submodule (ZMod 2) (V n) × V n) (R : Finset (V n)),
      m ≤ B ∧
      (∀ i, n - B ≤ Module.finrank (ZMod 2) (P i).1) ∧
      (∀ i, ∀ x ∈ affSupp (P i).1 (P i).2, f.apply x ≠ x) ∧
      (∀ x : V n, (x ∈ R ∧ ∀ i, x ∉ affSupp (P i).1 (P i).2) ∨
        (x ∉ R ∧ ∃! i, x ∈ affSupp (P i).1 (P i).2)) ∧
      (((∀ x ∈ R, f.apply x = x) ∧
          (R = ∅ ∨ ∃ (W : Submodule (ZMod 2) (V n)) (v : V n),
            R = affSupp W v ∧ n - B ≤ Module.finrank (ZMod 2) W)) ∨
        R.card * 2 ^ B ≤ 2 ^ n) := by
  sorry

/-- Step 3: uniform-input joint simulation for an arbitrary affine map. The
simulator `S` mixes, with message-independent weights (the probabilities of the
pieces), the tampered outputs on fixed-point-free pieces and `same⋆` on the
fixed piece. [TwoSourceExtractorsFor, node_38] -/
theorem joint_simulation {n r : ℕ} (E : V n → V r) (γ c : ℝ)
    (hγ0 : 0 < γ) (hγ1 : γ < 1) (hc : 0 < c) (hn : 1 ≤ n)
    (hE : RestrictedNMExt E γ c) (f : AffMap n) :
    ∃ S : FinDist (Option (V r)),
      tv (jointReal E f Finset.univ) (simJoint S)
        ≤ (2 : ℝ) ^ (-(c * n)) + ((n : ℝ) + 1) * (2 : ℝ) ^ (-(⌊γ * n / 2⌋₊ : ℝ)) := by
  sorry

/-- Step 4: data processing for total variation distance. [TwoSourceExtractorsFor, node_38] -/
theorem tv_push_le {α β : Type} [Fintype α] [Fintype β] (g : α → β)
    (p q : α → ℝ) : tv (push g p) (push g q) ≤ tv p q := by
  sorry

/-- Projection of the simulated joint law to the first `k` bits of both
coordinates is again of the form `(U_k, copy(S', U_k))`, with `S'` the push of
`S` (`FinDist.map`) along `some z ↦ some (prefix z)`, `none ↦ none`. [TwoSourceExtractorsFor, node_38] -/
theorem push_simJoint_prefix {r k : ℕ} (hk : k ≤ r) (S : FinDist (Option (V r))) :
    push (fun z : V r × V r => (prefixOf hk z.1, prefixOf hk z.2)) (simJoint S)
      = simJoint (FinDist.map (Option.map (prefixOf hk)) S) := by
  sorry

/-- Step 5a: "equal fibre cardinalities imply that this procedure samples
uniformly from the entire decoder fibre of `s`". [TwoSourceExtractorsFor, node_38] -/
theorem twoStep_eq_encDist {n r k : ℕ} (E : V n → V r) (hk : k ≤ r)
    (hbal : BalancedFibres E) (s : V k) :
    twoStepDist E hk s = encDist (decPrefix E hk) s := by
  sorry

/-- Step 5b: perfect correctness: `Enc(s)` is a probability vector supported on
`Dec⁻¹(s)`. Also the decoded message of a uniform block is exactly uniform. [TwoSourceExtractorsFor, node_38] -/
theorem perfect_correctness {n r k : ℕ} (E : V n → V r) (hk : k ≤ r)
    (hbal : BalancedFibres E) (s : V k) :
    IsProbVec (encDist (decPrefix E hk) s) ∧
    (∀ x, encDist (decPrefix E hk) s x ≠ 0 → decPrefix E hk x = s) ∧
    FinDist.map (decPrefix E hk) (FinDist.uniform (V n))
      = FinDist.uniform (V k) := by
  sorry

/-- Step 6: conditioning loss. If the joint law `p` of `(D, D')` has exactly
uniform first marginal and is `η`-close to `(U, copy(S, U))`, then for every
`s` the conditional law of `D'` given `D = s` is `2^k η`-close to
`copy(S, s)`. [TwoSourceExtractorsFor, node_38] -/
theorem conditioning_loss {k : ℕ} (p : FinDist (V k × V k)) (S : FinDist (Option (V k)))
    (hmarg : ∀ s, ∑ y, p (s, y) = 1 / (2 : ℝ) ^ k) (s : V k) :
    tv (condSnd p.prob s) (copyDist S s) ≤ (2 : ℝ) ^ k * tv p.prob (simJoint S) := by
  sorry

/-- The conditional law of `Dec(f(X))` given `Dec(X) = s` for uniform `X` is
exactly `Dec(f(Enc(s)))`. [TwoSourceExtractorsFor, node_38] -/
theorem condSnd_eq_tampered {n r k : ℕ} (E : V n → V r) (hk : k ≤ r)
    (hbal : BalancedFibres E) (f : AffMap n) (s : V k) :
    condSnd (push (fun z : V r × V r => (prefixOf hk z.1, prefixOf hk z.2))
        (jointReal E f Finset.univ)) s
      = tamperedDecDist (decPrefix E hk) f s := by
  sorry

/-- Step 7: parameter budget. For `0 < ρ < min{a, c/2, γ/4}` and large `n`,
`⌊ρ n⌋ ≤ a n` and `2^{⌊ρn⌋}(2^{-cn} + (n+1) 2^{-⌊γn/2⌋}) ≤ 2^{-δ n}`. [TwoSourceExtractorsFor, node_38] -/
theorem parameter_budget (γ a c ρ : ℝ) (hγ0 : 0 < γ) (hγ1 : γ < 1)
    (ha : 0 < a) (hc : 0 < c) (hρ0 : 0 < ρ) (hρa : ρ < a) (hρc : ρ < c / 2)
    (hργ : ρ < γ / 4) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      (⌊ρ * n⌋₊ : ℝ) ≤ a * n ∧ ρ * n / 2 ≤ (⌊ρ * n⌋₊ : ℝ) ∧
      (2 : ℝ) ^ (⌊ρ * n⌋₊ : ℝ) *
          ((2 : ℝ) ^ (-(c * n)) + ((n : ℝ) + 1) * (2 : ℝ) ^ (-(⌊γ * n / 2⌋₊ : ℝ)))
        ≤ (2 : ℝ) ^ (-(δ * n)) := by
  sorry

/-! ## Main theorems -/

/-- Main theorem (explicit form). Let `E_n` be the supplied family, valid for
`n ≥ N₀`, with `a n ≤ r(n) ≤ n`. For `0 < ρ < min{a, c/2, γ/4}` and
`k = ⌊ρ n⌋`, the code `Dec = first k bits of E_n`, `Enc(s)` = uniform on
`Dec⁻¹(s)` is perfectly correct and affine non-malleable with error
`2^k (2^{-cn} + (n+1) 2^{-⌊γn/2⌋})` for all `n ≥ N₀` with `k ≤ r(n)`. [TwoSourceExtractorsFor, node_38] -/
theorem nm_code_explicit (γ a c ρ : ℝ) (hγ0 : 0 < γ) (hγ1 : γ < 1)
    (ha : 0 < a) (hc : 0 < c) (hρ0 : 0 < ρ) (hρa : ρ < a) (hρc : ρ < c / 2)
    (hργ : ρ < γ / 4)
    (r : ℕ → ℕ) (E : (n : ℕ) → V n → V (r n)) (N₀ : ℕ)
    (hr : ∀ n, N₀ ≤ n → a * n ≤ (r n : ℝ) ∧ r n ≤ n)
    (hE : ∀ n, N₀ ≤ n → RestrictedNMExt (E n) γ c)
    (hbal : ∀ n, N₀ ≤ n → BalancedFibres (E n))
    (n : ℕ) (hn : N₀ ≤ n) (hn1 : 1 ≤ n) (hk : ⌊ρ * n⌋₊ ≤ r n) :
    (∀ s, IsProbVec (encDist (decPrefix (E n) hk) s) ∧
      ∀ x, encDist (decPrefix (E n) hk) s x ≠ 0 → decPrefix (E n) hk x = s) ∧
    (∀ s, twoStepDist (E n) hk s = encDist (decPrefix (E n) hk) s) ∧
    IsAffineNMCode (decPrefix (E n) hk)
      ((2 : ℝ) ^ (⌊ρ * n⌋₊ : ℝ) *
        ((2 : ℝ) ^ (-(c * n)) + ((n : ℝ) + 1) * (2 : ℝ) ^ (-(⌊γ * n / 2⌋₊ : ℝ)))) := by
  sorry

/-- Main theorem (asymptotic form): constant rate `k ≥ ρ n`, `k ≤ r(n)`,
perfect correctness, an exact two-step sampler, and error `2^{-δ k}` for every
large enough block length `n`. [TwoSourceExtractorsFor, node_38] -/
theorem nm_code_exists (γ a c : ℝ) (hγ0 : 0 < γ) (hγ1 : γ < 1)
    (ha : 0 < a) (hc : 0 < c)
    (r : ℕ → ℕ) (E : (n : ℕ) → V n → V (r n)) (N₀ : ℕ)
    (hr : ∀ n, N₀ ≤ n → a * n ≤ (r n : ℝ) ∧ r n ≤ n)
    (hE : ∀ n, N₀ ≤ n → RestrictedNMExt (E n) γ c)
    (hbal : ∀ n, N₀ ≤ n → BalancedFibres (E n)) :
    ∃ ρ δ : ℝ, 0 < ρ ∧ 0 < δ ∧ ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      ∃ k : ℕ, ∃ hk : k ≤ r n, ρ * n ≤ (k : ℝ) ∧ 1 ≤ k ∧
        (∀ s, IsProbVec (encDist (decPrefix (E n) hk) s) ∧
          ∀ x, encDist (decPrefix (E n) hk) s x ≠ 0 → decPrefix (E n) hk x = s) ∧
        (∀ s, twoStepDist (E n) hk s = encDist (decPrefix (E n) hk) s) ∧
        IsAffineNMCode (decPrefix (E n) hk) ((2 : ℝ) ^ (-(δ * k))) := by
  sorry

end TCSChallenge.TwoSourceExtractorsFor.node_38
