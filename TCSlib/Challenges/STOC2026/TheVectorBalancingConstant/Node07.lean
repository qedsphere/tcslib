/-!
## Gaussian measure of sections of normalized zonotopes

A zonotope `K ⊆ ℝ^d` is *normalized* if `K = √(d/m) Aᵀ [-1,1]^m` with `A ∈ ℝ^{m×d}`,
`AᵀA = I_d`, `m ≥ d ≥ 1`, and rows `aᵢ` satisfying `‖aᵢ‖₂ ≤ 2√(d/m)`.

Main theorem (`main_theorem`): there is a universal `C > 0` such that for every normalized
zonotope `K`, every `n`-dimensional subspace `H` and every `t ≥ 1`,
`γ_H((tCK) ∩ H) ≥ exp(-e^{-t²/2} n)`.

Lemma stubs follow the rubric: isotropic section estimate, spectral extension, relative
partition step, recursive block partition, and Gaussian log-concave recombination.
-/

open MeasureTheory ProbabilityTheory
open scoped NNReal ENNReal

namespace TCSChallenge.TheVectorBalancingConstant.node_07

/-- Euclidean inner product on `ℝ^d = Fin d → ℝ`. -/
def dot {d : ℕ} (x y : Fin d → ℝ) : ℝ := ∑ k, x k * y k

/-- Squared Euclidean norm `‖x‖₂²`. -/
def sqNorm {d : ℕ} (x : Fin d → ℝ) : ℝ := dot x x

/-- Standard Gaussian measure `N(0, I_n)` on `ℝ^n`: the product of TCSlib's
`standardGaussianMeasure` (`= gaussianReal 0 1`). -/
abbrev stdGauss (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ : Fin n => BooleanAnalysis.ThresholdFunctions.standardGaussianMeasure)

/-- The zonotope `{∑ᵢ zᵢ vᵢ : |zᵢ| ≤ 1}` generated by `v₁, …, v_N`. -/
def zonotope {d N : ℕ} (v : Fin N → Fin d → ℝ) : Set (Fin d → ℝ) :=
  {x | ∃ z : Fin N → ℝ, (∀ i, |z i| ≤ 1) ∧ x = ∑ i, z i • v i}

/-- `sK = {s x : x ∈ K}`. -/
def dilate {d : ℕ} (s : ℝ) (S : Set (Fin d → ℝ)) : Set (Fin d → ℝ) :=
  {y | ∃ x ∈ S, y = s • x}

/-- "`A ∈ ℝ^{m×d}`, `AᵀA = I_d`, … `‖aᵢ‖₂ ≤ 2√(d/m)`": `A i` is the `i`-th row `aᵢ`. -/
def IsNormalizedRep {d m : ℕ} (A : Fin m → Fin d → ℝ) : Prop :=
  (∀ k l : Fin d, ∑ i, A i k * A i l = if k = l then 1 else 0) ∧
  ∀ i, Real.sqrt (sqNorm (A i)) ≤ 2 * Real.sqrt ((d : ℝ) / m)

/-- The normalized zonotope `K = √(d/m) Aᵀ B_∞^m`, generated by the vectors `√(d/m) aᵢ`. -/
def normalizedZonotope {d m : ℕ} (A : Fin m → Fin d → ℝ) : Set (Fin d → ℝ) :=
  zonotope (fun i => Real.sqrt ((d : ℝ) / m) • A i)

/-- `U₁, …, U_n` is an orthonormal family in `ℝ^d` (an orthonormal basis of `H = span U`). -/
def OrthonormalFamily {d n : ℕ} (U : Fin n → Fin d → ℝ) : Prop :=
  ∀ j j' : Fin n, dot (U j) (U j') = if j = j' then 1 else 0

/-- `γ_H(S)` for `H = span U`: the probability that `∑ⱼ gⱼ Uⱼ ∈ S`, `g ∼ N(0, I_n)`. -/
def sectionMeasure {d n : ℕ} (U : Fin n → Fin d → ℝ) (S : Set (Fin d → ℝ)) : ℝ≥0∞ :=
  stdGauss n {g | ∑ j, g j • U j ∈ S}

/-- `p_n(t) = exp(-e^{-t²/2} n)`. -/
def pBound (n : ℕ) (t : ℝ) : ℝ := Real.exp (-(Real.exp (-t ^ 2 / 2)) * n)

/-- `∑ᵢ vᵢvᵢᵀ = I` (as quadratic forms; the matrix is symmetric). -/
def IsIsotropic {d N : ℕ} (v : Fin N → Fin d → ℝ) : Prop :=
  ∀ x : Fin d → ℝ, ∑ i, dot (v i) x ^ 2 = sqNorm x

/-- `∑_{i ∈ S} vᵢvᵢᵀ ⪰ α I`. -/
def CovGEOn {d N : ℕ} (v : Fin N → Fin d → ℝ) (S : Finset (Fin N)) (α : ℝ) : Prop :=
  ∀ x : Fin d → ℝ, α * sqNorm x ≤ ∑ i ∈ S, dot (v i) x ^ 2

/-- **Vector partition theorem** (given): if `∑ vᵢvᵢᵀ = I_r` and `‖vᵢ‖² ≤ ε`, there is a
partition `S₁ ⊔ S₂` with `‖∑_{i∈Sⱼ} vᵢvᵢᵀ - ½ I‖_op ≤ 3√ε` for `j = 1, 2`. -/
def VectorPartitionTheorem : Prop :=
  ∀ (r N : ℕ) (v : Fin N → Fin r → ℝ) (ε : ℝ), IsIsotropic v → (∀ i, sqNorm (v i) ≤ ε) →
    ∃ S : Finset (Fin N),
      (∀ x : Fin r → ℝ,
        |∑ i ∈ S, dot (v i) x ^ 2 - sqNorm x / 2| ≤ 3 * Real.sqrt ε * sqNorm x) ∧
      (∀ x : Fin r → ℝ,
        |∑ i ∈ Sᶜ, dot (v i) x ^ 2 - sqNorm x / 2| ≤ 3 * Real.sqrt ε * sqNorm x)

/-- **Gaussian correlation theorem** (given): `γ(E ∩ F) ≥ γ(E) γ(F)` for measurable symmetric
convex `E, F`. -/
def GaussianCorrelation : Prop :=
  ∀ (q : ℕ) (E F : Set (Fin q → ℝ)), MeasurableSet E → MeasurableSet F →
    Convex ℝ E → Convex ℝ F → (∀ x ∈ E, -x ∈ E) → (∀ x ∈ F, -x ∈ F) →
    stdGauss q E * stdGauss q F ≤ stdGauss q (E ∩ F)

/-- **Prékopa–Leindler inequality** (given), w.r.t. Lebesgue measure on `ℝ^q`. -/
def PrekopaLeindler : Prop :=
  ∀ (q : ℕ) (lam : ℝ), 0 < lam → lam < 1 →
    ∀ f g h : (Fin q → ℝ) → ℝ,
      (∀ x, 0 ≤ f x) → (∀ x, 0 ≤ g x) → (∀ x, 0 ≤ h x) →
      Integrable f → Integrable g → Integrable h →
      (∀ x y, f x ^ lam * g y ^ (1 - lam) ≤ h (lam • x + (1 - lam) • y)) →
      (∫ x, f x) ^ lam * (∫ x, g x) ^ (1 - lam) ≤ ∫ x, h x

/-- Strip estimate: for `‖u‖ ≤ 1` and `t ≥ 1`,
`P(|⟨u, g⟩| ≤ t) ≥ exp(-e^{-t²/2} ‖u‖²)`. [TheVectorBalancingConstant, node_07] -/
theorem strip_estimate (n : ℕ) (u : Fin n → ℝ) (hu : sqNorm u ≤ 1) (t : ℝ) (ht : 1 ≤ t) :
    ENNReal.ofReal (Real.exp (-(Real.exp (-t ^ 2 / 2)) * sqNorm u)) ≤
      stdGauss n {g | |dot u g| ≤ t} := by
  sorry

/-- Rubric 1 (isotropic section estimate): if `∑ bᵢbᵢᵀ = I_d` then
`γ_H((tZ) ∩ H) ≥ p_n(t)` for every `n`-dimensional `H` and `t ≥ 1`. [TheVectorBalancingConstant, node_07] -/
theorem isotropic_section_estimate (hGCT : GaussianCorrelation)
    {d N n : ℕ} (b : Fin N → Fin d → ℝ) (hb : IsIsotropic b)
    (U : Fin n → Fin d → ℝ) (hU : OrthonormalFamily U) (t : ℝ) (ht : 1 ≤ t) :
    ENNReal.ofReal (pBound n t) ≤ sectionMeasure U (dilate t (zonotope b)) := by
  sorry

/-- Rubric 2 (spectral extension): if `∑ vᵢvᵢᵀ ⪰ αI` with `α > 0`, then
`γ_H(((t/√α) Z) ∩ H) ≥ p_n(t)`. [TheVectorBalancingConstant, node_07] -/
theorem spectral_extension (hGCT : GaussianCorrelation)
    {d N n : ℕ} (v : Fin N → Fin d → ℝ) (α : ℝ) (hα : 0 < α)
    (hv : CovGEOn v Finset.univ α)
    (U : Fin n → Fin d → ℝ) (hU : OrthonormalFamily U) (t : ℝ) (ht : 1 ≤ t) :
    ENNReal.ofReal (pBound n t) ≤
      sectionMeasure U (dilate (t / Real.sqrt α) (zonotope v)) := by
  sorry

/-- Rubric 3 (relative partition step): if `∑_{i∈S} vᵢvᵢᵀ ⪰ LI`, `L > 0`, and
`‖vᵢ‖² ≤ ε` on `S`, then `S` splits into two parts each with covariance
`⪰ (L/2 - 3√(Lε)) I`. [TheVectorBalancingConstant, node_07] -/
theorem relative_split (hVPT : VectorPartitionTheorem)
    {d N : ℕ} (v : Fin N → Fin d → ℝ) (S : Finset (Fin N)) (L ε : ℝ) (hL : 0 < L)
    (hS : CovGEOn v S L) (hε : ∀ i ∈ S, sqNorm (v i) ≤ ε) :
    ∃ S₁ ⊆ S, CovGEOn v S₁ (L / 2 - 3 * Real.sqrt (L * ε)) ∧
      CovGEOn v (S \ S₁) (L / 2 - 3 * Real.sqrt (L * ε)) := by
  sorry

/-- Rubric 4 (recursive spectral control): with `D = 14400`, the rows of a normalized
representation split into `k ≥ m/(2Dd)` blocks `J_ℓ` with `∑_{i∈J_ℓ} aᵢaᵢᵀ ⪰ (1/(2k)) I`. [TheVectorBalancingConstant, node_07] -/
theorem block_partition (hVPT : VectorPartitionTheorem)
    {d m : ℕ} (hd : 1 ≤ d) (hdm : d ≤ m) (A : Fin m → Fin d → ℝ) (hA : IsNormalizedRep A) :
    ∃ (k : ℕ) (J : Fin m → Fin k), 1 ≤ k ∧
      (m : ℝ) / (2 * 14400 * d) ≤ k ∧
      ∀ ℓ : Fin k, CovGEOn A (Finset.univ.filter (fun i => J i = ℓ)) (1 / (2 * (k : ℝ))) := by
  sorry

/-- Rubric 6 (Gaussian log-concavity, weights `1/k`):
`γ((1/k)E₁ + ⋯ + (1/k)E_k) ≥ ∏_ℓ γ(E_ℓ)^{1/k}`. [TheVectorBalancingConstant, node_07] -/
theorem gaussian_logconcave_average (hPL : PrekopaLeindler)
    (n k : ℕ) (hk : 1 ≤ k) (E : Fin k → Set (Fin n → ℝ)) (hE : ∀ ℓ, MeasurableSet (E ℓ)) :
    ∏ ℓ, (stdGauss n (E ℓ)) ^ ((1 : ℝ) / k) ≤
      stdGauss n {y | ∃ x : Fin k → Fin n → ℝ, (∀ ℓ, x ℓ ∈ E ℓ) ∧
        y = ∑ ℓ, ((1 : ℝ) / k) • x ℓ} := by
  sorry

/-- **Main theorem.** There is a universal `C > 0` such that for every normalized zonotope
`K ⊆ ℝ^d`, every `n`-dimensional subspace `H = span U` and every `t ≥ 1`,
`γ_H((tCK) ∩ H) ≥ exp(-e^{-t²/2} n)`. (The reference proof gives `C = 240`.) [TheVectorBalancingConstant, node_07] -/
theorem main_theorem (hVPT : VectorPartitionTheorem) (hGCT : GaussianCorrelation)
    (hPL : PrekopaLeindler) :
    ∃ C : ℝ, 0 < C ∧
      ∀ (d m : ℕ), 1 ≤ d → d ≤ m →
        ∀ A : Fin m → Fin d → ℝ, IsNormalizedRep A →
          ∀ (n : ℕ) (U : Fin n → Fin d → ℝ), OrthonormalFamily U →
            ∀ t : ℝ, 1 ≤ t →
              ENNReal.ofReal (pBound n t) ≤
                sectionMeasure U (dilate (t * C) (normalizedZonotope A)) := by
  sorry

end TCSChallenge.TheVectorBalancingConstant.node_07
