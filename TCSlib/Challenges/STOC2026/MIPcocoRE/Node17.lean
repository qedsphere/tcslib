/-!
## Gap compression from three uniform compilers

We are given three abstract compilers:
* `F a K` (Interface (I)): any verifier ↦ synchronous level-3 verifier with the fixed sampler
  `U_{a,K}`, decider padded to length `H(a,K)`, sampling complexity `≤ log^{u} n`,
  verification complexity `≤ n^{b}`, and gap loss `ε ↦ q_{a,K}(ε,n) ≥ C_F⁻¹ ε^{A_F}`;
* `E b` (Interface (II)): synchronous level-3 verifier with complexities `≤ n^b` ↦ synchronous
  level-6 verifier, complexities `≤ log^{c_E(b)} n`, sampler a function of
  `(b, Q_W, |D_W|)`, gap loss `δ ↦ e_b(δ,n) ≥ C_E⁻¹ δ^{A_E} log^{-B_E} n`;
* `R c η` (Interface (III)): synchronous level-6 verifier with complexities `≤ log^c n` and an
  admissible gap `η ≥ C⁻¹ log^{-d} n` ↦ synchronous level-7 verifier with complexities
  `≤ log^{w(c,d,⌈log C⌉)} n` and soundness `1/2`, sampler a function of `(c, η, Q_Z)`.

The main theorem `gap_compression` asserts the existence of `Gapcompress_{α,k}` and an exponent
`γ = poly(α,k)` with: input-independent sampler, synchronous level-7 output with
`O(log^γ n)` complexities, and — for synchronous `k'<k`-level inputs of complexity `≤ n^α`
beyond `n₀` — preservation of perfect oracularizable strategies and of soundness `1/2` in
both models beyond a threshold `poly(γ, n₀)`.
-/

namespace TCSChallenge.MIPcocoRE.node_17

/-- The two value models: `t = *` (tensor product) and `t = co` (commuting operator). -/
inductive Model where
  | tensor
  | commuting

/-- Abstract universe of CL verifiers. `Ver` is the type of verifiers `V = (Q, D)`, `Smp` the
type of samplers. All fields are data (no axioms). -/
structure VerifierUniverse (Ver Smp : Type) where
  /-- the sampler `Q` of a verifier -/
  sampler : Ver → Smp
  /-- the description length `|D|` of the decider -/
  deciderLen : Ver → ℕ
  /-- "an ℓ-level conditionally linear verifier": the level `ℓ` -/
  level : Ver → ℕ
  /-- "A game is synchronous if equal questions require equal answers." -/
  synchronous : Ver → Prop
  /-- sampling complexity at index `n` -/
  sampComp : Ver → ℕ → ℕ
  /-- verification complexity (running time of `D`) at index `n` -/
  verComp : Ver → ℕ → ℕ
  /-- `ω^t(V_n)`: supremal value of the `n`-th game of `V` in model `t` -/
  value : Model → Ver → ℕ → ℝ
  /-- the `n`-th game of `V` has a perfect oracularizable strategy in model `t` -/
  perfectOrac : Model → Ver → ℕ → Prop

variable {Ver Smp : Type}

/-- Polynomially bounded function of one natural parameter. -/
def PolyBounded1 (f : ℕ → ℕ) : Prop :=
  ∃ c : ℕ, ∀ x, f x ≤ c * (x + 2) ^ c

/-- Polynomially bounded function of two natural parameters. -/
def PolyBounded2 (f : ℕ → ℕ → ℕ) : Prop :=
  ∃ c : ℕ, ∀ x y, f x y ≤ c * (x + y + 2) ^ c

/-- Polynomially bounded function of three natural parameters. -/
def PolyBounded3 (f : ℕ → ℕ → ℕ → ℕ) : Prop :=
  ∃ c : ℕ, ∀ x y z, f x y z ≤ c * (x + y + z + 2) ^ c

/-- "complexity at most `n^e` for `n ≥ n₀`" (both sampling and verification). -/
def PolyComplexity (U : VerifierUniverse Ver Smp) (V : Ver) (e n₀ : ℕ) : Prop :=
  ∀ n : ℕ, n₀ ≤ n → U.sampComp V n ≤ n ^ e ∧ U.verComp V n ≤ n ^ e

/-- "both complexities at most `log^c n`" (for `n ≥ 2`, log base 2). -/
def PolylogComplexity (U : VerifierUniverse Ver Smp) (V : Ver) (c : ℕ) : Prop :=
  ∀ n : ℕ, 2 ≤ n →
    (U.sampComp V n : ℝ) ≤ Real.logb 2 (n : ℝ) ^ c ∧
    (U.verComp V n : ℝ) ≤ Real.logb 2 (n : ℝ) ^ c

/-- "`η` is admissible with data `(C,d)` if `η(n) ≥ C⁻¹ log^{-d} n`." -/
def Admissible (η : ℕ → ℝ) (C d : ℕ) : Prop :=
  1 ≤ C ∧ ∀ n : ℕ, 2 ≤ n → (C : ℝ)⁻¹ * (Real.logb 2 (n : ℝ) ^ d)⁻¹ ≤ η n

/-- The data of the three compilers (F), (E), (R) and their numerical parameters. -/
structure CompilerData (Ver Smp : Type) where
  F : ℕ → ℕ → Ver → Ver
  /-- the fixed universal sampler `U_{a,K}` -/
  Ufix : ℕ → ℕ → Smp
  uF : ℕ → ℕ → ℕ
  bF : ℕ → ℕ → ℕ
  HF : ℕ → ℕ → ℕ
  /-- threshold for (F) as a function of `(n₀, a, K)` -/
  thrF : ℕ → ℕ → ℕ → ℕ
  /-- gap loss `q_{a,K}(ε, n)` -/
  qF : ℕ → ℕ → ℝ → ℕ → ℝ
  AF : ℕ → ℕ → ℕ
  CF : ℕ → ℕ → ℕ
  E : ℕ → Ver → Ver
  /-- `Q_Z` is determined by `(b, Q_W, |D_W|)` -/
  sE : ℕ → Smp → ℕ → Smp
  cE : ℕ → ℕ
  thrE : ℕ → ℕ
  /-- gap loss `e_b(δ, n)` -/
  eE : ℕ → ℝ → ℕ → ℝ
  AE : ℕ → ℕ
  BE : ℕ → ℕ
  CE : ℕ → ℕ
  R : ℕ → (ℕ → ℝ) → Ver → Ver
  /-- the sampler of `R_{c,η}(Z)` is determined by `(c, η, Q_Z)` -/
  sR : ℕ → (ℕ → ℝ) → Smp → Smp
  w : ℕ → ℕ → ℕ → ℕ
  /-- threshold for (R) as a function of `(c, d, ⌈log C⌉)` -/
  thrR : ℕ → ℕ → ℕ → ℕ

/-- The assumed guarantees (F), (E), (R) of the problem statement. -/
def CompilerAxioms (U : VerifierUniverse Ver Smp) (D : CompilerData Ver Smp) : Prop :=
  -- (F): unconditional syntactic conclusions
  (∀ a K V, U.synchronous (D.F a K V) ∧ U.level (D.F a K V) = 3 ∧
      U.sampler (D.F a K V) = D.Ufix a K ∧ U.deciderLen (D.F a K V) = D.HF a K ∧
      ∀ n : ℕ, 2 ≤ n →
        (U.sampComp (D.F a K V) n : ℝ) ≤ Real.logb 2 (n : ℝ) ^ D.uF a K ∧
        U.verComp (D.F a K V) n ≤ n ^ D.bF a K) ∧
  -- (F): semantic conclusions
  (∀ a K (V : Ver) (K' n₀ : ℕ), U.synchronous V → U.level V = K' → K' < K →
      PolyComplexity U V a n₀ →
      ∀ n, D.thrF n₀ a K ≤ n → ∀ t : Model,
        (U.perfectOrac t V n → U.perfectOrac t (D.F a K V) n) ∧
        ∀ ε : ℝ, 0 < ε → U.value t V n ≤ 1 - ε →
          U.value t (D.F a K V) n ≤ 1 - D.qF a K ε n) ∧
  (∀ a K, 1 ≤ D.CF a K) ∧
  (∀ a K (ε : ℝ) n, 0 < ε → (D.CF a K : ℝ)⁻¹ * ε ^ D.AF a K ≤ D.qF a K ε n) ∧
  PolyBounded2 D.uF ∧ PolyBounded2 D.bF ∧ PolyBounded2 D.HF ∧ PolyBounded2 D.AF ∧
  PolyBounded2 (fun a K => Nat.log 2 (D.CF a K)) ∧ PolyBounded3 D.thrF ∧
  -- (E)
  (∀ b W, U.sampler (D.E b W) = D.sE b (U.sampler W) (U.deciderLen W)) ∧
  (∀ b W, U.synchronous W → U.level W = 3 → PolyComplexity U W b 2 →
      U.synchronous (D.E b W) ∧ U.level (D.E b W) = 6 ∧
      PolylogComplexity U (D.E b W) (D.cE b) ∧
      ∀ n, D.thrE b ≤ n → ∀ t : Model,
        (U.perfectOrac t W n → U.perfectOrac t (D.E b W) n) ∧
        ∀ δ : ℝ, 0 < δ → U.value t W n ≤ 1 - δ →
          U.value t (D.E b W) n ≤ 1 - D.eE b δ n) ∧
  (∀ b, 1 ≤ D.CE b) ∧
  (∀ b (δ : ℝ) (n : ℕ), 0 < δ → 2 ≤ n →
      (D.CE b : ℝ)⁻¹ * δ ^ D.AE b * (Real.logb 2 (n : ℝ) ^ D.BE b)⁻¹ ≤ D.eE b δ n) ∧
  PolyBounded1 D.cE ∧ PolyBounded1 D.AE ∧ PolyBounded1 D.BE ∧
  PolyBounded1 (fun b => Nat.log 2 (D.CE b)) ∧ PolyBounded1 D.thrE ∧
  -- (R)
  (∀ c η Z, U.sampler (D.R c η Z) = D.sR c η (U.sampler Z)) ∧
  (∀ (c : ℕ) (η : ℕ → ℝ) (Z : Ver) (C d : ℕ), U.synchronous Z → U.level Z = 6 →
      PolylogComplexity U Z c → Admissible η C d →
      U.synchronous (D.R c η Z) ∧ U.level (D.R c η Z) = 7 ∧
      PolylogComplexity U (D.R c η Z) (D.w c d (Nat.log 2 C)) ∧
      ∀ n, D.thrR c d (Nat.log 2 C) ≤ n → ∀ t : Model,
        (U.perfectOrac t Z n → U.perfectOrac t (D.R c η Z) n) ∧
        (U.value t Z n ≤ 1 - η n → U.value t (D.R c η Z) n ≤ 1 / 2)) ∧
  PolyBounded3 D.w ∧ PolyBounded3 D.thrR

/-- The hand-off exponent `β = max{2, u(α,k), b(α,k)}`. -/
def betaExp (D : CompilerData Ver Smp) (α k : ℕ) : ℕ :=
  max 2 (max (D.uF α k) (D.bF α k))

/-- The nested gap `η(n) = e_β(q_{α,k}(1/2, n), n)` supplied to the amplifier. -/
def nestedGap (D : CompilerData Ver Smp) (α k : ℕ) : ℕ → ℝ :=
  fun n => D.eE (betaExp D α k) (D.qF α k (1 / 2) n) n

/-- Rubric 1: the output of `F_{α,k}` satisfies the syntactic hypotheses of `E_β`. [MIPcocoRE, node_17] -/
theorem F_output_feeds_E (U : VerifierUniverse Ver Smp) (D : CompilerData Ver Smp)
    (hD : CompilerAxioms U D) (α k : ℕ) (V : Ver) :
    U.synchronous (D.F α k V) ∧ U.level (D.F α k V) = 3 ∧
      PolyComplexity U (D.F α k V) (betaExp D α k) 2 := by
  sorry

/-- Rubric 3: the nested gap is admissible with polynomially bounded data. [MIPcocoRE, node_17] -/
theorem nestedGap_admissible (U : VerifierUniverse Ver Smp) (D : CompilerData Ver Smp)
    (hD : CompilerAxioms U D) :
    ∃ C d : ℕ → ℕ → ℕ, PolyBounded2 d ∧ PolyBounded2 (fun α k => Nat.log 2 (C α k)) ∧
      ∀ α k, Admissible (nestedGap D α k) (C α k) (d α k) := by
  sorry

/-- Rubric 4: the composed sampler does not depend on the input verifier. [MIPcocoRE, node_17] -/
theorem composed_sampler_independent (U : VerifierUniverse Ver Smp)
    (D : CompilerData Ver Smp) (hD : CompilerAxioms U D) (α k : ℕ) (V V' : Ver) :
    U.sampler (D.R (D.cE (betaExp D α k)) (nestedGap D α k)
        (D.E (betaExp D α k) (D.F α k V))) =
      U.sampler (D.R (D.cE (betaExp D α k)) (nestedGap D α k)
        (D.E (betaExp D α k) (D.F α k V'))) := by
  sorry

/-- **Gap compression.** From the interfaces (F), (E), (R) there is a compiler
`Gapcompress_{α,k}` with exponent `γ = poly(α,k)` and threshold `n₀^Comp = poly(γ, n₀)`. [MIPcocoRE, node_17] -/
theorem gap_compression (U : VerifierUniverse Ver Smp) (D : CompilerData Ver Smp)
    (hD : CompilerAxioms U D) :
    ∃ (Comp : ℕ → ℕ → Ver → Ver) (γ : ℕ → ℕ → ℕ) (thr : ℕ → ℕ → ℕ → ℕ),
      PolyBounded2 γ ∧
      (∃ c : ℕ, ∀ α k n₀, thr α k n₀ ≤ c * (γ α k + n₀ + 2) ^ c) ∧
      ∀ α k : ℕ,
        -- 2. sampler depends only on α, k; output synchronous level 7
        (∀ V V', U.sampler (Comp α k V) = U.sampler (Comp α k V')) ∧
        (∀ V, U.synchronous (Comp α k V) ∧ U.level (Comp α k V) = 7) ∧
        -- 3. both complexities O(log^γ n)
        (∀ V, ∃ C₀ : ℝ, ∀ n : ℕ, 2 ≤ n →
          (U.sampComp (Comp α k V) n : ℝ) ≤ C₀ * Real.logb 2 (n : ℝ) ^ γ α k ∧
          (U.verComp (Comp α k V) n : ℝ) ≤ C₀ * Real.logb 2 (n : ℝ) ^ γ α k) ∧
        -- semantic preservation
        (∀ (V : Ver) (k' n₀ : ℕ), U.synchronous V → U.level V = k' → k' < k →
          PolyComplexity U V α n₀ →
          ∀ n, thr α k n₀ ≤ n → ∀ t : Model,
            (U.perfectOrac t V n → U.perfectOrac t (Comp α k V) n) ∧
            (U.value t V n ≤ 1 / 2 → U.value t (Comp α k V) n ≤ 1 / 2)) := by
  sorry

end TCSChallenge.MIPcocoRE.node_17
