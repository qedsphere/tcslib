/-!
## Local expectation values of `A₁CQ` states reduce to polynomially many Pauli terms

`|ψ_n⟩ = Q C |0^n⟩` with `C` an arbitrary Clifford circuit (H, S, CNOT) and `Q` a depth-`d`
circuit of arbitrary `≤ 2`-qubit gates. For an observable `O` on `S`, `|S| = k ≤ c log₂ n`,

  `⟨ψ|O|ψ⟩ = ⟨0^n| C† (Q† O Q) C |0^n⟩`.

The light cone puts `Q† O Q` on a set `R` of at most `2^d k` qubits, so it is a combination of
the `4^{|R|}` Pauli operators `X^x Z^z` supported on `R`; Clifford conjugation sends each such
term to a single phased Pauli `i^φ X^{x'} Z^{z'}` (computed symbolically by `conjSymb`, possibly
with global support), whose `|0^n⟩` expectation is `i^φ` if `x' = 0` and `0` otherwise.
Main theorem: `A1CQ_local_expectation`.
-/

namespace TCSChallenge.QuantumCircuitLowerBounds.node_25

/-! ## Shared circuit model (identical in the node_04 file) -/

/-- An `n`-qubit operator: a complex matrix on the computational basis `{0,1}^n`. -/
abbrev Op (n : ℕ) : Type := Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ

/-- `A` acts only on the qubits in `S`, i.e. `A = A_S ⊗ I_{[n] \ S}`: entries vanish unless the
two basis strings agree off `S`, and then depend only on the restrictions to `S`. -/
def SupportedOn {n : ℕ} (S : Finset (Fin n)) (A : Op n) : Prop :=
  (∀ x y : Fin n → Fin 2, (∃ j, j ∉ S ∧ x j ≠ y j) → A x y = 0) ∧
  (∀ x y x' y' : Fin n → Fin 2, (∀ j, j ∈ S → x j = x' j ∧ y j = y' j) →
    (∀ j, j ∉ S → x j = y j ∧ x' j = y' j) → A x y = A x' y')

/-- "arbitrary one-qubit and two-qubit gates": a unitary supported on at most two qubits. -/
def IsGate {n : ℕ} (S : Finset (Fin n)) (G : Op n) : Prop :=
  S.card ≤ 2 ∧ SupportedOn S G ∧ G ∈ Matrix.unitaryGroup (Fin n → Fin 2) ℂ

/-- A layer: gates on pairwise disjoint sets of qubits. -/
def IsLayer {n : ℕ} (L : List (Finset (Fin n) × Op n)) : Prop :=
  (∀ g ∈ L, IsGate g.1 g.2) ∧ L.Pairwise (fun g h => Disjoint g.1 h.1)

/-- The unitary implemented by a layer. -/
def layerOp {n : ℕ} (L : List (Finset (Fin n) × Op n)) : Op n :=
  (L.map Prod.snd).prod

/-- `Q` is implemented by a bounded-fanin circuit of depth at most `d` (a `QNC⁰` block when `d`
is a constant independent of `n`). -/
def IsShallowCircuit {n : ℕ} (d : ℕ) (Q : Op n) : Prop :=
  ∃ Ls : List (List (Finset (Fin n) × Op n)),
    Ls.length ≤ d ∧ (∀ L ∈ Ls, IsLayer L) ∧ Q = (Ls.map layerOp).prod

/-- A one-qubit matrix `V` applied to qubit `a` (tensored with the identity elsewhere). -/
def embed1 {n : ℕ} (a : Fin n) (V : Matrix (Fin 2) (Fin 2) ℂ) : Op n :=
  Matrix.of fun x y => if (∀ j, j ≠ a → x j = y j) then V (x a) (y a) else 0

/-- Hadamard gate `(1/√2) [[1,1],[1,-1]]`. -/
def hadamard : Matrix (Fin 2) (Fin 2) ℂ :=
  Matrix.of fun r s => ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ * (if r = 1 ∧ s = 1 then -1 else 1)

/-- Phase gate `S = diag(1, i)`. -/
def sGate : Matrix (Fin 2) (Fin 2) ℂ :=
  Matrix.of fun r s => if r = s then (if r = 0 then 1 else Complex.I) else 0

/-- Clifford generators. -/
inductive CliffordGate (n : ℕ) where
  | h (a : Fin n)
  | s (a : Fin n)
  | cnot (c t : Fin n)

/-- `CNOT` with control `c` and target `t`: `|y⟩ ↦ |y with y_t ⊕= y_c⟩` (identity if `c = t`). -/
def cnotOp {n : ℕ} (c t : Fin n) : Op n :=
  if c = t then 1 else
    Matrix.of fun x y => if x = Function.update y t (y t + y c) then 1 else 0

/-- Matrix of a Clifford generator. -/
def cliffordGateOp {n : ℕ} : CliffordGate n → Op n
  | .h a => embed1 a hadamard
  | .s a => embed1 a sGate
  | .cnot c t => cnotOp c t

/-- A Clifford circuit (word in the generators, arbitrary length); `gs.head` is applied last. -/
def cliffordOp {n : ℕ} (gs : List (CliffordGate n)) : Op n :=
  (gs.map cliffordGateOp).prod

/-- "an arbitrary `n`-qubit Clifford circuit, with no depth restriction". -/
def IsCliffordCircuit {n : ℕ} (C : Op n) : Prop :=
  ∃ gs : List (CliffordGate n), C = cliffordOp gs

/-! ## Phased Pauli operators `i^φ X^x Z^z` and their symbolic Clifford update -/

/-- Symbolic phased Pauli `(φ, x, z)` standing for `i^φ ⊗_j X^{x_j} Z^{z_j}`. -/
abbrev SymPauli (n : ℕ) : Type := ℕ × (Fin n → Fin 2) × (Fin n → Fin 2)

/-- One-qubit `X^x Z^z`: `|s⟩ ↦ (-1)^{s z} |s + x⟩`. -/
def xzMat1 (x z : Fin 2) : Matrix (Fin 2) (Fin 2) ℂ :=
  Matrix.of fun r s => if r = s + x then (-1 : ℂ) ^ (s.val * z.val) else 0

/-- The matrix of a symbolic phased Pauli. -/
def pauliXZ {n : ℕ} (p : SymPauli n) : Op n :=
  Complex.I ^ p.1 • Matrix.of fun a b => ∏ j, xzMat1 (p.2.1 j) (p.2.2 j) (a j) (b j)

/-- Tableau rule for `g† P g`:
`H: X^a Z^b ↦ (-1)^{ab} X^b Z^a`; `S: X^a Z^b ↦ i^{3a} X^a Z^{a+b}`;
`CNOT(c,t): x_t += x_c, z_c += z_t` (no phase). -/
def gateConj {n : ℕ} : CliffordGate n → SymPauli n → SymPauli n
  | .h a, (φ, x, z) =>
      (φ + 2 * ((x a).val * (z a).val), Function.update x a (z a), Function.update z a (x a))
  | .s a, (φ, x, z) => (φ + 3 * (x a).val, x, Function.update z a (z a + x a))
  | .cnot c t, (φ, x, z) =>
      if c = t then (φ, x, z)
      else (φ, Function.update x t (x t + x c), Function.update z c (z c + z t))

/-- Symbolic `C† P C` for `C = cliffordOp gs` (conjugate by the head gate first). -/
def conjSymb {n : ℕ} (gs : List (CliffordGate n)) (p : SymPauli n) : SymPauli n :=
  gs.foldl (fun acc g => gateConj g acc) p

/-- `⟨0^n| i^φ X^x Z^z |0^n⟩`: `i^φ` if `x = 0`, else `0`. -/
def zeroExp {n : ℕ} (p : SymPauli n) : ℂ :=
  if p.2.1 = 0 then Complex.I ^ p.1 else 0

/-- Coefficient of `X^x Z^z` in the Pauli expansion: `tr((X^x Z^z)† A) / 2^n`. -/
def xzCoeff {n : ℕ} (A : Op n) (xz : (Fin n → Fin 2) × (Fin n → Fin 2)) : ℂ :=
  Matrix.trace (star (pauliXZ ((0 : ℕ), xz.1, xz.2)) * A) / (2 : ℂ) ^ n

/-- The `4^{|R|}` Pauli labels supported on `R`. -/
def pauliOn {n : ℕ} (R : Finset (Fin n)) : Finset ((Fin n → Fin 2) × (Fin n → Fin 2)) :=
  Finset.univ.filter (fun xz => ∀ j, j ∉ R → xz.1 j = 0 ∧ xz.2 j = 0)

/-- `⟨ψ|O|ψ⟩` for `|ψ⟩ = U|0^n⟩`, written as the `(0^n, 0^n)` entry of `U† O U`. -/
def zeroExpect {n : ℕ} (U O : Op n) : ℂ :=
  (star U * O * U) 0 0

/-! ## Lemma stubs -/

/-- Causal restriction: `Q† O Q` lives on the backward light cone `R`, `|R| ≤ 2^d |S|`, and
equals the conjugation by the reduced circuit made of the light-cone gates only. [QuantumCircuitLowerBounds, node_25] -/
theorem lightcone_reduced_circuit {n d : ℕ} (Q : Op n) (hQ : IsShallowCircuit d Q)
    (S : Finset (Fin n)) (O : Op n) (hO : SupportedOn S O) :
    ∃ R : Finset (Fin n), R.card ≤ 2 ^ d * S.card ∧ S ⊆ R ∧
      SupportedOn R (star Q * O * Q) ∧
      ∃ Ls : List (List (Finset (Fin n) × Op n)),
        Ls.length ≤ d ∧ (∀ L ∈ Ls, IsLayer L) ∧ (∀ L ∈ Ls, ∀ g ∈ L, g.1 ⊆ R) ∧
        star Q * O * Q = star (Ls.map layerOp).prod * O * (Ls.map layerOp).prod := by sorry

/-- There are exactly `4^{|R|}` Pauli labels on `R`. [QuantumCircuitLowerBounds, node_25] -/
theorem card_pauliOn {n : ℕ} (R : Finset (Fin n)) : (pauliOn R).card = 4 ^ R.card := by sorry

/-- Local Pauli expansion: an operator on `R` is a combination of the Paulis on `R`. [QuantumCircuitLowerBounds, node_25] -/
theorem pauli_expansion_on {n : ℕ} (R : Finset (Fin n)) (A : Op n) (hA : SupportedOn R A) :
    A = ∑ xz ∈ pauliOn R, xzCoeff A xz • pauliXZ ((0 : ℕ), xz.1, xz.2) := by sorry

/-- Correctness of the per-gate tableau rule. [QuantumCircuitLowerBounds, node_25] -/
theorem gateConj_correct {n : ℕ} (g : CliffordGate n) (p : SymPauli n) :
    star (cliffordGateOp g) * pauliXZ p * cliffordGateOp g = pauliXZ (gateConj g p) := by sorry

/-- Clifford conjugation maps one Pauli to one (possibly global) phased Pauli, computed by
`conjSymb`. [QuantumCircuitLowerBounds, node_25] -/
theorem conjSymb_correct {n : ℕ} (gs : List (CliffordGate n)) (p : SymPauli n) :
    star (cliffordOp gs) * pauliXZ p * cliffordOp gs = pauliXZ (conjSymb gs p) := by sorry

/-- Product-state evaluation of a phased Pauli. [QuantumCircuitLowerBounds, node_25] -/
theorem pauliXZ_zero_entry {n : ℕ} (p : SymPauli n) : pauliXZ p 0 0 = zeroExp p := by sorry

/-- Where `d = O(1)` and `k = O(log n)` enter: `4^{2^d k} ≤ n^{2^{d+1} c}`. [QuantumCircuitLowerBounds, node_25] -/
theorem term_count_poly (n d k : ℕ) (c : ℝ) (hn : 2 ≤ n) (hc : 0 < c)
    (hk : (k : ℝ) ≤ c * Real.logb 2 n) :
    (((4 : ℕ) ^ (2 ^ d * k) : ℕ) : ℝ) ≤ (n : ℝ) ^ ((2 : ℝ) ^ (d + 1) * c) := by sorry

/-! ## Main theorem -/

/-- The expectation-value identity behind the polynomial-time algorithm: `⟨ψ|O|ψ⟩` is a sum,
over at most `4^{2^d k} ≤ n^{2^{d+1} c}` Pauli labels on the light cone `R` of `S`, of the local
coefficient of `Q† O Q` times the `|0^n⟩` value of the symbolically Clifford-propagated term. [QuantumCircuitLowerBounds, node_25] -/
theorem A1CQ_local_expectation (n d : ℕ) (c : ℝ) (hn : 2 ≤ n) (hc : 0 < c)
    (Q : Op n) (hQ : IsShallowCircuit d Q) (gs : List (CliffordGate n))
    (S : Finset (Fin n)) (hS : (S.card : ℝ) ≤ c * Real.logb 2 n)
    (O : Op n) (hO : SupportedOn S O) (hOh : O.IsHermitian) :
    ∃ R : Finset (Fin n), R.card ≤ 2 ^ d * S.card ∧
      zeroExpect (Q * cliffordOp gs) O =
        ∑ xz ∈ pauliOn R, xzCoeff (star Q * O * Q) xz *
          zeroExp (conjSymb gs ((0 : ℕ), xz.1, xz.2)) ∧
      (pauliOn R).card ≤ 4 ^ (2 ^ d * S.card) ∧
      ((pauliOn R).card : ℝ) ≤ (n : ℝ) ^ ((2 : ℝ) ^ (d + 1) * c) := by sorry

end TCSChallenge.QuantumCircuitLowerBounds.node_25
