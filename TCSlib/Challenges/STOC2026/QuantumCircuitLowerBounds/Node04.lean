/-!
## `A₁CQ` and `A₁QC` are incomparable

An `n`-qubit operator is a matrix indexed by computational basis strings `Fin n → Fin 2`.
`A₁CQ` is the class of unitary families `U_n = Q_n C_n` (Clifford block `C_n` applied first,
then a depth-`d` circuit `Q_n` of arbitrary one/two-qubit gates, `d` independent of `n`),
`A₁QC` the class of families `V_n = C_n Q_n`, both up to global phase.

The intrinsic diagnostic is the number of nonzero coefficients in the Pauli expansion
(`pauliCount`). Members of `A₁CQ` have bounded backward count `pauliCount (U† P U)` for local
Paulis `P`; members of `A₁QC` have bounded forward count `pauliCount (V P V†)`. The witnesses
(CNOT fanout from qubit 0 combined with the parallel phase layer `diag(1, e^{iπ/4})^{⊗n}`)
reach `2^n`. Main theorems: `A1CQ_not_subset_A1QC` and `A1QC_not_subset_A1CQ`.
-/

namespace TCSChallenge.QuantumCircuitLowerBounds.node_04

/-! ## Shared circuit model (identical in the node_25 file) -/

/-- An `n`-qubit operator: a complex matrix on the computational basis `{0,1}^n`. -/
abbrev Op (n : ℕ) : Type := Matrix (Fin n → Fin 2) (Fin n → Fin 2) ℂ

/-- `A` acts only on the qubits in `S`, i.e. `A = A_S ⊗ I_{[n] \ S}`: entries vanish unless the
two basis strings agree off `S`, and then depend only on the restrictions to `S`. -/
def SupportedOn {n : ℕ} (S : Finset (Fin n)) (A : Op n) : Prop :=
  (∀ x y : Fin n → Fin 2, (∃ j, j ∉ S ∧ x j ≠ y j) → A x y = 0) ∧
  (∀ x y x' y' : Fin n → Fin 2, (∀ j, j ∈ S → x j = x' j ∧ y j = y' j) →
    (∀ j, j ∉ S → x j = y j ∧ x' j = y' j) → A x y = A x' y')

/-- "arbitrary one-qubit and two-qubit gates": a unitary supported on at most two qubits. -/
def IsGate {n : ℕ} (S : Finset (Fin n)) (G : Op n) : Prop :=
  S.card ≤ 2 ∧ SupportedOn S G ∧ G ∈ Matrix.unitaryGroup (Fin n → Fin 2) ℂ

/-- A layer: gates on pairwise disjoint sets of qubits. -/
def IsLayer {n : ℕ} (L : List (Finset (Fin n) × Op n)) : Prop :=
  (∀ g ∈ L, IsGate g.1 g.2) ∧ L.Pairwise (fun g h => Disjoint g.1 h.1)

/-- The unitary implemented by a layer. -/
def layerOp {n : ℕ} (L : List (Finset (Fin n) × Op n)) : Op n :=
  (L.map Prod.snd).prod

/-- `Q` is implemented by a bounded-fanin circuit of depth at most `d` (a `QNC⁰` block when `d`
is a constant independent of `n`). -/
def IsShallowCircuit {n : ℕ} (d : ℕ) (Q : Op n) : Prop :=
  ∃ Ls : List (List (Finset (Fin n) × Op n)),
    Ls.length ≤ d ∧ (∀ L ∈ Ls, IsLayer L) ∧ Q = (Ls.map layerOp).prod

/-- A one-qubit matrix `V` applied to qubit `a` (tensored with the identity elsewhere). -/
def embed1 {n : ℕ} (a : Fin n) (V : Matrix (Fin 2) (Fin 2) ℂ) : Op n :=
  Matrix.of fun x y => if (∀ j, j ≠ a → x j = y j) then V (x a) (y a) else 0

/-- Hadamard gate `(1/√2) [[1,1],[1,-1]]`. -/
def hadamard : Matrix (Fin 2) (Fin 2) ℂ :=
  Matrix.of fun r s => ((Real.sqrt 2 : ℝ) : ℂ)⁻¹ * (if r = 1 ∧ s = 1 then -1 else 1)

/-- Phase gate `S = diag(1, i)`. -/
def sGate : Matrix (Fin 2) (Fin 2) ℂ :=
  Matrix.of fun r s => if r = s then (if r = 0 then 1 else Complex.I) else 0

/-- Clifford generators. -/
inductive CliffordGate (n : ℕ) where
  | h (a : Fin n)
  | s (a : Fin n)
  | cnot (c t : Fin n)

/-- `CNOT` with control `c` and target `t`: `|y⟩ ↦ |y with y_t ⊕= y_c⟩` (identity if `c = t`). -/
def cnotOp {n : ℕ} (c t : Fin n) : Op n :=
  if c = t then 1 else
    Matrix.of fun x y => if x = Function.update y t (y t + y c) then 1 else 0

/-- Matrix of a Clifford generator. -/
def cliffordGateOp {n : ℕ} : CliffordGate n → Op n
  | .h a => embed1 a hadamard
  | .s a => embed1 a sGate
  | .cnot c t => cnotOp c t

/-- A Clifford circuit (word in the generators, arbitrary length); `gs.head` is applied last. -/
def cliffordOp {n : ℕ} (gs : List (CliffordGate n)) : Op n :=
  (gs.map cliffordGateOp).prod

/-- "an arbitrary `n`-qubit Clifford circuit, with no depth restriction". -/
def IsCliffordCircuit {n : ℕ} (C : Op n) : Prop :=
  ∃ gs : List (CliffordGate n), C = cliffordOp gs

/-! ## Pauli strings and the Pauli-coefficient count -/

/-- Single-qubit Paulis, `0 = I, 1 = X, 2 = Y, 3 = Z`. -/
def pauli1 (a : Fin 4) : Matrix (Fin 2) (Fin 2) ℂ :=
  if a = 0 then 1
  else if a = 1 then Matrix.of fun r s => if r = s then 0 else 1
  else if a = 2 then Matrix.of fun r s => if r = s then 0 else if r = 0 then -Complex.I else Complex.I
  else Matrix.of fun r s => if r = s then (if r = 0 then 1 else -1) else 0

/-- The Pauli string `P_1 ⊗ ⋯ ⊗ P_n`. -/
def pauliStr {n : ℕ} (P : Fin n → Fin 4) : Op n :=
  Matrix.of fun x y => ∏ j, pauli1 (P j) (x j) (y j)

/-- Coefficient of `P` in the (unique) Pauli expansion: `tr(P A) / 2^n`. -/
def pauliCoeff {n : ℕ} (A : Op n) (P : Fin n → Fin 4) : ℂ :=
  Matrix.trace (pauliStr P * A) / (2 : ℂ) ^ n

/-- The diagnostic: number of Pauli strings with nonzero coefficient in `A`. -/
def pauliCount {n : ℕ} (A : Op n) : ℕ :=
  (Finset.univ.filter (fun P : Fin n → Fin 4 => pauliCoeff A P ≠ 0)).card

/-- Pauli weight: number of non-identity tensor factors. -/
def pauliWeight {n : ℕ} (P : Fin n → Fin 4) : ℕ :=
  (Finset.univ.filter (fun j => P j ≠ 0)).card

/-- `X` on qubit `j`, identity elsewhere (as a Pauli string). -/
def localX {n : ℕ} (j : Fin n) : Fin n → Fin 4 :=
  Function.update (fun _ => 0) j 1

/-! ## The two classes -/

/-- A family of `n`-qubit operators, one for each `n`. -/
abbrev Family : Type := (n : ℕ) → Op n

/-- `A₁CQ`: `U_n = ω_n · Q_n C_n` with `C_n` Clifford and `Q_n` of depth `≤ d`, `d` fixed. -/
def InA1CQ (U : Family) : Prop :=
  ∃ d : ℕ, ∀ n : ℕ, ∃ (Q C : Op n) (ω : ℂ),
    IsShallowCircuit d Q ∧ IsCliffordCircuit C ∧ Complex.normSq ω = 1 ∧ U n = ω • (Q * C)

/-- `A₁QC`: `V_n = ω_n · C_n Q_n` with `C_n` Clifford and `Q_n` of depth `≤ d`, `d` fixed. -/
def InA1QC (V : Family) : Prop :=
  ∃ d : ℕ, ∀ n : ℕ, ∃ (Q C : Op n) (ω : ℂ),
    IsShallowCircuit d Q ∧ IsCliffordCircuit C ∧ Complex.normSq ω = 1 ∧ V n = ω • (C * Q)

/-! ## Witness blocks -/

/-- `e^{iπ/4}`. -/
def omega8 : ℂ := Complex.exp ((Real.pi / 4 : ℝ) * Complex.I)

/-- `Q_n := diag(1, e^{iπ/4})^{⊗ n}` (depth one). -/
def phaseLayer (n : ℕ) : Op n :=
  Matrix.diagonal fun x => ∏ j, (if x j = 1 then omega8 else 1)

/-- Clifford fanout: `CNOT` from qubit `0` to every other qubit. -/
def fanout : (n : ℕ) → Op n
  | 0 => 1
  | m + 1 => cliffordOp (List.ofFn fun j : Fin (m + 1) => CliffordGate.cnot 0 j)

/-- Witness in `A₁QC`: `V_n = C_n Q_n` (phase layer first, then fanout). -/
def witnessQC : Family := fun n => fanout n * phaseLayer n

/-- Witness in `A₁CQ`: `U_n = Q_n C_n` (fanout first, then phase layer). -/
def witnessCQ : Family := fun n => phaseLayer n * fanout n

/-! ## Lemma stubs -/

/-- Pauli strings form a basis: every operator equals its Pauli expansion. [QuantumCircuitLowerBounds, node_04] -/
theorem pauli_expansion {n : ℕ} (A : Op n) :
    A = ∑ P : Fin n → Fin 4, pauliCoeff A P • pauliStr P := by sorry

/-- Uniqueness of the Pauli expansion. [QuantumCircuitLowerBounds, node_04] -/
theorem pauli_expansion_unique {n : ℕ} (A : Op n) (c : (Fin n → Fin 4) → ℂ)
    (h : A = ∑ P : Fin n → Fin 4, c P • pauliStr P) : ∀ P, c P = pauliCoeff A P := by sorry

/-- Clifford conjugation (both directions) maps a Pauli string to a phase times a Pauli
string. [QuantumCircuitLowerBounds, node_04] -/
theorem clifford_conj_pauli {n : ℕ} (C : Op n) (hC : IsCliffordCircuit C)
    (P : Fin n → Fin 4) :
    (∃ (P' : Fin n → Fin 4) (ω : ℂ), Complex.normSq ω = 1 ∧
      star C * pauliStr P * C = ω • pauliStr P') ∧
    (∃ (P' : Fin n → Fin 4) (ω : ℂ), Complex.normSq ω = 1 ∧
      C * pauliStr P * star C = ω • pauliStr P') := by sorry

/-- Clifford conjugation preserves the Pauli count (it may change Pauli weights arbitrarily). [QuantumCircuitLowerBounds, node_04] -/
theorem pauliCount_clifford_conj {n : ℕ} (C : Op n) (hC : IsCliffordCircuit C) (A : Op n) :
    pauliCount (star C * A * C) = pauliCount A ∧
    pauliCount (C * A * star C) = pauliCount A := by sorry

/-- Global phases do not affect conjugation. [QuantumCircuitLowerBounds, node_04] -/
theorem conj_phase {n : ℕ} (ω : ℂ) (hω : Complex.normSq ω = 1) (W A : Op n) :
    star (ω • W) * A * (ω • W) = star W * A * W ∧
    (ω • W) * A * star (ω • W) = W * A * star W := by sorry

/-- Light cones: conjugating an operator on `S` by a depth-`d` circuit of `≤ 2`-qubit gates
gives an operator on at most `2^d |S|` qubits (backward and forward). [QuantumCircuitLowerBounds, node_04] -/
theorem lightcone {n d : ℕ} (Q : Op n) (hQ : IsShallowCircuit d Q)
    (S : Finset (Fin n)) (A : Op n) (hA : SupportedOn S A) :
    (∃ T : Finset (Fin n), T.card ≤ 2 ^ d * S.card ∧ SupportedOn T (star Q * A * Q)) ∧
    (∃ T : Finset (Fin n), T.card ≤ 2 ^ d * S.card ∧ SupportedOn T (Q * A * star Q)) := by sorry

/-- A Pauli string is supported on its non-identity positions. [QuantumCircuitLowerBounds, node_04] -/
theorem pauliStr_supported {n : ℕ} (P : Fin n → Fin 4) :
    SupportedOn (Finset.univ.filter (fun j => P j ≠ 0)) (pauliStr P) := by sorry

/-- An operator on `T` has at most `4^{|T|}` nonzero Pauli coefficients. [QuantumCircuitLowerBounds, node_04] -/
theorem pauliCount_le_of_supported {n : ℕ} (T : Finset (Fin n)) (A : Op n)
    (hA : SupportedOn T A) : pauliCount A ≤ 4 ^ T.card := by sorry

/-- Class bound for `A₁CQ`: bounded backward Pauli count of local Paulis, uniformly in `n`. [QuantumCircuitLowerBounds, node_04] -/
theorem A1CQ_backward_bound (U : Family) (hU : InA1CQ U) :
    ∃ d : ℕ, ∀ (n w : ℕ) (P : Fin n → Fin 4), pauliWeight P ≤ w →
      pauliCount (star (U n) * pauliStr P * U n) ≤ 4 ^ (2 ^ d * w) := by sorry

/-- Class bound for `A₁QC`: bounded forward Pauli count of local Paulis, uniformly in `n`. [QuantumCircuitLowerBounds, node_04] -/
theorem A1QC_forward_bound (V : Family) (hV : InA1QC V) :
    ∃ d : ℕ, ∀ (n w : ℕ) (P : Fin n → Fin 4), pauliWeight P ≤ w →
      pauliCount (V n * pauliStr P * star (V n)) ≤ 4 ^ (2 ^ d * w) := by sorry

/-- The fanout is a Clifford circuit and the phase layer is a depth-one circuit. [QuantumCircuitLowerBounds, node_04] -/
theorem witness_blocks (n : ℕ) :
    IsCliffordCircuit (fanout n) ∧ IsShallowCircuit 1 (phaseLayer n) := by sorry

theorem witnessQC_mem : InA1QC witnessQC := by sorry

theorem witnessCQ_mem : InA1CQ witnessCQ := by sorry

/-- Backward propagation of `X_0` through the `A₁QC` witness:
`V† X_0 V = Q† X^{⊗n} Q = ((X - Y)/√2)^{⊗ n}` up to sign conventions, with `2^n` terms. [QuantumCircuitLowerBounds, node_04] -/
theorem witnessQC_backward_count (m : ℕ) :
    pauliCount (star (witnessQC (m + 1)) * pauliStr (localX (0 : Fin (m + 1))) *
      witnessQC (m + 1)) = 2 ^ (m + 1) := by sorry

/-- Forward propagation of `X_0` through the `A₁CQ` witness has `2^n` Pauli terms. [QuantumCircuitLowerBounds, node_04] -/
theorem witnessCQ_forward_count (m : ℕ) :
    pauliCount (witnessCQ (m + 1) * pauliStr (localX (0 : Fin (m + 1))) *
      star (witnessCQ (m + 1))) = 2 ^ (m + 1) := by sorry

theorem witnessQC_not_mem_A1CQ : ¬ InA1CQ witnessQC := by sorry

theorem witnessCQ_not_mem_A1QC : ¬ InA1QC witnessCQ := by sorry

/-! ## Main theorems -/

/-- `A₁CQ ⊄ A₁QC`, with the explicit witness. [QuantumCircuitLowerBounds, node_04] -/
theorem A1CQ_not_subset_A1QC :
    (InA1CQ witnessCQ ∧ ¬ InA1QC witnessCQ) ∧ ¬ (∀ U : Family, InA1CQ U → InA1QC U) := by
  sorry

/-- `A₁QC ⊄ A₁CQ`, with the explicit witness. [QuantumCircuitLowerBounds, node_04] -/
theorem A1QC_not_subset_A1CQ :
    (InA1QC witnessQC ∧ ¬ InA1CQ witnessQC) ∧ ¬ (∀ V : Family, InA1QC V → InA1CQ V) := by
  sorry

end TCSChallenge.QuantumCircuitLowerBounds.node_04
