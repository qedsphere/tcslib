/-!
## Bootstrapping level-2 Fourier growth of DQC_k algorithms to all levels

Let `N = 2^n`, `K = 2^k` and let `f : {-1,1}^N → [0,1]` be the acceptance probability of a
`d`-query `DQC_k` algorithm: start in `(I_{NW}/NW) ⊗ |0^k⟩⟨0^k|` on `ℂ^N ⊗ ℂ^W ⊗ ℂ^K`, apply
`U_0, O_x, U_1, …, O_x, U_d` with the phase oracle `O_x = diag(x) ⊗ I_{WK}`, and measure.
Assuming `L_{1,2}(f|_σ) ≤ A d³ √K` for every restriction `σ`, there is a universal `c > 0`
with `L_{1,ℓ}(f|_ρ) ≤ c^ℓ d³ √K N^{(ℓ-2)/2} log^{ℓ-2}(N) √(ℓ!)` for every `ρ` and `ℓ ≥ 2`
(`main_dqc`).
-/

namespace TCSChallenge.FourierSpectrumOfNoisy.node_26

open Matrix
open SwitchingLemma
-- Only `boolToSign` is opened: the local `fourierCoeff` (over an arbitrary `ι`) would clash
-- with `BooleanAnalysis.fourierCoeff`.
open BooleanAnalysis (boolToSign)

/-! ## Shared definitions (byte-identical across the rows of this paper) -/

/-- The character `χ_S(x) = ∏_{i ∈ S} x_i` over an arbitrary index type `ι` (kept local: it is
used on `U_ρ` and on general `ι`); `boolToSign` maps `false ↦ 1`, `true ↦ -1`. -/
def chi {ι : Type} (S : Finset ι) (x : ι → Bool) : ℝ := ∏ i ∈ S, boolToSign (x i)

/-- `ĝ(S) = 𝔼_x[g(x) χ_S(x)]`, with the uniform expectation over the cube `ι → Bool`. -/
def fourierCoeff {ι : Type} [Fintype ι] [DecidableEq ι]
    (g : (ι → Bool) → ℝ) (S : Finset ι) : ℝ :=
  (Fintype.card (ι → Bool) : ℝ)⁻¹ * ∑ x : ι → Bool, g x * chi S x

/-- `L_{1,k}(g) = ∑_{|S| = k} |ĝ(S)|`. -/
def levelL1 {ι : Type} [Fintype ι] [DecidableEq ι]
    (g : (ι → Bool) → ℝ) (k : ℕ) : ℝ :=
  ∑ S ∈ (Finset.univ : Finset ι).powersetCard k, |fourierCoeff g S|

/-- The set `U_ρ` of coordinates left free by a restriction `ρ : SwitchingLemma.Restriction N`
(`none` is `*`, `some b` fixes the coordinate), as an index type. -/
abbrev FreeCoords {N : ℕ} (ρ : Restriction N) : Type := {i : Fin N // i ∈ ρ.freeVars}

/-- Complete an assignment of the free coordinates to a full input using `ρ` (the value
placed on fixed coordinates before `extend` is irrelevant). -/
def fillIn {N : ℕ} (ρ : Restriction N) (z : FreeCoords ρ → Bool) : Fin N → Bool :=
  ρ.extend (fun i => if h : i ∈ ρ.freeVars then z ⟨i, h⟩ else false)

/-- `f|_ρ`, regarded as a function on `{-1,1}^{U_ρ}`. -/
def restrictTo {N : ℕ} (f : (Fin N → Bool) → ℝ) (ρ : Restriction N) :
    (FreeCoords ρ → Bool) → ℝ :=
  fun z => f (fillIn ρ z)


/-- Fix the coordinates in `X` to the values of `x`, keeping the domain `ι → Bool`
(the result does not depend on the coordinates in `X`). This is `q_x` from the proof. -/
def fixOn {ι : Type} [DecidableEq ι] (X : Finset ι) (x : ι → Bool)
    (q : (ι → Bool) → ℝ) : (ι → Bool) → ℝ :=
  fun y => q (fun j => if j ∈ X then x j else y j)

/-- A family of functions on `ι → Bool` closed under fixing coordinates. -/
def ClosedUnderFix {ι : Type} [DecidableEq ι] (P : ((ι → Bool) → ℝ) → Prop) : Prop :=
  ∀ (g : (ι → Bool) → ℝ) (X : Finset ι) (x : ι → Bool), P g → P (fixOn X x g)

/-! ## Row-specific definitions: the DQC_k model -/

/-- Basis of `ℂ^N ⊗ ℂ^W ⊗ ℂ^K` with `N = 2^n`, `K = 2^k`. -/
abbrev DQCBasis (n k : ℕ) (W : Type) : Type := Fin (2 ^ n) × W × Fin (2 ^ k)

/-- A `d`-query `DQC_k` algorithm: unitaries `U_0, …, U_d` and an accepting set of basis
states (two-outcome projective measurement). -/
structure DQCAlg (n k : ℕ) (W : Type) where
  /-- number of oracle calls `d` -/
  queries : ℕ
  /-- input-independent unitaries (only `t ≤ queries` is used) -/
  U : ℕ → Matrix (DQCBasis n k W) (DQCBasis n k W) ℂ
  /-- accepting basis states -/
  accept : Finset (DQCBasis n k W)

/-- Validity: every `U_t` with `t ≤ d` is unitary. -/
def DQCAlg.Valid {n k : ℕ} {W : Type} [Fintype W] [DecidableEq W] (A : DQCAlg n k W) : Prop :=
  ∀ t ≤ A.queries, A.U t ∈ Matrix.unitaryGroup (DQCBasis n k W) ℂ

/-- The initial state `(I_{NW}/NW) ⊗ |0^k⟩⟨0^k|`. -/
def dqcInit (n k : ℕ) (W : Type) [Fintype W] [DecidableEq W] :
    Matrix (DQCBasis n k W) (DQCBasis n k W) ℂ :=
  Matrix.diagonal (fun b => if b.2.2.val = 0 then ((2 ^ n : ℂ) * (Fintype.card W : ℂ))⁻¹ else 0)

/-- The phase oracle `O_x = diag(x_1, …, x_N) ⊗ I_{WK}`. -/
def dqcOracle (n k : ℕ) (W : Type) [DecidableEq W] (x : Fin (2 ^ n) → Bool) :
    Matrix (DQCBasis n k W) (DQCBasis n k W) ℂ :=
  Matrix.diagonal (fun b => ((boolToSign (x b.1) : ℝ) : ℂ))

/-- The circuit `U_t O_x U_{t-1} ⋯ O_x U_0`. -/
def DQCAlg.circuit {n k : ℕ} {W : Type} [Fintype W] [DecidableEq W] (A : DQCAlg n k W)
    (x : Fin (2 ^ n) → Bool) : ℕ → Matrix (DQCBasis n k W) (DQCBasis n k W) ℂ
  | 0 => A.U 0
  | t + 1 => A.U (t + 1) * dqcOracle n k W x * DQCAlg.circuit A x t

/-- Acceptance probability `f(x) = tr(Π V ρ₀ V^†)` with `V` the full circuit. -/
def DQCAlg.acceptProb {n k : ℕ} {W : Type} [Fintype W] [DecidableEq W] (A : DQCAlg n k W)
    (x : Fin (2 ^ n) → Bool) : ℝ :=
  (∑ b ∈ A.accept,
    (A.circuit x A.queries * dqcInit n k W *
      Matrix.conjTranspose (A.circuit x A.queries)) b b).re

/-- `σ` extends `ρ`: every coordinate fixed by `ρ` is fixed to the same value by `σ`. -/
def Extends {N : ℕ} (σ ρ : Restriction N) : Prop :=
  ∀ (i : Fin N) (b : Bool), ρ i = some b → σ i = some b

/-! ## Rubric lemma stubs -/

/-- The level-`k` growth of `f|_ρ` on `U_ρ` equals that of `f ∘ R_ρ` on the full cube,
where `R_ρ = ρ.extend` overwrites the fixed coordinates. [FourierSpectrumOfNoisy, node_26] -/
theorem levelL1_restrictTo_eq {N : ℕ} (f : (Fin N → Bool) → ℝ) (ρ : Restriction N) (k : ℕ) :
    levelL1 (restrictTo f ρ) k = levelL1 (fun x => f (ρ.extend x)) k := by
  sorry

/-- Rubric 1: the family `𝓡_ρ` of further restrictions of `f|_ρ` is closed under fixing
coordinates. [FourierSpectrumOfNoisy, node_26] -/
theorem closedUnderFix_furtherRestrictions {N : ℕ} (f : (Fin N → Bool) → ℝ)
    (ρ : Restriction N) :
    ClosedUnderFix (fun g : (Fin N → Bool) → ℝ =>
      ∃ σ : Restriction N, Extends σ ρ ∧ g = fun x => f (σ.extend x)) := by
  sorry

/-- Rubric 2: if each coordinate lies in `X` independently with probability `1/(k+1)`, then
for `|S| = k+1`, `Pr[|S ∩ X| = 1] = (k/(k+1))^k`. [FourierSpectrumOfNoisy, node_26] -/
theorem isolation_prob {ι : Type} [Fintype ι] [DecidableEq ι] (k : ℕ) (S : Finset ι)
    (hS : S.card = k + 1) :
    ∑ X : Finset ι, (1 / ((k : ℝ) + 1)) ^ X.card *
        (1 - 1 / ((k : ℝ) + 1)) ^ (Fintype.card ι - X.card) *
        (if (S ∩ X).card = 1 then (1 : ℝ) else 0)
      = ((k : ℝ) / ((k : ℝ) + 1)) ^ k := by
  sorry

/-- Rubric 2: the isolation probability is at least `e⁻¹`. [FourierSpectrumOfNoisy, node_26] -/
theorem isolation_prob_ge (k : ℕ) :
    Real.exp (-1) ≤ ((k : ℝ) / ((k : ℝ) + 1)) ^ k := by
  sorry

/-- Rubric 3: for `i ∈ X` and `T` disjoint from `X`, `ĝ(T ∪ {i}) = 𝔼_x[x_i · ĝ_x(T)]`. [FourierSpectrumOfNoisy, node_26] -/
theorem fourier_insert_eq_avg_fixOn {ι : Type} [Fintype ι] [DecidableEq ι]
    (q : (ι → Bool) → ℝ) (X T : Finset ι) (i : ι) (hi : i ∈ X) (hT : Disjoint T X) :
    fourierCoeff q (insert i T) =
      (Fintype.card (ι → Bool) : ℝ)⁻¹ *
        ∑ x : ι → Bool, boolToSign (x i) * fourierCoeff (fixOn X x q) T := by
  sorry

/-- Rubric 3: expected maximum of `M ≥ N` Rademacher sums with coefficients in `[-1,1]` on at
most `N` coordinates is `O(√(N log M log N))` (Hoeffding + union bound). [FourierSpectrumOfNoisy, node_26] -/
theorem expected_max_rademacher :
    ∃ C1 : ℝ, 0 < C1 ∧
      ∀ (ι τ : Type) [Fintype ι] [DecidableEq ι] [Fintype τ] [Nonempty τ]
        (N : ℕ) (X : Finset ι) (a : τ → ι → ℝ),
        2 ≤ N → Fintype.card ι ≤ N → N ≤ Fintype.card τ → (∀ t i, |a t i| ≤ 1) →
        (Fintype.card (ι → Bool) : ℝ)⁻¹ *
            ∑ x : ι → Bool, (⨆ t : τ, |∑ i ∈ X, a t i * boolToSign (x i)|)
          ≤ C1 * Real.sqrt ((N : ℝ) * Real.log ((Fintype.card τ : ℕ) : ℝ) * Real.log N) := by
  sorry

/-- Rubric 4: the level-to-level recurrence
`B_{r+1} ≤ C₂ B_r √(N log binom(N,r) log N)` for any family closed under fixing coordinates. [FourierSpectrumOfNoisy, node_26] -/
theorem level_recurrence :
    ∃ C2 : ℝ, 0 < C2 ∧
      ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (P : ((ι → Bool) → ℝ) → Prop)
        (N r : ℕ) (B : ℝ),
        2 ≤ N → Fintype.card ι ≤ N → 1 ≤ r → ClosedUnderFix P →
        (∀ g, P g → levelL1 g r ≤ B) →
        ∀ g, P g → levelL1 g (r + 1) ≤
          C2 * B * Real.sqrt ((N : ℝ) * Real.log ((N.choose r : ℕ) : ℝ) * Real.log N) := by
  sorry

/-- Rubric 4: `log binom(N,k) ≤ k log N`. [FourierSpectrumOfNoisy, node_26] -/
theorem log_choose_le (N k : ℕ) (hN : 1 ≤ N) (hk : k ≤ N) :
    Real.log ((N.choose k : ℕ) : ℝ) ≤ k * Real.log N := by
  sorry

/-! ## Main theorem -/

/-- Main theorem: from the uniform level-2 hypothesis `L_{1,2}(f|_σ) ≤ A d³ √K` there is a
universal `c > 0` (depending only on `A`) with
`L_{1,ℓ}(f|_ρ) ≤ c^ℓ d³ √K N^{(ℓ-2)/2} log^{ℓ-2}(N) √(ℓ!)` for all `ρ` and `ℓ ≥ 2`. [FourierSpectrumOfNoisy, node_26] -/
theorem main_dqc (A : ℝ) (hA : 0 < A) :
    ∃ c : ℝ, 0 < c ∧
      ∀ (n k : ℕ) (W : Type) [Fintype W] [DecidableEq W] [Nonempty W] (alg : DQCAlg n k W),
        alg.Valid →
        (∀ σ : Restriction (2 ^ n),
          levelL1 (restrictTo alg.acceptProb σ) 2 ≤
            A * (alg.queries : ℝ) ^ 3 * Real.sqrt ((2 : ℝ) ^ k)) →
        ∀ (ρ : Restriction (2 ^ n)) (ℓ : ℕ), 2 ≤ ℓ →
          levelL1 (restrictTo alg.acceptProb ρ) ℓ ≤
            c ^ ℓ * (alg.queries : ℝ) ^ 3 * Real.sqrt ((2 : ℝ) ^ k) *
              ((2 : ℝ) ^ n) ^ (((ℓ : ℝ) - 2) / 2) * Real.log ((2 : ℝ) ^ n) ^ (ℓ - 2) *
              Real.sqrt (ℓ.factorial : ℝ) := by
  sorry

end TCSChallenge.FourierSpectrumOfNoisy.node_26
