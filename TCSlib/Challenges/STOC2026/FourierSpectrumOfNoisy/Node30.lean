/-!
## Fourier growth under depth-`d` classical pre-processing

For `β ∈ [-1,1]^{binom(N,k)}`, `L^β_{1,k}(h) = ∑_{|S|=k} β_S ĥ(S)` (TCSlib's `fourierCoeff`),
and `h|_ρ = h ∘ R_ρ` with `R_ρ x = ρ.extend x` (TCSlib's `Restriction.extend`).
Let `𝓕` be closed under fixing coordinates and let `f` first adaptively query at most `d`
coordinates, then run a function of `𝓕` chosen from the answers. Then for every `ρ`,
`ℓ ≤ N` and `α ∈ [-1,1]^{binom(N,ℓ)}` there is one `f' ∈ 𝓕` with
`L^α_{1,ℓ}(f|_ρ) ≤ ∑_{k=0}^{ℓ} binom(d, ℓ-k) max_{α'} L^{α'}_{1,k}(f'|_ρ)` (`main_preprocessing`).
-/

namespace TCSChallenge.FourierSpectrumOfNoisy.node_30

open BooleanAnalysis SwitchingLemma

/-! ## Shared definitions -/

/-- `L_{1,k}(g) = ∑_{|S| = k} |ĝ(S)|`, with TCSlib's uniformly normalised `fourierCoeff`. -/
def levelL1 {n : ℕ} (g : BooleanFunc n) (k : ℕ) : ℝ :=
  ∑ S ∈ (Finset.univ : Finset (Fin n)).powersetCard k, |fourierCoeff g S|

/-- Fix the coordinates in `X` to the values of `x`, keeping the domain `ι → Bool`
(the result does not depend on the coordinates in `X`). This is `q_x` from the proof. -/
def fixOn {ι : Type} [DecidableEq ι] (X : Finset ι) (x : ι → Bool)
    (q : (ι → Bool) → ℝ) : (ι → Bool) → ℝ :=
  fun y => q (fun j => if j ∈ X then x j else y j)

/-- A family of functions on `ι → Bool` closed under fixing coordinates. -/
def ClosedUnderFix {ι : Type} [DecidableEq ι] (P : ((ι → Bool) → ℝ) → Prop) : Prop :=
  ∀ (g : (ι → Bool) → ℝ) (X : Finset ι) (x : ι → Bool), P g → P (fixOn X x g)

/-! ## Row-specific definitions -/

/-- Signed level-`k` functional `L^β_{1,k}(h) = ∑_{|S| = k} β_S ĥ(S)`. -/
def signedL1 {N : ℕ} (β : Finset (Fin N) → ℝ) (h : BooleanFunc N) (k : ℕ) : ℝ :=
  ∑ S ∈ (Finset.univ : Finset (Fin N)).powersetCard k, β S * fourierCoeff h S

/-- `max_{α' ∈ [-1,1]^{binom(N,k)}} L^{α'}_{1,k}(h)`. -/
def maxSigned {N : ℕ} (h : BooleanFunc N) (k : ℕ) : ℝ :=
  ⨆ β : {β : Finset (Fin N) → ℝ // ∀ S, |β S| ≤ 1}, signedL1 β.1 h k

/-- The level-`ℓ` polynomial `∑_{|S| = ℓ} α_S χ_S(x)`. -/
def levelPoly {N : ℕ} (α : Finset (Fin N) → ℝ) (ℓ : ℕ) (x : BoolCube N) : ℝ :=
  ∑ S ∈ (Finset.univ : Finset (Fin N)).powersetCard ℓ, α S * chiS S x

/-- Adaptive classical pre-processing: query a coordinate and branch on its value, or stop at
a leaf and run the selected no-pre-processing algorithm (its acceptance function). -/
inductive PreTree (N : ℕ) : Type
  | leaf (h : BooleanFunc N) : PreTree N
  | query (i : Fin N) (onFalse onTrue : PreTree N) : PreTree N

/-- Number of coordinates inspected on the longest path. -/
def PreTree.depth {N : ℕ} : PreTree N → ℕ
  | .leaf _ => 0
  | .query _ t0 t1 => max t0.depth t1.depth + 1

/-- The acceptance probability `f(x)`: follow the answers, then run the chosen leaf function
on the unchanged input `x`. -/
def PreTree.eval {N : ℕ} : PreTree N → BoolCube N → ℝ
  | .leaf h, x => h x
  | .query i t0 t1, x => if x i then t1.eval x else t0.eval x

/-- Every leaf function belongs to `𝓕`. -/
def PreTree.LeavesIn {N : ℕ} (F : BooleanFunc N → Prop) : PreTree N → Prop
  | .leaf h => F h
  | .query _ t0 t1 => t0.LeavesIn F ∧ t1.LeavesIn F

/-- The subcube `C = {x : x_i = b_i for i ∈ Q}`. -/
def subcube {N : ℕ} (Q : Finset (Fin N)) (b : BoolCube N) : Finset (BoolCube N) :=
  Finset.univ.filter (fun x => ∀ i ∈ Q, x i = b i)

/-- Conditional expectation `𝔼_{x | x ∈ C}[φ(x)]` over the subcube `C`. -/
def condAvg {N : ℕ} (Q : Finset (Fin N)) (b : BoolCube N) (φ : BooleanFunc N) : ℝ :=
  ((subcube Q b).card : ℝ)⁻¹ * ∑ x ∈ subcube Q b, φ x

/-! ## Rubric lemma stubs -/

/-- Rubric 1 (transcript decomposition): some reachable transcript, with distinct alive
queried set `Q` (`|Q| ≤ d`), answers `b` and selected leaf `h ∈ 𝓕`, agrees with the
hard-wired continuation on its subcube and dominates the signed functional. [FourierSpectrumOfNoisy, node_30] -/
theorem exists_good_transcript {N : ℕ} (F : BooleanFunc N → Prop) (t : PreTree N)
    (d : ℕ) (ht : t.depth ≤ d) (hleaves : t.LeavesIn F) (ρ : Restriction N) (ℓ : ℕ)
    (α : Finset (Fin N) → ℝ) :
    ∃ (Q : Finset (Fin N)) (b : BoolCube N) (h : BooleanFunc N),
      F h ∧ Q.card ≤ d ∧ (∀ i ∈ Q, ρ i = none) ∧ (subcube Q b).Nonempty ∧
      (∀ x ∈ subcube Q b, t.eval (ρ.extend x) = fixOn Q b h (ρ.extend x)) ∧
      signedL1 α (fun x => t.eval (ρ.extend x)) ℓ ≤
        condAvg Q b (fun x => fixOn Q b h (ρ.extend x) * levelPoly α ℓ x) := by
  sorry

/-- Rubric 2 (hard-wiring invariant): the restriction of the hard-wired continuation does not
depend on the coordinates in `Q`. [FourierSpectrumOfNoisy, node_30] -/
theorem hardwired_independent {N : ℕ} (Q : Finset (Fin N)) (b : BoolCube N)
    (h : BooleanFunc N) (ρ : Restriction N) (x y : BoolCube N)
    (hxy : ∀ i, i ∉ Q → x i = y i) :
    fixOn Q b h (ρ.extend x) = fixOn Q b h (ρ.extend y) := by
  sorry

/-- Rubric 2: for `g` independent of `Q` and `S₁` disjoint from `Q`, the conditional
expectation over the subcube equals the unconditional Fourier coefficient. [FourierSpectrumOfNoisy, node_30] -/
theorem condAvg_eq_fourierCoeff {N : ℕ} (Q : Finset (Fin N)) (b : BoolCube N)
    (g : BooleanFunc N) (hg : ∀ x y : BoolCube N, (∀ i, i ∉ Q → x i = y i) → g x = g y)
    (S1 : Finset (Fin N)) (hS1 : Disjoint S1 Q) :
    condAvg Q b (fun x => g x * chiS S1 x) = fourierCoeff g S1 := by
  sorry

/-- Rubrics 3–4 (Fourier-level decomposition and counting): splitting each `ℓ`-set into its
queried and unqueried parts. [FourierSpectrumOfNoisy, node_30] -/
theorem level_split_bound {N : ℕ} (Q : Finset (Fin N)) (b : BoolCube N)
    (g : BooleanFunc N) (hg : ∀ x y : BoolCube N, (∀ i, i ∉ Q → x i = y i) → g x = g y)
    (ℓ : ℕ) (α : Finset (Fin N) → ℝ) (hα : ∀ S, |α S| ≤ 1) :
    condAvg Q b (fun x => g x * levelPoly α ℓ x) ≤
      ∑ k ∈ Finset.range (ℓ + 1), ((Q.card.choose (ℓ - k) : ℕ) : ℝ) * maxSigned g k := by
  sorry

/-! ## Main theorem -/

/-- Main theorem: for every restriction `ρ`, `ℓ ≤ N` and `α ∈ [-1,1]^{binom(N,ℓ)}` there is a
single `f' ∈ 𝓕` with
`L^α_{1,ℓ}(f|_ρ) ≤ ∑_{k=0}^{ℓ} binom(d, ℓ-k) max_{α'} L^{α'}_{1,k}(f'|_ρ)`. [FourierSpectrumOfNoisy, node_30] -/
theorem main_preprocessing {N : ℕ} (F : BooleanFunc N → Prop) (hF : ClosedUnderFix F)
    (t : PreTree N) (d : ℕ) (ht : t.depth ≤ d) (hleaves : t.LeavesIn F)
    (ρ : Restriction N) (ℓ : ℕ) (hℓ : ℓ ≤ N)
    (α : Finset (Fin N) → ℝ) (hα : ∀ S, |α S| ≤ 1) :
    ∃ f' : BooleanFunc N, F f' ∧
      signedL1 α (fun x => t.eval (ρ.extend x)) ℓ ≤
        ∑ k ∈ Finset.range (ℓ + 1),
          ((d.choose (ℓ - k) : ℕ) : ℝ) * maxSigned (fun x => f' (ρ.extend x)) k := by
  sorry

end TCSChallenge.FourierSpectrumOfNoisy.node_30
