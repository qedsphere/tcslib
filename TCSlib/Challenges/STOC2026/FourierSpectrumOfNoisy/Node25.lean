/-!
## Higher-level Fourier growth of restricted bounded low-degree polynomials

For `g : {-1,1}^m → ℝ`, `ĝ(S) = 𝔼_x[g(x) ∏_{i∈S} x_i]` and `L_{1,k}(g) = ∑_{|S|=k} |ĝ(S)|`.
Assuming the level-one bound `L_{1,1}(q) ≤ C₀ D` for bounded degree-`D` polynomials, there is
a universal `c > 0` such that for every `N ≥ 1`, every degree-`≤ d` `f : {-1,1}^N → [-1,1]`,
every restriction `ρ` and every `ℓ ≥ 1`,
`L_{1,ℓ}(f|_ρ) ≤ c^ℓ d N^{(ℓ-1)/2} log^{ℓ-1}(N) √(ℓ!)`
(`main_polynomial`). The same holds for acceptance probabilities of `d`-query quantum
algorithms (`main_bqp`), using that they are degree-`2d` polynomials with values in `[0,1]`.

Restrictions `ρ ∈ {-1,1,*}^N` are TCSlib's `SwitchingLemma.Restriction N = Fin N → Option Bool`
(`none = *`); `f|_ρ` is a function on the cube indexed by the free coordinates
`{i // i ∈ ρ.freeVars}`. Characters and Fourier coefficients are kept local because they are
needed over arbitrary finite index types (the free-coordinate subtype), not only `Fin n`.
-/

namespace TCSChallenge.FourierSpectrumOfNoisy.node_25

open Matrix
open BooleanAnalysis (boolToSign BooleanFunc)
open SwitchingLemma (Restriction)

/-! ## Shared definitions -/

/-- The character `χ_S(x) = ∏_{i ∈ S} x_i` (with `boolToSign : false ↦ 1, true ↦ -1`). -/
def chi {ι : Type} (S : Finset ι) (x : ι → Bool) : ℝ := ∏ i ∈ S, boolToSign (x i)

/-- `ĝ(S) = 𝔼_x[g(x) χ_S(x)]`, with the uniform expectation over the cube `ι → Bool`. -/
def fourierCoeff {ι : Type} [Fintype ι] [DecidableEq ι]
    (g : (ι → Bool) → ℝ) (S : Finset ι) : ℝ :=
  (Fintype.card (ι → Bool) : ℝ)⁻¹ * ∑ x : ι → Bool, g x * chi S x

/-- `L_{1,k}(g) = ∑_{|S| = k} |ĝ(S)|`. -/
def levelL1 {ι : Type} [Fintype ι] [DecidableEq ι]
    (g : (ι → Bool) → ℝ) (k : ℕ) : ℝ :=
  ∑ S ∈ (Finset.univ : Finset ι).powersetCard k, |fourierCoeff g S|

/-- The set `U_ρ` of coordinates left free by `ρ`, as an index type (from `ρ.freeVars`). -/
abbrev FreeCoords {N : ℕ} (ρ : Restriction N) : Type := {i : Fin N // i ∈ ρ.freeVars}

/-- Complete an assignment of the free coordinates to a full input using `ρ`
(`ρ.extend` of the free-coordinate assignment, padded arbitrarily off `U_ρ`). -/
def fillIn {N : ℕ} (ρ : Restriction N) (z : FreeCoords ρ → Bool) : Fin N → Bool :=
  ρ.extend (fun i => if h : i ∈ ρ.freeVars then z ⟨i, h⟩ else false)

/-- `f|_ρ`, regarded as a function on `{-1,1}^{U_ρ}`. -/
def restrictTo {N : ℕ} (f : BooleanFunc N) (ρ : Restriction N) :
    (FreeCoords ρ → Bool) → ℝ :=
  fun z => f (fillIn ρ z)

/-- Fix the coordinates in `X` to the values of `x`, keeping the domain `ι → Bool`
(the result does not depend on the coordinates in `X`). This is `q_x` from the proof. -/
def fixOn {ι : Type} [DecidableEq ι] (X : Finset ι) (x : ι → Bool)
    (q : (ι → Bool) → ℝ) : (ι → Bool) → ℝ :=
  fun y => q (fun j => if j ∈ X then x j else y j)

/-- A family of functions on `ι → Bool` closed under fixing coordinates. -/
def ClosedUnderFix {ι : Type} [DecidableEq ι] (P : ((ι → Bool) → ℝ) → Prop) : Prop :=
  ∀ (g : (ι → Bool) → ℝ) (X : Finset ι) (x : ι → Bool), P g → P (fixOn X x g)

/-! ## Row-specific definitions -/

/-- `g` takes values in `[-1, 1]`. -/
def Bounded {ι : Type} (g : (ι → Bool) → ℝ) : Prop := ∀ x, |g x| ≤ 1

/-- `g` is a (multilinear) polynomial of degree at most `D`: all Fourier coefficients of
sets of size `> D` vanish. -/
def DegLE {ι : Type} [Fintype ι] [DecidableEq ι] (g : (ι → Bool) → ℝ) (D : ℕ) : Prop :=
  ∀ S : Finset ι, D < S.card → fourierCoeff g S = 0

/-- Supplied fact 1: "every multilinear polynomial `q : {-1,1}^m → [-1,1]` of degree at most
`D` satisfies `L_{1,1}(q) ≤ C₀ D`" (for every finite coordinate set). -/
def LevelOneFact (C0 : ℝ) : Prop :=
  ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (q : (ι → Bool) → ℝ) (D : ℕ),
    Bounded q → DegLE q D → levelL1 q 1 ≤ C0 * D

/-- A phase-oracle quantum query algorithm on `N` input bits with workspace `W`. Basis states
are `(i, w)` with `i : Option (Fin N)`; the oracle multiplies `|some i, w⟩` by `x_i` and
leaves `|none, w⟩` unchanged. -/
structure QueryAlg (N : ℕ) (W : Type) where
  /-- number of oracle calls `d` -/
  queries : ℕ
  /-- initial state -/
  init : Option (Fin N) × W → ℂ
  /-- input-independent unitaries `U_0, …, U_d` (only `t ≤ queries` is used) -/
  U : ℕ → Matrix (Option (Fin N) × W) (Option (Fin N) × W) ℂ
  /-- accepting basis states -/
  accept : Finset (Option (Fin N) × W)

/-- The phase oracle `O_x`. -/
def phaseOracle {N : ℕ} (W : Type) [DecidableEq W] (x : Fin N → Bool) :
    Matrix (Option (Fin N) × W) (Option (Fin N) × W) ℂ :=
  Matrix.diagonal (fun b => match b.1 with
    | none => 1
    | some i => ((boolToSign (x i) : ℝ) : ℂ))

/-- State after `U_t O_x U_{t-1} ⋯ O_x U_0` applied to the initial state. -/
def QueryAlg.state {N : ℕ} {W : Type} [Fintype W] [DecidableEq W] (A : QueryAlg N W)
    (x : Fin N → Bool) : ℕ → (Option (Fin N) × W → ℂ)
  | 0 => A.U 0 *ᵥ A.init
  | t + 1 => A.U (t + 1) *ᵥ (phaseOracle W x *ᵥ QueryAlg.state A x t)

/-- Acceptance probability `f(x)` of the `d`-query algorithm. -/
def QueryAlg.acceptProb {N : ℕ} {W : Type} [Fintype W] [DecidableEq W] (A : QueryAlg N W)
    (x : Fin N → Bool) : ℝ :=
  ∑ b ∈ A.accept, Complex.normSq (A.state x A.queries b)

/-- Validity: unit initial vector and unitary `U_t` for `t ≤ d`. -/
def QueryAlg.Valid {N : ℕ} {W : Type} [Fintype W] [DecidableEq W] (A : QueryAlg N W) : Prop :=
  (∑ b, Complex.normSq (A.init b) = 1) ∧
    ∀ t ≤ A.queries, A.U t ∈ Matrix.unitaryGroup (Option (Fin N) × W) ℂ

/-- Supplied fact 2 (polynomial method): the acceptance probability of a `d`-query quantum
algorithm takes values in `[0,1]` and is a polynomial of degree at most `2d`. -/
def QueryPolyFact : Prop :=
  ∀ (N : ℕ) (W : Type) [Fintype W] [DecidableEq W] (A : QueryAlg N W), A.Valid →
    (∀ x, 0 ≤ A.acceptProb x ∧ A.acceptProb x ≤ 1) ∧ DegLE A.acceptProb (2 * A.queries)

/-! ## Rubric lemma stubs -/

/-- Rubric 1: restrictions preserve boundedness. [FourierSpectrumOfNoisy, node_25] -/
theorem bounded_restrictTo {N : ℕ} (f : BooleanFunc N) (ρ : Restriction N)
    (hf : Bounded f) : Bounded (restrictTo f ρ) := by
  sorry

/-- Rubric 1: restrictions preserve degree. [FourierSpectrumOfNoisy, node_25] -/
theorem degLE_restrictTo {N : ℕ} (f : BooleanFunc N) (ρ : Restriction N) (d : ℕ)
    (hf : DegLE f d) : DegLE (restrictTo f ρ) d := by
  sorry

/-- Rubric 1: fixing coordinates (`q ↦ q_x`) preserves boundedness and degree, so the class of
bounded degree-`D` functions is closed under `fixOn`. [FourierSpectrumOfNoisy, node_25] -/
theorem closedUnderFix_boundedDeg {ι : Type} [Fintype ι] [DecidableEq ι] (D : ℕ) :
    ClosedUnderFix (fun g : (ι → Bool) → ℝ => Bounded g ∧ DegLE g D) := by
  sorry

/-- The level-`k` growth of `f|_ρ` on `U_ρ` equals that of `f ∘ R_ρ` (`R_ρ = ρ.extend`) on the
full cube. [FourierSpectrumOfNoisy, node_25] -/
theorem levelL1_restrictTo_eq {N : ℕ} (f : BooleanFunc N) (ρ : Restriction N) (k : ℕ) :
    levelL1 (restrictTo f ρ) k = levelL1 (fun x => f (ρ.extend x)) k := by
  sorry

/-- Rubric 2: if each coordinate lies in `X` independently with probability `1/(k+1)`, then
for `|S| = k+1`, `Pr[|S ∩ X| = 1] = (k/(k+1))^k`. [FourierSpectrumOfNoisy, node_25] -/
theorem isolation_prob {ι : Type} [Fintype ι] [DecidableEq ι] (k : ℕ) (S : Finset ι)
    (hS : S.card = k + 1) :
    ∑ X : Finset ι, (1 / ((k : ℝ) + 1)) ^ X.card *
        (1 - 1 / ((k : ℝ) + 1)) ^ (Fintype.card ι - X.card) *
        (if (S ∩ X).card = 1 then (1 : ℝ) else 0)
      = ((k : ℝ) / ((k : ℝ) + 1)) ^ k := by
  sorry

/-- Rubric 2: the isolation probability is at least `e⁻¹`. [FourierSpectrumOfNoisy, node_25] -/
theorem isolation_prob_ge (k : ℕ) :
    Real.exp (-1) ≤ ((k : ℝ) / ((k : ℝ) + 1)) ^ k := by
  sorry

/-- Rubric 3 (identity (5)): for `i ∈ X` and `T` disjoint from `X`,
`q̂(T ∪ {i}) = 𝔼_x[x_i · q̂_x(T)]`. [FourierSpectrumOfNoisy, node_25] -/
theorem fourier_insert_eq_avg_fixOn {ι : Type} [Fintype ι] [DecidableEq ι]
    (q : (ι → Bool) → ℝ) (X T : Finset ι) (i : ι) (hi : i ∈ X) (hT : Disjoint T X) :
    fourierCoeff q (insert i T) =
      (Fintype.card (ι → Bool) : ℝ)⁻¹ *
        ∑ x : ι → Bool, boolToSign (x i) * fourierCoeff (fixOn X x q) T := by
  sorry

/-- Rubric 4: expected maximum of `M ≥ N` Rademacher sums with coefficients in `[-1,1]` on at
most `N` coordinates is `O(√(N log M log N))`. [FourierSpectrumOfNoisy, node_25] -/
theorem expected_max_rademacher :
    ∃ C1 : ℝ, 0 < C1 ∧
      ∀ (ι τ : Type) [Fintype ι] [DecidableEq ι] [Fintype τ] [Nonempty τ]
        (N : ℕ) (X : Finset ι) (a : τ → ι → ℝ),
        2 ≤ N → Fintype.card ι ≤ N → N ≤ Fintype.card τ → (∀ t i, |a t i| ≤ 1) →
        (Fintype.card (ι → Bool) : ℝ)⁻¹ *
            ∑ x : ι → Bool, (⨆ t : τ, |∑ i ∈ X, a t i * boolToSign (x i)|)
          ≤ C1 * Real.sqrt ((N : ℝ) * Real.log ((Fintype.card τ : ℕ) : ℝ) * Real.log N) := by
  sorry

/-- Rubrics 2–4 combined: the level-to-level recurrence
`A_{r+1} ≤ C₂ A_r √(N log binom(N,r) log N)` for any family closed under fixing coordinates. [FourierSpectrumOfNoisy, node_25] -/
theorem level_recurrence :
    ∃ C2 : ℝ, 0 < C2 ∧
      ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (P : ((ι → Bool) → ℝ) → Prop)
        (N r : ℕ) (B : ℝ),
        2 ≤ N → Fintype.card ι ≤ N → 1 ≤ r → ClosedUnderFix P →
        (∀ g, P g → levelL1 g r ≤ B) →
        ∀ g, P g → levelL1 g (r + 1) ≤
          C2 * B * Real.sqrt ((N : ℝ) * Real.log ((N.choose r : ℕ) : ℝ) * Real.log N) := by
  sorry

/-- Rubric 5: `log binom(N,k) ≤ k log N`. [FourierSpectrumOfNoisy, node_25] -/
theorem log_choose_le (N k : ℕ) (hN : 1 ≤ N) (hk : k ≤ N) :
    Real.log ((N.choose k : ℕ) : ℝ) ≤ k * Real.log N := by
  sorry

/-! ## Main theorems -/

/-- Main theorem (polynomials): with the supplied level-one estimate, there is a universal
`c > 0` such that `L_{1,ℓ}(f|_ρ) ≤ c^ℓ d N^{(ℓ-1)/2} log^{ℓ-1}(N) √(ℓ!)` for every bounded
degree-`≤ d` `f` on `N ≥ 1` variables, every restriction `ρ` and every `ℓ ≥ 1`. [FourierSpectrumOfNoisy, node_25] -/
theorem main_polynomial (C0 : ℝ) (hC0 : LevelOneFact C0) :
    ∃ c : ℝ, 0 < c ∧
      ∀ (N d : ℕ) (f : BooleanFunc N) (ρ : Restriction N) (ℓ : ℕ),
        1 ≤ N → 1 ≤ ℓ → Bounded f → DegLE f d →
        levelL1 (restrictTo f ρ) ℓ ≤
          c ^ ℓ * (d : ℝ) * (N : ℝ) ^ (((ℓ : ℝ) - 1) / 2) * Real.log N ^ (ℓ - 1) *
            Real.sqrt (ℓ.factorial : ℝ) := by
  sorry

/-- Rubric 6 / main theorem (quantum): the same bound, with `d` the number of queries, for the
acceptance probability of any valid `d`-query quantum algorithm. [FourierSpectrumOfNoisy, node_25] -/
theorem main_bqp (C0 : ℝ) (hC0 : LevelOneFact C0) (hQ : QueryPolyFact) :
    ∃ c : ℝ, 0 < c ∧
      ∀ (N : ℕ) (W : Type) [Fintype W] [DecidableEq W] (A : QueryAlg N W)
        (ρ : Restriction N) (ℓ : ℕ),
        1 ≤ N → 1 ≤ ℓ → A.Valid →
        levelL1 (restrictTo A.acceptProb ρ) ℓ ≤
          c ^ ℓ * (A.queries : ℝ) * (N : ℝ) ^ (((ℓ : ℝ) - 1) / 2) * Real.log N ^ (ℓ - 1) *
            Real.sqrt (ℓ.factorial : ℝ) := by
  sorry

end TCSChallenge.FourierSpectrumOfNoisy.node_25
