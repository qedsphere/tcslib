open scoped Classical
open TCSlib.InformationTheory

/-!
## A `d^{1/2+o(1)}` monotonicity tester for Boolean functions on hypergrids

A function `f : [n]^d → {0,1}` (here `(Fin d → Fin n) → Bool`, `false < true`, product order on
the grid) is monotone if `x ⪯ y → f x ≤ f y`. `distMon f` is the minimum fraction of points on
which `f` must be changed to become monotone.

A non-adaptive one-sided tester is a distribution `w : FinDist (Finset (Grid d n))` on finite
query sets `Q ⊆ [n]^d` (chosen without looking at `f`); it rejects iff `Q` contains a violating
pair `x ⪯ y`, `f x = true`, `f y = false`. Its query complexity is the largest `|Q|` with
`w Q ≠ 0`.

Main theorem `monotonicity_tester`: given the two supplied facts (domain reduction with
`m = ⌈(d/ε)^8⌉`, and the `O(1)`-query violation sampler on `[m]^d` for `m ≤ d^C`,
`η ≥ d^{-1/2}`), there are constants `C, c, d₀` such that for all `d ≥ d₀`, all `n ≥ 1` and all
`ε ∈ (0,1)` there is such a tester with at most `C ε^{-2} d^{1/2 + c / log log d}` queries that
rejects every `f` with `distMon f ≥ ε` with probability at least `2/3`.

Lemma stubs: the weighted dyadic tail lemma, monotone pullback along sorted lists, the
line-based fallback tester, and soundness of witness-based testers on monotone functions.
-/

namespace TCSChallenge.AD12o1MonotonicityTester.node_03

/-- Points of the hypergrid `[n]^d`; the order `x ≤ y` is the coordinatewise order `x ⪯ y`. -/
abbrev Grid (d n : ℕ) : Type := Fin d → Fin n

/-- "A violating pair consists of `x ⪯ y` with `f(x) > f(y)`": the query set `Q` contains one. -/
def FindsViolation {d n : ℕ} (f : Grid d n → Bool) (Q : Finset (Grid d n)) : Prop :=
  ∃ x ∈ Q, ∃ y ∈ Q, x ≤ y ∧ f x = true ∧ f y = false

/-- Number of points where `f` and `h` differ. -/
def disagree {d n : ℕ} (f h : Grid d n → Bool) : ℕ :=
  (Finset.univ.filter (fun x => f x ≠ h x)).card

/-- Minimum number of changes needed to make `f` monotone (the constant `false` function is
monotone, so the set is nonempty). -/
def distCount {d n : ℕ} (f : Grid d n → Bool) : ℕ :=
  sInf {k : ℕ | ∃ h : Grid d n → Bool, Monotone h ∧ disagree f h = k}

/-- "`dist_mon(g)` is the minimum fraction of values that must be changed to make `g` monotone,
measured under the uniform distribution on that grid." -/
def distMon {d n : ℕ} (f : Grid d n → Bool) : ℝ :=
  (distCount f : ℝ) / (Fintype.card (Grid d n) : ℝ)

/-- The tester makes at most `q` queries on every run of positive probability. Stated for an
arbitrary weight function; a tester `w : FinDist _` is passed as `⇑w`. -/
def QueriesAtMost {d n : ℕ} (w : Finset (Grid d n) → ℝ) (q : ℝ) : Prop :=
  ∀ Q, w Q ≠ 0 → (Q.card : ℝ) ≤ q

/-- Probability that the tester finds (and hence reports) a violating pair of `f`. Stated for
an arbitrary weight function; a tester `w : FinDist _` is passed as `⇑w`. -/
def rejectProb {d n : ℕ} (w : Finset (Grid d n) → ℝ) (f : Grid d n → Bool) : ℝ :=
  ∑ Q, if FindsViolation f Q then w Q else 0

/-- "Sort them into a list `T_i`, retaining repetitions": the sorted version of `s`. -/
def sortedList {m n : ℕ} (s : Fin m → Fin n) : Fin m → Fin n :=
  s ∘ Tuple.sort s

/-- `g_T(a₁,…,a_d) = f(T₁(a₁),…,T_d(a_d))`, where `T_i` is the sorted version of the `m`
independent uniform samples `S i`. -/
def pull {d n m : ℕ} (f : Grid d n → Bool) (S : Fin d → Fin m → Fin n) : Grid d m → Bool :=
  fun a => f (fun i => sortedList (S i) (a i))

/-- The side length `m = ⌈(d/ε)^8⌉` of the reduced grid. -/
def reducedSide (d : ℕ) (ε : ℝ) : ℕ := ⌈((d : ℝ) / ε) ^ (8 : ℕ)⌉₊

/-- Supplied result 1 (domain reduction): if `dist_mon(f) ≥ ε` then
`𝔼_T[dist_mon(g_T)] ≥ ε/2`, the expectation being over uniform `S : [d] → [m] → [n]`. -/
def DomainReductionFact : Prop :=
  ∀ (d n : ℕ), 1 ≤ d → 1 ≤ n → ∀ ε : ℝ, 0 < ε → ε < 1 →
    ∀ f : Grid d n → Bool, ε ≤ distMon f →
      ε / 2 ≤ (1 / (Fintype.card (Fin d → Fin (reducedSide d ε) → Fin n) : ℝ)) *
        ∑ S : Fin d → Fin (reducedSide d ε) → Fin n, distMon (pull f S)

/-- Supplied result 2 (restricted-range violation sampler): for every fixed `C ≥ 1`, whenever
`m ≤ d^C` and `d^{-1/2} ≤ η < 1`, a non-adaptive `O(1)`-query procedure finds a violating pair
of any `g : [m]^d → {0,1}` with `dist_mon(g) ≥ η` with probability at least
`η² d^{-1/2-O(1/log log d)}` (stated with an extra constant factor `1/K`, which only weakens it). -/
def SamplerFact : Prop :=
  ∀ C : ℝ, 1 ≤ C → ∃ (q : ℕ) (K c : ℝ) (d₀ : ℕ), 0 < K ∧ 0 ≤ c ∧
    ∀ d : ℕ, d₀ ≤ d → ∀ m : ℕ, 1 ≤ m → (m : ℝ) ≤ (d : ℝ) ^ C →
      ∀ η : ℝ, (d : ℝ) ^ (-(1 / 2 : ℝ)) ≤ η → η < 1 →
        ∃ w : FinDist (Finset (Grid d m)), QueriesAtMost ⇑w q ∧
          ∀ g : Grid d m → Bool, η ≤ distMon g →
            η ^ 2 * (d : ℝ) ^ (-(1 / 2 : ℝ) - c / Real.logb 2 (Real.logb 2 d)) / K
              ≤ rejectProb ⇑w g

/-! ## Lemma stubs -/

/-- Witness-based testers never reject monotone functions (one-sided error). [AD12o1MonotonicityTester, node_03] -/
theorem rejectProb_monotone_eq_zero {d n : ℕ} (w : Finset (Grid d n) → ℝ)
    (f : Grid d n → Bool) (hf : Monotone f) : rejectProb w f = 0 := by
  sorry

/-- Ordered restrictions preserve monotonicity: the pullback `g_T` of a monotone `f` along
sorted lists is monotone. [AD12o1MonotonicityTester, node_03] -/
theorem pull_monotone {d n m : ℕ} (f : Grid d n → Bool) (hf : Monotone f)
    (S : Fin d → Fin m → Fin n) : Monotone (pull f S) := by
  sorry

/-- Weighted dyadic tail lemma. Let `X` be a `[0,1]`-valued random variable on a finite
probability space `(Ω, p)` with `𝔼[X] ≥ ε/2`, and let `J` be the first index with
`2^{-J} ≤ ε/8`. Then some threshold `η = 2^{-j}`, `1 ≤ j ≤ J`, satisfies
`Pr[X ≥ η] ≥ c · ε / (η · log²(2/η))` for an absolute constant `c > 0`. [AD12o1MonotonicityTester, node_03] -/
theorem dyadic_tail_lemma :
    ∃ c : ℝ, 0 < c ∧
      ∀ {Ω : Type} [Fintype Ω] (p : FinDist Ω) (X : Ω → ℝ) (ε : ℝ) (J : ℕ),
        (∀ ω, 0 ≤ X ω ∧ X ω ≤ 1) →
        0 < ε → ε < 1 → ε / 2 ≤ ∑ ω, p ω * X ω →
        (2 : ℝ)⁻¹ ^ J ≤ ε / 8 → (∀ j : ℕ, j < J → ε / 8 < (2 : ℝ)⁻¹ ^ j) →
        ∃ j : ℕ, 1 ≤ j ∧ j ≤ J ∧
          c * ε / ((2 : ℝ)⁻¹ ^ j * (Real.logb 2 (2 / (2 : ℝ)⁻¹ ^ j)) ^ 2)
            ≤ ∑ ω, if (2 : ℝ)⁻¹ ^ j ≤ X ω then p ω else 0 := by
  sorry

/-- Line-based fallback tester (standard; Dodis et al. style, weakened to `log²`): a
non-adaptive 2-query procedure on `[m]^d` that finds a violating pair of any `g` with
`dist_mon(g) ≥ η` with probability at least `η / (K d log²(2m))`, for every side length `m`
and every `η ∈ (0,1)`. [AD12o1MonotonicityTester, node_03] -/
theorem line_tester :
    ∃ K : ℝ, 0 < K ∧ ∀ (d m : ℕ), 1 ≤ d → 1 ≤ m → ∀ η : ℝ, 0 < η → η < 1 →
      ∃ w : FinDist (Finset (Grid d m)), QueriesAtMost ⇑w 2 ∧
        ∀ g : Grid d m → Bool, η ≤ distMon g →
          η / (K * d * (Real.logb 2 (2 * m)) ^ 2) ≤ rejectProb ⇑w g := by
  sorry

/-! ## Main theorem -/

/-- **Target theorem.** Assuming the two supplied results, there are constants `C, c, d₀`
(independent of `n` and `ε`) such that for every `d ≥ d₀`, `n ≥ 1`, `ε ∈ (0,1)` there is a
non-adaptive one-sided tester making at most `C ε^{-2} d^{1/2 + c/log log d}` queries that
rejects every `f` with `dist_mon(f) ≥ ε` with probability at least `2/3`. [AD12o1MonotonicityTester, node_03] -/
theorem monotonicity_tester (hRed : DomainReductionFact) (hSamp : SamplerFact) :
    ∃ (C c : ℝ) (d₀ : ℕ), 0 < C ∧ 0 ≤ c ∧
      ∀ d : ℕ, d₀ ≤ d → ∀ n : ℕ, 1 ≤ n → ∀ ε : ℝ, 0 < ε → ε < 1 →
        ∃ w : FinDist (Finset (Grid d n)),
          QueriesAtMost ⇑w
            (C * ε ^ (-(2 : ℝ)) * (d : ℝ) ^ ((1 / 2 : ℝ) + c / Real.logb 2 (Real.logb 2 d))) ∧
          ∀ f : Grid d n → Bool, ε ≤ distMon f → (2 / 3 : ℝ) ≤ rejectProb ⇑w f := by
  sorry

end TCSChallenge.AD12o1MonotonicityTester.node_03
