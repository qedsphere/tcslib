/-!
## One trial of the dyadic path tester on `[n]^d` rejects with probability `ε² d^{-1/2-o(1)}`

`[n]^d = Fin d → Fin n` with the coordinatewise order and uniform measure. `L = ⌈log₂ n⌉`,
`s_q = min(2^q, n)`. One coordinate step from `a`: choose `q ∈ [L]` uniformly, a uniform
cyclic interval `I` of length `s_q` containing `a`, then a uniform `b ∈ I \ {a}`; the
resulting law is `companion n a b`. The walk `U_k(x)` picks a uniform `k`-subset `R` of
coordinates and moves each `i ∈ R` to its companion if it is larger (`D_k`: if smaller).

One trial chooses `p ∈ {0,…,⌊log₂ d⌋}` uniformly, `τ = 2^p`, and for `ℓ ∈ {τ−1, τ}` runs
the four tests of the problem with fresh randomness; `trialRejectProb` is its exact
rejection probability. Main theorem: `trial_reject_lower_bound`.
-/

namespace TCSChallenge.AD12o1MonotonicityTester.node07

open Finset

/-- `L = ⌈log₂ n⌉`. -/
def Lc (n : ℕ) : ℕ := Nat.clog 2 n

/-- `s_q = min{2^q, n}`. -/
def scale (n q : ℕ) : ℕ := min (2 ^ q) n

/-- "A cyclic interval of length s in ℤ_n consists of s consecutive residues and is indexed
by its starting residue": `{j, j+1, …, j+s−1} mod n`. -/
def cycInt (n s : ℕ) (j : Fin n) : Finset (Fin n) :=
  univ.filter (fun b : Fin n => ((b : ℕ) + n - (j : ℕ)) % n < s)

/-- Starting residues of the cyclic intervals of length `s_q` that contain `a`. -/
def containing (n q : ℕ) (a : Fin n) : Finset (Fin n) :=
  univ.filter (fun j : Fin n => a ∈ cycInt n (scale n q) j)

/-- One-coordinate companion law `Q(a,b)`: `q` uniform in `[L]`, a uniform cyclic interval
`I` of length `s_q` containing `a`, then `b` uniform in `I \ {a}`. -/
def companion (n : ℕ) (a b : Fin n) : ℝ :=
  (1 / (Lc n : ℝ)) * ∑ q ∈ Icc 1 (Lc n),
    (1 / ((containing n q a).card : ℝ)) * ∑ j ∈ containing n q a,
      (if b ∈ (cycInt n (scale n q) j).erase a
        then 1 / (((cycInt n (scale n q) j).erase a).card : ℝ) else 0)

/-- Upward coordinate kernel: "replace x_i by a_i if a_i > x_i" (otherwise stay). -/
def upCoord (n : ℕ) (a b : Fin n) : ℝ :=
  if a < b then companion n a b
  else if b = a then ∑ c ∈ univ.filter (fun c : Fin n => ¬ a < c), companion n a c
  else 0

/-- Downward coordinate kernel: "replace x_i by a_i if a_i < x_i" (otherwise stay). -/
def downCoord (n : ℕ) (a b : Fin n) : ℝ :=
  if b < a then companion n a b
  else if b = a then ∑ c ∈ univ.filter (fun c : Fin n => ¬ c < a), companion n a c
  else 0

/-- `Pr[U_k(x) = y]`: uniform `k`-subset `R ⊆ [d]`, independent upward steps on `R`,
other coordinates unchanged. For `k = 0` this is the point mass at `x`. -/
def upWalk (n d k : ℕ) (x y : Fin d → Fin n) : ℝ :=
  (1 / ((d.choose k : ℕ) : ℝ)) * ∑ R ∈ (univ : Finset (Fin d)).powersetCard k,
    ∏ i, (if i ∈ R then upCoord n (x i) (y i) else (if y i = x i then 1 else 0))

/-- `Pr[D_k(x) = y]`. -/
def downWalk (n d k : ℕ) (x y : Fin d → Fin n) : ℝ :=
  (1 / ((d.choose k : ℕ) : ℝ)) * ∑ R ∈ (univ : Finset (Fin d)).powersetCard k,
    ∏ i, (if i ∈ R then downCoord n (x i) (y i) else (if y i = x i then 1 else 0))

/-- Indicator of the rejection event `f(x) > f(y)`. -/
def viol {d n : ℕ} (f : (Fin d → Fin n) → Bool) (x y : Fin d → Fin n) : ℝ :=
  if f x = true ∧ f y = false then 1 else 0

/-- Test 1: `x` uniform, `y ∼ U_ℓ(x)`, reject if `f(x) > f(y)`. -/
def test1 (n d : ℕ) (f : (Fin d → Fin n) → Bool) (ℓ : ℕ) : ℝ :=
  ∑ x, ∑ y, (1 / (n : ℝ) ^ d) * upWalk n d ℓ x y * viol f x y

/-- Test 2: `y` uniform, `x ∼ D_ℓ(y)`, reject if `f(x) > f(y)`. -/
def test2 (n d : ℕ) (f : (Fin d → Fin n) → Bool) (ℓ : ℕ) : ℝ :=
  ∑ y, ∑ x, (1 / (n : ℝ) ^ d) * downWalk n d ℓ y x * viol f x y

/-- Test 3: `x` uniform, independently `y ∼ U_ℓ(x)` and `v ∼ D_{τ−1}(x)` (so
`s = x − v ∼ DS_{τ−1}(x)`); reject if `f(x−s) > f(y−s)`, where `x − s = v` and
`y − s = w` with `w + x = y + v` coordinatewise. -/
def test3 (n d : ℕ) (f : (Fin d → Fin n) → Bool) (ℓ τ : ℕ) : ℝ :=
  ∑ x, ∑ y, ∑ v, ∑ w, (1 / (n : ℝ) ^ d) * upWalk n d ℓ x y * downWalk n d (τ - 1) x v *
    (if ∀ i, (w i : ℕ) + (x i : ℕ) = (y i : ℕ) + (v i : ℕ) then 1 else 0) * viol f v w

/-- Test 4: `y` uniform, independently `x ∼ D_ℓ(y)` and `u ∼ U_{τ−1}(y)` (so
`s = u − y ∼ US_{τ−1}(y)`); reject if `f(x+s) > f(y+s)`, where `y + s = u` and
`x + s = w` with `w + y = x + u` coordinatewise. -/
def test4 (n d : ℕ) (f : (Fin d → Fin n) → Bool) (ℓ τ : ℕ) : ℝ :=
  ∑ y, ∑ x, ∑ u, ∑ w, (1 / (n : ℝ) ^ d) * downWalk n d ℓ y x * upWalk n d (τ - 1) y u *
    (if ∀ i, (w i : ℕ) + (y i : ℕ) = (x i : ℕ) + (u i : ℕ) then 1 else 0) * viol f w u

/-- Probability that all four tests at length `ℓ` (with shift length `τ − 1`) accept. -/
def acceptAt (n d : ℕ) (f : (Fin d → Fin n) → Bool) (ℓ τ : ℕ) : ℝ :=
  (1 - test1 n d f ℓ) * (1 - test2 n d f ℓ) * (1 - test3 n d f ℓ τ) * (1 - test4 n d f ℓ τ)

/-- Rejection probability of one trial: `p` uniform in `{0,…,⌊log₂ d⌋}`, `τ = 2^p`, all
eight tests (for `ℓ = τ−1` and `ℓ = τ`) run with fresh randomness. -/
def trialRejectProb (n d : ℕ) (f : (Fin d → Fin n) → Bool) : ℝ :=
  (1 / ((Nat.log 2 d + 1 : ℕ) : ℝ)) * ∑ p ∈ range (Nat.log 2 d + 1),
    (1 - acceptAt n d f (2 ^ p - 1) (2 ^ p) * acceptAt n d f (2 ^ p) (2 ^ p))

/-- "ε-far from monotone if it differs from every monotone Boolean function at at least
εn^d points". -/
def EpsFar {d n : ℕ} (f : (Fin d → Fin n) → Bool) (ε : ℝ) : Prop :=
  ∀ g : (Fin d → Fin n) → Bool, Monotone g →
    ε * (n : ℝ) ^ d ≤ ((univ.filter (fun x => f x ≠ g x)).card : ℝ)

/-- The supplied isoperimetric estimate with constant `a`: for every ε-far `g` and every
family `S₁,…,S_d` covering the violated `i`-edges,
`∑_z √|{i : z ∈ S_i}| ≥ a ε n^d / log(2n)`. -/
def IsoperimetricFact (a : ℝ) : Prop :=
  ∀ (n d : ℕ), 2 ≤ n → 1 ≤ d → ∀ (ε : ℝ) (g : (Fin d → Fin n) → Bool), 0 < ε → EpsFar g ε →
  ∀ S : Fin d → Finset (Fin d → Fin n),
    (∀ (i : Fin d) (x y : Fin d → Fin n), (∀ j, j ≠ i → x j = y j) → x i < y i →
        g x = true → g y = false → x ∈ S i ∨ y ∈ S i) →
    a * ε * (n : ℝ) ^ d / Real.log (2 * n) ≤
      ∑ z, Real.sqrt ((univ.filter (fun i : Fin d => z ∈ S i)).card : ℝ)

/-- Total influence `I = d · Pr_{x, y ∼ U_1(x)}[f(x) ≠ f(y)]`. -/
def influence (n d : ℕ) (f : (Fin d → Fin n) → Bool) : ℝ :=
  (d : ℝ) * ∑ x, ∑ y, (1 / (n : ℝ) ^ d) * upWalk n d 1 x y * (if f x ≠ f y then 1 else 0)

/-- Rubric 1 (cube representation): the companion law is symmetric, `Q(a,b) = Q(b,a)`. [AD12o1MonotonicityTester, node_07] -/
theorem companion_symm (n : ℕ) (hn : 2 ≤ n) (a b : Fin n) :
    companion n a b = companion n b a := by
  sorry

/-- The companion law is a probability distribution on `[n] \ {a}`. [AD12o1MonotonicityTester, node_07] -/
theorem companion_sum_one (n : ℕ) (hn : 2 ≤ n) (a : Fin n) :
    companion n a a = 0 ∧ ∑ b, companion n a b = 1 := by
  sorry

/-- Rubric 1 (influence reduction): `I − 2 I⁻ ≤ √d`, where `I⁻ = d · (test 1 at ℓ = 1)`. [AD12o1MonotonicityTester, node_07] -/
theorem influence_le (n d : ℕ) (hn : 2 ≤ n) (hd : 1 ≤ d) (f : (Fin d → Fin n) → Bool) :
    influence n d f ≤ 2 * ((d : ℝ) * test1 n d f 1) + Real.sqrt d := by
  sorry

/-- **Main theorem.** Given the isoperimetric estimate, for every `c₀ > 0` there are
`b, C > 0` such that for all large `d`, every `2 ≤ n ≤ d^{c₀}`, every `ε ≥ d^{-1/2}` and
every ε-far `f`, one trial rejects with probability
`≥ b ε² d^{-1/2 - C / log log(nd)}`. [AD12o1MonotonicityTester, node_07] -/
theorem trial_reject_lower_bound (a : ℝ) (ha : 0 < a) (hiso : IsoperimetricFact a)
    (c₀ : ℝ) (hc₀ : 0 < c₀) :
    ∃ b C : ℝ, 0 < b ∧ 0 < C ∧ ∃ d₀ : ℕ, ∀ d n : ℕ, d₀ ≤ d → 2 ≤ n →
      (n : ℝ) ≤ (d : ℝ) ^ c₀ →
      ∀ ε : ℝ, (d : ℝ) ^ (-(1 / 2 : ℝ)) ≤ ε →
      ∀ f : (Fin d → Fin n) → Bool, EpsFar f ε →
        b * ε ^ 2 * (d : ℝ) ^ (-(1 / 2 : ℝ) - C / Real.log (Real.log ((n : ℝ) * d))) ≤
          trialRejectProb n d f := by
  sorry

end TCSChallenge.AD12o1MonotonicityTester.node07
