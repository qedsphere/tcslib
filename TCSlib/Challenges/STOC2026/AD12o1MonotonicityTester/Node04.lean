/-!
## Monotonicity testing under an unknown product measure on ℝ^d

`ℝ^d` and `[m]^d` carry the coordinatewise order (Mathlib's Pi order), `Bool` has
`false < true`, so "monotone Boolean function" is Mathlib's `Monotone`. For a product
probability measure `μ = μ₁ × ⋯ × μ_d` (`Measure.pi μ`),
`dist_μ(h) = inf_g μ{h ≠ g}` over measurable monotone `g`.

A non-adaptive tester draws `s` samples from each marginal and an internal seed
`ω ∈ [0,1]`; from these alone it fixes `q` query points and a decision rule applied to the
`q` answers. The tester may depend on `d` and `ε` but not on `μ` or `f`.

Main theorems: `exists_tester_large_d` (query bound `C ε^{-2} d^{1/2 + B/log log d}` for all
large `d`) and `exists_tester_bounded_d` (`C_d ε^{-2}` for each fixed `d`).
-/

namespace TCSChallenge.AD12o1MonotonicityTester.node04

/-- "dist_μ(h) = inf_g ν({x : h(x) ≠ g(x)}), where the infimum is over measurable monotone
Boolean functions g", with `ν = μ₁ × ⋯ × μ_d`. -/
def distMu {d : ℕ} (μ : Fin d → Measure ℝ) (h : (Fin d → ℝ) → Bool) : ℝ≥0∞ :=
  ⨅ g : {g : (Fin d → ℝ) → Bool // Measurable g ∧ Monotone g},
    Measure.pi μ {x | h x ≠ g.1 x}

/-- "On a finite grid, write dist(h) for distance under the uniform measure":
`min_g |{h ≠ g}| / m^d` over monotone `g : [m]^d → {0,1}` (here `[m] = Fin m`). -/
def gridDist {d m : ℕ} (h : (Fin d → Fin m) → Bool) : ℝ :=
  ⨅ g : {g : (Fin d → Fin m) → Bool // Monotone g},
    ((Finset.univ.filter (fun x => h x ≠ g.1 x)).card : ℝ) / (m : ℝ) ^ d

/-- The `m` samples of one marginal sorted increasingly, "retaining repetitions":
`t_{i,1} ≤ ⋯ ≤ t_{i,m}`. -/
def sortedSamples {m : ℕ} (x : Fin m → ℝ) : Fin m → ℝ :=
  x ∘ Tuple.sort x

/-- `F_T(a₁,…,a_d) = f(t_{1,a₁},…,t_{d,a_d})` for the array of sorted samples. -/
def gridRestrict {d m : ℕ} (f : (Fin d → ℝ) → Bool) (raw : Fin d → Fin m → ℝ) :
    (Fin d → Fin m) → Bool :=
  fun a => f (fun i => sortedSamples (raw i) (a i))

/-- Law of the raw sample array: `m` independent samples from each marginal `μ_i`. -/
def sampleArrayLaw {d : ℕ} (μ : Fin d → Measure ℝ) (m : ℕ) : Measure (Fin d → Fin m → ℝ) :=
  Measure.pi (fun i => Measure.pi (fun _ : Fin m => μ i))

/-- A non-adaptive tester with `q` value queries for Boolean functions on ℝ^d. It sees `s`
samples per marginal and a seed `ω ∈ ℝ` (drawn uniformly from `[0,1]`). The query points
depend only on samples and seed ("determined before any function values are received");
`verdict … = true` means *reject*. -/
structure NATester (d : ℕ) where
  s : ℕ
  q : ℕ
  query : (Fin d → Fin s → ℝ) → ℝ → Fin q → (Fin d → ℝ)
  verdict : (Fin d → Fin s → ℝ) → ℝ → (Fin q → Bool) → Bool

/-- Measurability of the tester's query map and decision rule (so rejection probabilities
are honest measures of measurable events). -/
def NATester.IsMeasurable {d : ℕ} (T : NATester d) : Prop :=
  (∀ k : Fin T.q, Measurable (fun p : (Fin d → Fin T.s → ℝ) × ℝ => T.query p.1 p.2 k)) ∧
  (∀ ans : Fin T.q → Bool, Measurable (fun p : (Fin d → Fin T.s → ℝ) × ℝ => T.verdict p.1 p.2 ans))

/-- Joint law of (samples, seed): `s` samples per marginal, independent uniform seed. -/
def testerLaw {d : ℕ} (μ : Fin d → Measure ℝ) (s : ℕ) : Measure ((Fin d → Fin s → ℝ) × ℝ) :=
  (sampleArrayLaw μ s).prod (volume.restrict (Set.Icc (0 : ℝ) 1))

/-- Rejection probability of tester `T` on `f` under the product measure `μ`. -/
def rejectProb {d : ℕ} (μ : Fin d → Measure ℝ) (T : NATester d) (f : (Fin d → ℝ) → Bool) : ℝ≥0∞ :=
  testerLaw μ T.s {p | T.verdict p.1 p.2 (fun k => f (T.query p.1 p.2 k)) = true}

/-- The tester is one-sided and `ε`-sound for every product probability measure and every
measurable `f`. -/
def IsMonotonicityTester {d : ℕ} (T : NATester d) (ε : ℝ) : Prop :=
  ∀ μ : Fin d → Measure ℝ, (∀ i, IsProbabilityMeasure (μ i)) →
  ∀ f : (Fin d → ℝ) → Bool, Measurable f →
    (Monotone f → rejectProb μ T f = 0) ∧
    (ENNReal.ofReal ε ≤ distMu μ f → (2 / 3 : ℝ≥0∞) ≤ rejectProb μ T f)

/-- Rubric 1: the sorted-sample map `[m]^d → ℝ^d` is order preserving (even with repeated
samples), so restrictions of monotone functions are monotone. [AD12o1MonotonicityTester, node_04] -/
theorem gridRestrict_monotone {d m : ℕ} (f : (Fin d → ℝ) → Bool) (hf : Monotone f)
    (raw : Fin d → Fin m → ℝ) : Monotone (gridRestrict f raw) := by
  sorry

/-- Rubric 2 (probability observation): with `J = ⌈log₂(4/ε)⌉`, a `[0,1]`-valued random
variable with mean `≥ ε/2` satisfies `Pr[X ≥ 2^{-j}] ≥ ε 2^j / (16 j²)` for some `1 ≤ j ≤ J`. [AD12o1MonotonicityTester, node_04] -/
theorem dyadic_tail {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    (X : Ω → ℝ) (hX : Measurable X) (h0 : ∀ ω, 0 ≤ X ω) (h1 : ∀ ω, X ω ≤ 1)
    (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1) (hmean : ε / 2 ≤ ∫ ω, X ω ∂P) :
    ∃ j : ℕ, 1 ≤ j ∧ j ≤ ⌈Real.logb 2 (4 / ε)⌉₊ ∧
      ENNReal.ofReal (ε * 2 ^ j / (16 * (j : ℝ) ^ 2)) ≤ P {ω | (2 : ℝ)⁻¹ ^ j ≤ X ω} := by
  sorry

/-- Supplied Fact 1 (domain reduction), stated as a stub: for large `d` and
`m = ⌈(d/ε)^8⌉`, `dist_μ(f) ≥ ε` implies `E_T[dist(F_T)] ≥ ε/2`. [AD12o1MonotonicityTester, node_04] -/
theorem domain_reduction :
    ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d → ∀ ε : ℝ, 0 < ε → ε < 1 →
    ∀ μ : Fin d → Measure ℝ, (∀ i, IsProbabilityMeasure (μ i)) →
    ∀ f : (Fin d → ℝ) → Bool, Measurable f →
      ENNReal.ofReal ε ≤ distMu μ f →
      ε / 2 ≤ ∫ raw, gridDist (gridRestrict f raw) ∂(sampleArrayLaw μ ⌈((d : ℝ) / ε) ^ 8⌉₊) := by
  sorry

/-- **Main theorem (large d).** There are constants `C, B` and `d₀` such that for all
`d ≥ d₀` and `ε ∈ (0,1)` there is a measurable non-adaptive one-sided tester using at most
`C ε^{-2} d^{1/2 + B/log log d}` value queries, accepting monotone `f` with probability 1
and rejecting `f` with `dist_μ(f) ≥ ε` with probability `≥ 2/3`, for every product measure. [AD12o1MonotonicityTester, node_04] -/
theorem exists_tester_large_d :
    ∃ C B : ℝ, 0 < C ∧ 0 < B ∧ ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d → ∀ ε : ℝ, 0 < ε → ε < 1 →
      ∃ T : NATester d, T.IsMeasurable ∧
        (T.q : ℝ) ≤ C * ε ^ (-2 : ℝ) * (d : ℝ) ^ ((1 : ℝ) / 2 + B / Real.log (Real.log d)) ∧
        IsMonotonicityTester T ε := by
  sorry

/-- **Main theorem (bounded d).** For each fixed dimension the query bound is `O(ε^{-2})`. [AD12o1MonotonicityTester, node_04] -/
theorem exists_tester_bounded_d (d : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ ε : ℝ, 0 < ε → ε < 1 →
      ∃ T : NATester d, T.IsMeasurable ∧ (T.q : ℝ) ≤ C * ε ^ (-2 : ℝ) ∧
        IsMonotonicityTester T ε := by
  sorry

end TCSChallenge.AD12o1MonotonicityTester.node04
