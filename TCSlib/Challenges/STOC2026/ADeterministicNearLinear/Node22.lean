/-!
## Geometric transportation via a multiscale grid graph and preconditioner

Points `pts : ι → ℝ^d` (with Euclidean distance `euclid`) carry a zero-sum supply `μ`.
A transportation map `τ` ships `μ(p) > 0` from supply points to demand points `μ(q) < 0`;
`cost τ = ∑ τ(p,q) ‖p - q‖₂`, and `costStar μ` is the infimum over all maps.

The construction: hat-function weights `w_ℓ(x,p)` on the grid `h_ℓ ℤ^d`, `h_ℓ = h₀/2^ℓ`,
`0 ≤ ℓ ≤ L`; a sparse graph `geomGraph` on the points (transition edges between
representatives of consecutive levels and horizontal edges between representatives of grid
sites at index distance `≤ R = ⌈(2C+4)/η⌉`, `C = 64√d`); and the multiscale norm
`Q(b) = ∑_ℓ h_ℓ ‖S_ℓ b‖₁`. Main facts:
* `graph_stretch`: graph distances are within `(1+η)` of Euclidean distances;
* `conditioning`: `‖Bb‖₁ ≤ OPT_G(b) ≤ 10 d (L+1) ‖Bb‖₁` for `B = H / (2√d(L+1))`;
* `cycle_cancel`, `forest_flow_integral`, `forest_flow_to_transport`: map recovery and
  integrality;
* main theorem `approx_flow_gives_approx_transport`: a `(1+ε/4)`-approximate flow on the
  graph with `η = ε/4` yields a transportation map of cost `≤ (1+ε) cost*`, integral when
  `μ` is.
-/

namespace TCSChallenge.ADeterministicNearLinear.node_22

/-! ## Transportation maps -/

/-- Euclidean distance `‖u - v‖₂` on `ℝ^d` (the Pi-type norm is the sup norm, so we write it
out). -/
def euclid {d : ℕ} (u v : Fin d → ℝ) : ℝ :=
  Real.sqrt (∑ j, (u j - v j) ^ 2)

/-- "A transportation map is a function τ : P⁺ × P⁻ → R_{≥0} such that
∑_{q∈P⁻} τ(p,q) = μ(p) for every p∈P⁺, ∑_{p∈P⁺} τ(p,q) = −μ(q) for every q∈P⁻."
Encoded on all of `ι × ι`, vanishing outside `P⁺ × P⁻`. -/
def IsTransportMap {ι : Type*} [Fintype ι] (μ : ι → ℝ) (τ : ι → ι → ℝ) : Prop :=
  (∀ p q, 0 ≤ τ p q) ∧
  (∀ p q, τ p q ≠ 0 → 0 < μ p ∧ μ q < 0) ∧
  (∀ p, 0 < μ p → ∑ q, τ p q = μ p) ∧
  (∀ q, μ q < 0 → ∑ p, τ p q = -μ q)

/-- `cost(τ) = ∑_{p∈P⁺, q∈P⁻} τ(p,q)‖p−q‖₂`. -/
def transportCost {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (τ : ι → ι → ℝ) : ℝ :=
  ∑ p, ∑ q, τ p q * euclid (pts p) (pts q)

/-- `cost*(P,μ)`: the minimum transportation cost (as an infimum over the nonempty set of
transportation maps of a zero-sum `μ`). -/
def costStar {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ) (μ : ι → ℝ) : ℝ :=
  ⨅ τ : {τ : ι → ι → ℝ // IsTransportMap μ τ}, transportCost pts τ.1

/-- Integrality of a vector. -/
def IsIntegralVec {ι : Type*} (b : ι → ℝ) : Prop := ∀ p, ∃ k : ℤ, b p = k

/-- Integrality of a map on pairs. -/
def IsIntegralMap {ι : Type*} (τ : ι → ι → ℝ) : Prop := ∀ p q, ∃ k : ℤ, τ p q = k

/-! ## Flows on a graph whose vertices are the points -/

/-- A (nonnegative, directed) flow supported on edges of `G`; this is equivalent to a signed
flow `f_e` on an arbitrarily oriented incidence matrix. -/
def IsGraphFlow {ι : Type*} (G : SimpleGraph ι) (f : ι → ι → ℝ) : Prop :=
  (∀ u v, 0 ≤ f u v) ∧ (∀ u v, f u v ≠ 0 → G.Adj u v)

/-- Divergence (net outflow) of a flow: the vector `Af`. -/
def netOut {ι : Type*} [Fintype ι] (f : ι → ι → ℝ) (v : ι) : ℝ :=
  ∑ w, f v w - ∑ w, f w v

/-- Graph cost `∑_e w_e |f_e|` with Euclidean edge lengths. -/
def flowCost {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ) (f : ι → ι → ℝ) : ℝ :=
  ∑ u, ∑ v, f u v * euclid (pts u) (pts v)

/-- `OPT_G(b) = min{∑_e w_e|f_e| : Af = b}`. -/
def optGraph {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ) (G : SimpleGraph ι)
    (b : ι → ℝ) : ℝ :=
  ⨅ f : {f : ι → ι → ℝ // IsGraphFlow G f ∧ netOut f = b}, flowCost pts f.1

/-- The flow is supported on a forest: its undirected support graph is acyclic and no edge
carries flow in both directions. -/
def ForestSupported {ι : Type*} (f : ι → ι → ℝ) : Prop :=
  (SimpleGraph.fromRel (fun u v => f u v ≠ 0)).IsAcyclic ∧ ∀ u v, f u v ≠ 0 → f v u = 0

/-! ## Scales and hat-function weights -/

/-- `h_ℓ = h₀ / 2^ℓ`. -/
def hLevel (h0 : ℝ) (ℓ : ℕ) : ℝ := h0 / 2 ^ ℓ

/-- Coordinates of `p` relative to the origin `o` of the bounding box `o + [0,h₀]^d`. -/
def rel {ι : Type*} {d : ℕ} (pts : ι → Fin d → ℝ) (o : Fin d → ℝ) (p : ι) : Fin d → ℝ :=
  fun j => pts p j - o j

/-- Position of grid index `x ∈ ℤ^d` in the grid `h ℤ^d`. -/
def gridPos {d : ℕ} (h : ℝ) (x : Fin d → ℤ) : Fin d → ℝ := fun j => (x j : ℝ) * h

/-- "w_ℓ(x,p) = ∏_{j=1}^d max{0, 1−|x_j−p_j|/h_ℓ}", with `x = h · (grid index)`. -/
def weight {d : ℕ} (h : ℝ) (x : Fin d → ℤ) (z : Fin d → ℝ) : ℝ :=
  ∏ j, max 0 (1 - |(x j : ℝ) * h - z j| / h)

/-- The `2^d` grid indices around `z` that can carry positive weight. -/
def cand {d : ℕ} (h : ℝ) (z : Fin d → ℝ) : Finset (Fin d → ℤ) :=
  Fintype.piFinset (fun j => ({⌊z j / h⌋, ⌊z j / h⌋ + 1} : Finset ℤ))

/-- A finite set of grid indices containing `X_ℓ` (all sites with positive weight for some
point). -/
def gridSites {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ) (o : Fin d → ℝ)
    (h : ℝ) : Finset (Fin d → ℤ) :=
  Finset.univ.biUnion (fun p => cand h (rel pts o p))

/-- `x ∈ X_ℓ`: the grid site has positive weight for at least one input point. -/
def InSupport {ι : Type*} {d : ℕ} (pts : ι → Fin d → ℝ) (o : Fin d → ℝ) (h0 : ℝ) (ℓ : ℕ)
    (x : Fin d → ℤ) : Prop :=
  ∃ p, 0 < weight (hLevel h0 ℓ) x (rel pts o p)

/-- Specification of representatives: "for every x∈X_ℓ choose a representative r_ℓ(x)∈P with
w_ℓ(x,r_ℓ(x))>0". -/
def RepSpec {ι : Type*} {d : ℕ} (pts : ι → Fin d → ℝ) (o : Fin d → ℝ) (h0 : ℝ)
    (rep : ℕ → (Fin d → ℤ) → ι) : Prop :=
  ∀ ℓ x, InSupport pts o h0 ℓ x → 0 < weight (hLevel h0 ℓ) x (rel pts o (rep ℓ x))

/-- Standing geometric hypotheses: `d ≥ 1`, at least two points, all points in
`o + [0,h₀]^d`, `a > 0` a lower bound on pairwise distances, and depth `L` with
`h_L ≤ a/(4√d)`. -/
def Setup {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ) (o : Fin d → ℝ)
    (h0 a : ℝ) (L : ℕ) : Prop :=
  1 ≤ d ∧ 2 ≤ Fintype.card ι ∧ 0 < h0 ∧ 0 < a ∧
  (∀ p j, 0 ≤ pts p j - o j ∧ pts p j - o j ≤ h0) ∧
  (∀ p q, p ≠ q → a ≤ euclid (pts p) (pts q)) ∧
  hLevel h0 L ≤ a / (4 * Real.sqrt d)

/-- `C = 64√d`. -/
def constC (d : ℕ) : ℝ := 64 * Real.sqrt d

/-- `R = ⌈(2C+4)/η⌉`. -/
def radiusR (d : ℕ) (η : ℝ) : ℕ := ⌈(2 * constC d + 4) / η⌉₊

/-- The sparse graph `G` on vertex set `P`: for `ℓ ≥ 1` and positive `R_ℓ(y,x)
= w_{ℓ−1}(y,x)`, connect `r_ℓ(x)` to `r_{ℓ−1}(y)`; for every `ℓ` and `x,y∈X_ℓ` whose grid
indices differ by at most `R` in every coordinate, connect `r_ℓ(x)` to `r_ℓ(y)`. Loops are
omitted by `fromRel`. -/
def geomGraph {ι : Type*} {d : ℕ} (pts : ι → Fin d → ℝ) (o : Fin d → ℝ) (h0 η : ℝ)
    (L : ℕ) (rep : ℕ → (Fin d → ℤ) → ι) : SimpleGraph ι :=
  SimpleGraph.fromRel (fun u v =>
    ∃ ℓ, ℓ ≤ L ∧ ∃ x y : Fin d → ℤ, InSupport pts o h0 ℓ x ∧
      ((1 ≤ ℓ ∧ 0 < weight (hLevel h0 (ℓ - 1)) y (gridPos (hLevel h0 ℓ) x) ∧
          u = rep ℓ x ∧ v = rep (ℓ - 1) y) ∨
       (InSupport pts o h0 ℓ y ∧ (∀ j, |x j - y j| ≤ (radiusR d η : ℤ)) ∧
          u = rep ℓ x ∧ v = rep ℓ y)))

/-- The multiscale norm `Q(b) = ∑_{ℓ=0}^L h_ℓ ‖S_ℓ b‖₁ = ‖H b‖₁`. -/
def multiscaleQ {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ) (o : Fin d → ℝ)
    (h0 : ℝ) (L : ℕ) (b : ι → ℝ) : ℝ :=
  ∑ ℓ ∈ Finset.range (L + 1), hLevel h0 ℓ *
    ∑ x ∈ gridSites pts o (hLevel h0 ℓ), |∑ p, weight (hLevel h0 ℓ) x (rel pts o p) * b p|

/-- Length of a walk given as a vertex sequence. -/
def walkLength {ι : Type*} {d : ℕ} (pts : ι → Fin d → ℝ) {k : ℕ} (π : Fin (k + 1) → ι) : ℝ :=
  ∑ i : Fin k, euclid (pts (π i.castSucc)) (pts (π i.succ))

/-! ## Lemma stubs -/

/-- Partition of unity: "For every p these weights sum to one". [ADeterministicNearLinear, node_22] -/
theorem weight_sum_one {d : ℕ} (h : ℝ) (hh : 0 < h) (z : Fin d → ℝ) :
    ∑ x ∈ cand h z, weight h x z = 1 := by sorry

/-- Weights vanish off the candidate sites. [ADeterministicNearLinear, node_22] -/
theorem weight_eq_zero_of_not_mem_cand {d : ℕ} (h : ℝ) (hh : 0 < h) (z : Fin d → ℝ)
    (x : Fin d → ℤ) (hx : x ∉ cand h z) : weight h x z = 0 := by sorry

/-- Refinement identity (1): `S_{ℓ−1} = R_ℓ S_ℓ`. [ADeterministicNearLinear, node_22] -/
theorem weight_refinement {d : ℕ} (h0 : ℝ) (hh0 : 0 < h0) (ℓ : ℕ) (hℓ : 1 ≤ ℓ)
    (y : Fin d → ℤ) (z : Fin d → ℝ) :
    weight (hLevel h0 (ℓ - 1)) y z =
      ∑ x ∈ cand (hLevel h0 ℓ) z,
        weight (hLevel h0 (ℓ - 1)) y (gridPos (hLevel h0 ℓ) x) * weight (hLevel h0 ℓ) x z := by
  sorry

/-- Cancellation estimate (6): `‖S_ℓ(e_p − e_q)‖₁ ≤ 2‖p−q‖₁/h_ℓ`. [ADeterministicNearLinear, node_22] -/
theorem weight_l1_diff {d : ℕ} (h : ℝ) (hh : 0 < h) (z z' : Fin d → ℝ) :
    ∑ x ∈ cand h z ∪ cand h z', |weight h x z - weight h x z'| ≤
      2 * (∑ j, |z j - z' j|) / h := by sorry

/-- At the finest level no grid site has positive weight for two different points. [ADeterministicNearLinear, node_22] -/
theorem finest_level_unique {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (o : Fin d → ℝ) (h0 a : ℝ) (L : ℕ) (hS : Setup pts o h0 a L) (x : Fin d → ℤ) (p q : ι)
    (hp : 0 < weight (hLevel h0 L) x (rel pts o p))
    (hq : 0 < weight (hLevel h0 L) x (rel pts o q)) : p = q := by sorry

/-- Stretch bound (5): `dist_G(p,q) ≤ (1+η)‖p−q‖₂` for every pair, via an explicit walk. [ADeterministicNearLinear, node_22] -/
theorem graph_stretch {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (o : Fin d → ℝ) (h0 a η : ℝ) (L : ℕ) (rep : ℕ → (Fin d → ℤ) → ι)
    (hS : Setup pts o h0 a L) (hrep : RepSpec pts o h0 rep) (hη : 0 < η) (hη1 : η ≤ 1)
    (p q : ι) :
    ∃ (k : ℕ) (π : Fin (k + 1) → ι), π 0 = p ∧ π (Fin.last k) = q ∧
      (∀ i : Fin k, (geomGraph pts o h0 η L rep).Adj (π i.castSucc) (π i.succ)) ∧
      walkLength pts π ≤ (1 + η) * euclid (pts p) (pts q) := by sorry

/-- Near-isometric reduction: routing any transportation map along stretch paths gives a
graph flow with `OPT_G(μ) ≤ (1+η) cost(τ)`. [ADeterministicNearLinear, node_22] -/
theorem graph_flow_of_transport {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (o : Fin d → ℝ) (h0 a η : ℝ) (L : ℕ) (rep : ℕ → (Fin d → ℤ) → ι)
    (hS : Setup pts o h0 a L) (hrep : RepSpec pts o h0 rep) (hη : 0 < η) (hη1 : η ≤ 1)
    (μ : ι → ℝ) (τ : ι → ι → ℝ) (hτ : IsTransportMap μ τ) :
    ∃ f, IsGraphFlow (geomGraph pts o h0 η L rep) f ∧ netOut f = μ ∧
      flowCost pts f ≤ (1 + η) * transportCost pts τ := by sorry

/-- Inequality (7), per flow: `Q(Af) ≤ 2√d(L+1) ∑_e |f_e| ‖u−v‖₂`. [ADeterministicNearLinear, node_22] -/
theorem Q_le_flowCost {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (o : Fin d → ℝ) (h0 : ℝ) (hh0 : 0 < h0) (L : ℕ) (f : ι → ι → ℝ)
    (hf : ∀ u v, 0 ≤ f u v) :
    multiscaleQ pts o h0 L (netOut f) ≤
      2 * Real.sqrt d * (L + 1) * flowCost pts f := by sorry

/-- Inequality (8): an explicit feasible routing of every zero-sum `b` with cost
`≤ 5√d Q(b)`. [ADeterministicNearLinear, node_22] -/
theorem exists_routing_le_Q {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (o : Fin d → ℝ) (h0 a η : ℝ) (L : ℕ) (rep : ℕ → (Fin d → ℤ) → ι)
    (hS : Setup pts o h0 a L) (hrep : RepSpec pts o h0 rep) (hη : 0 < η) (hη1 : η ≤ 1)
    (b : ι → ℝ) (hb : ∑ p, b p = 0) :
    ∃ f, IsGraphFlow (geomGraph pts o h0 η L rep) f ∧ netOut f = b ∧
      flowCost pts f ≤ 5 * Real.sqrt d * multiscaleQ pts o h0 L b := by sorry

/-- Full column rank of `H`: `Q(b) = 0` forces `b = 0`. [ADeterministicNearLinear, node_22] -/
theorem Q_eq_zero_imp {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (o : Fin d → ℝ) (h0 a : ℝ) (L : ℕ) (hS : Setup pts o h0 a L) (b : ι → ℝ)
    (hb : multiscaleQ pts o h0 L b = 0) : b = 0 := by sorry

/-- Conditioning (9): with `‖Bb‖₁ = Q(b)/(2√d(L+1))`,
`‖Bb‖₁ ≤ OPT_G(b) ≤ 10 d (L+1) ‖Bb‖₁` for every zero-sum `b`, i.e. `κ = O_d(L+1)`. [ADeterministicNearLinear, node_22] -/
theorem conditioning {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (o : Fin d → ℝ) (h0 a η : ℝ) (L : ℕ) (rep : ℕ → (Fin d → ℤ) → ι)
    (hS : Setup pts o h0 a L) (hrep : RepSpec pts o h0 rep) (hη : 0 < η) (hη1 : η ≤ 1)
    (b : ι → ℝ) (hb : ∑ p, b p = 0) :
    multiscaleQ pts o h0 L b / (2 * Real.sqrt d * (L + 1)) ≤
        optGraph pts (geomGraph pts o h0 η L rep) b ∧
      optGraph pts (geomGraph pts o h0 η L rep) b ≤
        10 * d * (L + 1) * (multiscaleQ pts o h0 L b / (2 * Real.sqrt d * (L + 1))) := by
  sorry

/-- Cycle cancellation: any graph flow can be replaced by a forest-supported graph flow with
the same divergence and no larger cost. [ADeterministicNearLinear, node_22] -/
theorem cycle_cancel {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (G : SimpleGraph ι) (f : ι → ι → ℝ) (hf : IsGraphFlow G f) :
    ∃ g, IsGraphFlow G g ∧ netOut g = netOut f ∧ flowCost pts g ≤ flowCost pts f ∧
      ForestSupported g := by sorry

/-- Leaf induction: a forest-supported flow with integral divergences is integral. [ADeterministicNearLinear, node_22] -/
theorem forest_flow_integral {ι : Type*} [Fintype ι] (g : ι → ι → ℝ)
    (hg0 : ∀ u v, 0 ≤ g u v) (hg : ForestSupported g) (hint : IsIntegralVec (netOut g)) :
    IsIntegralMap g := by sorry

/-- Map recovery: a nonnegative forest-supported flow with divergence `μ` yields a
transportation map of no larger cost, integral when the flow is integral. [ADeterministicNearLinear, node_22] -/
theorem forest_flow_to_transport {ι : Type*} [Fintype ι] {d : ℕ} (pts : ι → Fin d → ℝ)
    (μ : ι → ℝ) (g : ι → ι → ℝ) (hg0 : ∀ u v, 0 ≤ g u v) (hg : ForestSupported g)
    (hdiv : netOut g = μ) :
    ∃ τ, IsTransportMap μ τ ∧ transportCost pts τ ≤ flowCost pts g ∧
      (IsIntegralMap g → IsIntegralMap τ) := by sorry

/-! ## Main theorem -/

/-- End-to-end guarantee. Build the graph with `η = ε/4`; let `f` be any exactly feasible
graph flow for `μ` of cost at most `(1+ε/4) OPT_G(μ)` (the output of the supplied optimizer
with `δ = ε/4`). Then cycle cancellation and map recovery give a transportation map `τ` with
`cost(τ) ≤ (1+ε) cost*(P,μ)`, which is integral whenever every `μ(p)` is an integer. [ADeterministicNearLinear, node_22] -/
theorem approx_flow_gives_approx_transport {ι : Type*} [Fintype ι] {d : ℕ}
    (pts : ι → Fin d → ℝ) (o : Fin d → ℝ) (h0 a : ℝ) (L : ℕ) (rep : ℕ → (Fin d → ℤ) → ι)
    (hS : Setup pts o h0 a L) (hrep : RepSpec pts o h0 rep)
    (ε : ℝ) (hε : 0 < ε) (hε1 : ε ≤ 1)
    (μ : ι → ℝ) (hμ : ∑ p, μ p = 0)
    (f : ι → ι → ℝ) (hf : IsGraphFlow (geomGraph pts o h0 (ε / 4) L rep) f)
    (hdiv : netOut f = μ)
    (hcost : flowCost pts f ≤
      (1 + ε / 4) * optGraph pts (geomGraph pts o h0 (ε / 4) L rep) μ) :
    ∃ τ, IsTransportMap μ τ ∧ transportCost pts τ ≤ (1 + ε) * costStar pts μ ∧
      (IsIntegralVec μ → IsIntegralMap τ) := by sorry

end TCSChallenge.ADeterministicNearLinear.node_22
