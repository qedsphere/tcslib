namespace TCSChallenge.PolynomialIdentityTestingAnd.node_24

/-! ### Shared definitions: algebraic circuits, IPS, and the gate-consistency system -/

/-- A gate of a division-free algebraic circuit over `F` with input variables `ι`:
an input variable, a field constant, or a fan-in-two `+`/`×` gate whose arguments
are referenced by the indices of earlier gates. -/
inductive Gate (F : Type) (ι : Type) where
  | var : ι → Gate F ι
  | const : F → Gate F ι
  | add : ℕ → ℕ → Gate F ι
  | mul : ℕ → ℕ → Gate F ι

/-- "Algebraic circuits over `F` are division-free circuits with `+`- and `×`-gates and
constants from `F`." A circuit is a straight-line program (a DAG listed in topological
order); the output is the last gate. Sharing of subcircuits is therefore built in. -/
structure Circuit (F : Type) (ι : Type) where
  gates : List (Gate F ι)

variable {F : Type} [Field F]

/-- Polynomial computed by a gate, given the polynomials of the previous gates
(dangling references read as `0`; well-formed circuits never use this). -/
def Gate.toPoly {ι : Type} (acc : List (MvPolynomial ι F)) : Gate F ι → MvPolynomial ι F
  | .var x => MvPolynomial.X x
  | .const c => MvPolynomial.C c
  | .add i j => acc.getD i 0 + acc.getD j 0
  | .mul i j => acc.getD i 0 * acc.getD j 0

/-- The polynomials `f_v` computed at all gates `v`. -/
def Circuit.gatePolys {ι : Type} (C : Circuit F ι) : List (MvPolynomial ι F) :=
  C.gates.foldl (fun acc g => acc ++ [g.toPoly acc]) []

/-- The formal polynomial computed by the circuit (at its last gate; `0` if empty). -/
def Circuit.poly {ι : Type} (C : Circuit F ι) : MvPolynomial ι F :=
  C.gatePolys.getLastD 0

/-- Circuit size, measured as the number of gates. -/
def Circuit.size {ι : Type} (C : Circuit F ι) : ℕ := C.gates.length

/-- Gate `k` only references strictly earlier gates. -/
def Gate.RefsBelow {ι : Type} (k : ℕ) : Gate F ι → Prop
  | .var _ => True
  | .const _ => True
  | .add i j => i < k ∧ j < k
  | .mul i j => i < k ∧ j < k

/-- A well-formed circuit: nonempty, and every gate references only earlier gates. -/
def Circuit.WellFormed {ι : Type} (C : Circuit F ι) : Prop :=
  C.gates ≠ [] ∧ ∀ (k : ℕ) (h : k < C.gates.length), (C.gates.get ⟨k, h⟩).RefsBelow k

/-- "An IPS certificate deriving `G(X)` is an algebraic circuit `D(X,Y)` such that
`D(X,0)=0` and `D(X,F_1(X),…,F_m(X))=G(X)` as formal polynomial identities."
The placeholder variables `Y_j` are indexed by `J`. -/
def IsIPSCert {ι J : Type} (Fs : J → MvPolynomial ι F) (D : Circuit F (ι ⊕ J))
    (G : MvPolynomial ι F) : Prop :=
  MvPolynomial.bind₁ (Sum.elim MvPolynomial.X (fun _ => (0 : MvPolynomial ι F))) D.poly = 0 ∧
  MvPolynomial.bind₁ (Sum.elim MvPolynomial.X Fs) D.poly = G

/-- An IPS refutation is a certificate deriving `1`. -/
def IsIPSRefutation {ι J : Type} (Fs : J → MvPolynomial ι F) (D : Circuit F (ι ⊕ J)) : Prop :=
  IsIPSCert Fs D 1

/-- Variables of the gate-consistency system `F_C`: the inputs `x_i`, one variable `g_v`
per gate `v`, and the extra variable `z`. -/
abbrev SysVar (n L : ℕ) : Type := Fin n ⊕ Fin L ⊕ Unit

/-- Gate reading the variable `g_i` (or `0` if `i` is out of range). -/
def gRef (n L : ℕ) (i : ℕ) : Gate F (SysVar n L) :=
  if h : i < L then .var (Sum.inr (Sum.inl ⟨i, h⟩)) else .const 0

/-- The gate equation `q_v` for gate `v` of `C`, as a small circuit:
`g_v - x_i`, `g_v - c`, `g_v - g_u - g_w`, or `g_v - g_u g_w`. -/
def gateEq (n L : ℕ) (v : Fin L) : Gate F (Fin n) → Circuit F (SysVar n L)
  | .var x => ⟨[.var (Sum.inr (Sum.inl v)), .var (Sum.inl x), .const (-1), .mul 1 2, .add 0 3]⟩
  | .const c => ⟨[.var (Sum.inr (Sum.inl v)), .const (-c), .add 0 1]⟩
  | .add i j => ⟨[.var (Sum.inr (Sum.inl v)), gRef n L i, gRef n L j, .const (-1),
      .add 1 2, .mul 3 4, .add 0 5]⟩
  | .mul i j => ⟨[.var (Sum.inr (Sum.inl v)), gRef n L i, gRef n L j, .const (-1),
      .mul 1 2, .mul 3 4, .add 0 5]⟩

/-- The output equation `q_* = 1 - z g_o`, where `o` is the last gate. -/
def outEq (n L : ℕ) : Circuit F (SysVar n L) :=
  ⟨[.const 1, .var (Sum.inr (Sum.inr ())), gRef n L (L - 1), .const (-1),
    .mul 1 2, .mul 3 4, .add 0 5]⟩

/-- The system `F_C` (encoded by circuits): one gate equation per gate of `C`, followed by
the output equation `1 - z g_o`. -/
def sysCircuit {n : ℕ} (C : Circuit F (Fin n)) (i : Fin (C.gates.length + 1)) :
    Circuit F (SysVar n C.gates.length) :=
  if h : i.val < C.gates.length then gateEq n C.gates.length ⟨i.val, h⟩ (C.gates.get ⟨i.val, h⟩)
  else outEq n C.gates.length

/-- The polynomials of `F_C`. -/
def sysPolys {n : ℕ} (C : Circuit F (Fin n)) (i : Fin (C.gates.length + 1)) :
    MvPolynomial (SysVar n C.gates.length) F :=
  (sysCircuit C i).poly

/-- Circuit substitution with sharing: from `A(X,Y)` and circuits for `F_j(X)` one builds
circuits for `A(X,0)` and `A(X,F(X)) - 1` of linear size. (Used to build the PIT
instances `D_0, D_1` checked by the proof system.) [PolynomialIdentityTestingAnd, node_24] -/
theorem subst_circuits {ι J : Type} [Fintype J] (A : Circuit F (ι ⊕ J))
    (Fs : J → Circuit F ι) :
    ∃ D₀ D₁ : Circuit F ι,
      D₀.poly = MvPolynomial.bind₁ (Sum.elim MvPolynomial.X (fun _ => (0 : MvPolynomial ι F)))
        A.poly ∧
      D₁.poly = MvPolynomial.bind₁ (Sum.elim MvPolynomial.X (fun j => (Fs j).poly)) A.poly - 1 ∧
      D₀.size ≤ A.size + 2 ∧
      D₁.size ≤ A.size + ∑ j, ((Fs j).size + 1) + 5 := by
  sorry

/-- Gate-by-gate invariant: for a well-formed circuit `C`, there is a circuit `B_o` of
linear size with `B_o(X,g,0) = 0` and `B_o(X,g,q) = g_o - f_o(X)`
(here `g_o` is the variable of the last gate and `f_o = C.poly`). [PolynomialIdentityTestingAnd, node_24] -/
theorem gate_invariant :
    ∃ K : ℕ, ∀ (n : ℕ) (C : Circuit F (Fin n)), C.WellFormed →
      ∃ B : Circuit F (SysVar n C.gates.length ⊕ Fin (C.gates.length + 1)),
        IsIPSCert (sysPolys C) B
          ((⟨[gRef n C.gates.length (C.gates.length - 1)]⟩ :
              Circuit F (SysVar n C.gates.length)).poly -
            MvPolynomial.rename Sum.inl C.poly) ∧
        B.size ≤ K * C.size := by
  sorry

/-- The encoding of `F_C` has linear size. [PolynomialIdentityTestingAnd, node_24] -/
theorem sysCircuit_size {n : ℕ} (C : Circuit F (Fin n)) :
    ∑ i, (sysCircuit C i).size ≤ 7 * (C.size + 1) := by
  sorry

/-- Short IPS refutation: if `C` computes the zero polynomial, then `F_C` has an IPS
refutation whose size, including the encoding of `F_C`, is `O(|C|)`. [PolynomialIdentityTestingAnd, node_24] -/
theorem short_refutation_of_zero :
    ∃ K : ℕ, ∀ (n : ℕ) (C : Circuit F (Fin n)), C.WellFormed → C.poly = 0 →
      ∃ A : Circuit F (SysVar n C.gates.length ⊕ Fin (C.gates.length + 1)),
        IsIPSRefutation (sysPolys C) A ∧
        A.size + ∑ i, (sysCircuit C i).size ≤ K * C.size := by
  sorry

/-! ### CNFs and their algebraic encoding -/

/-- A literal `(v, s)`: the variable `v` with polarity `s` (`true` = positive). -/
abbrev Lit (V : Type) : Type := V × Bool

/-- A clause is a disjunction of literals; a CNF is a list of clauses. -/
abbrev Clause (V : Type) : Type := List (Lit V)
abbrev CNF (V : Type) : Type := List (Clause V)

/-- `φ` is satisfiable by a Boolean assignment. -/
def CNFSat {V : Type} (φ : CNF V) : Prop :=
  ∃ a : V → Bool, ∀ κ ∈ φ, ∃ ℓ ∈ κ, a ℓ.1 = ℓ.2

/-- `alg` of a literal: `x` or `1 - x`. -/
def litPoly {V : Type} (ℓ : Lit V) : MvPolynomial V F :=
  if ℓ.2 then MvPolynomial.X ℓ.1 else 1 - MvPolynomial.X ℓ.1

/-- The clause equation `1 - alg(κ) = ∏_{ℓ ∈ κ} (1 - alg ℓ)`. -/
def clausePoly {V : Type} (κ : Clause V) : MvPolynomial V F :=
  (κ.map (fun ℓ => 1 - litPoly ℓ)).prod

/-- The variables occurring in `φ`. -/
def cnfVars {V : Type} [DecidableEq V] (φ : CNF V) : Finset V :=
  (φ.flatMap (fun κ => κ.map Prod.fst)).toFinset

/-- Index type of the algebraic axioms of `φ`: clauses and Boolean axioms. -/
abbrev AxIdx {V : Type} [DecidableEq V] (φ : CNF V) : Type := Fin φ.length ⊕ ↥(cnfVars φ)

variable (F) in
/-- "A Boolean CNF `φ` is represented algebraically by the equations `1-alg(κ)` for its
clauses `κ`, together with the Boolean axioms `x_i^2-x_i`." -/
def cnfAxioms {V : Type} [DecidableEq V] (φ : CNF V) : AxIdx φ → MvPolynomial V F :=
  Sum.elim (fun i => clausePoly (φ.get i))
    (fun v => MvPolynomial.X v.1 ^ 2 - MvPolynomial.X v.1)

variable (F) in
/-- The permitted completeness of IPS (Hilbert Nullstellensatz), in the form used: a
system with no common zero in the algebraic closure has an IPS refutation. -/
def IPSComplete : Prop :=
  ∀ (ι J : Type) [Fintype ι] [Fintype J] (Fs : J → MvPolynomial ι F),
    (¬ ∃ a : ι → AlgebraicClosure F, ∀ j, MvPolynomial.aeval a (Fs j) = 0) →
    ∃ D : Circuit F (ι ⊕ J), IsIPSRefutation Fs D

/-! ### Part (b): PIT_F ∈ NP ⇒ a Cook–Reckhow system for UNSAT p-simulating IPS_F (core) -/

/-- Soundness: a CNF with an IPS refutation of its algebraic encoding is unsatisfiable. [PolynomialIdentityTestingAnd, node_24] -/
theorem cnf_ips_sound {V : Type} [DecidableEq V] (φ : CNF V)
    (D : Circuit F (V ⊕ AxIdx φ)) (hD : IsIPSRefutation (cnfAxioms F φ) D) : ¬ CNFSat φ := by
  sorry

/-- Completeness: an unsatisfiable CNF has an IPS refutation (its encoding, including the
Boolean axioms, has no common zero over the algebraic closure). [PolynomialIdentityTestingAnd, node_24] -/
theorem cnf_ips_complete (hN : IPSComplete F) {N : ℕ} (φ : CNF (Fin N)) (hφ : ¬ CNFSat φ) :
    ∃ D : Circuit F (Fin N ⊕ AxIdx φ), IsIPSRefutation (cnfAxioms F φ) D := by
  sorry

/-- **Part (b), core.** The image of the PIT-witness proof system is exactly UNSAT: an
IPS_F refutation exists iff the CNF is unsatisfiable. (The checked PIT instances are the
circuits of `subst_circuits`, of size linear in `|D| + |φ|`.) [PolynomialIdentityTestingAnd, node_24] -/
theorem part_b_core (hN : IPSComplete F) (N : ℕ) (φ : CNF (Fin N)) :
    (∃ D : Circuit F (Fin N ⊕ AxIdx φ), IsIPSRefutation (cnfAxioms F φ) D) ↔ ¬ CNFSat φ := by
  sorry

/-! ### Boolean circuits, Tseitin CNFs, and modular-arithmetic gadgets -/

/-- A Boolean circuit gate over inputs `I`; arguments refer to earlier wires. -/
inductive BGate (I : Type) where
  | input : I → BGate I
  | tt : BGate I
  | ff : BGate I
  | neg : ℕ → BGate I
  | conj : ℕ → ℕ → BGate I
  | disj : ℕ → ℕ → BGate I

/-- Tseitin clauses for wire `k` (Tseitin variable `Sum.inl k`) computing gate `g`. -/
def BGate.clauses {I : Type} (k : ℕ) : BGate I → CNF (ℕ ⊕ I)
  | .input x => [[(Sum.inl k, false), (Sum.inr x, true)], [(Sum.inl k, true), (Sum.inr x, false)]]
  | .tt => [[(Sum.inl k, true)]]
  | .ff => [[(Sum.inl k, false)]]
  | .neg i => [[(Sum.inl k, true), (Sum.inl i, true)], [(Sum.inl k, false), (Sum.inl i, false)]]
  | .conj i j => [[(Sum.inl k, false), (Sum.inl i, true)], [(Sum.inl k, false), (Sum.inl j, true)],
      [(Sum.inl i, false), (Sum.inl j, false), (Sum.inl k, true)]]
  | .disj i j => [[(Sum.inl i, false), (Sum.inl k, true)], [(Sum.inl j, false), (Sum.inl k, true)],
      [(Sum.inl k, false), (Sum.inl i, true), (Sum.inl j, true)]]

/-- Standard Tseitin CNF of a list of gates, wires numbered from `k`. -/
def tseitinFrom {I : Type} : ℕ → List (BGate I) → CNF (ℕ ⊕ I)
  | _, [] => []
  | k, g :: gs => g.clauses k ++ tseitinFrom (k + 1) gs

/-- A modular-arithmetic gadget (`ADD_p` or `MUL_p`): a Boolean circuit on two `b`-bit
blocks `U = inl`, `V = inr`, with `b` designated output wires. -/
structure ModGadget (b : ℕ) where
  gates : List (BGate (Fin b ⊕ Fin b))
  out : Fin b → ℕ

/-- `val_p(U) = ∑_j 2^j U_j` in `𝔽_p`, for a block of variables `w`. -/
def valPoly (p : ℕ) [Fact p.Prime] {V : Type} {b : ℕ} (w : Fin b → V) : MvPolynomial V (ZMod p) :=
  ∑ j : Fin b, MvPolynomial.C ((2 : ZMod p) ^ (j : ℕ)) * MvPolynomial.X (w j)

/-- Background facts 2 and 3 for one gadget: from the Tseitin clauses of the gadget and the
Boolean axioms, IPS over `𝔽_p` derives `val_p(out) - op(val_p U, val_p V)` with a
certificate of size at most `S`. -/
def GadgetDerivable (p : ℕ) [Fact p.Prime] {b : ℕ} (g : ModGadget b)
    (op : MvPolynomial (ℕ ⊕ (Fin b ⊕ Fin b)) (ZMod p) →
      MvPolynomial (ℕ ⊕ (Fin b ⊕ Fin b)) (ZMod p) → MvPolynomial (ℕ ⊕ (Fin b ⊕ Fin b)) (ZMod p))
    (S : ℕ) : Prop :=
  ∃ D : Circuit (ZMod p) ((ℕ ⊕ (Fin b ⊕ Fin b)) ⊕ AxIdx (tseitinFrom 0 g.gates)),
    IsIPSCert (cnfAxioms (ZMod p) (tseitinFrom 0 g.gates)) D
      (valPoly p (fun j => Sum.inl (g.out j)) -
        op (valPoly p (fun j => Sum.inr (Sum.inl j))) (valPoly p (fun j => Sum.inr (Sum.inr j)))) ∧
    D.size ≤ S

/-- Inline one gadget gate at offset `o`, wiring its input blocks to existing wires
`bu`, `bw` (an input bit becomes the copy gate `w ∧ w`). -/
def inlineGate {ι : Type} {b : ℕ} (o : ℕ) (bu bw : ℕ → ℕ) :
    BGate (Fin b ⊕ Fin b) → BGate (ι × Fin b)
  | .input (Sum.inl j) => .conj (bu j.val) (bu j.val)
  | .input (Sum.inr j) => .conj (bw j.val) (bw j.val)
  | .tt => .tt
  | .ff => .ff
  | .neg i => .neg (i + o)
  | .conj i k => .conj (i + o) (k + o)
  | .disj i k => .disj (i + o) (k + o)

/-- Append a copy of gadget `g` applied to blocks `bu`, `bw`; return the new gate list and
the output block. -/
def inlineGadget {ι : Type} {b : ℕ} (g : ModGadget b) (gs : List (BGate (ι × Fin b)))
    (bu bw : ℕ → ℕ) : List (BGate (ι × Fin b)) × (ℕ → ℕ) :=
  (gs ++ g.gates.map (inlineGate gs.length bu bw),
    fun j => if h : j < b then g.out ⟨j, h⟩ + gs.length else 0)

/-- One step of `Bit_p`: a variable becomes its bit block, a constant its canonical binary
representation, `+` an inlined `ADD_p`, `×` an inlined `MUL_p`. The state is the Boolean
gate list and the output block of every algebraic gate processed so far. -/
def bitStep (p : ℕ) [Fact p.Prime] {ι : Type} {b : ℕ} (addG mulG : ModGadget b)
    (st : List (BGate (ι × Fin b)) × List (ℕ → ℕ)) :
    Gate (ZMod p) ι → List (BGate (ι × Fin b)) × List (ℕ → ℕ)
  | .var x => (st.1 ++ List.ofFn (fun j : Fin b => BGate.input (x, j)),
      st.2 ++ [fun j => st.1.length + j])
  | .const c => (st.1 ++ List.ofFn (fun j : Fin b =>
        if c.val.testBit j.val then (BGate.tt : BGate (ι × Fin b)) else BGate.ff),
      st.2 ++ [fun j => st.1.length + j])
  | .add i k =>
      let r := inlineGadget addG st.1 (st.2.getD i (fun _ => 0)) (st.2.getD k (fun _ => 0))
      (r.1, st.2 ++ [r.2])
  | .mul i k =>
      let r := inlineGadget mulG st.1 (st.2.getD i (fun _ => 0)) (st.2.getD k (fun _ => 0))
      (r.1, st.2 ++ [r.2])

/-- `Bit_p(G)` appended to the gate list `gs0`; returns the gates and the output block. -/
def bitCircuit (p : ℕ) [Fact p.Prime] {ι : Type} {b : ℕ} (addG mulG : ModGadget b)
    (gs0 : List (BGate (ι × Fin b))) (G : Circuit (ZMod p) ι) :
    List (BGate (ι × Fin b)) × (ℕ → ℕ) :=
  let st := G.gates.foldl (bitStep p addG mulG) (gs0, [])
  (st.1, st.2.getLastD (fun _ => 0))

/-- `Bit_p` applied to every equation, in one shared Boolean circuit. -/
def eqsBits (p : ℕ) [Fact p.Prime] {ι : Type} {b : ℕ} (addG mulG : ModGadget b)
    (Gs : List (Circuit (ZMod p) ι)) : List (BGate (ι × Fin b)) × List (ℕ → ℕ) :=
  Gs.foldl (fun st G => let r := bitCircuit p addG mulG st.1 G; (r.1, st.2 ++ [r.2])) ([], [])

/-- The Tseitin CNF of `Ψ = ⋀_{i,j} ¬Γ_{i,j}`: Tseitin clauses of the shared circuit plus a
unit clause `¬Γ_{i,j}` for every output bit of every equation. -/
def booleanizedCNF (p : ℕ) [Fact p.Prime] {ι : Type} {b : ℕ} (addG mulG : ModGadget b)
    (Gs : List (Circuit (ZMod p) ι)) : CNF (ℕ ⊕ (ι × Fin b)) :=
  tseitinFrom 0 (eqsBits p addG mulG Gs).1 ++
    (eqsBits p addG mulG Gs).2.flatMap
      (fun blk => List.ofFn (fun j : Fin b => [((Sum.inl (blk j.val) : ℕ ⊕ (ι × Fin b)), false)]))

/-- `φ_C`: the Booleanization of the gate-consistency system `E_C` over `𝔽_p`. -/
def phiC (p : ℕ) [Fact p.Prime] {b : ℕ} (addG mulG : ModGadget b) {n : ℕ}
    (C : Circuit (ZMod p) (Fin n)) : CNF (ℕ ⊕ (SysVar n C.gates.length × Fin b)) :=
  booleanizedCNF p addG mulG (List.ofFn (sysCircuit C))

/-! ### Part (a): Booleanization preserving short IPS refutations (core, prime field) -/

/-- Bit-level invariant (7): for every algebraic circuit `G` over `𝔽_p`, IPS derives
`G(v(U)) - val_p(Bit_p(G))` from the Tseitin clauses and Boolean axioms with a certificate
of size polynomial in `|G|`, `b`, `S` and the gadget sizes. Stated for `Bit_p(G)` built
from an empty gate list. [PolynomialIdentityTestingAnd, node_24] -/
theorem bit_invariant :
    ∃ c k : ℕ, ∀ (p : ℕ) [Fact p.Prime] (b : ℕ), b = Nat.clog 2 p →
      ∀ (addG mulG : ModGadget b) (S : ℕ),
      GadgetDerivable p addG (· + ·) S → GadgetDerivable p mulG (· * ·) S →
      ∀ (ι : Type) [DecidableEq ι] (G : Circuit (ZMod p) ι), G.WellFormed →
        ∃ D : Circuit (ZMod p) ((ℕ ⊕ (ι × Fin b)) ⊕
            AxIdx (tseitinFrom 0 (bitCircuit p addG mulG [] G).1)),
          IsIPSCert (cnfAxioms (ZMod p) (tseitinFrom 0 (bitCircuit p addG mulG [] G).1)) D
            (MvPolynomial.bind₁
                (fun x : ι => valPoly p (fun j : Fin b => (Sum.inr (x, j) : ℕ ⊕ (ι × Fin b))))
                G.poly -
              valPoly p (fun j : Fin b =>
                (Sum.inl ((bitCircuit p addG mulG [] G).2 j.val) : ℕ ⊕ (ι × Fin b)))) ∧
          D.size ≤ c * (G.size + S + addG.gates.length + mulG.gates.length + b + 1) ^ k := by
  sorry

/-- **Part (a), core.** For a prime `p`, `b = ⌈log₂ p⌉`, and modular gadgets satisfying
background facts 2–3, the CNF `φ_C` is unsatisfiable iff `C` vanishes on `𝔽_p^n`, and if
`C` is the zero formal polynomial then `φ_C` has an IPS refutation over `𝔽_p` of size
polynomial in `|C|`, `b`, `S` and the gadget sizes. [PolynomialIdentityTestingAnd, node_24] -/
theorem part_a_core :
    ∃ c k : ℕ, ∀ (p : ℕ) [Fact p.Prime] (b : ℕ), b = Nat.clog 2 p →
      ∀ (addG mulG : ModGadget b) (S : ℕ),
      GadgetDerivable p addG (· + ·) S → GadgetDerivable p mulG (· * ·) S →
      ∀ (n : ℕ) (C : Circuit (ZMod p) (Fin n)), C.WellFormed →
        ((¬ CNFSat (phiC p addG mulG C)) ↔ ∀ a : Fin n → ZMod p, MvPolynomial.eval a C.poly = 0) ∧
        (C.poly = 0 →
          ∃ D : Circuit (ZMod p) ((ℕ ⊕ (SysVar n C.gates.length × Fin b)) ⊕
              AxIdx (phiC p addG mulG C)),
            IsIPSRefutation (cnfAxioms (ZMod p) (phiC p addG mulG C)) D ∧
            D.size ≤ c * (C.size + S + addG.gates.length + mulG.gates.length + b + 1) ^ k) := by
  sorry

end TCSChallenge.PolynomialIdentityTestingAnd.node_24
