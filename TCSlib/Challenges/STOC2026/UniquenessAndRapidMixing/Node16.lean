open scoped Classical

open TCSlib.InformationTheory (FinDist)

/-!
## Entropy contraction of field dynamics under spectral independence + marginal stability

Spins `±1` are encoded as `Bool` (`true = +1`, `false = -1`); a configuration is
`Fin n → Bool`. The reference law `ν` and the initial law `π` are bundled TCSlib
`FinDist (Config n)`s; derived laws (tilts, conditionals, kernel outputs) are plain
functions `Config n → ℝ`.

For `λ > 0` the tilt `λ * μ` reweights `σ` by `λ^{|σ|₊}`. A pinning is a pair `(Λ, τ)`
with `Λ : Finset (Fin n)` and `τ : Fin n → Bool` (only `τ` on `Λ` matters, so `τ_S` for
`S ⊆ Λ` is the pair `(S, τ)`). The field dynamics kernel `P` (parameters `θ`, `ν`):
from `σ`, put each minus coordinate into `S`, and each plus coordinate into `S` with
probability `θ`, independently; resample `S` from `θ * ν` conditioned on `σ` off `S`.

Main theorem `field_dynamics_entropy_contraction`: if `λ * ν` is `K`-marginally stable and
`η`-spectrally independent for all `λ ∈ [θ, 1]`, then for all `π ≪ ν`,
`D(πP ‖ νP) ≤ (1 - θ^{2000 η K⁴}) D(π ‖ ν)`.
-/

namespace TCSChallenge.UniquenessAndRapidMixing.node_16

/-- Spin configurations on `[n]`; `true` is `+1`, `false` is `-1`. -/
abbrev Config (n : ℕ) := Fin n → Bool

/-- Absolute continuity `π ≪ μ`: `μ a = 0 → π a = 0`. -/
def AbsCont {α : Type} [Fintype α] (π μ : α → ℝ) : Prop :=
  ∀ a, μ a = 0 → π a = 0

/-- `D_KL(π ‖ μ) = ∑ π(a) log (π(a)/μ(a))`, with the convention `0 log(0/·) = 0`. -/
def klDiv {α : Type} [Fintype α] (π μ : α → ℝ) : ℝ :=
  ∑ a, if π a = 0 then 0 else π a * Real.log (π a / μ a)

/-- `|σ|₊`, the number of plus spins. -/
def plusCount {n : ℕ} (σ : Config n) : ℕ :=
  (Finset.univ.filter (fun i => σ i = true)).card

/-- The tilted law `(λ * μ)(σ) = μ(σ) λ^{|σ|₊} / ∑_ω μ(ω) λ^{|ω|₊}`. -/
def tilt {n : ℕ} (lam : ℝ) (μ : Config n → ℝ) (σ : Config n) : ℝ :=
  μ σ * lam ^ plusCount σ / ∑ ω, μ ω * lam ^ plusCount ω

/-- The globally spin-flipped law `μ̄(σ) = μ(-σ)`. -/
def flipDist {n : ℕ} (μ : Config n → ℝ) (σ : Config n) : ℝ :=
  μ (fun i => !σ i)

/-- `σ` agrees with the pinning `τ` on `Λ`, i.e. `σ_Λ = τ_Λ`. -/
def Agrees {n : ℕ} (Λ : Finset (Fin n)) (τ σ : Config n) : Prop :=
  ∀ i ∈ Λ, σ i = τ i

/-- `μ(σ_Λ = τ)`. -/
def pinMass {n : ℕ} (μ : Config n → ℝ) (Λ : Finset (Fin n)) (τ : Config n) : ℝ :=
  ∑ σ ∈ Finset.univ.filter (fun σ => Agrees Λ τ σ), μ σ

/-- "A pinning `τ ∈ {±1}^Λ` is feasible for `μ` if `μ(σ_Λ = τ) > 0`." -/
def Feasible {n : ℕ} (μ : Config n → ℝ) (Λ : Finset (Fin n)) (τ : Config n) : Prop :=
  0 < pinMass μ Λ τ

/-- The conditional law `μ^τ` (pinned coordinates are retained as fixed coordinates). -/
def condLaw {n : ℕ} (μ : Config n → ℝ) (Λ : Finset (Fin n)) (τ : Config n)
    (σ : Config n) : ℝ :=
  if Agrees Λ τ σ then μ σ / pinMass μ Λ τ else 0

/-- Plus marginal `μ_i(+1)`. -/
def margPlus {n : ℕ} (μ : Config n → ℝ) (i : Fin n) : ℝ :=
  ∑ σ ∈ Finset.univ.filter (fun σ : Config n => σ i = true), μ σ

/-- Minus marginal `μ_i(-1)`. -/
def margMinus {n : ℕ} (μ : Config n → ℝ) (i : Fin n) : ℝ :=
  ∑ σ ∈ Finset.univ.filter (fun σ : Config n => σ i = false), μ σ

/-- The influence matrix
`Ψ_μ(i,j) = Pr_μ[σ_j = + | σ_i = +] - Pr_μ[σ_j = + | σ_i = -]` when both conditioning
events have positive probability, and row `i` is zero otherwise. -/
def influence {n : ℕ} (μ : Config n → ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  Matrix.of fun i j =>
    if 0 < margPlus μ i ∧ 0 < margMinus μ i then
      margPlus (condLaw μ {i} (fun _ => true)) j - margPlus (condLaw μ {i} (fun _ => false)) j
    else 0

/-- `η`-spectral independence: after every feasible pinning, the largest eigenvalue of the
influence matrix is at most `η`. Pinned coordinates of `μ^τ` have zero rows and columns in
`Ψ_{μ^τ}`, so (as `η ≥ 0`) this is the same as the condition on the remaining coordinates;
eigenvalues of `Ψ` are real, so it suffices to bound real eigenvalues. -/
def SpectrallyIndependent {n : ℕ} (η : ℝ) (μ : Config n → ℝ) : Prop :=
  ∀ (Λ : Finset (Fin n)) (τ : Config n), Feasible μ Λ τ →
    ∀ (c : ℝ) (v : Fin n → ℝ), v ≠ 0 →
      Matrix.mulVec (influence (condLaw μ Λ τ)) v = c • v → c ≤ η

/-- `R_i^τ = ρ_i^τ(+1) / ρ_i^τ(-1)`. -/
def marginalRatio {n : ℕ} (ρ : Config n → ℝ) (Λ : Finset (Fin n)) (τ : Config n)
    (i : Fin n) : ℝ :=
  margPlus (condLaw ρ Λ τ) i / margMinus (condLaw ρ Λ τ) i

/-- `K`-marginal stability: for some `ρ ∈ {μ, μ̄}`, for every `i`, every
`S ⊆ Λ ⊆ [n] \ {i}` and every `τ` on `Λ` feasible for `ρ`,
`R_i^τ ≤ K R_i^{τ_S}` and `ρ_i^τ(-1) ≥ K⁻¹`. -/
def MarginallyStable {n : ℕ} (K : ℝ) (μ : Config n → ℝ) : Prop :=
  ∃ ρ : Config n → ℝ, (ρ = μ ∨ ρ = flipDist μ) ∧
    ∀ (i : Fin n) (Λ S : Finset (Fin n)) (τ : Config n),
      i ∉ Λ → S ⊆ Λ → Feasible ρ Λ τ →
        marginalRatio ρ Λ τ i ≤ K * marginalRatio ρ S τ i ∧
        K⁻¹ ≤ margMinus (condLaw ρ Λ τ) i

/-- Probability that the field dynamics picks the resampling set `S` from `σ`:
minus coordinates are always in `S`, plus coordinates independently with probability `θ`. -/
def selProb {n : ℕ} (θ : ℝ) (σ : Config n) (S : Finset (Fin n)) : ℝ :=
  ∏ i, if σ i = true then (if i ∈ S then θ else 1 - θ) else (if i ∈ S then 1 else 0)

/-- The field dynamics kernel `P(σ, σ')`: choose `S`, keep `σ` off `S`, resample `S` from
the conditional law of `θ * ν` given the coordinates outside `S`. -/
def fieldKernel {n : ℕ} (θ : ℝ) (ν : Config n → ℝ) (σ σ' : Config n) : ℝ :=
  ∑ S : Finset (Fin n), selProb θ σ S * condLaw (tilt θ ν) Sᶜ σ σ'

/-- `πP`, the law after one step of a kernel. -/
def applyKernel {α β : Type} [Fintype α] (π : α → ℝ) (P : α → β → ℝ) (b : β) : ℝ :=
  ∑ a, π a * P a b

/-- The retained-set observation channel: each plus coordinate is retained independently
with probability `1 - θ`; minus coordinates are never retained. (`R = Sᶜ`.) -/
def obsChannel {n : ℕ} (θ : ℝ) (σ : Config n) (R : Finset (Fin n)) : ℝ :=
  ∏ i, if σ i = true then (if i ∈ R then 1 - θ else θ) else (if i ∈ R then 0 else 1)

/-- The all-plus configuration (the pinning induced by a retained set). -/
def allPlus (n : ℕ) : Config n := fun _ => true

/-- Posterior given retained set `R`: `(θ * ν)^{1_R}`. -/
def posterior {n : ℕ} (θ : ℝ) (ν : Config n → ℝ) (R : Finset (Fin n)) : Config n → ℝ :=
  condLaw (tilt θ ν) R (allPlus n)

/-- `Ent_μ[f] = E_μ[f log f] - E_μ[f] log E_μ[f]`. -/
def entropyF {n : ℕ} (μ : Config n → ℝ) (f : Config n → ℝ) : ℝ :=
  (∑ σ, μ σ * (f σ * Real.log (f σ))) -
    (∑ σ, μ σ * f σ) * Real.log (∑ σ, μ σ * f σ)

/-- The one-sided marginal information sum
`∑_i [π_i(+) log(π_i(+)/μ_i(+)) - π_i(+) + μ_i(+)]`. -/
def plusInfoSum {n : ℕ} (π μ : Config n → ℝ) : ℝ :=
  ∑ i, (margPlus π i * Real.log (margPlus π i / margPlus μ i) - margPlus π i + margPlus μ i)

/-- The exponent `2·10³ η K⁴`. -/
def rateConst (η K : ℝ) : ℝ := 2000 * η * K ^ 4

/-! ## Lemma stubs (proof-plan intermediate claims) -/

/-- Bayes' rule: conditional on the retained set `R`, the configuration has law
`(θ * ν)^{1_R}`. [UniquenessAndRapidMixing, node_16] -/
theorem bayes_posterior {n : ℕ} (θ : ℝ) (ν : FinDist (Config n))
    (hθ0 : 0 < θ) (hθ1 : θ < 1) (R : Finset (Fin n)) (σ : Config n) :
    ν σ * obsChannel θ σ R =
      applyKernel ⇑ν (obsChannel θ) R * posterior θ ⇑ν R σ := by
  sorry

/-- The field update is the observation channel followed by posterior resampling. [UniquenessAndRapidMixing, node_16] -/
theorem fieldKernel_eq_obs_then_resample {n : ℕ} (θ : ℝ) (ν : Config n → ℝ)
    (σ σ' : Config n) :
    fieldKernel θ ν σ σ' = ∑ R : Finset (Fin n), obsChannel θ σ R * posterior θ ν R σ' := by
  sorry

/-- Data processing for posterior resampling: `D(πP‖νP) ≤ D(πQ‖νQ)` for the observation
channel `Q`. [UniquenessAndRapidMixing, node_16] -/
theorem data_processing_resample {n : ℕ} (θ : ℝ) (ν π : FinDist (Config n))
    (hac : AbsCont ⇑π ⇑ν) (hθ0 : 0 < θ) (hθ1 : θ < 1) :
    klDiv (applyKernel ⇑π (fieldKernel θ ⇑ν)) (applyKernel ⇑ν (fieldKernel θ ⇑ν)) ≤
      klDiv (applyKernel ⇑π (obsChannel θ)) (applyKernel ⇑ν (obsChannel θ)) := by
  sorry

/-- Feasible pinnings of a tilt inherit spectral independence with the same constant. [UniquenessAndRapidMixing, node_16] -/
theorem spectralIndependent_condLaw {n : ℕ} (η : ℝ) (μ : Config n → ℝ)
    (h : SpectrallyIndependent η μ) (Λ : Finset (Fin n)) (τ : Config n)
    (hfeas : Feasible μ Λ τ) :
    SpectrallyIndependent η (condLaw μ Λ τ) := by
  sorry

/-- Feasible pinnings inherit marginal stability with the same constant. [UniquenessAndRapidMixing, node_16] -/
theorem marginallyStable_condLaw {n : ℕ} (K : ℝ) (μ : Config n → ℝ)
    (h : MarginallyStable K μ) (Λ : Finset (Fin n)) (τ : Config n)
    (hfeas : Feasible μ Λ τ) :
    MarginallyStable K (condLaw μ Λ τ) := by
  sorry

/-- The quantitative information bridge: for every feasible conditional law `μ` of a tilt
`λ * ν`, `λ ∈ [θ, 1]`, and every `π ≪ μ`, the one-sided marginal information sum is at
most `2·10³ η K⁴ · D(π‖μ)`. [UniquenessAndRapidMixing, node_16] -/
theorem marginal_information_bridge {n : ℕ} (ν : FinDist (Config n))
    (θ K η : ℝ) (hθ0 : 0 < θ) (hθ1 : θ < 1) (hK : 1 ≤ K) (hη : 1 ≤ η)
    (hyp : ∀ lam : ℝ, θ ≤ lam → lam ≤ 1 →
      MarginallyStable K (tilt lam ⇑ν) ∧ SpectrallyIndependent η (tilt lam ⇑ν))
    (lam : ℝ) (hl0 : θ ≤ lam) (hl1 : lam ≤ 1)
    (Λ : Finset (Fin n)) (τ : Config n) (hfeas : Feasible (tilt lam ⇑ν) Λ τ)
    (π : FinDist (Config n)) (hac : AbsCont ⇑π (condLaw (tilt lam ⇑ν) Λ τ)) :
    plusInfoSum ⇑π (condLaw (tilt lam ⇑ν) Λ τ) ≤
      rateConst η K * klDiv ⇑π (condLaw (tilt lam ⇑ν) Λ τ) := by
  sorry

/-- Endpoint of the exponential-clock argument: expected remaining posterior entropy after
the retained-set observation is at least `θ^{2·10³ η K⁴} Ent_ν[f]` (lower-bound direction). [UniquenessAndRapidMixing, node_16] -/
theorem remaining_entropy_lower_bound {n : ℕ} (ν : FinDist (Config n))
    (θ K η : ℝ) (hθ0 : 0 < θ) (hθ1 : θ < 1) (hK : 1 ≤ K) (hη : 1 ≤ η)
    (hyp : ∀ lam : ℝ, θ ≤ lam → lam ≤ 1 →
      MarginallyStable K (tilt lam ⇑ν) ∧ SpectrallyIndependent η (tilt lam ⇑ν))
    (f : Config n → ℝ) (hf : ∀ σ, 0 ≤ f σ) :
    θ ^ rateConst η K * entropyF ⇑ν f ≤
      ∑ R : Finset (Fin n),
        applyKernel ⇑ν (obsChannel θ) R * entropyF (posterior θ ⇑ν R) f := by
  sorry

/-- Chain rule: divergence lost by the observation channel equals expected posterior
entropy of `π/ν`, with reference-law weights. [UniquenessAndRapidMixing, node_16] -/
theorem chain_rule_observation {n : ℕ} (θ : ℝ) (ν π : FinDist (Config n))
    (hac : AbsCont ⇑π ⇑ν) (hθ0 : 0 < θ) (hθ1 : θ < 1) :
    klDiv ⇑π ⇑ν - klDiv (applyKernel ⇑π (obsChannel θ)) (applyKernel ⇑ν (obsChannel θ)) =
      ∑ R : Finset (Fin n),
        applyKernel ⇑ν (obsChannel θ) R *
          entropyF (posterior θ ⇑ν R) (fun σ => π σ / ν σ) := by
  sorry

/-! ## Main theorem -/

/-- Field dynamics entropy contraction: under `K`-marginal stability and `η`-spectral
independence of `λ * ν` for every `λ ∈ [θ, 1]`, every `π ≪ ν` satisfies
`D(πP ‖ νP) ≤ (1 - θ^{2·10³ η K⁴}) D(π ‖ ν)`. [UniquenessAndRapidMixing, node_16] -/
theorem field_dynamics_entropy_contraction {n : ℕ} (hn : 1 ≤ n)
    (ν : FinDist (Config n))
    (θ K η : ℝ) (hθ0 : 0 < θ) (hθ1 : θ < 1) (hK : 1 ≤ K) (hη : 1 ≤ η)
    (hyp : ∀ lam : ℝ, θ ≤ lam → lam ≤ 1 →
      MarginallyStable K (tilt lam ⇑ν) ∧ SpectrallyIndependent η (tilt lam ⇑ν))
    (π : FinDist (Config n)) (hac : AbsCont ⇑π ⇑ν) :
    klDiv (applyKernel ⇑π (fieldKernel θ ⇑ν)) (applyKernel ⇑ν (fieldKernel θ ⇑ν)) ≤
      (1 - θ ^ rateConst η K) * klDiv ⇑π ⇑ν := by
  sorry

end TCSChallenge.UniquenessAndRapidMixing.node_16
