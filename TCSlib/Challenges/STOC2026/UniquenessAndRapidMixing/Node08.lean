/-!
## The asymmetric bipartite hardcore uniqueness region

Fix reals `d ≥ 1` and `w > 1/d`. For `λ, α, v > 0` let
`F_{λ,d,α,v}(x) = λ (1 + α (1+x)^{-v})^{-d}`. The triple `(λ, d, α)` is *unique* if for every
real `v > 0`, every fixed point `x ≥ 0` of `F_{λ,d,α,v}` has `F'(x) ≤ 1`. With
`λ_c = w^d (d+1)^{d+1} / (dw-1)^{d+1}` and `α_c = d^w (w+1)^{w+1} / (dw-1)^{w+1}`,
the main theorem `main_theorem` says: every `(λ, α) ∈ [λ_c, ∞) × (0, α_c]` is unique, and on
the lines `α = α_c` and `λ = λ_c` (with positive parameters) membership in the rectangle is
also necessary.
-/

namespace TCSChallenge.UniquenessAndRapidMixing.node_08

/-- "`F_{λ,d,α,v}(x) = λ(1 + α(1+x)^{-v})^{-d}`", with real exponents. -/
def F (lam d α v : ℝ) (x : ℝ) : ℝ :=
  lam * (1 + α * (1 + x) ^ (-v)) ^ (-d)

/-- "Call `(λ,d,α)` unique if `∀ v > 0, ∀ x ≥ 0, F(x) = x ⟹ F'(x) ≤ 1`." -/
def IsUnique (lam d α : ℝ) : Prop :=
  ∀ v : ℝ, 0 < v → ∀ x : ℝ, 0 ≤ x → F lam d α v x = x → deriv (F lam d α v) x ≤ 1

/-- `λ_c = w^d (d+1)^{d+1} / (dw-1)^{d+1}`. -/
def lamCrit (d w : ℝ) : ℝ :=
  w ^ d * (d + 1) ^ (d + 1) / (d * w - 1) ^ (d + 1)

/-- `α_c = d^w (w+1)^{w+1} / (dw-1)^{w+1}`. -/
def alphaCrit (d w : ℝ) : ℝ :=
  d ^ w * (w + 1) ^ (w + 1) / (d * w - 1) ^ (w + 1)

/-- Rubric 1: at a fixed point `x` with `y = α(1+x)^{-v}`, one has `x > 0`, `λ = x(1+y)^d`,
and `F'(x) = d v x y / ((1+x)(1+y))`. [UniquenessAndRapidMixing, node_08] -/
theorem fixed_point_coordinates (lam d α v x : ℝ) (hlam : 0 < lam) (hd : 1 ≤ d)
    (hα : 0 < α) (hv : 0 < v) (hx : 0 ≤ x) (hfix : F lam d α v x = x) :
    0 < x ∧ lam = x * (1 + α * (1 + x) ^ (-v)) ^ d ∧
      deriv (F lam d α v) x =
        d * v * x * (α * (1 + x) ^ (-v)) /
          ((1 + x) * (1 + α * (1 + x) ^ (-v))) := by
  sorry

/-- Rubric 2–3: exact criterion (3). With `z` the unique positive solution of
`λ = z ((d+1+z)/d)^d`, uniqueness holds iff `α ≤ (1/d) (1+z)^{(d+1)(1+z)/(dz)}`. [UniquenessAndRapidMixing, node_08] -/
theorem uniqueness_criterion (lam d α z : ℝ) (hlam : 0 < lam) (hd : 1 ≤ d) (hα : 0 < α)
    (hz : 0 < z) (hPz : lam = z * ((d + 1 + z) / d) ^ d) :
    IsUnique lam d α ↔ α ≤ (1 / d) * (1 + z) ^ ((d + 1) * (1 + z) / (d * z)) := by
  sorry

/-- Rubric 4: the critical dual formulas. For `u > 1/d` and `z_u = (d+1)/(du-1)`,
`P_d(z_u) = λ̂(u,d)` and `Q_d(z_u) = λ̂(d,u)`, i.e. the critical `λ` and `α` at parameter `u`. [UniquenessAndRapidMixing, node_08] -/
theorem critical_dual_formulas (d u : ℝ) (hd : 1 ≤ d) (hu : 1 / d < u) :
    ((d + 1) / (d * u - 1)) * ((d + 1 + (d + 1) / (d * u - 1)) / d) ^ d = lamCrit d u ∧
      (1 / d) * (1 + (d + 1) / (d * u - 1)) ^
          ((d + 1) * (1 + (d + 1) / (d * u - 1)) / (d * ((d + 1) / (d * u - 1))))
        = alphaCrit d u := by
  sorry

/-- Main theorem: the rectangle `[λ_c, ∞) × (0, α_c]` is contained in the uniqueness region,
and is sharp on the lines `α = α_c` and `λ = λ_c`. [UniquenessAndRapidMixing, node_08] -/
theorem main_theorem (d w : ℝ) (hd : 1 ≤ d) (hw : 1 / d < w) :
    (∀ lam α : ℝ, lamCrit d w ≤ lam → 0 < α → α ≤ alphaCrit d w → IsUnique lam d α) ∧
    (∀ lam : ℝ, 0 < lam → IsUnique lam d (alphaCrit d w) → lamCrit d w ≤ lam) ∧
    (∀ α : ℝ, 0 < α → IsUnique (lamCrit d w) d α → α ≤ alphaCrit d w) := by
  sorry

end TCSChallenge.UniquenessAndRapidMixing.node_08
