/-!
## Spectral gap of L-side Glauber dynamics in the bipartite hardcore model

`G = ((L,R),E)` is a finite bipartite graph with `n = |L| ≥ 2` and every `u ∈ L` of degree
`≤ Δ` (degrees in `R` unrestricted). `μ(I) ∝ λ^{|I|}` on independent sets, `ν` its marginal
on `L`. Put `d = Δ - 1`, `C = (1+λ)^Δ`. If `(λ,d)` is `δ`-unique — for every real `w > 0`
every fixed point `x̂ ≥ 0` of `F_w(x) = λ(1 + λ(1+x)^{-w})^{-d}` has `F_w'(x̂) ≤ 1-δ` — then
the heat-bath chain `P_ν` satisfies (`main_theorem`)
`γ(P_ν) ≥ (1/(22n)) · (C e^9 Δ log n / λ)^{-10^5 C^5/δ}`.
-/

namespace TCSChallenge.UniquenessAndRapidMixing.node_21

variable {L R : Type} [Fintype L] [Fintype R] [DecidableEq L] [DecidableEq R]

/-- Number of positive (occupied) coordinates `N_+(x)`. -/
def numPos {X : Type} [Fintype X] (x : X → Bool) : ℕ :=
  (Finset.univ.filter (fun i => x i = true)).card

/-- `(σ, τ)` encodes an independent set of `G`: no edge has both endpoints occupied. -/
def IsIndep (adj : L → R → Prop) (σ : L → Bool) (τ : R → Bool) : Prop :=
  ∀ u v, adj u v → ¬ (σ u = true ∧ τ v = true)

/-- Unnormalized marginal weight on `L`: `∑_{τ} λ^{|σ|+|τ|} [σ ∪ τ independent]`. -/
def margWeight (adj : L → R → Prop) (lam : ℝ) (σ : L → Bool) : ℝ :=
  ∑ τ : R → Bool, if IsIndep adj σ τ then lam ^ (numPos σ + numPos τ) else 0

/-- "`ν_H` its marginal on `A`": the `L`-marginal of the hardcore measure `μ_G`. -/
def nu (adj : L → R → Prop) (lam : ℝ) (σ : L → Bool) : ℝ :=
  margWeight adj lam σ / ∑ σ' : L → Bool, margWeight adj lam σ'

/-- Global spin flip `ρ̄(x) = ρ(-x)`. -/
def flipDist (ρ : (L → Bool) → ℝ) : (L → Bool) → ℝ := fun x => ρ (fun i => !x i)

/-- Heat-bath chain `P_ρ`: choose a coordinate `i` uniformly and resample it from `ρ`
conditioned on all other coordinates. -/
def heatBath (ρ : (L → Bool) → ℝ) (x y : L → Bool) : ℝ :=
  (1 / (Fintype.card L : ℝ)) * ∑ i : L,
    if (∀ j, j ≠ i → y j = x j) then
      ρ y / (ρ (Function.update x i true) + ρ (Function.update x i false))
    else 0

/-- `Var_ρ(f)`. -/
def variance (ρ : (L → Bool) → ℝ) (f : (L → Bool) → ℝ) : ℝ :=
  (∑ x, ρ x * f x ^ 2) - (∑ x, ρ x * f x) ^ 2

/-- Dirichlet form `½ ∑_{x,y} ρ(x) P(x,y) (f(x)-f(y))²`. -/
def dirichlet (ρ : (L → Bool) → ℝ) (P : (L → Bool) → (L → Bool) → ℝ)
    (f : (L → Bool) → ℝ) : ℝ :=
  (1 / 2) * ∑ x, ∑ y, ρ x * P x y * (f x - f y) ^ 2

/-- Spectral gap `γ(P) = inf_{Var_ρ f > 0} 𝓔(f,f) / Var_ρ(f)`. -/
def spectralGap (ρ : (L → Bool) → ℝ) (P : (L → Bool) → (L → Bool) → ℝ) : ℝ :=
  sInf {r : ℝ | ∃ f : (L → Bool) → ℝ, 0 < variance ρ f ∧ r = dirichlet ρ P f / variance ρ f}

/-- `F_w(x) = λ(1 + λ(1+x)^{-w})^{-d}`. -/
def Fw (lam d w : ℝ) (x : ℝ) : ℝ :=
  lam * (1 + lam * (1 + x) ^ (-w)) ^ (-d)

/-- `δ`-uniqueness of `(λ, d)`: every nonnegative fixed point of every `F_w` has
`F_w' ≤ 1 - δ`. -/
def DeltaUnique (lam d δ : ℝ) : Prop :=
  ∀ w : ℝ, 0 < w → ∀ x : ℝ, 0 ≤ x → Fw lam d w x = x → deriv (Fw lam d w) x ≤ 1 - δ

/-- Step 5 / rubric 5: global spin flip intertwines `P_ν` and `P_{ν̄}`, so the gaps agree. [UniquenessAndRapidMixing, node_21] -/
theorem spectralGap_flip (ρ : (L → Bool) → ℝ) :
    spectralGap (flipDist ρ) (heatBath (flipDist ρ)) = spectralGap ρ (heatBath ρ) := by
  sorry

/-- Formula (4): the heat-bath Dirichlet form is the average of expected one-coordinate
conditional variances (stated for a positive distribution). [UniquenessAndRapidMixing, node_21] -/
theorem heatBath_dirichlet_eq (ρ : (L → Bool) → ℝ) (hρ : ∀ x, 0 < ρ x)
    (f : (L → Bool) → ℝ) :
    dirichlet ρ (heatBath ρ) f =
      (1 / (Fintype.card L : ℝ)) * ∑ i : L, ∑ x : L → Bool,
        ρ x * (ρ (Function.update x i true) * ρ (Function.update x i false) /
          (ρ (Function.update x i true) + ρ (Function.update x i false)) ^ 2) *
          (f (Function.update x i true) - f (Function.update x i false)) ^ 2 := by
  sorry

/-- Main theorem: `γ(P_ν) ≥ (1/(22n)) (C e^9 Δ log n / λ)^{-10^5 C^5/δ}`. [UniquenessAndRapidMixing, node_21] -/
theorem main_theorem (adj : L → R → Prop) (Δ : ℕ) (lam δ : ℝ)
    (hΔ : 2 ≤ Δ) (hlam : 0 < lam) (hδ0 : 0 < δ) (hδ1 : δ < 1)
    (hn : 2 ≤ Fintype.card L)
    (hdeg : ∀ u : L, (Finset.univ.filter (fun v : R => adj u v)).card ≤ Δ)
    (huniq : DeltaUnique lam ((Δ : ℝ) - 1) δ) :
    let n : ℝ := Fintype.card L
    let C : ℝ := (1 + lam) ^ Δ
    1 / (22 * n) *
        (C * Real.exp 9 * (Δ : ℝ) * Real.log n / lam) ^ (-(10 ^ 5 * C ^ 5 / δ))
      ≤ spectralGap (nu adj lam) (heatBath (nu adj lam)) := by
  sorry

end TCSChallenge.UniquenessAndRapidMixing.node_21
