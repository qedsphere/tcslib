/-!
## Algorithmic scatter dimension of Euclidean ball intersection

An admissible algorithm `C` takes a finite set `Q` of requests `(p, r)` (balls `B(p,r)` in
`ℝ^d`) and `η ∈ (0,1)` and returns FAIL or a point `x` with `‖x − p‖ ≤ (1+η) r` for all
requests, never failing when the balls have a common point. A `(C, ε)`-scattering is a
sequence `(x_i, p_i, r_i)` where each `x_i` (`i ≥ 2`) is returned by `C` on the earlier
requests with accuracy `ε/2`, and `‖x_i − p_i‖ > (1+ε) r_i`.
Main theorem `algorithmic_scatter_dimension_bound`: some admissible `C` and absolute `A`
satisfy: in every `(C, ε)`-scattering, each radius occurs at most `A ε^{-4} log(1/ε)` times,
for all `0 < ε ≤ 1/2`.
-/

namespace TCSChallenge.ParameterizedApproximationSchemesFor.node_29

/-- Euclidean space `ℝ^d` with the `ℓ₂` norm. -/
abbrev E (d : ℕ) : Type := EuclideanSpace ℝ (Fin d)

/-- A uniform deterministic algorithm: one function for all dimensions; `none` is FAIL. -/
abbrev BallAlg : Type := ∀ d : ℕ, Finset (E d × ℝ) → ℝ → Option (E d)

/-- "Every returned point satisfies ‖x−p‖₂ ≤ (1+η) r for all (p,r) ∈ Q. If ⋂ B(p,r) is
nonempty, C does not return FAIL." (running time dropped) -/
def Admissible (C : BallAlg) : Prop :=
  ∀ (d : ℕ) (Q : Finset (E d × ℝ)) (η : ℝ), 0 < η → η < 1 → (∀ q ∈ Q, 0 < q.2) →
    (∀ x : E d, C d Q η = some x → ∀ q ∈ Q, ‖x - q.1‖ ≤ (1 + η) * q.2) ∧
    ((∃ z : E d, ∀ q ∈ Q, ‖z - q.1‖ ≤ q.2) → C d Q η ≠ none)

/-- The request set `{(p_j, r_j) : j < i}`. -/
def prefixRequests {d ℓ : ℕ} (p : Fin ℓ → E d) (r : Fin ℓ → ℝ) (i : Fin ℓ) :
    Finset (E d × ℝ) :=
  (Finset.univ.filter (fun j : Fin ℓ => j < i)).image (fun j => (p j, r j))

/-- "A (C,ε)-scattering is a finite sequence (x_i,p_i,r_i) with p_i ∈ P, r_i > 0, x₁
arbitrary, for every i ≥ 2 the call C({(p_j,r_j) : j<i}, ε/2) returns x_i, and
‖x_i − p_i‖₂ > (1+ε) r_i for every i." (0-based indices: `i ≥ 2` becomes `1 ≤ i.val`.) -/
def IsAlgScattering (C : BallAlg) (ε : ℝ) (d : ℕ) (P : Finset (E d)) (ℓ : ℕ)
    (x p : Fin ℓ → E d) (r : Fin ℓ → ℝ) : Prop :=
  (∀ i, p i ∈ P) ∧ (∀ i, 0 < r i) ∧
    (∀ i : Fin ℓ, 1 ≤ i.val → C d (prefixRequests p r i) (ε / 2) = some (x i)) ∧
    ∀ i, (1 + ε) * r i < ‖x i - p i‖

/-- Number of indices of the scattering with radius exactly `r₀`. -/
def radiusMultiplicity {ℓ : ℕ} (r : Fin ℓ → ℝ) (r₀ : ℝ) : ℕ :=
  (Finset.univ.filter (fun i : Fin ℓ => r i = r₀)).card

/-! ## The paper's algorithm -/

/-- `F_S(y) = max_{(p,r) ∈ S} ‖y − p‖² / r²` (0 for empty `S`). -/
def Fobj {d : ℕ} (S : Finset (E d × ℝ)) (y : E d) : ℝ :=
  ⨆ q : ↥S, ‖y - (q : E d × ℝ).1‖ ^ 2 / (q : E d × ℝ).2 ^ 2

/-- Specification of the (deterministic) convex-programming procedure: on a nonempty `S`
and `δ > 0` it returns `x` with `F_S(x) ≤ min_y F_S(y) + δ`. -/
def MinOracleSpec (o : ∀ d : ℕ, Finset (E d × ℝ) → ℝ → E d) : Prop :=
  ∀ (d : ℕ) (S : Finset (E d × ℝ)) (δ : ℝ), S.Nonempty → 0 < δ →
    ∀ y : E d, Fobj S (o d S δ) ≤ Fobj S y + δ

/-- The paper's algorithm: `m` = minimum radius, `a = 2^⌊log₂ m⌋`, `b = 6a/η`, retain
`S = {(p,r) ∈ Q : r ≤ b}`, compute an additive `δ = η⁴/576` minimizer `x` of `F_S`, and
return `x` if it satisfies every request of `Q` with factor `1+η`, else FAIL; the origin
for empty `Q`. -/
def paperAlg (o : ∀ d : ℕ, Finset (E d × ℝ) → ℝ → E d) : BallAlg :=
  fun d Q η =>
    if h : Q.Nonempty then
      let m : ℝ := Q.inf' h Prod.snd
      let a : ℝ := (2 : ℝ) ^ (Int.floor (Real.logb 2 m))
      let S : Finset (E d × ℝ) := Q.filter (fun q => q.2 ≤ 6 * a / η)
      let x : E d := o d S (η ^ 4 / 576)
      if ∀ q ∈ Q, ‖x - q.1‖ ≤ (1 + η) * q.2 then some x else none
    else some 0

/-- Step 3, inequality (2): if all radii of `S` lie in `(0, b]` and `z` minimizes `F_S`, then
`F_S(y) ≥ F_S(z) + ‖y − z‖² / b²`. [ParameterizedApproximationSchemesFor, node_29] -/
theorem Fobj_strong_convexity {d : ℕ} (S : Finset (E d × ℝ)) (hS : S.Nonempty) (b : ℝ)
    (hb : 0 < b) (hr : ∀ q ∈ S, 0 < q.2 ∧ q.2 ≤ b) (z : E d)
    (hz : ∀ y : E d, Fobj S z ≤ Fobj S y) (y : E d) :
    Fobj S z + ‖y - z‖ ^ 2 / b ^ 2 ≤ Fobj S y := by
  sorry

/-- Rubric 2: the paper's algorithm is a correct approximate ball-intersection algorithm. [ParameterizedApproximationSchemesFor, node_29] -/
theorem paperAlg_admissible (o : ∀ d : ℕ, Finset (E d × ℝ) → ℝ → E d)
    (ho : MinOracleSpec o) : Admissible (paperAlg o) := by
  sorry

/-- Rubrics 3–5: explicit multiplicity bound for the paper's algorithm,
`|{i : r_i = r}| ≤ 2 + 162 η^{-4} (2 + log₂(6/η))` with `η = ε/2`. [ParameterizedApproximationSchemesFor, node_29] -/
theorem paperAlg_multiplicity_bound (o : ∀ d : ℕ, Finset (E d × ℝ) → ℝ → E d)
    (ho : MinOracleSpec o) (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε ≤ 1 / 2) (d : ℕ)
    (P : Finset (E d)) (ℓ : ℕ) (x p : Fin ℓ → E d) (r : Fin ℓ → ℝ)
    (hσ : IsAlgScattering (paperAlg o) ε d P ℓ x p r) (r₀ : ℝ) :
    (radiusMultiplicity r r₀ : ℝ) ≤
      2 + 162 * (ε / 2)⁻¹ ^ 4 * (2 + Real.logb 2 (6 / (ε / 2))) := by
  sorry

/-- Main theorem: there are an admissible uniform algorithm `C` and an absolute constant `A`
with `Λ_C(ε) ≤ A ε^{-4} log(1/ε)` for every `0 < ε ≤ 1/2`. [ParameterizedApproximationSchemesFor, node_29] -/
theorem algorithmic_scatter_dimension_bound :
    ∃ (A : ℝ) (C : BallAlg), Admissible C ∧
      ∀ (ε : ℝ), 0 < ε → ε ≤ 1 / 2 →
        ∀ (d : ℕ) (P : Finset (E d)) (ℓ : ℕ) (x p : Fin ℓ → E d) (r : Fin ℓ → ℝ),
          IsAlgScattering C ε d P ℓ x p r →
          ∀ r₀ : ℝ, (radiusMultiplicity r r₀ : ℝ) ≤ A * ε⁻¹ ^ 4 * Real.log (1 / ε) := by
  sorry

end TCSChallenge.ParameterizedApproximationSchemesFor.node_29
