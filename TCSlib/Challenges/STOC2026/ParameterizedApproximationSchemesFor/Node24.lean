/-!
## Scatter dimension of bounded-treewidth graph metrics

For a finite connected graph `G` with strictly positive symmetric edge lengths and its
shortest-path metric `d_G`, an ε-scattering is a sequence `(x_i, p_i)` with
`d_G(x_i, p_j) ≤ 1` for `j < i` and `d_G(x_i, p_i) > 1 + ε`.
Main theorem `scatter_bound_treewidth`: there is an absolute `C ≥ 2` such that for every
`k ≥ 1`, `0 < ε < 1` and every such `G` with `tw(G) ≤ k`, every ε-scattering has length
at most `exp((C/ε)^(C k))`, and at most `k^((C/ε)^(C k))` when `k ≥ 2`.
-/

namespace TCSChallenge.ParameterizedApproximationSchemesFor.node_24

variable {V : Type} [Fintype V] [DecidableEq V]

/-- Edge lengths: "edges have strictly positive lengths" (symmetric, positive on edges). -/
def PositiveLengths (G : SimpleGraph V) (len : V → V → ℝ) : Prop :=
  (∀ u v, len u v = len v u) ∧ ∀ u v, G.Adj u v → 0 < len u v

/-- A walk of `k` steps from `x` to `y` in `G` all of whose vertices avoid `D`
(i.e. a walk in `G − D`), encoded as a vertex tuple. -/
def IsWalkAvoiding (G : SimpleGraph V) (D : Set V) (x y : V) (k : ℕ)
    (q : Fin (k + 1) → V) : Prop :=
  q 0 = x ∧ q (Fin.last k) = y ∧ (∀ i : Fin k, G.Adj (q i.castSucc) (q i.succ)) ∧
    ∀ i, q i ∉ D

/-- Length of a walk: the sum of its edge lengths. -/
def walkLength (len : V → V → ℝ) (k : ℕ) (q : Fin (k + 1) → V) : ℝ :=
  ∑ i : Fin k, len (q i.castSucc) (q i.succ)

/-- The shortest-path metric `d_G(x, y)`: infimum of lengths of walks from `x` to `y`. -/
def graphDist (G : SimpleGraph V) (len : V → V → ℝ) (x y : V) : ℝ :=
  sInf {c : ℝ | ∃ (k : ℕ) (q : Fin (k + 1) → V),
    IsWalkAvoiding G ∅ x y k q ∧ walkLength len k q = c}

/-- `d_{G−D}(x, y) ≤ c`: some walk in `G − D` from `x` to `y` has length at most `c`. -/
def CloseAvoid (G : SimpleGraph V) (len : V → V → ℝ) (D : Set V) (x y : V) (c : ℝ) : Prop :=
  ∃ (k : ℕ) (q : Fin (k + 1) → V), IsWalkAvoiding G D x y k q ∧ walkLength len k q ≤ c

/-- "An ε-scattering is a finite sequence (x₁,p₁),…,(x_m,p_m) of pairs of vertices such that
d_G(x_i,p_j) ≤ 1 for all 1 ≤ j < i ≤ m, d_G(x_i,p_i) > 1 + ε for all i." -/
def IsScattering (G : SimpleGraph V) (len : V → V → ℝ) (ε : ℝ) (m : ℕ)
    (x p : Fin m → V) : Prop :=
  (∀ i j : Fin m, j < i → graphDist G len (x i) (p j) ≤ 1) ∧
    ∀ i : Fin m, 1 + ε < graphDist G len (x i) (p i)

/-- An ε-scattering in the intermediate graph `H = G − D` (vertices of all pairs survive;
distances across components are `+∞`). -/
def IsScatteringAvoid (G : SimpleGraph V) (len : V → V → ℝ) (D : Set V) (ε : ℝ) (m : ℕ)
    (x p : Fin m → V) : Prop :=
  (∀ i j : Fin m, j < i → CloseAvoid G len D (x i) (p j) 1) ∧
    ∀ i : Fin m, x i ∉ D ∧ p i ∉ D ∧ ¬ CloseAvoid G len D (x i) (p i) (1 + ε)

/-- "A tree decomposition of G is a finite tree T with bags B_t ⊆ V(G) such that the bags
cover V(G), every edge has both endpoints in some bag, and for each v the nodes t with
v ∈ B_t induce a connected subtree"; width `max |B_t| − 1 ≤ k`, i.e. all bags have size
`≤ k + 1`. `tw(G) ≤ k` iff such a decomposition exists. -/
def HasTreewidthAtMost (G : SimpleGraph V) (k : ℕ) : Prop :=
  ∃ (n : ℕ) (T : SimpleGraph (Fin n)) (B : Fin n → Finset V),
    T.IsTree ∧ (∀ v, ∃ t, v ∈ B t) ∧ (∀ u v, G.Adj u v → ∃ t, u ∈ B t ∧ v ∈ B t) ∧
    (∀ v, (T.induce {t | v ∈ B t}).Connected) ∧ ∀ t, (B t).card ≤ k + 1

/-- "A connected set S supports X if there is one path from S to each x ∈ X, and these
paths are pairwise vertex-disjoint outside S", all inside `G − D` (and `S ∩ D = ∅`). -/
def Supports (G : SimpleGraph V) (D : Set V) (S X : Finset V) : Prop :=
  (G.induce (↑S : Set V)).Connected ∧ (∀ v ∈ S, v ∉ D) ∧
    ∃ (s : V → V) (k : V → ℕ) (q : ∀ v, Fin (k v + 1) → V),
      (∀ v ∈ X, s v ∈ S ∧ IsWalkAvoiding G D (s v) v (k v) (q v)) ∧
      ∀ v ∈ X, ∀ v' ∈ X, v ≠ v' → ∀ (i : Fin (k v + 1)) (j : Fin (k v' + 1)),
        q v i = q v' j → q v i ∈ S

/-- For connected `G` with positive lengths, `d_G(x,y) ≤ c` iff some walk has length `≤ c`
(the infimum over walks is attained). [ParameterizedApproximationSchemesFor, node_24] -/
theorem graphDist_le_iff (G : SimpleGraph V) (len : V → V → ℝ) (hG : G.Connected)
    (hlen : PositiveLengths G len) (x y : V) (c : ℝ) :
    graphDist G len x y ≤ c ↔ CloseAvoid G len ∅ x y c := by
  sorry

/-- Rubric 1 (packing): centers of an ε-scattering are pairwise more than ε apart. [ParameterizedApproximationSchemesFor, node_24] -/
theorem centers_separated (G : SimpleGraph V) (len : V → V → ℝ) (hlen : PositiveLengths G len)
    (D : Set V) (ε : ℝ) (m : ℕ) (x p : Fin m → V)
    (hσ : IsScatteringAvoid G len D ε m x p) (i j : Fin m) (hij : i ≠ j) :
    ¬ CloseAvoid G len D (x i) (x j) ε := by
  sorry

/-- Rubric 5 (treewidth obstruction): with `w = k + 1`, if `tw(G) ≤ k` there are no `w + 1`
pairwise disjoint connected sets all supporting the same target set `X` with `|X| > 2w`. [ParameterizedApproximationSchemesFor, node_24] -/
theorem treewidth_obstruction (G : SimpleGraph V) (k : ℕ) (htw : HasTreewidthAtMost G k)
    (X : Finset V) (hX : 2 * (k + 1) < X.card) (S : Fin (k + 2) → Finset V)
    (hdisj : ∀ i j, i ≠ j → Disjoint (S i) (S j)) (hsupp : ∀ i, Supports G ∅ (S i) X) :
    False := by
  sorry

/-- Rubrics 2–3 (extraction): an ε-scattering of length `m ≥ (64/ε)^(3/ε)` in `H = G − D`
yields a connected set `S ⊆ V(H)` and a subsequence of length `m' ≥ (ε/32) m^(ε/3)` which is
an ε-scattering in `H − S`, and `S` supports its centers in `H`. [ParameterizedApproximationSchemesFor, node_24] -/
theorem extraction (G : SimpleGraph V) (len : V → V → ℝ) (hlen : PositiveLengths G len)
    (D : Set V) (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1) (m : ℕ) (x p : Fin m → V)
    (hσ : IsScatteringAvoid G len D ε m x p)
    (hm : (64 / ε) ^ (3 / ε) ≤ (m : ℝ)) :
    ∃ (S : Finset V) (m' : ℕ) (φ : Fin m' → Fin m), StrictMono φ ∧
      Supports G D S ((Finset.univ : Finset (Fin m')).image (fun i => x (φ i))) ∧
      IsScatteringAvoid G len (D ∪ ↑S) ε m' (x ∘ φ) (p ∘ φ) ∧
      (ε / 32) * (m : ℝ) ^ (ε / 3) ≤ (m' : ℝ) := by
  sorry

/-- Explicit form (Step 3–4): every ε-scattering has length
`< (128(k+2)/ε)^(3 (4/ε)^(k+2))`. [ParameterizedApproximationSchemesFor, node_24] -/
theorem scatter_bound_explicit (k : ℕ) (hk : 1 ≤ k) (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1)
    (G : SimpleGraph V) (len : V → V → ℝ) (hG : G.Connected) (hlen : PositiveLengths G len)
    (htw : HasTreewidthAtMost G k) (m : ℕ) (x p : Fin m → V)
    (hσ : IsScattering G len ε m x p) :
    (m : ℝ) < (128 * ((k : ℝ) + 2) / ε) ^ (3 * (4 / ε) ^ ((k : ℝ) + 2)) := by
  sorry

/-- Main theorem: an absolute `C ≥ 2` with `scatter_ε(G) ≤ exp((C/ε)^(C k))`, and
`scatter_ε(G) ≤ k^((C/ε)^(C k))` when `k ≥ 2`, for all `tw(G) ≤ k`. [ParameterizedApproximationSchemesFor, node_24] -/
theorem scatter_bound_treewidth :
    ∃ C : ℝ, 2 ≤ C ∧ ∀ (k : ℕ), 1 ≤ k → ∀ (ε : ℝ), 0 < ε → ε < 1 →
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) (len : W → W → ℝ),
        G.Connected → PositiveLengths G len → HasTreewidthAtMost G k →
        ∀ (m : ℕ) (x p : Fin m → W), IsScattering G len ε m x p →
          (m : ℝ) ≤ Real.exp ((C / ε) ^ (C * (k : ℝ))) ∧
          (2 ≤ k → (m : ℝ) ≤ (k : ℝ) ^ ((C / ε) ^ (C * (k : ℝ)))) := by
  sorry

end TCSChallenge.ParameterizedApproximationSchemesFor.node_24
