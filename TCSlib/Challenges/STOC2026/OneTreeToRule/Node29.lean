/-!
## Poly-logarithmic sparse partition hierarchies

Let `G = (V, E, w)` be a connected weighted graph with `n ≥ 2` vertices and all edge lengths
at least `1`. A partition is encoded by a label function `c : V → V` (clusters are the fibres).
A `γ`-hierarchy is a sequence `c 0, …, c k` with `c 0` singletons, `c k` a single cluster,
`c (i+1)` coarsening `c i`, and each `c i` a strong diameter-`γ^i`, `(α, τ)`-sparse partition.

Main theorem `sparse_partition_hierarchy`: every such graph admits a hierarchy with
`α, τ = O(log n)` and `γ = O(log² n)`.

Distances are encoded through walks: `DistLE G w S x y L` says there is a walk from `x` to `y`
staying inside `S` of total length at most `L`, i.e. `d_{G[S]}(x, y) ≤ L` (finite graph,
positive lengths, so the infimum is attained).
-/

namespace TCSChallenge.OneTreeToRuleThemAll.node_29

/-- A walk `p 0, …, p m` from `x` to `y` all of whose vertices lie in `S`. -/
def IsWalkIn {V : Type} (G : SimpleGraph V) (S : Set V) (x y : V) {m : ℕ}
    (p : Fin (m + 1) → V) : Prop :=
  p 0 = x ∧ p (Fin.last m) = y ∧ (∀ i, p i ∈ S) ∧
    ∀ i : Fin m, G.Adj (p i.castSucc) (p i.succ)

/-- Total length of a walk under the edge-length function `w`. -/
def walkLen {V : Type} (w : V → V → ℝ) {m : ℕ} (p : Fin (m + 1) → V) : ℝ :=
  ∑ i : Fin m, w (p i.castSucc) (p i.succ)

/-- "`d_{G[S]}(x,y) ≤ L`": some walk inside `S` from `x` to `y` has length at most `L`.
With `S = Set.univ` this is the ambient bound `d_G(x,y) ≤ L`. -/
def DistLE {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (S : Set V) (x y : V) (L : ℝ) :
    Prop :=
  ∃ (m : ℕ) (p : Fin (m + 1) → V), IsWalkIn G S x y p ∧ walkLen w p ≤ L

/-- Shortest-path distance `d_G(x,y)` (infimum of walk lengths). -/
def gDist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (x y : V) : ℝ :=
  sInf {L : ℝ | DistLE G w Set.univ x y L}

/-- "undirected graph with positive edge lengths ... normalize the minimum edge length to be at
least 1": symmetric lengths, every edge of length at least `1`. -/
def GoodWeights {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) : Prop :=
  (∀ u v, w u v = w v u) ∧ ∀ u v, G.Adj u v → 1 ≤ w u v

/-- "each cluster `C` has diameter at most `s` in `G[C]`". -/
def StrongDiam {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (c : V → V) (s : ℝ) : Prop :=
  ∀ u v, c u = c v → DistLE G w {x | c x = c u} u v s

/-- "every ball `B_G(v, s/α)` intersects at most `τ` clusters". -/
def Sparse {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ) (c : V → V)
    (s α : ℝ) (τ : ℕ) : Prop :=
  ∀ v, ((Finset.univ.filter (fun u => DistLE G w Set.univ v u (s / α))).image c).card ≤ τ

/-- "`𝒞_{i+1}` coarsens `𝒞_i`": every old cluster lies inside a new cluster. -/
def Coarsens {V : Type} (c c' : V → V) : Prop :=
  ∀ u v, c u = c v → c' u = c' v

/-- A `γ`-hierarchy of strong diameter-`γ^i`, `(α, τ)`-sparse partitions from singletons
(`c 0` injective) to the single cluster `{V}` (`c k` constant). -/
def IsHierarchy {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
    (α : ℝ) (τ : ℕ) (γ : ℝ) : Prop :=
  ∃ (k : ℕ) (c : ℕ → V → V),
    Function.Injective (c 0) ∧ (∀ u v, c k u = c k v) ∧
    (∀ i, i < k → Coarsens (c i) (c (i + 1))) ∧
    ∀ i, i ≤ k → StrongDiam G w (c i) (γ ^ i) ∧ Sparse G w (c i) (γ ^ i) α τ

/-- Supplied fact (weighted sites): `a, t = O(log n)`, independent of the scale `Δ`. [OneTreeToRule, node_29] -/
theorem weighted_sites :
    ∃ C : ℝ, 0 < C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) (w : W → W → ℝ),
        2 ≤ Fintype.card W → G.Connected → GoodWeights G w →
        ∃ (a : ℝ) (t : ℕ), 1 ≤ a ∧ 1 ≤ t ∧
          a ≤ C * Real.log (Fintype.card W) ∧ (t : ℝ) ≤ C * Real.log (Fintype.card W) ∧
          ∀ Δ : ℝ, 0 < Δ →
            ∃ (S : Finset W) (hS : S.Nonempty) (lam : W → ℝ), (∀ q ∈ S, 0 < lam q) ∧
              ∀ v : W,
                S.inf' hS (fun q => gDist G w v q + lam q) ≤ Δ ∧
                (S.filter (fun q => gDist G w v q + lam q ≤
                    S.inf' hS (fun q' => gDist G w v q' + lam q') + Δ / a)).card ≤ t := by
  sorry

/-- Supplied fact (block assignment / cluster aggregation) with a universal constant `c`.
Blocks are the fibres of `Q`, `κ` their number; portals `P` are singleton blocks. [OneTreeToRule, node_29] -/
theorem block_assignment :
    ∃ cst : ℝ, 0 < cst ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (H : SimpleGraph W) (wH : W → W → ℝ),
        H.Connected → (∀ u v, wH u v = wH v u) → (∀ u v, H.Adj u v → 0 < wH u v) →
        ∀ (Q : W → W) (s : ℝ), 0 < s → StrongDiam H wH Q s →
        ∀ (P : Finset W) (hP : P.Nonempty), (∀ p ∈ P, ∀ x, Q x = Q p → x = p) →
          ∃ φ : W → W, (∀ x, φ x ∈ P) ∧ (∀ x y, Q x = Q y → φ x = φ y) ∧
            (∀ p ∈ P, φ p = p) ∧
            ∀ x, DistLE H wH {y | φ y = φ x} x (φ x)
              (P.inf' hP (fun p => gDist H wH x p) +
                cst * s * Real.log (2 * ((Finset.univ.image Q).card : ℝ))) := by
  sorry

/-- Internal routing gives strong diameter: if every vertex reaches the common centre `φ x`
of its cluster by a walk inside the cluster of length `≤ L`, clusters have strong diameter
`≤ 2L`. [OneTreeToRule, node_29] -/
theorem strongDiam_of_routing {V : Type} (G : SimpleGraph V) (w : V → V → ℝ)
    (hw : GoodWeights G w) (c φ : V → V) (L : ℝ)
    (hφ : ∀ x y, c x = c y → φ x = φ y)
    (hroute : ∀ x, DistLE G w {y | c y = c x} x (φ x) L) :
    StrongDiam G w c (2 * L) := by
  sorry

/-- Level zero: singleton clusters have strong diameter `0 ≤ 1 = γ^0`, and a ball of radius
`1/α < 1` contains only its centre (edge lengths `≥ 1`), so it meets one cluster. [OneTreeToRule, node_29] -/
theorem level_zero {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
    (hw : GoodWeights G w) (c : V → V) (hc : Function.Injective c)
    (α : ℝ) (hα : 1 < α) (τ : ℕ) (hτ : 1 ≤ τ) :
    StrongDiam G w c 1 ∧ Sparse G w c 1 α τ := by
  sorry

/-- Termination: the single cluster `{V}` has strong diameter `≤ s` once every pair is at
ambient distance `≤ s`, meets every ball in one cluster, and coarsens any partition. [OneTreeToRule, node_29] -/
theorem top_level {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
    (c c₀ : V → V) (hc : ∀ u v, c u = c v) (s α : ℝ) (τ : ℕ) (hτ : 1 ≤ τ)
    (hs : ∀ u v, DistLE G w Set.univ u v s) :
    StrongDiam G w c s ∧ Sparse G w c s α τ ∧ Coarsens c₀ c := by
  sorry

/-- A connected finite graph has finite diameter: some `D` bounds all distances, and
`γ^k ≥ D` for large `k` when `γ > 1`. [OneTreeToRule, node_29] -/
theorem connected_bounded_dist {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
    (hG : G.Connected) : ∃ D : ℝ, ∀ u v, DistLE G w Set.univ u v D := by
  sorry

/-- One-step coarsening (the missing reduction). With uniform `a, b, t = O(log n)` and
`Δ = 2abs`, `R = Δ/(4a) = bs/2`: from any partition of strong diameter `s` one builds a
coarsening with strong diameter `≤ 2(Δ + bs) = 2b(2a+1)s` in which every ball of radius
`R = 2b(2a+1)s / (8a+4)` meets at most `t` clusters. [OneTreeToRule, node_29] -/
theorem one_step_coarsening :
    ∃ C : ℝ, 0 < C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) (w : W → W → ℝ),
        2 ≤ Fintype.card W → G.Connected → GoodWeights G w →
        ∃ (a b : ℝ) (t : ℕ), 1 ≤ a ∧ 1 ≤ b ∧ 1 ≤ t ∧
          a ≤ C * Real.log (Fintype.card W) ∧ b ≤ C * Real.log (Fintype.card W) ∧
          (t : ℝ) ≤ C * Real.log (Fintype.card W) ∧
          ∀ (s : ℝ), 0 < s → ∀ c : W → W, StrongDiam G w c s →
            ∃ c' : W → W, Coarsens c c' ∧
              StrongDiam G w c' (2 * b * (2 * a + 1) * s) ∧
              Sparse G w c' (2 * b * (2 * a + 1) * s) (8 * a + 4) t := by
  sorry

/-- **Main theorem.** Every connected graph with `n ≥ 2` vertices and edge lengths `≥ 1`
admits a `γ`-hierarchy of strong diameter-`γ^i`, `(α, τ)`-sparse partitions with
`α = O(log n)`, `τ = O(log n)`, `γ = O(log² n)`. [OneTreeToRule, node_29] -/
theorem sparse_partition_hierarchy :
    ∃ C : ℝ, 0 < C ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) (w : W → W → ℝ),
        2 ≤ Fintype.card W → G.Connected → GoodWeights G w →
        ∃ (α γ : ℝ) (τ : ℕ), 0 < α ∧
          α ≤ C * Real.log (Fintype.card W) ∧
          (τ : ℝ) ≤ C * Real.log (Fintype.card W) ∧
          γ ≤ C * Real.log (Fintype.card W) ^ 2 ∧
          IsHierarchy G w α τ γ := by
  sorry

