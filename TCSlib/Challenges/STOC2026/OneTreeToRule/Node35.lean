/-!
## A universal Steiner tree with stretch `Õ(d⁷) log n` for doubling graphs

Let `G` be a connected positively weighted graph on `n ≥ 2` vertices whose shortest-path
metric has doubling dimension at most `d ≥ 1`. Assuming the leaf-attachment Fact 1, the
block-assignment Fact 2 and the hierarchy-to-tree Fact 3, there is a spanning tree `T` with
`w(T[S]) ≤ Õ(d⁷) · log n · OPT_G(S)` for all `S ∋ r`.

Main theorem: `universal_steiner_tree_doubling`.
-/

namespace TCSChallenge.OneTreeToRuleThemAll.node_35

/-! ## Shared definitions (identical in the three files of this paper) -/

/-- Edge lengths: nonnegative and symmetric on edges. -/
def IsWeighting {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) : Prop :=
  ∀ x y, G.Adj x y → 0 ≤ w x y ∧ w x y = w y x

/-- A walk `p 0, …, p k` all of whose vertices lie in `S` and consecutive vertices adjacent. -/
def IsWalkIn {V : Type} (G : SimpleGraph V) (S : Set V) {k : ℕ} (p : Fin (k + 1) → V) :
    Prop :=
  (∀ i, p i ∈ S) ∧ ∀ i : Fin k, G.Adj (p i.castSucc) (p i.succ)

/-- Length of a walk. -/
def walkLength {V : Type} (w : V → V → ℝ) {k : ℕ} (p : Fin (k + 1) → V) : ℝ :=
  ∑ i : Fin k, w (p i.castSucc) (p i.succ)

/-- `d_{G[S]}(x, y) ≤ r`: some walk from `x` to `y` inside `S` has length at most `r`.
(This is false when an endpoint is absent from `S` or no path exists: the `+∞` convention.) -/
def InducedDistLE {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (S : Set V) (x y : V)
    (r : ℝ) : Prop :=
  ∃ (k : ℕ) (p : Fin (k + 1) → V), IsWalkIn G S p ∧ p 0 = x ∧ p (Fin.last k) = y ∧
    walkLength w p ≤ r

/-- Shortest-path distance `d_G(x, y)` (used only on connected graphs). -/
def gDist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (x y : V) : ℝ :=
  sInf {r : ℝ | InducedDistLE G w Set.univ x y r}

/-- `d_G(x, P) = min_{t ∈ P} d_G(x, t)`. -/
def distToSet {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (x : V) (P : Set V) : ℝ :=
  sInf ((fun z => gDist G w x z) '' P)

/-- `B_G(v, R) = {x : d_G(v, x) ≤ R}`. -/
def ball {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (v : V) (R : ℝ) : Set V :=
  {x | gDist G w v x ≤ R}

/-- "`S` has diameter at most `D` in `G[S]`" (strong diameter). -/
def StrongDiamLE {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (S : Set V) (D : ℝ) :
    Prop :=
  ∀ x ∈ S, ∀ y ∈ S, InducedDistLE G w S x y D

/-- A partition of `V` into nonempty pairwise disjoint parts. -/
def IsPartition {V : Type} (C : Set (Set V)) : Prop :=
  (∀ S ∈ C, S.Nonempty) ∧ (∀ S ∈ C, ∀ T ∈ C, S ≠ T → Disjoint S T) ∧ ∀ x, ∃ S ∈ C, x ∈ S

/-- The singleton partition. -/
def singletonPartition {V : Type} : Set (Set V) :=
  {S | ∃ x, S = {x}}

/-- `C'` coarsens `C`: every part of `C` lies inside a part of `C'`. -/
def Coarsens {V : Type} (C C' : Set (Set V)) : Prop :=
  ∀ S ∈ C, ∃ T ∈ C', S ⊆ T

/-- "A strong `D`-diameter `(α, τ)`-sparse partition: every `S ∈ C` has diameter at most `D`
in `G[S]` and every ball `B_G(v, D/α)` intersects at most `τ` members of `C`." -/
def IsStrongSparsePartition {V : Type} (G : SimpleGraph V) (w : V → V → ℝ)
    (C : Set (Set V)) (D α τ : ℝ) : Prop :=
  IsPartition C ∧ (∀ S ∈ C, StrongDiamLE G w S D) ∧
    ∀ v : V, ((Set.ncard {S ∈ C | (S ∩ ball G w v (D / α)).Nonempty} : ℕ) : ℝ) ≤ τ

/-- A hierarchy `C_0, …, C_k`: `C_0` singletons, `C_k = {V}`, each `C_{i+1}` coarsens `C_i`,
and `C_i` is a strong `(base · γ^i)`-diameter `(α, τ)`-sparse partition. -/
def IsSparseHierarchy {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (base γ α τ : ℝ)
    (k : ℕ) (C : ℕ → Set (Set V)) : Prop :=
  C 0 = singletonPartition ∧ C k = {Set.univ} ∧ (∀ i, i < k → Coarsens (C i) (C (i + 1))) ∧
    ∀ i, i ≤ k → IsStrongSparsePartition G w (C i) (base * γ ^ i) α τ

/-- Path decomposition `B_1, …, B_m`: bags cover all vertices, every edge lies in a bag, and
the bags containing a fixed vertex form an interval. -/
def IsPathDecomposition {V : Type} (G : SimpleGraph V) (m : ℕ) (B : Fin m → Set V) : Prop :=
  (∀ v, ∃ j, v ∈ B j) ∧ (∀ x y, G.Adj x y → ∃ j, x ∈ B j ∧ y ∈ B j) ∧
    ∀ (v : V) (i j l : Fin m), i ≤ j → j ≤ l → v ∈ B i → v ∈ B l → v ∈ B j

/-- Pathwidth at most `q`: a path decomposition with all bags of size `≤ q + 1`. -/
def PathwidthLE {V : Type} (G : SimpleGraph V) (q : ℕ) : Prop :=
  ∃ (m : ℕ) (B : Fin m → Set V), IsPathDecomposition G m B ∧
    ∀ j, (B j).Finite ∧ (B j).ncard ≤ q + 1

/-- Adjacency of the leaf-augmented graph on `V ⊕ V`: old edges, plus a pendant edge
`inl z — inr z` for each `z ∈ A` (copies `inr z` with `z ∉ A` are isolated). -/
def augRel {V : Type} (G : SimpleGraph V) (A : Set V) : V ⊕ V → V ⊕ V → Prop
  | Sum.inl x, Sum.inl y => G.Adj x y
  | Sum.inl x, Sum.inr z => x = z ∧ z ∈ A
  | Sum.inr _, _ => False

/-- The graph obtained from `G` by attaching one new leaf to each vertex of `A`. -/
def augGraph {V : Type} (G : SimpleGraph V) (A : Set V) : SimpleGraph (V ⊕ V) :=
  SimpleGraph.fromRel (augRel G A)

/-- Edge lengths of the augmented graph: the leaf at `z` has edge length `lam z`. -/
def augWeight {V : Type} (w : V → V → ℝ) (lam : V → ℝ) : V ⊕ V → V ⊕ V → ℝ
  | Sum.inl x, Sum.inl y => w x y
  | Sum.inl _, Sum.inr z => lam z
  | Sum.inr z, Sum.inl _ => lam z
  | Sum.inr _, Sum.inr _ => 0

/-- `min_{z ∈ A} (d_H(x, z) + λ(z))`. -/
def offsetDist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (A : Set V) (lam : V → ℝ)
    (x : V) : ℝ :=
  sInf ((fun z => gDist G w x z + lam z) '' A)

/-- Minimum-weight connected subgraph of `G` containing `S`, over finite edge sets `F` of `G`
(ordered pairs; duplicates only increase the weight). -/
def steinerCost {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (S : Set V) : ℝ :=
  sInf {c : ℝ | ∃ F : Finset (V × V), (∀ e ∈ F, G.Adj e.1 e.2) ∧
    (∀ x ∈ S, ∀ y ∈ S, (SimpleGraph.fromRel (fun a b => (a, b) ∈ F)).Reachable x y) ∧
    (∑ e ∈ F, w e.1 e.2) = c}

/-! ## Doubling-specific definitions -/

/-- "Every ball of radius `R` can be covered by at most `2^d` balls of radius `R/2` whose
centers lie in `V`." -/
def DoublingDimLE {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (d : ℝ) : Prop :=
  ∀ (v : V) (R : ℝ), ∃ F : Finset V, ((F.card : ℕ) : ℝ) ≤ (2 : ℝ) ^ d ∧
    ball G w v R ⊆ ⋃ u ∈ F, ball G w u (R / 2)

/-- `h(x) = ⌈log₂(2 + x)⌉`. -/
def hfun (x : ℝ) : ℝ :=
  ((⌈Real.logb 2 (2 + x)⌉₊ : ℕ) : ℝ)

/-- Leaves attached to the vertices of `X` (vertex type `V ⊕ X`, no isolated copies). -/
def leafRel {V : Type} (G : SimpleGraph V) (X : Set V) : V ⊕ X → V ⊕ X → Prop
  | Sum.inl x, Sum.inl y => G.Adj x y
  | Sum.inl x, Sum.inr z => x = z.1
  | Sum.inr _, _ => False

/-- The graph `G` with one pendant leaf at each vertex of `X`. -/
def leafGraph {V : Type} (G : SimpleGraph V) (X : Set V) : SimpleGraph (V ⊕ X) :=
  SimpleGraph.fromRel (leafRel G X)

/-- Edge lengths of `leafGraph`: the leaf at `z` has edge length `ℓ z`. -/
def leafWeight {V : Type} (w : V → V → ℝ) (X : Set V) (ℓ : V → ℝ) : V ⊕ X → V ⊕ X → ℝ
  | Sum.inl x, Sum.inl y => w x y
  | Sum.inl _, Sum.inr z => ℓ z.1
  | Sum.inr z, Sum.inl _ => ℓ z.1
  | Sum.inr _, Sum.inr _ => 0

/-! ## The three permitted facts -/

/-- Fact 1 (with parameter functions `a, t` and separation constant `c`): a nonempty
`X ⊆ V` and `θ_x ∈ (0, L]` with `f(v) ≤ L`,
`|{x ∈ X : dist(v,x) + θ_x ≤ f(v) + L/a(d)}| ≤ t(d)`, and `dist(x,y) ≥ cL` on `X`. -/
def Fact1 (c : ℝ) (a t : ℝ → ℝ) : Prop :=
  ∀ (W : Type) [Fintype W] (H : SimpleGraph W) (w : W → W → ℝ) (d : ℝ),
    1 ≤ d → H.Connected → IsWeighting H w → (∀ x y, H.Adj x y → 0 < w x y) →
    DoublingDimLE H w d → ∀ L : ℝ, 0 < L →
    ∃ (X : Set W) (θ : W → ℝ), X.Nonempty ∧ (∀ x ∈ X, 0 < θ x ∧ θ x ≤ L) ∧
      (∀ v : W, offsetDist H w X θ v ≤ L ∧
        ((Set.ncard {x ∈ X | gDist H w v x + θ x ≤ offsetDist H w X θ v + L / a d} : ℕ) : ℝ)
          ≤ t d) ∧
      ∀ x ∈ X, ∀ y ∈ X, x ≠ y → c * L ≤ gDist H w x y

/-- The block-assignment property of Fact 2 for given `σ, λ, b`. -/
def AssignProp (σ lam b : ℝ) : Prop :=
  ∀ (W : Type) [Fintype W] (H : SimpleGraph W) (w : W → W → ℝ) (D Δ : ℝ)
    (Q : Set (Set W)) (Z P : Set W),
    H.Connected → IsWeighting H w → (∀ x y, H.Adj x y → 0 < w x y) →
    1 ≤ D → DoublingDimLE H w D → 0 < Δ → IsPartition Q →
    (∀ B ∈ Q, StrongDiamLE H w B Δ) →
    (∀ B ∈ Q, (Z ∩ B).ncard = 1) →
    (∀ z ∈ Z, ∀ z' ∈ Z, z ≠ z' → σ * Δ / 3 ≤ gDist H w z z') →
    (∀ x : W, distToSet H w x P ≤ lam * D ^ 3 * hfun D * Δ) →
    (∀ p ∈ P, ∀ p' ∈ P, p ≠ p' → σ * (lam * D ^ 3 * hfun D * Δ) ≤ gDist H w p p') →
    (∀ p ∈ P, ({p} : Set W) ∈ Q) →
    ∃ f : W → W, (∀ x, f x ∈ P) ∧ (∀ B ∈ Q, ∀ x ∈ B, ∀ y ∈ B, f x = f y) ∧
      (∀ p ∈ P, f p = p) ∧
      ∀ x, InducedDistLE H w {y | f y = f x} x (f x)
        (distToSet H w x P + b * D ^ 2 * hfun D * Δ)

/-- Fact 2: for every `σ ∈ (0,1)` and `η > 0` there are `λ ≥ 2`, `b > 0` with `b/λ ≤ η`
for which the block-assignment property holds. -/
def Fact2 : Prop :=
  ∀ σ : ℝ, 0 < σ → σ < 1 → ∀ η : ℝ, 0 < η →
    ∃ lam b : ℝ, 2 ≤ lam ∧ 0 < b ∧ b / lam ≤ η ∧ AssignProp σ lam b

/-- Fact 3: a hierarchy with strong diameters `Δ₀γⁱ` and balls of radius `Δ₀γⁱ/A` meeting
`≤ t` blocks yields a spanning tree with `w(T[S]) ≤ C A² t² γ log n · OPT_G(S)`. -/
def Fact3 (C : ℝ) : Prop :=
  ∀ (W : Type) [Fintype W] (H : SimpleGraph W) (w : W → W → ℝ) (root : W)
    (A t γ Δ₀ : ℝ) (k : ℕ) (Q : ℕ → Set (Set W)),
    H.Connected → IsWeighting H w → (∀ x y, H.Adj x y → 0 < w x y) →
    1 ≤ A → 1 ≤ t → 2 ≤ γ → 0 < Δ₀ → IsSparseHierarchy H w Δ₀ γ A t k Q →
    ∃ T : SimpleGraph W, T ≤ H ∧ T.IsTree ∧ ∀ S : Set W, root ∈ S →
      steinerCost T w S ≤
        C * A ^ 2 * t ^ 2 * γ * Real.log (Fintype.card W) * steinerCost H w S

/-! ## Rubric lemmas -/

/-- Packing bound: `ρ`-separated points in a ball of radius `R` number at most
`max {1, (4R/ρ)^d}`. [OneTreeToRule, node_35] -/
theorem packing_bound {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ) (d : ℝ)
    (hconn : G.Connected) (hw : IsWeighting G w) (hpos : ∀ x y, G.Adj x y → 0 < w x y)
    (hd : 1 ≤ d) (hdd : DoublingDimLE G w d) (v : V) (R ρ : ℝ) (hρ : 0 < ρ) (Y : Set V)
    (hY : Y ⊆ ball G w v R) (hsep : ∀ x ∈ Y, ∀ y ∈ Y, x ≠ y → ρ ≤ gDist G w x y) :
    ((Y.ncard : ℕ) : ℝ) ≤ max 1 ((4 * R / ρ) ^ d) := by
  sorry

/-- Rubric 1: attaching leaves of length `≤ L` at `σL`-separated vertices keeps the doubling
dimension `O(d)`, with a factor depending only on `σ`. [OneTreeToRule, node_35] -/
theorem leafGraph_doubling (σ : ℝ) (hσ0 : 0 < σ) (hσ1 : σ < 1) :
    ∃ K : ℝ, 0 < K ∧ ∀ (V : Type) [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ) (d L : ℝ)
      (X : Set V) (ℓ : V → ℝ), G.Connected → IsWeighting G w →
      (∀ x y, G.Adj x y → 0 < w x y) → 1 ≤ d → DoublingDimLE G w d → 0 < L →
      (∀ z ∈ X, 0 < ℓ z ∧ ℓ z ≤ L) →
      (∀ x ∈ X, ∀ y ∈ X, x ≠ y → σ * L ≤ gDist G w x y) →
      DoublingDimLE (leafGraph G X) (leafWeight w X ℓ) (K * d) := by
  sorry

/-- Rubrics 3–5: a hierarchy with `A = O(d)`, `t = Õ(d)`, `γ = Õ(d³)` exists. [OneTreeToRule, node_35] -/
theorem doubling_hierarchy (c Ca Ct : ℝ) (q : ℕ) (a t : ℝ → ℝ) (hc0 : 0 < c) (hc1 : c < 1)
    (ha : ∀ d, 1 ≤ d → 1 ≤ a d ∧ a d ≤ Ca * d)
    (ht : ∀ d, 1 ≤ d → t d ≤ Ct * d * hfun d ^ q)
    (h1 : Fact1 c a t) (h2 : Fact2) :
    ∃ (KA Kt Kγ : ℝ) (e : ℕ), ∀ (V : Type) [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
      (d : ℝ), G.Connected → IsWeighting G w → (∀ x y, G.Adj x y → 0 < w x y) → 1 ≤ d →
      DoublingDimLE G w d →
      ∃ (A τ γ Δ₀ : ℝ) (k : ℕ) (Q : ℕ → Set (Set V)),
        1 ≤ A ∧ 1 ≤ τ ∧ 2 ≤ γ ∧ 0 < Δ₀ ∧
        A ≤ KA * d ∧ τ ≤ Kt * d * hfun d ^ e ∧ γ ≤ Kγ * d ^ 3 * hfun d ^ e ∧
        IsSparseHierarchy G w Δ₀ γ A τ k Q := by
  sorry

/-! ## Main theorem -/

/-- A universal Steiner tree with stretch `Õ(d⁷) · log n` for graphs of doubling dimension
at most `d`. [OneTreeToRule, node_35] -/
theorem universal_steiner_tree_doubling (c Ca Ct : ℝ) (q : ℕ) (a t : ℝ → ℝ) (C : ℝ)
    (hc0 : 0 < c) (hc1 : c < 1)
    (ha : ∀ d, 1 ≤ d → 1 ≤ a d ∧ a d ≤ Ca * d)
    (ht : ∀ d, 1 ≤ d → t d ≤ Ct * d * hfun d ^ q)
    (h1 : Fact1 c a t) (h2 : Fact2) (h3 : Fact3 C) :
    ∃ (K : ℝ) (e : ℕ), ∀ (V : Type) [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ) (r : V)
      (d : ℝ), 2 ≤ Fintype.card V → G.Connected → IsWeighting G w →
      (∀ x y, G.Adj x y → 0 < w x y) → 1 ≤ d → DoublingDimLE G w d →
      ∃ T : SimpleGraph V, T ≤ G ∧ T.IsTree ∧ ∀ S : Set V, r ∈ S →
        steinerCost T w S ≤
          K * d ^ 7 * hfun d ^ e * Real.log (Fintype.card V) * steinerCost G w S := by
  sorry

