/-!
## A universal Steiner tree with stretch `O(p⁸ log n)` for pathwidth-`p` graphs

Given a connected graph `G` of pathwidth `p` with nonnegative edge weights and a root `r`,
there is a spanning tree `T` of `G` with `w(T[S]) ≤ C p⁸ log n · OPT_G(S)` for every `S ∋ r`,
assuming the leaf-attachment fact (i), the whole-part assignment fact (ii) and the
hierarchy-to-tree extraction fact (iii).

Main theorem: `universal_steiner_tree_pathwidth`.
-/

namespace TCSChallenge.OneTreeToRuleThemAll.node_32

/-! ## Shared definitions (identical in the three files of this paper) -/

/-- Edge lengths: nonnegative and symmetric on edges. -/
def IsWeighting {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) : Prop :=
  ∀ x y, G.Adj x y → 0 ≤ w x y ∧ w x y = w y x

/-- A walk `p 0, …, p k` all of whose vertices lie in `S` and consecutive vertices adjacent. -/
def IsWalkIn {V : Type} (G : SimpleGraph V) (S : Set V) {k : ℕ} (p : Fin (k + 1) → V) :
    Prop :=
  (∀ i, p i ∈ S) ∧ ∀ i : Fin k, G.Adj (p i.castSucc) (p i.succ)

/-- Length of a walk. -/
def walkLength {V : Type} (w : V → V → ℝ) {k : ℕ} (p : Fin (k + 1) → V) : ℝ :=
  ∑ i : Fin k, w (p i.castSucc) (p i.succ)

/-- `d_{G[S]}(x, y) ≤ r`: some walk from `x` to `y` inside `S` has length at most `r`.
(This is false when an endpoint is absent from `S` or no path exists: the `+∞` convention.) -/
def InducedDistLE {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (S : Set V) (x y : V)
    (r : ℝ) : Prop :=
  ∃ (k : ℕ) (p : Fin (k + 1) → V), IsWalkIn G S p ∧ p 0 = x ∧ p (Fin.last k) = y ∧
    walkLength w p ≤ r

/-- Shortest-path distance `d_G(x, y)` (used only on connected graphs). -/
def gDist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (x y : V) : ℝ :=
  sInf {r : ℝ | InducedDistLE G w Set.univ x y r}

/-- `d_G(x, P) = min_{t ∈ P} d_G(x, t)`. -/
def distToSet {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (x : V) (P : Set V) : ℝ :=
  sInf ((fun z => gDist G w x z) '' P)

/-- `B_G(v, R) = {x : d_G(v, x) ≤ R}`. -/
def ball {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (v : V) (R : ℝ) : Set V :=
  {x | gDist G w v x ≤ R}

/-- "`S` has diameter at most `D` in `G[S]`" (strong diameter). -/
def StrongDiamLE {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (S : Set V) (D : ℝ) :
    Prop :=
  ∀ x ∈ S, ∀ y ∈ S, InducedDistLE G w S x y D

/-- A partition of `V` into nonempty pairwise disjoint parts. -/
def IsPartition {V : Type} (C : Set (Set V)) : Prop :=
  (∀ S ∈ C, S.Nonempty) ∧ (∀ S ∈ C, ∀ T ∈ C, S ≠ T → Disjoint S T) ∧ ∀ x, ∃ S ∈ C, x ∈ S

/-- The singleton partition. -/
def singletonPartition {V : Type} : Set (Set V) :=
  {S | ∃ x, S = {x}}

/-- `C'` coarsens `C`: every part of `C` lies inside a part of `C'`. -/
def Coarsens {V : Type} (C C' : Set (Set V)) : Prop :=
  ∀ S ∈ C, ∃ T ∈ C', S ⊆ T

/-- "A strong `D`-diameter `(α, τ)`-sparse partition: every `S ∈ C` has diameter at most `D`
in `G[S]` and every ball `B_G(v, D/α)` intersects at most `τ` members of `C`." -/
def IsStrongSparsePartition {V : Type} (G : SimpleGraph V) (w : V → V → ℝ)
    (C : Set (Set V)) (D α τ : ℝ) : Prop :=
  IsPartition C ∧ (∀ S ∈ C, StrongDiamLE G w S D) ∧
    ∀ v : V, ((Set.ncard {S ∈ C | (S ∩ ball G w v (D / α)).Nonempty} : ℕ) : ℝ) ≤ τ

/-- A hierarchy `C_0, …, C_k`: `C_0` singletons, `C_k = {V}`, each `C_{i+1}` coarsens `C_i`,
and `C_i` is a strong `(base · γ^i)`-diameter `(α, τ)`-sparse partition. -/
def IsSparseHierarchy {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (base γ α τ : ℝ)
    (k : ℕ) (C : ℕ → Set (Set V)) : Prop :=
  C 0 = singletonPartition ∧ C k = {Set.univ} ∧ (∀ i, i < k → Coarsens (C i) (C (i + 1))) ∧
    ∀ i, i ≤ k → IsStrongSparsePartition G w (C i) (base * γ ^ i) α τ

/-- Path decomposition `B_1, …, B_m`: bags cover all vertices, every edge lies in a bag, and
the bags containing a fixed vertex form an interval. -/
def IsPathDecomposition {V : Type} (G : SimpleGraph V) (m : ℕ) (B : Fin m → Set V) : Prop :=
  (∀ v, ∃ j, v ∈ B j) ∧ (∀ x y, G.Adj x y → ∃ j, x ∈ B j ∧ y ∈ B j) ∧
    ∀ (v : V) (i j l : Fin m), i ≤ j → j ≤ l → v ∈ B i → v ∈ B l → v ∈ B j

/-- Pathwidth at most `q`: a path decomposition with all bags of size `≤ q + 1`. -/
def PathwidthLE {V : Type} (G : SimpleGraph V) (q : ℕ) : Prop :=
  ∃ (m : ℕ) (B : Fin m → Set V), IsPathDecomposition G m B ∧
    ∀ j, (B j).Finite ∧ (B j).ncard ≤ q + 1

/-- Adjacency of the leaf-augmented graph on `V ⊕ V`: old edges, plus a pendant edge
`inl z — inr z` for each `z ∈ A` (copies `inr z` with `z ∉ A` are isolated). -/
def augRel {V : Type} (G : SimpleGraph V) (A : Set V) : V ⊕ V → V ⊕ V → Prop
  | Sum.inl x, Sum.inl y => G.Adj x y
  | Sum.inl x, Sum.inr z => x = z ∧ z ∈ A
  | Sum.inr _, _ => False

/-- The graph obtained from `G` by attaching one new leaf to each vertex of `A`. -/
def augGraph {V : Type} (G : SimpleGraph V) (A : Set V) : SimpleGraph (V ⊕ V) :=
  SimpleGraph.fromRel (augRel G A)

/-- Edge lengths of the augmented graph: the leaf at `z` has edge length `lam z`. -/
def augWeight {V : Type} (w : V → V → ℝ) (lam : V → ℝ) : V ⊕ V → V ⊕ V → ℝ
  | Sum.inl x, Sum.inl y => w x y
  | Sum.inl _, Sum.inr z => lam z
  | Sum.inr z, Sum.inl _ => lam z
  | Sum.inr _, Sum.inr _ => 0

/-- `min_{z ∈ A} (d_H(x, z) + λ(z))`. -/
def offsetDist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (A : Set V) (lam : V → ℝ)
    (x : V) : ℝ :=
  sInf ((fun z => gDist G w x z + lam z) '' A)

/-- Minimum-weight connected subgraph of `G` containing `S`, over finite edge sets `F` of `G`
(ordered pairs; duplicates only increase the weight). -/
def steinerCost {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (S : Set V) : ℝ :=
  sInf {c : ℝ | ∃ F : Finset (V × V), (∀ e ∈ F, G.Adj e.1 e.2) ∧
    (∀ x ∈ S, ∀ y ∈ S, (SimpleGraph.fromRel (fun a b => (a, b) ∈ F)).Reachable x y) ∧
    (∑ e ∈ F, w e.1 e.2) = c}

/-! ## The three permitted facts -/

/-- Fact (i): for every `D > 0` there are a nonempty `Z` and `a_z ≥ 0` with `m(v) ≤ D` and
`|{z ∈ Z : d_H(v,z) + a_z ≤ m(v) + D/[c(q+1)]}| ≤ c(q+1)²`. -/
def FactLeaf (c : ℕ) : Prop :=
  ∀ (W : Type) [Fintype W] (H : SimpleGraph W) (w : W → W → ℝ) (q : ℕ),
    H.Connected → IsWeighting H w → PathwidthLE H q → ∀ D : ℝ, 0 < D →
    ∃ (Z : Set W) (a : W → ℝ), Z.Nonempty ∧ (∀ z ∈ Z, 0 ≤ a z) ∧
      ∀ v : W, offsetDist H w Z a v ≤ D ∧
        ((Set.ncard {z ∈ Z | gDist H w v z + a z ≤
            offsetDist H w Z a v + D / ((c : ℝ) * ((q : ℝ) + 1))} : ℕ) : ℝ) ≤
          (c : ℝ) * ((q : ℝ) + 1) ^ 2

/-- Fact (ii): whole-part assignment `f : Q → P` with
`d_{H[X_{f(v)}]}(v, f(v)) ≤ d_H(v, P) + 8(q+1)δ`. -/
def FactAssign : Prop :=
  ∀ (W : Type) [Fintype W] (H : SimpleGraph W) (w : W → W → ℝ) (q : ℕ),
    H.Connected → IsWeighting H w → PathwidthLE H q →
    ∀ (δ : ℝ) (Q : Set (Set W)), 0 < δ → IsPartition Q → (∀ S ∈ Q, StrongDiamLE H w S δ) →
    ∀ P : Set W, P.Nonempty →
    ∃ f : W → W, (∀ x, f x ∈ P) ∧ (∀ S ∈ Q, ∀ x ∈ S, ∀ y ∈ S, f x = f y) ∧
      ∀ v, InducedDistLE H w {y | f y = f v} v (f v)
        (distToSet H w v P + 8 * ((q : ℝ) + 1) * δ)

/-- Fact (iii): a hierarchy with strong diameters `λγⁱ` and balls `B(v, λγⁱ/A)` meeting `≤ t`
parts yields a spanning tree `U` with `w(U[S]) ≤ C₀ A² t² γ log|V(H)| · OPT_H(S)`. -/
def FactTree (C₀ : ℝ) : Prop :=
  ∀ (W : Type) [Fintype W] (H : SimpleGraph W) (w : W → W → ℝ) (root : W)
    (lam A t γ : ℝ) (k : ℕ) (P : ℕ → Set (Set W)),
    H.Connected → IsWeighting H w → 0 < lam → 0 < A → 0 < t → 2 ≤ γ →
    IsSparseHierarchy H w lam γ A t k P →
    ∃ U : SimpleGraph W, U ≤ H ∧ U.IsTree ∧ ∀ S : Set W, root ∈ S →
      steinerCost U w S ≤
        C₀ * A ^ 2 * t ^ 2 * γ * Real.log (Fintype.card W) * steinerCost H w S

/-! ## Rubric lemmas -/

/-- Rubric 1: attaching leaves increases pathwidth by at most one. [OneTreeToRule, node_32] -/
theorem augGraph_pathwidth {V : Type} [Fintype V] (G : SimpleGraph V) (A : Set V) (p : ℕ)
    (hpw : PathwidthLE G p) : PathwidthLE (augGraph G A) (p + 1) := by
  sorry

/-- Rubrics 2–3: the coarsening step for positive weights. With `a = c(p+1)`,
`t = c(p+1)²`, `β = 8(p+2)`, `A = 8a + 4`, `γ = 2β(2a+1)`, any partition with strong
diameters `≤ s` has a coarsening that is a strong `γs`-diameter `(A, t)`-sparse partition. [OneTreeToRule, node_32] -/
theorem coarsening_step (c : ℕ) (hc : 1 ≤ c) (hI : FactLeaf c) (hII : FactAssign)
    {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ) (p : ℕ) (hp : 1 ≤ p)
    (hconn : G.Connected) (hw : IsWeighting G w) (hpos : ∀ x y, G.Adj x y → 0 < w x y)
    (hpw : PathwidthLE G p) (Q : Set (Set V)) (s : ℝ) (hs : 0 < s) (hQ : IsPartition Q)
    (hdiam : ∀ S ∈ Q, StrongDiamLE G w S s) :
    ∃ Q' : Set (Set V), Coarsens Q Q' ∧
      IsStrongSparsePartition G w Q'
        (2 * (8 * ((p : ℝ) + 2)) * (2 * ((c : ℝ) * ((p : ℝ) + 1)) + 1) * s)
        (8 * ((c : ℝ) * ((p : ℝ) + 1)) + 4) ((c : ℝ) * ((p : ℝ) + 1) ^ 2) := by
  sorry

/-- Rubric 4: for positive weights, a complete hierarchy exists with the parameters above. [OneTreeToRule, node_32] -/
theorem hierarchy_positive (c : ℕ) (hc : 1 ≤ c) (hI : FactLeaf c) (hII : FactAssign)
    {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ) (p : ℕ) (hp : 1 ≤ p)
    (hconn : G.Connected) (hw : IsWeighting G w) (hpos : ∀ x y, G.Adj x y → 0 < w x y)
    (hpw : PathwidthLE G p) :
    ∃ (lam : ℝ) (k : ℕ) (P : ℕ → Set (Set V)), 0 < lam ∧
      IsSparseHierarchy G w lam
        (2 * (8 * ((p : ℝ) + 2)) * (2 * ((c : ℝ) * ((p : ℝ) + 1)) + 1))
        (8 * ((c : ℝ) * ((p : ℝ) + 1)) + 4) ((c : ℝ) * ((p : ℝ) + 1) ^ 2) k P := by
  sorry

/-! ## Main theorem -/

/-- A universal Steiner tree with stretch `C p⁸ log n` for graphs of pathwidth `p`. [OneTreeToRule, node_32] -/
theorem universal_steiner_tree_pathwidth (c : ℕ) (C₀ : ℝ) (hc : 1 ≤ c)
    (hI : FactLeaf c) (hII : FactAssign) (hIII : FactTree C₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ (V : Type) [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ) (r : V)
      (p : ℕ), 2 ≤ Fintype.card V → G.Connected → IsWeighting G w → PathwidthLE G p →
      ∃ T : SimpleGraph V, T ≤ G ∧ T.IsTree ∧ ∀ S : Set V, r ∈ S →
        steinerCost T w S ≤
          C * (p : ℝ) ^ 8 * Real.log (Fintype.card V) * steinerCost G w S := by
  sorry

end TCSChallenge.OneTreeToRuleThemAll.node_32
