/-!
## Cardinal complexity of the game of googol

A set `S = {s₁ < ⋯ < sₙ}` of distinct positive integers arrives in a uniformly random order;
an algorithm accepts at most one arrival irrevocably and wins iff it accepts `sₙ`. Ordinal
algorithms see only relative ranks; `p_n` (`pOrd n`) is the optimal ordinal winning probability.
The main theorem `cardinal_complexity_upper_bound` states that for some absolute constant `C`,
for all `n ≥ 2` and `0 < ε < 1` there is a distribution over increasing `n`-tuples of values in
`[N]`, `N ≤ C (n/ε)^n`, under which every cardinal algorithm wins with probability at most
`(1+ε) p_n`.

The supplied level-information model is formalized (`LevelAlg`, `levelWinProb`) and its
optimality enters as the hypothesis `LevelModelFact n`. The lemma stubs follow the reference
plan: smooth sin² gap laws at scales `B^i`, a translation (Hellinger) estimate, an online
simulation of any cardinal algorithm by a level algorithm with additive loss `O(√n / B)`,
and the range bound `∑_{i<n} B^i ≤ 2 B^{n-1}`.
-/

namespace TCSChallenge.OnlineOrdinalProblemsOptimality.node_27

open Finset

/-- Embedding of the first `t+1` arrival times into `Fin n`. -/
def emb {n : ℕ} (t : Fin n) : Fin (t.val + 1) → Fin n :=
  Fin.castLE (Nat.succ_le_of_lt t.isLt)

/-- The algorithm stops (accepts) at time `t`: it says yes at `t` and no at every earlier time. -/
def StopsAt {n : ℕ} (obs : Fin n → Bool) (t : Fin n) : Prop :=
  obs t = true ∧ ∀ t' : Fin n, t' < t → obs t' = false

/-! ## Cardinal algorithms -/

/-- "A cardinal algorithm observes numerical values": a deterministic stopping rule that, after
`k+1` arrivals, sees the numerical values of these arrivals (in arrival order) and decides
whether to accept the current one. -/
abbrev CardAlg : Type := (k : ℕ) → (Fin (k + 1) → ℕ) → Bool

/-- Numerical values of the first `t+1` arrivals. An instance is an increasing tuple
`s : Fin n → Fin N` (value `s r + 1 ∈ [N]` is the element of final rank `r`), and arrival time
`u` carries final rank `σ u`. -/
def cardPrefix {n N : ℕ} (s : Fin n → Fin N) (σ : Equiv.Perm (Fin n)) (t : Fin n) :
    Fin (t.val + 1) → ℕ :=
  fun i => (s (σ (emb t i))).val + 1

/-- The cardinal algorithm wins: it accepts the maximum value `sₙ`. -/
def cardWins {n N : ℕ} (A : CardAlg) (s : Fin n → Fin N) (σ : Equiv.Perm (Fin n)) : Prop :=
  ∃ t : Fin n, StopsAt (fun u => A u.val (cardPrefix s σ u)) t ∧ ∀ j, s j ≤ s (σ t)

/-- "A distribution `F` over `n`-element subsets of `[N]`": probability weights on increasing
tuples (an increasing tuple is the sorted listing of an `n`-subset). -/
def IsInstanceDist {n N : ℕ} (w : (Fin n → Fin N) → ℝ) : Prop :=
  (∀ s, 0 ≤ w s) ∧ ∑ s, w s = 1 ∧ ∀ s, w s ≠ 0 → StrictMono s

/-- Winning probability of a cardinal algorithm when the instance is drawn from `w` and,
independently, the arrival order is uniform. -/
def cardWinProb {n N : ℕ} (w : (Fin n → Fin N) → ℝ) (A : CardAlg) : ℝ :=
  ∑ s, ∑ σ : Equiv.Perm (Fin n),
    w s / (n.factorial : ℝ) * (if cardWins A s σ then 1 else 0)

/-! ## Ordinal algorithms and `p_n` -/

/-- "An ordinal algorithm observes only relative ranks": after `k+1` arrivals it sees the
comparison relation among them. -/
abbrev OrdAlg : Type := (k : ℕ) → (Fin (k + 1) → Fin (k + 1) → Bool) → Bool

/-- Relative ranking `π^t` of the first `t+1` arrivals (`i j ↦ [arrival i ranks below j]`). -/
def ordPrefix {n : ℕ} (σ : Equiv.Perm (Fin n)) (t : Fin n) :
    Fin (t.val + 1) → Fin (t.val + 1) → Bool :=
  fun i j => decide (σ (emb t i) < σ (emb t j))

/-- The ordinal algorithm accepts the arrival of top final rank. -/
def ordWins {n : ℕ} (A : OrdAlg) (σ : Equiv.Perm (Fin n)) : Prop :=
  ∃ t : Fin n, StopsAt (fun u => A u.val (ordPrefix σ u)) t ∧ ∀ j, j ≤ σ t

/-- Winning probability of an ordinal algorithm under a uniformly random arrival order. -/
def ordWinProb (n : ℕ) (A : OrdAlg) : ℝ :=
  ∑ σ : Equiv.Perm (Fin n), (1 / (n.factorial : ℝ)) * (if ordWins A σ then 1 else 0)

/-- `p_n`, the optimal ordinal winning probability (a supremum of values in `[0,1]`). -/
def pOrd (n : ℕ) : ℝ := ⨆ A : OrdAlg, ordWinProb n A

/-! ## The level-information model (supplied) -/

/-- Level of arrival `t'` as observed after arrival `k` (zero if `t'` has not arrived):
`ρ^k_j = max_{i_{j-1} < a ≤ i_j} ρ_a` where `i_j = σ t'` and `i_{j-1}` is the largest revealed
rank below it. Gap `r` (0-indexed) is the gap directly below final rank `r`; levels are reported
1-indexed as `(ρ r).val + 1 ∈ {1,…,n}`. -/
def levelObs {n : ℕ} (σ ρ : Equiv.Perm (Fin n)) (k t' : Fin n) : ℕ :=
  if t' ≤ k then
    (univ.filter (fun r : Fin n => r ≤ σ t' ∧
        ∀ u : Fin n, u ≤ k → ¬ (r ≤ σ u ∧ σ u < σ t'))).sup (fun r => (ρ r).val + 1)
  else 0

/-- Full level-observation history up to time `t`: entry `(a, b)` is the level of arrival `b`
as seen after arrival `a`. -/
def levelHist {n : ℕ} (σ ρ : Equiv.Perm (Fin n)) (t : Fin n) :
    Fin (t.val + 1) → Fin (t.val + 1) → ℕ :=
  fun a b => levelObs σ ρ (emb t a) (emb t b)

/-- A level algorithm: sees relative ranks and the entire level-observation history. -/
abbrev LevelAlg : Type :=
  (k : ℕ) → (Fin (k + 1) → Fin (k + 1) → Bool) → (Fin (k + 1) → Fin (k + 1) → ℕ) → Bool

/-- The level algorithm accepts the arrival of final rank `n`. -/
def levelWins {n : ℕ} (A : LevelAlg) (ρ σ : Equiv.Perm (Fin n)) : Prop :=
  ∃ t : Fin n, StopsAt (fun u => A u.val (ordPrefix σ u) (levelHist σ ρ u)) t ∧
    ∀ j, j ≤ σ t

/-- "A distribution `F^lev` over permutations `ρ` of `{1,…,n}` with `ρ₁ = n`". -/
def IsLevelDist {n : ℕ} (wl : Equiv.Perm (Fin n) → ℝ) : Prop :=
  (∀ ρ, 0 ≤ wl ρ) ∧ ∑ ρ, wl ρ = 1 ∧
    ∀ ρ, wl ρ ≠ 0 → ∀ r : Fin n, r.val = 0 → (ρ r).val + 1 = n

/-- Winning probability of a level algorithm (`ρ ∼ wl`, independent uniform `σ`). -/
def levelWinProb {n : ℕ} (wl : Equiv.Perm (Fin n) → ℝ) (A : LevelAlg) : ℝ :=
  ∑ ρ, ∑ σ : Equiv.Perm (Fin n),
    wl ρ / (n.factorial : ℝ) * (if levelWins A ρ σ then 1 else 0)

/-- Supplied fact (used without proof): some level distribution makes every level algorithm
win with probability at most `p_n`. -/
def LevelModelFact (n : ℕ) : Prop :=
  ∃ wl : Equiv.Perm (Fin n) → ℝ, IsLevelDist wl ∧ ∀ A : LevelAlg, levelWinProb wl A ≤ pOrd n

/-! ## The hard distribution: smooth multiscale gaps -/

/-- Smooth gap law at scale `M`:
`L(a) = 2/(M+1) · sin²(π a/(M+1))` for `1 ≤ a ≤ M`, zero elsewhere. -/
def gapLaw (M : ℕ) (a : ℤ) : ℝ :=
  if 1 ≤ a ∧ a ≤ (M : ℤ) then
    2 / ((M : ℝ) + 1) * Real.sin (Real.pi * (a : ℝ) / ((M : ℝ) + 1)) ^ 2
  else 0

/-- Squared Hellinger distance between `L_M` and its translate by `h`. -/
def hellSq (M : ℕ) (h : ℤ) : ℝ :=
  1 - ∑ a ∈ Finset.Icc (1 : ℤ) (M : ℤ), Real.sqrt (gapLaw M a * gapLaw M (a - h))

/-- Value range `N_B = ∑_{i<n} B^i` (sum of all scales). -/
def hardRange (n B : ℕ) : ℕ := ∑ i ∈ Finset.range n, B ^ i

/-- Gap below final rank `r` in a tuple (values shifted to `[N]`, with `s₀ = 0`). -/
def gapOf {n N : ℕ} (s : Fin n → Fin N) (r : Fin n) : ℤ :=
  ((s r).val : ℤ) + 1 -
    (if 0 < r.val then ((s ⟨r.val - 1, lt_of_le_of_lt (Nat.sub_le _ _) r.isLt⟩).val : ℤ) + 1
     else 0)

/-- The hard instance distribution: draw `ρ ∼ wl`, then independent gaps, the gap below rank
`r` drawn from the smooth law at scale `B^{level - 1} = B^{(ρ r).val}`. -/
def hardDist (n B : ℕ) (wl : Equiv.Perm (Fin n) → ℝ) :
    (Fin n → Fin (hardRange n B)) → ℝ :=
  fun s => ∑ ρ, wl ρ * ∏ r, gapLaw (B ^ (ρ r).val) (gapOf s r)

/-! ## Lemma stubs -/

/-- Supplied bound `p_n ≥ 1/4`. [OnlineOrdinalProblemsOptimality, node_27] -/
theorem pOrd_ge_quarter (n : ℕ) (hn : 2 ≤ n) : (1 : ℝ) / 4 ≤ pOrd n := by
  sorry

/-- The smooth gap law is a probability law on `{1,…,M}`. [OnlineOrdinalProblemsOptimality, node_27] -/
theorem gapLaw_sum (M : ℕ) (hM : 1 ≤ M) :
    ∑ a ∈ Finset.Icc (1 : ℤ) (M : ℤ), gapLaw M a = 1 := by
  sorry

/-- The hard distribution is a legal instance distribution on `[N_B]`. [OnlineOrdinalProblemsOptimality, node_27] -/
theorem hardDist_isInstanceDist (n B : ℕ) (hn : 2 ≤ n) (hB : 2 ≤ B)
    (wl : Equiv.Perm (Fin n) → ℝ) (hwl : IsLevelDist wl) :
    IsInstanceDist (hardDist n B wl) := by
  sorry

/-- Translation lemma: shifting `L_M` by an integer `h` with `|h| ≤ M/(B-1)` costs squared
Hellinger distance `O(B^{-2})`, with an absolute constant. [OnlineOrdinalProblemsOptimality, node_27] -/
theorem gapLaw_translation :
    ∃ c : ℝ, 0 < c ∧ ∀ (M B : ℕ) (h : ℤ), 3 ≤ B → 1 ≤ M →
      |h| * ((B : ℤ) - 1) ≤ (M : ℤ) → hellSq M h ≤ c / (B : ℝ) ^ 2 := by
  sorry

/-- Simulation/comparison lemma: every cardinal algorithm facing the hard distribution is
matched, up to additive loss `c₀ √n / B`, by a (deterministic) level algorithm facing the
level model (online seed-based realization, joint instance–order law within total variation
`O(√n/B)`, legal fallback on failure, derandomization by averaging). [OnlineOrdinalProblemsOptimality, node_27] -/
theorem simulation_comparison :
    ∃ c₀ : ℝ, 0 < c₀ ∧ ∀ (n B : ℕ), 2 ≤ n → 3 ≤ B →
      ∀ wl : Equiv.Perm (Fin n) → ℝ, IsLevelDist wl →
        ∀ A : CardAlg, ∃ A' : LevelAlg,
          cardWinProb (hardDist n B wl) A ≤ levelWinProb wl A' + c₀ * Real.sqrt n / B := by
  sorry

/-- Range bound: `∑_{i<n} B^i ≤ 2 B^{n-1}` for `B ≥ 2`. [OnlineOrdinalProblemsOptimality, node_27] -/
theorem hardRange_le (n B : ℕ) (hn : 1 ≤ n) (hB : 2 ≤ B) :
    (hardRange n B : ℝ) ≤ 2 * (B : ℝ) ^ (n - 1) := by
  sorry

/-! ## Main theorem -/

/-- Cardinal complexity `N = O((n/ε)^n)`: with an absolute constant `C` (independent of `n`
and `ε`), for every `n ≥ 2` and `0 < ε < 1` there is a distribution over `n`-subsets of
`[N]`, `N ≤ C (n/ε)^n`, under which every cardinal algorithm wins with probability at most
`(1+ε) p_n`. [OnlineOrdinalProblemsOptimality, node_27] -/
theorem cardinal_complexity_upper_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, 2 ≤ n → LevelModelFact n →
      ∀ ε : ℝ, 0 < ε → ε < 1 →
        ∃ N : ℕ, (N : ℝ) ≤ C * ((n : ℝ) / ε) ^ n ∧
          ∃ w : (Fin n → Fin N) → ℝ, IsInstanceDist w ∧
            ∀ A : CardAlg, cardWinProb w A ≤ (1 + ε) * pOrd n := by
  sorry

end TCSChallenge.OnlineOrdinalProblemsOptimality.node_27
