/-!
## Level information does not help the secretary against the stationary level distribution

`Ω_n` is the set of permutations `r` of `[n]` with `r_1 = n`. The chain picks one of the
`n - 1` adjacent pairs uniformly and moves the smaller entry of the pair to the right end.
With `ρ` stationary and `π` an independent uniform arrival order, an observer sees at round
`k` the relative ranks `R^k` of the arrived labels and the level vector `L^k` (block maxima
of `ρ` between consecutive arrived labels). Main theorem `level_secretary`:
`W_lev(n) = W_ord(n)` and `Pr(π(k) = n | L^k = μ, R^k = σ) = k / n` whenever the current
element is a record (`σ(k) = k`) and the conditioning event has positive probability.
-/

namespace TCSChallenge.OnlineOrdinalProblemsOptimality.node_26

/-- `Ω_n`: injective `r : Fin n → Fin n` (a permutation of `[n]`) with `r_1 = n`. -/
def IsLevelState (n : ℕ) (r : Fin n → Fin n) : Prop :=
  Function.Injective r ∧ ∀ i : Fin n, i.val = 0 → (r i).val = n - 1

/-- The chain update for the adjacent pair `(j, j+1)`: the smaller of `r_j, r_{j+1}`, at
position `p`, is moved to the right end; other entries keep their relative order. For
`j = n - 1` (no pair) it is the identity, but that `j` is never selected. -/
def moveStep {n : ℕ} (r : Fin n → Fin n) (j : Fin n) : Fin n → Fin n :=
  if h : j.val + 1 < n then
    let j' : Fin n := ⟨j.val + 1, h⟩
    let p : Fin n := if r j < r j' then j else j'
    fun i => if i.val < p.val then r i
      else if h2 : i.val + 1 < n then r ⟨i.val + 1, h2⟩ else r p
  else r

/-- Transition probability: the adjacent pair is chosen uniformly among the `n - 1` pairs. -/
def kernel {n : ℕ} (r y : Fin n → Fin n) : ℝ :=
  ((Finset.univ.filter (fun j : Fin n => j.val + 1 < n ∧ moveStep r j = y)).card : ℝ) /
    ((n : ℝ) - 1)

/-- `F^lev`: a stationary probability vector of the chain, supported on `Ω_n`. -/
def IsStationaryLevelDist (n : ℕ) (p : (Fin n → Fin n) → ℝ) : Prop :=
  (∀ r, 0 ≤ p r) ∧ ∑ r, p r = 1 ∧ (∀ r, p r ≠ 0 → IsLevelState n r) ∧
    ∀ y, p y = ∑ r, p r * kernel r y

/-- Labels arrived up to round `t` (inclusive): `{π(0), …, π(t)}`. -/
def arrived {n : ℕ} (π : Equiv.Perm (Fin n)) (t : Fin n) : Finset (Fin n) :=
  (Finset.univ.filter (fun u : Fin n => u ≤ t)).image π

/-- `R^k` padded: `R^k(u) = 1 + |{w ≤ t : π w < π u}|` for `u ≤ t`, and `0` otherwise. -/
def relRank {n : ℕ} (π : Equiv.Perm (Fin n)) (t : Fin n) : Fin n → ℕ :=
  fun u => if u ≤ t then 1 + (Finset.univ.filter (fun w : Fin n => w ≤ t ∧ π w < π u)).card
    else 0

/-- For an arrived label `c` of the arrived set `S`, the block maximum
`max {ρ_b : (previous arrived label) < b ≤ c}` (values `ρ_b ∈ [n]`, shifted by one). -/
def blockMax {n : ℕ} (ρ : Fin n → Fin n) (S : Finset (Fin n)) (c : Fin n) : ℕ :=
  (Finset.univ.filter (fun b : Fin n => b ≤ c ∧ ∀ c' ∈ S, c' < c → c' < b)).sup
    (fun b => (ρ b).val + 1)

/-- `L^k` padded: entry `a` is the block maximum of the `a`-th smallest arrived label
(`L^k_{a+1}` in the paper), `0` if `a ≥ k`. It does not reveal absolute labels. -/
def levelVec {n : ℕ} (ρ : Fin n → Fin n) (π : Equiv.Perm (Fin n)) (t : Fin n) : Fin n → ℕ :=
  fun a =>
    ((arrived π t).filter (fun c => ((arrived π t).filter (· < c)).card = a.val)).sup
      (blockMax ρ (arrived π t))

/-- Level-information history at round `t`: `(R^s, L^s)` for `s ≤ t`, padded with zeros. -/
def levHist {n : ℕ} (ρ : Fin n → Fin n) (π : Equiv.Perm (Fin n)) (t : Fin n) :
    Fin n → (Fin n → ℕ) × (Fin n → ℕ) :=
  fun s => if s ≤ t then (relRank π s, levelVec ρ π s) else (fun _ => 0, fun _ => 0)

/-- Ordinal history at round `t`: `R^s` for `s ≤ t`, padded with zeros. -/
def ordHist {n : ℕ} (π : Equiv.Perm (Fin n)) (t : Fin n) : Fin n → (Fin n → ℕ) :=
  fun s => if s ≤ t then relRank π s else fun _ => 0

/-- Success probability of a randomized stopping rule (acceptance probability `q t h` at
round `t` given history `h`): accept at `t` (having rejected before) and `π t` is label `n`. -/
def successProb {n : ℕ} {H : Type} (hist : Fin n → H) (q : Fin n → H → ℝ)
    (π : Equiv.Perm (Fin n)) : ℝ :=
  ∑ t, (if (π t).val = n - 1 then (1 : ℝ) else 0) * q t (hist t) *
    ∏ s ∈ Finset.univ.filter (fun s : Fin n => s < t), (1 - q s (hist s))

/-- Valid randomized stopping rules on histories of type `H`. -/
def StopRule (n : ℕ) (H : Type) : Type :=
  {q : Fin n → H → ℝ // ∀ t h, 0 ≤ q t h ∧ q t h ≤ 1}

/-- `W_lev(n)`: optimal success probability with level information. -/
def Wlev (n : ℕ) (p : (Fin n → Fin n) → ℝ) : ℝ :=
  ⨆ q : StopRule n (Fin n → (Fin n → ℕ) × (Fin n → ℕ)),
    ∑ ρ, ∑ π : Equiv.Perm (Fin n),
      p ρ / (n.factorial : ℝ) * successProb (levHist ρ π) q.1 π

/-- `W_ord(n)`: optimal success probability with ordinal information only. -/
def Word (n : ℕ) (p : (Fin n → Fin n) → ℝ) : ℝ :=
  ⨆ q : StopRule n (Fin n → (Fin n → ℕ)),
    ∑ ρ, ∑ π : Equiv.Perm (Fin n),
      p ρ / (n.factorial : ℝ) * successProb (ordHist π) q.1 π

/-- Probability of an event of `(ρ, π)` with `ρ ∼ p`, `π` uniform, independent. -/
def evProb {n : ℕ} (p : (Fin n → Fin n) → ℝ)
    (E : (Fin n → Fin n) → Equiv.Perm (Fin n) → Prop) : ℝ :=
  ∑ ρ, ∑ π : Equiv.Perm (Fin n), if E ρ π then p ρ / (n.factorial : ℝ) else 0

/-- `D_m`: delete the last entry (padded vector of length `n`: set it to `0`). -/
def dropLast {n : ℕ} (x : Fin n → ℕ) : Fin n → ℕ :=
  fun i => if i.val + 1 < n then x i else 0

/-- `D_j` for `j < m`: merge entries `j, j+1` by maximum, shift the tail left, pad with `0`. -/
def mergeDel {n : ℕ} (x : Fin n → ℕ) (j : Fin n) : Fin n → ℕ :=
  fun i => if i.val < j.val then x i
    else if h : i.val + 1 < n then
      (if i.val = j.val then max (x i) (x ⟨i.val + 1, h⟩) else x ⟨i.val + 1, h⟩)
    else 0

/-- The level vector of the full state, `x_b = ρ_b` (shifted to `[n]`). -/
def stateVec {n : ℕ} (ρ : Fin n → Fin n) : Fin n → ℕ := fun b => (ρ b).val + 1

/-- Rubric 1 (one-step consequence of stationarity): `A_n p = V_n p`, i.e. deleting the last
entry has the same law as merging a uniformly chosen adjacent pair. [OnlineOrdinalProblemsOptimality, node_26] -/
theorem stationary_one_step (n : ℕ) (hn : 2 ≤ n) (p : (Fin n → Fin n) → ℝ)
    (hp : IsStationaryLevelDist n p) (y : Fin n → ℕ) :
    ∑ ρ ∈ Finset.univ.filter (fun ρ => dropLast (stateVec ρ) = y), p ρ =
      (1 / ((n : ℝ) - 1)) * ∑ j ∈ Finset.univ.filter (fun j : Fin n => j.val + 1 < n),
        ∑ ρ ∈ Finset.univ.filter (fun ρ => mergeDel (stateVec ρ) j = y), p ρ := by
  sorry

/-- Rubric 2–3 (multi-step invariant, retained-subset laws): the joint law of `(L^k, R^k)` is
unchanged by conditioning on label `n` having arrived, which has probability `k / n`. [OnlineOrdinalProblemsOptimality, node_26] -/
theorem level_law_retained (n : ℕ) (hn : 2 ≤ n) (p : (Fin n → Fin n) → ℝ)
    (hp : IsStationaryLevelDist n p) (t : Fin n) (μ σ : Fin n → ℕ) :
    evProb p (fun ρ π => (∃ c ∈ arrived π t, c.val = n - 1) ∧
        levelVec ρ π t = μ ∧ relRank π t = σ) =
      ((t.val + 1 : ℝ) / n) * evProb p (fun ρ π => levelVec ρ π t = μ ∧ relRank π t = σ) := by
  sorry

/-- Rubric 4 (next-record probability): given `(L^k, R^k)`, the element arriving at round
`k + 1` is a record with probability `1 / (k + 1)`. [OnlineOrdinalProblemsOptimality, node_26] -/
theorem next_record_prob (n : ℕ) (hn : 2 ≤ n) (p : (Fin n → Fin n) → ℝ)
    (hp : IsStationaryLevelDist n p) (t : Fin n) (ht : t.val + 1 < n) (μ σ : Fin n → ℕ) :
    evProb p (fun ρ π => relRank π ⟨t.val + 1, ht⟩ ⟨t.val + 1, ht⟩ = t.val + 2 ∧
        levelVec ρ π t = μ ∧ relRank π t = σ) =
      (1 / (t.val + 2 : ℝ)) * evProb p (fun ρ π => levelVec ρ π t = μ ∧ relRank π t = σ) := by
  sorry

/-- Main theorem: `W_lev(n) = W_ord(n)`, and for every round `k = t + 1`, every compatible
record state `(μ, σ)` (`σ(k) = k`, positive probability),
`Pr(π(k) = n | L^k = μ, R^k = σ) = k / n`. [OnlineOrdinalProblemsOptimality, node_26] -/
theorem level_secretary (n : ℕ) (hn : 2 ≤ n) (p : (Fin n → Fin n) → ℝ)
    (hp : IsStationaryLevelDist n p) :
    Wlev n p = Word n p ∧
      ∀ (t : Fin n) (μ σ : Fin n → ℕ), σ t = t.val + 1 →
        0 < evProb p (fun ρ π => levelVec ρ π t = μ ∧ relRank π t = σ) →
        evProb p (fun ρ π => (π t).val = n - 1 ∧ levelVec ρ π t = μ ∧ relRank π t = σ) /
            evProb p (fun ρ π => levelVec ρ π t = μ ∧ relRank π t = σ) =
          (t.val + 1 : ℝ) / n := by
  sorry

end TCSChallenge.OnlineOrdinalProblemsOptimality.node_26
