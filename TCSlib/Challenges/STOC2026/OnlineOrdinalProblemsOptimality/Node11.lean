/-!
## Ordinal algorithms are near-optimal against a tower-bounded value distribution

There are `n` elements (labels `Fin n`), an arrival order `π` (element `π k` arrives in round
`k`) and a rank assignment `σ` (`σ i` is the 0-indexed rank of element `i`, rank 0 smallest),
drawn independently from `Dπ, Dσ : FinDist (Equiv.Perm (Fin n))`. An online task has nonempty
action sets `A k` and a reward `R : (∏ k, A k) → Sym(n) → Sym(n) → ℝ≥0`. A cardinal algorithm
sees the arrived identities and their numerical values; an ordinal algorithm sees the arrived
identities and their comparisons. Values come from an increasing tuple `s : Fin n → Fin N`
drawn from a distribution `F : FinDist (Fin n → Fin N)` supported on increasing tuples (the
value of the element of rank `j` is `s j + 1 ∈ [N]`). Laws of deletions are `FinDist.map`
pushforwards, compared in TCSlib's `statDist`.

Main theorem `cardinal_le_one_add_eps_ordinal`: there is a universal `C ≥ 1` such that for
every task, `Dπ`, `Dσ`, `ε > 0` there exist `N ≤ T_{n-1}(C n³ (n!)² / min{ε,1})` and `F`
with `sup_Card E[R] ≤ (1+ε) sup_Ord E[R]`.
-/

namespace TCSChallenge.OnlineOrdinalProblemsOptimality.node_11

/-- "A distribution `F` on `n`-element subsets of `[N]`": a distribution on tuples
`s : Fin n → Fin N` supported on strictly increasing tuples `s_1 < ⋯ < s_n` (shifted by one:
the actual integer is `s j + 1`). -/
def IsSubsetDist {n N : ℕ} (F : FinDist (Fin n → Fin N)) : Prop :=
  ∀ s, F s ≠ 0 → StrictMono s

/-- The tower function `T_0(b) = 1`, `T_{h+1}(b) = b^{T_h(b)}` (real powers). -/
def tower : ℕ → ℝ → ℝ
  | 0, _ => 1
  | h + 1, b => b ^ (tower h b)

/-- The `t`-th round (`t ≤ k`) as a round of `Fin n`. -/
def pre {n : ℕ} (k : Fin n) (t : Fin (k.val + 1)) : Fin n := Fin.castLE k.isLt t

/-- Value vector `v(S,σ)_i = s_{σ(i)}`: element `i` gets the `σ(i)`-th smallest value. -/
def valueVec {n N : ℕ} (s : Fin n → Fin N) (σ : Equiv.Perm (Fin n)) : Fin n → ℕ :=
  fun i => (s (σ i)).val + 1

/-- A (deterministic) cardinal algorithm: in round `k` it sees, for every round `t ≤ k`, the
identity of the element that arrived and its numerical value, and picks an action in `A k`. -/
def CardAlg (n : ℕ) (A : Fin n → Type) : Type :=
  (k : Fin n) → (Fin (k.val + 1) → Fin n × ℕ) → A k

/-- A (deterministic) ordinal algorithm: in round `k` it sees the identities of the arrived
elements and their pairwise comparisons, and picks an action in `A k`. -/
def OrdAlg (n : ℕ) (A : Fin n → Type) : Type :=
  (k : Fin n) → (Fin (k.val + 1) → Fin n) → (Fin (k.val + 1) → Fin (k.val + 1) → Bool) → A k

/-- `ALG(v, π)`: the action transcript of a cardinal algorithm on values `v`, arrival order `π`. -/
def cardTranscript {n : ℕ} {A : Fin n → Type} (alg : CardAlg n A) (v : Fin n → ℕ)
    (π : Equiv.Perm (Fin n)) : (k : Fin n) → A k :=
  fun k => alg k (fun t => (π (pre k t), v (π (pre k t))))

/-- `ALG(σ, π)`: the action transcript of an ordinal algorithm on the comparisons of `σ`. -/
def ordTranscript {n : ℕ} {A : Fin n → Type} (alg : OrdAlg n A) (σ π : Equiv.Perm (Fin n)) :
    (k : Fin n) → A k :=
  fun k => alg k (fun t => π (pre k t))
    (fun a b => decide (σ (π (pre k a)) < σ (π (pre k b))))

/-- `E_{π, σ, S∼F}[R(ALG(v(S,σ),π),σ,π)]` for a cardinal algorithm (weights `Dπ`, `Dσ` given
as real vectors, e.g. the masses of a `FinDist`). -/
def cardValue {n N : ℕ} {A : Fin n → Type}
    (R : ((k : Fin n) → A k) → Equiv.Perm (Fin n) → Equiv.Perm (Fin n) → ℝ≥0)
    (Dπ Dσ : Equiv.Perm (Fin n) → ℝ) (F : FinDist (Fin n → Fin N)) (alg : CardAlg n A) :
    ℝ≥0∞ :=
  ∑ π, ∑ σ, ∑ s,
    ENNReal.ofReal (Dπ π * Dσ σ * F s * (R (cardTranscript alg (valueVec s σ) π) σ π : ℝ))

/-- `E_{π, σ}[R(ALG(σ,π),σ,π)]` for an ordinal algorithm. -/
def ordValue {n : ℕ} {A : Fin n → Type}
    (R : ((k : Fin n) → A k) → Equiv.Perm (Fin n) → Equiv.Perm (Fin n) → ℝ≥0)
    (Dπ Dσ : Equiv.Perm (Fin n) → ℝ) (alg : OrdAlg n A) : ℝ≥0∞ :=
  ∑ π, ∑ σ, ENNReal.ofReal (Dπ π * Dσ σ * (R (ordTranscript alg σ π) σ π : ℝ))

/-- Expected offline optimum `W = E_{σ,π} M(σ,π)`, `M(σ,π) = sup_a R(a,σ,π)`. -/
def offlineValue {n : ℕ} {A : Fin n → Type}
    (R : ((k : Fin n) → A k) → Equiv.Perm (Fin n) → Equiv.Perm (Fin n) → ℝ≥0)
    (Dπ Dσ : Equiv.Perm (Fin n) → ℝ) : ℝ≥0∞ :=
  ∑ π, ∑ σ, ENNReal.ofReal (Dπ π * Dσ σ) * ⨆ a : (k : Fin n) → A k, (R a σ π : ℝ≥0∞)

/-- Delete coordinate `i` from an `(m+1)`-tuple (`S_{-i}`). -/
def deleteCoord {m N : ℕ} (i : Fin (m + 1)) (s : Fin (m + 1) → Fin N) : Fin m → Fin N :=
  fun a => s (i.succAbove a)

/-- Rubric 1–2 (construction and domain control): for `q ≥ 2(m+1)` there is a distribution on
increasing `(m+1)`-tuples in `[N]`, `N + 2 ≤ T_m(4q)`, all of whose single-coordinate deletions
are within total variation `(2(m+1) - 3)/q` of each other. [OnlineOrdinalProblemsOptimality, node_11] -/
theorem deletion_indistinguishable (m : ℕ) (hm : 1 ≤ m) (q : ℕ) (hq : 2 * (m + 1) ≤ q) :
    ∃ (N : ℕ) (P : FinDist (Fin (m + 1) → Fin N)), IsSubsetDist P ∧
      (N : ℝ) + 2 ≤ tower m (4 * (q : ℝ)) ∧
      ∀ i j : Fin (m + 1),
        statDist (P.map (deleteCoord i)) (P.map (deleteCoord j))
          ≤ (2 * ((m : ℝ) + 1) - 3) / q := by
  sorry

/-- Rubric 3–4 (consistent online simulation, transfer to rewards): if all deletions of `F`
are `ρ`-close, every cardinal algorithm is matched by ordinal algorithms up to additive
error `(n-1) ρ W`, with `n = m + 1` and `W` the expected offline optimum. [OnlineOrdinalProblemsOptimality, node_11] -/
theorem simulation_transfer (m : ℕ) (A : Fin (m + 1) → Type) (hA : ∀ k, Nonempty (A k))
    (R : ((k : Fin (m + 1)) → A k) → Equiv.Perm (Fin (m + 1)) → Equiv.Perm (Fin (m + 1)) → ℝ≥0)
    (Dπ Dσ : FinDist (Equiv.Perm (Fin (m + 1))))
    (N : ℕ) (F : FinDist (Fin (m + 1) → Fin N)) (hF : IsSubsetDist F) (ρ : ℝ) (hρ : 0 ≤ ρ)
    (hdel : ∀ i j : Fin (m + 1),
      statDist (F.map (deleteCoord i)) (F.map (deleteCoord j)) ≤ ρ)
    (alg : CardAlg (m + 1) A) :
    cardValue R Dπ Dσ F alg ≤
      (⨆ B : OrdAlg (m + 1) A, ordValue R Dπ Dσ B) +
        ENNReal.ofReal ((m : ℝ) * ρ) * offlineValue R Dπ Dσ := by
  sorry

/-- Rubric 5 (ordinal guessing bound): `V_Ord ≥ W / (n!)²`, for arbitrary nonnegative weight
vectors `Dπ`, `Dσ` (not necessarily normalised). [OnlineOrdinalProblemsOptimality, node_11] -/
theorem ordinal_guessing (n : ℕ) (A : Fin n → Type)
    (R : ((k : Fin n) → A k) → Equiv.Perm (Fin n) → Equiv.Perm (Fin n) → ℝ≥0)
    (Dπ Dσ : Equiv.Perm (Fin n) → ℝ≥0) :
    offlineValue R (fun π => (Dπ π : ℝ)) (fun σ => (Dσ σ : ℝ)) ≤
      ((n.factorial : ℝ≥0∞) ^ 2) *
        ⨆ B : OrdAlg n A, ordValue R (fun π => (Dπ π : ℝ)) (fun σ => (Dσ σ : ℝ)) B := by
  sorry

/-- Main theorem. [OnlineOrdinalProblemsOptimality, node_11] -/
theorem cardinal_le_one_add_eps_ordinal :
    ∃ C : ℝ, 1 ≤ C ∧
      ∀ (n : ℕ), 1 ≤ n →
      ∀ (A : Fin n → Type), (∀ k, Nonempty (A k)) →
      ∀ (R : ((k : Fin n) → A k) → Equiv.Perm (Fin n) → Equiv.Perm (Fin n) → ℝ≥0)
        (Dπ Dσ : FinDist (Equiv.Perm (Fin n))),
      ∀ ε : ℝ, 0 < ε →
        ∃ (N : ℕ) (F : FinDist (Fin n → Fin N)), IsSubsetDist F ∧
          (N : ℝ) ≤ tower (n - 1)
            (C * (n : ℝ) ^ 3 * ((n.factorial : ℝ)) ^ 2 / min ε 1) ∧
          (⨆ alg : CardAlg n A, cardValue R Dπ Dσ F alg) ≤
            ENNReal.ofReal (1 + ε) * ⨆ B : OrdAlg n A, ordValue R Dπ Dσ B := by
  sorry

end TCSChallenge.OnlineOrdinalProblemsOptimality.node_11
