/-!
## Testing ρ-IndepSet and ρ-Clique with `Õ(ρ³/ε²)` samples

Graphs are `SimpleGraph (Fin n)`. The edit distance between two graphs counts unordered
pairs `{u,v}` on which they disagree. `G` is `ε`-far from a property `Π` if every graph in
`Π` is at edit distance `≥ ε n²`. A canonical tester of sample cost `s` draws a uniform
`s`-subset `S` of the vertices and decides from `G[S]` alone; it must accept members of
`Π` with probability `≥ 2/3` and reject `ε`-far graphs with probability `≥ 2/3`.
`S_Π(n, ε)` is the least such `s` (the full sample `s = n` always works).

With `m = ⌈ρ n⌉`, ρ-IndepSet is "has an independent set of size `≥ m`" and ρ-Clique is
"has a clique of size `≥ m`". Main theorem `main_theorem`: there is an absolute `C > 0`
such that for all `n ≥ 1`, `0 < ρ ≤ 1`, `0 < ε < 1/2`,
`S_{ρ-Clique}(n,ε) = S_{ρ-IndepSet}(n,ε) ≤ C · ρ³/ε² · ln³(1/ε)`.
-/

namespace TCSChallenge.TestingGraphPropertiesWith.node_05

variable {n : ℕ}

/-- Edit distance: "each changed unordered vertex pair counted once". Counts pairs `(u,v)`
with `u < v` on which `G` and `H` disagree. -/
def editDist (G H : SimpleGraph (Fin n)) : ℕ :=
  ((Finset.univ : Finset (Fin n × Fin n)).filter
    (fun p => p.1 < p.2 ∧ ¬ (G.Adj p.1 p.2 ↔ H.Adj p.1 p.2))).card

/-- "A graph is ε-far from a property Π if at least ε n² edge additions or deletions are
required to obtain a graph in Π." -/
def IsFar (P : SimpleGraph (Fin n) → Prop) (ε : ℝ) (G : SimpleGraph (Fin n)) : Prop :=
  ∀ H : SimpleGraph (Fin n), P H → ε * (n : ℝ) ^ 2 ≤ (editDist G H : ℝ)

/-- The observed graph: `G[S]`, relabelled by the increasing enumeration of `S`. -/
def observe (G : SimpleGraph (Fin n)) (S : Finset (Fin n)) : SimpleGraph (Fin S.card) :=
  G.comap (fun i => S.orderEmbOfFin rfl i)

/-- A decision rule on observed graphs (one predicate per sample size). -/
abbrev Decider := ∀ k : ℕ, SimpleGraph (Fin k) → Prop

/-- The tester "observes only its induced graph": its decision is isomorphism invariant. -/
def IsoInvariant (D : Decider) : Prop :=
  ∀ (k : ℕ) (H H' : SimpleGraph (Fin k)), Nonempty (H ≃g H') → (D k H ↔ D k H')

/-- Acceptance probability with a uniformly random `s`-subset of the vertices. -/
def acceptProb (D : Decider) (G : SimpleGraph (Fin n)) (s : ℕ) : ℝ :=
  (((Finset.univ : Finset (Fin n)).powersetCard s).filter
      (fun S => D S.card (observe G S))).card / (n.choose s : ℝ)

/-- A canonical tester of sample cost `s` for `Π` with proximity `ε`. -/
def IsCanonicalTester (P : SimpleGraph (Fin n) → Prop) (ε : ℝ) (s : ℕ) (D : Decider) : Prop :=
  IsoInvariant D ∧
  (∀ G, P G → (2 : ℝ) / 3 ≤ acceptProb D G s) ∧
  (∀ G, IsFar P ε G → (2 : ℝ) / 3 ≤ 1 - acceptProb D G s)

/-- `S_Π(n, ε)`: the least sample cost `s ∈ {0,…,n}` of a canonical tester. -/
def sampleComplexity (n : ℕ) (P : SimpleGraph (Fin n) → Prop) (ε : ℝ) : ℕ :=
  sInf {s : ℕ | s ≤ n ∧ ∃ D : Decider, IsCanonicalTester P ε s D}

/-- `G` has an independent set of size at least `m`. -/
def HasIndepSetOfSize (G : SimpleGraph (Fin n)) (m : ℕ) : Prop :=
  ∃ S : Finset (Fin n), G.IsIndepSet (S : Set (Fin n)) ∧ m ≤ S.card

/-- `G` has a clique of size at least `m`. -/
def HasCliqueOfSize (G : SimpleGraph (Fin n)) (m : ℕ) : Prop :=
  ∃ S : Finset (Fin n), G.IsClique (S : Set (Fin n)) ∧ m ≤ S.card

/-- ρ-IndepSet: an independent set of size at least `m = ⌈ρ n⌉`. -/
def RhoIndepSet (n : ℕ) (ρ : ℝ) (G : SimpleGraph (Fin n)) : Prop :=
  HasIndepSetOfSize G ⌈ρ * n⌉₊

/-- ρ-Clique: a clique of size at least `m = ⌈ρ n⌉`. -/
def RhoClique (n : ℕ) (ρ : ℝ) (G : SimpleGraph (Fin n)) : Prop :=
  HasCliqueOfSize G ⌈ρ * n⌉₊

/-- `e(G[A])`: the number of edges spanned by `A`. -/
def edgesIn (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) : ℕ :=
  ((Finset.univ : Finset (Fin n × Fin n)).filter
    (fun p => p.1 < p.2 ∧ p.1 ∈ A ∧ p.2 ∈ A ∧ G.Adj p.1 p.2)).card

/-! ## Rubric lemma stubs -/

/-- Farness transfer: if `G` is `ε`-far from ρ-IndepSet then every `m`-set spans at least
`ε n²` edges. [TestingGraphPropertiesWith, node_05] -/
theorem far_every_mset_dense (ρ ε : ℝ) (G : SimpleGraph (Fin n))
    (hfar : IsFar (RhoIndepSet n ρ) ε G) (A : Finset (Fin n)) (hA : A.card = ⌈ρ * n⌉₊) :
    ε * (n : ℝ) ^ 2 ≤ (edgesIn G A : ℝ) := by
  sorry

/-- Structural container lemma (rubric items 1–3). In the nontrivial regime `m ≥ 2`,
`ε < r²/2` (with `r = m/n`), put `ℓ = ln(2r/ε)`, `H = 16 r² ℓ / ε`, `a = ε/(16 r ℓ)`.
If `G` is `ε`-far, there is a map `C` from vertex sets to vertex sets (depending only on
`G` and the fixed tie-breaking order) such that every independent set `I` with `|I| > H`
has a fingerprint `F ⊆ I`, `1 ≤ |F| ≤ H`, with `I ⊆ C(F)` and `|C(F)| ≤ (r − a|F|) n`.
Since `F` is a `t`-subset, there are at most `binom(n,t)` fingerprints of size `t`. [TestingGraphPropertiesWith, node_05] -/
theorem container_lemma (ρ ε : ℝ) (hε : 0 < ε) (G : SimpleGraph (Fin n))
    (hm : 2 ≤ ⌈ρ * n⌉₊)
    (hεr : ε < ((⌈ρ * n⌉₊ : ℝ) / n) ^ 2 / 2)
    (hfar : IsFar (RhoIndepSet n ρ) ε G) :
    let r : ℝ := (⌈ρ * n⌉₊ : ℝ) / n
    let ℓ : ℝ := Real.log (2 * r / ε)
    let H : ℝ := 16 * r ^ 2 * ℓ / ε
    let a : ℝ := ε / (16 * r * ℓ)
    ∃ C : Finset (Fin n) → Finset (Fin n),
      ∀ I : Finset (Fin n), G.IsIndepSet (I : Set (Fin n)) → H < (I.card : ℝ) →
        ∃ F : Finset (Fin n), F ⊆ I ∧ 1 ≤ F.card ∧ (F.card : ℝ) ≤ H ∧ I ⊆ C F ∧
          ((C F).card : ℝ) ≤ (r - a * F.card) * n := by
  sorry

/-- Tester analysis (rubric items 4–5) in the nontrivial regime: with `L = ln(1/ε)`,
`s = ⌈K r³ L³/ε²⌉ < n` and `k = ⌈r s − 2√(r s)⌉`, the rule "accept iff `G[S]` has an
independent set of size `≥ k`" accepts every ρ-IndepSet graph with probability `≥ 3/4`
and accepts every `ε`-far graph with probability `≤ 1/3`. [TestingGraphPropertiesWith, node_05] -/
theorem indep_tester_analysis :
    ∃ K : ℝ, 0 < K ∧ ∀ (ρ ε : ℝ), 0 < ρ → ρ ≤ 1 → 0 < ε → ε < 1 / 2 →
      2 ≤ ⌈ρ * n⌉₊ → ε < ((⌈ρ * n⌉₊ : ℝ) / n) ^ 2 / 2 →
      let r : ℝ := (⌈ρ * n⌉₊ : ℝ) / n
      let L : ℝ := Real.log (1 / ε)
      let s : ℕ := ⌈K * r ^ 3 / ε ^ 2 * L ^ 3⌉₊
      let k : ℕ := ⌈r * s - 2 * Real.sqrt (r * s)⌉₊
      let D : Decider := fun _ Gs => HasIndepSetOfSize Gs k
      s < n →
        IsoInvariant D ∧
        (∀ G : SimpleGraph (Fin n), RhoIndepSet n ρ G → (3 : ℝ) / 4 ≤ acceptProb D G s) ∧
        (∀ G : SimpleGraph (Fin n), IsFar (RhoIndepSet n ρ) ε G →
          acceptProb D G s ≤ 1 / 3) := by
  sorry

/-- Complementation preserves edit distance. [TestingGraphPropertiesWith, node_05] -/
theorem editDist_compl (G H : SimpleGraph (Fin n)) : editDist Gᶜ Hᶜ = editDist G H := by
  sorry

/-- Complementation: ρ-Clique and ρ-IndepSet have the same sample complexity. [TestingGraphPropertiesWith, node_05] -/
theorem sampleComplexity_clique_eq_indep (ρ ε : ℝ) :
    sampleComplexity n (RhoClique n ρ) ε = sampleComplexity n (RhoIndepSet n ρ) ε := by
  sorry

/-! ## Main theorem -/

/-- **Main theorem.** Uniformly over `n ≥ 1`, `0 < ρ ≤ 1`, `0 < ε < 1/2`,
`S_{ρ-Clique}(n,ε) = S_{ρ-IndepSet}(n,ε) ≤ C ρ³/ε² · ln³(1/ε)` for an absolute `C`. [TestingGraphPropertiesWith, node_05] -/
theorem main_theorem :
    ∃ C : ℝ, 0 < C ∧ ∀ (n : ℕ) (ρ ε : ℝ), 1 ≤ n → 0 < ρ → ρ ≤ 1 → 0 < ε → ε < 1 / 2 →
      sampleComplexity n (RhoClique n ρ) ε = sampleComplexity n (RhoIndepSet n ρ) ε ∧
      (sampleComplexity n (RhoIndepSet n ρ) ε : ℝ) ≤
        C * (ρ ^ 3 / ε ^ 2) * (Real.log (1 / ε)) ^ 3 := by
  sorry

end TCSChallenge.TestingGraphPropertiesWith.node_05
