/-!
## Testing k-colorability with `O((k/ε) ln²(1/ε))` samples

Graphs are `SimpleGraph (Fin n)`; `G` is `ε`-far from k-colorable if every k-colorable
graph on the same vertex set is at edit distance `≥ ε n²` (unordered pairs counted once).

Main theorem `main_theorem`: there is an absolute `C > 0` such that for all `k, n ≥ 1`,
`0 < ε ≤ 1/2`, with `s = min{n, ⌈C (k/ε) ln²(1/ε)⌉}`, every `ε`-far `G` has at most
`binom(n,s)/3` many `s`-subsets `U` with `G[U]` k-colorable; consequently
`S_{k-Colorable}(n,ε) ≤ s` (the tester accepts iff the sample is k-colorable).
-/

namespace TCSChallenge.TestingGraphPropertiesWith.node_09

variable {n : ℕ}

/-- Edit distance: "each changed unordered vertex pair counted once". Counts pairs `(u,v)`
with `u < v` on which `G` and `H` disagree. -/
def editDist (G H : SimpleGraph (Fin n)) : ℕ :=
  ((Finset.univ : Finset (Fin n × Fin n)).filter
    (fun p => p.1 < p.2 ∧ ¬ (G.Adj p.1 p.2 ↔ H.Adj p.1 p.2))).card

/-- "A graph is ε-far from a property Π if at least ε n² edge additions or deletions are
required to obtain a graph in Π." -/
def IsFar (P : SimpleGraph (Fin n) → Prop) (ε : ℝ) (G : SimpleGraph (Fin n)) : Prop :=
  ∀ H : SimpleGraph (Fin n), P H → ε * (n : ℝ) ^ 2 ≤ (editDist G H : ℝ)

/-- The observed graph: `G[S]`, relabelled by the increasing enumeration of `S`. -/
def observe (G : SimpleGraph (Fin n)) (S : Finset (Fin n)) : SimpleGraph (Fin S.card) :=
  G.comap (fun i => S.orderEmbOfFin rfl i)

/-- A decision rule on observed graphs (one predicate per sample size). -/
abbrev Decider := ∀ k : ℕ, SimpleGraph (Fin k) → Prop

/-- The tester "observes only its induced graph": its decision is isomorphism invariant. -/
def IsoInvariant (D : Decider) : Prop :=
  ∀ (k : ℕ) (H H' : SimpleGraph (Fin k)), Nonempty (H ≃g H') → (D k H ↔ D k H')

/-- Acceptance probability with a uniformly random `s`-subset of the vertices. -/
def acceptProb (D : Decider) (G : SimpleGraph (Fin n)) (s : ℕ) : ℝ :=
  (((Finset.univ : Finset (Fin n)).powersetCard s).filter
      (fun S => D S.card (observe G S))).card / (n.choose s : ℝ)

/-- A canonical tester of sample cost `s` for `Π` with proximity `ε`. -/
def IsCanonicalTester (P : SimpleGraph (Fin n) → Prop) (ε : ℝ) (s : ℕ) (D : Decider) : Prop :=
  IsoInvariant D ∧
  (∀ G, P G → (2 : ℝ) / 3 ≤ acceptProb D G s) ∧
  (∀ G, IsFar P ε G → (2 : ℝ) / 3 ≤ 1 - acceptProb D G s)

/-- `S_Π(n, ε)`: the least sample cost `s ∈ {0,…,n}` of a canonical tester. -/
def sampleComplexity (n : ℕ) (P : SimpleGraph (Fin n) → Prop) (ε : ℝ) : ℕ :=
  sInf {s : ℕ | s ≤ n ∧ ∃ D : Decider, IsCanonicalTester P ε s D}

/-- The property k-Colorable: a proper colouring `χ : V → Fin k` exists. -/
def KColorable (n k : ℕ) (G : SimpleGraph (Fin n)) : Prop :=
  G.Colorable k

/-- The number of `s`-subsets `U` with `G[U]` k-colorable. -/
def numColorableSubsets (G : SimpleGraph (Fin n)) (k s : ℕ) : ℕ :=
  (((Finset.univ : Finset (Fin n)).powersetCard s).filter
    (fun U : Finset (Fin n) => (G.induce (↑U : Set (Fin n))).Colorable k)).card

/-- Degree of `v` inside `G[A]`. -/
def degIn (G : SimpleGraph (Fin n)) (A : Finset (Fin n)) (v : Fin n) : ℕ :=
  (A.filter (fun w => G.Adj v w)).card

/-! ## Rubric lemma stubs -/

/-- Random colouring: an `ε`-far-from-k-colorable graph has `ε < 1/(2k)`. [TestingGraphPropertiesWith, node_09] -/
theorem far_implies_eps_small (k : ℕ) (hk : 1 ≤ k) (hn : 1 ≤ n) (ε : ℝ)
    (G : SimpleGraph (Fin n)) (hfar : IsFar (KColorable n k) ε G) :
    ε < 1 / (2 * (k : ℝ)) := by
  sorry

/-- Deterministic containers for independent sets (rubric item 1): maps `F r I`, `C r I`
with `F_r(I) ⊆ I ⊆ C_r(I)`, `|F_r(I)| = min(r,|I|)`, nested containers, reconstruction
`C_r(F_r(I)) = C_r(I)`, and maximum degree of `G[C_r(I)]` at most `n/r` for `r ≥ 1`. [TestingGraphPropertiesWith, node_09] -/
theorem independent_set_containers (G : SimpleGraph (Fin n)) :
    ∃ (F C : ℕ → Finset (Fin n) → Finset (Fin n)),
      ∀ I : Finset (Fin n), G.IsIndepSet (I : Set (Fin n)) → ∀ r : ℕ,
        F r I ⊆ I ∧ I ⊆ C r I ∧ (F r I).card = min r I.card ∧
        C (r + 1) I ⊆ C r I ∧ C r (F r I) = C r I ∧
        (1 ≤ r → ∀ v ∈ C r I, (degIn G (C r I) v : ℝ) ≤ (n : ℝ) / r) := by
  sorry

/-- Common-stage union deficit (rubric item 2). For `0 < ε ≤ e⁻⁴`, `L = ln(1/ε)`,
`T = ⌈4/ε⌉`, `a = ε/(4L)`, and `G` `ε`-far from k-colorable, there are containers as in
`independent_set_containers` such that every `k` independent sets `I₁,…,I_k` admit a
stage `1 ≤ r ≤ T` with `|⋃ᵢ C_r(Iᵢ)| ≤ (1 − a r) n`. [TestingGraphPropertiesWith, node_09] -/
theorem common_stage_deficit (k : ℕ) (hk : 1 ≤ k) (ε : ℝ) (hε : 0 < ε)
    (hε4 : ε ≤ Real.exp (-4)) (G : SimpleGraph (Fin n)) (hfar : IsFar (KColorable n k) ε G) :
    let L : ℝ := Real.log (1 / ε)
    let T : ℕ := ⌈4 / ε⌉₊
    let a : ℝ := ε / (4 * L)
    ∃ (F C : ℕ → Finset (Fin n) → Finset (Fin n)),
      (∀ I : Finset (Fin n), G.IsIndepSet (I : Set (Fin n)) → ∀ r : ℕ,
        F r I ⊆ I ∧ I ⊆ C r I ∧ (F r I).card = min r I.card ∧
        C (r + 1) I ⊆ C r I ∧ C r (F r I) = C r I ∧
        (1 ≤ r → ∀ v ∈ C r I, (degIn G (C r I) v : ℝ) ≤ (n : ℝ) / r)) ∧
      ∀ I : Fin k → Finset (Fin n), (∀ i, G.IsIndepSet (I i : Set (Fin n))) →
        ∃ r : ℕ, 1 ≤ r ∧ r ≤ T ∧
          ((Finset.univ.biUnion (fun i => C r (I i))).card : ℝ) ≤ (1 - a * r) * n := by
  sorry

/-- Encoding of large colorable sets (rubric item 3). Same parameters. There is a covering
map `Cov` on `k`-tuples of vertex sets such that every `U` with `G[U]` k-colorable and
`|U| ≥ k T` has a pairwise-disjoint tuple `(T₁,…,T_k)` of subsets of `U`, each of size
`≤ T`, with union of size `q ≥ 1`, `U ⊆ Cov(T)` and `|Cov(T)| ≤ (1 − a q / k) n`.
Disjointness gives at most `binom(n,q) k^q` tuples with union size `q`. [TestingGraphPropertiesWith, node_09] -/
theorem colorable_set_encoding (k : ℕ) (hk : 1 ≤ k) (ε : ℝ) (hε : 0 < ε)
    (hε4 : ε ≤ Real.exp (-4)) (G : SimpleGraph (Fin n)) (hfar : IsFar (KColorable n k) ε G) :
    let L : ℝ := Real.log (1 / ε)
    let T : ℕ := ⌈4 / ε⌉₊
    let a : ℝ := ε / (4 * L)
    ∃ Cov : (Fin k → Finset (Fin n)) → Finset (Fin n),
      ∀ U : Finset (Fin n), (G.induce (U : Set (Fin n))).Colorable k → k * T ≤ U.card →
        ∃ Tup : Fin k → Finset (Fin n),
          (∀ i j, i ≠ j → Disjoint (Tup i) (Tup j)) ∧ (∀ i, Tup i ⊆ U) ∧
          (∀ i, (Tup i).card ≤ T) ∧ 1 ≤ (Finset.univ.biUnion Tup).card ∧
          U ⊆ Cov Tup ∧
          ((Cov Tup).card : ℝ) ≤
            (1 - a * ((Finset.univ.biUnion Tup).card : ℝ) / k) * n := by
  sorry

/-- Sampling bound in the small-ε regime (rubric items 4–5): for `ε ≤ e⁻⁴` and
`s = ⌈256 (k/ε) L²⌉ < n`, at most a third of the `s`-subsets induce k-colorable graphs. [TestingGraphPropertiesWith, node_09] -/
theorem small_eps_sampling_bound (k : ℕ) (hk : 1 ≤ k) (ε : ℝ) (hε : 0 < ε)
    (hε4 : ε ≤ Real.exp (-4)) (G : SimpleGraph (Fin n)) (hfar : IsFar (KColorable n k) ε G) :
    let s : ℕ := ⌈256 * ((k : ℝ) / ε) * (Real.log (1 / ε)) ^ 2⌉₊
    s < n → (numColorableSubsets G k s : ℝ) ≤ (n.choose s : ℝ) / 3 := by
  sorry

/-! ## Main theorem -/

/-- **Main theorem.** There is an absolute `C > 0` such that for all `k, n ≥ 1` and
`0 < ε ≤ 1/2`, with `s = min{n, ⌈C (k/ε) ln²(1/ε)⌉}`: every `ε`-far-from-k-colorable `G`
has at most `binom(n,s)/3` many `s`-subsets inducing a k-colorable graph, and
`S_{k-Colorable}(n,ε) ≤ s`. [TestingGraphPropertiesWith, node_09] -/
theorem main_theorem :
    ∃ C : ℝ, 0 < C ∧ ∀ (k n : ℕ) (ε : ℝ), 1 ≤ k → 1 ≤ n → 0 < ε → ε ≤ 1 / 2 →
      let s : ℕ := min n ⌈C * ((k : ℝ) / ε) * (Real.log (1 / ε)) ^ 2⌉₊
      (∀ G : SimpleGraph (Fin n), IsFar (KColorable n k) ε G →
        (numColorableSubsets G k s : ℝ) ≤ (n.choose s : ℝ) / 3) ∧
      sampleComplexity n (KColorable n k) ε ≤ s := by
  sorry

end TCSChallenge.TestingGraphPropertiesWith.node_09
