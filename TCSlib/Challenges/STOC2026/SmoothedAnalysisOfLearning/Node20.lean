/-!
## Composing a local one-sided positive-only learner into a global learner

Domain `X = ℝ^d` (as `Fin d → ℝ`), reference distribution `D`, evaluation distribution
`D*`, unknown target set `H*` in a class `𝓗` of measurable sets (a hypothesis
`g : X → {0,1}` is identified with its positive set `H_g`). The assumptions are
generalized smoothness `D*(A) ≤ σ⁻¹ D(A)^{1/q}`, positive mass `D*(H*) ≥ α`, and
degree-`k`, range-`[-C, ∞)` `L₁` approximation error `ζ` under `D`.

A supplied local routine (used without proof) takes a region `S` with conditioned
parameters `a, s, η` and a failure budget `r`, and returns a degree-`k` polynomial
threshold set `G` with small conditional false-negative mass and conditional reference
mass at most `OPT(S)` plus a small error.

The nested restriction algorithm: `S₁ = X`; in round `i`, if a fresh estimate of `D(Sᵢ)`
is below `3γ/2`, stop and output `Sᵢ`; else call the local routine on `Sᵢ` (with
`a = 5α/6`, `s = 5ασ/6`, `η = ζ/γ`, budget `r`) and set `Sᵢ₊₁ = Sᵢ ∩ Gᵢ`. After
`T = ⌈1/γ⌉` rounds output `S_{T+1}`.

Main theorem `nestedRestriction_correct`: for absolute constants `c₁, c₂` of the local
routine there is an absolute `c₀` such that whenever
`ζ ≤ c₀ (σαε)^{8q²+5q} / (C+1)^{4q}`, some choice of `γ, r` depending only on the
known scalars makes the algorithm (on the success events of all its subroutine calls)
output an intersection of at most `T` degree-`k` PTF sets `H` with
`D*(H △ H*) ≤ ε`.
-/

namespace TCSChallenge.SmoothedAnalysisOfLearning.node_20

open MeasureTheory ProbabilityTheory

/-- The domain `𝒳 = ℝ^d`, as coordinate vectors. -/
abbrev Pt (d : ℕ) : Type := Fin d → ℝ

/-- "A degree-`k` polynomial threshold set is a set `G_{p,t} := {x : p(x) ≥ t}`, where
`p` has degree at most `k` and `t ∈ ℝ`." -/
def IsPTF {d : ℕ} (k : ℕ) (G : Set (Pt d)) : Prop :=
  ∃ (p : MvPolynomial (Fin d) ℝ) (t : ℝ),
    p.totalDegree ≤ k ∧ G = {x | t ≤ MvPolynomial.eval x p}

/-- Generalized smoothness: "`𝒟*(A) ≤ (1/σ) 𝒟(A)^{1/q}` for every measurable `A`". -/
def GenSmooth {d : ℕ} (Dstar D : Measure (Pt d)) (σ q : ℝ) : Prop :=
  ∀ A : Set (Pt d), MeasurableSet A →
    (Dstar A).toReal ≤ (1 / σ) * (D A).toReal ^ (1 / q)

/-- Approximation hypothesis: "for every `g ∈ 𝓗` there is a polynomial `p_g` of degree
at most `k` with `p_g(𝒳) ⊆ [-C, ∞)` and `E_{x∼μ}[|p_g(x) - g(x)|] ≤ η`". The hypothesis
`g` is the indicator of its positive set; integrability is required so that the Bochner
integral is the true expectation. -/
def ApproxErr {d : ℕ} (k : ℕ) (C : ℝ) (Hcls : Set (Set (Pt d))) (μ : Measure (Pt d))
    (η : ℝ) : Prop :=
  ∀ g ∈ Hcls, ∃ p : MvPolynomial (Fin d) ℝ,
    p.totalDegree ≤ k ∧ (∀ x, -C ≤ MvPolynomial.eval x p) ∧
    Integrable (fun x => |MvPolynomial.eval x p - g.indicator (fun _ => (1 : ℝ)) x|) μ ∧
    ∫ x, |MvPolynomial.eval x p - g.indicator (fun _ => (1 : ℝ)) x| ∂μ ≤ η

/-- "`OPT(S) := inf { 𝒟_S(H_g) : g ∈ 𝓗, 𝒫*_S(H_g) = 1 }`" with `𝒫* = 𝒟*(· | H*)`,
`𝒫*_S = 𝒫*(· | S)`, `𝒟_S = 𝒟(· | S)`. -/
def OPT {d : ℕ} (Hcls : Set (Set (Pt d))) (D Dstar : Measure (Pt d))
    (Hstar S : Set (Pt d)) : ℝ :=
  sInf {v : ℝ | ∃ g ∈ Hcls, cond (cond Dstar Hstar) S g = 1 ∧ v = (cond D S g).toReal}

/-- The supplied local result, as a specification of the (success event of the) local
routine `L S a s η r`: if `a, s ∈ (0,1]`, `r ∈ (0,1)`, the conditioned instance is
`(s, q)`-smooth with positive mass `a`, the class has approximation error `η` under
`𝒟_S`, and `η ≤ c₁ (as/(C+1))^{2q}`, then the output is a degree-`k` PTF set `G` with
`𝒟*_S(H* \ G) ≤ c₂ (C+1)/(as) η^{1/(4q)}` and
`𝒟_S(G) ≤ OPT(S) + c₂ (C+1)/(as) η^{1/(4q)} + c₂ r`. -/
def LocalSpec {d : ℕ} (k : ℕ) (C q c1 c2 : ℝ) (Hcls : Set (Set (Pt d)))
    (D Dstar : Measure (Pt d)) (Hstar : Set (Pt d))
    (L : Set (Pt d) → ℝ → ℝ → ℝ → ℝ → Set (Pt d)) : Prop :=
  ∀ (S : Set (Pt d)) (a s η r : ℝ), MeasurableSet S →
    0 < a → a ≤ 1 → 0 < s → s ≤ 1 → 0 < r → r < 1 → 0 ≤ η →
    GenSmooth (cond Dstar S) (cond D S) s q →
    a ≤ (cond Dstar S Hstar).toReal →
    ApproxErr k C Hcls (cond D S) η →
    η ≤ c1 * (a * s / (C + 1)) ^ (2 * q) →
      IsPTF k (L S a s η r) ∧
      (cond Dstar S (Hstar \ L S a s η r)).toReal
          ≤ c2 * (C + 1) / (a * s) * η ^ (1 / (4 * q)) ∧
      (cond D S (L S a s η r)).toReal
          ≤ OPT Hcls D Dstar Hstar S + c2 * (C + 1) / (a * s) * η ^ (1 / (4 * q)) + c2 * r

/-- The nested restriction algorithm, run on the success events of its subroutines.
State after `i` rounds: the current region `Sᵢ₊₁` and a `stopped` flag. In round `i`, if
already stopped nothing changes; if the fresh estimate `est i Sᵢ` of `𝒟(Sᵢ)` is below the
threshold `θ`, stop (output `Sᵢ`); otherwise set `Sᵢ₊₁ := Sᵢ ∩ loc(Sᵢ)`. -/
def nestedRun {d : ℕ} (loc : Set (Pt d) → Set (Pt d)) (est : ℕ → Set (Pt d) → ℝ)
    (θ : ℝ) : ℕ → Set (Pt d) × Bool
  | 0 => (Set.univ, false)
  | i + 1 =>
    let st := nestedRun loc est θ i
    if st.2 = true then st
    else if est i st.1 < θ then (st.1, true)
    else (st.1 ∩ loc st.1, false)

/-! ## Lemma stubs (rubric items) -/

/-- Restriction invariant (smoothness): if `𝒟*(S) ≥ m > 0` then the conditioned pair
`(𝒟*_S, 𝒟_S)` is `(mσ, q)`-smooth. (With `m = 5α/6` this gives `s = 5ασ/6`.) [SmoothedAnalysisOfLearning, node_20] -/
theorem cond_genSmooth {d : ℕ} (Dstar D : Measure (Pt d)) [IsProbabilityMeasure Dstar]
    [IsProbabilityMeasure D] (σ q m : ℝ) (hσ : 0 < σ) (hq : 1 ≤ q) (hm : 0 < m)
    (hsm : GenSmooth Dstar D σ q) (S : Set (Pt d)) (hS : MeasurableSet S)
    (hmass : m ≤ (Dstar S).toReal) :
    GenSmooth (cond Dstar S) (cond D S) (m * σ) q := by
  sorry

/-- Restriction invariant (positive mass): `𝒟*_S(H*) ≥ 𝒟*(S ∩ H*)`. [SmoothedAnalysisOfLearning, node_20] -/
theorem cond_posMass {d : ℕ} (Dstar : Measure (Pt d)) [IsProbabilityMeasure Dstar]
    (S Hstar : Set (Pt d)) (hS : MeasurableSet S) (hH : MeasurableSet Hstar) :
    (Dstar (S ∩ Hstar)).toReal ≤ (cond Dstar S Hstar).toReal := by
  sorry

/-- Restriction invariant (reference mass): smoothness turns a lower bound on `𝒟*(S)`
into `𝒟(S) ≥ (mσ)^q`. [SmoothedAnalysisOfLearning, node_20] -/
theorem refMass_lower {d : ℕ} (Dstar D : Measure (Pt d)) [IsProbabilityMeasure Dstar]
    [IsProbabilityMeasure D] (σ q m : ℝ) (hσ : 0 < σ) (hq : 1 ≤ q) (hm : 0 < m)
    (hsm : GenSmooth Dstar D σ q) (S : Set (Pt d)) (hS : MeasurableSet S)
    (hmass : m ≤ (Dstar S).toReal) :
    (m * σ) ^ q ≤ (D S).toReal := by
  sorry

/-- Restriction invariant (approximation): the restricted approximation error grows by
at most the factor `1/𝒟(S)`. [SmoothedAnalysisOfLearning, node_20] -/
theorem approxErr_cond {d : ℕ} (k : ℕ) (C ζ : ℝ) (Hcls : Set (Set (Pt d)))
    (D : Measure (Pt d)) [IsProbabilityMeasure D] (S : Set (Pt d))
    (hS : MeasurableSet S) (hpos : 0 < (D S).toReal) (happ : ApproxErr k C Hcls D ζ) :
    ApproxErr k C Hcls (cond D S) (ζ / (D S).toReal) := by
  sorry

/-- Feasibility of the target: `OPT(S) ≤ 𝒟_S(H*)` whenever `𝒟*(S ∩ H*) > 0`. [SmoothedAnalysisOfLearning, node_20] -/
theorem opt_le_target {d : ℕ} (Hcls : Set (Set (Pt d))) (D Dstar : Measure (Pt d))
    [IsProbabilityMeasure D] [IsProbabilityMeasure Dstar] (Hstar S : Set (Pt d))
    (hHmem : Hstar ∈ Hcls) (hH : MeasurableSet Hstar) (hS : MeasurableSet S)
    (hpos : 0 < Dstar (S ∩ Hstar)) :
    OPT Hcls D Dstar Hstar S ≤ (cond D S Hstar).toReal := by
  sorry

/-- False-negative accounting: along a nested sequence `S 0 = univ`, `S (i+1) ⊆ S i`,
with each step removing target mass `𝒟*((S i ∩ H*) \ S (i+1)) ≤ β`, the total target
mass lost after `T` steps is at most `Tβ`. [SmoothedAnalysisOfLearning, node_20] -/
theorem falseNeg_sum {d : ℕ} (Dstar : Measure (Pt d)) [IsProbabilityMeasure Dstar]
    (Hstar : Set (Pt d)) (S : ℕ → Set (Pt d)) (β : ℝ) (T : ℕ)
    (h0 : S 0 = Set.univ) (hmeas : ∀ i, MeasurableSet (S i))
    (hnest : ∀ i, S (i + 1) ⊆ S i)
    (hstep : ∀ i < T, (Dstar ((S i ∩ Hstar) \ S (i + 1))).toReal ≤ β) :
    (Dstar (Hstar \ S T)).toReal ≤ T * β := by
  sorry

/-- False-positive progress for one round: if `𝒟(S ∩ G) ≤ 𝒟(S ∩ H*) + β` (the local
objective guarantee multiplied by `𝒟(S)` and compared with the feasible `H*`), then
`𝒟((S ∩ G) \ H*) ≤ 𝒟(S ∩ H*) - 𝒟(S ∩ G ∩ H*) + β`. [SmoothedAnalysisOfLearning, node_20] -/
theorem falsePos_step {d : ℕ} (D : Measure (Pt d)) [IsProbabilityMeasure D]
    (Hstar S G : Set (Pt d)) (hH : MeasurableSet Hstar) (hS : MeasurableSet S)
    (hG : MeasurableSet G) (β : ℝ)
    (hobj : (D (S ∩ G)).toReal ≤ (D (S ∩ Hstar)).toReal + β) :
    (D ((S ∩ G) \ Hstar)).toReal
      ≤ (D (S ∩ Hstar)).toReal - (D (S ∩ G ∩ Hstar)).toReal + β := by
  sorry

/-- False-positive telescoping: if all `T ≥ 1` rounds execute along a nested sequence and
each satisfies the progress relation, then `𝒟(S_T \ H*) ≤ 1/T + β`. [SmoothedAnalysisOfLearning, node_20] -/
theorem falsePos_telescope {d : ℕ} (D : Measure (Pt d)) [IsProbabilityMeasure D]
    (Hstar : Set (Pt d)) (S : ℕ → Set (Pt d)) (β : ℝ) (T : ℕ) (hT : 1 ≤ T)
    (hH : MeasurableSet Hstar) (hmeas : ∀ i, MeasurableSet (S i))
    (hnest : ∀ i, S (i + 1) ⊆ S i)
    (hprog : ∀ i < T, (D (S (i + 1) \ Hstar)).toReal
      ≤ (D (S i ∩ Hstar)).toReal - (D (S (i + 1) ∩ Hstar)).toReal + β) :
    (D (S T \ Hstar)).toReal ≤ 1 / T + β := by
  sorry

/-- Output representation: after `n` rounds the region is an intersection of at most
`n` sets returned by the local routine. [SmoothedAnalysisOfLearning, node_20] -/
theorem nestedRun_intersection {d : ℕ} (k : ℕ) (loc : Set (Pt d) → Set (Pt d))
    (est : ℕ → Set (Pt d) → ℝ) (θ : ℝ) (hloc : ∀ S, IsPTF k (loc S)) (n : ℕ) :
    ∃ m ≤ n, ∃ G : Fin m → Set (Pt d), (∀ j, IsPTF k (G j)) ∧
      (nestedRun loc est θ n).1 = ⋂ j, G j := by
  sorry

/-! ## Main theorem -/

/-- Correctness of the nested restriction algorithm (on the success events of all local
calls and mass estimates). For the absolute constants `c₁, c₂ > 0` of the local routine
there is an absolute `c₀ > 0` such that, whenever `ζ ≤ c₀ (σαε)^{8q²+5q} / (C+1)^{4q}`,
there are an internal scale `γ > 0` and a local failure budget `r ∈ (0,1)`, depending only
on the known scalars, such that for every instance, every local routine meeting the local
specification and every mass estimator accurate to `γ/2`, the output `H` of
`T = ⌈1/γ⌉` rounds of nested restriction (stopping threshold `3γ/2`, local parameters
`a = 5α/6`, `s = 5ασ/6`, `η = ζ/γ`) is an intersection of at most `T` degree-`k` PTF sets
and satisfies `𝒟*(H △ H*) ≤ ε`. [SmoothedAnalysisOfLearning, node_20] -/
theorem nestedRestriction_correct (c1 c2 : ℝ) (hc1 : 0 < c1) (hc2 : 0 < c2) :
    ∃ c0 : ℝ, 0 < c0 ∧
    ∀ (d k : ℕ) (C ζ σ q α ε : ℝ),
      1 ≤ d → 1 ≤ k → 0 < C → 0 < ζ → 0 < σ → σ ≤ 1 → 1 ≤ q →
      0 < α → α ≤ 1 → 0 < ε → ε < α / 6 →
      ζ ≤ c0 * (σ * α * ε) ^ (8 * q ^ 2 + 5 * q) / (C + 1) ^ (4 * q) →
    ∃ γ r : ℝ, 0 < γ ∧ 0 < r ∧ r < 1 ∧
    ∀ (D Dstar : Measure (Pt d)) [IsProbabilityMeasure D] [IsProbabilityMeasure Dstar]
      (Hcls : Set (Set (Pt d))) (Hstar : Set (Pt d))
      (L : Set (Pt d) → ℝ → ℝ → ℝ → ℝ → Set (Pt d)) (est : ℕ → Set (Pt d) → ℝ),
      (∀ g ∈ Hcls, MeasurableSet g) → Hstar ∈ Hcls →
      GenSmooth Dstar D σ q →
      α ≤ (Dstar Hstar).toReal →
      ApproxErr k C Hcls D ζ →
      LocalSpec k C q c1 c2 Hcls D Dstar Hstar L →
      (∀ (i : ℕ) (S : Set (Pt d)), |est i S - (D S).toReal| ≤ γ / 2) →
      let T : ℕ := ⌈1 / γ⌉₊
      let H : Set (Pt d) :=
        (nestedRun (fun S => L S (5 * α / 6) (5 * α * σ / 6) (ζ / γ) r) est
          (3 * γ / 2) T).1
      (∃ m ≤ T, ∃ G : Fin m → Set (Pt d), (∀ j, IsPTF k (G j)) ∧ H = ⋂ j, G j) ∧
      (Dstar (symmDiff H Hstar)).toReal ≤ ε := by
  sorry

