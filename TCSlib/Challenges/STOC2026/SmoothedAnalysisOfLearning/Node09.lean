/-!
## Positive-only learning under generalized smoothness (improper learner)

`H` is a class of measurable subsets of `X` with VC dimension `≤ d`. The target `H⋆ ∈ H` and
the unknown distribution `D⋆` satisfy `D⋆(H⋆) > 0`; `P⋆ = D⋆(· | H⋆)`. The learner sees
`P ∼ (P⋆)^n` and, independently, `U ∼ D^n`, where the reference distribution `D` satisfies the
generalized smoothness condition `D⋆(A) ≤ σ⁻¹ D(A)^{1/q}` for all measurable `A`, with known
`σ ∈ (0,1]`, `q ≥ 1`.

Main theorem `positive_learning_generalized_smooth`: for every `ε, δ ∈ (0, 1/2)` there is
`n = Õ((d + log(1/δ))/(εσ)^{2q})` and a learner (a map from the two samples to a measurable
set, not necessarily in `H`) such that, for every admissible `D⋆, D, H⋆`,
`Pr[D⋆(Ĥ △ H⋆) > ε] ≤ δ`.

The combinatorial heart of the reference proof (the "removed-layer invariant" of the greedy
chain of constrained empirical minimizers) is stated as lemma stubs.
-/

namespace TCSChallenge.SmoothedAnalysisOfLearning.node_09

open MeasureTheory

/-- `H` shatters the finite set `S`: every subset `T ⊆ S` is cut out as `S ∩ G` by some
`G ∈ H`. -/
def ShattersSet {X : Type*} (H : Set (Set X)) (S : Finset X) : Prop :=
  ∀ T : Finset X, T ⊆ S → ∃ G ∈ H, ∀ x ∈ S, (x ∈ G ↔ x ∈ T)

/-- "`H` has VC dimension at most `d`": no finite set of size `> d` is shattered. -/
def HasVCDimAtMost {X : Type*} (H : Set (Set X)) (d : ℕ) : Prop :=
  ∀ S : Finset X, ShattersSet H S → S.card ≤ d

/-- Standard measurability assumption ("pointwise measurable class"): there is a countable
subclass `H₀ ⊆ H` such that every `G ∈ H` is the pointwise limit of a sequence in `H₀`, i.e.
for each point `x`, membership of `x` in `g k` eventually agrees with membership in `G`. -/
def PointwiseMeasurableClass {X : Type*} (H : Set (Set X)) : Prop :=
  ∃ H₀ : Set (Set X), H₀ ⊆ H ∧ H₀.Countable ∧
    ∀ G ∈ H, ∃ g : ℕ → Set X, (∀ k, g k ∈ H₀) ∧
      ∀ x : X, ∃ K : ℕ, ∀ k, K ≤ k → (x ∈ g k ↔ x ∈ G)

/-- Generalized smoothness: "`D⋆(A) ≤ (1/σ) D(A)^{1/q}` for every measurable `A ⊆ X`". -/
def GenSmooth {X : Type*} [MeasurableSpace X] (Dstar D : Measure X) (σ q : ℝ) : Prop :=
  ∀ A : Set X, MeasurableSet A → (Dstar A).toReal ≤ (1 / σ) * ((D A).toReal) ^ (1 / q)

/-- A (possibly improper, non-efficient) learner with `n` samples from each source: it maps
the positive sample `P` and the reference sample `U` to a set `Ĥ ⊆ X`. -/
abbrev Learner (X : Type*) (n : ℕ) : Type _ := (Fin n → X) → (Fin n → X) → Set X

/-- The joint law of `(P, U)`: `P ∼ (D⋆ | H⋆)^n` independent of `U ∼ D^n`. -/
noncomputable def sampleLaw {X : Type*} [MeasurableSpace X] (n : ℕ) (Dstar D : Measure X)
    (Hstar : Set X) : Measure ((Fin n → X) × (Fin n → X)) :=
  (Measure.pi fun _ : Fin n => ProbabilityTheory.cond Dstar Hstar).prod
    (Measure.pi fun _ : Fin n => D)

/-- The symmetric difference `A △ B = (A \ B) ∪ (B \ A)`. -/
def symmDiffSet {X : Type*} (A B : Set X) : Set X := (A \ B) ∪ (B \ A)

/-! ### The greedy chain of constrained empirical minimizers (combinatorial core) -/

/-- Indices of reference points surviving the first `i` rounds:
`U_i = U ∩ Hs 0 ∩ ⋯ ∩ Hs (i-1)` (as a multiset, represented by indices). -/
def survivors {X : Type*} {n : ℕ} (U : Fin n → X) (Hs : ℕ → Set X) (i : ℕ) : Finset (Fin n) :=
  Finset.univ.filter (fun j => ∀ k, k < i → U j ∈ Hs k)

/-- Removed layer `R_i = U_{i} \ Hs i` (0-indexed round `i`). -/
def layer {X : Type*} {n : ℕ} (U : Fin n → X) (Hs : ℕ → Set X) (i : ℕ) : Finset (Fin n) :=
  (survivors U Hs i).filter (fun j => U j ∉ Hs i)

/-- "`G` contains every point of `P`" (feasibility). -/
def ContainsSample {X : Type*} {n : ℕ} (P : Fin n → X) (G : Set X) : Prop :=
  ∀ j, P j ∈ G

/-- `Hs 0, …, Hs (T-1)` is a greedy chain: in round `i`, `Hs i ∈ H` contains all of `P` and
minimizes `|U_i ∩ G|` over all `G ∈ H` containing all of `P`. -/
def IsGreedyChain {X : Type*} {n : ℕ} (H : Set (Set X)) (P U : Fin n → X) (T : ℕ)
    (Hs : ℕ → Set X) : Prop :=
  ∀ i, i < T → Hs i ∈ H ∧ ContainsSample P (Hs i) ∧
    ∀ G ∈ H, ContainsSample P G →
      ((survivors U Hs i).filter (fun j => U j ∈ Hs i)).card ≤
        ((survivors U Hs i).filter (fun j => U j ∈ G)).card

/-- Removed-layer invariant: layer sizes are nonincreasing, `|R_i| ≥ |R_{i+1}|`. [SmoothedAnalysisOfLearning, node_09] -/
theorem layer_card_antitone {X : Type*} {n : ℕ} (H : Set (Set X)) (P U : Fin n → X) (T : ℕ)
    (Hs : ℕ → Set X) (hchain : IsGreedyChain H P U T Hs) (i : ℕ) (hi : i + 1 < T) :
    (layer U Hs (i + 1)).card ≤ (layer U Hs i).card := by
  sorry

/-- The final layer has size at most `|U|/T`: `T · |R_{T-1}| ≤ n`. [SmoothedAnalysisOfLearning, node_09] -/
theorem final_layer_small {X : Type*} {n : ℕ} (H : Set (Set X)) (P U : Fin n → X) (T : ℕ)
    (hT : 1 ≤ T) (Hs : ℕ → Set X) (hchain : IsGreedyChain H P U T Hs) :
    T * (layer U Hs (T - 1)).card ≤ n := by
  sorry

/-- Empirical false-positive bound: if `H⋆ ∈ H` contains all of `P`, then the number of
reference points in `(⋂_{i<T} Hs i) \ H⋆` is at most `|U|/T`. [SmoothedAnalysisOfLearning, node_09] -/
theorem empirical_false_positive {X : Type*} {n : ℕ} (H : Set (Set X)) (P U : Fin n → X)
    (T : ℕ) (hT : 1 ≤ T) (Hs : ℕ → Set X) (hchain : IsGreedyChain H P U T Hs)
    (Hstar : Set X) (hHstar : Hstar ∈ H) (hPstar : ContainsSample P Hstar) :
    T * (Finset.univ.filter
        (fun j => (∀ k, k < T → U j ∈ Hs k) ∧ U j ∉ Hstar)).card ≤ n := by
  sorry

/-- VC dimension of the class of `T`-fold intersections of members of `H`, minus a fixed set
`H⋆`, is `O(d T log T)`: concretely `≤ C₀ d T log₂(2T)` for a universal `C₀`. [SmoothedAnalysisOfLearning, node_09] -/
theorem vc_Tfold_intersections :
    ∃ C₀ : ℕ, ∀ (X : Type) (H : Set (Set X)) (d : ℕ), HasVCDimAtMost H d →
      ∀ (T : ℕ) (Hstar : Set X), 1 ≤ T →
        HasVCDimAtMost
          {F : Set X | ∃ G : Fin T → Set X, (∀ i, G i ∈ H) ∧ F = (⋂ i, G i) \ Hstar}
          (C₀ * d * T * Nat.log 2 (2 * T)) := by
  sorry

/-! ### Main theorem -/

/-- **Positive-only learning under generalized smoothness.** For fixed `q ≥ 1` there are
constants `C, k` such that for every pointwise measurable class `H` of measurable sets with VC
dimension `≤ d`, every `σ ∈ (0,1]` and `ε, δ ∈ (0, 1/2)`, some
`n ≤ C · (d + log(1/δ))/(εσ)^{2q} · log(2 + d + 1/(εσδ))^k` admits a learner `L` with
measurable outputs such that for all probability measures `D⋆, D` and every `H⋆ ∈ H` with
`D⋆(H⋆) > 0` and `D⋆(A) ≤ σ⁻¹ D(A)^{1/q}`, the probability (over `P ∼ (D⋆|H⋆)^n`,
`U ∼ D^n`) that `D⋆(L(P,U) △ H⋆) > ε` is at most `δ`. [SmoothedAnalysisOfLearning, node_09] -/
theorem positive_learning_generalized_smooth (q : ℝ) (hq : 1 ≤ q) :
    ∃ C : ℝ, 0 < C ∧ ∃ k : ℕ,
      ∀ (X : Type) [MeasurableSpace X] (H : Set (Set X)) (d : ℕ),
        (∀ G ∈ H, MeasurableSet G) → PointwiseMeasurableClass H → HasVCDimAtMost H d →
        ∀ (σ ε δ : ℝ), 0 < σ → σ ≤ 1 → 0 < ε → ε < 1 / 2 → 0 < δ → δ < 1 / 2 →
        ∃ n : ℕ,
          (n : ℝ) ≤ C * (((d : ℝ) + Real.log (1 / δ)) / (ε * σ) ^ (2 * q)) *
            (Real.log (2 + (d : ℝ) + 1 / (ε * σ * δ))) ^ k ∧
          ∃ L : Learner X n, (∀ P U, MeasurableSet (L P U)) ∧
            ∀ (Dstar D : Measure X), IsProbabilityMeasure Dstar → IsProbabilityMeasure D →
            ∀ Hstar ∈ H, 0 < Dstar Hstar → GenSmooth Dstar D σ q →
              sampleLaw n Dstar D Hstar
                {ω | ENNReal.ofReal ε < Dstar (symmDiffSet (L ω.1 ω.2) Hstar)}
                ≤ ENNReal.ofReal δ := by
  sorry

end TCSChallenge.SmoothedAnalysisOfLearning.node_09
