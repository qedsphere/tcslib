/-!
## Proper positive-only learning under two-sided smoothness

`H` is a class of measurable subsets of `X` with VC dimension `≤ d`, `H⋆ ∈ H`, and the
distributions `D⋆, D` satisfy `σ D(S) ≤ D⋆(S) ≤ σ⁻¹ D(S)` for every measurable `S`, with known
`σ ∈ (0,1]`. Assume `D⋆(H⋆) > 0` and `P⋆ = D⋆(· | H⋆)`. The learner sees `n` i.i.d. points of
`P⋆` and, independently, `n` i.i.d. points of `D`.

Main theorem `positive_learning_two_sided_smooth`: for every `ε, δ ∈ (0, 1/2)` there is
`n = Õ((d + log(1/δ))/(εσ²))` and a learner with outputs in `H` such that for every admissible
`D⋆, D, H⋆`, `Pr[D⋆(Ĥ △ H⋆) > ε] ≤ δ`.
-/

namespace TCSChallenge.SmoothedAnalysisOfLearning.node_12

open MeasureTheory

/-- `H` shatters the finite set `S`: every subset `T ⊆ S` is cut out as `S ∩ G` by some
`G ∈ H`. -/
def ShattersSet {X : Type*} (H : Set (Set X)) (S : Finset X) : Prop :=
  ∀ T : Finset X, T ⊆ S → ∃ G ∈ H, ∀ x ∈ S, (x ∈ G ↔ x ∈ T)

/-- "`H` has VC dimension at most `d`": no finite set of size `> d` is shattered. -/
def HasVCDimAtMost {X : Type*} (H : Set (Set X)) (d : ℕ) : Prop :=
  ∀ S : Finset X, ShattersSet H S → S.card ≤ d

/-- Standard measurability assumption ("pointwise measurable class"): there is a countable
subclass `H₀ ⊆ H` such that every `G ∈ H` is the pointwise limit of a sequence in `H₀`, i.e.
for each point `x`, membership of `x` in `g k` eventually agrees with membership in `G`. -/
def PointwiseMeasurableClass {X : Type*} (H : Set (Set X)) : Prop :=
  ∃ H₀ : Set (Set X), H₀ ⊆ H ∧ H₀.Countable ∧
    ∀ G ∈ H, ∃ g : ℕ → Set X, (∀ k, g k ∈ H₀) ∧
      ∀ x : X, ∃ K : ℕ, ∀ k, K ≤ k → (x ∈ g k ↔ x ∈ G)

/-- A (possibly improper, non-efficient) learner with `n` samples from each source: it maps
the positive sample `P` and the reference sample `U` to a set `Ĥ ⊆ X`. -/
abbrev Learner (X : Type*) (n : ℕ) : Type _ := (Fin n → X) → (Fin n → X) → Set X

/-- The joint law of `(P, U)`: `P ∼ (D⋆ | H⋆)^n` independent of `U ∼ D^n`. -/
noncomputable def sampleLaw {X : Type*} [MeasurableSpace X] (n : ℕ) (Dstar D : Measure X)
    (Hstar : Set X) : Measure ((Fin n → X) × (Fin n → X)) :=
  (Measure.pi fun _ : Fin n => ProbabilityTheory.cond Dstar Hstar).prod
    (Measure.pi fun _ : Fin n => D)

/-- The symmetric difference `A △ B = (A \ B) ∪ (B \ A)`. -/
def symmDiffSet {X : Type*} (A B : Set X) : Set X := (A \ B) ∪ (B \ A)

/-- "`G` contains every point of `P`" (feasibility). -/
def ContainsSample {X : Type*} {n : ℕ} (P : Fin n → X) (G : Set X) : Prop :=
  ∀ j, P j ∈ G

/-- Two-sided smoothness: "`σ D(S) ≤ D⋆(S) ≤ (1/σ) D(S)` for every measurable `S ⊆ X`". -/
def TwoSidedSmooth {X : Type*} [MeasurableSpace X] (Dstar D : Measure X) (σ : ℝ) : Prop :=
  ∀ S : Set X, MeasurableSet S →
    σ * (D S).toReal ≤ (Dstar S).toReal ∧ (Dstar S).toReal ≤ (1 / σ) * (D S).toReal

/-- Number of reference points falling in `A`, i.e. `n · D̂_U(A)`. -/
def empCount {X : Type*} {n : ℕ} (U : Fin n → X) (A : Set X) : ℕ :=
  (Finset.univ.filter (fun j => U j ∈ A)).card

/-- The learner's rule: `Ĥ ∈ H` contains all of `P` and minimizes `D̂_U(G)` over all
`G ∈ H` containing all of `P`. -/
def IsConstrainedERM {X : Type*} {n : ℕ} (H : Set (Set X)) (P U : Fin n → X) (Hhat : Set X) :
    Prop :=
  Hhat ∈ H ∧ ContainsSample P Hhat ∧
    ∀ G ∈ H, ContainsSample P G → empCount U Hhat ≤ empCount U G

/-- Empirical comparison: if `H⋆` is feasible and `Ĥ` is a constrained empirical minimizer,
then `D̂_U(Ĥ \ H⋆) ≤ D̂_U(H⋆ \ Ĥ)`. [SmoothedAnalysisOfLearning, node_12] -/
theorem empirical_comparison {X : Type*} {n : ℕ} (H : Set (Set X)) (P U : Fin n → X)
    (Hhat Hstar : Set X) (hERM : IsConstrainedERM H P U Hhat) (hHstar : Hstar ∈ H)
    (hfeas : ContainsSample P Hstar) :
    empCount U (Hhat \ Hstar) ≤ empCount U (Hstar \ Hhat) := by
  sorry

/-- The false-positive class `{G \ H⋆ : G ∈ H}` has VC dimension at most `d`. [SmoothedAnalysisOfLearning, node_12] -/
theorem vc_falsePositive_class {X : Type*} (H : Set (Set X)) (d : ℕ) (hd : HasVCDimAtMost H d)
    (Hstar : Set X) : HasVCDimAtMost {F : Set X | ∃ G ∈ H, F = G \ Hstar} d := by
  sorry

/-- The false-negative class `{H⋆ \ G : G ∈ H}` has VC dimension at most `d`. [SmoothedAnalysisOfLearning, node_12] -/
theorem vc_falseNegative_class {X : Type*} (H : Set (Set X)) (d : ℕ) (hd : HasVCDimAtMost H d)
    (Hstar : Set X) : HasVCDimAtMost {F : Set X | ∃ G ∈ H, F = Hstar \ G} d := by
  sorry

/-- **Proper positive-only learning under two-sided smoothness.** There are absolute
constants `C, k` such that for every pointwise measurable class `H` of measurable sets with
VC dimension `≤ d`, every `σ ∈ (0,1]` and `ε, δ ∈ (0, 1/2)`, some
`n ≤ C · (d + log(1/δ))/(εσ²) · log(2 + d + 1/(εσδ))^k` admits a learner `L` with outputs in
`H` such that for all probability measures `D⋆, D` and every `H⋆ ∈ H` with `D⋆(H⋆) > 0` and
`σ D ≤ D⋆ ≤ σ⁻¹ D` on measurable sets, the probability (over `P ∼ (D⋆|H⋆)^n`, `U ∼ D^n`)
that `D⋆(L(P,U) △ H⋆) > ε` is at most `δ`. [SmoothedAnalysisOfLearning, node_12] -/
theorem positive_learning_two_sided_smooth :
    ∃ C : ℝ, 0 < C ∧ ∃ k : ℕ,
      ∀ (X : Type) [MeasurableSpace X] (H : Set (Set X)) (d : ℕ),
        H.Nonempty → (∀ G ∈ H, MeasurableSet G) → PointwiseMeasurableClass H →
        HasVCDimAtMost H d →
        ∀ (σ ε δ : ℝ), 0 < σ → σ ≤ 1 → 0 < ε → ε < 1 / 2 → 0 < δ → δ < 1 / 2 →
        ∃ n : ℕ,
          (n : ℝ) ≤ C * (((d : ℝ) + Real.log (1 / δ)) / (ε * σ ^ 2)) *
            (Real.log (2 + (d : ℝ) + 1 / (ε * σ * δ))) ^ k ∧
          ∃ L : Learner X n, (∀ P U, L P U ∈ H) ∧
            ∀ (Dstar D : Measure X), IsProbabilityMeasure Dstar → IsProbabilityMeasure D →
            ∀ Hstar ∈ H, 0 < Dstar Hstar → TwoSidedSmooth Dstar D σ →
              sampleLaw n Dstar D Hstar
                {ω | ENNReal.ofReal ε < Dstar (symmDiffSet (L ω.1 ω.2) Hstar)}
                ≤ ENNReal.ofReal δ := by
  sorry

end TCSChallenge.SmoothedAnalysisOfLearning.node_12
