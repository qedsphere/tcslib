/-!
## Bitwise-MAP list decoding of Reed–Muller codes below capacity

`RM(m,r)` is the code of evaluations of multilinear polynomials of degree `≤ r` over `𝔽₂^m`;
`f` is uniform on it and `Y = f + Z` with `Z` i.i.d. Bernoulli(ε), `0 < ε < 1/2`. Along a
sequence `(m_i,r_i)` with `m_i → ∞` and rates eventually below `1 - H(ε)`, assume the optimal
estimator of `f(0)` from `(Y(x))_{x≠0}` errs with probability `≤ K m^{-c√m}`. The decoder takes
the bitwise MAP word `f̂`, lists the codewords within `½·2^{m-(c/2)√m log₂ m}` of `f̂`, and
returns a uniformly random list member closest to `Y` (failure if the list is empty).

Main theorem: `TCSChallenge.AProofThatReed.node_22.rm_list_decoder_succeeds` — the decoder
returns `f` with probability `1 - O(2^{-(c/2)√m log₂ m})`.
-/

open Filter

namespace TCSChallenge.AProofThatReed.node_22

/-! ## Shared definitions (identical in every file of this paper) -/

/-- Points of `𝔽₂^ι` (for `ι = Fin m` this is `𝔽₂^m`). -/
abbrev Pt (ι : Type) := ι → ZMod 2

/-- Binary words of length `2^{|ι|}`, indexed by the points of `𝔽₂^ι`. -/
abbrev Word (ι : Type) := Pt ι → ZMod 2

/-- "`RM(m,r)` is the set of evaluation vectors `(p(x))_{x ∈ 𝔽₂^m}` of multilinear polynomials
`p ∈ 𝔽₂[X_1,…,X_m]` of degree at most `r`." A multilinear polynomial is a sum
`∑_S c_S ∏_{i∈S} X_i` over subsets `S`, and `deg p ≤ r` means `c_S = 0` whenever `|S| > r`. -/
noncomputable def RM (ι : Type) [Fintype ι] [DecidableEq ι] (r : ℕ) : Finset (Word ι) := by
  classical
  exact Finset.univ.filter (fun f : Word ι => ∃ coef : Finset ι → ZMod 2,
    (∀ S : Finset ι, r < S.card → coef S = 0) ∧
    ∀ x : Pt ι, f x = ∑ S : Finset ι, coef S * ∏ i ∈ S, x i)

/-- Binary entropy `H(p) = -p log₂ p - (1-p) log₂ (1-p)`. -/
noncomputable def binaryEntropy (p : ℝ) : ℝ :=
  -p * Real.logb 2 p - (1 - p) * Real.logb 2 (1 - p)

/-- Rate of `RM(d,s)`: `R(d,s) = 2^{-d} ∑_{j=0}^{min(s,d)} C(d,j)`. -/
noncomputable def rmRate (d s : ℕ) : ℝ :=
  (∑ j ∈ Finset.range (min s d + 1), (Nat.choose d j : ℝ)) / 2 ^ d

/-- BSC transition probability `Pr[Y = y | F = g] = ε^{d_H(g,y)} (1-ε)^{N - d_H(g,y)}`,
`N = 2^{|ι|}` the block length. -/
noncomputable def bscProb {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ) (g y : Word ι) : ℝ :=
  ε ^ hammingDist g y * (1 - ε) ^ (Fintype.card (Pt ι) - hammingDist g y)

/-- Unnormalised posterior weight of the event `F(u) = b` given `Y = y`, for `F` uniform on `C`:
`∑_{g ∈ C, g(u) = b} Pr[Y = y | F = g]` (the uniform prior `1/|C|` cancels in comparisons). -/
noncomputable def postWeight {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ) (C : Finset (Word ι))
    (y : Word ι) (u : Pt ι) (b : ZMod 2) : ℝ :=
  ∑ g ∈ C.filter (fun g => g u = b), bscProb ε g y

/-- Error probability of the bitwise MAP estimate of `F(u)` from the whole word `Y`, with fair
random tie-breaking, for `F` uniform on `C`: `∑_y min(Pr[F(u)=0,Y=y], Pr[F(u)=1,Y=y])`. -/
noncomputable def bitMAPError {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ)
    (C : Finset (Word ι)) (u : Pt ι) : ℝ :=
  (1 / (C.card : ℝ)) * ∑ y : Word ι, min (postWeight ε C y u 0) (postWeight ε C y u 1)

/-- "the optimal estimator of `F(u)` based only on `(Y(x))_{x ≠ u}`": its error probability
(fair tie-breaking) is `∑_{y'} min(Pr[F(u)=0, Y'=y'], Pr[F(u)=1, Y'=y'])` over punctured words
`y'`; we enumerate `y'` as the full words with `y(u) = 0`, and the likelihood ignores coordinate
`u` (exponent of `1-ε` is `N - 1 - #disagreements off u`). -/
noncomputable def puncturedMAPError {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ)
    (C : Finset (Word ι)) (u : Pt ι) : ℝ := by
  classical
  exact (1 / (C.card : ℝ)) * ∑ y ∈ Finset.univ.filter (fun y : Word ι => y u = 0),
    min (∑ g ∈ C.filter (fun g => g u = 0),
          ε ^ (Finset.univ.filter (fun x => x ≠ u ∧ g x ≠ y x)).card *
          (1 - ε) ^ (Fintype.card (Pt ι) - 1 - (Finset.univ.filter (fun x => x ≠ u ∧ g x ≠ y x)).card))
        (∑ g ∈ C.filter (fun g => g u = 1),
          ε ^ (Finset.univ.filter (fun x => x ≠ u ∧ g x ≠ y x)).card *
          (1 - ε) ^ (Fintype.card (Pt ι) - 1 - (Finset.univ.filter (fun x => x ≠ u ∧ g x ≠ y x)).card))

/-- Bitwise MAP estimate `h(Y)`: `h(Y)(u)` maximises `Pr[F(u) = b | Y]`; on a posterior tie it
uses the fair tie-breaking bit `t u` (the bits `t` are uniform and independent). -/
noncomputable def mapEstimate {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ)
    (C : Finset (Word ι)) (y t : Word ι) : Word ι := fun u =>
  if postWeight ε C y u 0 < postWeight ε C y u 1 then 1
  else if postWeight ε C y u 1 < postWeight ε C y u 0 then 0 else t u

/-- Codewords of `C` within (real) distance `ρ` of a word `w`. -/
noncomputable def ballList {ι : Type} [Fintype ι] [DecidableEq ι] (C : Finset (Word ι))
    (w : Word ι) (ρ : ℝ) : Finset (Word ι) := by
  classical
  exact C.filter (fun g => (hammingDist g w : ℝ) ≤ ρ)

/-- Members of `L` minimising `d_H(g, y)`. -/
noncomputable def argminDist {ι : Type} [Fintype ι] [DecidableEq ι] (L : Finset (Word ι))
    (y : Word ι) : Finset (Word ι) := by
  classical
  exact L.filter (fun g => ∀ g' ∈ L, hammingDist g y ≤ hammingDist g' y)

/-- Probability that "return a uniformly random minimiser, or `⊥` (= `none`) if the list is
empty" outputs `o`, given the minimiser set `M` and the list `L`. -/
noncomputable def selectProb {ι : Type} [Fintype ι] [DecidableEq ι] (L M : Finset (Word ι))
    (o : Option (Word ι)) : ℝ := by
  classical
  exact match o with
  | none => if L = ∅ then 1 else 0
  | some g => if g ∈ M then 1 / (M.card : ℝ) else 0

/-- List radius `½ · 2^{d - (a/2)√d log₂ d}`, `d = |ι|`. -/
noncomputable def listRadius (d : ℕ) (a : ℝ) : ℝ :=
  (1 / 2) * (2 : ℝ) ^ ((d : ℝ) - (a / 2) * Real.sqrt d * Real.logb 2 d)

/-- The decoder `D(d,s,Y;a)`: candidate list
`{g ∈ RM(d,s) : d_H(g, h(Y)) ≤ ½ 2^{d-(a/2)√d log₂ d}}` (with `h` the bitwise MAP under the
uniform prior on `RM(d,s)`), return a uniformly random member minimising `d_H(g,Y)`, `⊥` if empty.
This is the probability that `D` outputs `o` on received word `y`, averaging over its internal
randomness (uniform tie bits `t` for `h`, then uniform choice among minimisers). -/
noncomputable def decoderDProb {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ) (s : ℕ) (a : ℝ)
    (y : Word ι) (o : Option (Word ι)) : ℝ :=
  (1 / (2 : ℝ) ^ Fintype.card (Pt ι)) * ∑ t : Word ι,
    selectProb (ballList (RM ι s) (mapEstimate ε (RM ι s) y t) (listRadius (Fintype.card ι) a))
      (argminDist (ballList (RM ι s) (mapEstimate ε (RM ι s) y t) (listRadius (Fintype.card ι) a)) y)
      o

/-- The supplied weight-enumerator inequality: for `1 ≤ l ≤ s ≤ d`,
`|{g ∈ RM(d,s) : wt(g) ≤ 2^{d-l}}| ≤ 2^{∑_{j=l}^{s} [17 d (j-1)(j+2) + 17 (j+2) C(d-j+1, ≤ s-j+1)]}`.
(All subtractions are in `ℕ` but never truncate under `1 ≤ l ≤ j ≤ s ≤ d`.) -/
def WeightCountingBound : Prop :=
  ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (l s : ℕ), 1 ≤ l → l ≤ s → s ≤ Fintype.card ι →
    ((RM ι s).filter (fun g => hammingDist g 0 ≤ 2 ^ (Fintype.card ι - l))).card ≤
      2 ^ (∑ j ∈ Finset.Icc l s,
        (17 * Fintype.card ι * (j - 1) * (j + 2) +
          17 * (j + 2) * ∑ h ∈ Finset.range (s - j + 2), Nat.choose (Fintype.card ι - j + 1) h))

/-! ## Row-specific definitions -/

/-- Probability that the decoder `D(·, s, Y; a)` returns the transmitted word, for `F` uniform
on `RM(ι,s)` and `Y = F + Z`:
`(1/|C|) ∑_{f ∈ C} ∑_y Pr[Y = y | F = f] · Pr[D(y) = f]`. -/
noncomputable def successProbD (ι : Type) [Fintype ι] [DecidableEq ι] (ε : ℝ) (s : ℕ) (a : ℝ) :
    ℝ :=
  (1 / ((RM ι s).card : ℝ)) *
    ∑ f ∈ RM ι s, ∑ y : Word ι, bscProb ε f y * decoderDProb ε s a y (some f)

/-! ## Lemma stubs (rubric items) -/

/-- Rubric 1: every coordinate of the bitwise MAP word errs with probability at most
`e(m,r,ε)` (affine symmetry + "the full-`Y` MAP may ignore `Y(u)`"). The left side is
`Pr[f̂(u) ≠ f(u)]`, averaging over `f`, the channel and the tie bits. [AProofThatReed, node_22] -/
theorem coordinate_error_le_punctured (m r : ℕ) (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1 / 2)
    (u : Pt (Fin m)) :
    (1 / ((RM (Fin m) r).card : ℝ)) * ∑ f ∈ RM (Fin m) r, ∑ y : Word (Fin m),
      bscProb ε f y * ((1 / (2 : ℝ) ^ Fintype.card (Pt (Fin m))) *
        ∑ t ∈ Finset.univ.filter
          (fun t : Word (Fin m) => mapEstimate ε (RM (Fin m) r) y t u ≠ f u), (1 : ℝ)) ≤
    puncturedMAPError ε (RM (Fin m) r) 0 := by
  sorry

/-- Rubric 2: rates eventually below `R₀ < 1` force `r ≤ m/2 + B√m` eventually. [AProofThatReed, node_22] -/
theorem order_upper_bound (ms rs : ℕ → ℕ) (R₀ : ℝ) (hR₀ : R₀ < 1)
    (hrate : ∀ᶠ i in atTop, rmRate (ms i) (rs i) ≤ R₀) :
    ∃ B : ℝ, 0 < B ∧ ∀ᶠ i in atTop, (rs i : ℝ) ≤ (ms i : ℝ) / 2 + B * Real.sqrt (ms i) := by
  sorry

/-- Rubric 3: pairwise channel comparison, ties included:
`Pr_Z[d_H(Z,h) ≤ d_H(Z,0)] ≤ (4ε(1-ε))^{|h|/2}`. [AProofThatReed, node_22] -/
theorem pairwise_comparison_bound {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ)
    (hε0 : 0 < ε) (hε1 : ε < 1 / 2) (h : Word ι) :
    ∑ z ∈ Finset.univ.filter (fun z : Word ι => hammingDist z h ≤ hammingDist z 0),
      bscProb ε 0 z ≤ (4 * ε * (1 - ε)) ^ ((hammingDist h 0 : ℝ) / 2) := by
  sorry

open Classical in
/-- Rubrics 4–5: nearby-competitor exclusion. For orders `s ≤ d/2 + K√d` and radius
`2^{d - b√d log₂ d}`, the noise event "some nonzero `h ∈ RM(d,s)` of weight `≤` the radius with
`d_H(Z,h) ≤ d_H(Z,0)`" has probability `≤ 2^{-2^{d/3}}` for all large `d`. [AProofThatReed, node_22] -/
theorem nearby_competitor_bound (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1 / 2)
    (hcount : WeightCountingBound) (b K : ℝ) (hb : 0 < b) (hK : 0 < K) :
    ∃ N : ℕ, ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (s : ℕ), N ≤ Fintype.card ι →
      (s : ℝ) ≤ (Fintype.card ι : ℝ) / 2 + K * Real.sqrt (Fintype.card ι) →
      ∑ z ∈ Finset.univ.filter (fun z : Word ι => ∃ h ∈ RM ι s, h ≠ 0 ∧
          (hammingDist h 0 : ℝ) ≤
            (2 : ℝ) ^ ((Fintype.card ι : ℝ) - b * Real.sqrt (Fintype.card ι) *
              Real.logb 2 (Fintype.card ι)) ∧
          hammingDist z h ≤ hammingDist z 0),
        bscProb ε 0 z ≤
          (2 : ℝ) ^ (-((2 : ℝ) ^ ((Fintype.card ι : ℝ) / 3))) := by
  sorry

/-! ## Main theorem -/

/-- Rubric 6 / the claim: the bitwise-MAP list decoder with radius
`½ · 2^{m-(c/2)√m log₂ m}` returns `f` with probability `1 - O(2^{-(c/2)√m log₂ m})`. [AProofThatReed, node_22] -/
theorem rm_list_decoder_succeeds (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1 / 2)
    (ms rs : ℕ → ℕ) (hm : Tendsto ms atTop atTop) (hrm : ∀ i, rs i ≤ ms i)
    (hrate : ∃ R₀ : ℝ, R₀ < 1 - binaryEntropy ε ∧
      ∀ᶠ i in atTop, rmRate (ms i) (rs i) ≤ R₀)
    (c K : ℝ) (hc : 0 < c)
    (hbit : ∀ᶠ i in atTop, puncturedMAPError ε (RM (Fin (ms i)) (rs i)) 0 ≤
      K * (ms i : ℝ) ^ (-(c * Real.sqrt (ms i))))
    (hcount : WeightCountingBound) :
    ∃ C : ℝ, ∀ᶠ i in atTop,
      1 - successProbD (Fin (ms i)) ε (rs i) c ≤
        C * (2 : ℝ) ^ (-((c / 2) * Real.sqrt (ms i) * Real.logb 2 (ms i))) := by
  sorry

end TCSChallenge.AProofThatReed.node_22
