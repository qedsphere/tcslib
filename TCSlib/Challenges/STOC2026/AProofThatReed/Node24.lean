/-!
## Error amplification by slicing: doubly-exponential block error for RM codes

The decoder `G(m,r,Y;c,c')` splits `[m]` into `q = ⌈√m / c⌉` balanced blocks `S_j`, runs the
bitwise-MAP list decoder `D(m-|S_j|, r, Y_{S_j,v}; c')` on every slice `{z : z_{S_j} = v}`,
takes the pointwise majority `F̂` of the `q` slice answers (`⊥ ↦ 0`), and returns the codeword
of `RM(m,r)` closest to `Y` among those within `½·2^{m-√m log₂ m}` of `F̂`.

Main theorem: `TCSChallenge.AProofThatReed.node_24.recursive_decoder_doubly_exponential` —
below capacity, `Pr[G ≠ F] = O(2^{-2^{c''√m}})` for suitable `c, c', c'' > 0`.
-/

open Filter

namespace TCSChallenge.AProofThatReed.node_24

/-! ## Shared definitions (identical in every file of this paper) -/

/-- Points of `𝔽₂^ι` (for `ι = Fin m` this is `𝔽₂^m`). -/
abbrev Pt (ι : Type) := ι → ZMod 2

/-- Binary words of length `2^{|ι|}`, indexed by the points of `𝔽₂^ι`. -/
abbrev Word (ι : Type) := Pt ι → ZMod 2

/-- "`RM(m,r)` is the set of evaluation vectors `(p(x))_{x ∈ 𝔽₂^m}` of multilinear polynomials
`p ∈ 𝔽₂[X_1,…,X_m]` of degree at most `r`." A multilinear polynomial is a sum
`∑_S c_S ∏_{i∈S} X_i` over subsets `S`, and `deg p ≤ r` means `c_S = 0` whenever `|S| > r`. -/
noncomputable def RM (ι : Type) [Fintype ι] [DecidableEq ι] (r : ℕ) : Finset (Word ι) := by
  classical
  exact Finset.univ.filter (fun f : Word ι => ∃ coef : Finset ι → ZMod 2,
    (∀ S : Finset ι, r < S.card → coef S = 0) ∧
    ∀ x : Pt ι, f x = ∑ S : Finset ι, coef S * ∏ i ∈ S, x i)

/-- Binary entropy `H(p) = -p log₂ p - (1-p) log₂ (1-p)`. -/
noncomputable def binaryEntropy (p : ℝ) : ℝ :=
  -p * Real.logb 2 p - (1 - p) * Real.logb 2 (1 - p)

/-- Rate of `RM(d,s)`: `R(d,s) = 2^{-d} ∑_{j=0}^{min(s,d)} C(d,j)`. -/
noncomputable def rmRate (d s : ℕ) : ℝ :=
  (∑ j ∈ Finset.range (min s d + 1), (Nat.choose d j : ℝ)) / 2 ^ d

/-- BSC transition probability `Pr[Y = y | F = g] = ε^{d_H(g,y)} (1-ε)^{N - d_H(g,y)}`,
`N = 2^{|ι|}` the block length. -/
noncomputable def bscProb {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ) (g y : Word ι) : ℝ :=
  ε ^ hammingDist g y * (1 - ε) ^ (Fintype.card (Pt ι) - hammingDist g y)

/-- Unnormalised posterior weight of the event `F(u) = b` given `Y = y`, for `F` uniform on `C`:
`∑_{g ∈ C, g(u) = b} Pr[Y = y | F = g]` (the uniform prior `1/|C|` cancels in comparisons). -/
noncomputable def postWeight {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ) (C : Finset (Word ι))
    (y : Word ι) (u : Pt ι) (b : ZMod 2) : ℝ :=
  ∑ g ∈ C.filter (fun g => g u = b), bscProb ε g y

/-- Error probability of the bitwise MAP estimate of `F(u)` from the whole word `Y`, with fair
random tie-breaking, for `F` uniform on `C`: `∑_y min(Pr[F(u)=0,Y=y], Pr[F(u)=1,Y=y])`. -/
noncomputable def bitMAPError {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ)
    (C : Finset (Word ι)) (u : Pt ι) : ℝ :=
  (1 / (C.card : ℝ)) * ∑ y : Word ι, min (postWeight ε C y u 0) (postWeight ε C y u 1)

/-- "the optimal estimator of `F(u)` based only on `(Y(x))_{x ≠ u}`": its error probability
(fair tie-breaking) is `∑_{y'} min(Pr[F(u)=0, Y'=y'], Pr[F(u)=1, Y'=y'])` over punctured words
`y'`; we enumerate `y'` as the full words with `y(u) = 0`, and the likelihood ignores coordinate
`u` (exponent of `1-ε` is `N - 1 - #disagreements off u`). -/
noncomputable def puncturedMAPError {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ)
    (C : Finset (Word ι)) (u : Pt ι) : ℝ := by
  classical
  exact (1 / (C.card : ℝ)) * ∑ y ∈ Finset.univ.filter (fun y : Word ι => y u = 0),
    min (∑ g ∈ C.filter (fun g => g u = 0),
          ε ^ (Finset.univ.filter (fun x => x ≠ u ∧ g x ≠ y x)).card *
          (1 - ε) ^ (Fintype.card (Pt ι) - 1 - (Finset.univ.filter (fun x => x ≠ u ∧ g x ≠ y x)).card))
        (∑ g ∈ C.filter (fun g => g u = 1),
          ε ^ (Finset.univ.filter (fun x => x ≠ u ∧ g x ≠ y x)).card *
          (1 - ε) ^ (Fintype.card (Pt ι) - 1 - (Finset.univ.filter (fun x => x ≠ u ∧ g x ≠ y x)).card))

/-- Bitwise MAP estimate `h(Y)`: `h(Y)(u)` maximises `Pr[F(u) = b | Y]`; on a posterior tie it
uses the fair tie-breaking bit `t u` (the bits `t` are uniform and independent). -/
noncomputable def mapEstimate {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ)
    (C : Finset (Word ι)) (y t : Word ι) : Word ι := fun u =>
  if postWeight ε C y u 0 < postWeight ε C y u 1 then 1
  else if postWeight ε C y u 1 < postWeight ε C y u 0 then 0 else t u

/-- Codewords of `C` within (real) distance `ρ` of a word `w`. -/
noncomputable def ballList {ι : Type} [Fintype ι] [DecidableEq ι] (C : Finset (Word ι))
    (w : Word ι) (ρ : ℝ) : Finset (Word ι) := by
  classical
  exact C.filter (fun g => (hammingDist g w : ℝ) ≤ ρ)

/-- Members of `L` minimising `d_H(g, y)`. -/
noncomputable def argminDist {ι : Type} [Fintype ι] [DecidableEq ι] (L : Finset (Word ι))
    (y : Word ι) : Finset (Word ι) := by
  classical
  exact L.filter (fun g => ∀ g' ∈ L, hammingDist g y ≤ hammingDist g' y)

/-- Probability that "return a uniformly random minimiser, or `⊥` (= `none`) if the list is
empty" outputs `o`, given the minimiser set `M` and the list `L`. -/
noncomputable def selectProb {ι : Type} [Fintype ι] [DecidableEq ι] (L M : Finset (Word ι))
    (o : Option (Word ι)) : ℝ := by
  classical
  exact match o with
  | none => if L = ∅ then 1 else 0
  | some g => if g ∈ M then 1 / (M.card : ℝ) else 0

/-- List radius `½ · 2^{d - (a/2)√d log₂ d}`, `d = |ι|`. -/
noncomputable def listRadius (d : ℕ) (a : ℝ) : ℝ :=
  (1 / 2) * (2 : ℝ) ^ ((d : ℝ) - (a / 2) * Real.sqrt d * Real.logb 2 d)

/-- The decoder `D(d,s,Y;a)`: candidate list
`{g ∈ RM(d,s) : d_H(g, h(Y)) ≤ ½ 2^{d-(a/2)√d log₂ d}}` (with `h` the bitwise MAP under the
uniform prior on `RM(d,s)`), return a uniformly random member minimising `d_H(g,Y)`, `⊥` if empty.
This is the probability that `D` outputs `o` on received word `y`, averaging over its internal
randomness (uniform tie bits `t` for `h`, then uniform choice among minimisers). -/
noncomputable def decoderDProb {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ) (s : ℕ) (a : ℝ)
    (y : Word ι) (o : Option (Word ι)) : ℝ :=
  (1 / (2 : ℝ) ^ Fintype.card (Pt ι)) * ∑ t : Word ι,
    selectProb (ballList (RM ι s) (mapEstimate ε (RM ι s) y t) (listRadius (Fintype.card ι) a))
      (argminDist (ballList (RM ι s) (mapEstimate ε (RM ι s) y t) (listRadius (Fintype.card ι) a)) y)
      o

/-- The supplied weight-enumerator inequality: for `1 ≤ l ≤ s ≤ d`,
`|{g ∈ RM(d,s) : wt(g) ≤ 2^{d-l}}| ≤ 2^{∑_{j=l}^{s} [17 d (j-1)(j+2) + 17 (j+2) C(d-j+1, ≤ s-j+1)]}`.
(All subtractions are in `ℕ` but never truncate under `1 ≤ l ≤ j ≤ s ≤ d`.) -/
def WeightCountingBound : Prop :=
  ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (l s : ℕ), 1 ≤ l → l ≤ s → s ≤ Fintype.card ι →
    ((RM ι s).filter (fun g => hammingDist g 0 ≤ 2 ^ (Fintype.card ι - l))).card ≤
      2 ^ (∑ j ∈ Finset.Icc l s,
        (17 * Fintype.card ι * (j - 1) * (j + 2) +
          17 * (j + 2) * ∑ h ∈ Finset.range (s - j + 2), Nat.choose (Fintype.card ι - j + 1) h))

/-! ## Row-specific definitions -/

/-- The supplied bit-estimation estimate: for every sequence of variable sets `ι k` (of size
`d_k → ∞`) and orders `s_k` with rates eventually below some `R₀ < 1 - H(ε)`, there are
`a, A > 0` with `max_u Pr[h(Y)(u) ≠ F(u)] ≤ A·2^{-a√d_k log₂ d_k}` eventually, for `F` uniform
on `RM(d_k,s_k)`. -/
def BitEstimationHyp (ε : ℝ) : Prop :=
  ∀ (ι : ℕ → Type) [∀ k, Fintype (ι k)] [∀ k, DecidableEq (ι k)] (s : ℕ → ℕ),
    Tendsto (fun k => Fintype.card (ι k)) atTop atTop →
    (∃ R₀ : ℝ, R₀ < 1 - binaryEntropy ε ∧
      ∀ᶠ k in atTop, rmRate (Fintype.card (ι k)) (s k) ≤ R₀) →
    ∃ a A : ℝ, 0 < a ∧ 0 < A ∧ ∀ᶠ k in atTop, ∀ u : Pt (ι k),
      bitMAPError ε (RM (ι k) (s k)) u ≤
        A * (2 : ℝ) ^ (-(a * Real.sqrt (Fintype.card (ι k)) *
          Real.logb 2 (Fintype.card (ι k))))

/-- "a partition `[m] = S_1 ⊔ ⋯ ⊔ S_q` whose part sizes differ by at most one". -/
def IsBalancedPartition {m q : ℕ} (S : Fin q → Finset (Fin m)) : Prop :=
  (∀ j k : Fin q, j ≠ k → Disjoint (S j) (S k)) ∧ (∀ i : Fin m, ∃ j : Fin q, i ∈ S j) ∧
    ∀ j k : Fin q, (S j).card ≤ (S k).card + 1

/-- The point `z ∈ 𝔽₂^m` with `z_S = v` and `z_{[m]∖S} = w`. -/
def glue {m : ℕ} (S : Finset (Fin m)) (v : {i // i ∈ S} → ZMod 2)
    (w : {i // i ∉ S} → ZMod 2) : Pt (Fin m) :=
  fun i => if h : i ∈ S then v ⟨i, h⟩ else w ⟨i, h⟩

/-- `Y_{S,v}`: restriction of `Y` to `{z : z_S = v}`, as a word on `𝔽₂^{[m]∖S}`. -/
def sliceWord {m : ℕ} (S : Finset (Fin m)) (Y : Word (Fin m)) (v : {i // i ∈ S} → ZMod 2) :
    Word {i // i ∉ S} :=
  fun w => Y (glue S v w)

/-- `z_S`. -/
def restrIn {m : ℕ} (S : Finset (Fin m)) (z : Pt (Fin m)) : {i // i ∈ S} → ZMod 2 :=
  fun i => z i.1

/-- `z_{[m]∖S}`. -/
def restrOut {m : ℕ} (S : Finset (Fin m)) (z : Pt (Fin m)) : {i // i ∉ S} → ZMod 2 :=
  fun i => z i.1

/-- A joint outcome of all slice calls: `W j v ∈ RM(·) ∪ {⊥}` (`none = ⊥`). -/
abbrev SliceOutputs {m q : ℕ} (S : Fin q → Finset (Fin m)) : Type :=
  (j : Fin q) → ({i // i ∈ S j} → ZMod 2) → Option (Word {i // i ∉ S j})

/-- Vote of block `j` at `z`: `W_{j,z_{S_j}}(z_{[m]∖S_j})`, with `⊥` read as the zero function. -/
def sliceVote {m q : ℕ} (S : Fin q → Finset (Fin m)) (W : SliceOutputs S) (j : Fin q)
    (z : Pt (Fin m)) : ZMod 2 :=
  match W j (restrIn (S j) z) with
  | none => 0
  | some g => g (restrOut (S j) z)

/-- `F̂(z) = Maj_j(vote_j(z))`; an exact tie uses the (arbitrary) tie word. -/
def majorityEstimate {m q : ℕ} (S : Fin q → Finset (Fin m)) (W : SliceOutputs S)
    (tie : Word (Fin m)) : Word (Fin m) := fun z =>
  if q < 2 * (Finset.univ.filter (fun j : Fin q => sliceVote S W j z = 1)).card then 1
  else if 2 * (Finset.univ.filter (fun j : Fin q => sliceVote S W j z = 1)).card < q then 0
  else tie z

/-- Final radius `½ · 2^{m - √m log₂ m}`. -/
noncomputable def finalRadius (m : ℕ) : ℝ :=
  (1 / 2) * (2 : ℝ) ^ ((m : ℝ) - Real.sqrt m * Real.logb 2 m)

/-- `Pr[G(m,r,Y;c,c') ≠ F]` for `F` uniform on `RM(m,r)`, `Y = F + Z`, the slice calls
`D(m-|S_j|, r, Y_{S_j,v}; c')` run with independent internal randomness (product of their
output laws), and adversarial tie-breaking: `G` succeeds only if `F` is the unique closest
member of `{g ∈ RM(m,r) : d_H(g, F̂) ≤ ½·2^{m-√m log₂ m}}`. -/
noncomputable def failProbG {m q : ℕ} (ε : ℝ) (r : ℕ) (c' : ℝ) (S : Fin q → Finset (Fin m))
    (tie : Word (Fin m) → Word (Fin m)) : ℝ := by
  classical
  exact (1 / ((RM (Fin m) r).card : ℝ)) *
    ∑ f ∈ RM (Fin m) r, ∑ Y : Word (Fin m), bscProb ε f Y *
      ∑ W : SliceOutputs S,
        (∏ j : Fin q, ∏ v : ({i // i ∈ S j} → ZMod 2),
          decoderDProb ε r c' (sliceWord (S j) Y v) (W j v)) *
        (if argminDist (ballList (RM (Fin m) r) (majorityEstimate S W (tie Y)) (finalRadius m)) Y
            = {f} then 0 else 1)

/-! ## Lemma stubs (rubric items) -/

/-- Rates eventually below `R₀ < 1` force `s ≤ d/2 + K√d` eventually (used for the original
code and every slice). [AProofThatReed, node_24] -/
theorem order_upper_bound (ms rs : ℕ → ℕ) (R₀ : ℝ) (hR₀ : R₀ < 1)
    (hrate : ∀ᶠ i in atTop, rmRate (ms i) (rs i) ≤ R₀) :
    ∃ B : ℝ, 0 < B ∧ ∀ᶠ i in atTop, (rs i : ℝ) ≤ (ms i : ℝ) / 2 + B * Real.sqrt (ms i) := by
  sorry

/-- Rubric 1 (capacity stability): deleting `t ≤ m` variables raises the rate by at most
`C₀ t / √(m-t)`. [AProofThatReed, node_24] -/
theorem rate_deletion_stability :
    ∃ C₀ : ℝ, 0 < C₀ ∧ ∀ m t r : ℕ, t < m →
      0 ≤ rmRate (m - t) r - rmRate m r ∧
        rmRate (m - t) r - rmRate m r ≤ C₀ * t / Real.sqrt ((m - t : ℕ) : ℝ) := by
  sorry

/-- Pairwise channel comparison, ties included: `Pr_Z[d_H(Z,h) ≤ d_H(Z,0)] ≤ (4ε(1-ε))^{|h|/2}`. [AProofThatReed, node_24] -/
theorem pairwise_comparison_bound {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ)
    (hε0 : 0 < ε) (hε1 : ε < 1 / 2) (h : Word ι) :
    ∑ z ∈ Finset.univ.filter (fun z : Word ι => hammingDist z h ≤ hammingDist z 0),
      bscProb ε 0 z ≤ (4 * ε * (1 - ε)) ^ ((hammingDist h 0 : ℝ) / 2) := by
  sorry

open Classical in
/-- Rubric 2: nearby-competitor exclusion. For `s ≤ d/2 + K√d` and radius `2^{d - b√d log₂ d}`,
`Pr_Z[∃ nonzero h ∈ RM(d,s), wt h ≤ radius, d_H(Z,h) ≤ d_H(Z,0)] ≤ 2^{-2^{d/3}}` for large `d`
(equivalently, for every fixed `f`, no `g ≠ f` nearby is at least as close to `f + Z`). [AProofThatReed, node_24] -/
theorem nearby_competitor_bound (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1 / 2)
    (hcount : WeightCountingBound) (b K : ℝ) (hb : 0 < b) (hK : 0 < K) :
    ∃ N : ℕ, ∀ (ι : Type) [Fintype ι] [DecidableEq ι] (s : ℕ), N ≤ Fintype.card ι →
      (s : ℝ) ≤ (Fintype.card ι : ℝ) / 2 + K * Real.sqrt (Fintype.card ι) →
      ∑ z ∈ Finset.univ.filter (fun z : Word ι => ∃ h ∈ RM ι s, h ≠ 0 ∧
          (hammingDist h 0 : ℝ) ≤
            (2 : ℝ) ^ ((Fintype.card ι : ℝ) - b * Real.sqrt (Fintype.card ι) *
              Real.logb 2 (Fintype.card ι)) ∧
          hammingDist z h ≤ hammingDist z 0),
        bscProb ε 0 z ≤
          (2 : ℝ) ^ (-((2 : ℝ) ^ ((Fintype.card ι : ℝ) / 3))) := by
  sorry

/-- Rubric 3 (translation symmetry): shifting the received word by a codeword shifts the
output law of `D`, so its failure probability is the same for every transmitted codeword. [AProofThatReed, node_24] -/
theorem decoderD_translation_invariant {ι : Type} [Fintype ι] [DecidableEq ι] (ε : ℝ)
    (s : ℕ) (a : ℝ) (u : Word ι) (hu : u ∈ RM ι s) (y g : Word ι) :
    decoderDProb ε s a (y + u) (some (g + u)) = decoderDProb ε s a y (some g) := by
  sorry

open Classical in
/-- Rubric 5 (product-structure count): if the failed slices of block `j` form `E_j`, the
points lying in failed slices for at least half of the blocks number at most
`∑_{T ⊆ [q], |T| ≥ q/2} ∏_{j∈T} |E_j| ∏_{j∉T} 2^{|S_j|}`. [AProofThatReed, node_24] -/
theorem majority_error_count {m q : ℕ} (S : Fin q → Finset (Fin m))
    (hS : IsBalancedPartition S) (E : (j : Fin q) → Finset ({i // i ∈ S j} → ZMod 2)) :
    (Finset.univ.filter (fun z : Pt (Fin m) =>
        q ≤ 2 * (Finset.univ.filter (fun j : Fin q => restrIn (S j) z ∈ E j)).card)).card ≤
      ∑ T ∈ (Finset.univ : Finset (Finset (Fin q))).filter (fun T => q ≤ 2 * T.card),
        (∏ j ∈ T, (E j).card) * ∏ j ∈ Finset.univ \ T, 2 ^ (S j).card := by
  sorry

/-! ## Main theorem -/

/-- Rubric 6 / the claim: below capacity, the sliced majority decoder `G` with
`q = ⌈√m / c⌉` blocks fails with probability `O(2^{-2^{c''√m}})`. [AProofThatReed, node_24] -/
theorem recursive_decoder_doubly_exponential (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1 / 2)
    (hbit : BitEstimationHyp ε) (hcount : WeightCountingBound)
    (ms rs : ℕ → ℕ) (hm : Tendsto ms atTop atTop) (hpos : ∀ i, 0 < ms i ∧ 0 < rs i)
    (hrate : ∃ R₀ : ℝ, R₀ < 1 - binaryEntropy ε ∧
      ∀ᶠ i in atTop, rmRate (ms i) (rs i) ≤ R₀) :
    ∃ c c' c'' C : ℝ, 0 < c ∧ 0 < c' ∧ 0 < c'' ∧ ∀ᶠ i in atTop,
      ∀ S : Fin (Nat.ceil (Real.sqrt (ms i) / c)) → Finset (Fin (ms i)),
        IsBalancedPartition S →
        ∀ tie : Word (Fin (ms i)) → Word (Fin (ms i)),
          failProbG ε (rs i) c' S tie ≤
            C * (2 : ℝ) ^ (-((2 : ℝ) ^ (c'' * Real.sqrt (ms i)))) := by
  sorry

end TCSChallenge.AProofThatReed.node_24
