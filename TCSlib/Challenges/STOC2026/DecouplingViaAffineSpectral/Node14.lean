/-!
## Beck-Fiala discrepancy beyond Banaszczyk

Let `A ∈ {0,±1}^{m×n}` have at most `k` nonzero entries per column,
`disc(A) = min_{χ ∈ {±1}^n} ‖Aχ‖_∞`, `L = max{2, log n}`, `ℓ = max{1, log L}`. If
`b ≥ 1` satisfies `b² max{1, b/L} ≫ k √(Lℓ)` and `b ≫ √(kℓ)`, then `disc(A) = O(b)`.
Consequently every set system of column sparsity `k` has discrepancy
`O(√k · (log n)^{1/4} (log log n)^{1/4}) = Õ(k^{1/2} log^{1/4} n)`.

Main theorems: `TCSChallenge.DecouplingViaAffineSpectral.node_14.disc_le_of_parameters` and
`TCSChallenge.DecouplingViaAffineSpectral.node_14.disc_setSystem_le`.
-/

namespace TCSChallenge.DecouplingViaAffineSpectral.node_14

open Matrix

/-- "`diag(A)` denotes the diagonal matrix having the same diagonal as `A`." -/
def diagPart {ι : Type} [DecidableEq ι] (A : Matrix ι ι ℝ) : Matrix ι ι ℝ :=
  Matrix.diagonal (fun i => A i i)

/-- Loewner order `A ≼ B`: `B - A` is positive semidefinite. -/
def loewnerLE {ι : Type} [Fintype ι] (A B : Matrix ι ι ℝ) : Prop :=
  (B - A).PosSemidef

/-- `A ∈ {0, ±1}^{m×n}`. -/
def IsSignedIncidence {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ) : Prop :=
  ∀ i j, A i j = 0 ∨ A i j = 1 ∨ A i j = -1

/-- `A ∈ {0, 1}^{m×n}` (a set system). -/
def IsIncidence {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ) : Prop :=
  ∀ i j, A i j = 0 ∨ A i j = 1

/-- "at most `k` nonzero entries in each column". -/
def ColumnSparse {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ) (k : ℕ) : Prop :=
  ∀ j, (Finset.univ.filter (fun i => A i j ≠ 0)).card ≤ k

/-- `χ ∈ {-1, 1}^n`. -/
def IsColoring {n : ℕ} (χ : Fin n → ℤ) : Prop :=
  ∀ j, χ j = 1 ∨ χ j = -1

/-- `disc(A) ≤ D`, i.e. `min_χ ‖Aχ‖_∞ ≤ D` (the minimum over the finite set of colorings
is attained, so this is equivalent to the paper's definition). -/
def DiscAtMost {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ) (D : ℝ) : Prop :=
  ∃ χ : Fin n → ℤ, IsColoring χ ∧ ∀ i, |((∑ j, A i j * χ j : ℤ) : ℝ)| ≤ D

/-- `L := max{2, log n}`. -/
def Lpar (n : ℕ) : ℝ := max 2 (Real.log n)

/-- `ℓ := max{1, log L}`. -/
def ellPar (n : ℕ) : ℝ := max 1 (Real.log (Lpar n))

/-- Lemma stub (supplied fact 3, classical floating variables): column sparsity `k ≥ 1`
gives discrepancy at most `2k - 1`. [DecouplingViaAffineSpectral, node_14] -/
theorem beck_fiala_classical {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ)
    (hA : IsSignedIncidence A) (k : ℕ) (hk : 1 ≤ k) (hsp : ColumnSparse A k) :
    DiscAtMost A (2 * (k : ℝ) - 1) := by
  sorry

/-- Lemma stub (supplied fact 1, covariance feasibility with one affine constraint matrix):
`dim W ≤ δ h`, `F ∈ ℝ^{p×h}`, `r = max{1, p/h}`, `δ + κ + η + η₁ ≤ 1` give `U ≽ 0` with
`Uw = 0` on `W`, `U_jj ≤ 1`, `Tr U ≥ κ h`, `U ≼ η⁻¹ diag U`,
`F U Fᵀ ≼ (r/η₁) diag(F U Fᵀ)`. (Polynomial-time computability not captured.) [DecouplingViaAffineSpectral, node_14] -/
theorem covariance_feasibility (h p : ℕ) (hh : 1 ≤ h)
    (W : Submodule ℝ (Fin h → ℝ)) (F : Matrix (Fin p) (Fin h) ℝ) (δ κ η η₁ : ℝ)
    (hW : (Module.finrank ℝ W : ℝ) ≤ δ * h)
    (hδ : 0 < δ) (hκ : 0 < κ) (hη : 0 < η) (hη₁ : 0 < η₁)
    (hsum : δ + κ + η + η₁ ≤ 1) :
    ∃ U : Matrix (Fin h) (Fin h) ℝ,
      U.PosSemidef ∧
      (∀ w ∈ W, U *ᵥ w = 0) ∧
      (∀ j, U j j ≤ 1) ∧
      κ * (h : ℝ) ≤ U.trace ∧
      loewnerLE U (η⁻¹ • diagPart U) ∧
      loewnerLE (F * U * Fᵀ)
        ((max 1 ((p : ℝ) / h) / η₁) • diagPart (F * U * Fᵀ)) := by
  sorry

/-- Lemma stub (rubric item 5, asymptotics): `b₀ = C √k L^{1/4} ℓ^{1/4}` satisfies both
parameter inequalities for a suitable `C` depending only on `C₀`. [DecouplingViaAffineSpectral, node_14] -/
theorem simplified_parameter_admissible (C₀ : ℝ) (hC₀ : 0 < C₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ (n k : ℕ), 1 ≤ k →
      let b₀ := C * Real.sqrt k * (Lpar n) ^ ((1 : ℝ) / 4) * (ellPar n) ^ ((1 : ℝ) / 4)
      1 ≤ b₀ ∧
      C₀ * (k : ℝ) * Real.sqrt (Lpar n * ellPar n) ≤ b₀ ^ 2 * max 1 (b₀ / Lpar n) ∧
      C₀ * Real.sqrt ((k : ℝ) * ellPar n) ≤ b₀ := by
  sorry

/-- Main theorem (node_14, discrepancy core): there are universal constants `C₀, C₁` such
that whenever `b ≥ 1` satisfies `b² max{1, b/L} ≥ C₀ k √(Lℓ)` and `b ≥ C₀ √(kℓ)`, every
`{0,±1}` matrix of column sparsity `k` has `disc(A) ≤ C₁ b`. [DecouplingViaAffineSpectral, node_14] -/
theorem disc_le_of_parameters :
    ∃ C₀ C₁ : ℝ, 0 < C₀ ∧ 0 < C₁ ∧
      ∀ (m n k : ℕ) (A : Matrix (Fin m) (Fin n) ℤ),
        IsSignedIncidence A → ColumnSparse A k →
        ∀ b : ℝ, 1 ≤ b →
          C₀ * (k : ℝ) * Real.sqrt (Lpar n * ellPar n) ≤ b ^ 2 * max 1 (b / Lpar n) →
          C₀ * Real.sqrt ((k : ℝ) * ellPar n) ≤ b →
          DiscAtMost A (C₁ * b) := by
  sorry

/-- Main theorem (node_14, corollary): every `{0,1}` set system of column sparsity `k` has
discrepancy `O(√k · L^{1/4} ℓ^{1/4}) = Õ(k^{1/2} log^{1/4} n)`. [DecouplingViaAffineSpectral, node_14] -/
theorem disc_setSystem_le :
    ∃ C : ℝ, 0 < C ∧
      ∀ (m n k : ℕ) (A : Matrix (Fin m) (Fin n) ℤ),
        IsIncidence A → ColumnSparse A k →
          DiscAtMost A
            (C * Real.sqrt k * (Lpar n) ^ ((1 : ℝ) / 4) * (ellPar n) ^ ((1 : ℝ) / 4)) := by
  sorry

end TCSChallenge.DecouplingViaAffineSpectral.node_14
