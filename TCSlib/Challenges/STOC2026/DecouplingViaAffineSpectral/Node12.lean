## Affine spectral-independence covariance feasibility (decoupling SDP)

Let `h, q ≥ 1`, for each `s ∈ [q]` let `r_s ≥ 1` and `E_s ∈ ℝ^{r_s h × h}`, and let
`W ⊆ ℝ^h` be a subspace of dimension `δ h`. If `0 < κ, η, η_s < 1` and
`δ + κ + η + ∑_s η_s ≤ 1`, then there is a symmetric `U ∈ ℝ^{h×h}` with
`U ≽ 0`, `⟨w wᵀ, U⟩ = 0` for `w ∈ W`, `U_ii ≤ 1`, `Tr U ≥ κ h`, `U ≼ η⁻¹ diag(U)`, and
`E_s U E_sᵀ ≼ (r_s/η_s) diag(E_s U E_sᵀ)` for every `s`.

Main theorem: `TCSChallenge.DecouplingViaAffineSpectral.node_12.exists_decoupling_covariance`.
-/

namespace TCSChallenge.DecouplingViaAffineSpectral.node_12

open Matrix

/-- "`diag(A)` denotes the diagonal matrix having the same diagonal as `A`." -/
def diagPart {ι : Type} [DecidableEq ι] (A : Matrix ι ι ℝ) : Matrix ι ι ℝ :=
  Matrix.diagonal (fun i => A i i)

/-- Loewner order `A ≼ B`: `B - A` is positive semidefinite. -/
def loewnerLE {ι : Type} [Fintype ι] (A B : Matrix ι ι ℝ) : Prop :=
  (B - A).PosSemidef

/-- Lemma stub (rubric item 2, the key estimate `(∗)`): for a PSD matrix `G` of size
`r h × r h` and `0 < ρ < 1` there is a subspace `L ⊆ ℝ^{rh}` of codimension at most `ρ h`
on which `uᵀ G u ≤ (r/ρ) uᵀ diag(G) u`. Zero diagonal entries are allowed. [DecouplingViaAffineSpectral, node_12] -/
theorem spectral_subspace_estimate (r h : ℕ) (hr : 1 ≤ r) (ρ : ℝ) (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (G : Matrix (Fin (r * h)) (Fin (r * h)) ℝ) (hG : G.PosSemidef) :
    ∃ L : Submodule ℝ (Fin (r * h) → ℝ),
      ((r * h : ℕ) : ℝ) - ρ * (h : ℝ) ≤ (Module.finrank ℝ L : ℝ) ∧
      ∀ u ∈ L, u ⬝ᵥ (G *ᵥ u) ≤ ((r : ℝ) / ρ) * (u ⬝ᵥ (diagPart G *ᵥ u)) := by
  sorry

/-- Lemma stub (rubric item 2, pullback): the preimage of a subspace `L ⊆ ℝ^p` under
`E : ℝ^h → ℝ^p` has codimension at most the codimension of `L`. [DecouplingViaAffineSpectral, node_12] -/
theorem pullback_codim_le (p h : ℕ) (E : Matrix (Fin p) (Fin h) ℝ)
    (L : Submodule ℝ (Fin p → ℝ)) :
    (p : ℤ) - (Module.finrank ℝ L : ℤ) ≥
      (h : ℤ) - (Module.finrank ℝ (L.comap (Matrix.mulVecLin E)) : ℤ) := by
  sorry

/-- Main theorem (node_12). [DecouplingViaAffineSpectral, node_12] -/
theorem exists_decoupling_covariance
    (h q : ℕ) (hh : 1 ≤ h) (hq : 1 ≤ q)
    (r : Fin q → ℕ) (hr : ∀ s, 1 ≤ r s)
    (E : (s : Fin q) → Matrix (Fin (r s * h)) (Fin h) ℝ)
    (W : Submodule ℝ (Fin h → ℝ)) (δ κ η : ℝ) (ηs : Fin q → ℝ)
    (hW : (Module.finrank ℝ W : ℝ) ≤ δ * h)
    (hκ0 : 0 < κ) (hκ1 : κ < 1) (hη0 : 0 < η) (hη1 : η < 1)
    (hηs0 : ∀ s, 0 < ηs s) (hηs1 : ∀ s, ηs s < 1)
    (hsum : δ + κ + η + ∑ s, ηs s ≤ 1) :
    ∃ U : Matrix (Fin h) (Fin h) ℝ,
      U.IsSymm ∧
      U.PosSemidef ∧
      (∀ w ∈ W, w ⬝ᵥ (U *ᵥ w) = 0) ∧
      (∀ i, U i i ≤ 1) ∧
      κ * (h : ℝ) ≤ U.trace ∧
      loewnerLE U (η⁻¹ • diagPart U) ∧
      (∀ s, loewnerLE (E s * U * (E s)ᵀ)
        (((r s : ℝ) / ηs s) • diagPart (E s * U * (E s)ᵀ))) := by
  sorry

end TCSChallenge.DecouplingViaAffineSpectral.node_12
