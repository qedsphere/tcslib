/-!
## Sparsifying a sum of seminorms (`p = 1`)

Let `N₁,…,N_m` be seminorms on `ℝⁿ` and `N = ∑ᵢ Nᵢ`. A vector `w ∈ [0,∞)^m` is an
`ε`-approximation if `|N(x) − ∑ᵢ wᵢ Nᵢ(x)| ≤ ε N(x)` for every `x`. With
`log u = max{1, ln u}`, the main theorem `exists_sparse_approximation` states that every
such `N` admits a nonnegative `ε`-approximation of sparsity
`O(ε⁻² n log(n/ε) (log n)^{5/2})`, with a universal constant, assuming the supplied
concentration inequality for symmetric log-concave vectors with rate `√log(2d)`.

Lemma stubs: kernel invariance, the translation inequality for `exp(-G)` densities,
the operator estimate `sup_{G(z) ≤ 1} Q(z) ≤ (e+1) E Q(X)`, and `E G(X) = d`.
-/

namespace TCSChallenge.SparsifyingSumsOfNorms.node_04

open MeasureTheory

/-- A seminorm on `ℝⁿ`, as a predicate on a function: absolute homogeneity
`f (c • x) = |c| f x` and the triangle inequality (nonnegativity follows). -/
def IsSeminormFn {n : ℕ} (f : (Fin n → ℝ) → ℝ) : Prop :=
  (∀ (c : ℝ) (x : Fin n → ℝ), f (c • x) = |c| * f x) ∧
    ∀ x y : Fin n → ℝ, f (x + y) ≤ f x + f y

/-- A norm: a seminorm vanishing only at `0`. -/
def IsNormFn {n : ℕ} (f : (Fin n → ℝ) → ℝ) : Prop :=
  IsSeminormFn f ∧ ∀ x, f x = 0 → x = 0

/-- Truncated logarithm `log u = max{1, ln u}`. -/
def logT (u : ℝ) : ℝ := max 1 (Real.log u)

/-- Unnormalized measure with density `exp(-V)` with respect to Lebesgue measure on `ℝ^d`. -/
def expDensityMeasure {d : ℕ} (V : (Fin d → ℝ) → ℝ) : Measure (Fin d → ℝ) :=
  (volume : Measure (Fin d → ℝ)).withDensity (fun x => ENNReal.ofReal (Real.exp (-V x)))

/-- The supplied concentration fact: "for every symmetric log-concave random vector `X` in
`ℝ^d` and every seminorm `Q` with `a = E Q(X) > 0`,
`P(|Q(X) − a| > t) ≤ 2 exp(−c₀ t / (a · rate d))` for `t ≥ 0`."
Stated for densities `∝ exp(-V)` with `V` convex, even and `exp(-V)` integrable;
probabilities are written unnormalized (multiplied by `Z = ∫ exp(-V)`). -/
def LogConcaveConcentration (c₀ : ℝ) (rate : ℕ → ℝ) : Prop :=
  ∀ (d : ℕ) (V : (Fin d → ℝ) → ℝ), ConvexOn ℝ Set.univ V → (∀ x, V (-x) = V x) →
    Integrable (fun x => Real.exp (-V x)) →
    ∀ H : (Fin d → ℝ) → ℝ, IsSeminormFn H →
      0 < (∫ x, H x * Real.exp (-V x)) / (∫ x, Real.exp (-V x)) →
      ∀ t : ℝ, 0 ≤ t →
        expDensityMeasure V
            {x | t < |H x - (∫ y, H y * Real.exp (-V y)) / (∫ y, Real.exp (-V y))|} ≤
          ENNReal.ofReal (2 * Real.exp (-(c₀ * t) /
              (((∫ y, H y * Real.exp (-V y)) / (∫ y, Real.exp (-V y))) * rate d)) *
            ∫ y, Real.exp (-V y))

/-- Sum of the seminorms `N = ∑ᵢ Nᵢ`. -/
def sumNorm {n m : ℕ} (N : Fin m → (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) : ℝ :=
  ∑ i, N i x

/-- `w` is a nonnegative `ε`-approximation of `N = ∑ᵢ Nᵢ`. -/
def IsEpsApprox {n m : ℕ} (N : Fin m → (Fin n → ℝ) → ℝ) (ε : ℝ) (w : Fin m → ℝ) : Prop :=
  (∀ i, 0 ≤ w i) ∧
    ∀ x : Fin n → ℝ, |sumNorm N x - ∑ i, w i * N i x| ≤ ε * sumNorm N x

/-- Sparsity `|{i : wᵢ ≠ 0}|`. -/
def sparsity {m : ℕ} (w : Fin m → ℝ) : ℕ :=
  (Finset.univ.filter (fun i => w i ≠ 0)).card

/-- Every summand is invariant under translation by `ker N`. [SparsifyingSumsOfNorms, node_04] -/
theorem summand_kernel_invariant {n m : ℕ} (N : Fin m → (Fin n → ℝ) → ℝ)
    (hN : ∀ i, IsSeminormFn (N i)) (x z : Fin n → ℝ) (hz : sumNorm N z = 0) (i : Fin m) :
    N i (x + z) = N i x := by
  sorry

/-- Translation inequality (1): `μ_G(A + z) ≥ exp(−G(z)) μ_G(A)`. [SparsifyingSumsOfNorms, node_04] -/
theorem translation_inequality {d : ℕ} (G : (Fin d → ℝ) → ℝ) (hG : IsSeminormFn G)
    (A : Set (Fin d → ℝ)) (hA : MeasurableSet A) (z : Fin d → ℝ) :
    ENNReal.ofReal (Real.exp (-G z)) * expDensityMeasure G A ≤
      expDensityMeasure G {x | x - z ∈ A} := by
  sorry

/-- Operator estimate (2): `sup_{G(z) ≤ 1} Q(z) ≤ (e+1) E Q(X)` for `X ∼ μ_G`. [SparsifyingSumsOfNorms, node_04] -/
theorem operator_estimate {d : ℕ} (G Q : (Fin d → ℝ) → ℝ) (hG : IsNormFn G)
    (hQ : IsSeminormFn Q) (z : Fin d → ℝ) (hz : G z ≤ 1) :
    Q z ≤ (Real.exp 1 + 1) *
      ((∫ x, Q x * Real.exp (-G x)) / (∫ x, Real.exp (-G x))) := by
  sorry

/-- Identity (5): `E G(X) = d` for `X ∼ μ_G`. [SparsifyingSumsOfNorms, node_04] -/
theorem expected_norm_eq_dim {d : ℕ} (G : (Fin d → ℝ) → ℝ) (hG : IsNormFn G) :
    (∫ x, G x * Real.exp (-G x)) = (d : ℝ) * ∫ x, Real.exp (-G x) := by
  sorry

/-- Main theorem (existence part): a nonnegative `ε`-approximation of sparsity
`C ε⁻² n log(n/ε) (log n)^{5/2}`, with `C` depending only on the concentration constant. [SparsifyingSumsOfNorms, node_04] -/
theorem exists_sparse_approximation (c₀ : ℝ) (hc₀ : 0 < c₀) :
    ∃ C : ℝ, 0 < C ∧
      (LogConcaveConcentration c₀ (fun d => Real.sqrt (logT (2 * (d : ℝ)))) →
        ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m →
          ∀ N : Fin m → (Fin n → ℝ) → ℝ, (∀ i, IsSeminormFn (N i)) →
            ∀ ε : ℝ, 0 < ε →
              ∃ w : Fin m → ℝ, IsEpsApprox N ε w ∧
                (sparsity w : ℝ) ≤
                  C * ε⁻¹ ^ 2 * (n : ℝ) * logT ((n : ℝ) / ε) *
                    logT (n : ℝ) ^ ((5 : ℝ) / 2)) := by
  sorry

end TCSChallenge.SparsifyingSumsOfNorms.node_04
