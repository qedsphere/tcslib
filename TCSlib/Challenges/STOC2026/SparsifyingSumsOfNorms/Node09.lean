/-!
## Sparsifying sums of squares of seminorms equivalent to `ℓ_{p_i}` norms of linear images

Let `K ≥ 1`, `2 ≤ pᵢ ≤ p < ∞`, `Aᵢ : ℝⁿ → ℝ^{kᵢ}` linear and `Nᵢ` seminorms with
`cᵢ ‖Aᵢ x‖_{pᵢ} ≤ Nᵢ(x) ≤ K cᵢ ‖Aᵢ x‖_{pᵢ}`, and `F = ∑ᵢ Nᵢ²`. The main theorem
`exists_sparse_square_approximation` states: for a universal `C` and every `ε > 0` there are
`w ≥ 0` with `|∑ wᵢ Nᵢ(x)² − F(x)| ≤ ε F(x)` for all `x` and
`|{i : wᵢ ≠ 0}| ≤ C (K³/ε)² p n log₊(n/ε)`, given the supplied analytic estimate.

Lemma stub: the determinant-optimization normalization (6) (for trivial common kernel).
-/

namespace TCSChallenge.SparsifyingSumsOfNorms.node_09

open MeasureTheory ProbabilityTheory
open scoped NNReal

/-- A seminorm on `ℝⁿ`, as a predicate on a function: absolute homogeneity
`f (c • x) = |c| f x` and the triangle inequality (nonnegativity follows). -/
def IsSeminormFn {n : ℕ} (f : (Fin n → ℝ) → ℝ) : Prop :=
  (∀ (c : ℝ) (x : Fin n → ℝ), f (c • x) = |c| * f x) ∧
    ∀ x y : Fin n → ℝ, f (x + y) ≤ f x + f y

/-- `log₊ t = max{1, log t}`. -/
def logPlus (t : ℝ) : ℝ := max 1 (Real.log t)

/-- Euclidean norm `‖z‖₂` (the norm on `Fin d → ℝ` is the sup norm, so write it out). -/
def eucNorm {d : ℕ} (z : Fin d → ℝ) : ℝ := Real.sqrt (∑ j, z j ^ 2)

/-- `‖v‖_q = (∑ₜ |vₜ|^q)^{1/q}`. -/
def lpNorm {k : ℕ} (q : ℝ) (v : Fin k → ℝ) : ℝ := (∑ t, |v t| ^ q) ^ (1 / q)

/-- Standard Gaussian vector in `ℝ^d` (product of TCSlib's `standardGaussianMeasure`). -/
abbrev stdGaussian (d : ℕ) : Measure (Fin d → ℝ) :=
  Measure.pi fun _ : Fin d => BooleanAnalysis.ThresholdFunctions.standardGaussianMeasure

/-- `D_Q = {z : ‖z‖₂ ≤ 1, ∑ⱼ Qⱼ(z)² ≤ 1}`. -/
def DQ {d s : ℕ} (Q : Fin s → (Fin d → ℝ) → ℝ) : Set (Fin d → ℝ) :=
  {z | eucNorm z ≤ 1 ∧ ∑ j, Q j z ^ 2 ≤ 1}

/-- Uniform sign `±1` from a Boolean. -/
def signOf (b : Bool) : ℝ := if b then 1 else -1

/-- The supplied analytic estimate:
`E_ξ sup_{z ∈ D_Q} |∑ⱼ ξⱼ Qⱼ(z)²| ≤ C₀ (E_g maxⱼ Qⱼ(g) + √log(2d) maxⱼ E_g Qⱼ(g))`,
with `ξ` uniform on `{±1}^s` (written as an average over `Fin s → Bool`). -/
def AnalyticEstimate (C₀ : ℝ) : Prop :=
  ∀ (d s : ℕ), 1 ≤ d → 1 ≤ s →
    ∀ Q : Fin s → (Fin d → ℝ) → ℝ, (∀ j, IsSeminormFn (Q j)) →
      (1 / (2 : ℝ) ^ s) *
          ∑ ξ : Fin s → Bool, (⨆ z : DQ Q, |∑ j, signOf (ξ j) * Q j z.1 ^ 2|) ≤
        C₀ * ((∫ g, (⨆ j, Q j g) ∂stdGaussian d) +
          Real.sqrt (Real.log (2 * (d : ℝ))) * (⨆ j, ∫ g, Q j g ∂stdGaussian d))

/-- Sparsity `|{i : wᵢ ≠ 0}|`. -/
def sparsity {m : ℕ} (w : Fin m → ℝ) : ℕ :=
  (Finset.univ.filter (fun i => w i ≠ 0)).card

/-- Normalization (6), for trivial common kernel: there is an invertible `U` and `αᵢ ≥ 0` with
`∑ αᵢ² = n`, `‖Aᵢ U y‖_{pᵢ} ≤ αᵢ ‖y‖₂`, and `‖y‖₂² ≤ ∑ᵢ ‖Aᵢ U y‖_{pᵢ}²`. [SparsifyingSumsOfNorms, node_09] -/
theorem exists_normalization {n m : ℕ} (k : Fin m → ℕ)
    (A : (i : Fin m) → Matrix (Fin (k i)) (Fin n) ℝ) (pe : Fin m → ℝ)
    (hpi : ∀ i, 2 ≤ pe i)
    (hker : ∀ x : Fin n → ℝ, (∀ i, Matrix.mulVec (A i) x = 0) → x = 0) :
    ∃ (U : Matrix (Fin n) (Fin n) ℝ) (α : Fin m → ℝ), U.det ≠ 0 ∧ (∀ i, 0 ≤ α i) ∧
      ∑ i, α i ^ 2 = (n : ℝ) ∧
      (∀ i y, lpNorm (pe i) (Matrix.mulVec (A i) (Matrix.mulVec U y)) ≤ α i * eucNorm y) ∧
      (∀ y, eucNorm y ^ 2 ≤ ∑ i, lpNorm (pe i) (Matrix.mulVec (A i) (Matrix.mulVec U y)) ^ 2) := by
  sorry

/-- Main theorem. [SparsifyingSumsOfNorms, node_09] -/
theorem exists_sparse_square_approximation (C₀ : ℝ) (hC₀ : 0 < C₀) :
    ∃ C : ℝ, 0 < C ∧
      (AnalyticEstimate C₀ →
        ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m →
        ∀ (K p : ℝ), 1 ≤ K →
        ∀ (k : Fin m → ℕ) (A : (i : Fin m) → Matrix (Fin (k i)) (Fin n) ℝ)
          (pe c : Fin m → ℝ) (N : Fin m → (Fin n → ℝ) → ℝ),
          (∀ i, 2 ≤ pe i) → (∀ i, pe i ≤ p) → (∀ i, 0 < c i) →
          (∀ i, IsSeminormFn (N i)) →
          (∀ i x, c i * lpNorm (pe i) (Matrix.mulVec (A i) x) ≤ N i x) →
          (∀ i x, N i x ≤ K * c i * lpNorm (pe i) (Matrix.mulVec (A i) x)) →
        ∀ ε : ℝ, 0 < ε →
          ∃ w : Fin m → ℝ, (∀ i, 0 ≤ w i) ∧
            (∀ x : Fin n → ℝ,
              |∑ i, w i * N i x ^ 2 - ∑ i, N i x ^ 2| ≤ ε * ∑ i, N i x ^ 2) ∧
            (sparsity w : ℝ) ≤
              C * (K ^ 3 / ε) ^ 2 * p * (n : ℝ) * logPlus ((n : ℝ) / ε)) := by
  sorry

end TCSChallenge.SparsifyingSumsOfNorms.node_09
