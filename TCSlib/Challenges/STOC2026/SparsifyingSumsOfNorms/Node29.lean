/-!
## Sampling from `e^{-N(x)}` via uniform sampling of the norm ball

Let `N` be a norm on `ℝⁿ` with `r‖x‖₂ ≤ N(x) ≤ R‖x‖₂`, `B_N = {N ≤ 1}`, and
`μ` the probability measure with density `e^{-N(x)} / Z`. The reduction:

1. `(1/R) B₂ ⊆ B_N ⊆ (1/r) B₂`, so the supplied uniform sampler applies with
   `a = 1/R`, `b = 1/r`, `b/a = R/r`.
2. Given a (near-)uniform point `x ∈ B_N`, output `(t / N(x)) • x` where
   `t ~ Gamma(n, 1)` is independent (sum of `n` mean-one exponentials), and `0` if
   `N(x) = 0`.
3. For the exact uniform law on `B_N` this outputs exactly `μ` (radial law
   `∝ t^{n-1} e^{-t}` by `vol(t B_N) = tⁿ vol(B_N)`; angular law equals the
   normalization pushforward of the uniform law, independent of the radius).
4. Total variation does not increase under this randomized post-processing,
   so an `ε`-accurate uniform sample yields an `ε`-accurate sample of `μ`.

Main theorem: `expNorm_sampling_guarantee`.
-/

namespace TCSChallenge.SparsifyingSumsOfNorms.node_29

open MeasureTheory ProbabilityTheory
open scoped ENNReal

variable {n : ℕ}

/-- Euclidean norm `‖x‖₂` on `ℝⁿ`, modelled as `Fin n → ℝ` (whose built-in norm is
the sup norm, hence this explicit definition). -/
def eucl (x : Fin n → ℝ) : ℝ := Real.sqrt (∑ i, x i ^ 2)

/-- "A norm `N : ℝⁿ → [0,∞)`": nonnegative, definite, absolutely homogeneous,
subadditive. -/
def IsNormFn (N : (Fin n → ℝ) → ℝ) : Prop :=
  (∀ x, 0 ≤ N x) ∧ (∀ x, N x = 0 → x = 0) ∧
  (∀ (c : ℝ) (x : Fin n → ℝ), N (c • x) = |c| * N x) ∧
  (∀ x y, N (x + y) ≤ N x + N y)

/-- "`r‖x‖₂ ≤ N(x) ≤ R‖x‖₂` for all `x ∈ ℝⁿ`". -/
def Rounded (r R : ℝ) (N : (Fin n → ℝ) → ℝ) : Prop :=
  ∀ x, r * eucl x ≤ N x ∧ N x ≤ R * eucl x

/-- "`B_N = {x : N(x) ≤ 1}`". -/
def normBall (N : (Fin n → ℝ) → ℝ) : Set (Fin n → ℝ) := {x | N x ≤ 1}

/-- The Euclidean ball `ρ B₂ⁿ = {x : ‖x‖₂ ≤ ρ}`. -/
def euclBall (n : ℕ) (ρ : ℝ) : Set (Fin n → ℝ) := {x | eucl x ≤ ρ}

/-- The uniform probability law on a set `A` of finite positive Lebesgue measure. -/
def uniformOn (A : Set (Fin n → ℝ)) : Measure (Fin n → ℝ) :=
  (volume A)⁻¹ • volume.restrict A

/-- "`𝒵 = ∫ e^{-N(x)} dx`". -/
def partitionFn (N : (Fin n → ℝ) → ℝ) : ℝ≥0∞ :=
  ∫⁻ x, ENNReal.ofReal (Real.exp (-N x))

/-- "`dμ/dx = 𝒵⁻¹ e^{-N(x)}`". -/
def expNormMeasure (N : (Fin n → ℝ) → ℝ) : Measure (Fin n → ℝ) :=
  (partitionFn N)⁻¹ • volume.withDensity (fun x => ENNReal.ofReal (Real.exp (-N x)))

/-- Post-processing: "normalize using `x / N(x)`, sample the scalar radius `t`
independently, and multiply"; the origin is sent to the origin. -/
def postprocess (N : (Fin n → ℝ) → ℝ) (p : (Fin n → ℝ) × ℝ) : Fin n → ℝ :=
  if N p.1 = 0 then 0 else (p.2 / N p.1) • p.1

/-- Output law of the randomized post-processing applied to an input sample of law
`ν`, with an independent `Gamma(n, 1)` radius. -/
def outputLaw (N : (Fin n → ℝ) → ℝ) (ν : Measure (Fin n → ℝ)) : Measure (Fin n → ℝ) :=
  (ν.prod (gammaMeasure (n : ℝ) 1)).map (postprocess N)

/-- Total variation distance `sup_A |μ(A) − ν(A)|` over measurable sets. -/
def tvDist {α : Type} [MeasurableSpace α] (μ ν : Measure α) : ℝ :=
  ⨆ A : {s : Set α // MeasurableSet s}, |(μ A.1).toReal - (ν A.1).toReal|

/-- The cone over a set `S` of norm-sphere directions, truncated at norm level `t`. -/
def cone (N : (Fin n → ℝ) → ℝ) (S : Set (Fin n → ℝ)) (t : ℝ) : Set (Fin n → ℝ) :=
  {x | x ≠ 0 ∧ N x ≤ t ∧ (N x)⁻¹ • x ∈ S}

/-! ### Rubric item 2: geometric reduction -/

/-- "`(1/R) B₂ⁿ ⊆ B_N ⊆ (1/r) B₂ⁿ`". [SparsifyingSumsOfNorms, node_29] -/
theorem ball_sandwich (N : (Fin n → ℝ) → ℝ) (r R : ℝ) (hr : 0 < r) (hrR : r ≤ R)
    (hN : IsNormFn N) (hround : Rounded r R N) :
    euclBall n (1 / R) ⊆ normBall N ∧ normBall N ⊆ euclBall n (1 / r) := by
  sorry

/-- The condition ratio fed to the uniform sampler: `b / a = (1/r)/(1/R) = R/r`. [SparsifyingSumsOfNorms, node_29] -/
theorem sampler_ratio (r R : ℝ) (hr : 0 < r) (hrR : r ≤ R) :
    (1 / r) / (1 / R) = R / r := by
  sorry

/-- `B_N` has finite positive volume (so `uniformOn (normBall N)` is a probability law). [SparsifyingSumsOfNorms, node_29] -/
theorem normBall_volume_pos_finite (N : (Fin n → ℝ) → ℝ) (r R : ℝ) (hn : 1 ≤ n)
    (hr : 0 < r) (hrR : r ≤ R) (hN : IsNormFn N) (hround : Rounded r R N) :
    0 < volume (normBall N) ∧ volume (normBall N) < ∞ := by
  sorry

/-! ### Rubric item 3: exact-law construction -/

/-- Dilation: "`vol(t B_N) = tⁿ vol(B_N)`". [SparsifyingSumsOfNorms, node_29] -/
theorem volume_sublevel (N : (Fin n → ℝ) → ℝ) (r R : ℝ) (hr : 0 < r) (hrR : r ≤ R)
    (hN : IsNormFn N) (hround : Rounded r R N) (t : ℝ) (ht : 0 < t) :
    volume {x : Fin n → ℝ | N x ≤ t} = ENNReal.ofReal (t ^ n) * volume (normBall N) := by
  sorry

/-- Dilation inside cones: for every measurable set `S` of directions on the norm
sphere, `vol(cone_S(t)) = tⁿ vol(cone_S(1))`. [SparsifyingSumsOfNorms, node_29] -/
theorem volume_cone (N : (Fin n → ℝ) → ℝ) (r R : ℝ) (hr : 0 < r) (hrR : r ≤ R)
    (hN : IsNormFn N) (hround : Rounded r R N) (S : Set (Fin n → ℝ))
    (hS : MeasurableSet S) (hSsphere : S ⊆ {x | N x = 1}) (t : ℝ) (ht : 0 < t) :
    volume (cone N S t) = ENNReal.ofReal (t ^ n) * volume (cone N S 1) := by
  sorry

/-- "`𝒵 = n! vol(B_N)`". [SparsifyingSumsOfNorms, node_29] -/
theorem partitionFn_eq (N : (Fin n → ℝ) → ℝ) (r R : ℝ) (hn : 1 ≤ n) (hr : 0 < r)
    (hrR : r ≤ R) (hN : IsNormFn N) (hround : Rounded r R N) :
    partitionFn N = (n.factorial : ℝ≥0∞) * volume (normBall N) := by
  sorry

/-- Angular/radial decomposition of `μ`: under `μ`, the pair `(x / N(x), N(x))` has law
(normalization pushforward of the uniform law on `B_N`) ⊗ `Gamma(n, 1)`; in particular the
radius has density `∝ t^{n-1} e^{-t}` and is independent of the direction. [SparsifyingSumsOfNorms, node_29] -/
theorem expNorm_polar_law (N : (Fin n → ℝ) → ℝ) (r R : ℝ) (hn : 1 ≤ n) (hr : 0 < r)
    (hrR : r ≤ R) (hN : IsNormFn N) (hround : Rounded r R N) :
    (expNormMeasure N).map (fun x => ((N x)⁻¹ • x, N x)) =
      ((uniformOn (normBall N)).map (fun x => (N x)⁻¹ • x)).prod
        (gammaMeasure (n : ℝ) 1) := by
  sorry

/-- Exact law: the post-processing applied to an exact uniform point of `B_N` outputs
exactly `μ`. [SparsifyingSumsOfNorms, node_29] -/
theorem outputLaw_uniform_eq (N : (Fin n → ℝ) → ℝ) (r R : ℝ) (hn : 1 ≤ n) (hr : 0 < r)
    (hrR : r ≤ R) (hN : IsNormFn N) (hround : Rounded r R N) :
    outputLaw N (uniformOn (normBall N)) = expNormMeasure N := by
  sorry

/-- Scalar randomness: the sum of `n` independent mean-one exponentials is `Gamma(n, 1)`. [SparsifyingSumsOfNorms, node_29] -/
theorem gamma_eq_sum_exp (hn : 1 ≤ n) :
    (Measure.pi (fun _ : Fin n => expMeasure 1)).map (fun e => ∑ i, e i) =
      gammaMeasure (n : ℝ) 1 := by
  sorry

/-! ### Rubric item 4: error transfer -/

/-- Total variation contraction under the (everywhere-defined) randomized
post-processing, including inputs with an atom at the origin. [SparsifyingSumsOfNorms, node_29] -/
theorem tvDist_outputLaw_le (N : (Fin n → ℝ) → ℝ) (r R : ℝ) (hr : 0 < r) (hrR : r ≤ R)
    (hN : IsNormFn N) (hround : Rounded r R N) (ν ν' : Measure (Fin n → ℝ))
    [IsProbabilityMeasure ν] [IsProbabilityMeasure ν'] :
    tvDist (outputLaw N ν) (outputLaw N ν') ≤ tvDist ν ν' := by
  sorry

/-! ### Main theorem -/

/-- Accuracy guarantee of the reduction: if the bounded-body sampler, run on
`B_N` with `a = 1/R`, `b = 1/r`, `η = ε`, returns a point whose law `ν` is within total
variation `ε` of uniform on `B_N`, then the post-processed output (independent
`Gamma(n,1)` radius, normalization by `N`) is within total variation `ε` of `μ`. [SparsifyingSumsOfNorms, node_29] -/
theorem expNorm_sampling_guarantee (N : (Fin n → ℝ) → ℝ) (r R ε : ℝ) (hn : 1 ≤ n)
    (hr : 0 < r) (hrR : r ≤ R) (hN : IsNormFn N) (hround : Rounded r R N)
    (hε : 0 < ε) (hε2 : ε < 1 / 2) (ν : Measure (Fin n → ℝ)) [IsProbabilityMeasure ν]
    (hν : tvDist ν (uniformOn (normBall N)) ≤ ε) :
    euclBall n (1 / R) ⊆ normBall N ∧ normBall N ⊆ euclBall n (1 / r) ∧
      tvDist (outputLaw N ν) (expNormMeasure N) ≤ ε := by
  sorry

end TCSChallenge.SparsifyingSumsOfNorms.node_29
