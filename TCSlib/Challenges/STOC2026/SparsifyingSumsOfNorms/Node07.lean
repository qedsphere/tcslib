/-!
## Sparsifying sums of `p`-th powers of seminorms under a uniformly smooth comparison norm

Let `p ≥ 1`, `N₁,…,N_m` seminorms on `ℝⁿ`, `N(x) = (∑ᵢ Nᵢ(x)^p)^{1/p}`, `r = min{p,2}`.
Assume a seminorm `Q` and `K,S ≥ 1` with `Q ≤ N ≤ K Q` and
`(Q(x+y)^r + Q(x−y)^r)/2 ≤ Q(x)^r + S^r Q(y)^r`. The main theorem
`exists_sparse_power_approximation` gives, for every `ε ∈ (0,1)`, nonnegative weights with
`|N(x)^p − ∑ wᵢ Nᵢ(x)^p| ≤ ε N(x)^p` and support at most
`C K^p ε⁻² n [S ψ_n log(n/ε)]^p (log n)²` if `1 ≤ p ≤ 2`, and
`C K^p S^p p² ε⁻² ((n+p)/2)^{p/2} [ψ_n log(n/ε)]² (log n)²` if `p ≥ 2`,
with `C` universal (depending only on the constants `c₀, C₀` of the supplied facts).

Lemma stubs: kernel invariance, the translation inequality for `exp(−Q^r)`, and the two
scalar power-difference inequalities.
-/

namespace TCSChallenge.SparsifyingSumsOfNorms.node_07

open MeasureTheory

/-- A seminorm on `ℝⁿ`, as a predicate on a function: absolute homogeneity
`f (c • x) = |c| f x` and the triangle inequality (nonnegativity follows). -/
def IsSeminormFn {n : ℕ} (f : (Fin n → ℝ) → ℝ) : Prop :=
  (∀ (c : ℝ) (x : Fin n → ℝ), f (c • x) = |c| * f x) ∧
    ∀ x y : Fin n → ℝ, f (x + y) ≤ f x + f y

/-- Truncated logarithm `log u = max{1, ln u}`. -/
def logT (u : ℝ) : ℝ := max 1 (Real.log u)

/-- Unnormalized measure with density `exp(-V)` with respect to Lebesgue measure on `ℝ^d`. -/
def expDensityMeasure {d : ℕ} (V : (Fin d → ℝ) → ℝ) : Measure (Fin d → ℝ) :=
  (volume : Measure (Fin d → ℝ)).withDensity (fun x => ENNReal.ofReal (Real.exp (-V x)))

/-- The supplied concentration fact: "for every symmetric log-concave random vector `X` in
`ℝ^d` and every seminorm `Q` with `a = E Q(X) > 0`,
`P(|Q(X) − a| > t) ≤ 2 exp(−c₀ t / (a · rate d))` for `t ≥ 0`."
Stated for densities `∝ exp(-V)` with `V` convex, even and `exp(-V)` integrable;
probabilities are written unnormalized (multiplied by `Z = ∫ exp(-V)`). -/
def LogConcaveConcentration (c₀ : ℝ) (rate : ℕ → ℝ) : Prop :=
  ∀ (d : ℕ) (V : (Fin d → ℝ) → ℝ), ConvexOn ℝ Set.univ V → (∀ x, V (-x) = V x) →
    Integrable (fun x => Real.exp (-V x)) →
    ∀ H : (Fin d → ℝ) → ℝ, IsSeminormFn H →
      0 < (∫ x, H x * Real.exp (-V x)) / (∫ x, Real.exp (-V x)) →
      ∀ t : ℝ, 0 ≤ t →
        expDensityMeasure V
            {x | t < |H x - (∫ y, H y * Real.exp (-V y)) / (∫ y, Real.exp (-V y))|} ≤
          ENNReal.ofReal (2 * Real.exp (-(c₀ * t) /
              (((∫ y, H y * Real.exp (-V y)) / (∫ y, Real.exp (-V y))) * rate d)) *
            ∫ y, Real.exp (-V y))

/-- `N(x) = (∑ᵢ Nᵢ(x)^p)^{1/p}`. -/
def pSumNorm {n m : ℕ} (p : ℝ) (N : Fin m → (Fin n → ℝ) → ℝ) (x : Fin n → ℝ) : ℝ :=
  (∑ i, N i x ^ p) ^ (1 / p)

/-- `r`-uniform smoothness of `Q` with constant `S`:
`(Q(x+y)^r + Q(x−y)^r)/2 ≤ Q(x)^r + S^r Q(y)^r`. -/
def IsUniformlySmooth {n : ℕ} (Q : (Fin n → ℝ) → ℝ) (r S : ℝ) : Prop :=
  ∀ x y : Fin n → ℝ, (Q (x + y) ^ r + Q (x - y) ^ r) / 2 ≤ Q x ^ r + S ^ r * Q y ^ r

/-- Sparsity `|{i : wᵢ > 0}|`. -/
def support {m : ℕ} (w : Fin m → ℝ) : ℕ :=
  (Finset.univ.filter (fun i => 0 < w i)).card

/-- The claimed sparsity bound (two regimes). -/
def sparsityBound (n : ℕ) (p K S ε ψn : ℝ) : ℝ :=
  if p ≤ 2 then
    K ^ p * ε⁻¹ ^ 2 * (n : ℝ) * (S * ψn * logT ((n : ℝ) / ε)) ^ p * logT (n : ℝ) ^ 2
  else
    K ^ p * S ^ p * p ^ 2 * ε⁻¹ ^ 2 * (((n : ℝ) + p) / 2) ^ (p / 2) *
      (ψn * logT ((n : ℝ) / ε)) ^ 2 * logT (n : ℝ) ^ 2

/-- Every summand is invariant under translation by `ker N`. [SparsifyingSumsOfNorms, node_07] -/
theorem summand_kernel_invariant {n m : ℕ} (N : Fin m → (Fin n → ℝ) → ℝ)
    (hN : ∀ i, IsSeminormFn (N i)) (x z : Fin n → ℝ) (hz : ∀ i, N i z = 0) (i : Fin m) :
    N i (x + z) = N i x := by
  sorry

/-- Translation inequality (1): for symmetric measurable `W`,
`μ(W + z) ≥ exp(−S^r Q(z)^r) μ(W)` for the density `∝ exp(−Q^r)`. [SparsifyingSumsOfNorms, node_07] -/
theorem translation_inequality {d : ℕ} (Q : (Fin d → ℝ) → ℝ) (hQ : IsSeminormFn Q)
    (r S : ℝ) (hr1 : 1 ≤ r) (hr2 : r ≤ 2) (hS : 1 ≤ S) (hsm : IsUniformlySmooth Q r S)
    (W : Set (Fin d → ℝ)) (hW : MeasurableSet W) (hWsymm : ∀ x, x ∈ W → -x ∈ W)
    (z : Fin d → ℝ) :
    ENNReal.ofReal (Real.exp (-(S ^ r * Q z ^ r))) * expDensityMeasure (fun x => Q x ^ r) W ≤
      expDensityMeasure (fun x => Q x ^ r) {x | x - z ∈ W} := by
  sorry

/-- Scalar inequality for `1 ≤ p ≤ 2`: `|u^p − v^p|² ≤ 2 |u−v|^p (u^p + v^p)`. [SparsifyingSumsOfNorms, node_07] -/
theorem pow_diff_sq_le_small_p (p u v : ℝ) (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hu : 0 ≤ u)
    (hv : 0 ≤ v) :
    |u ^ p - v ^ p| ^ 2 ≤ 2 * |u - v| ^ p * (u ^ p + v ^ p) := by
  sorry

/-- Scalar inequality for `p ≥ 2`: `|u^p − v^p| ≤ p |u−v| √(u^{2p−2} + v^{2p−2})`. [SparsifyingSumsOfNorms, node_07] -/
theorem pow_diff_le_large_p (p u v : ℝ) (hp : 2 ≤ p) (hu : 0 ≤ u) (hv : 0 ≤ v) :
    |u ^ p - v ^ p| ≤ p * |u - v| * Real.sqrt (u ^ (2 * p - 2) + v ^ (2 * p - 2)) := by
  sorry

/-- Main theorem. [SparsifyingSumsOfNorms, node_07] -/
theorem exists_sparse_power_approximation (c₀ C₀ : ℝ) (hc₀ : 0 < c₀) (hC₀ : 0 < C₀) :
    ∃ C : ℝ, 0 < C ∧
      ∀ ψ : ℕ → ℝ, Monotone ψ → (∀ d, 1 ≤ ψ d) →
        (∀ d, ψ d ≤ C₀ * Real.sqrt (logT (d : ℝ))) →
        LogConcaveConcentration c₀ ψ →
        ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m →
        ∀ (p : ℝ), 1 ≤ p →
        ∀ N : Fin m → (Fin n → ℝ) → ℝ, (∀ i, IsSeminormFn (N i)) →
        ∀ (Q : (Fin n → ℝ) → ℝ) (K S : ℝ), IsSeminormFn Q → 1 ≤ K → 1 ≤ S →
          (∀ x, Q x ≤ pSumNorm p N x) → (∀ x, pSumNorm p N x ≤ K * Q x) →
          IsUniformlySmooth Q (min p 2) S →
        ∀ ε : ℝ, 0 < ε → ε < 1 →
          ∃ w : Fin m → ℝ, (∀ i, 0 ≤ w i) ∧
            (∀ x : Fin n → ℝ,
              |pSumNorm p N x ^ p - ∑ i, w i * N i x ^ p| ≤ ε * pSumNorm p N x ^ p) ∧
            (support w : ℝ) ≤ C * sparsityBound n p K S ε (ψ n) := by
  sorry

end TCSChallenge.SparsifyingSumsOfNorms.node_07
