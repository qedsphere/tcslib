/-!
## Asymmetric unique set-disjointness: `∑ᵢ cᵢ / sᵢ ≥ γ`

There are `k ≥ 2` players; player `i` holds `Sᵢ ⊆ [n]` with `|Sᵢ| = sᵢ ≥ 1`, and
`∑ᵢ sᵢ ≤ n/2` (formalized as `2 * ∑ᵢ sᵢ ≤ n`). The input is promised to be either pairwise
disjoint, or to have a common element `x` with the sets `Sᵢ \ {x}` pairwise disjoint.
Players write bits on a blackboard; speaker order, termination and answer depend on the public
coins and the transcript, a written bit may also depend on the speaker's input and private
coins. A protocol is `[c₁,…,c_k]`-bounded if player `i` writes at most `cᵢ` bits on every
execution.

Main theorem `main_theorem`: there is an absolute `γ > 0` such that every bounded randomized
protocol with error `≤ 1/3` on all promised inputs satisfies `∑ᵢ cᵢ / sᵢ ≥ γ`.

Model: for each public coin value `r : Fin m` the protocol is a binary tree `BTree` whose
internal nodes carry a speaker `i` and a bit function `Finset (Fin n) → Fin (p i) → Bool`
(input of the speaker, private tape of the speaker); leaves carry the answer. A tree for a
fixed `r` is exactly a deterministic protocol whose schedule depends only on the transcript.
-/

namespace TCSChallenge.StreamingLowerBoundsAnd.node_09

/-- A blackboard protocol tree for fixed public coins. "The next speaker, the decision to
terminate, and the final answer are determined by the public randomness and the transcript so
far; a transmitted bit may additionally depend on its sender's input and private randomness." -/
inductive BTree (k n : ℕ) (p : Fin k → ℕ) : Type where
  | leaf (out : Bool) : BTree k n p
  | node (i : Fin k) (msg : Finset (Fin n) → Fin (p i) → Bool) (t₀ t₁ : BTree k n p) :
      BTree k n p

/-- The answer of the tree on inputs `S` and private tapes `ρ`. -/
def BTree.run {k n : ℕ} {p : Fin k → ℕ} :
    BTree k n p → (Fin k → Finset (Fin n)) → ((i : Fin k) → Fin (p i)) → Bool
  | .leaf b, _, _ => b
  | .node i msg t₀ t₁, S, ρ => if msg (S i) (ρ i) then t₁.run S ρ else t₀.run S ρ

/-- Number of bits written by player `j` along the execution on inputs `S`, tapes `ρ`. -/
def BTree.bitsBy {k n : ℕ} {p : Fin k → ℕ} (j : Fin k) :
    BTree k n p → (Fin k → Finset (Fin n)) → ((i : Fin k) → Fin (p i)) → ℕ
  | .leaf _, _, _ => 0
  | .node i msg t₀ t₁, S, ρ =>
      (if i = j then 1 else 0) +
        (if msg (S i) (ρ i) then t₁.bitsBy j S ρ else t₀.bitsBy j S ρ)

/-- A randomized `k`-party blackboard protocol on subsets of `[n]`: public coins uniform on
`Fin m`, private coins of player `i` uniform on `Fin (p i)`, independent. -/
structure RandProtocol (k n : ℕ) where
  m : ℕ
  hm : 0 < m
  p : Fin k → ℕ
  hp : ∀ i, 0 < p i
  tree : Fin m → BTree k n p

/-- Probability, over public and private coins, that the protocol outputs `b` on input `S`. -/
noncomputable def RandProtocol.probOut {k n : ℕ} (P : RandProtocol k n)
    (S : Fin k → Finset (Fin n)) (b : Bool) : ℝ :=
  ((Finset.univ.filter
      (fun ω : Fin P.m × ((i : Fin k) → Fin (P.p i)) => (P.tree ω.1).run S ω.2 = b)).card : ℝ) /
    (Fintype.card (Fin P.m × ((i : Fin k) → Fin (P.p i))) : ℝ)

/-- "`[c₁,…,c_k]`-bounded: player `i` writes at most `cᵢ` bits on every execution." -/
def RandProtocol.Bounded {k n : ℕ} (P : RandProtocol k n) (c : Fin k → ℕ) : Prop :=
  ∀ (r : Fin P.m) (S : Fin k → Finset (Fin n)) (ρ : (i : Fin k) → Fin (P.p i)) (i : Fin k),
    (P.tree r).bitsBy i S ρ ≤ c i

/-- Size-free disjoint pattern: the sets are pairwise disjoint. -/
def PairwiseDisj {k n : ℕ} (S : Fin k → Finset (Fin n)) : Prop :=
  Pairwise (fun i j => Disjoint (S i) (S j))

/-- Size-free unique-intersection pattern: "there is `x ∈ ⋂ Sᵢ` such that the sets
`Sᵢ \ {x}` are pairwise disjoint". -/
def UniqueInter {k n : ℕ} (S : Fin k → Finset (Fin n)) : Prop :=
  ∃ x : Fin n, (∀ i, x ∈ S i) ∧ Pairwise (fun i j => Disjoint ((S i).erase x) ((S j).erase x))

/-- Promised disjoint instance with prescribed sizes `|Sᵢ| = sᵢ`. -/
def IsDisjointInstance {k n : ℕ} (s : Fin k → ℕ) (S : Fin k → Finset (Fin n)) : Prop :=
  (∀ i, (S i).card = s i) ∧ PairwiseDisj S

/-- Promised unique-intersection instance with prescribed sizes `|Sᵢ| = sᵢ`. -/
def IsUniqueInterInstance {k n : ℕ} (s : Fin k → ℕ) (S : Fin k → Finset (Fin n)) : Prop :=
  (∀ i, (S i).card = s i) ∧ UniqueInter S

/-- The protocol distinguishes the two promised cases with error at most `ε` on every promised
input (`true` = intersecting). -/
def RandProtocol.Solves {k n : ℕ} (P : RandProtocol k n) (s : Fin k → ℕ) (ε : ℝ) : Prop :=
  (∀ S, IsDisjointInstance s S → P.probOut S true ≤ ε) ∧
  (∀ S, IsUniqueInterInstance s S → P.probOut S false ≤ ε)

/-- Rubric 1 (amplification): a fixed number of repetitions with majority vote reduces the
error from `1/3` to `1/100`, multiplying every bit budget by the same absolute constant `A`. [StreamingLowerBoundsAnd, node_09] -/
theorem amplification :
    ∃ A : ℕ, 0 < A ∧ ∀ (n k : ℕ) (s c : Fin k → ℕ) (P : RandProtocol k n),
      P.Bounded c → P.Solves s (1 / 3) →
      ∃ P' : RandProtocol k n, P'.Bounded (fun i => A * c i) ∧ P'.Solves s (1 / 100) := by
  sorry

/-- Rubric 1 (silent players): under the hypotheses of the main theorem, at least two players
have a positive bit budget. [StreamingLowerBoundsAnd, node_09] -/
theorem two_active_players (n k : ℕ) (hk : 2 ≤ k) (s : Fin k → ℕ) (hs : ∀ i, 0 < s i)
    (hsum : 2 * ∑ i, s i ≤ n) (c : Fin k → ℕ) (P : RandProtocol k n)
    (hb : P.Bounded c) (hP : P.Solves s (1 / 3)) :
    2 ≤ (Finset.univ.filter (fun i : Fin k => 0 < c i)).card := by
  sorry

/-- Rubric 4 (promise-preserving padding): if the inputs live in `{0,…,M-1}`, and pairwise
disjoint reserves `Tᵢ ⊆ {M,…,n-1}` with `|Tᵢ| = sᵢ` are given, then any input with
`|Xᵢ| ≤ sᵢ` can be padded from its own reserve to sizes exactly `sᵢ`, preserving both the
disjoint and the unique-intersection pattern. [StreamingLowerBoundsAnd, node_09] -/
theorem padding_preserves_promise (n k M : ℕ) (s : Fin k → ℕ)
    (X T : Fin k → Finset (Fin n))
    (hX : ∀ i, ∀ x ∈ X i, x.val < M) (hT : ∀ i, ∀ x ∈ T i, M ≤ x.val)
    (hTdisj : PairwiseDisj T) (hTcard : ∀ i, (T i).card = s i)
    (hXcard : ∀ i, (X i).card ≤ s i) :
    ∃ Y : Fin k → Finset (Fin n),
      (∀ i, X i ⊆ Y i ∧ Y i ⊆ X i ∪ T i) ∧
      (PairwiseDisj X → IsDisjointInstance s Y) ∧
      (UniqueInter X → IsUniqueInterInstance s Y) := by
  sorry

/-- Rubric 5 (the elementary step in (6)): `e^{-s} ≤ 1/s` for `s ≥ 1`. [StreamingLowerBoundsAnd, node_09] -/
theorem exp_neg_le_inv (x : ℝ) (hx : 1 ≤ x) : Real.exp (-x) ≤ 1 / x := by
  sorry

/-- **Main theorem.** There is an absolute constant `γ > 0` such that for all `n`, `k ≥ 2`,
positive sizes with `∑ sᵢ ≤ n/2`, every `[c₁,…,c_k]`-bounded randomized protocol that
distinguishes the promised cases with error at most `1/3` satisfies `∑ᵢ cᵢ / sᵢ ≥ γ`. [StreamingLowerBoundsAnd, node_09] -/
theorem main_theorem :
    ∃ γ : ℝ, 0 < γ ∧
      ∀ (n k : ℕ), 2 ≤ k → ∀ (s : Fin k → ℕ), (∀ i, 0 < s i) → 2 * ∑ i, s i ≤ n →
        ∀ (c : Fin k → ℕ) (P : RandProtocol k n),
          P.Bounded c → P.Solves s (1 / 3) →
          γ ≤ ∑ i, (c i : ℝ) / (s i : ℝ) := by
  sorry

end TCSChallenge.StreamingLowerBoundsAnd.node_09
