/-!
## Agnostic multiclass sample complexity: `d_RE`, `d_DS`, `d_N`

For `H ⊆ Y^X`, `er_P(h) = P(h(X) ≠ Y)`. `ε^RE_H(n)` is the minimax expected error of
randomized learners over realizable distributions, and `d = d_RE(H)` is the least `n` with
`ε^RE_H(n) ≤ 1/(9e)`. With `q = d_DS(H)` (DS dimension, via pseudo-cubes) and `d_N`
(Natarajan dimension) we must show

* `Ω(q) ≤ d ≤ O(q^{3/2} loḡ² q)`;
* `M^AG(ε,δ) ≤ O((d_N loḡ³(d_N/ε) + log(1/δ))/ε² + d loḡ²(d/ε)/ε)`;
* for small universal `ε, δ`: `M^AG(ε,δ) ≥ Ω((d_N + log(1/δ))/ε² + d/ε)`;
* `M^AG(ε,δ) ≤ O((d_N loḡ³(1/ε) + log(1/δ))/ε² + q^{3/2} loḡ² q loḡ²(q/ε)/ε)`.

`M^AG` is encoded through the predicate `AgnosticLearns H ε δ n` ("some learner on `n`
samples is `(ε,δ)`-agnostic for every `P`"): upper bounds exhibit such an `n`, lower bounds
hold for every such `n`. Main theorem: `agnostic_sample_complexity`.
-/

open MeasureTheory
open scoped Classical

namespace TCSChallenge.SampleComplexityOfAgnostic.node_10

/-- `er_P(h) := P(h(X) ≠ Y)`, the 0-1 risk (outer measure if the event is not measurable). -/
noncomputable def errP {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (P : Measure (X × Y)) (h : X → Y) : ℝ :=
  (P {z | h z.1 ≠ z.2}).toReal

/-- "the convention `loḡ u = log(eu)`", clipped below at `u = 1`: `loḡ u = 1 + log (max u 1)`. -/
def lbar (u : ℝ) : ℝ := 1 + Real.log (max u 1)

/-- "there are `x_1,…,x_m` and pairs of distinct labels `a_i, b_i` such that every vector in
`∏ {a_i, b_i}` is realized by a member of `H` on these points." -/
def NatarajanShatters {X Y : Type} (H : Set (X → Y)) (m : ℕ) : Prop :=
  ∃ x : Fin m → X, ∃ a b : Fin m → Y, (∀ i, a i ≠ b i) ∧
    ∀ σ : Fin m → Bool, ∃ h ∈ H, ∀ i, h (x i) = if σ i then a i else b i

/-- The Natarajan dimension `d_N`: the largest `m` that is Natarajan-shattered. -/
def natarajanDim {X Y : Type} (H : Set (X → Y)) : ℕ :=
  sSup {m : ℕ | NatarajanShatters H m}

/-- "A finite nonempty set `V ⊆ Y^m` is a pseudo-cube if, for every `v ∈ V` and every
coordinate `i`, there is `v' ∈ V` that agrees with `v` outside coordinate `i` and differs
from it at coordinate `i`." -/
def IsPseudoCube {Y : Type} {m : ℕ} (V : Finset (Fin m → Y)) : Prop :=
  V.Nonempty ∧ ∀ v ∈ V, ∀ i : Fin m, ∃ v' ∈ V, v' i ≠ v i ∧ ∀ j, j ≠ i → v' j = v j

/-- "`H|_x` contains a pseudo-cube for some `x ∈ X^m`." -/
def DSShatters {X Y : Type} (H : Set (X → Y)) (m : ℕ) : Prop :=
  ∃ x : Fin m → X, ∃ V : Finset (Fin m → Y), IsPseudoCube V ∧
    ∀ v ∈ V, ∃ h ∈ H, ∀ i, h (x i) = v i

/-- The DS dimension `q = d_DS(H)`: the largest `m` such that `H|_x` contains a pseudo-cube. -/
def dsDim {X Y : Type} (H : Set (X → Y)) : ℕ :=
  sSup {m : ℕ | DSShatters H m}

/-- Finiteness of the DS dimension (the finite-dimensional case of the claim). -/
def HasFiniteDSDim {X Y : Type} (H : Set (X → Y)) : Prop :=
  BddAbove {m : ℕ | DSShatters H m}

/-- "`P` is `H`-realizable if `inf_{h ∈ H} er_P(h) = 0`." -/
def Realizable {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (H : Set (X → Y)) (P : Measure (X × Y)) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ h ∈ H, errP P h < ε

/-- The law of the learner's internal randomness: a uniform seed in `[0,1]`. -/
def unifSeed : Measure ℝ := volume.restrict (Set.Icc (0 : ℝ) 1)

/-- A randomized learner on `n` examples: sample and random seed ↦ classifier. -/
abbrev RandLearner (X Y : Type) (n : ℕ) : Type := (Fin n → X × Y) → ℝ → X → Y

/-- Joint law of `(S, ω)` with `S ∼ P^n` and an independent uniform seed `ω`. -/
def sampleSeedMeasure {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (P : Measure (X × Y)) [IsProbabilityMeasure P] (n : ℕ) :
    Measure ((Fin n → X × Y) × ℝ) :=
  (Measure.pi (fun _ : Fin n => P)).prod unifSeed

/-- Measurability clause for randomized learners (so that expected error is meaningful). -/
def LearnerMeasurable {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y] {n : ℕ}
    (A : RandLearner X Y n) : Prop :=
  ∀ P : Measure (X × Y), IsProbabilityMeasure P →
    Measurable (fun p : (Fin n → X × Y) × ℝ => errP P (A p.1 p.2))

/-- `E_{S∼P^n, A}[er_P(A(S))]`. -/
def expectedError {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y] {n : ℕ}
    (P : Measure (X × Y)) [IsProbabilityMeasure P] (A : RandLearner X Y n) : ℝ :=
  ∫ p, errP P (A p.1 p.2) ∂(sampleSeedMeasure P n)

/-- `ε^RE_H(n) := inf_A sup_{P realizable} E_{S∼P^n,A}[er_P(A(S))]`. -/
def epsRE {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (H : Set (X → Y)) (n : ℕ) : ℝ :=
  ⨅ A : {A : RandLearner X Y n // LearnerMeasurable A},
    ⨆ P : {P : Measure (X × Y) // IsProbabilityMeasure P ∧ Realizable H P},
      (haveI : IsProbabilityMeasure P.1 := P.2.1; expectedError P.1 A.1)

/-- `d = d_RE(H) := inf {n : ε^RE_H(n) ≤ 1/(9e)}`. -/
def dRE {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y] (H : Set (X → Y)) : ℕ :=
  sInf {n : ℕ | epsRE H n ≤ 1 / (9 * Real.exp 1)}

/-- "some learner, on `n` i.i.d. examples from every distribution `P`, outputs `ĥ` with
`er_P(ĥ) ≤ inf_{h∈H} er_P(h) + ε` with probability at least `1 - δ`."
`M^AG_H(ε,δ)` is the least `n` with `AgnosticLearns H ε δ n`. -/
def AgnosticLearns {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (H : Set (X → Y)) (ε δ : ℝ) (n : ℕ) : Prop :=
  ∃ A : RandLearner X Y n, ∀ (P : Measure (X × Y)) [IsProbabilityMeasure P],
    sampleSeedMeasure P n
      {p | (⨅ h : H, errP P h.1) + ε < errP P (A p.1 p.2)} ≤ ENNReal.ofReal δ

/-- Rubric 1: `d_N ≤ d_DS` (a Natarajan-shattered set carries a binary pseudo-cube). [SampleComplexityOfAgnostic, node_10] -/
theorem natarajanDim_le_dsDim {X Y : Type} (H : Set (X → Y)) (hfin : HasFiniteDSDim H) :
    natarajanDim H ≤ dsDim H := by sorry

/-- Rubric 1: `q ≤ d` (a `q`-dimensional pseudo-cube has average one-inclusion degree `q`). [SampleComplexityOfAgnostic, node_10] -/
theorem dsDim_le_dRE {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (H : Set (X → Y)) (hfin : HasFiniteDSDim H) :
    dsDim H ≤ dRE H := by sorry

/-- Rubric 1: `d ≤ O(q^{3/2} loḡ² q)`. [SampleComplexityOfAgnostic, node_10] -/
theorem dRE_le_ds_pow :
    ∃ C : ℝ, 0 < C ∧ ∀ (X Y : Type) [MeasurableSpace X] [MeasurableSpace Y]
      (H : Set (X → Y)), HasFiniteDSDim H →
      (dRE H : ℝ) ≤ C * (dsDim H : ℝ) ^ (3 / 2 : ℝ) * lbar (dsDim H) ^ 2 := by sorry

/-- Rubric 6: the `Ω(d/ε)` lower bound for small universal `ε, δ`. [SampleComplexityOfAgnostic, node_10] -/
theorem agnostic_lower_bound_dRE :
    ∃ c ε₀ δ₀ : ℝ, 0 < c ∧ 0 < ε₀ ∧ 0 < δ₀ ∧
      ∀ (X Y : Type) [MeasurableSpace X] [MeasurableSpace Y] (H : Set (X → Y)),
        HasFiniteDSDim H → 1 ≤ natarajanDim H →
        ∀ ε δ : ℝ, 0 < ε → ε < ε₀ → 0 < δ → δ < δ₀ →
          ∀ n : ℕ, AgnosticLearns H ε δ n → c * ((dRE H : ℝ) / ε) ≤ n := by sorry

/-- Rubrics 2–5: the agnostic upper bound
`M^AG ≤ O((d_N loḡ³(d_N/ε) + log(1/δ))/ε² + d loḡ²(d/ε)/ε)`. [SampleComplexityOfAgnostic, node_10] -/
theorem agnostic_upper_bound :
    ∃ C : ℝ, 0 < C ∧
      ∀ (X Y : Type) [MeasurableSpace X] [MeasurableSpace Y] (H : Set (X → Y)),
        HasFiniteDSDim H →
        ∀ ε δ : ℝ, 0 < ε → ε < 1 → 0 < δ → δ < 1 →
          ∃ n : ℕ, AgnosticLearns H ε δ n ∧
            (n : ℝ) ≤ C * (((natarajanDim H : ℝ) * lbar ((natarajanDim H : ℝ) / ε) ^ 3
                + Real.log (1 / δ)) / ε ^ 2
              + (dRE H : ℝ) * lbar ((dRE H : ℝ) / ε) ^ 2 / ε) := by sorry

/-- Main theorem: `Ω(q) ≤ d ≤ O(q^{3/2} loḡ² q)`, the two-sided bound on `M^AG_H(ε,δ)`,
and the DS-only upper bound. [SampleComplexityOfAgnostic, node_10] -/
theorem agnostic_sample_complexity :
    ∃ c C ε₀ δ₀ : ℝ, 0 < c ∧ 0 < C ∧ 0 < ε₀ ∧ 0 < δ₀ ∧
      ∀ (X Y : Type) [MeasurableSpace X] [MeasurableSpace Y] (H : Set (X → Y)),
        HasFiniteDSDim H →
        -- `Ω(q) ≤ d ≤ O(q^{3/2} loḡ² q)`
        (c * (dsDim H : ℝ) ≤ (dRE H : ℝ) ∧
          (dRE H : ℝ) ≤ C * (dsDim H : ℝ) ^ (3 / 2 : ℝ) * lbar (dsDim H) ^ 2) ∧
        -- upper bound in terms of `d_N` and `d`
        (∀ ε δ : ℝ, 0 < ε → ε < 1 → 0 < δ → δ < 1 →
          ∃ n : ℕ, AgnosticLearns H ε δ n ∧
            (n : ℝ) ≤ C * (((natarajanDim H : ℝ) * lbar ((natarajanDim H : ℝ) / ε) ^ 3
                + Real.log (1 / δ)) / ε ^ 2
              + (dRE H : ℝ) * lbar ((dRE H : ℝ) / ε) ^ 2 / ε)) ∧
        -- lower bound for small universal `ε, δ` (nontrivial class)
        (1 ≤ natarajanDim H →
          ∀ ε δ : ℝ, 0 < ε → ε < ε₀ → 0 < δ → δ < δ₀ →
            ∀ n : ℕ, AgnosticLearns H ε δ n →
              c * (((natarajanDim H : ℝ) + Real.log (1 / δ)) / ε ^ 2
                + (dRE H : ℝ) / ε) ≤ n) ∧
        -- DS-only consequence
        (∀ ε δ : ℝ, 0 < ε → ε < 1 → 0 < δ → δ < 1 →
          ∃ n : ℕ, AgnosticLearns H ε δ n ∧
            (n : ℝ) ≤ C * (((natarajanDim H : ℝ) * lbar (1 / ε) ^ 3
                + Real.log (1 / δ)) / ε ^ 2
              + (dsDim H : ℝ) ^ (3 / 2 : ℝ) * lbar (dsDim H) ^ 2
                  * lbar ((dsDim H : ℝ) / ε) ^ 2 / ε)) := by sorry

end TCSChallenge.SampleComplexityOfAgnostic.node_10
