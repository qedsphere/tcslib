/-!
## Menu-restricted compression oracle inequality

`l^μ(f,(x,y)) = 1{f(x) ≠ y ∧ y ∈ μ(x)}`. A deterministic compression `(κ, ρ)` with
`A(s) = ρ(κ(s))` is empirically optimal for `L^μ_s` over a nonempty class `H`. With
`k = k_A(n)` and `n ≥ 2`, there is a universal `C₂` such that with probability `≥ 1 - δ`,
simultaneously for all `h ∈ H`,
`er_P(Â) - er_P(h) ≤ C₂ √((k log n + log(1/δ))/n) + P{h(x) = y ∧ y ∉ μ(x)}`.
Main theorem: `menu_compression_oracle_inequality`.
-/

open MeasureTheory
open scoped Classical

namespace TCSChallenge.SampleComplexityOfAgnostic.node_21

/-- `er_P(h) := P(h(X) ≠ Y)`, the 0-1 risk (outer measure if the event is not measurable). -/
noncomputable def errP {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (P : Measure (X × Y)) (h : X → Y) : ℝ :=
  (P {z | h z.1 ≠ z.2}).toReal

/-- `l^μ(f,(x,y)) = 1{f(x) ≠ y and y ∈ μ(x)}`. -/
def lossMu {X Y : Type} (μ : X → Set Y) (f : X → Y) (z : X × Y) : ℝ :=
  if f z.1 ≠ z.2 ∧ z.2 ∈ μ z.1 then 1 else 0

/-- `L^μ_s(f) = (1/m) ∑_i l^μ(f, z_i)` for `s = (z_1,…,z_m)`. -/
def empLossMu {X Y : Type} (μ : X → Set Y) (f : X → Y) {m : ℕ} (s : Fin m → X × Y) : ℝ :=
  (∑ i : Fin m, lossMu μ f (s i)) / m

/-- Population menu-restricted risk `L^μ_P(f) = P{f(x) ≠ y ∧ y ∈ μ(x)}`. -/
def popLossMu {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (P : Measure (X × Y)) (μ : X → Set Y) (f : X → Y) : ℝ :=
  (P {z | f z.1 ≠ z.2 ∧ z.2 ∈ μ z.1}).toReal

/-- `P{(x,y) : h(x) = y and y ∉ μ(x)}`: comparator correct on a label omitted by the menu. -/
def omittedMass {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (P : Measure (X × Y)) (μ : X → Set Y) (h : X → Y) : ℝ :=
  (P {z | h z.1 = z.2 ∧ z.2 ∉ μ z.1}).toReal

/-- `𝒜(s) = ρ(κ(s))`: reconstruct from the selected sub-sample. -/
def compressOut {X Y : Type} (κ : (m : ℕ) → (Fin m → X × Y) → List (Fin m))
    (ρ : List (X × Y) → X → Y) {m : ℕ} (s : Fin m → X × Y) : X → Y :=
  ρ ((κ m s).map s)

/-- `k_𝒜(n) = sup_{1 ≤ m ≤ n} sup_{s ∈ Z^m} |κ(s)|`. -/
def compSize {X Y : Type} (κ : (m : ℕ) → (Fin m → X × Y) → List (Fin m)) (n : ℕ) : ℕ :=
  sSup {j : ℕ | ∃ m : ℕ, 1 ≤ m ∧ m ≤ n ∧ ∃ s : Fin m → X × Y, (κ m s).length = j}

/-- Rubric 3: pointwise menu-to-classification conversion
`e_f(z) - e_h(z) ≤ r_f(z) - r_h(z) + b_h(z)`. [SampleComplexityOfAgnostic, node_21] -/
theorem pointwise_menu_conversion {X Y : Type} (μ : X → Set Y) (f h : X → Y) (z : X × Y) :
    ((if f z.1 ≠ z.2 then (1 : ℝ) else 0) - (if h z.1 ≠ z.2 then (1 : ℝ) else 0)) ≤
      lossMu μ f z - lossMu μ h z + (if h z.1 = z.2 ∧ z.2 ∉ μ z.1 then (1 : ℝ) else 0) := by
  sorry

/-- Rubric 3: integrated conversion
`er_P(f) - er_P(h) ≤ L^μ_P(f) - L^μ_P(h) + P{h(x) = y ∧ y ∉ μ(x)}`. [SampleComplexityOfAgnostic, node_21] -/
theorem err_sub_le_menu {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (P : Measure (X × Y)) [IsProbabilityMeasure P] (μ : X → Set Y)
    (hμ : MeasurableSet {z : X × Y | z.2 ∈ μ z.1}) (f h : X → Y)
    (hf : MeasurableSet {z : X × Y | f z.1 = z.2})
    (hh : MeasurableSet {z : X × Y | h z.1 = z.2}) :
    errP P f - errP P h ≤ popLossMu P μ f - popLossMu P μ h + omittedMass P μ h := by sorry

/-- Rubrics 1, 2, 5: the menu-restricted oracle inequality
`L^μ_P(Â) ≤ inf_{g∈H} L^μ_P(g) + 6 √((k log n + log(1/δ))/n)` with probability `≥ 1 - δ`. [SampleComplexityOfAgnostic, node_21] -/
theorem menu_restricted_oracle {X Y : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (P : Measure (X × Y)) [IsProbabilityMeasure P] (μ : X → Set Y)
    (hμ : MeasurableSet {z : X × Y | z.2 ∈ μ z.1})
    (H : Set (X → Y)) (hHne : H.Nonempty)
    (hH : ∀ g ∈ H, MeasurableSet {z : X × Y | g z.1 = z.2})
    (κ : (m : ℕ) → (Fin m → X × Y) → List (Fin m)) (ρ : List (X × Y) → X → Y)
    (hnodup : ∀ (m : ℕ) (s : Fin m → X × Y), (κ m s).Nodup)
    (hκ : ∀ (m : ℕ) (I : List (Fin m)), MeasurableSet {s : Fin m → X × Y | κ m s = I})
    (hρ : ∀ j : ℕ, MeasurableSet
      {p : (Fin j → X × Y) × (X × Y) | ρ (List.ofFn p.1) p.2.1 = p.2.2})
    (hopt : ∀ (m : ℕ) (s : Fin m → X × Y), ∀ g ∈ H,
      empLossMu μ (compressOut κ ρ s) s ≤ empLossMu μ g s)
    (n : ℕ) (hn : 2 ≤ n) (δ : ℝ) (hδ0 : 0 < δ) (hδ1 : δ < 1) :
    Measure.pi (fun _ : Fin n => P)
        {S | ¬ ∀ g ∈ H, popLossMu P μ (compressOut κ ρ S) - popLossMu P μ g ≤
          6 * Real.sqrt (((compSize κ n : ℝ) * Real.log n + Real.log (1 / δ)) / n)}
      ≤ ENNReal.ofReal δ := by sorry

/-- Main theorem: there is a universal `C₂ > 0` such that with probability at least `1 - δ`,
simultaneously for all `h ∈ H`,
`er_P(Â) - er_P(h) ≤ C₂ √((k log n + log(1/δ))/n) + P{h(x) = y ∧ y ∉ μ(x)}`. [SampleComplexityOfAgnostic, node_21] -/
theorem menu_compression_oracle_inequality :
    ∃ C₂ : ℝ, 0 < C₂ ∧
      ∀ (X Y : Type) [MeasurableSpace X] [MeasurableSpace Y]
        (P : Measure (X × Y)) [IsProbabilityMeasure P] (μ : X → Set Y)
        (_hμ : MeasurableSet {z : X × Y | z.2 ∈ μ z.1})
        (H : Set (X → Y)) (_hHne : H.Nonempty)
        (_hH : ∀ g ∈ H, MeasurableSet {z : X × Y | g z.1 = z.2})
        (κ : (m : ℕ) → (Fin m → X × Y) → List (Fin m)) (ρ : List (X × Y) → X → Y)
        (_hnodup : ∀ (m : ℕ) (s : Fin m → X × Y), (κ m s).Nodup)
        (_hκ : ∀ (m : ℕ) (I : List (Fin m)),
          MeasurableSet {s : Fin m → X × Y | κ m s = I})
        (_hρ : ∀ j : ℕ, MeasurableSet
          {p : (Fin j → X × Y) × (X × Y) | ρ (List.ofFn p.1) p.2.1 = p.2.2})
        (_hopt : ∀ (m : ℕ) (s : Fin m → X × Y), ∀ g ∈ H,
          empLossMu μ (compressOut κ ρ s) s ≤ empLossMu μ g s)
        (n : ℕ) (_hn : 2 ≤ n) (δ : ℝ) (_hδ0 : 0 < δ) (_hδ1 : δ < 1),
        Measure.pi (fun _ : Fin n => P)
            {S | ¬ ∀ h ∈ H, errP P (compressOut κ ρ S) - errP P h ≤
              C₂ * Real.sqrt (((compSize κ n : ℝ) * Real.log n + Real.log (1 / δ)) / n)
                + omittedMass P μ h}
          ≤ ENNReal.ofReal δ := by sorry

end TCSChallenge.SampleComplexityOfAgnostic.node_21
