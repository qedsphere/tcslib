/-!
## Novel-correct multiplicative weights builds a small menu

`F ⊆ Y^X` finite, `N = |F|`, `(X_t,Y_t)_{t ≤ T} ∼ P^T`. With `η = 1/2`, `p_1` uniform, draw
`h_t ∼ p_t`, reward `r_t(h) = 1{h(X_t) = Y_t ∧ h_s(X_t) ≠ Y_t ∀ s < t}`, update
multiplicatively, and output the menu `μ(x) = {h_s(x) : 1 ≤ s < T}`. For each fixed
`f⋆ ∈ F` and `δ ∈ (0,1)`, with probability `≥ 1 - δ`,
`P(f⋆(X) = Y ∧ f⋆(X) ∉ μ(X) | μ) ≤ (4 log N + 14 log(3/δ) + 12)/T`.
Main theorems: `novel_mw_menu_missed_mass` and `novel_mw_menu_missed_mass_le_eps`.
Rounds are 0-indexed (`Fin T`), so "`1 ≤ s < T`" becomes `s.val + 1 < T`.
-/

open MeasureTheory
open scoped Classical

namespace TCSChallenge.SampleComplexityOfAgnostic.node_19

/-- Exponential weights from the uniform prior for a reward sequence `r`:
`p_t(h) = exp(η ∑_{s<t} r_s(h)) / ∑_g exp(η ∑_{s<t} r_s(g))`, the closed form of
`p_{t+1}(h) = p_t(h) e^{η r_t(h)} / ∑_g p_t(g) e^{η r_t(g)}`. -/
def mwWeight {F : Type} [Fintype F] {T : ℕ} (η : ℝ) (r : Fin T → F → ℝ) (t : Fin T)
    (h : F) : ℝ :=
  Real.exp (η * ∑ s ∈ Finset.univ.filter (fun s : Fin T => s < t), r s h) /
    ∑ g : F, Real.exp (η * ∑ s ∈ Finset.univ.filter (fun s : Fin T => s < t), r s g)

/-- `r_t(h) = 1{h(X_t) = Y_t and h_s(X_t) ≠ Y_t for every s < t}` (novel-correct reward). -/
def reward {X Y F : Type} (f : F → X → Y) {T : ℕ} (z : Fin T → X × Y) (hs : Fin T → F)
    (t : Fin T) (h : F) : ℝ :=
  if f h (z t).1 = (z t).2 ∧ ∀ s : Fin T, s < t → f (hs s) (z t).1 ≠ (z t).2 then 1 else 0

/-- `p_t` of the procedure on sample `z` and drawn hypotheses `hs` (depends on `hs s` only
for `s < t`). -/
def procWeight {X Y F : Type} [Fintype F] (f : F → X → Y) {T : ℕ} (η : ℝ)
    (z : Fin T → X × Y) (hs : Fin T → F) (t : Fin T) (h : F) : ℝ :=
  mwWeight η (reward f z hs) t h

/-- Probability that the internal randomization draws `h_1,…,h_T = hs` given the sample `z`:
`∏_t p_t(h_t)`. -/
def pathProb {X Y F : Type} [Fintype F] (f : F → X → Y) {T : ℕ} (η : ℝ)
    (z : Fin T → X × Y) (hs : Fin T → F) : ℝ :=
  ∏ t : Fin T, procWeight f η z hs t (hs t)

/-- `P_{(X,Y)∼P}(f⋆(X) = Y ∧ f⋆(X) ∉ μ(X) | μ)` with `μ(x) = {h_s(x) : 1 ≤ s < T}`. -/
def missedMass {X Y F : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (P : Measure (X × Y)) (f : F → X → Y) (fstar : F) {T : ℕ} (hs : Fin T → F) : ℝ :=
  (P {w | f fstar w.1 = w.2 ∧ ∀ s : Fin T, s.val + 1 < T → f (hs s) w.1 ≠ w.2}).toReal

/-- Outer probability (sample and internal randomization) that the missed mass exceeds `b`. -/
def failProb {X Y F : Type} [MeasurableSpace X] [MeasurableSpace Y] [Fintype F]
    (P : Measure (X × Y)) [IsProbabilityMeasure P] (f : F → X → Y) (fstar : F)
    (T : ℕ) (η b : ℝ) : ENNReal :=
  ∫⁻ z, ∑ hs : Fin T → F,
      ENNReal.ofReal (pathProb f η z hs) * (if b < missedMass P f fstar hs then 1 else 0)
    ∂(Measure.pi (fun _ : Fin T => P))

/-- Rubric 1: reward-form multiplicative-weights inequality at `η = 1/2`:
`M ≥ (2/3) R⋆ - (4/3) log N` for any `[0,1]`-valued reward sequence. [SampleComplexityOfAgnostic, node_19] -/
theorem mw_reward_regret {F : Type} [Fintype F] [Nonempty F] {T : ℕ}
    (r : Fin T → F → ℝ) (hr : ∀ t h, 0 ≤ r t h ∧ r t h ≤ 1) (fstar : F) :
    (2 / 3 : ℝ) * ∑ t, r t fstar - (4 / 3) * Real.log (Fintype.card F) ≤
      ∑ t, ∑ h, mwWeight (1 / 2) r t h * r t h := by sorry

/-- Rubric 4 (disjointness): for fixed hypotheses and a fixed pair `(x,y)`, at most one
round `t` is the first at which the sequence predicts `y` at `x`. [SampleComplexityOfAgnostic, node_19] -/
theorem novel_indicators_sum_le_one {X Y F : Type} (f : F → X → Y) {T : ℕ}
    (hs : Fin T → F) (x : X) (y : Y) :
    ∑ t : Fin T, (if f (hs t) x = y ∧ ∀ s : Fin T, s < t → f (hs s) x ≠ y then (1 : ℝ) else 0)
      ≤ 1 := by sorry

/-- Rubric 2: every conditional mean `q_t` of `r_t(f⋆)` dominates the final missed mass. [SampleComplexityOfAgnostic, node_19] -/
theorem missedMass_le_prefix {X Y F : Type} [MeasurableSpace X] [MeasurableSpace Y]
    (P : Measure (X × Y)) [IsProbabilityMeasure P] (f : F → X → Y) (fstar : F) {T : ℕ}
    (hs : Fin T → F) (t : Fin T) :
    missedMass P f fstar hs ≤
      (P {w | f fstar w.1 = w.2 ∧ ∀ s : Fin T, s < t → f (hs s) w.1 ≠ w.2}).toReal := by sorry

/-- Main theorem: with probability at least `1 - δ`,
`P(f⋆(X) = Y ∧ f⋆(X) ∉ μ(X) | μ) ≤ (4 log N + 14 log(3/δ) + 12)/T`. [SampleComplexityOfAgnostic, node_19] -/
theorem novel_mw_menu_missed_mass {X Y F : Type} [MeasurableSpace X] [MeasurableSpace Y]
    [Fintype F] [Nonempty F] (f : F → X → Y) (hinj : Function.Injective f)
    (hmeas : ∀ i : F, MeasurableSet {w : X × Y | f i w.1 = w.2})
    (P : Measure (X × Y)) [IsProbabilityMeasure P] (T : ℕ) (hT : 1 ≤ T) (fstar : F)
    (δ : ℝ) (hδ0 : 0 < δ) (hδ1 : δ < 1) :
    failProb P f fstar T (1 / 2)
        ((4 * Real.log (Fintype.card F) + 14 * Real.log (3 / δ) + 12) / T)
      ≤ ENNReal.ofReal δ := by sorry

/-- Corollary: the missed mass is at most `ε` with probability `≥ 1 - δ` whenever
`T ≥ (4 log N + 14 log(3/δ) + 12)/ε`. [SampleComplexityOfAgnostic, node_19] -/
theorem novel_mw_menu_missed_mass_le_eps {X Y F : Type} [MeasurableSpace X]
    [MeasurableSpace Y] [Fintype F] [Nonempty F] (f : F → X → Y)
    (hinj : Function.Injective f)
    (hmeas : ∀ i : F, MeasurableSet {w : X × Y | f i w.1 = w.2})
    (P : Measure (X × Y)) [IsProbabilityMeasure P] (T : ℕ) (hT : 1 ≤ T) (fstar : F)
    (δ ε : ℝ) (hδ0 : 0 < δ) (hδ1 : δ < 1) (hε : 0 < ε)
    (hTε : (4 * Real.log (Fintype.card F) + 14 * Real.log (3 / δ) + 12) / ε ≤ T) :
    failProb P f fstar T (1 / 2) ε ≤ ENNReal.ofReal δ := by sorry

end TCSChallenge.SampleComplexityOfAgnostic.node_19
