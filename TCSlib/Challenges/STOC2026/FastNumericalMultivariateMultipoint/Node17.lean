/-!
## Exact integer multipoint evaluation from a finite-field routine

A polynomial of individual degree `< D` in variables indexed by a finite type `ι` is given by
its dense coefficient array `c : (ι → Fin D) → R`; its value at `a : ι → R` is
`∑_e c e * ∏_j a_j ^ e_j` (`evalDense`).

The algorithm of the paper: with `λ = log₂ d`, `k = ⌊√λ⌋`, `B = ⌈d^(1/k)⌉`, `r = mk`,
re-encode each exponent `e_j < d` by its `k` base-`B` digits (`digitLift`) and replace each
point `a` by `v(a)_{j,h} = a_j^(B^h)` (`liftPoint`); the new polynomial has individual degree
`< B` in `r` variables and the same values (`evalDense_digitLift_liftPoint`). Run this over
`𝔽_p` for the first few primes `p` with product `M > 2^(s+1)`, CRT-reconstruct `R_i ∈ [0, M)`,
and output the signed representative `signedRep M R_i`.

Main theorem: `pipeline_correct` — under the output promise `|f(a^(i))| ≤ 2^s`, the output is
exactly `f(a^(i))`.
-/

namespace TCSChallenge.FastNumericalMultivariateMultipoint.node_17

open scoped BigOperators

/-- Dense evaluation: "Polynomials of individual degree less than `D` ... are represented by
their full arrays of coefficients, including zeros." The value at `a` is
`∑_e c_e ∏_j a_j^{e_j}`. -/
def evalDense {R : Type} [CommSemiring R] {ι : Type} [Fintype ι] [DecidableEq ι] {D : ℕ}
    (c : (ι → Fin D) → R) (a : ι → R) : R :=
  ∑ e : ι → Fin D, c e * ∏ j : ι, a j ^ (e j : ℕ)

/-- The number encoded by the `k` base-`B` digits `(c (j,h))_h` of variable `j`:
`Σ_{h<k} c_{j,h} B^h`. -/
def digitValue {m k B : ℕ} (c : Fin m × Fin k → Fin B) (j : Fin m) : ℕ :=
  ∑ h : Fin k, (c (j, h) : ℕ) * B ^ (h : ℕ)

/-- The transformed polynomial `G((y_{j,h})) = Σ_e c_e ∏_j ∏_h y_{j,h}^{e_{j,h}}`, as a
dense array of individual degree `< B` in the `r = mk` variables `y_{j,h}`: "entries not
arising from an exponent vector of `g` are set to zero". -/
def digitLift {R : Type} [CommSemiring R] {m d k B : ℕ}
    (f : (Fin m → Fin d) → R) : (Fin m × Fin k → Fin B) → R :=
  fun c => if h : ∀ j, digitValue c j < d then f (fun j => ⟨digitValue c j, h j⟩) else 0

/-- The transformed point `v(a)_{j,h} = a_j^(B^h)`. -/
def liftPoint {R : Type} [CommSemiring R] {m : ℕ} (k B : ℕ) (a : Fin m → R) :
    Fin m × Fin k → R :=
  fun jh => a jh.1 ^ (B ^ (jh.2 : ℕ))

/-- `k = ⌊√(log₂ d)⌋`. -/
noncomputable def kParam (d : ℕ) : ℕ :=
  ⌊Real.sqrt (Real.logb 2 (d : ℝ))⌋₊

/-- `B = ⌈d^(1/k)⌉`. -/
noncomputable def BParam (d : ℕ) : ℕ :=
  ⌈(d : ℝ) ^ ((1 : ℝ) / (kParam d : ℝ))⌉₊

/-- Signed representative of a residue `R ∈ [0, M)`: "`z_i = R_i` if `R_i ≤ M/2`, and
`z_i = R_i − M` otherwise." -/
def signedRep (M R : ℤ) : ℤ :=
  if 2 * R ≤ M then R else R - M

/-! ### Rubric item 1: evaluation-preserving degree reduction -/

/-- "Directly from the base-`B` expansion, `G(v(a)) = g(a)`", valid over any commutative
ring (in particular `𝔽_p`), including when coordinates vanish, provided `d ≤ B^k`. [FastNumericalMultivariateMultipoint, node_17] -/
theorem evalDense_digitLift_liftPoint {R : Type} [CommRing R] (m d k B : ℕ)
    (hdB : d ≤ B ^ k) (f : (Fin m → Fin d) → R) (a : Fin m → R) :
    evalDense (digitLift (k := k) (B := B) f) (liftPoint k B a) = evalDense f a := by
  sorry

/-! ### Rubric item 2: padding and parameter overheads -/

/-- For large `d`: `k ≥ 2` and `B^k ≥ d`. [FastNumericalMultivariateMultipoint, node_17] -/
theorem params_valid : ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d →
    2 ≤ kParam d ∧ d ≤ BParam d ^ kParam d := by
  sorry

/-- `H = B^r + N r ≤ A^(1+o_d(1))` with `A = d^m + Nm`, `r = mk`, uniformly in `m, N`. [FastNumericalMultivariateMultipoint, node_17] -/
theorem transformed_size_bound (ε : ℝ) (hε : 0 < ε) :
    ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d → ∀ m N : ℕ, 1 ≤ m →
      ((BParam d : ℝ) ^ (m * kParam d) + (N : ℝ) * ((m * kParam d : ℕ) : ℝ))
        ≤ ((d : ℝ) ^ m + (N : ℝ) * (m : ℝ)) ^ (1 + ε) := by
  sorry

/-- "Every fixed polynomial in `r` and `B` is `A^(o_d(1))`", uniformly in `m, N`. [FastNumericalMultivariateMultipoint, node_17] -/
theorem poly_overhead_subpolynomial (C : ℕ) (ε : ℝ) (hε : 0 < ε) :
    ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d → ∀ m N : ℕ, 1 ≤ m →
      (((m * kParam d * BParam d : ℕ) : ℝ)) ^ C
        ≤ ((d : ℝ) ^ m + (N : ℝ) * (m : ℝ)) ^ ε := by
  sorry

/-! ### Rubric item 3: inexpensive sufficient moduli (combinatorial part) -/

/-- There is an absolute constant `c` such that for every `s ≥ 1` there are distinct primes,
each of size `≤ c (s+2)^2`, whose product `M` satisfies `2^(s+1) < M ≤ 2^(c s)`
(so total bit length `O(s)`). [FastNumericalMultivariateMultipoint, node_17] -/
theorem exists_small_moduli : ∃ c : ℕ, ∀ s : ℕ, 1 ≤ s →
    ∃ P : Finset ℕ, (∀ p ∈ P, p.Prime ∧ p ≤ c * (s + 2) ^ 2) ∧
      2 ^ (s + 1) < ∏ p ∈ P, p ∧ ∏ p ∈ P, p ≤ 2 ^ (c * s) := by
  sorry

/-! ### Rubric item 4: exact signed reconstruction -/

/-- "Reduction modulo a prime is a ring homomorphism": evaluating the reduced array at the
reduced point gives the reduction of the integer value. [FastNumericalMultivariateMultipoint, node_17] -/
theorem evalDense_map {m d : ℕ} (p : ℕ) (f : (Fin m → Fin d) → ℤ) (a : Fin m → ℤ) :
    ((evalDense f a : ℤ) : ZMod p)
      = evalDense (fun e => (f e : ZMod p)) (fun j => (a j : ZMod p)) := by
  sorry

/-- CRT uniqueness: a residue `R ∈ [0, M)`, `M = ∏_{p∈P} p` for distinct primes, that agrees
with `z` modulo every `p ∈ P` is `z mod M`. [FastNumericalMultivariateMultipoint, node_17] -/
theorem crt_unique (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) (R z : ℤ)
    (hR0 : 0 ≤ R) (hRM : R < ((∏ p ∈ P, p : ℕ) : ℤ))
    (hres : ∀ p ∈ P, (R : ZMod p) = (z : ZMod p)) :
    R = z % ((∏ p ∈ P, p : ℕ) : ℤ) := by
  sorry

/-- "Because `|f(a^(i))| ≤ 2^s < M/2` ... it equals `z_i`", including negative values and
the endpoints `±2^s`. [FastNumericalMultivariateMultipoint, node_17] -/
theorem signedRep_emod (s : ℕ) (M z : ℤ) (hM : 2 ^ (s + 1) < M) (hz : |z| ≤ 2 ^ s) :
    signedRep M (z % M) = z := by
  sorry

/-! ### Main theorem: the pipeline outputs `f(a^(i))` exactly -/

/-- Correctness of the integer algorithm. Let `P` be a set of primes with product
`M > 2^(s+1)`, and `d ≤ B^k`. Suppose that for each point `i`, `R_i ∈ [0, M)` has, modulo
every `p ∈ P`, the residue computed by evaluating the digit-lifted reduced polynomial at the
lifted reduced point. If `|f(a^(i))| ≤ 2^s`, then `signedRep M R_i = f(a^(i))`. [FastNumericalMultivariateMultipoint, node_17] -/
theorem pipeline_correct (m d k B s N : ℕ) (hdB : d ≤ B ^ k)
    (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) (hM : 2 ^ (s + 1) < ∏ p ∈ P, p)
    (f : (Fin m → Fin d) → ℤ) (a : Fin N → Fin m → ℤ)
    (hval : ∀ i, |evalDense f (a i)| ≤ 2 ^ s)
    (R : Fin N → ℤ) (hR0 : ∀ i, 0 ≤ R i) (hRM : ∀ i, R i < ((∏ p ∈ P, p : ℕ) : ℤ))
    (hres : ∀ i, ∀ p ∈ P,
      (R i : ZMod p) = evalDense (digitLift (k := k) (B := B) (fun e => (f e : ZMod p)))
        (liftPoint k B (fun j => (a i j : ZMod p)))) :
    ∀ i, signedRep ((∏ p ∈ P, p : ℕ) : ℤ) (R i) = evalDense f (a i) := by
  sorry

end TCSChallenge.FastNumericalMultivariateMultipoint.node_17
