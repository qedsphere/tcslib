/-!
## Exact rational outputs from numerical multipoint evaluation

`R_s = {p/q : |p| < 2^s, 1 ≤ q < 2^s}`. A polynomial `f ∈ ℚ[x_1,…,x_m]` of individual degree
`< d` is given by its dense array; its values `y_i = f(a^(i))` are promised to lie in `R_s`.
The algorithm calls the numerical evaluator with precision `t = 2s + 1`, obtaining
`β_i = A_i / 2^t` with `|β_i − y_i| < 2^(−t) = 1/(2Q^2)`, `Q = 2^s`, and returns the
convergent `p_n/q_n` of `β_i` of largest index with `q_n < Q`.

Main theorem: `algorithm_correct` — this returns exactly `y_i`.
-/

namespace TCSChallenge.FastNumericalMultivariateMultipoint.node_26

open scoped BigOperators

/-- Dense evaluation over `ℚ`: `f` is "supplied by its dense coefficient list", value at `a`
is `∑_e c_e ∏_j a_j^{e_j}`. -/
def evalDense {m d : ℕ} (c : (Fin m → Fin d) → ℚ) (a : Fin m → ℚ) : ℚ :=
  ∑ e : Fin m → Fin d, c e * ∏ j : Fin m, a j ^ (e j : ℕ)

/-- `R_s = {p/q : p ∈ ℤ, q ∈ ℤ, |p| < 2^s, 1 ≤ q < 2^s}` (pair need not be reduced). -/
def InRs (s : ℕ) (x : ℚ) : Prop :=
  ∃ p q : ℤ, |p| < 2 ^ s ∧ 1 ≤ q ∧ q < 2 ^ s ∧ x = (p : ℚ) / (q : ℚ)

/-- The input oracle for `α = p/q ∈ (−1,1)`: precompute `u = ⌊2^s |p| / q⌋`; for `k ≤ s`
return `sign(p) · ⌊u / 2^(s−k)⌋`, for `k > s` return `sign(p) · ⌊2^k |p| / q⌋`.
(Integer `/` is floor division here since all operands are nonnegative.) -/
def oracleAnswer (s : ℕ) (p q : ℤ) (k : ℕ) : ℤ :=
  if k ≤ s then Int.sign p * (((2 : ℤ) ^ s * |p|) / q / (2 : ℤ) ^ (s - k))
  else Int.sign p * (((2 : ℤ) ^ k * |p|) / q)

/-- "The convergent `p_i/q_i` having the largest index `i` for which `q_i < Q`": `n` has
denominator `< Q`, and every later convergent with denominator `< Q` coincides with it
(later indices only repeat the final value once the expansion of a rational terminates). -/
def IsLastConvBelow (ξ : ℝ) (Q n : ℕ) : Prop :=
  (ξ.convergent n).den < Q ∧
    ∀ j : ℕ, n < j → (ξ.convergent j).den < Q → ξ.convergent j = ξ.convergent n

/-! ### Rubric item 1: precision -/

/-- With `t = 2s + 1`, the error `2^(−t)` is `1/(2Q^2)`, which is below `1/(2 b^2)` for the
reduced denominator `b < Q` of any element of `R_s`; also `|y| < 2^s`, so outputs of absolute
value `> 1` are allowed. [FastNumericalMultivariateMultipoint, node_26] -/
theorem precision_threshold (s : ℕ) (y : ℚ) (hy : InRs s y) (β : ℝ)
    (hβ : |β - (y : ℝ)| < (2 : ℝ)⁻¹ ^ (2 * s + 1)) :
    (y.den : ℕ) < 2 ^ s ∧ |(y : ℝ)| < 2 ^ s ∧
      |β - (y : ℝ)| < 1 / (2 * ((2 : ℝ) ^ s) ^ 2) ∧
      |β - (y : ℝ)| < 1 / (2 * (y.den : ℝ) ^ 2) := by
  sorry

/-! ### Rubric item 2: structural approximation principle -/

/-- "If `a/b` is reduced, `b > 0`, and `|x − a/b| < 1/(2b^2)`, then `a/b` is a convergent
of `x`." [FastNumericalMultivariateMultipoint, node_26] -/
theorem close_fraction_is_convergent (ξ : ℝ) (y : ℚ)
    (h : |ξ - (y : ℝ)| < 1 / (2 * (y.den : ℝ) ^ 2)) :
    ∃ n : ℕ, ξ.convergent n = y := by
  sorry

/-- Monotonicity of convergent denominators: "denominators are positive and nondecreasing". [FastNumericalMultivariateMultipoint, node_26] -/
theorem convergent_den_mono (ξ : ℝ) (i j : ℕ) (hij : i ≤ j) :
    (ξ.convergent i).den ≤ (ξ.convergent j).den := by
  sorry

/-- Gap bound (1): if the expansion has not terminated at index `n`, then
`|x − p_n/q_n| ≥ 1/[q_n (q_n + q_{n+1})]`. [FastNumericalMultivariateMultipoint, node_26] -/
theorem convergent_gap (ξ : ℝ) (n : ℕ)
    (hne : ξ.convergent (n + 1) ≠ ξ.convergent n) :
    1 / (((ξ.convergent n).den : ℝ) *
        (((ξ.convergent n).den : ℝ) + ((ξ.convergent (n + 1)).den : ℝ)))
      ≤ |ξ - ((ξ.convergent n : ℚ) : ℝ)| := by
  sorry

/-! ### Rubric item 3: identification of the unknown fraction -/

/-- The selection index exists for a rational `x` (for any `Q ≥ 2`; `q_0 = 1 < Q`). [FastNumericalMultivariateMultipoint, node_26] -/
theorem exists_last_conv_below (x : ℚ) (Q : ℕ) (hQ : 2 ≤ Q) :
    ∃ n : ℕ, IsLastConvBelow (x : ℝ) Q n := by
  sorry

/-- "The last convergent below the denominator threshold is correct": if `y` has reduced
denominator `< Q` and `|x − y| < 1/(2Q^2)`, the selected convergent is `y`. [FastNumericalMultivariateMultipoint, node_26] -/
theorem last_conv_below_eq (ξ : ℝ) (Q : ℕ) (hQ : 2 ≤ Q) (y : ℚ) (hyden : y.den < Q)
    (hclose : |ξ - (y : ℝ)| < 1 / (2 * (Q : ℝ) ^ 2)) (n : ℕ)
    (hn : IsLastConvBelow ξ Q n) :
    ξ.convergent n = y := by
  sorry

/-- Uniqueness: two distinct fractions with denominators `< Q` cannot both be within
`1/(2Q^2)` of `x`. [FastNumericalMultivariateMultipoint, node_26] -/
theorem unique_close_fraction (ξ : ℝ) (Q : ℕ) (y y' : ℚ) (hy : y.den < Q) (hy' : y'.den < Q)
    (h : |ξ - (y : ℝ)| < 1 / (2 * (Q : ℝ) ^ 2)) (h' : |ξ - (y' : ℝ)| < 1 / (2 * (Q : ℝ) ^ 2)) :
    y = y' := by
  sorry

/-! ### Rubric item 5: input oracles (correctness part) -/

/-- The oracle for `α = p/q ∈ R_s ∩ (−1,1)` meets the specification for every `k ≥ 1`:
`|u_k| ≤ 2^k` and `|α − u_k/2^k| < 2^(−k)`. [FastNumericalMultivariateMultipoint, node_26] -/
theorem oracleAnswer_spec (s : ℕ) (p q : ℤ) (hq : 1 ≤ q) (hpq : |p| < q) (k : ℕ) (hk : 1 ≤ k) :
    |oracleAnswer s p q k| ≤ 2 ^ k ∧
      |(p : ℝ) / (q : ℝ) - (oracleAnswer s p q k : ℝ) / (2 : ℝ) ^ k| < (2 : ℝ)⁻¹ ^ k := by
  sorry

/-! ### Main theorem -/

/-- Correctness of the algorithm. Let `y_i = f(a^(i)) ∈ R_s`, and let `A_i` be the outputs of
the numerical evaluator with precision `t = 2s + 1`, i.e. `|A_i/2^t − y_i| < 2^(−t)`. For any
index `n_i` selected by the rule "largest index with denominator `< 2^s`" for `β_i = A_i/2^t`,
the returned convergent equals `y_i`. [FastNumericalMultivariateMultipoint, node_26] -/
theorem algorithm_correct (m d N s : ℕ) (hs : 1 ≤ s)
    (f : (Fin m → Fin d) → ℚ) (a : Fin N → Fin m → ℚ)
    (hprom : ∀ i, InRs s (evalDense f (a i)))
    (A : Fin N → ℤ)
    (hA : ∀ i, |(A i : ℝ) / (2 : ℝ) ^ (2 * s + 1) - ((evalDense f (a i) : ℚ) : ℝ)|
      < (2 : ℝ)⁻¹ ^ (2 * s + 1))
    (n : Fin N → ℕ)
    (hn : ∀ i, IsLastConvBelow ((A i : ℝ) / (2 : ℝ) ^ (2 * s + 1)) (2 ^ s) (n i)) :
    ∀ i, ((A i : ℝ) / (2 : ℝ) ^ (2 * s + 1)).convergent (n i) = evalDense f (a i) := by
  sorry

end TCSChallenge.FastNumericalMultivariateMultipoint.node_26
