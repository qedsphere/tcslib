/-!
## Top-link expansion of the matrix-poset complex `X^{r,b,n}`

Let `q = 2^b`, `V = 𝔽_q^{n×n}` viewed as an `𝔽₂`-space. For nonzero `a ∈ 𝔽₂^{r+1}` pick
`u_a, v_a ∈ 𝔽_q^n` with `{u_a}` and `{v_a}` each `𝔽_q`-linearly independent, and set
`T(z) = ∑_{a ≠ 0} (a·z) u_a v_aᵀ`. The poset `X` consists of all binary subspaces contained
in some `im T`; a face of binary dimension `k` has rank `k - 1`.

For `x ∈ X(r-2)` (binary dimension `r-1`), the link graph `G_x` has as vertices the faces of
binary dimension `r` containing `x`; an edge is drawn by picking a uniform top face `t ⊇ x`
(binary dimension `r+1`) and then a uniform unordered pair of distinct intermediate faces.

Main theorem `topLink_expansion`: for `r ≥ 1`, `b ≥ 1`, `n ≥ 2^{r+1}`, every such link
satisfies `λ(G_x) ≤ 11/q` (two-sided norm on functions orthogonal to constants).

Binary subspaces of `V` are encoded as finsets of matrices containing `0` and closed under
addition (in characteristic 2 these are exactly the `𝔽₂`-subspaces). Matrices are encoded as
plain functions `Fin n → Fin n → F` so that `Fintype` instances come from `Pi`.
-/

namespace TCSChallenge.FromGrassmannianToSimplicial.node_20

variable {F : Type} [Field F] [Fintype F]

/-- The ambient space `V = 𝔽_q^{n×n}` (matrices as functions). -/
abbrev Mat (K : Type) (n : ℕ) : Type := Fin n → Fin n → K

/-- Binary vectors `𝔽₂^{r+1}`. -/
abbrev BVec (r : ℕ) : Type := Fin (r + 1) → ZMod 2

/-- "`T(z) = ∑_{a ∈ 𝔽₂^{r+1} ∖ {0}} (a·z) u_a v_aᵀ`, where the dot product is binary and its
value is embedded in `𝔽_q`." -/
def Tmap {n r : ℕ} (u v : BVec r → (Fin n → F)) (z : BVec r) : Mat F n :=
  ∑ a ∈ Finset.univ.filter (fun a : BVec r => a ≠ 0),
    fun i j => (if dotProduct a z = 1 then (1 : F) else 0) * (u a i * v a j)

/-- "the family of all `u_a` is linearly independent over `𝔽_q`" (indexed by nonzero `a`). -/
def NonzeroIndep {n r : ℕ} (u : BVec r → (Fin n → F)) : Prop :=
  LinearIndependent F (fun a : {a : BVec r // a ≠ 0} => u a.1)

/-- A binary linear subspace of `V`: contains `0` and is closed under addition
(over characteristic 2 this is the same as an `𝔽₂`-subspace). -/
def IsBinarySubspace {n : ℕ} (W : Finset (Mat F n)) : Prop :=
  (0 : Mat F n) ∈ W ∧ ∀ w₁ ∈ W, ∀ w₂ ∈ W, w₁ + w₂ ∈ W

/-- "`X` is the poset of all binary linear subspaces contained in some image `im T`." -/
def IsFace (n r : ℕ) (W : Finset (Mat F n)) : Prop :=
  IsBinarySubspace W ∧
    ∃ u v : BVec r → (Fin n → F), NonzeroIndep u ∧ NonzeroIndep v ∧
      ∀ w ∈ W, w ∈ Set.range (Tmap u v)

variable (F) in
/-- Faces of binary dimension `k` (i.e. rank `k - 1`, so `X(i)` = `facesDim (i+1)`). -/
def facesDim (n r k : ℕ) : Finset (Finset (Mat F n)) :=
  Finset.univ.filter (fun W => IsFace n r W ∧ W.card = 2 ^ k)

/-- Vertices of `G_x`: faces `y ∈ X(r-1)` (binary dimension `r`) containing `x`. -/
def linkVertices (n r : ℕ) (x : Finset (Mat F n)) : Finset (Finset (Mat F n)) :=
  (facesDim F n r r).filter (fun y => x ⊆ y)

/-- Top faces `t ∈ X(r)` (binary dimension `r+1`) containing `x`. -/
def linkTops (n r : ℕ) (x : Finset (Mat F n)) : Finset (Finset (Mat F n)) :=
  (facesDim F n r (r + 1)).filter (fun t => x ⊆ t)

/-- Intermediate faces `y` with `x ⊆ y ⊆ t` and `y ∈ X(r-1)`. -/
def between (n r : ℕ) (x t : Finset (Mat F n)) : Finset (Finset (Mat F n)) :=
  (facesDim F n r r).filter (fun y => x ⊆ y ∧ y ⊆ t)

/-- Edge distribution of `G_x`: probability of the unordered pair `{y, y'}` when a top face
`t ⊇ x` is chosen uniformly and then a uniform unordered pair of distinct intermediate faces
between `x` and `t`. (Symmetric in `y, y'`; zero on the diagonal.) -/
def edgeWeight (n r : ℕ) (x y y' : Finset (Mat F n)) : ℝ :=
  ∑ t ∈ linkTops n r x,
    if y ≠ y' ∧ y ∈ between n r x t ∧ y' ∈ between n r x t then
      (1 / ((linkTops n r x).card : ℝ)) * (1 / (((between n r x t).card.choose 2 : ℕ) : ℝ))
    else 0

/-- Weighted degree of `y` in `G_x`; the stationary distribution is proportional to it. -/
def weightedDeg (n r : ℕ) (x y : Finset (Mat F n)) : ℝ :=
  ∑ y' ∈ linkVertices n r x, edgeWeight n r x y y'

/-- Random-walk operator `P_x(y, y') = w(y, y') / deg(y)`. -/
def walkKernel (n r : ℕ) (x y y' : Finset (Mat F n)) : ℝ :=
  edgeWeight n r x y y' / weightedDeg n r x y

/-- `(P_x f)(y) = ∑_{y'} P_x(y, y') f(y')`. -/
def walkApply (n r : ℕ) (x : Finset (Mat F n)) (f : Finset (Mat F n) → ℝ)
    (y : Finset (Mat F n)) : ℝ :=
  ∑ y' ∈ linkVertices n r x, walkKernel n r x y y' * f y'

/-- `λ(G_x) ≤ c`: the operator norm of `P_x` on functions orthogonal to constants in
`L²(π)` (π ∝ weighted degree) is at most `c`. Both signs of eigenvalues are controlled,
since this bounds `‖P_x f‖_π`, not a Rayleigh quotient. -/
def LinkLambdaLE (n r : ℕ) (x : Finset (Mat F n)) (c : ℝ) : Prop :=
  ∀ f : Finset (Mat F n) → ℝ,
    ∑ y ∈ linkVertices n r x, weightedDeg n r x y * f y = 0 →
      ∑ y ∈ linkVertices n r x, weightedDeg n r x y * (walkApply n r x f y) ^ 2 ≤
        c ^ 2 * ∑ y ∈ linkVertices n r x, weightedDeg n r x y * (f y) ^ 2

/-! ## Lemma stubs -/

/-- Between a face `x` of binary dimension `r-1` and a top face `t ⊇ x` of binary dimension
`r+1` there are exactly three intermediate faces (lines of the 2-dim quotient `t/x`), so the
pair choice is uniform over 3 unordered pairs. [FromGrassmannianToSimplicial, node_20] -/
theorem between_card (b n r : ℕ) [CharP F 2] (hq : Fintype.card F = 2 ^ b) (hr : 1 ≤ r)
    (x : Finset (Mat F n)) (hx : x ∈ facesDim F n r (r - 1))
    (t : Finset (Mat F n)) (ht : t ∈ linkTops n r x) :
    (between n r x t).card = 3 := by
  sorry

/-- Every vertex of the link lies in some top face, hence has positive weighted degree. [FromGrassmannianToSimplicial, node_20] -/
theorem weightedDeg_pos (b n r : ℕ) [CharP F 2] (hq : Fintype.card F = 2 ^ b) (hr : 1 ≤ r)
    (hn : 2 ^ (r + 1) ≤ n)
    (x : Finset (Mat F n)) (hx : x ∈ facesDim F n r (r - 1))
    (y : Finset (Mat F n)) (hy : y ∈ linkVertices n r x) :
    0 < weightedDeg n r x y := by
  sorry

/-- Trivial range: a reversible Markov operator is a contraction in `L²(π)`, so
`λ(G_x) ≤ 1`; this disposes of `q ≤ 11`. [FromGrassmannianToSimplicial, node_20] -/
theorem linkLambda_le_one (b n r : ℕ) [CharP F 2] (hq : Fintype.card F = 2 ^ b)
    (hr : 1 ≤ r) (hn : 2 ^ (r + 1) ≤ n)
    (x : Finset (Mat F n)) (hx : x ∈ facesDim F n r (r - 1)) :
    LinkLambdaLE n r x 1 := by
  sorry

/-- Ambient avoidance count: if a subspace `S ≤ 𝔽_q^n` has codimension at least 2
(the forbidden row/column space enlarged by the current rank-two support has dimension
`≤ 2^{r+1} - 2 ≤ n - 2`), a uniform nonzero vector lies in `S` with probability `≤ 1/q²`. [FromGrassmannianToSimplicial, node_20] -/
theorem avoidance_prob (n : ℕ) (S : Submodule F (Fin n → F))
    (hS : Module.finrank F S + 2 ≤ n) :
    ((Finset.univ.filter (fun w : Fin n → F => w ≠ 0 ∧ w ∈ S)).card : ℝ) ≤
      (1 / (Fintype.card F : ℝ) ^ 2) *
        ((Finset.univ.filter (fun w : Fin n → F => w ≠ 0)).card : ℝ) := by
  sorry

/-! ## Main theorem -/

/-- **Top-link expansion.** For `r ≥ 1`, `b ≥ 1`, `n ≥ 2^{r+1}`, `q = 2^b`, every link
`G_x`, `x ∈ X(r-2)` (binary dimension `r-1`; the zero subspace when `r = 1`), satisfies
`λ(G_x) ≤ 11/q`; hence `λ^{(r-2)}(X) ≤ 11/q`. [FromGrassmannianToSimplicial, node_20] -/
theorem topLink_expansion (b n r : ℕ) [CharP F 2] (hb : 1 ≤ b)
    (hq : Fintype.card F = 2 ^ b) (hr : 1 ≤ r) (hn : 2 ^ (r + 1) ≤ n)
    (x : Finset (Mat F n)) (hx : x ∈ facesDim F n r (r - 1)) :
    LinkLambdaLE n r x (11 / (2 : ℝ) ^ b) := by
  sorry

end TCSChallenge.FromGrassmannianToSimplicial.node_20
