/-!
## First homology of a Cayley simplicial complex modulo short cycles

Over `𝔽₂`, let `A ⊆ 𝔽₂^k ∖ {0}` and let `X(1)` be a family of triples `{a, b, a+b} ⊆ A` with
`a ≠ b`. Put `V = span A`. The complex `Y` has vertex set `V`, edges `{v, v+a}` (`v ∈ V`,
`a ∈ A`) and triangles `{v, v+a, v+b}` (`v ∈ V`, `{a,b,a+b} ∈ X(1)`). For `D ⊆ A` let `Γ_D` be the
graph on `V` with edges `{v, v+d}`, `d ∈ D`, and `S₁(Y) = ∑_{D ⊆ A, |D| ≤ 2} Z₁(Γ_D)`.

With `G_X ∈ 𝔽₂^{A×k}` (row `a` is `a`) and `H_X ∈ 𝔽₂^{X(1)×A}` (rows are incidence vectors of
triples), the main theorem `homology_quotient_iso` states that

  `H₁(Y) / (S₁(Y) + B₁(Y)) ≅ ker G_Xᵀ / im H_Xᵀ`,

via the isomorphism induced by the edge-label parity map `Φ`. Naturality is captured at the
chain level by `labelParity_pushChain`.
-/

namespace TCSChallenge.FromGrassmannianToSimplicial.node_27

/-- The ambient space `𝔽₂^k`. -/
abbrev Vec (k : ℕ) := Fin k → ZMod 2

/-- 1-chains over `𝔽₂`: functions on unordered pairs of points of `𝔽₂^k`. -/
abbrev Chain1 (k : ℕ) := Sym2 (Vec k) → ZMod 2

/-- "Let `A = X(0) ⊆ 𝔽₂^k ∖ {0}`, and let `X(1)` be a collection of triples `{a, b, a+b} ⊆ A`
with `a ≠ b`." -/
def IsTripleData {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k))) : Prop :=
  (0 : Vec k) ∉ A ∧
    ∀ t ∈ X1, ∃ a ∈ A, ∃ b ∈ A, a ≠ b ∧ a + b ∈ A ∧ t = ({a, b, a + b} : Finset (Vec k))

/-- "`V = span_{𝔽₂} A`." -/
def spanA {k : ℕ} (A : Finset (Vec k)) : Submodule (ZMod 2) (Vec k) :=
  Submodule.span (ZMod 2) (↑A : Set (Vec k))

/-- The elementary chain `[e]`. -/
def edgeChain {k : ℕ} (e : Sym2 (Vec k)) : Chain1 k :=
  Pi.single e 1

/-- The boundary `∂₁[{p,q}] = [p] + [q]`, extended linearly: `(∂₁ c)(v) = ∑_{e ∋ v} c(e)`. -/
def boundary1 (k : ℕ) : Chain1 k →ₗ[ZMod 2] (Vec k → ZMod 2) :=
  LinearMap.pi fun v : Vec k =>
    ∑ e ∈ Finset.univ.filter (fun e : Sym2 (Vec k) => v ∈ e),
      (LinearMap.proj e : Chain1 k →ₗ[ZMod 2] ZMod 2)

/-- "edges `{v, v+a}` (`v ∈ V`, `a ∈ A`)" of `Y`. -/
def Yedges {k : ℕ} (A : Finset (Vec k)) : Set (Sym2 (Vec k)) :=
  {e | ∃ v ∈ spanA A, ∃ a ∈ A, e = Sym2.mk (v, v + a)}

/-- "`Γ_D` is the graph on `V` with edges `{v, v+d}` for `v ∈ V` and `d ∈ D`." -/
def gammaEdges {k : ℕ} (A D : Finset (Vec k)) : Set (Sym2 (Vec k)) :=
  {e | ∃ v ∈ spanA A, ∃ d ∈ D, e = Sym2.mk (v, v + d)}

/-- Chains supported on an edge set `E` (the chain space `C₁` of the graph with edges `E`). -/
def chainsOn {k : ℕ} (E : Set (Sym2 (Vec k))) : Submodule (ZMod 2) (Chain1 k) :=
  Submodule.span (ZMod 2) (edgeChain '' E)

/-- `Z₁(Y) = ker ∂₁` on `C₁(Y)`. -/
def Z1Y {k : ℕ} (A : Finset (Vec k)) : Submodule (ZMod 2) (Chain1 k) :=
  chainsOn (Yedges A) ⊓ LinearMap.ker (boundary1 k)

/-- The cycle space `Z₁(Γ_D)`, regarded inside `Z₁(Y)`. -/
def Z1Gamma {k : ℕ} (A D : Finset (Vec k)) : Submodule (ZMod 2) (Chain1 k) :=
  chainsOn (gammaEdges A D) ⊓ LinearMap.ker (boundary1 k)

/-- "`S₁(Y) = ∑_{D ⊆ A, |D| ≤ 2} Z₁(Γ_D)`." -/
def S1 {k : ℕ} (A : Finset (Vec k)) : Submodule (ZMod 2) (Chain1 k) :=
  ⨆ (D : Finset (Vec k)) (_ : D ⊆ A ∧ D.card ≤ 2), Z1Gamma A D

/-- `∂₂[{v, v+a, v+b}] = [{v,v+a}] + [{v+a,v+b}] + [{v,v+b}]`. -/
def triangleBoundary {k : ℕ} (v a b : Vec k) : Chain1 k :=
  edgeChain (Sym2.mk (v, v + a)) + edgeChain (Sym2.mk (v + a, v + b)) +
    edgeChain (Sym2.mk (v, v + b))

/-- `B₁(Y) = im ∂₂`, spanned by the boundaries of the triangles `{v, v+a, v+b}`,
`v ∈ V`, `{a, b, a+b} ∈ X(1)`. -/
def B1 {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k))) :
    Submodule (ZMod 2) (Chain1 k) :=
  Submodule.span (ZMod 2)
    {c | ∃ v ∈ spanA A, ∃ a ∈ A, ∃ b ∈ A, a ≠ b ∧
      ({a, b, a + b} : Finset (Vec k)) ∈ X1 ∧ c = triangleBoundary v a b}

/-- The boundaries `B₁(Y)` as a subspace of the cycles `Z₁(Y)`. -/
def B1rel {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k))) :
    Submodule (ZMod 2) ↥(Z1Y A) :=
  Submodule.comap (Z1Y A).subtype (B1 A X1)

/-- `H₁(Y) = Z₁(Y) / B₁(Y)`. -/
abbrev H1Y {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k))) : Type :=
  ↥(Z1Y A) ⧸ B1rel A X1

/-- "The denominator on the left denotes its image under `Z₁(Y) → H₁(Y)`": the image of
`S₁(Y) + B₁(Y)` in `H₁(Y)`. -/
def SBimage {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k))) :
    Submodule (ZMod 2) (H1Y A X1) :=
  Submodule.map (B1rel A X1).mkQ (Submodule.comap (Z1Y A).subtype (B1 A X1 ⊔ S1 A))

/-- "For an edge `e = {p,q}`, its label is `L(e) = p + q`." -/
def edgeLabel {k : ℕ} : Sym2 (Vec k) → Vec k :=
  Sym2.lift ⟨fun p q => p + q, fun p q => add_comm p q⟩

/-- The edge-label parity map `Φ : C₁ → 𝔽₂^A`, `Φ([e]) = e_{L(e)}` (edges with label outside
`A` are sent to `0`; no edge of `Y` has such a label). -/
def labelParity {k : ℕ} (A : Finset (Vec k)) : Chain1 k →ₗ[ZMod 2] (↥A → ZMod 2) :=
  LinearMap.pi fun a : ↥A =>
    ∑ e ∈ Finset.univ.filter (fun e : Sym2 (Vec k) => edgeLabel e = (a : Vec k)),
      (LinearMap.proj e : Chain1 k →ₗ[ZMod 2] ZMod 2)

/-- "`G_X ∈ 𝔽₂^{A×k}` has row `a` at index `a ∈ A`." -/
def GX {k : ℕ} (A : Finset (Vec k)) : Matrix ↥A (Fin k) (ZMod 2) :=
  Matrix.of fun a i => (a : Vec k) i

/-- "`H_X ∈ 𝔽₂^{X(1)×A}` has the incidence vector of `t` as its row indexed by `t ∈ X(1)`." -/
def HX {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k))) :
    Matrix ↥X1 ↥A (ZMod 2) :=
  Matrix.of fun t a => if (a : Vec k) ∈ (t : Finset (Vec k)) then 1 else 0

/-- `ker G_Xᵀ ⊆ 𝔽₂^A`: the linear relations `∑_a u_a a = 0`. -/
def kerGT {k : ℕ} (A : Finset (Vec k)) : Submodule (ZMod 2) (↥A → ZMod 2) :=
  LinearMap.ker (Matrix.transpose (GX A)).mulVecLin

/-- `im H_Xᵀ ⊆ 𝔽₂^A`: the span of incidence vectors of triples. -/
def imHT {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k))) :
    Submodule (ZMod 2) (↥A → ZMod 2) :=
  LinearMap.range (Matrix.transpose (HX A X1)).mulVecLin

/-- The relation quotient `ker G_Xᵀ / im H_Xᵀ`. -/
abbrev RelQuot {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k))) : Type :=
  ↥(kerGT A) ⧸ Submodule.comap (kerGT A).subtype (imHT A X1)

/-- The chain of the walk starting at `v` that follows the labels `a₁, …, a_m`:
`c(w) = ∑_i [{v_{i-1}, v_i}]` with `v_0 = v`, `v_i = v_{i-1} + a_i`. -/
def walkChainFrom {k : ℕ} : Vec k → List (Vec k) → Chain1 k
  | _, [] => 0
  | v, a :: l => edgeChain (Sym2.mk (v, v + a)) + walkChainFrom (v + a) l

/-- The parity vector `∑_i e_{a_i}` of a label sequence (indexed by all of `𝔽₂^k`). -/
def labelVec {k : ℕ} (l : List (Vec k)) : Vec k → ZMod 2 :=
  (l.map fun x => (Pi.single x 1 : Vec k → ZMod 2)).sum

/-- Push-forward of a chain along a map of vertex sets: `(f_* c)(e') = ∑_{f(e) = e'} c(e)`. -/
def pushChain {k k' : ℕ} (f : Vec k →ₗ[ZMod 2] Vec k') (c : Chain1 k) : Chain1 k' :=
  fun e' => ∑ e ∈ Finset.univ.filter (fun e : Sym2 (Vec k) => Sym2.map f e = e'), c e

/-! ## Rubric 1–2: the canonical map and compatibility with the relations -/

/-- `B₁(Y) ⊆ Z₁(Y)`, so `H₁(Y)` is a well-defined quotient. [FromGrassmannianToSimplicial, node_27] -/
theorem B1_le_Z1Y {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k)))
    (hX : IsTripleData A X1) : B1 A X1 ≤ Z1Y A := by
  sorry

/-- `S₁(Y) ⊆ Z₁(Y)`. [FromGrassmannianToSimplicial, node_27] -/
theorem S1_le_Z1Y {k : ℕ} (A : Finset (Vec k)) : S1 A ≤ Z1Y A := by
  sorry

/-- Rubric 1: a cycle maps into `ker G_Xᵀ`. [FromGrassmannianToSimplicial, node_27] -/
theorem labelParity_mem_kerGT {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k)))
    (hX : IsTripleData A X1) (z : Chain1 k) (hz : z ∈ Z1Y A) :
    labelParity A z ∈ kerGT A := by
  sorry

/-- Rubric 2: a triangle boundary maps to the incidence vector of its triple. [FromGrassmannianToSimplicial, node_27] -/
theorem labelParity_triangleBoundary {k : ℕ} (A : Finset (Vec k))
    (X1 : Finset (Finset (Vec k))) (hX : IsTripleData A X1) (v a b : Vec k)
    (hv : v ∈ spanA A) (ha : a ∈ A) (hb : b ∈ A) (hab : a ≠ b)
    (ht : ({a, b, a + b} : Finset (Vec k)) ∈ X1) :
    labelParity A (triangleBoundary v a b) =
      (Matrix.transpose (HX A X1)).mulVec (Pi.single (⟨_, ht⟩ : ↥X1) 1) := by
  sorry

/-- Rubric 2: `Φ(B₁(Y)) ⊆ im H_Xᵀ`. [FromGrassmannianToSimplicial, node_27] -/
theorem B1_le_comap_imHT {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k)))
    (hX : IsTripleData A X1) :
    B1 A X1 ≤ Submodule.comap (labelParity A) (imHT A X1) := by
  sorry

/-- Rubric 2: `Φ(S₁(Y)) = 0`. [FromGrassmannianToSimplicial, node_27] -/
theorem S1_le_ker_labelParity {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k)))
    (hX : IsTripleData A X1) : S1 A ≤ LinearMap.ker (labelParity A) := by
  sorry

/-! ## Rubric 3–4: the inverse via closed walks -/

/-- Walk chains along label sequences in `A` that sum to zero are cycles of `Y`. [FromGrassmannianToSimplicial, node_27] -/
theorem walkChain_mem_Z1Y {k : ℕ} (A : Finset (Vec k)) (l : List (Vec k))
    (hl : ∀ x ∈ l, x ∈ A) (hsum : l.sum = 0) : walkChainFrom 0 l ∈ Z1Y A := by
  sorry

/-- Rubric 3: an adjacent interchange changes the walk chain by an element of `S₁(Y)`. [FromGrassmannianToSimplicial, node_27] -/
theorem walkChain_swap_mem_S1 {k : ℕ} (A : Finset (Vec k)) (l₁ l₂ : List (Vec k))
    (a b : Vec k) (hl₁ : ∀ x ∈ l₁, x ∈ A) (ha : a ∈ A) (hb : b ∈ A) :
    walkChainFrom 0 (l₁ ++ a :: b :: l₂) + walkChainFrom 0 (l₁ ++ b :: a :: l₂) ∈ S1 A := by
  sorry

/-- Rubric 3: deleting two consecutive equal labels leaves the chain unchanged. [FromGrassmannianToSimplicial, node_27] -/
theorem walkChain_cancel {k : ℕ} (v : Vec k) (l₁ l₂ : List (Vec k)) (a : Vec k) :
    walkChainFrom v (l₁ ++ a :: a :: l₂) = walkChainFrom v (l₁ ++ l₂) := by
  sorry

/-- Rubric 3: two label sequences in `A` with the same parity vector give walk chains that
agree modulo `S₁(Y)` (choice independence). [FromGrassmannianToSimplicial, node_27] -/
theorem walkChain_sub_mem_S1 {k : ℕ} (A : Finset (Vec k)) (l l' : List (Vec k))
    (hl : ∀ x ∈ l, x ∈ A) (hl' : ∀ x ∈ l', x ∈ A) (hpar : labelVec l = labelVec l') :
    walkChainFrom 0 l - walkChainFrom 0 l' ∈ S1 A := by
  sorry

/-- Rubric 4: concatenation of walks adds chains. [FromGrassmannianToSimplicial, node_27] -/
theorem walkChain_append {k : ℕ} (v : Vec k) (l₁ l₂ : List (Vec k)) :
    walkChainFrom v (l₁ ++ l₂) = walkChainFrom v l₁ + walkChainFrom (v + l₁.sum) l₂ := by
  sorry

/-- Rubric 4: the walk `(a, a+b, b)` of a triple is a triangle boundary. [FromGrassmannianToSimplicial, node_27] -/
theorem walkChain_triple_mem_B1 {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k)))
    (a b : Vec k) (ha : a ∈ A) (hb : b ∈ A) (hab : a ≠ b)
    (ht : ({a, b, a + b} : Finset (Vec k)) ∈ X1) :
    walkChainFrom 0 [a, a + b, b] ∈ B1 A X1 := by
  sorry

/-! ## Rubric 5: inverse identities and naturality -/

/-- `Φ(c(w)) = ∑_i e_{a_i}`, counted with multiplicity. [FromGrassmannianToSimplicial, node_27] -/
theorem labelParity_walkChain {k : ℕ} (A : Finset (Vec k)) (v : Vec k) (l : List (Vec k)) :
    labelParity A (walkChainFrom v l) = fun a : ↥A => labelVec l (a : Vec k) := by
  sorry

/-- Rubric 5: chains of closed walks based at `0` generate `Z₁(Y)`. [FromGrassmannianToSimplicial, node_27] -/
theorem Z1Y_le_span_closedWalks {k : ℕ} (A : Finset (Vec k)) :
    Z1Y A ≤ Submodule.span (ZMod 2)
      {c | ∃ l : List (Vec k), (∀ x ∈ l, x ∈ A) ∧ l.sum = 0 ∧ c = walkChainFrom 0 l} := by
  sorry

/-- Rubric 5 (naturality at the chain level): for a linear map `f` injective on `V`, pushing a
chain of `Y` forward along `f` and then taking label parities in `A' = f(A)` agrees with taking
label parities in `A` and reindexing by `a ↦ f a`. [FromGrassmannianToSimplicial, node_27] -/
theorem labelParity_pushChain {k k' : ℕ} (A : Finset (Vec k))
    (f : Vec k →ₗ[ZMod 2] Vec k') (hf : Set.InjOn f (spanA A : Set (Vec k)))
    (c : Chain1 k) (hc : c ∈ chainsOn (Yedges A)) (a : ↥A) :
    labelParity (A.image f) (pushChain f c) ⟨f a, Finset.mem_image_of_mem f a.2⟩ =
      labelParity A c a := by
  sorry

/-! ## Main theorem -/

/-- **Main theorem.** `H₁(Y) / (S₁(Y) + B₁(Y)) ≅ ker G_Xᵀ / im H_Xᵀ`, via the isomorphism that
sends the class of a cycle `z` to the class of its edge-label parity vector `Φ z`. [FromGrassmannianToSimplicial, node_27] -/
theorem homology_quotient_iso {k : ℕ} (A : Finset (Vec k)) (X1 : Finset (Finset (Vec k)))
    (hX : IsTripleData A X1) :
    ∃ ψ : (H1Y A X1 ⧸ SBimage A X1) ≃ₗ[ZMod 2] RelQuot A X1,
      ∀ (z : ↥(Z1Y A)) (u : ↥(kerGT A)),
        (u : ↥A → ZMod 2) = labelParity A (z : Chain1 k) →
          ψ (Submodule.Quotient.mk (Submodule.Quotient.mk z)) = Submodule.Quotient.mk u := by
  sorry

