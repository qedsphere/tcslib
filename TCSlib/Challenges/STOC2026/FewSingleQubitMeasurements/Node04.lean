/-!
## A one-copy single-qubit certification test

Let `|H⟩` be a pure `n`-qubit state. We ask for a randomized procedure, using only adaptive
single-qubit projective measurements on one copy of an unknown `n`-qubit state `ρ`, that
outputs Accept/Reject with
`Pr[Accept] ≥ ⟨H|ρ|H⟩` and `Pr[Reject] ≥ (1 − ⟨H|ρ|H⟩)/n` for every density matrix `ρ`.

States are vectors `QIdx n → ℂ` with `QIdx n = Fin n → Fin 2`; an adaptive procedure is a
finite tree (`LocalProtocol`). Main theorem: `main_theorem`.
-/

namespace TCSChallenge.FewSingleQubitMeasurements.node_04

/-! ## Shared definitions (byte-identical in S00 and S01) -/

/-- Computational-basis labels of an `n`-qubit register: a bit for each qubit. -/
abbrev QIdx (n : ℕ) : Type := Fin n → Fin 2

/-- "a pure `n`-qubit state": a unit vector in `(ℂ²)^{⊗ n} ≅ ℂ^{QIdx n}`. -/
def IsUnitVec {n : ℕ} (H : QIdx n → ℂ) : Prop :=
  ∑ x, Complex.normSq (H x) = 1

/-- "an `n`-qubit mixed state": a positive semidefinite matrix of trace one. -/
def IsDensity {n : ℕ} (ρ : Matrix (QIdx n) (QIdx n) ℂ) : Prop :=
  ρ.PosSemidef ∧ ρ.trace = 1

/-- The fidelity `F = ⟨H|ρ|H⟩` (real part; it is real for Hermitian `ρ`). -/
def fidelity {n : ℕ} (H : QIdx n → ℂ) (ρ : Matrix (QIdx n) (QIdx n) ℂ) : ℝ :=
  (∑ x, ∑ y, star (H x) * ρ x y * H y).re

/-- The product operator `A₁ ⊗ ⋯ ⊗ Aₙ` written entrywise:
`(A₁ ⊗ ⋯ ⊗ Aₙ)_{x,y} = ∏ⱼ (Aⱼ)_{xⱼ,yⱼ}`. -/
def tensorOp {n : ℕ} (A : Fin n → Matrix (Fin 2) (Fin 2) ℂ) : Matrix (QIdx n) (QIdx n) ℂ :=
  Matrix.of fun x y => ∏ j, A j (x j) (y j)

/-- The rank-one projector `|u_b⟩⟨u_b|` onto the `b`-th column `u_b` of a one-qubit
matrix `U` (the measurement basis is the set of columns of a unitary `U`). -/
def colProj (U : Matrix (Fin 2) (Fin 2) ℂ) (b : Fin 2) : Matrix (Fin 2) (Fin 2) ℂ :=
  Matrix.vecMulVec (fun a => U a b) (fun a => star (U a b))

/-- An adaptive single-qubit measurement procedure on one copy: "every physical measurement
must act on a single qubit, although its basis may be chosen adaptively". A node measures
qubit `i` in the orthonormal basis given by the columns of `U`, and continues with
`next b` on outcome `b`; a leaf outputs `reject = true` (Reject) or `false` (Accept).
The bases may depend on the hypothesis (the tree is chosen knowing it) and on outcomes
already observed (the tree position), but not on the lab state. -/
inductive LocalProtocol (n : ℕ) : Type
  | leaf (reject : Bool) : LocalProtocol n
  | measure (i : Fin n) (U : Matrix (Fin 2) (Fin 2) ℂ) (next : Fin 2 → LocalProtocol n) :
      LocalProtocol n

/-- Well-formedness: every basis is orthonormal (`U` unitary) and no qubit is measured
twice along a path (`used` = qubits measured so far). -/
def LocalProtocol.WellFormed {n : ℕ} : Finset (Fin n) → LocalProtocol n → Prop
  | _, .leaf _ => True
  | used, .measure i U next =>
      i ∉ used ∧ U ∈ Matrix.unitaryGroup (Fin 2) ℂ ∧
        ∀ b : Fin 2, LocalProtocol.WellFormed (insert i used) (next b)

/-- Number of single-qubit measurements on the longest path. -/
def LocalProtocol.depth {n : ℕ} : LocalProtocol n → ℕ
  | .leaf _ => 0
  | .measure _ _ next => 1 + max (LocalProtocol.depth (next 0)) (LocalProtocol.depth (next 1))

/-- Born rule for a sequence of single-qubit projective measurements on distinct qubits:
the probability of a root-to-leaf path is `tr(ρ · ⊗ⱼ Pⱼ)`, where `Pⱼ` is the projector
selected on qubit `j` (identity on unmeasured qubits). `A` accumulates the factors. The
result is the probability of output `out` (`true` = Reject). -/
def LocalProtocol.outcomeProbAux {n : ℕ} (ρ : Matrix (QIdx n) (QIdx n) ℂ) (out : Bool) :
    LocalProtocol n → (Fin n → Matrix (Fin 2) (Fin 2) ℂ) → ℝ
  | .leaf r, A => if r = out then (Matrix.trace (ρ * tensorOp A)).re else 0
  | .measure i U next, A =>
      ∑ b : Fin 2, LocalProtocol.outcomeProbAux ρ out (next b) (Function.update A i (colProj U b))

/-- Probability that the procedure outputs `out` on input state `ρ`
(initially all tensor factors are the identity). -/
def LocalProtocol.outcomeProb {n : ℕ} (ρ : Matrix (QIdx n) (QIdx n) ℂ) (out : Bool)
    (P : LocalProtocol n) : ℝ :=
  LocalProtocol.outcomeProbAux ρ out P (fun _ => 1)

/-- A one-copy test using internal randomness: a finite mixture of adaptive procedures
with weights given by a finite distribution `w` on the indices. -/
structure RandLocalTest (n : ℕ) where
  m : ℕ
  w : FinDist (Fin m)
  P : Fin m → LocalProtocol n

/-- Validity of a randomized test: every procedure in the mixture is well formed
(the weights are a probability vector by construction of `FinDist`). -/
def RandLocalTest.Valid {n : ℕ} (T : RandLocalTest n) : Prop :=
  ∀ k, LocalProtocol.WellFormed ∅ (T.P k)

/-- Probability that the randomized test outputs `out` (`true` = Reject) on `ρ`. -/
def RandLocalTest.prob {n : ℕ} (T : RandLocalTest n) (ρ : Matrix (QIdx n) (QIdx n) ℂ)
    (out : Bool) : ℝ :=
  ∑ k, T.w k * LocalProtocol.outcomeProb ρ out (T.P k)

/-! ## Lemma stubs for the one-copy test (rubric items) -/

/-- Supplied Bloch-sphere fact, used for the jointly uniform adaptive basis: for any two
one-qubit states there is an orthonormal basis in which each outcome has probability
`1/2` under both. [FewSingleQubitMeasurements, node_04] -/
theorem exists_joint_unbiased_basis (ρ₁ ρ₂ : Matrix (Fin 2) (Fin 2) ℂ)
    (h₁ : ρ₁.PosSemidef ∧ ρ₁.trace = 1) (h₂ : ρ₂.PosSemidef ∧ ρ₂.trace = 1) :
    ∃ U ∈ Matrix.unitaryGroup (Fin 2) ℂ, ∀ b : Fin 2,
      (∑ a, ∑ a', star (U a b) * ρ₁ a a' * U a' b).re = 1 / 2 ∧
      (∑ a, ∑ a', star (U a b) * ρ₂ a a' * U a' b).re = 1 / 2 := by
  sorry

/-- Quadratic identity (4) behind the one-step fidelity increment:
`|α|² + |β|² − |a₀α + a₁β|² = |a₁α − a₀β|²` when `a₀² + a₁² = 1`. [FewSingleQubitMeasurements, node_04] -/
theorem fidelity_increment_identity (a₀ a₁ : ℝ) (α β : ℂ) (h : a₀ ^ 2 + a₁ ^ 2 = 1) :
    Complex.normSq α + Complex.normSq β - Complex.normSq (a₀ * α + a₁ * β) =
      Complex.normSq (a₁ * α - a₀ * β) := by
  sorry

/-- The two outputs are complementary: for a well-formed procedure and a density matrix,
`Pr[Accept] + Pr[Reject] = 1`. [FewSingleQubitMeasurements, node_04] -/
theorem outcomeProb_add_eq_one {n : ℕ} (P : LocalProtocol n) (hP : LocalProtocol.WellFormed ∅ P)
    (ρ : Matrix (QIdx n) (QIdx n) ℂ) (hρ : IsDensity ρ) :
    LocalProtocol.outcomeProb ρ false P + LocalProtocol.outcomeProb ρ true P = 1 := by
  sorry

/-- Mixed-state extension: outcome probabilities are affine in the input state, since the
procedure is fixed independently of the lab state. [FewSingleQubitMeasurements, node_04] -/
theorem outcomeProb_convex {n : ℕ} (P : LocalProtocol n) (ρ₁ ρ₂ : Matrix (QIdx n) (QIdx n) ℂ)
    (t : ℝ) (out : Bool) :
    LocalProtocol.outcomeProb ((t : ℂ) • ρ₁ + ((1 - t : ℝ) : ℂ) • ρ₂) out P =
      t * LocalProtocol.outcomeProb ρ₁ out P + (1 - t) * LocalProtocol.outcomeProb ρ₂ out P := by
  sorry

/-- A well-formed procedure performs at most `n` single-qubit measurements per copy. [FewSingleQubitMeasurements, node_04] -/
theorem depth_le_of_wellFormed {n : ℕ} (P : LocalProtocol n) (used : Finset (Fin n))
    (hP : LocalProtocol.WellFormed used P) : LocalProtocol.depth P + used.card ≤ n := by
  sorry

/-- **One-copy test** (the central construction): random pivot `k`, computational-basis
prefix, jointly uniform adaptive suffix basis, final one-qubit hypothesis test. For every
lab state, `Pr[Accept] ≥ F` and `Pr[Reject] ≥ (1 − F)/n`. [FewSingleQubitMeasurements, node_04] -/
theorem exists_one_copy_test (n : ℕ) (hn : 1 ≤ n) (H : QIdx n → ℂ) (hH : IsUnitVec H) :
    ∃ T : RandLocalTest n, T.Valid ∧ ∀ ρ : Matrix (QIdx n) (QIdx n) ℂ, IsDensity ρ →
      fidelity H ρ ≤ T.prob ρ false ∧ (1 - fidelity H ρ) / n ≤ T.prob ρ true := by
  sorry

/-! ## Main theorem -/

/-- **Main theorem (node_04).** For every `n ≥ 1` and pure state `|H⟩` there is a randomized
adaptive single-qubit-measurement procedure, fixed before the lab state, measuring each
qubit at most once (so at most `n` single-qubit measurements), such that for every
`n`-qubit density matrix `ρ`:
`Pr[Accept] ≥ ⟨H|ρ|H⟩` and `Pr[Reject] ≥ (1 − ⟨H|ρ|H⟩)/n`. [FewSingleQubitMeasurements, node_04] -/
theorem main_theorem (n : ℕ) (hn : 1 ≤ n) (H : QIdx n → ℂ) (hH : IsUnitVec H) :
    ∃ T : RandLocalTest n, T.Valid ∧
      (∀ k, LocalProtocol.depth (T.P k) ≤ n) ∧
      ∀ ρ : Matrix (QIdx n) (QIdx n) ℂ, IsDensity ρ →
        fidelity H ρ ≤ T.prob ρ false ∧ (1 - fidelity H ρ) / n ≤ T.prob ρ true := by
  sorry

end TCSChallenge.FewSingleQubitMeasurements.node_04
