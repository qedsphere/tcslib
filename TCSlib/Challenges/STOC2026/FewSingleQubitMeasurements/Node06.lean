/-!
## Weakly adaptive single-copy measurements cannot distinguish a coherent superposition
# from the incoherent mixture

For every `n ≥ 1` there are a pure `n`-qubit state `|hyp⟩` and a density operator `ρ_lab`
with `⟨hyp|ρ_lab|hyp⟩ ≤ 2^{-c₁ n}` such that every `c₂ n`-adaptive algorithm (per copy:
product bases outside a set `S` with `|S| ≤ c₂ n`, then an arbitrary outcome-dependent
basis on `S`; adaptive across copies) that distinguishes the two with success probability
`≥ 1/2 + 2^{-c₃ n}` (equal priors) needs at least `2^{c₄ n}` copies.

Main theorem: `main_theorem`.
-/

namespace TCSChallenge.FewSingleQubitMeasurements.node_06

/-- Computational-basis labels of an `n`-qubit register: a bit for each qubit. -/
abbrev QIdx (n : ℕ) : Type := Fin n → Fin 2

/-- "a pure `n`-qubit state": a unit vector in `(ℂ²)^{⊗ n} ≅ ℂ^{QIdx n}`. -/
def IsUnitVec {n : ℕ} (H : QIdx n → ℂ) : Prop :=
  ∑ x, Complex.normSq (H x) = 1

/-- "an `n`-qubit density operator": a positive semidefinite matrix of trace one. -/
def IsDensity {n : ℕ} (ρ : Matrix (QIdx n) (QIdx n) ℂ) : Prop :=
  ρ.PosSemidef ∧ ρ.trace = 1

/-- The fidelity `⟨hyp|ρ|hyp⟩` (real part; it is real for Hermitian `ρ`). -/
def fidelity {n : ℕ} (H : QIdx n → ℂ) (ρ : Matrix (QIdx n) (QIdx n) ℂ) : ℝ :=
  (∑ x, ∑ y, star (H x) * ρ x y * H y).re

/-- The pure-state density operator `σ = |ψ⟩⟨ψ|`. -/
def pureDensity {n : ℕ} (ψ : QIdx n → ℂ) : Matrix (QIdx n) (QIdx n) ℂ :=
  Matrix.of fun x y => ψ x * star (ψ y)

/-- One-copy measurement of the `ℓ`-adaptive class: a set `S` of adaptive qubits, a
single-qubit basis `U i` (columns) for each qubit (used for `i ∉ S`), and, for every
outcome `y` on `[n] \ S`, an arbitrary basis `W y` (columns) of the `S`-register. -/
structure LAdaptiveMeas (n : ℕ) where
  S : Finset (Fin n)
  U : Fin n → Matrix (Fin 2) (Fin 2) ℂ
  W : ({i // i ∉ S} → Fin 2) →
    Matrix ({i // i ∈ S} → Fin 2) ({i // i ∈ S} → Fin 2) ℂ

/-- "chooses a set `S ⊆ [n]` with `|S| ≤ ℓ`, measures `[n] \ S` nonadaptively in a product
of single-qubit orthonormal bases, and then measures `S` in an arbitrary orthonormal basis
that may depend on the outcomes from `[n] \ S`". (`|S| ≤ ℓ` for real `ℓ` is `|S| ≤ ⌊ℓ⌋`.) -/
def LAdaptiveMeas.Valid {n : ℕ} (M : LAdaptiveMeas n) (ℓ : ℝ) : Prop :=
  (M.S.card : ℝ) ≤ ℓ ∧ (∀ i, M.U i ∈ Matrix.unitaryGroup (Fin 2) ℂ) ∧
    ∀ y, M.W y ∈ Matrix.unitaryGroup ({i // i ∈ M.S} → Fin 2) ℂ

/-- The measurement basis vector `|e_{y,z}⟩ = ⊗_{i∉S} |φ^i_{y_i}⟩ ⊗ |η^y_z⟩`, indexed by a
full outcome `ω` whose restriction to `[n] \ S` is `y` and to `S` is `z`. -/
def LAdaptiveMeas.vec {n : ℕ} (M : LAdaptiveMeas n) (ω : QIdx n) : QIdx n → ℂ := fun x =>
  (∏ i ∈ M.Sᶜ, M.U i (x i) (ω i)) *
    M.W (fun i => ω i.1) (fun i => x i.1) (fun i => ω i.1)

/-- Born probability `⟨e_ω|τ|e_ω⟩` of outcome `ω` on state `τ`. -/
def LAdaptiveMeas.prob {n : ℕ} (M : LAdaptiveMeas n) (τ : Matrix (QIdx n) (QIdx n) ℂ)
    (ω : QIdx n) : ℝ :=
  (∑ x, ∑ y, star (M.vec ω x) * τ x y * M.vec ω y).re

/-- An adaptive strategy across copies: the measurement on the next copy is a function of
the list of outcomes on earlier copies. -/
abbrev Strategy (n : ℕ) : Type := List (QIdx n) → LAdaptiveMeas n

/-- Probability of the transcript `t` (outcomes on copies `0, …, m-1`) when every copy is
`τ`: product of the conditional one-copy outcome probabilities. -/
def transcriptProb {n m : ℕ} (τ : Matrix (QIdx n) (QIdx n) ℂ) (σ : Strategy n)
    (t : Fin m → QIdx n) : ℝ :=
  ∏ j : Fin m,
    (σ (List.ofFn (fun i : Fin j.val => t ⟨i.val, lt_trans i.isLt j.isLt⟩))).prob τ (t j)

/-- Success probability with equal priors, where `D t ∈ [0,1]` is the probability of
answering "hyp" on transcript `t`. -/
def successProb {n : ℕ} (m : ℕ) (ψ : QIdx n → ℂ) (ρ : Matrix (QIdx n) (QIdx n) ℂ)
    (σ : Strategy n) (D : (Fin m → QIdx n) → ℝ) : ℝ :=
  (1 / 2) * ∑ t, transcriptProb (pureDensity ψ) σ t * D t +
    (1 / 2) * ∑ t, transcriptProb ρ σ t * (1 - D t)

/-! ## Lemma stubs (rubric items) -/

/-- Five-pair graph labelling: for any five distinct unordered pairs (a simple graph with
five edges), some labelling of the vertices by `{0,1,2,3}` realises each of the label pairs
`{0,1}, {0,2}, {0,3}` on some edge. [FewSingleQubitMeasurements, node_06] -/
theorem five_edge_labeling {V : Type} (E : Finset (Sym2 V)) (hE : E.card = 5)
    (hdiag : ∀ e ∈ E, ¬ e.IsDiag) :
    ∃ L : V → Fin 4, ∀ b : Fin 4, b ≠ 0 → ∃ e ∈ E, Sym2.map L e = s(0, b) := by
  sorry

/-- Sequential (hybrid) bound: if every allowed one-copy measurement has total-variation
distance at most `η` between `σ = |ψ⟩⟨ψ|` and `ρ`, then any `m`-copy adaptive algorithm has
success probability at most `1/2 + m η / 2`. [FewSingleQubitMeasurements, node_06] -/
theorem success_le_of_one_copy_tv {n : ℕ} (ℓ η : ℝ) (ψ : QIdx n → ℂ) (hψ : IsUnitVec ψ)
    (ρ : Matrix (QIdx n) (QIdx n) ℂ) (hρ : IsDensity ρ)
    (htv : ∀ M : LAdaptiveMeas n, M.Valid ℓ →
      (1 / 2) * ∑ ω, |M.prob (pureDensity ψ) ω - M.prob ρ ω| ≤ η)
    (m : ℕ) (σ : Strategy n) (hσ : ∀ h, (σ h).Valid ℓ)
    (D : (Fin m → QIdx n) → ℝ) (hD : ∀ t, 0 ≤ D t ∧ D t ≤ 1) :
    successProb m ψ ρ σ D ≤ 1 / 2 + m * η / 2 := by
  sorry

/-- One-copy indistinguishability for the construction (coherent superposition of
codeword product states versus their incoherent mixture): there are `c₁, c₂, c > 0` with
small fidelity and one-copy TV `≤ 2^{-c n}` against every `c₂ n`-adaptive measurement,
for all sufficiently large `n`. [FewSingleQubitMeasurements, node_06] -/
theorem exists_hard_pair_large_n :
    ∃ c₁ c₂ c : ℝ, 0 < c₁ ∧ 0 < c₂ ∧ 0 < c ∧ ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
      ∃ ψ : QIdx n → ℂ, IsUnitVec ψ ∧ ∃ ρ : Matrix (QIdx n) (QIdx n) ℂ, IsDensity ρ ∧
        fidelity ψ ρ ≤ (2 : ℝ) ^ (-(c₁ * n)) ∧
        ∀ M : LAdaptiveMeas n, M.Valid (c₂ * n) →
          (1 / 2) * ∑ ω, |M.prob (pureDensity ψ) ω - M.prob ρ ω| ≤ (2 : ℝ) ^ (-(c * n)) := by
  sorry

/-! ## Main theorem -/

/-- **Main theorem (node_06).** There are absolute constants `c₁, c₂, c₃, c₄ > 0` such that
for every `n ≥ 1` there are a pure state `|hyp⟩` and a density operator `ρ_lab` with
`⟨hyp|ρ_lab|hyp⟩ ≤ 2^{-c₁ n}`, yet every `c₂ n`-adaptive algorithm on `m` copies whose
equal-prior success probability is at least `1/2 + 2^{-c₃ n}` has `m ≥ 2^{c₄ n}`. [FewSingleQubitMeasurements, node_06] -/
theorem main_theorem :
    ∃ c₁ c₂ c₃ c₄ : ℝ, 0 < c₁ ∧ 0 < c₂ ∧ 0 < c₃ ∧ 0 < c₄ ∧
      ∀ n : ℕ, 1 ≤ n →
        ∃ ψ : QIdx n → ℂ, IsUnitVec ψ ∧ ∃ ρ : Matrix (QIdx n) (QIdx n) ℂ, IsDensity ρ ∧
          fidelity ψ ρ ≤ (2 : ℝ) ^ (-(c₁ * n)) ∧
          ∀ (m : ℕ) (σ : Strategy n) (D : (Fin m → QIdx n) → ℝ),
            (∀ h, (σ h).Valid (c₂ * n)) → (∀ t, 0 ≤ D t ∧ D t ≤ 1) →
            1 / 2 + (2 : ℝ) ^ (-(c₃ * n)) ≤ successProb m ψ ρ σ D →
            (2 : ℝ) ^ (c₄ * n) ≤ m := by
  sorry

end TCSChallenge.FewSingleQubitMeasurements.node_06
