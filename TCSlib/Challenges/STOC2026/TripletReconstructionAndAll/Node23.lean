/-!
## Approximation resistance of phylogenetic CSPs: the hard instance `I_d`

A phylogenetic payoff `f` of arity `k ≥ 2` takes values in `[0,1]` and depends only on the
reduced ordered rooted tree induced by its (distinct) argument leaves. Leaves of finite ordered
binary trees are encoded as prefix-free strings in `{0,1}*`, and infinite paths (binary
expansions) as `ℕ → Bool`; finite strings are padded by `false`, which does not change the
point where two prefix-free strings diverge.

The instance `I_d` lives on the leaves `V_d = (Fin d → Fin k)` of the perfect `k`-ary tree of
depth `d`: choose a level `ℓ < d`, a node `u` at that level, and `v_j` uniformly below the
`j`-th child of `u`. Main theorem `main_theorem`: for every `ε > 0` and all large `d`,
`opt(I_d) = 1` and `E_π[opt(I_d | π)] ≤ α + ε`, where `α` is the supremum over absolutely
continuous probability measures on `[0,1]` of the expected payoff of `k` i.i.d. samples.
-/

namespace TCSChallenge.TripletReconstructionAndAll.node_23

/-- An infinite path in the ordered binary tree (`false` = left, `true` = right). -/
abbrev IPath := ℕ → Bool

/-- A finite root-to-leaf string, padded by `false` to an infinite path. -/
def pad (s : List Bool) : IPath := fun n => s.getD n false

/-- Depth of the lowest common ancestor of two distinct paths: the first index where they
differ (it is `0` for equal paths, a case never used). -/
def cpLen (a b : IPath) : ℕ := sInf {n : ℕ | a n ≠ b n}

/-- `a` lies strictly to the left of `b`. -/
def LexLt (a b : IPath) : Prop := a ≠ b ∧ a (cpLen a b) = false

/-- The `k` argument leaves are pairwise distinct. -/
def AllDistinct {k : ℕ} (x : Fin k → IPath) : Prop := ∀ i j : Fin k, i ≠ j → x i ≠ x j

/-- "The reduced ordered rooted tree induced by the argument leaves" is the same for `x`
and `y`: same left-to-right order of arguments and the same rooted triplets
(`ij|l` iff the LCA of `i,j` is strictly deeper than that of `i,l`). For distinct leaves of a
binary tree these data determine the reduced ordered tree. -/
def SamePattern {k : ℕ} (x y : Fin k → IPath) : Prop :=
  (∀ i j : Fin k, LexLt (x i) (x j) ↔ LexLt (y i) (y j)) ∧
  (∀ i j l : Fin k,
    cpLen (x i) (x l) < cpLen (x i) (x j) ↔ cpLen (y i) (y l) < cpLen (y i) (y j))

/-- "a fixed phylogenetic CSP payoff of arity `k`, taking values in `[0,1]`; its value depends
only on the reduced ordered rooted tree induced by its distinct labeled argument leaves". -/
def IsPhyloPayoff (k : ℕ) (f : (Fin k → IPath) → ℝ) : Prop :=
  (∀ x, 0 ≤ f x ∧ f x ≤ 1) ∧
  (∀ x y, AllDistinct x → AllDistinct y → SamePattern x y → f x = f y)

/-- Prefix-free family of strings (no string is a prefix of another, nor equal to it): exactly
an injective assignment to leaves of some finite ordered rooted binary tree. -/
def PrefixFree {ι : Type} (φ : ι → List Bool) : Prop :=
  ∀ u v : ι, u ≠ v → ¬ List.IsPrefix (φ u) (φ v)

/-- "after a fixed relabeling `σ` of its arguments, there is an ordered rooted binary pattern
`P` with argument labels appearing from left to right in argument order such that `f(P)=1`". -/
def HasOrderedSatPattern (k : ℕ) (f : (Fin k → IPath) → ℝ) : Prop :=
  ∃ σ : Equiv.Perm (Fin k), ∃ P : Fin k → List Bool,
    PrefixFree P ∧ (∀ i j : Fin k, i < j → LexLt (pad (P i)) (pad (P j))) ∧
    f (fun j => pad (P (σ j))) = 1

/-- Leaves `V_d` of the perfect ordered `k`-ary tree of depth `d` (child index at each level);
`|V_d| = k^d`. -/
abbrev Leaf (k d : ℕ) : Type := Fin d → Fin k

/-- The tuple `v` arises from the node at level `l` that is the common length-`l` prefix of all
`v_j`, with `v_j` below its `j`-th child. -/
def LevelHits (k d : ℕ) (l : Fin d) (v : Fin k → Leaf k d) : Prop :=
  (∀ j j' : Fin k, ∀ i : Fin d, i < l → v j i = v j' i) ∧ ∀ j : Fin k, v j l = j

/-- Sampling probability of the constraint `v` in `I_d`: level uniform in `{0,…,d-1}`
(prob. `1/d`), node uniform at that level (`1/k^ℓ`), each `v_j` uniform among the
`k^(d-ℓ-1)` leaves below the `j`-th child. -/
def weight (k d : ℕ) (v : Fin k → Leaf k d) : ℝ :=
  ∑ l : Fin d, if LevelHits k d l v then
    (1 / (d : ℝ)) * (1 / (k : ℝ) ^ (l : ℕ)) * (1 / (k : ℝ) ^ (d - 1 - (l : ℕ))) ^ k else 0

/-- `val(φ, I_d) = E_{v ∼ I_d} f(T; φ(v_1), …, φ(v_k))`. -/
def solVal (k d : ℕ) (f : (Fin k → IPath) → ℝ) (φ : Leaf k d → List Bool) : ℝ :=
  ∑ v : Fin k → Leaf k d, weight k d v * f (fun j => pad (φ (v j)))

/-- An ordering `π` of the variables, as a bijection to positions `Fin (k^d)`. -/
abbrev VarOrder (k d : ℕ) : Type := Leaf k d ≃ Fin (k ^ d)

/-- The assigned leaves occur from left to right in the order specified by `π`. -/
def Respects {k d : ℕ} (π : VarOrder k d) (φ : Leaf k d → List Bool) : Prop :=
  ∀ u v : Leaf k d, π u < π v → LexLt (pad (φ u)) (pad (φ v))

/-- Binary expansion of `t ∈ [0,1]`: digit `n` is `⌊2^{n+1} t⌋ mod 2`. -/
def binExp (t : ℝ) : IPath := fun n => decide (⌊(2 : ℝ) ^ (n + 1) * t⌋ % 2 = 1)

/-- Absolutely continuous probability measure on `[0,1]`. -/
def IsACProb (ρ : Measure ℝ) : Prop :=
  IsProbabilityMeasure ρ ∧ Measure.AbsolutelyContinuous ρ volume ∧ ρ (Set.Icc (0 : ℝ) 1)ᶜ = 0

/-- Expected payoff of `k` independent samples from `ρ`, read as binary-expansion paths. -/
def biasedPayoff (k : ℕ) (f : (Fin k → IPath) → ℝ) (ρ : Measure ℝ) : ℝ :=
  ∫ t, f (fun j => binExp (t j)) ∂(Measure.pi fun _ : Fin k => ρ)

/-- `α = sup_ρ E_{ρ^{⊗k}}[f]` over absolutely continuous probability measures on `[0,1]`. -/
def alpha (k : ℕ) (f : (Fin k → IPath) → ℝ) : ℝ :=
  ⨆ ρ : {ρ : Measure ℝ // IsACProb ρ}, biasedPayoff k f ρ.1

/-- `E_{Y ∼ p^{⊗k}} g(Y)` for a distribution `p` on the finite alphabet `Fin r`. -/
def productExp {k r : ℕ} (p : FinDist (Fin r)) (g : (Fin k → Fin r) → ℝ) : ℝ :=
  ∑ y : Fin k → Fin r, (∏ j, p (y j)) * g y

/-- The supplied comparison result: for every `q`, `η > 0` there is `D(k,q,η)` such that for
`d ≥ D`, every alphabet of size `≤ q`, every `g : A^k → [0,1]` and every labelling
`a : V_d → A`, the instance value is at most `max_p E_{p^{⊗k}} g + η`. -/
def ComparisonFact (k : ℕ) : Prop :=
  ∀ q : ℕ, ∀ η : ℝ, 0 < η → ∃ D : ℕ, ∀ d : ℕ, D ≤ d → ∀ r : ℕ, r ≤ q →
    ∀ g : (Fin k → Fin r) → ℝ, (∀ y, 0 ≤ g y ∧ g y ≤ 1) →
      ∀ a : Leaf k d → Fin r,
        ∃ p : FinDist (Fin r),
          ∑ v : Fin k → Leaf k d, weight k d v * g (fun j => a (v j)) ≤ productExp p g + η

/-- Recursive substitution: the leaf `v` gets the concatenation over levels `i` of the pattern
string for child index `v i` (child `j` is placed at the leaf `P (σ j)`). -/
def substSolution {k : ℕ} (d : ℕ) (σ : Equiv.Perm (Fin k)) (P : Fin k → List Bool)
    (v : Leaf k d) : List Bool :=
  (List.ofFn fun i : Fin d => P (σ (v i))).flatten

/-- Pessimistic ("lower") payoff of a bounded representation: representative leaves `R`,
colors `c`; tuples with a repeated color get payoff `0`. -/
def lowerPayoff {k r q : ℕ} (f : (Fin k → IPath) → ℝ) (R : Fin r → List Bool)
    (c : Fin r → Fin q) (y : Fin k → Fin r) : ℝ :=
  if ∀ i j : Fin k, i ≠ j → c (y i) ≠ c (y j) then f (fun j => pad (R (y j))) else 0

/-- Weight of constraints whose arguments receive a repeated position color under `π`. -/
def repWeight (k d q : ℕ) (col : Fin (k ^ d) → Fin q) (π : VarOrder k d) : ℝ :=
  ∑ v : Fin k → Leaf k d,
    weight k d v * (if ∃ i j : Fin k, i ≠ j ∧ col (π (v i)) = col (π (v j)) then 1 else 0)

/-- A coloring of positions into at most `q` consecutive intervals (via a monotone map onto
`r ≤ q` interval labels), each color used on at most `η m` positions. -/
def IntervalColoring (q m : ℕ) (η : ℝ) (col : Fin m → Fin q) : Prop :=
  (∃ r : ℕ, r ≤ q ∧ ∃ a : Fin m → Fin r, Monotone a ∧ ∃ c : Fin r → Fin q,
      col = fun i => c (a i)) ∧
  ∀ b : Fin q, ((Finset.univ.filter fun i => col i = b).card : ℝ) ≤ η * m

/-! ## Lemma stubs (intermediate claims of the strategy) -/

/-- Constraint weights are sampling probabilities and sum to `1`. [TripletReconstructionAndAll, node_23] -/
theorem weight_sum_eq_one (k d : ℕ) (hk : 2 ≤ k) (hd : 1 ≤ d) :
    (∀ v, 0 ≤ weight k d v) ∧ ∑ v : Fin k → Leaf k d, weight k d v = 1 := by
  sorry

/-- Every sampled constraint takes its arguments from distinct children of one node, so the
substituted leaves induce exactly the pattern `P ∘ σ`. [TripletReconstructionAndAll, node_23] -/
theorem subst_pattern (k d : ℕ) (σ : Equiv.Perm (Fin k)) (P : Fin k → List Bool)
    (hP : PrefixFree P) (l : Fin d) (v : Fin k → Leaf k d) (hv : LevelHits k d l v) :
    AllDistinct (fun j => pad (substSolution d σ P (v j))) ∧
    SamePattern (fun j => pad (substSolution d σ P (v j))) (fun j => pad (P (σ j))) := by
  sorry

/-- Completeness: the recursive substitution is a solution of value `1`. [TripletReconstructionAndAll, node_23] -/
theorem subst_complete (k d : ℕ) (hk : 2 ≤ k) (hd : 1 ≤ d) (f : (Fin k → IPath) → ℝ)
    (hf : IsPhyloPayoff k f) (σ : Equiv.Perm (Fin k)) (P : Fin k → List Bool)
    (hP : PrefixFree P) (hPσ : f (fun j => pad (P (σ j))) = 1) :
    PrefixFree (substSolution d σ P) ∧ solVal k d f (substSolution d σ P) = 1 := by
  sorry

/-- Equal weighted degrees: every variable has expected multiplicity `k / k^d` in a sampled
constraint (so the clique-expansion pair graph is regular). [TripletReconstructionAndAll, node_23] -/
theorem equal_weighted_degree (k d : ℕ) (hk : 2 ≤ k) (hd : 1 ≤ d) (u : Leaf k d) :
    ∑ v : Fin k → Leaf k d,
      weight k d v * ((Finset.univ.filter fun j : Fin k => v j = u).card : ℝ)
      = (k : ℝ) / (k : ℝ) ^ d := by
  sorry

/-- Structural representation: every order-respecting solution is captured, on all tuples with
distinct colors, by at most `q = q(k, η)` representative leaves receiving consecutive intervals
of positions, colored so that each color class has at most `η m` positions. [TripletReconstructionAndAll, node_23] -/
theorem structural_representation (k : ℕ) (hk : 2 ≤ k) (η : ℝ) (hη : 0 < η) :
    ∃ q D₀ : ℕ, ∀ d : ℕ, D₀ ≤ d → ∀ (π : VarOrder k d) (φ : Leaf k d → List Bool),
      PrefixFree φ → Respects π φ →
      ∃ r : ℕ, r ≤ q ∧ ∃ R : Fin r → List Bool, PrefixFree R ∧
        ∃ a : Fin (k ^ d) → Fin r, Monotone a ∧ ∃ c : Fin r → Fin q,
          (∀ b : Fin q,
            ((Finset.univ.filter fun i => c (a i) = b).card : ℝ) ≤ η * (k : ℝ) ^ d) ∧
          ∀ v : Fin k → Leaf k d,
            (∀ i j : Fin k, i ≠ j → c (a (π (v i))) ≠ c (a (π (v j)))) →
            SamePattern (fun j => pad (φ (v j))) (fun j => pad (R (a (π (v j))))) := by
  sorry

/-- Upper score ≤ lower score + exceptional weight: pattern preservation on distinct-color
tuples bounds the genuine value. [TripletReconstructionAndAll, node_23] -/
theorem val_le_lower_add_rep (k d r q : ℕ) (hk : 2 ≤ k) (f : (Fin k → IPath) → ℝ)
    (hf : IsPhyloPayoff k f) (π : VarOrder k d) (φ : Leaf k d → List Bool)
    (hφ : PrefixFree φ) (R : Fin r → List Bool) (hR : PrefixFree R)
    (a : Fin (k ^ d) → Fin r) (c : Fin r → Fin q)
    (hpat : ∀ v : Fin k → Leaf k d,
      (∀ i j : Fin k, i ≠ j → c (a (π (v i))) ≠ c (a (π (v j)))) →
      SamePattern (fun j => pad (φ (v j))) (fun j => pad (R (a (π (v j)))))) :
    solVal k d f φ ≤
      ∑ v : Fin k → Leaf k d, weight k d v * lowerPayoff f R c (fun j => a (π (v j)))
        + repWeight k d q (fun i => c (a i)) π := by
  sorry

/-- Product-distribution expectations of a lower payoff are at most `α`: realize `R` as
disjoint dyadic intervals of `[0,1]` carrying masses `p`, spread uniformly inside. [TripletReconstructionAndAll, node_23] -/
theorem lower_productExp_le_alpha (k r q : ℕ) (hk : 2 ≤ k) (f : (Fin k → IPath) → ℝ)
    (hf : IsPhyloPayoff k f) (R : Fin r → List Bool) (hR : PrefixFree R)
    (c : Fin r → Fin q) (p : FinDist (Fin r)) :
    productExp p (lowerPayoff (k := k) f R c) ≤ alpha k f := by
  sorry

/-- Uniform lower-score bound through the comparison result: once `d ≥ D(k,q,η)`, every bounded
representation (any tree, coloring, labelling) has lower score at most `α + η`. [TripletReconstructionAndAll, node_23] -/
theorem lower_score_le_alpha (k : ℕ) (hk : 2 ≤ k) (f : (Fin k → IPath) → ℝ)
    (hf : IsPhyloPayoff k f) (hcmp : ComparisonFact k) (q : ℕ) (η : ℝ) (hη : 0 < η) :
    ∃ D : ℕ, ∀ d : ℕ, D ≤ d → ∀ r : ℕ, r ≤ q → ∀ (R : Fin r → List Bool), PrefixFree R →
      ∀ (c : Fin r → Fin q) (a : Leaf k d → Fin r),
        ∑ v : Fin k → Leaf k d, weight k d v * lowerPayoff f R c (fun j => a (v j))
          ≤ alpha k f + η := by
  sorry

/-- Uniform control of exceptional mass: even when the interval coloring of positions is chosen
after seeing `π`, the expected repeated-color weight is at most `k² η` for large `d`
(fixed-coloring mean `≤ C(k,2) η`, `O(1/m)` sensitivity by regularity, permutation
concentration, union bound over `≤ (qm)^q` interval colorings). [TripletReconstructionAndAll, node_23] -/
theorem exceptional_uniform (k : ℕ) (hk : 2 ≤ k) (q : ℕ) (η : ℝ) (hη : 0 < η) :
    ∃ D : ℕ, ∀ d : ℕ, D ≤ d →
      ∀ C : VarOrder k d → Fin (k ^ d) → Fin q,
        (∀ π, IntervalColoring q (k ^ d) η (C π)) →
        (1 / (Fintype.card (VarOrder k d) : ℝ)) * ∑ π : VarOrder k d, repWeight k d q (C π) π
          ≤ (k : ℝ) ^ 2 * η := by
  sorry

/-! ## Main theorem -/

/-- For every `ε > 0` and all sufficiently large `d`: `opt(I_d) = 1` (a value-`1` solution
exists and no solution exceeds `1`), and for every order-adapted choice of solutions
`Φ π` respecting `π`, `E_π[val(Φ π, I_d)] ≤ α + ε` with `π` uniform. [TripletReconstructionAndAll, node_23] -/
theorem main_theorem (k : ℕ) (hk : 2 ≤ k) (f : (Fin k → IPath) → ℝ)
    (hf : IsPhyloPayoff k f) (hP : HasOrderedSatPattern k f) (hcmp : ComparisonFact k)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ D : ℕ, ∀ d : ℕ, D ≤ d →
      ((∃ φ : Leaf k d → List Bool, PrefixFree φ ∧ solVal k d f φ = 1) ∧
        ∀ φ : Leaf k d → List Bool, PrefixFree φ → solVal k d f φ ≤ 1) ∧
      ∀ Φ : VarOrder k d → Leaf k d → List Bool,
        (∀ π, PrefixFree (Φ π) ∧ Respects π (Φ π)) →
        (1 / (Fintype.card (VarOrder k d) : ℝ)) * ∑ π : VarOrder k d, solVal k d f (Φ π)
          ≤ alpha k f + ε := by
  sorry

