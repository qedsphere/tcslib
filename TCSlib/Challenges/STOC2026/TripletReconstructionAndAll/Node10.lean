/-!
## Phylogenetic CSPs: the optimal biased rounding is approached by finite dyadic measures

Fix an arity `k ≥ 1` and a finite nonempty family `Γ` (indexed by `Fin numF`) of payoff
functions on ordered rooted binary trees with leaves labelled `1, …, k`, with values in
`[0,1]`. An instance on `n` variables is a weighted list of constraints `f(v₁,…,v_k)`.
For a probability measure `ρ` on `[0,1]`, absolutely continuous w.r.t. Lebesgue measure,
the rounding `A_ρ` samples `X_v ∼ ρ` independently and outputs the reduced ordered
binary-prefix tree of the binary expansions. `α_ρ(Γ)` is the worst ratio
`E[val(A_ρ, I)] / OPT(I)` and `α_opt(Γ)` its supremum over `ρ`.

Main theorem `TCSChallenge.TripletReconstructionAndAll.node_10.main`: for every `ε > 0`
there is a finitely described dyadic step measure `σ` (constant density on the `2^D`
dyadic intervals, masses `num j / 2^B`) with
`E[val(A_σ, I)] ≥ (α_opt(Γ) − ε) · OPT(I)` for every instance `I`.
-/

namespace TCSChallenge.TripletReconstructionAndAll.node_10

/-! ## Trees -/

/-- Ordered rooted binary trees with leaves labelled by `L` (every internal vertex has an
ordered pair of children: left, right). -/
inductive OTree (L : Type) where
  | leaf : L → OTree L
  | node : OTree L → OTree L → OTree L

/-- The left-to-right list of leaf labels. -/
def OTree.leaves {L : Type} : OTree L → List L
  | .leaf a => [a]
  | .node l r => l.leaves ++ r.leaves

/-- "an ordered rooted binary tree whose leaves are labeled by a finite set V": each label
occurs on exactly one leaf. -/
def IsLeafLabeling {L : Type} (T : OTree L) : Prop :=
  T.leaves.Nodup ∧ ∀ a : L, a ∈ T.leaves

/-- Joining two optional subtrees under a common parent, *suppressing* the parent when one
side is empty (this is how unary vertices are suppressed). -/
def joinOpt {L : Type} : Option (OTree L) → Option (OTree L) → Option (OTree L)
  | some a, some b => some (.node a b)
  | some a, none => some a
  | none, some b => some b
  | none, none => none

/-- "T restricted to (v₁,…,v_k)": delete all branches containing none of these leaves,
suppress unary vertices (including a unary root) and relabel `v_i` as `i`.
Returns `none` iff no leaf of `T` is among the `v_i`. -/
def OTree.restrict {V : Type} {k : ℕ} (v : Fin k → V) : OTree V → Option (OTree (Fin k))
  | .leaf x => if h : ∃ i, v i = x then some (.leaf (Classical.choose h)) else none
  | .node l r => joinOpt (l.restrict v) (r.restrict v)

/-! ## Binary-prefix trees -/

/-- `prefixTree x fuel d l`: the reduced ordered binary-prefix tree of the strings
`x a` (`a ∈ l`), read from position `d` on, splitting on the bit (`false` = 0 to the left,
`true` = 1 to the right) with empty branches and unary vertices suppressed. Returns `none`
if `l` is empty or the fuel runs out before all strings are separated. -/
def prefixTree {V : Type} (x : V → ℕ → Bool) : ℕ → ℕ → List V → Option (OTree V)
  | _, _, [] => none
  | _, _, [a] => some (.leaf a)
  | 0, _, _ :: _ :: _ => none
  | fuel + 1, d, l@(_ :: _ :: _) =>
      joinOpt (prefixTree x fuel (d + 1) (l.filter (fun a => !x a d)))
              (prefixTree x fuel (d + 1) (l.filter (fun a => x a d)))

/-- The reduced ordered binary-prefix tree of the (infinite) strings `x v`, `v ∈ V`:
`prefixTree` with the least sufficient fuel; `none` if the strings are not pairwise distinct
(a probability-zero event for an absolutely continuous `ρ`) or `V` is empty. -/
def reducedPrefixTree {V : Type} [Fintype V] (x : V → ℕ → Bool) : Option (OTree V) :=
  if h : ∃ N, (prefixTree x N 0 (Finset.univ : Finset V).toList).isSome then
    prefixTree x (Nat.find h) 0 (Finset.univ : Finset V).toList
  else none

/-- Binary digit `j` (0-indexed, i.e. the coefficient of `2^{-(j+1)}`) of a real `x`:
`⌊x·2^{j+1}⌋ mod 2`. This is a fixed convention at dyadic points (terminating expansion). -/
def binDigit (x : ℝ) (j : ℕ) : Bool :=
  decide (⌊x * 2 ^ (j + 1)⌋₊ % 2 = 1)

/-! ## Instances, values, approximation factors -/

/-- Payoff of the constraint `f(v₁,…,v_k)` on the tree `T`: `f` evaluated on `T` restricted
to `(v₁,…,v_k)` (0 if the restriction is empty, which never happens for leaf-labelings). -/
def constraintPayoff {V : Type} {k : ℕ} (f : OTree (Fin k) → ℝ) (v : Fin k → V)
    (T : OTree V) : ℝ :=
  match T.restrict v with
  | some t => f t
  | none => 0

/-- An instance on the variable set `Fin n` over a family indexed by `Fin numF`:
`m` constraints, the `c`-th being `Γ (typ c) (vars c 0, …, vars c (k-1))` with weight
`weight c`. -/
structure Instance (numF k n : ℕ) where
  m : ℕ
  typ : Fin m → Fin numF
  vars : Fin m → Fin k → Fin n
  weight : Fin m → ℝ

/-- Constraints use distinct variables; weights are nonnegative of positive total weight. -/
def Instance.WellFormed {numF k n : ℕ} (I : Instance numF k n) : Prop :=
  (∀ c, Function.Injective (I.vars c)) ∧ (∀ c, 0 ≤ I.weight c) ∧ 0 < ∑ c, I.weight c

/-- `val(T, I)`: the weighted average payoff. -/
def val {numF k n : ℕ} (Γ : Fin numF → OTree (Fin k) → ℝ) (I : Instance numF k n)
    (T : OTree (Fin n)) : ℝ :=
  (∑ c, I.weight c * constraintPayoff (Γ (I.typ c)) (I.vars c) T) / ∑ c, I.weight c

/-- `OPT(I)`: maximum of `val(T, I)` over ordered rooted binary trees with leaf set `V`. -/
def OPT {numF k n : ℕ} (Γ : Fin numF → OTree (Fin k) → ℝ) (I : Instance numF k n) : ℝ :=
  sSup {r : ℝ | ∃ T : OTree (Fin n), IsLeafLabeling T ∧ r = val Γ I T}

/-- Value of an optional output tree (`none`, a null event, scores 0). -/
def valOpt {numF k n : ℕ} (Γ : Fin numF → OTree (Fin k) → ℝ) (I : Instance numF k n) :
    Option (OTree (Fin n)) → ℝ
  | some T => val Γ I T
  | none => 0

/-- `E[val(A_ρ, I)]`: `X_v ∼ ρ` i.i.d., output the reduced binary-prefix tree of their binary
expansions. -/
def expectedVal {numF k n : ℕ} (Γ : Fin numF → OTree (Fin k) → ℝ) (ρ : Measure ℝ)
    (I : Instance numF k n) : ℝ :=
  ∫ X, valOpt Γ I (reducedPrefixTree (fun v => binDigit (X v))) ∂(Measure.pi fun _ : Fin n => ρ)

/-- An absolutely continuous probability measure on `[0,1]`. -/
def Admissible (ρ : Measure ℝ) : Prop :=
  IsProbabilityMeasure ρ ∧ ρ (Set.Icc (0 : ℝ) 1)ᶜ = 0 ∧ ρ ≪ volume

/-- Some well-formed instance has positive optimum. -/
def HasPositiveInstance {numF k : ℕ} (Γ : Fin numF → OTree (Fin k) → ℝ) : Prop :=
  ∃ (n : ℕ) (I : Instance numF k n), I.WellFormed ∧ 0 < OPT Γ I

/-- `α_ρ(Γ) = inf_{I : OPT(I) > 0} E[val(A_ρ, I)] / OPT(I)`, and `1` if every instance has
optimum zero. -/
def alphaRho {numF k : ℕ} (Γ : Fin numF → OTree (Fin k) → ℝ) (ρ : Measure ℝ) : ℝ :=
  if HasPositiveInstance Γ then
    sInf {r : ℝ | ∃ (n : ℕ) (I : Instance numF k n),
      I.WellFormed ∧ 0 < OPT Γ I ∧ r = expectedVal Γ ρ I / OPT Γ I}
  else 1

/-- `α_opt(Γ) = sup_ρ α_ρ(Γ)` over absolutely continuous probability measures on `[0,1]`,
and `1` if every instance has optimum zero. -/
def alphaOpt {numF k : ℕ} (Γ : Fin numF → OTree (Fin k) → ℝ) : ℝ :=
  if HasPositiveInstance Γ then
    sSup {a : ℝ | ∃ ρ : Measure ℝ, Admissible ρ ∧ a = alphaRho Γ ρ}
  else 1

/-! ## Single-constraint quantities -/

/-- `M_f`: the largest payoff of `f` on a leaf-labeling of `{1,…,k}`. -/
def maxPayoff {k : ℕ} (f : OTree (Fin k) → ℝ) : ℝ :=
  sSup {r : ℝ | ∃ t : OTree (Fin k), IsLeafLabeling t ∧ r = f t}

/-- `p_ρ(f)`: expected payoff of `f` on the reduced prefix tree of `k` independent
`ρ`-samples (leaf `i` labelled `i`). -/
def singlePayoff {k : ℕ} (f : OTree (Fin k) → ℝ) (ρ : Measure ℝ) : ℝ :=
  ∫ Y, (match reducedPrefixTree (fun i : Fin k => binDigit (Y i)) with
        | some t => f t
        | none => 0) ∂(Measure.pi fun _ : Fin k => ρ)

/-! ## Finitely described dyadic step measures -/

/-- Finite description: depth `D`, precision `B`, numerators `num j` (`j < 2^D`) summing to
`2^B`, i.e. interval masses `b_j = num j / 2^B` are dyadic rationals summing to one. -/
def IsDyadicStepData (D B : ℕ) (num : ℕ → ℕ) : Prop :=
  ∑ j ∈ Finset.range (2 ^ D), num j = 2 ^ B

/-- The density constant `q · b_j = 2^D · num j / 2^B` on the `j`-th dyadic interval
`[j/2^D, (j+1)/2^D)` of `[0,1)`, and `0` outside `[0,1)`. -/
def dyadicStepDensity (D B : ℕ) (num : ℕ → ℕ) (x : ℝ) : ℝ≥0∞ :=
  if 0 ≤ x ∧ x < 1 then (num ⌊x * 2 ^ D⌋₊ : ℝ≥0∞) * 2 ^ D / 2 ^ B else 0

/-- The measure with density `dyadicStepDensity`. -/
def dyadicStepMeasure (D B : ℕ) (num : ℕ → ℕ) : Measure ℝ :=
  volume.withDensity (dyadicStepDensity D B num)

/-- Index `j` of the depth-`D` leaf selected by the first `D` bits of `w` (most significant
first). -/
def prefixIndex (D : ℕ) (w : ℕ → Bool) : ℕ :=
  ∑ i ∈ Finset.range D, if w i then 2 ^ (D - 1 - i) else 0

/-! ## Lemma stubs (rubric items) -/

/-- Rubric 1 (single-constraint characterization, eq. (1)): if some instance has positive
optimum, `α_ρ(Γ) = min_{f : M_f > 0} p_ρ(f) / M_f`. [TripletReconstructionAndAll, node_10] -/
theorem alphaRho_eq_min_single {numF k : ℕ} (hk : 1 ≤ k)
    (Γ : Fin numF → OTree (Fin k) → ℝ) (hΓ : ∀ i t, 0 ≤ Γ i t ∧ Γ i t ≤ 1)
    (ρ : Measure ℝ) (hρ : Admissible ρ) (hpos : HasPositiveInstance Γ) :
    (∀ i, 0 < maxPayoff (Γ i) → alphaRho Γ ρ ≤ singlePayoff (Γ i) ρ / maxPayoff (Γ i)) ∧
    ∃ i, 0 < maxPayoff (Γ i) ∧ alphaRho Γ ρ = singlePayoff (Γ i) ρ / maxPayoff (Γ i) := by
  sorry

/-- Rubric 1 (stability, eq. (2)): `|α_ρ(Γ) − α_σ(Γ)| ≤ k · d_TV(ρ, σ)` for densities. [TripletReconstructionAndAll, node_10] -/
theorem alphaRho_stability {numF k : ℕ} (hk : 1 ≤ k)
    (Γ : Fin numF → OTree (Fin k) → ℝ) (hΓ : ∀ i t, 0 ≤ Γ i t ∧ Γ i t ≤ 1)
    (h g : ℝ → ℝ≥0∞) (hh : Measurable h) (hg : Measurable g)
    (hρ : Admissible (volume.withDensity h)) (hσ : Admissible (volume.withDensity g)) :
    |alphaRho Γ (volume.withDensity h) - alphaRho Γ (volume.withDensity g)| ≤
      (k : ℝ) * ((1 / 2) * ∫ x, |(h x).toReal - (g x).toReal|) := by
  sorry

/-- Rubric 2 (eq. (3)): every probability density on `[0,1]` is approximated in total
variation by a finitely described dyadic step density. [TripletReconstructionAndAll, node_10] -/
theorem exists_dyadic_approx (h : ℝ → ℝ≥0∞) (hh : Measurable h)
    (hρ : Admissible (volume.withDensity h)) (η : ℝ) (hη : 0 < η) :
    ∃ (D B : ℕ) (num : ℕ → ℕ), IsDyadicStepData D B num ∧
      (1 / 2) * ∫ x, |(h x).toReal - (dyadicStepDensity D B num x).toReal| < η := by
  sorry

/-- A dyadic step measure is admissible. [TripletReconstructionAndAll, node_10] -/
theorem dyadicStepMeasure_admissible (D B : ℕ) (num : ℕ → ℕ)
    (hdata : IsDyadicStepData D B num) : Admissible (dyadicStepMeasure D B num) := by
  sorry

/-- Rubric 3 (exact realization): under the dyadic step measure the first `D` binary digits
select leaf `j` with probability `num j / 2^B` and all later digits are independent fair
bits: every cylinder of length `L ≥ D` has probability `num j / 2^B · 2^{-(L-D)}`. [TripletReconstructionAndAll, node_10] -/
theorem dyadicStepMeasure_cylinder (D B : ℕ) (num : ℕ → ℕ)
    (hdata : IsDyadicStepData D B num) (L : ℕ) (hL : D ≤ L) (w : ℕ → Bool) :
    dyadicStepMeasure D B num {x : ℝ | ∀ i < L, binDigit x i = w i} =
      (num (prefixIndex D w) : ℝ≥0∞) / 2 ^ B / 2 ^ (L - D) := by
  sorry

/-! ## Main theorem -/

/-- For every `ε > 0` there is a finitely described dyadic step measure `σ` whose rounding
`A_σ` satisfies `E[val(A_σ, I)] ≥ (α_opt(Γ) − ε) · OPT(I)` on every weighted instance. [TripletReconstructionAndAll, node_10] -/
theorem main {numF k : ℕ} (hk : 1 ≤ k) (hF : 1 ≤ numF)
    (Γ : Fin numF → OTree (Fin k) → ℝ) (hΓ : ∀ i t, 0 ≤ Γ i t ∧ Γ i t ≤ 1)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ (D B : ℕ) (num : ℕ → ℕ), IsDyadicStepData D B num ∧
      ∀ (n : ℕ) (I : Instance numF k n), I.WellFormed →
        (alphaOpt Γ - ε) * OPT Γ I ≤ expectedVal Γ (dyadicStepMeasure D B num) I := by
  sorry

end TCSChallenge.TripletReconstructionAndAll.node_10
