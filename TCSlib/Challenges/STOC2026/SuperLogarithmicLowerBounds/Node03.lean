/-!
## Super-logarithmic lower bound for incremental DAG reachability

Cell-probe model with `w`-bit cells and addresses. A data structure maintains a DAG on
`n` vertices, starting empty; each update inserts an edge keeping the graph acyclic;
a query `(s,t)` asks whether `t` is reachable from `s`. With `t_u` the worst-case
insertion cost and `t_q` the maximum (over legal insertion sequences and query
pairs) expected query cost, for every fixed `c₀ > 0` and `w ≥ c₀ log n`:

  `t_q = Ω((log n)^{3/2} / log²(t_u w))`.

Main theorem: `incremental_reachability_lower_bound`.
-/

open TCSlib.InformationTheory

namespace TCSChallenge.SuperLogarithmicLowerBounds.node_03

/-! ## Cell-probe model (shared block) -/

/-- A `w`-bit word. Cells and addresses are both `w`-bit words. -/
abbrev Word (w : ℕ) : Type := Fin w → Bool

/-- Memory: `2^w` cells of `w` bits, addressed by `w`-bit words. -/
abbrev Mem (w : ℕ) : Type := Word w → Word w

/-- An adaptive cell-probe program: "computation is free, and each memory-cell read or
write costs one probe". Each step reads a cell (and branches on its content), writes
a cell, or returns an answer. -/
inductive Prog (Addr Val α : Type) where
  | ret : α → Prog Addr Val α
  | read : Addr → (Val → Prog Addr Val α) → Prog Addr Val α
  | write : Addr → Val → Prog Addr Val α → Prog Addr Val α

/-- Run a program on a memory: (answer, final memory, number of probes). -/
def Prog.run {Addr Val α : Type} [DecidableEq Addr] :
    Prog Addr Val α → (Addr → Val) → α × (Addr → Val) × ℕ
  | .ret a, M => (a, M, 0)
  | .read x k, M =>
      let r := (k (M x)).run M
      (r.1, r.2.1, r.2.2 + 1)
  | .write x v p, M =>
      let r := p.run (Function.update M x v)
      (r.1, r.2.1, r.2.2 + 1)

/-! ## Incremental reachability data structures -/

/-- A randomized cell-probe data structure for incremental reachability on `n` fixed
vertices. Given the seed `ω`, the initial memory and the program run for each
operation are fixed; "no input-dependent information persists between operations
outside the counted memory". -/
structure ReachDS (n w : ℕ) (Ω : Type) where
  init : Ω → Mem w
  insert : Ω → Fin n → Fin n → Prog (Word w) (Word w) Unit
  query : Ω → Fin n → Fin n → Prog (Word w) (Word w) Bool

/-- Memory after performing the insertions `es` in order, starting from the empty graph. -/
def ReachDS.memAfter {n w : ℕ} {Ω : Type} (D : ReachDS n w Ω) (ω : Ω)
    (es : List (Fin n × Fin n)) : Mem w :=
  es.foldl (fun M e => ((D.insert ω e.1 e.2).run M).2.1) (D.init ω)

/-- The edge relation of the graph built from the inserted edges. -/
def edgeRel {n : ℕ} (es : List (Fin n × Fin n)) (u v : Fin n) : Prop := (u, v) ∈ es

/-- The inserted graph is a DAG (no directed cycle). -/
def IsAcyclic {n : ℕ} (es : List (Fin n × Fin n)) : Prop :=
  ∀ v, ¬ Relation.TransGen (edgeRel es) v v

/-- Worst-case insertion cost at most `tu`, over all legal (acyclicity-preserving)
insertion sequences and all seeds. -/
def ReachDS.UpdateBound {n w : ℕ} {Ω : Type} (D : ReachDS n w Ω) (tu : ℕ) : Prop :=
  ∀ (ω : Ω) (es : List (Fin n × Fin n)) (e : Fin n × Fin n), IsAcyclic (es ++ [e]) →
    ((D.insert ω e.1 e.2).run (D.memAfter ω es)).2.2 ≤ tu

/-- Zero-error correctness: for every seed and legal sequence, the query `(s,t)`
answers whether `t` is reachable from `s`. -/
def ReachDS.Correct {n w : ℕ} {Ω : Type} (D : ReachDS n w Ω) : Prop :=
  ∀ (ω : Ω) (es : List (Fin n × Fin n)), IsAcyclic es → ∀ s t : Fin n,
    (((D.query ω s t).run (D.memAfter ω es)).1 = true ↔ Relation.ReflTransGen (edgeRel es) s t)

/-- `t_q` bound: for every legal preceding sequence and query pair, the expected query
cost (over the seed, drawn from the finite distribution `p` once before the first
operation) is at most `tq`. -/
def ReachDS.QueryBound {n w : ℕ} {Ω : Type} [Fintype Ω] (D : ReachDS n w Ω) (p : FinDist Ω)
    (tq : ℝ) : Prop :=
  ∀ es : List (Fin n × Fin n), IsAcyclic es → ∀ s t : Fin n,
    ∑ ω, p ω * (((D.query ω s t).run (D.memAfter ω es)).2.2 : ℝ) ≤ tq

/-! ## Butterflies and path XOR (shared block) -/

/-- An edge of the degree-`B` butterfly of depth `k`: `(r, x, y)` is the edge from
vertex `x` in layer `r` to vertex `x[r ↦ y]` in layer `r+1` ("there is an edge from
(r,x) to (r+1,y) exactly when x_j = y_j for every j ≠ r"). There are `k B^(k+1)`. -/
abbrev BEdge (B k : ℕ) : Type := Fin k × (Fin k → Fin B) × Fin B

/-- Labels in `{0,1}^b`, with XOR as addition in `ZMod 2`. -/
abbrev Label (b : ℕ) : Type := Fin b → ZMod 2

/-- Tail vertex (in layer `e.1`) of a butterfly edge. -/
def BEdge.tail {B k : ℕ} (e : BEdge B k) : Fin k → Fin B := e.2.1

/-- Head vertex (in layer `e.1 + 1`) of a butterfly edge. -/
def BEdge.head {B k : ℕ} (e : BEdge B k) : Fin k → Fin B :=
  Function.update e.2.1 e.1 e.2.2

/-- The vertex in layer `r` of the unique path from source `u` to sink `v`:
coordinates `< r` already agree with `v`, the others still agree with `u`. -/
def pathVertex {B k : ℕ} (u v : Fin k → Fin B) (r : ℕ) : Fin k → Fin B :=
  fun j => if j.val < r then v j else u j

/-- `X(u,v)`: "the bitwise XOR of the labels along the directed path from source `u`
to sink `v`". The `r`-th edge of that path leaves `pathVertex u v r` and sets
coordinate `r` to `v r`. -/
def pathXor {B b k : ℕ} (ℓ : BEdge B k → Label b) (u v : Fin k → Fin B) : Label b :=
  ∑ r : Fin k, ℓ (r, pathVertex u v r.val, v r)

/-- A full labelling: `ℓ i` labels the butterfly of depth `i.val + 1`. -/
abbrev Labels (d B b : ℕ) : Type := (i : Fin d) → BEdge B (i.val + 1) → Label b

/-- The first `i.val + 1` base-`B` digits of `s`, i.e. `⌊s / B^(d-(i+1))⌋`. -/
def prefixWord {d B : ℕ} (s : Fin d → Fin B) (i : Fin d) : Fin (i.val + 1) → Fin B :=
  fun j => s ⟨j.val, Nat.lt_of_lt_of_le j.isLt (Nat.succ_le_of_lt i.isLt)⟩

/-- The answer to query `(s,t)`: "there exists `i ∈ {1,…,d}` such that
`X_i(⌊s/B^(d−i)⌋, ⌊t/B^(d−i)⌋) = 0^b`". -/
def EpochAnswer {d B b : ℕ} (ℓ : Labels d B b) (s t : Fin d → Fin B) : Prop :=
  ∃ i : Fin d, pathXor (ℓ i) (prefixWord s i) (prefixWord t i) = 0

/-! ## The reachability construction (shared block) -/

/-- Vertices of a perfect `B`-ary tree of depth `d`: a depth `r ≤ d` and a word of
length `r` (its parent deletes the last digit). -/
abbrev TreeV (d B : ℕ) : Type := (r : Fin (d + 1)) × (Fin r.val → Fin B)

/-- Vertices of the lifted butterflies `H_i`: component `i`, layer, word, XOR state. -/
abbrev LiftV (d B b : ℕ) : Type :=
  (i : Fin d) × Fin (i.val + 2) × (Fin (i.val + 1) → Fin B) × Label b

/-- All vertices: in-tree `S`, the lifted butterflies, out-tree `T`. -/
abbrev CVert (d B b : ℕ) : Type := TreeV d B ⊕ LiftV d B b ⊕ TreeV d B

/-- Vertex of `S`. -/
def srcV {d B b : ℕ} (v : TreeV d B) : CVert d B b := Sum.inl v

/-- Vertex of `T`. -/
def snkV {d B b : ℕ} (v : TreeV d B) : CVert d B b := Sum.inr (Sum.inr v)

/-- Vertex `(layer r, word x, state a)` of `H_i`. -/
def liftV {d B b : ℕ} (i : Fin d) (r : Fin (i.val + 2)) (x : Fin (i.val + 1) → Fin B)
    (a : Label b) : CVert d B b :=
  Sum.inr (Sum.inl ⟨i, r, x, a⟩)

/-- The tree vertex at depth `r.val + 1` with word `x`. -/
def childNode {d B : ℕ} (r : Fin d) (x : Fin (r.val + 1) → Fin B) : TreeV d B :=
  ⟨⟨r.val + 1, Nat.succ_lt_succ r.isLt⟩, x⟩

/-- The parent (depth `r.val`) of `childNode r x`: delete the last digit. -/
def parentNode {d B : ℕ} (r : Fin d) (x : Fin (r.val + 1) → Fin B) : TreeV d B :=
  ⟨⟨r.val, Nat.lt_succ_of_lt r.isLt⟩, fun j : Fin r.val => x j.castSucc⟩

/-- Leaf `s` of a tree. -/
def leaf {d B : ℕ} (s : Fin d → Fin B) : TreeV d B := ⟨Fin.last d, s⟩

/-- Edges of the constructed graph after all epochs. In order: `S` edges (child to
parent), `T` edges (parent to child), `S`-to-source connections, sink-to-`T`
connections, and the lifted edges `(u,a) → (v, a ⊕ ℓ(e))` of each `H_i`. -/
def CEdge {d B b : ℕ} (ℓ : Labels d B b) (u v : CVert d B b) : Prop :=
  (∃ (r : Fin d) (x : Fin (r.val + 1) → Fin B),
      u = srcV (childNode r x) ∧ v = srcV (parentNode r x)) ∨
  (∃ (r : Fin d) (x : Fin (r.val + 1) → Fin B),
      u = snkV (parentNode r x) ∧ v = snkV (childNode r x)) ∨
  (∃ (i : Fin d) (x : Fin (i.val + 1) → Fin B),
      u = srcV (childNode i x) ∧ v = liftV i ⟨0, Nat.zero_lt_succ _⟩ x 0) ∨
  (∃ (i : Fin d) (x : Fin (i.val + 1) → Fin B),
      u = liftV i (Fin.last (i.val + 1)) x 0 ∧ v = snkV (childNode i x)) ∨
  (∃ (i : Fin d) (e : BEdge B (i.val + 1)) (a : Label b),
      u = liftV i e.1.castSucc e.tail a ∧ v = liftV i e.1.succ e.head (a + ℓ i e))

/-- The vertex budget `N = ∑_{i=1}^d 2^b (i+1) B^i + 2 ∑_{i=0}^d B^i` (reindexed). -/
def vertexBudget (d B b : ℕ) : ℕ :=
  (∑ i ∈ Finset.range d, 2 ^ b * (i + 2) * B ^ (i + 1)) + 2 * ∑ i ∈ Finset.range (d + 1), B ^ i

/-- Number of auxiliary (tree and connecting) edges, all inserted in epoch `d`:
`4 ∑_{i=1}^d B^i`. -/
def auxEdgeCount (d B : ℕ) : ℕ := 4 * ∑ r ∈ Finset.range d, B ^ (r + 1)

/-- Number of reachability insertions made in the epoch of depth `i.val + 1`:
`2^b · (i+1) B^(i+2)` lifted edges, plus all auxiliary edges in epoch `d`. -/
def epochInsertions (d B b : ℕ) (i : Fin d) : ℕ :=
  2 ^ b * (i.val + 1) * B ^ (i.val + 2) + (if i.val + 1 = d then auxEdgeCount d B else 0)

/-! ## Rubric lemmas (XOR and disjunction gadget) -/

/-- One reachability query computes the disjunction over all depths of the zero-XOR
conditions. [SuperLogarithmicLowerBounds, node_03] -/
theorem leaf_reach_iff {d B b : ℕ} (ℓ : Labels d B b) (s t : Fin d → Fin B) :
    Relation.ReflTransGen (CEdge ℓ) (srcV (leaf s)) (snkV (leaf t)) ↔ EpochAnswer ℓ s t := by
  sorry

/-- Every intermediate graph of the insertion sequence is acyclic. [SuperLogarithmicLowerBounds, node_03] -/
theorem acyclic_of_sub {d B b : ℕ} (ℓ : Labels d B b) (R : CVert d B b → CVert d B b → Prop)
    (hR : ∀ u v, R u v → CEdge ℓ u v) (v : CVert d B b) :
    ¬ Relation.TransGen R v v := by
  sorry

/-- The gadget has `N` vertices. [SuperLogarithmicLowerBounds, node_03] -/
theorem card_CVert (d B b : ℕ) : Fintype.card (CVert d B b) = vertexBudget d B b := by
  sorry

/-! ## Main theorem -/

/-- For every fixed `c₀ > 0`, every zero-error randomized cell-probe data structure for
incremental DAG reachability with `w ≥ c₀ log n` and worst-case insertion cost
`t_u ≥ 1` has expected query cost `t_q ≥ c (log n)^{3/2} / log²(t_u w)` for `n ≥ N`. [SuperLogarithmicLowerBounds, node_03] -/
theorem incremental_reachability_lower_bound (c₀ : ℝ) (hc₀ : 0 < c₀) :
    ∃ c : ℝ, 0 < c ∧ ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ (w tu : ℕ), c₀ * Real.logb 2 n ≤ w →
      1 ≤ tu → ∀ (tq : ℝ) (Ω : Type) [Fintype Ω] (p : FinDist Ω) (D : ReachDS n w Ω),
        D.UpdateBound tu → D.Correct → D.QueryBound p tq →
        c * Real.logb 2 n ^ (3 / 2 : ℝ) / Real.logb 2 ((tu : ℝ) * w) ^ 2 ≤ tq := by
  sorry

end TCSChallenge.SuperLogarithmicLowerBounds.node_03
