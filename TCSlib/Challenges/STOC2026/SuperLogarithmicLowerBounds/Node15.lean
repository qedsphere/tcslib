/-!
## Lower bound for the OR-of-path-XOR epoch problem

For `i = 1, …, d`, `G_i` is the degree-`B` butterfly of depth `i`, each edge labelled in
`{0,1}^b`. Epochs `d, d−1, …, 1` assign all labels of `G_i`; a final query `(s,t)` asks
for `OR_i 1{XOR of the labels on the path in G_i from ⌊s/B^(d−i)⌋ to ⌊t/B^(d−i)⌋ is 0^b}`.
With `b = ⌈lg d⌉ + 6`, `B = ⌈(d t_u w)^12⌉`, `n = d ∑_{i=1}^d B^i`, `w ≥ ⌈lg n⌉`, and
epoch `i` changing at most `C t_u d B^(i+1)` cells, the average (uniform labels, uniform
query, internal randomness) query cost satisfies

  `t_q = Ω((lg n)^{3/2} / (lg(t_u w))²)`.

Main theorem: `epoch_problem_lower_bound`.
-/

namespace TCSChallenge.SuperLogarithmicLowerBounds.node_15

open TCSlib.InformationTheory

/-! ## Cell-probe model (shared block) -/

/-- A `w`-bit word. Cells and addresses are both `w`-bit words. -/
abbrev Word (w : ℕ) : Type := Fin w → Bool

/-- Memory: `2^w` cells of `w` bits, addressed by `w`-bit words. -/
abbrev Mem (w : ℕ) : Type := Word w → Word w

/-- An adaptive cell-probe program: "computation is free, and each memory-cell read or
write costs one probe". Each step reads a cell (and branches on its content), writes
a cell, or returns an answer. -/
inductive Prog (Addr Val α : Type) where
  | ret : α → Prog Addr Val α
  | read : Addr → (Val → Prog Addr Val α) → Prog Addr Val α
  | write : Addr → Val → Prog Addr Val α → Prog Addr Val α

/-- Run a program on a memory: (answer, final memory, number of probes). -/
def Prog.run {Addr Val α : Type} [DecidableEq Addr] :
    Prog Addr Val α → (Addr → Val) → α × (Addr → Val) × ℕ
  | .ret a, M => (a, M, 0)
  | .read x k, M =>
      let r := (k (M x)).run M
      (r.1, r.2.1, r.2.2 + 1)
  | .write x v p, M =>
      let r := p.run (Function.update M x v)
      (r.1, r.2.1, r.2.2 + 1)

/-! The data structure's random tape is a seed drawn once, before the first operation,
from a finite distribution `p : FinDist Ω` (TCSlib). -/

/-! ## Butterflies and path XOR (shared block) -/

/-- An edge of the degree-`B` butterfly of depth `k`: `(r, x, y)` is the edge from
vertex `x` in layer `r` to vertex `x[r ↦ y]` in layer `r+1` ("there is an edge from
(r,x) to (r+1,y) exactly when x_j = y_j for every j ≠ r"). There are `k B^(k+1)`. -/
abbrev BEdge (B k : ℕ) : Type := Fin k × (Fin k → Fin B) × Fin B

/-- Labels in `{0,1}^b`, with XOR as addition in `ZMod 2`. -/
abbrev Label (b : ℕ) : Type := Fin b → ZMod 2

/-- Tail vertex (in layer `e.1`) of a butterfly edge. -/
def BEdge.tail {B k : ℕ} (e : BEdge B k) : Fin k → Fin B := e.2.1

/-- Head vertex (in layer `e.1 + 1`) of a butterfly edge. -/
def BEdge.head {B k : ℕ} (e : BEdge B k) : Fin k → Fin B :=
  Function.update e.2.1 e.1 e.2.2

/-- The vertex in layer `r` of the unique path from source `u` to sink `v`:
coordinates `< r` already agree with `v`, the others still agree with `u`. -/
def pathVertex {B k : ℕ} (u v : Fin k → Fin B) (r : ℕ) : Fin k → Fin B :=
  fun j => if j.val < r then v j else u j

/-- `X(u,v)`: "the bitwise XOR of the labels along the directed path from source `u`
to sink `v`". The `r`-th edge of that path leaves `pathVertex u v r` and sets
coordinate `r` to `v r`. -/
def pathXor {B b k : ℕ} (ℓ : BEdge B k → Label b) (u v : Fin k → Fin B) : Label b :=
  ∑ r : Fin k, ℓ (r, pathVertex u v r.val, v r)

/-- A full labelling: `ℓ i` labels the butterfly of depth `i.val + 1`. -/
abbrev Labels (d B b : ℕ) : Type := (i : Fin d) → BEdge B (i.val + 1) → Label b

/-- The first `i.val + 1` base-`B` digits of `s`, i.e. `⌊s / B^(d-(i+1))⌋`. -/
def prefixWord {d B : ℕ} (s : Fin d → Fin B) (i : Fin d) : Fin (i.val + 1) → Fin B :=
  fun j => s ⟨j.val, Nat.lt_of_lt_of_le j.isLt (Nat.succ_le_of_lt i.isLt)⟩

/-- The answer to query `(s,t)`: "there exists `i ∈ {1,…,d}` such that
`X_i(⌊s/B^(d−i)⌋, ⌊t/B^(d−i)⌋) = 0^b`". -/
def EpochAnswer {d B b : ℕ} (ℓ : Labels d B b) (s t : Fin d → Fin B) : Prop :=
  ∃ i : Fin d, pathXor (ℓ i) (prefixWord s i) (prefixWord t i) = 0

/-! ## Epoch data structures -/

/-- A randomized cell-probe data structure for the epoch problem. Epoch `i` (depth
`i.val + 1`) runs a program determined by the seed and the labels of `G_i`; the query
runs a program determined by the seed and `(s,t)`. The initial memory is independent
of the labels. -/
structure EpochDS (d B b w : ℕ) (Ω : Type) where
  init : Ω → Mem w
  epoch : Ω → (i : Fin d) → (BEdge B (i.val + 1) → Label b) → Prog (Word w) (Word w) Unit
  query : Ω → (Fin d → Fin B) → (Fin d → Fin B) → Prog (Word w) (Word w) Bool

/-- Memory after the first `k` epochs, processed in the order `d, d−1, …` (the `k`-th
processed epoch is `Fin.rev k`, i.e. depth `d − k`). -/
def EpochDS.memAfter {d B b w : ℕ} {Ω : Type} (D : EpochDS d B b w Ω) (ω : Ω)
    (L : Labels d B b) : ℕ → Mem w
  | 0 => D.init ω
  | k + 1 =>
      if h : k < d then
        ((D.epoch ω (Fin.rev ⟨k, h⟩) (L (Fin.rev ⟨k, h⟩))).run (D.memAfter ω L k)).2.1
      else D.memAfter ω L k

/-- Number of cells whose contents differ between two memories. -/
def changedCells {w : ℕ} (M M' : Mem w) : ℕ :=
  (Finset.univ.filter (fun x : Word w => M x ≠ M' x)).card

/-- "For every update input and every outcome of its randomness, epoch `i` changes at
most `C t_u d B^(i+1)` cells" (epoch `Fin.rev k` has depth `(Fin.rev k).val + 1`). -/
def EpochDS.WriteBound {d B b w : ℕ} {Ω : Type} (D : EpochDS d B b w Ω) (C tu : ℝ) : Prop :=
  ∀ (ω : Ω) (L : Labels d B b) (k : ℕ) (h : k < d),
    (changedCells (D.memAfter ω L k) (D.memAfter ω L (k + 1)) : ℝ) ≤
      C * tu * d * (B : ℝ) ^ ((Fin.rev (⟨k, h⟩ : Fin d)).val + 2)

/-- Zero-error correctness after all `d` epochs, for every seed and labelling. -/
def EpochDS.Correct {d B b w : ℕ} {Ω : Type} (D : EpochDS d B b w Ω) : Prop :=
  ∀ (ω : Ω) (L : Labels d B b) (s t : Fin d → Fin B),
    (((D.query ω s t).run (D.memAfter ω L d)).1 = true ↔ EpochAnswer L s t)

/-- `t_q`: expected query probes over uniform labels, a uniform query, and the seed. -/
def EpochDS.avgQueryCost {d B b w : ℕ} {Ω : Type} [Fintype Ω] (D : EpochDS d B b w Ω)
    (p : FinDist Ω) : ℝ :=
  ∑ ω, p ω * ((Fintype.card (Labels d B b) : ℝ)⁻¹ *
    ((Fintype.card (Fin d → Fin B) : ℝ) ^ 2)⁻¹ *
    ∑ L : Labels d B b, ∑ s : Fin d → Fin B, ∑ t : Fin d → Fin B,
      (((D.query ω s t).run (D.memAfter ω L d)).2.2 : ℝ))

/-! ## Main theorem -/

/-- With `b = ⌈lg d⌉ + 6`, `B = ⌈(d t_u w)^12⌉`, `n = d ∑_{i=1}^d B^i` and
`w ≥ ⌈lg n⌉`, every zero-error data structure whose epoch `i` changes at most
`C t_u d B^(i+1)` cells has `t_q ≥ c (lg n)^{3/2} / (lg(t_u w))²` for all large `d`. [SuperLogarithmicLowerBounds, node_15] -/
theorem epoch_problem_lower_bound (C : ℝ) (hC : 0 < C) :
    ∃ c : ℝ, 0 < c ∧ ∃ D₀ : ℕ, ∀ d : ℕ, D₀ ≤ d → ∀ (tu : ℝ) (w : ℕ), 1 ≤ tu →
      Nat.clog 2 (d * ∑ i ∈ Finset.Icc 1 d, ⌈((d : ℝ) * tu * w) ^ 12⌉₊ ^ i) ≤ w →
      ∀ (Ω : Type) [Fintype Ω] (p : FinDist Ω)
        (D : EpochDS d ⌈((d : ℝ) * tu * w) ^ 12⌉₊ (Nat.clog 2 d + 6) w Ω),
        D.WriteBound C tu → D.Correct →
        c * Real.logb 2 ((d * ∑ i ∈ Finset.Icc 1 d, ⌈((d : ℝ) * tu * w) ^ 12⌉₊ ^ i : ℕ) : ℝ)
            ^ (3 / 2 : ℝ) / Real.logb 2 (tu * w) ^ 2 ≤ D.avgQueryCost p := by
  sorry

end TCSChallenge.SuperLogarithmicLowerBounds.node_15
