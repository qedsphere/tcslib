/-!
## Reachability encoding of the OR-of-path-XOR epoch problem

For each depth `i = 1, …, d` the butterfly `G_i` has vertex set `{0,…,i} × [B]^i`
and an edge from `(r,x)` to `(r+1,y)` iff `x` and `y` agree outside coordinate `r`.
Every edge carries a label in `{0,1}^b` (modelled as `Fin b → ZMod 2`).

The construction: lift each `G_i` to `H_i` with vertices `(u, a)`, `a ∈ {0,1}^b`, and
edges `(u,a) → (v, a ⊕ ℓ(u,v))`; add an in-tree `S` and an out-tree `T` (perfect
`B`-ary, depth `d`), connect the depth-`i` vertex `x` of `S` to `(source x, 0)` of
`H_i` and `(sink x, 0)` of `H_i` to the depth-`i` vertex `x` of `T`.

Main theorem `epoch_problem_reduces_to_reachability`: the resulting graph is acyclic
at every stage, leaf `s` of `S` reaches leaf `t` of `T` iff some depth `i` has zero
path-XOR between the length-`i` prefixes of `s` and `t`, it has exactly
`N = ∑_{i=1}^d 2^b (i+1) B^i + 2 ∑_{i=0}^d B^i` vertices, and epoch `i` makes at most
`3 n / B^(d-i-1)` insertions whenever `n ≥ N`.
-/

namespace TCSChallenge.SuperLogarithmicLowerBounds.node_14

/-! ## Butterflies and path XOR (shared block) -/

/-- An edge of the degree-`B` butterfly of depth `k`: `(r, x, y)` is the edge from
vertex `x` in layer `r` to vertex `x[r ↦ y]` in layer `r+1` ("there is an edge from
(r,x) to (r+1,y) exactly when x_j = y_j for every j ≠ r"). There are `k B^(k+1)`. -/
abbrev BEdge (B k : ℕ) : Type := Fin k × (Fin k → Fin B) × Fin B

/-- Labels in `{0,1}^b`, with XOR as addition in `ZMod 2`. -/
abbrev Label (b : ℕ) : Type := Fin b → ZMod 2

/-- Tail vertex (in layer `e.1`) of a butterfly edge. -/
def BEdge.tail {B k : ℕ} (e : BEdge B k) : Fin k → Fin B := e.2.1

/-- Head vertex (in layer `e.1 + 1`) of a butterfly edge. -/
def BEdge.head {B k : ℕ} (e : BEdge B k) : Fin k → Fin B :=
  Function.update e.2.1 e.1 e.2.2

/-- The vertex in layer `r` of the unique path from source `u` to sink `v`:
coordinates `< r` already agree with `v`, the others still agree with `u`. -/
def pathVertex {B k : ℕ} (u v : Fin k → Fin B) (r : ℕ) : Fin k → Fin B :=
  fun j => if j.val < r then v j else u j

/-- `X(u,v)`: "the bitwise XOR of the labels along the directed path from source `u`
to sink `v`". The `r`-th edge of that path leaves `pathVertex u v r` and sets
coordinate `r` to `v r`. -/
def pathXor {B b k : ℕ} (ℓ : BEdge B k → Label b) (u v : Fin k → Fin B) : Label b :=
  ∑ r : Fin k, ℓ (r, pathVertex u v r.val, v r)

/-- A full labelling: `ℓ i` labels the butterfly of depth `i.val + 1`. -/
abbrev Labels (d B b : ℕ) : Type := (i : Fin d) → BEdge B (i.val + 1) → Label b

/-- The first `i.val + 1` base-`B` digits of `s`, i.e. `⌊s / B^(d-(i+1))⌋`. -/
def prefixWord {d B : ℕ} (s : Fin d → Fin B) (i : Fin d) : Fin (i.val + 1) → Fin B :=
  fun j => s ⟨j.val, Nat.lt_of_lt_of_le j.isLt (Nat.succ_le_of_lt i.isLt)⟩

/-- The answer to query `(s,t)`: "there exists `i ∈ {1,…,d}` such that
`X_i(⌊s/B^(d−i)⌋, ⌊t/B^(d−i)⌋) = 0^b`". -/
def EpochAnswer {d B b : ℕ} (ℓ : Labels d B b) (s t : Fin d → Fin B) : Prop :=
  ∃ i : Fin d, pathXor (ℓ i) (prefixWord s i) (prefixWord t i) = 0

/-! ## The reachability construction (shared block) -/

/-- Vertices of a perfect `B`-ary tree of depth `d`: a depth `r ≤ d` and a word of
length `r` (its parent deletes the last digit). -/
abbrev TreeV (d B : ℕ) : Type := (r : Fin (d + 1)) × (Fin r.val → Fin B)

/-- Vertices of the lifted butterflies `H_i`: component `i`, layer, word, XOR state. -/
abbrev LiftV (d B b : ℕ) : Type :=
  (i : Fin d) × Fin (i.val + 2) × (Fin (i.val + 1) → Fin B) × Label b

/-- All vertices: in-tree `S`, the lifted butterflies, out-tree `T`. -/
abbrev CVert (d B b : ℕ) : Type := TreeV d B ⊕ LiftV d B b ⊕ TreeV d B

/-- Vertex of `S`. -/
def srcV {d B b : ℕ} (v : TreeV d B) : CVert d B b := Sum.inl v

/-- Vertex of `T`. -/
def snkV {d B b : ℕ} (v : TreeV d B) : CVert d B b := Sum.inr (Sum.inr v)

/-- Vertex `(layer r, word x, state a)` of `H_i`. -/
def liftV {d B b : ℕ} (i : Fin d) (r : Fin (i.val + 2)) (x : Fin (i.val + 1) → Fin B)
    (a : Label b) : CVert d B b :=
  Sum.inr (Sum.inl ⟨i, r, x, a⟩)

/-- The tree vertex at depth `r.val + 1` with word `x`. -/
def childNode {d B : ℕ} (r : Fin d) (x : Fin (r.val + 1) → Fin B) : TreeV d B :=
  ⟨⟨r.val + 1, Nat.succ_lt_succ r.isLt⟩, x⟩

/-- The parent (depth `r.val`) of `childNode r x`: delete the last digit. -/
def parentNode {d B : ℕ} (r : Fin d) (x : Fin (r.val + 1) → Fin B) : TreeV d B :=
  ⟨⟨r.val, Nat.lt_succ_of_lt r.isLt⟩, fun j : Fin r.val => x j.castSucc⟩

/-- Leaf `s` of a tree. -/
def leaf {d B : ℕ} (s : Fin d → Fin B) : TreeV d B := ⟨Fin.last d, s⟩

/-- Edges of the constructed graph after all epochs. In order: `S` edges (child to
parent), `T` edges (parent to child), `S`-to-source connections, sink-to-`T`
connections, and the lifted edges `(u,a) → (v, a ⊕ ℓ(e))` of each `H_i`. -/
def CEdge {d B b : ℕ} (ℓ : Labels d B b) (u v : CVert d B b) : Prop :=
  (∃ (r : Fin d) (x : Fin (r.val + 1) → Fin B),
      u = srcV (childNode r x) ∧ v = srcV (parentNode r x)) ∨
  (∃ (r : Fin d) (x : Fin (r.val + 1) → Fin B),
      u = snkV (parentNode r x) ∧ v = snkV (childNode r x)) ∨
  (∃ (i : Fin d) (x : Fin (i.val + 1) → Fin B),
      u = srcV (childNode i x) ∧ v = liftV i ⟨0, Nat.zero_lt_succ _⟩ x 0) ∨
  (∃ (i : Fin d) (x : Fin (i.val + 1) → Fin B),
      u = liftV i (Fin.last (i.val + 1)) x 0 ∧ v = snkV (childNode i x)) ∨
  (∃ (i : Fin d) (e : BEdge B (i.val + 1)) (a : Label b),
      u = liftV i e.1.castSucc e.tail a ∧ v = liftV i e.1.succ e.head (a + ℓ i e))

/-- The vertex budget `N = ∑_{i=1}^d 2^b (i+1) B^i + 2 ∑_{i=0}^d B^i` (reindexed). -/
def vertexBudget (d B b : ℕ) : ℕ :=
  (∑ i ∈ Finset.range d, 2 ^ b * (i + 2) * B ^ (i + 1)) + 2 * ∑ i ∈ Finset.range (d + 1), B ^ i

/-- Number of auxiliary (tree and connecting) edges, all inserted in epoch `d`:
`4 ∑_{i=1}^d B^i`. -/
def auxEdgeCount (d B : ℕ) : ℕ := 4 * ∑ r ∈ Finset.range d, B ^ (r + 1)

/-- Number of reachability insertions made in the epoch of depth `i.val + 1`:
`2^b · (i+1) B^(i+2)` lifted edges, plus all auxiliary edges in epoch `d`. -/
def epochInsertions (d B b : ℕ) (i : Fin d) : ℕ :=
  2 ^ b * (i.val + 1) * B ^ (i.val + 2) + (if i.val + 1 = d then auxEdgeCount d B else 0)

/-! ## Rubric lemmas -/

/-- Single-butterfly invariant: inside the constructed graph, `(source u, 0)` of `H_i`
reaches `(sink v, a)` iff `a` is the path XOR from `u` to `v`; in particular zero
reaches zero iff the path XOR vanishes. [SuperLogarithmicLowerBounds, node_14] -/
theorem lifted_reach_iff {d B b : ℕ} (ℓ : Labels d B b) (i : Fin d)
    (u v : Fin (i.val + 1) → Fin B) (a : Label b) :
    Relation.ReflTransGen (CEdge ℓ) (liftV i ⟨0, Nat.zero_lt_succ _⟩ u 0)
        (liftV i (Fin.last (i.val + 1)) v a) ↔
      a = pathXor (ℓ i) u v := by
  sorry

/-- One-query aggregation: leaf `s` of `S` reaches leaf `t` of `T` iff the OR of the
zero-XOR conditions over all depths holds. [SuperLogarithmicLowerBounds, node_14] -/
theorem leaf_reach_iff {d B b : ℕ} (ℓ : Labels d B b) (s t : Fin d → Fin B) :
    Relation.ReflTransGen (CEdge ℓ) (srcV (leaf s)) (snkV (leaf t)) ↔ EpochAnswer ℓ s t := by
  sorry

/-- Insertion-only acyclicity: every subgraph of the final graph (in particular every
intermediate graph of the insertion sequence) is acyclic. [SuperLogarithmicLowerBounds, node_14] -/
theorem acyclic_of_sub {d B b : ℕ} (ℓ : Labels d B b) (R : CVert d B b → CVert d B b → Prop)
    (hR : ∀ u v, R u v → CEdge ℓ u v) (v : CVert d B b) :
    ¬ Relation.TransGen R v v := by
  sorry

/-- The construction uses exactly `N` vertices. [SuperLogarithmicLowerBounds, node_14] -/
theorem card_CVert (d B b : ℕ) : Fintype.card (CVert d B b) = vertexBudget d B b := by
  sorry

/-- The depth-`k` butterfly has `k B^(k+1)` edges, so epoch `k` lifts `2^b k B^(k+1)`. [SuperLogarithmicLowerBounds, node_14] -/
theorem card_lifted_edges (B b k : ℕ) :
    Fintype.card (BEdge B k × Label b) = 2 ^ b * k * B ^ (k + 1) := by
  sorry

/-- Auxiliary edges: the number of tree and connecting edges is at most `2N`. [SuperLogarithmicLowerBounds, node_14] -/
theorem auxEdgeCount_le (d B b : ℕ) : auxEdgeCount d B ≤ 2 * vertexBudget d B b := by
  sorry

/-- Probe accounting: when `n ≥ N`, epoch `i` (depth `i.val+1`) makes at most
`3 n / B^(d - i - 1)` insertions (exponent `-1` in epoch `d`). [SuperLogarithmicLowerBounds, node_14] -/
theorem epochInsertions_le (d B b n : ℕ) (hB : 1 ≤ B) (hn : vertexBudget d B b ≤ n)
    (i : Fin d) :
    (epochInsertions d B b i : ℝ) ≤
      3 * (n : ℝ) / (B : ℝ) ^ ((d : ℤ) - ((i.val : ℤ) + 1) - 1) := by
  sorry

/-! ## Main theorem -/

/-- The OR-of-path-XOR epoch problem reduces to insertion-only DAG reachability on
`n ≥ N` vertices with one reachability query per query and `O(n / B^(d-i-1))`
insertions in epoch `i` (absolute constant 3). [SuperLogarithmicLowerBounds, node_14] -/
theorem epoch_problem_reduces_to_reachability (d B b n : ℕ) (hB : 1 ≤ B)
    (hn : vertexBudget d B b ≤ n) :
    Fintype.card (CVert d B b) = vertexBudget d B b ∧
    (∀ ℓ : Labels d B b, ∀ R : CVert d B b → CVert d B b → Prop,
        (∀ u v, R u v → CEdge ℓ u v) → ∀ v, ¬ Relation.TransGen R v v) ∧
    (∀ (ℓ : Labels d B b) (s t : Fin d → Fin B),
        Relation.ReflTransGen (CEdge ℓ) (srcV (leaf s)) (snkV (leaf t)) ↔ EpochAnswer ℓ s t) ∧
    (∀ i : Fin d, (epochInsertions d B b i : ℝ) ≤
        3 * (n : ℝ) / (B : ℝ) ^ ((d : ℤ) - ((i.val : ℤ) + 1) - 1)) := by
  sorry

end TCSChallenge.SuperLogarithmicLowerBounds.node_14
