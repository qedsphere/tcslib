/-!
## Single-pass streaming bipartite matching beyond `(8 - 2√10)/3` needs `n^{1+Ω(1/log log n)}` bits

A single-pass insertion-only streaming algorithm is `α`-approximate if with probability at
least `2/3` it outputs a matching `M ⊆ E` of the input bipartite graph with
`|M| ≥ α · OPT`.

**Main theorem** (`streaming_lower_bound`). For every `α > ρ₀ = (8 - 2√10)/3` there is
`c > 0` such that for all large `n`, every `α`-approximate single-pass algorithm on
`n`-vertex bipartite streams uses `S ≥ n^{1 + c / log log n}` bits.

The route goes through blueprints (definitions below): `V^* ≥ v₀ = (5 - √10)/3`
(`exists_proper_value_gt`) and, for each proper blueprint `𝔾` and `α > α(𝔾)`, the same space
lower bound (`blueprint_lower_bound`). Coordinates are 0-indexed: phase `p : Fin P` is the
paper's phase `p + 1`, and `x_{<p} ∘ z` is `splice p x z`.
-/

namespace TCSChallenge.SemiStreamingMatchingIn.node_33

/-! ### Blueprints -/

/-- A blueprint `𝔾 = (𝕃, ℝ, 𝔼, w)`: left vertices `𝕃^{(b)}(x)` are pairs `(b, x)` with
`b ∈ [B_L]`, `x ∈ [C]^P`; right vertices likewise. `E` is the edge set, `phase e = p` means
`e ∈ 𝔼^{(p+1)}`, and `w` is the weight function (only its values on `E` matter). -/
structure Blueprint where
  P : ℕ
  C : ℕ
  BL : ℕ
  BR : ℕ
  sL : Fin BL → ℚ
  sR : Fin BR → ℚ
  E : Finset ((Fin BL × (Fin P → Fin C)) × (Fin BR × (Fin P → Fin C)))
  phase : (Fin BL × (Fin P → Fin C)) × (Fin BR × (Fin P → Fin C)) → Fin P
  w : (Fin BL × (Fin P → Fin C)) × (Fin BR × (Fin P → Fin C)) → ℚ

namespace Blueprint

/-- A left vertex is isolated when no edge of `𝔼` is incident to it. -/
def LIsolated (G : Blueprint) (u : Fin G.BL × (Fin G.P → Fin G.C)) : Prop :=
  ∀ e ∈ G.E, e.1 ≠ u

/-- A right vertex is isolated when no edge of `𝔼` is incident to it. -/
def RIsolated (G : Blueprint) (v : Fin G.BR × (Fin G.P → Fin G.C)) : Prop :=
  ∀ e ∈ G.E, e.2 ≠ v

/-- "fixed positive integers `P, C, B_L, B_R`, positive rational block sizes, and
`w : 𝔼 → ℚ_{>0}`". -/
def WellFormed (G : Blueprint) : Prop :=
  0 < G.P ∧ 0 < G.C ∧ 0 < G.BL ∧ 0 < G.BR ∧ (∀ b, 0 < G.sL b) ∧ (∀ b, 0 < G.sR b) ∧
    ∀ e ∈ G.E, 0 < G.w e

/-- "every nonisolated vertex `𝕃^{(b)}(x)` has total incident weight `s_L(b)`, and every
nonisolated vertex `ℝ^{(b')}(y)` has total incident weight `s_R(b')`". -/
def DegreeCondition (G : Blueprint) : Prop :=
  (∀ u : Fin G.BL × (Fin G.P → Fin G.C), ¬ G.LIsolated u →
      ∑ e ∈ G.E.filter (fun e => e.1 = u), G.w e = G.sL u.1) ∧
    (∀ v : Fin G.BR × (Fin G.P → Fin G.C), ¬ G.RIsolated v →
      ∑ e ∈ G.E.filter (fun e => e.2 = v), G.w e = G.sR v.1)

/-- `x_{<p} ∘ z`: keep the coordinates `i < p` of `x`, take the remaining ones from `z`. -/
def splice {P C : ℕ} (p : Fin P) (x z : Fin P → Fin C) : Fin P → Fin C :=
  fun i => if i.val < p.val then x i else z i

/-- "if `e = (𝕃^{(b)}(x), ℝ^{(b')}(y)) ∈ 𝔼^{(p)}`, then for every `z ∈ [C]^{P-p+1}`, at
least one of `𝕃^{(b)}(x_{<p} ∘ z)` and `ℝ^{(b')}(y_{<p} ∘ z)` is isolated". -/
def BanCondition (G : Blueprint) : Prop :=
  ∀ e ∈ G.E, ∀ z : Fin G.P → Fin G.C,
    G.LIsolated (e.1.1, splice (G.phase e) e.1.2 z) ∨
      G.RIsolated (e.2.1, splice (G.phase e) e.2.2 z)

/-- A proper blueprint. -/
def IsProper (G : Blueprint) : Prop :=
  G.WellFormed ∧ G.DegreeCondition ∧ G.BanCondition

/-- `value(𝔾) = 2 ∑_{e ∈ 𝔼} w(e) / (C^P (∑_b s_L(b) + ∑_{b'} s_R(b')))`. -/
def value (G : Blueprint) : ℝ :=
  (2 * ∑ e ∈ G.E, (G.w e : ℝ)) /
    ((G.C : ℝ) ^ G.P * (∑ b, (G.sL b : ℝ) + ∑ b, (G.sR b : ℝ)))

/-- `α(𝔾) = (2 - 2v)/(2 - v)` with `v = value(𝔾)`. -/
def alphaOf (G : Blueprint) : ℝ :=
  (2 - 2 * G.value) / (2 - G.value)

/-- "simple if `B_L = B_R = 1`, both block sizes are `1`, and every edge weight is `1`". -/
def IsSimple (G : Blueprint) : Prop :=
  G.BL = 1 ∧ G.BR = 1 ∧ (∀ b, G.sL b = 1) ∧ (∀ b, G.sR b = 1) ∧ ∀ e ∈ G.E, G.w e = 1

end Blueprint

/-! ### Single-pass streaming of bipartite graphs -/

/-- A valid insertion-only stream of a bipartite graph on vertex set `Fin n`: a list of
oriented edges `(left, right)`, without repetitions, such that no vertex occurs both as a
left and as a right endpoint. -/
def ValidStream {n : ℕ} (s : List (Fin n × Fin n)) : Prop :=
  s.Nodup ∧ ∀ e ∈ s, ∀ e' ∈ s, e.1 ≠ e'.2

/-- `M` is a matching of the input graph: `M ⊆ E(H)` and distinct edges of `M` share no
endpoint. -/
def IsMatchingIn {n : ℕ} (s : List (Fin n × Fin n)) (M : Finset (Fin n × Fin n)) : Prop :=
  M ⊆ s.toFinset ∧ ∀ e ∈ M, ∀ e' ∈ M, e ≠ e' → e.1 ≠ e'.1 ∧ e.2 ≠ e'.2

/-- `OPT(H)`: the maximum matching size of the streamed graph. -/
def maxMatching {n : ℕ} (s : List (Fin n × Fin n)) : ℕ :=
  (s.toFinset.powerset.filter (fun M => IsMatchingIn s M)).sup Finset.card

/-- A deterministic single-pass streaming algorithm with `S` bits of memory on `n`-vertex
inputs: memory states `Fin (2^S)`, an initial state, a transition per streamed edge, and an
output matching computed from the final state. -/
structure DetStreamAlg (n S : ℕ) where
  init : Fin (2 ^ S)
  step : Fin (2 ^ S) → Fin n × Fin n → Fin (2 ^ S)
  out : Fin (2 ^ S) → Finset (Fin n × Fin n)

/-- Output of a deterministic streaming algorithm on a stream. -/
def DetStreamAlg.run {n S : ℕ} (A : DetStreamAlg n S) (s : List (Fin n × Fin n)) :
    Finset (Fin n × Fin n) :=
  A.out (s.foldl A.step A.init)

/-- A randomized `S`-bit streaming algorithm: a finite probability mixture of deterministic
`S`-bit algorithms (the random seed is free); the mixture weights `prob` are a finite
probability distribution on the seeds `Fin K`. -/
structure RandStreamAlg (n S : ℕ) where
  K : ℕ
  prob : FinDist (Fin K)
  alg : Fin K → DetStreamAlg n S

/-- Probability that the output on stream `s` satisfies `good`. -/
def RandStreamAlg.succProb {n S : ℕ} (R : RandStreamAlg n S) (s : List (Fin n × Fin n))
    (good : Finset (Fin n × Fin n) → Prop) : ℝ :=
  ∑ k, if good ((R.alg k).run s) then R.prob k else 0

/-- "outputs a matching `M ⊆ E(H)` satisfying `|M| ≥ β · OPT(H)`". -/
def GoodOutput {n : ℕ} (β : ℝ) (s : List (Fin n × Fin n)) (M : Finset (Fin n × Fin n)) :
    Prop :=
  IsMatchingIn s M ∧ β * (maxMatching s : ℝ) ≤ (M.card : ℝ)

/-! ### Lossy compression of a randomly thinned edge set -/

/-- Probability of the surviving set `X ⊆ [m]` when each of `m` base edges is deleted
independently with probability `η`. -/
def thinProb (m : ℕ) (η : ℝ) (X : Finset (Fin m)) : ℝ :=
  ∏ i, if i ∈ X then 1 - η else η

/-- Probability that an `s`-bit summary `g` of the thinned set equals `μ`. -/
def msgProb {m s : ℕ} (η : ℝ) (g : Finset (Fin m) → Fin (2 ^ s)) (μ : Fin (2 ^ s)) : ℝ :=
  ∑ X, if g X = μ then thinProb m η X else 0

/-- Base edges certified by message `μ`: posterior survival probability at least
`1 - η/2` given `g(X) = μ` (written multiplicatively; `μ` must have positive probability). -/
def certified {m s : ℕ} (η : ℝ) (g : Finset (Fin m) → Fin (2 ^ s)) (μ : Fin (2 ^ s)) :
    Finset (Fin m) :=
  Finset.univ.filter (fun i =>
    0 < msgProb η g μ ∧
      (1 - η / 2) * msgProb η g μ ≤ ∑ X, if g X = μ ∧ i ∈ X then thinProb m η X else 0)

/-- Expected number of certified base edges. -/
def expectedCertified {m s : ℕ} (η : ℝ) (g : Finset (Fin m) → Fin (2 ^ s)) : ℝ :=
  ∑ X, thinProb m η X * ((certified η g (g X)).card : ℝ)

/-! ### Lemma stubs -/

/-- Supplied fact 3 (lossy compression): an `s`-bit summary of an `η`-thinned base set
certifies posterior survival `≥ 1 - η/2` for only `O(s / (η log(1/η)))` base edges in
expectation. [SemiStreamingMatchingIn, node_33] -/
theorem lossy_compression :
    ∃ η₀ : ℝ, 0 < η₀ ∧ ∃ K : ℝ, 0 < K ∧
      ∀ η : ℝ, 0 < η → η ≤ η₀ → ∀ m s : ℕ, ∀ g : Finset (Fin m) → Fin (2 ^ s),
        expectedCertified η g ≤ K * (s : ℝ) / (η * Real.log (1 / η)) := by
  sorry

/-- Normalization: every proper blueprint has a simple proper counterpart of the same value
with at most one extra player coordinate. [SemiStreamingMatchingIn, node_33] -/
theorem normalize_to_simple (G : Blueprint) (hG : G.IsProper) :
    ∃ G' : Blueprint, G'.IsProper ∧ G'.IsSimple ∧ G'.value = G.value ∧ G'.P ≤ G.P + 1 := by
  sorry

/-- Every proper blueprint has value in `[0, 1]`. [SemiStreamingMatchingIn, node_33] -/
theorem value_mem_Icc (G : Blueprint) (hG : G.IsProper) : 0 ≤ G.value ∧ G.value ≤ 1 := by
  sorry

/-- `f(v) = (2 - 2v)/(2 - v)` is strictly decreasing on `(-∞, 2)`. [SemiStreamingMatchingIn, node_33] -/
theorem f_strictAntiOn :
    StrictAntiOn (fun v : ℝ => (2 - 2 * v) / (2 - v)) (Set.Iio 2) := by
  sorry

/-- Extremal component (`V^* ≥ v₀`): every `γ < (5 - √10)/3` is exceeded by the value of a
proper blueprint. [SemiStreamingMatchingIn, node_33] -/
theorem exists_proper_value_gt (γ : ℝ) (hγ : γ < (5 - Real.sqrt 10) / 3) :
    ∃ G : Blueprint, G.IsProper ∧ γ < G.value := by
  sorry

/-- Lower-bound component: for a proper blueprint `𝔾` and `α > α(𝔾)`, every `α`-approximate
single-pass algorithm needs `n^{1 + Ω(1/log log n)}` bits. [SemiStreamingMatchingIn, node_33] -/
theorem blueprint_lower_bound (G : Blueprint) (hG : G.IsProper) (α : ℝ)
    (hα : G.alphaOf < α) :
    ∃ c : ℝ, 0 < c ∧ ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → ∀ S : ℕ, ∀ R : RandStreamAlg n S,
      (∀ s : List (Fin n × Fin n), ValidStream s → (2 : ℝ) / 3 ≤ R.succProb s (GoodOutput α s)) →
        (n : ℝ) ^ (1 + c / Real.log (Real.log n)) ≤ (S : ℝ) := by
  sorry

/-! ### Main theorem -/

/-- **Main theorem.** For every fixed `α > (8 - 2√10)/3`, every `α`-approximate single-pass
insertion-only streaming algorithm for bipartite matching on `n`-vertex graphs uses
`n^{1 + Ω(1/log log n)}` bits of space. [SemiStreamingMatchingIn, node_33] -/
theorem streaming_lower_bound (α : ℝ) (hα : (8 - 2 * Real.sqrt 10) / 3 < α) :
    ∃ c : ℝ, 0 < c ∧ ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → ∀ S : ℕ, ∀ R : RandStreamAlg n S,
      (∀ s : List (Fin n × Fin n), ValidStream s → (2 : ℝ) / 3 ≤ R.succProb s (GoodOutput α s)) →
        (n : ℝ) ^ (1 + c / Real.log (Real.log n)) ≤ (S : ℝ) := by
  sorry

end TCSChallenge.SemiStreamingMatchingIn.node_33
