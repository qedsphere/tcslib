  sorry

/-- `r` is a root of `3v² - 10v + 5`. [SemiStreamingMatchingIn, node_29] -/
theorem rStar_root : 3 * rStar ^ 2 - 10 * rStar + 5 = 0 := by
  sorry

/-- The margin identity `3(r-δ)² - 10(r-δ) + 5 = 2√10 δ + 3δ²`. [SemiStreamingMatchingIn, node_29] -/
theorem margin_identity (δ : ℝ) :
    3 * (rStar - δ) ^ 2 - 10 * (rStar - δ) + 5 = 2 * Real.sqrt 10 * δ + 3 * δ ^ 2 := by
  sorry

/-- Quantitative gap-sensitive improvement (reference strategy): a proper blueprint of
value below `r - δ` can be augmented to a proper blueprint of value larger by `δ³`. [SemiStreamingMatchingIn, node_29] -/
theorem quantitative_improvement (δ : ℝ) (hδ0 : 0 < δ) (hδ1 : δ < 1) (G : Blueprint)
    (hG : G.IsProper) (hv : G.value < rStar - δ) :
    ∃ G' : Blueprint, G'.IsProper ∧ G.value + δ ^ 3 < G'.value := by
