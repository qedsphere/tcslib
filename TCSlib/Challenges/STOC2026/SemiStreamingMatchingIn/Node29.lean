/-!
## Proper blueprints of value approaching `(5 - √10)/3`

Blueprints, properness, `value` and `α = (2-2v)/(2-v)` are as in the paper (see the
definitions below). With `V^* = sup { value(𝔾) : 𝔾 proper }` and
`A^* = inf { α(𝔾) : 𝔾 proper }`, the claim is
`V^* ≥ r := (5 - √10)/3` and consequently `A^* ≤ (8 - 2√10)/3`.

**Main theorems.** `exists_proper_value_gt`: for every `γ < r` some proper blueprint has
value `> γ` (this is `V^* ≥ r` without `sSup`); `exists_proper_alpha_lt`: for every
`γ > (8 - 2√10)/3` some proper blueprint has `α(𝔾) < γ`. The `sSup`/`sInf` forms are
stated as well.

Coordinates are 0-indexed: phase `p : Fin P` corresponds to the paper's phase `p + 1`, and
`x_{<p} ∘ z` is `splice p x z`.
-/

namespace TCSChallenge.SemiStreamingMatchingIn.node_29

/-! ### Blueprints -/

/-- A blueprint `𝔾 = (𝕃, ℝ, 𝔼, w)`: left vertices `𝕃^{(b)}(x)` are pairs `(b, x)` with
`b ∈ [B_L]`, `x ∈ [C]^P`; right vertices likewise. `E` is the edge set, `phase e = p` means
`e ∈ 𝔼^{(p+1)}`, and `w` is the weight function (only its values on `E` matter). -/
structure Blueprint where
  P : ℕ
  C : ℕ
  BL : ℕ
  BR : ℕ
  sL : Fin BL → ℚ
  sR : Fin BR → ℚ
  E : Finset ((Fin BL × (Fin P → Fin C)) × (Fin BR × (Fin P → Fin C)))
  phase : (Fin BL × (Fin P → Fin C)) × (Fin BR × (Fin P → Fin C)) → Fin P
  w : (Fin BL × (Fin P → Fin C)) × (Fin BR × (Fin P → Fin C)) → ℚ

namespace Blueprint

/-- A left vertex is isolated when no edge of `𝔼` is incident to it. -/
def LIsolated (G : Blueprint) (u : Fin G.BL × (Fin G.P → Fin G.C)) : Prop :=
  ∀ e ∈ G.E, e.1 ≠ u

/-- A right vertex is isolated when no edge of `𝔼` is incident to it. -/
def RIsolated (G : Blueprint) (v : Fin G.BR × (Fin G.P → Fin G.C)) : Prop :=
  ∀ e ∈ G.E, e.2 ≠ v

/-- "fixed positive integers `P, C, B_L, B_R`, positive rational block sizes, and
`w : 𝔼 → ℚ_{>0}`". -/
def WellFormed (G : Blueprint) : Prop :=
  0 < G.P ∧ 0 < G.C ∧ 0 < G.BL ∧ 0 < G.BR ∧ (∀ b, 0 < G.sL b) ∧ (∀ b, 0 < G.sR b) ∧
    ∀ e ∈ G.E, 0 < G.w e

/-- "every nonisolated vertex `𝕃^{(b)}(x)` has total incident weight `s_L(b)`, and every
nonisolated vertex `ℝ^{(b')}(y)` has total incident weight `s_R(b')`". -/
def DegreeCondition (G : Blueprint) : Prop :=
  (∀ u : Fin G.BL × (Fin G.P → Fin G.C), ¬ G.LIsolated u →
      ∑ e ∈ G.E.filter (fun e => e.1 = u), G.w e = G.sL u.1) ∧
    (∀ v : Fin G.BR × (Fin G.P → Fin G.C), ¬ G.RIsolated v →
      ∑ e ∈ G.E.filter (fun e => e.2 = v), G.w e = G.sR v.1)

/-- `x_{<p} ∘ z`: keep the coordinates `i < p` of `x`, take the remaining ones from `z`. -/
def splice {P C : ℕ} (p : Fin P) (x z : Fin P → Fin C) : Fin P → Fin C :=
  fun i => if i.val < p.val then x i else z i

/-- "if `e = (𝕃^{(b)}(x), ℝ^{(b')}(y)) ∈ 𝔼^{(p)}`, then for every `z ∈ [C]^{P-p+1}`, at
least one of `𝕃^{(b)}(x_{<p} ∘ z)` and `ℝ^{(b')}(y_{<p} ∘ z)` is isolated". -/
def BanCondition (G : Blueprint) : Prop :=
  ∀ e ∈ G.E, ∀ z : Fin G.P → Fin G.C,
    G.LIsolated (e.1.1, splice (G.phase e) e.1.2 z) ∨
      G.RIsolated (e.2.1, splice (G.phase e) e.2.2 z)

/-- A proper blueprint. -/
def IsProper (G : Blueprint) : Prop :=
  G.WellFormed ∧ G.DegreeCondition ∧ G.BanCondition

/-- `value(𝔾) = 2 ∑_{e ∈ 𝔼} w(e) / (C^P (∑_b s_L(b) + ∑_{b'} s_R(b')))`. -/
def value (G : Blueprint) : ℝ :=
  (2 * ∑ e ∈ G.E, (G.w e : ℝ)) /
    ((G.C : ℝ) ^ G.P * (∑ b, (G.sL b : ℝ) + ∑ b, (G.sR b : ℝ)))

/-- `α(𝔾) = (2 - 2v)/(2 - v)` with `v = value(𝔾)`. -/
def alphaOf (G : Blueprint) : ℝ :=
  (2 - 2 * G.value) / (2 - G.value)

/-- "simple if `B_L = B_R = 1`, both block sizes are `1`, and every edge weight is `1`". -/
def IsSimple (G : Blueprint) : Prop :=
  G.BL = 1 ∧ G.BR = 1 ∧ (∀ b, G.sL b = 1) ∧ (∀ b, G.sR b = 1) ∧ ∀ e ∈ G.E, G.w e = 1

end Blueprint

/-! ### Constants -/

/-- `r = (5 - √10)/3`, the smaller root of `3v² - 10v + 5`. -/
def rStar : ℝ := (5 - Real.sqrt 10) / 3

/-- `f(x) = (2 - 2x)/(2 - x)`. -/
def fRatio (x : ℝ) : ℝ := (2 - 2 * x) / (2 - x)

/-- The set of values of proper blueprints. -/
def properValues : Set ℝ := {v | ∃ G : Blueprint, G.IsProper ∧ G.value = v}

/-- The set of ratios `α(𝔾)` of proper blueprints. -/
def properAlphas : Set ℝ := {a | ∃ G : Blueprint, G.IsProper ∧ G.alphaOf = a}

