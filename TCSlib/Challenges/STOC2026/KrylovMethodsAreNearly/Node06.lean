/-!
## Krylov-type algorithm for Schatten-p rank-one approximation with `Õ(p ε^{-1/3})` queries

With `‖M‖_{S_p}^p = ∑ σ_j(M)^p`, there is a randomized adaptive algorithm with access to
`x ↦ Ax` and `y ↦ Aᵀy` that, for every `A ∈ ℝ^{n×d}`, uses
`O(p ε^{-1/3} max{1, log(1/ε)})` queries (independent of `n, d`) and returns a unit `v` with
`‖A(I - vvᵀ)‖_{S_p}^p ≤ (1+ε) min_{‖u‖=1} ‖A(I - uuᵀ)‖_{S_p}^p` with probability `≥ 99/100`.

Singular values: `σ_j(M)² ` are the eigenvalues of the PSD matrix `Mᵀ M`, so
`‖M‖_{S_p}^p = ∑_j λ_j(MᵀM)^{p/2}` (real power `p/2`).

Main theorem: `exists_schatten_rank_one_algorithm`.
-/

namespace TCSChallenge.KrylovMethodsAreNearly.node_06

open MeasureTheory ProbabilityTheory

/-- Euclidean norm `‖x‖₂`. -/
noncomputable def vnorm {m : ℕ} (x : Fin m → ℝ) : ℝ :=
  Real.sqrt (∑ i, x i ^ 2)

/-- Squared singular values of `M`: the eigenvalues of `Mᴴ M = Mᵀ M`. -/
noncomputable def sqSingularValues {n d : ℕ} (M : Matrix (Fin n) (Fin d) ℝ) : Fin d → ℝ :=
  (Matrix.isHermitian_conjTranspose_mul_self M).eigenvalues

/-- `‖M‖_{S_p}^p = ∑_j σ_j(M)^p = ∑_j (σ_j(M)²)^{p/2}`. -/
noncomputable def schattenPow {n d : ℕ} (p : ℝ) (M : Matrix (Fin n) (Fin d) ℝ) : ℝ :=
  ∑ j, (sqSingularValues M j) ^ (p / 2)

/-- `σ₁(M)^p`, the `p`-th power of the top singular value (`0` when `d = 0`). -/
noncomputable def topSVPow {n d : ℕ} (p : ℝ) (M : Matrix (Fin n) (Fin d) ℝ) : ℝ :=
  (⨆ j, sqSingularValues M j) ^ (p / 2)

/-- The residual `A (I_d - v vᵀ)`. -/
def residual {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℝ) (v : Fin d → ℝ) :
    Matrix (Fin n) (Fin d) ℝ :=
  A * (1 - Matrix.vecMulVec v v)

/-- `min_{u ∈ ℝ^d, ‖u‖₂ = 1} ‖A(I_d - uuᵀ)‖_{S_p}^p`. -/
noncomputable def optError {n d : ℕ} (p : ℝ) (A : Matrix (Fin n) (Fin d) ℝ) : ℝ :=
  sInf ((fun u => schattenPow p (residual A u)) '' {u | vnorm u = 1})

/-- A query: `inl x` asks for `A x`, `inr y` asks for `Aᵀ y`. -/
abbrev Query (n d : ℕ) := (Fin d → ℝ) ⊕ (Fin n → ℝ)

/-- Oracle reply to a query. -/
def answer {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℝ) : Query n d → (Fin n → ℝ) ⊕ (Fin d → ℝ)
  | Sum.inl x => Sum.inl (A.mulVec x)
  | Sum.inr y => Sum.inr (A.transpose.mulVec y)

/-- Transcript: list of (query, reply). -/
abbrev Transcript (n d : ℕ) := List (Query n d × ((Fin n → ℝ) ⊕ (Fin d → ℝ)))

/-- An adaptive algorithm with seed space `S`, for dimensions `n × d`. -/
structure BiAlgorithm (n d : ℕ) (S : Type) where
  query : S → Transcript n d → Query n d
  output : S → Transcript n d → (Fin d → ℝ)

/-- Transcript after `j` adaptive queries. -/
def runTranscript {n d : ℕ} {S : Type} (alg : BiAlgorithm n d S)
    (A : Matrix (Fin n) (Fin d) ℝ) (s : S) : ℕ → Transcript n d
  | 0 => []
  | j + 1 =>
      let t := runTranscript alg A s j
      let q := alg.query s t
      t ++ [(q, answer A q)]

/-- Output after `T` queries. -/
def runOutput {n d : ℕ} {S : Type} (alg : BiAlgorithm n d S)
    (A : Matrix (Fin n) (Fin d) ℝ) (s : S) (T : ℕ) : Fin d → ℝ :=
  alg.output s (runTranscript alg A s T)

/-- The Krylov space `span{g, Lg, …, Lᵗ g}`. -/
def krylov {n : ℕ} (L : Matrix (Fin n) (Fin n) ℝ) (g : Fin n → ℝ) (t : ℕ) :
    Submodule ℝ (Fin n → ℝ) :=
  Submodule.span ℝ (Set.range fun ℓ : Fin (t + 1) => (L ^ ℓ.val).mulVec g)

/-! ## Rubric lemma stubs -/

/-- **(1a) Vector-to-residual implication (pinching).** For unit `w` with `Aᵀw ≠ 0` and
`v = Aᵀw/‖Aᵀw‖₂`, `‖A(I - vvᵀ)‖_{S_p}^p ≤ ‖A‖_{S_p}^p - ‖Aᵀw‖₂^p`. [KrylovMethodsAreNearly, node_06] -/
theorem residual_le_of_left_vector {n d : ℕ} (p : ℝ) (hp : 1 ≤ p)
    (A : Matrix (Fin n) (Fin d) ℝ) (w : Fin n → ℝ) (hw : vnorm w = 1)
    (hAw : A.transpose.mulVec w ≠ 0) :
    schattenPow p (residual A ((vnorm (A.transpose.mulVec w))⁻¹ • A.transpose.mulVec w))
      ≤ schattenPow p A - vnorm (A.transpose.mulVec w) ^ p := by
  sorry

/-- **(1b) Optimal error is the singular-value tail.** For `d ≥ 1`,
`min_u ‖A(I-uuᵀ)‖_{S_p}^p = ∑_{j≥2} σ_j^p = ‖A‖_{S_p}^p - σ₁^p`. [KrylovMethodsAreNearly, node_06] -/
theorem optError_eq_tail {n d : ℕ} (hd : 1 ≤ d) (p : ℝ) (hp : 1 ≤ p)
    (A : Matrix (Fin n) (Fin d) ℝ) :
    optError p A = schattenPow p A - topSVPow p A := by
  sorry

/-- **(2–5) Dimension-independent Krylov assertion.** With `δ = min{ε, 1/2}` and
`t = ⌈C p δ^{-1/3} log(p/δ)⌉`, with probability `≥ 0.99` over `g ∼ N(0, I_n)` the Krylov
space of `AAᵀ` of depth `t` contains a unit `w` with `‖Aᵀw‖₂^p ≥ σ₁^p - δ ∑_{j≥2} σ_j^p`. [KrylovMethodsAreNearly, node_06] -/
theorem krylov_contains_good_left_vector :
    ∃ C : ℝ, 0 < C ∧ ∀ p : ℝ, 1 ≤ p → ∀ ε : ℝ, 0 < ε → ε < 1 →
      let δ := min ε (1 / 2)
      let t := ⌈C * p * δ ^ (-(1 / 3 : ℝ)) * Real.log (p / δ)⌉₊
      ∀ n d : ℕ, ∀ A : Matrix (Fin n) (Fin d) ℝ,
        (Measure.pi (fun _ : Fin n => gaussianReal 0 1))
          {g | ∃ w ∈ krylov (A * A.transpose) g t, vnorm w = 1 ∧
              topSVPow p A - δ * (schattenPow p A - topSVPow p A)
                ≤ vnorm (A.transpose.mulVec w) ^ p} ≥ 99 / 100 := by
  sorry

/-! ## Main theorem -/

/-- **Challenge.** For every bound `P₀ ≥ 1` on `p` there is `C` such that for all
`1 ≤ p ≤ P₀` and `0 < ε < 1` some randomized adaptive algorithm using
`T ≤ C p ε^{-1/3} max{1, log(1/ε)}` queries (independent of `n, d`) outputs, for every
`A ∈ ℝ^{n×d}` with `n, d ≥ 1`, with probability `≥ 99/100` a unit vector `v` with
`‖A(I - vvᵀ)‖_{S_p}^p ≤ (1+ε) min_{‖u‖=1} ‖A(I - uuᵀ)‖_{S_p}^p`. [KrylovMethodsAreNearly, node_06] -/
theorem exists_schatten_rank_one_algorithm (P₀ : ℝ) (hP₀ : 1 ≤ P₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ p : ℝ, 1 ≤ p → p ≤ P₀ → ∀ ε : ℝ, 0 < ε → ε < 1 →
      ∃ T : ℕ, (T : ℝ) ≤ C * p * ε ^ (-(1 / 3 : ℝ)) * max 1 (Real.log (1 / ε)) ∧
      ∃ (S : Type) (_ : MeasurableSpace S) (μ : Measure S), IsProbabilityMeasure μ ∧
      ∃ alg : (n d : ℕ) → BiAlgorithm n d S,
        ∀ n d : ℕ, 1 ≤ n → 1 ≤ d → ∀ A : Matrix (Fin n) (Fin d) ℝ,
          μ {s | vnorm (runOutput (alg n d) A s T) = 1 ∧
              schattenPow p (residual A (runOutput (alg n d) A s T))
                ≤ (1 + ε) * optError p A} ≥ 99 / 100 := by
  sorry

end TCSChallenge.KrylovMethodsAreNearly.node_06
