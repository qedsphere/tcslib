/-!
## Krylov lower bound for adaptive matrix–vector query algorithms (spectral rank one)

Let `0 < ε < 1/2`, `n ≥ N ε^{-2.01}`, `r = ⌊c₀ log n / √ε⌋`, `k = (n-1)/(r+1)` an integer.
`D` is diagonal with eigenvalue `1+2ε` once and `cos(iπ/r)` with multiplicity `k` for
`i = 0, …, r`; `A = Uᵀ D U` with `U` Haar on `O(n)`. Any adaptive randomized algorithm (seed
independent of `U`) making at most `c₁ log n / √ε` queries `q ↦ A q` and outputting a unit
vector `v` satisfies `Pr[‖A(I - vvᵀ)‖_op ≤ (1+ε) min_{‖u‖=1} ‖A(I-uuᵀ)‖_op] < 2/3`.

Main theorem: `krylov_adaptive_lower_bound`.
-/

namespace TCSChallenge.KrylovMethodsAreNearly.node_04

open MeasureTheory ProbabilityTheory

/-- Euclidean norm `‖x‖₂ = (∑ xᵢ²)^{1/2}` on `ℝⁿ` (written out to avoid the sup norm on
`Fin n → ℝ`). -/
noncomputable def vnorm {n : ℕ} (x : Fin n → ℝ) : ℝ :=
  Real.sqrt (∑ i, x i ^ 2)

/-- Euclidean inner product. -/
def inner2 {n : ℕ} (x y : Fin n → ℝ) : ℝ := ∑ i, x i * y i

/-- "the operator norm is induced by the Euclidean norm": `‖M‖_op = sup_{‖x‖₂=1} ‖Mx‖₂`. -/
noncomputable def opNorm {n : ℕ} (M : Matrix (Fin n) (Fin n) ℝ) : ℝ :=
  sSup ((fun x => vnorm (M.mulVec x)) '' {x | vnorm x = 1})

/-- The rank-one projection residual `A (I - v vᵀ)`. -/
def residual {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (v : Fin n → ℝ) :
    Matrix (Fin n) (Fin n) ℝ :=
  A * (1 - Matrix.vecMulVec v v)

/-- `min_{‖u‖₂=1} ‖A(I - uuᵀ)‖_op`, the optimal spectral rank-one error. -/
noncomputable def optRankOne {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : ℝ :=
  sInf ((fun u => opNorm (residual A u)) '' {u | vnorm u = 1})

/-- The hard spectrum: index `0` carries `1 + 2ε`; index `m ≥ 1` carries `cos(iπ/r)` with
`i = ⌊(m-1)/k⌋`, so each `cos(iπ/r)`, `i = 0, …, r`, has multiplicity `k` when
`n - 1 = k (r+1)` (natural-number division). -/
noncomputable def hardSpectrum (n r k : ℕ) (ε : ℝ) (m : Fin n) : ℝ :=
  if m.val = 0 then 1 + 2 * ε
  else Real.cos (((((m.val - 1) / k : ℕ) : ℝ)) * Real.pi / r)

/-- The diagonal matrix `D`. -/
noncomputable def hardD (n r k : ℕ) (ε : ℝ) : Matrix (Fin n) (Fin n) ℝ :=
  Matrix.diagonal (hardSpectrum n r k ε)

/-- A transcript is the list of (query, reply) pairs. -/
abbrev Transcript (n : ℕ) := List ((Fin n → ℝ) × (Fin n → ℝ))

/-- An adaptive algorithm with seed space `S`: the next query is any function of the seed and
the transcript so far; the output is any function of the seed and the full transcript. -/
structure QueryAlgorithm (n : ℕ) (S : Type) where
  query : S → Transcript n → (Fin n → ℝ)
  output : S → Transcript n → (Fin n → ℝ)

/-- The transcript after `j` adaptive queries to the oracle `q ↦ A q`. -/
def runTranscript {n : ℕ} {S : Type} (alg : QueryAlgorithm n S)
    (A : Matrix (Fin n) (Fin n) ℝ) (s : S) : ℕ → Transcript n
  | 0 => []
  | j + 1 =>
      let t := runTranscript alg A s j
      let q := alg.query s t
      t ++ [(q, A.mulVec q)]

/-- The output vector after `K` queries. -/
def runOutput {n : ℕ} {S : Type} (alg : QueryAlgorithm n S)
    (A : Matrix (Fin n) (Fin n) ℝ) (s : S) (K : ℕ) : Fin n → ℝ :=
  alg.output s (runTranscript alg A s K)

/-- `U` (as a random array) is Haar-distributed on `O(n)`: measurable, orthogonal, and its law
is invariant under left multiplication by every fixed orthogonal matrix. -/
def IsHaarOrthogonal {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω) {n : ℕ}
    (U : Ω → Fin n → Fin n → ℝ) : Prop :=
  Measurable U ∧ (∀ ω, Matrix.of (U ω) ∈ Matrix.orthogonalGroup (Fin n) ℝ) ∧
    ∀ Q ∈ Matrix.orthogonalGroup (Fin n) ℝ,
      P.map (fun ω i j => (Q * Matrix.of (U ω)) i j) = P.map U

/-- The block Krylov span `span{Dˡ gⱼ : 1 ≤ j ≤ r, 0 ≤ ℓ ≤ r}`. -/
def krylovSpan {n s r : ℕ} (D : Matrix (Fin n) (Fin n) ℝ) (g : Fin s → Fin n → ℝ) :
    Submodule ℝ (Fin n → ℝ) :=
  Submodule.span ℝ (Set.range fun p : Fin s × Fin (r + 1) => (D ^ p.2.val).mulVec (g p.1))

/-! ## Rubric lemma stubs -/

/-- **(1) Polynomial growth.** Every polynomial of degree `≤ r` satisfies
`|f(1+2ε)| ≤ e^{2r√ε} max_i |f(cos(iπ/r))|`. [KrylovMethodsAreNearly, node_04] -/
theorem poly_growth_cosine_grid (r : ℕ) (hr : 1 ≤ r) (ε : ℝ) (hε : 0 < ε)
    (f : Polynomial ℝ) (hf : f.natDegree ≤ r) (M : ℝ)
    (hM : ∀ i : ℕ, i ≤ r → |f.eval (Real.cos (i * Real.pi / r))| ≤ M) :
    |f.eval (1 + 2 * ε)| ≤ Real.exp (2 * r * Real.sqrt ε) * M := by
  sorry

/-- **(2) Uniform random-span bound.** For `r` independent standard Gaussian vectors, with
probability at least `0.9`, every unit vector of the Krylov span of `D` has squared alignment
`< ε/100` with `e₁` (stated for the parameter regime of the main theorem with the constant
`c₀` and threshold `N` to be found). [KrylovMethodsAreNearly, node_04] -/
theorem uniform_random_span_bound :
    ∃ c₀ : ℝ, 0 < c₀ ∧ ∃ N : ℝ, 1 ≤ N ∧
      ∀ ε : ℝ, 0 < ε → ε < 1 / 2 → ∀ n : ℕ, N * ε ^ (-(2.01 : ℝ)) ≤ n →
        let r := ⌊c₀ * Real.log n / Real.sqrt ε⌋₊
        ∀ k : ℕ, n - 1 = k * (r + 1) →
          ∀ hn : 0 < n,
          (Measure.pi (fun _ : Fin r => Measure.pi (fun _ : Fin n => gaussianReal 0 1)))
            {g | ∀ x ∈ krylovSpan (r := r) (hardD n r k ε) g, vnorm x = 1 →
                (x ⟨0, hn⟩) ^ 2 < ε / 100} ≥ 9 / 10 := by
  sorry

/-- **(5a) Optimal error is 1.** For any orthogonal `U`, `min_u ‖UᵀDU(I-uuᵀ)‖_op = 1`. [KrylovMethodsAreNearly, node_04] -/
theorem optRankOne_hard_eq_one (n r k : ℕ) (hr : 1 ≤ r) (hk : 1 ≤ k)
    (hnk : n - 1 = k * (r + 1)) (ε : ℝ) (hε : 0 < ε)
    (U : Matrix (Fin n) (Fin n) ℝ) (hU : U ∈ Matrix.orthogonalGroup (Fin n) ℝ) :
    optRankOne (U.transpose * hardD n r k ε * U) = 1 := by
  sorry

/-- **(5b) Success forces alignment.** If a unit `v` satisfies
`‖A(I-vvᵀ)‖_op ≤ (1+ε)` for `A = UᵀDU`, then `(Uv)₁² ≥ ε/(1+2ε) > ε/2`. [KrylovMethodsAreNearly, node_04] -/
theorem success_forces_alignment (n r k : ℕ) (hn : 0 < n) (ε : ℝ) (hε : 0 < ε)
    (U : Matrix (Fin n) (Fin n) ℝ) (hU : U ∈ Matrix.orthogonalGroup (Fin n) ℝ)
    (v : Fin n → ℝ) (hv : vnorm v = 1)
    (hsucc : opNorm (residual (U.transpose * hardD n r k ε * U) v) ≤ 1 + ε) :
    ε / (1 + 2 * ε) ≤ (U.mulVec v ⟨0, hn⟩) ^ 2 := by
  sorry

/-! ## Main theorem -/

/-- **Challenge.** There are absolute constants `c₀, c₁ > 0`, `N ≥ 1` such that, in the stated
parameter regime, `r ≥ 2`, and every adaptive randomized algorithm (seed independent of the
Haar matrix `U`) making `K ≤ c₁ log n/√ε` queries to `q ↦ A q`, `A = UᵀDU`, and outputting a
unit vector, succeeds in `(1+ε)`-approximate spectral rank-one approximation with probability
`< 2/3`. [KrylovMethodsAreNearly, node_04] -/
theorem krylov_adaptive_lower_bound :
    ∃ c₀ c₁ : ℝ, 0 < c₀ ∧ 0 < c₁ ∧ ∃ N : ℝ, 1 ≤ N ∧
      ∀ ε : ℝ, 0 < ε → ε < 1 / 2 → ∀ n : ℕ, N * ε ^ (-(2.01 : ℝ)) ≤ n →
        let r := ⌊c₀ * Real.log n / Real.sqrt ε⌋₊
        2 ≤ r ∧
        ∀ k : ℕ, n - 1 = k * (r + 1) →
        ∀ (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
          (U : Ω → Fin n → Fin n → ℝ), IsHaarOrthogonal P U →
        ∀ (S : Type) [MeasurableSpace S] (seed : Ω → S), Measurable seed →
          IndepFun U seed P →
        ∀ (alg : QueryAlgorithm n S), (∀ s t, vnorm (alg.output s t) = 1) →
        ∀ K : ℕ, (K : ℝ) ≤ c₁ * Real.log n / Real.sqrt ε →
          P {ω | let A := (Matrix.of (U ω)).transpose * hardD n r k ε * Matrix.of (U ω)
                 opNorm (residual A (runOutput alg A (seed ω) K))
                   ≤ (1 + ε) * optRankOne A} < 2 / 3 := by
  sorry

end TCSChallenge.KrylovMethodsAreNearly.node_04
