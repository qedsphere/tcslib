/-!
## Block Krylov spaces with `r = s = ⌊c log n/√ε⌋` fail for spectral rank-one approximation

There are absolute constants `c ∈ (0,1)`, `C > 0` such that for `0 < ε < 1/2` and
`n ≥ C ε^{-2.01}` some distribution `𝒟` on symmetric `n × n` matrices has the property: with
`s = r = ⌊c log n/√ε⌋`, `A ∼ 𝒟` and independent uniform unit vectors `q₁, …, q_s`, with
probability `≥ 9/10`, every `v ∈ 𝒦_r(A; q₁, …, q_s)` (no normalization) satisfies
`‖A(I - vvᵀ)‖_op > (1+ε) min_{‖u‖=1} ‖A(I - uuᵀ)‖_op`.

Main theorem: `exists_hard_distribution_block_krylov`.
-/

namespace TCSChallenge.KrylovMethodsAreNearly.node_17

open MeasureTheory ProbabilityTheory

/-- Euclidean norm `‖x‖₂ = (∑ xᵢ²)^{1/2}` on `ℝⁿ` (written out to avoid the sup norm on
`Fin n → ℝ`). -/
noncomputable def vnorm {n : ℕ} (x : Fin n → ℝ) : ℝ :=
  Real.sqrt (∑ i, x i ^ 2)

/-- Euclidean inner product. -/
def inner2 {n : ℕ} (x y : Fin n → ℝ) : ℝ := ∑ i, x i * y i

/-- "the operator norm is induced by the Euclidean norm": `‖M‖_op = sup_{‖x‖₂=1} ‖Mx‖₂`. -/
noncomputable def opNorm {n : ℕ} (M : Matrix (Fin n) (Fin n) ℝ) : ℝ :=
  sSup ((fun x => vnorm (M.mulVec x)) '' {x | vnorm x = 1})

/-- The rank-one projection residual `A (I - v vᵀ)`. -/
def residual {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (v : Fin n → ℝ) :
    Matrix (Fin n) (Fin n) ℝ :=
  A * (1 - Matrix.vecMulVec v v)

/-- `min_{‖u‖₂=1} ‖A(I - uuᵀ)‖_op`, the optimal spectral rank-one error. -/
noncomputable def optRankOne {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) : ℝ :=
  sInf ((fun u => opNorm (residual A u)) '' {u | vnorm u = 1})

/-- `𝒦_r(A; q₁, …, q_s) = span{Aˡ qⱼ : 0 ≤ ℓ ≤ r, 1 ≤ j ≤ s}`. -/
def blockKrylov {n s : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (q : Fin s → Fin n → ℝ) (r : ℕ) :
    Submodule ℝ (Fin n → ℝ) :=
  Submodule.span ℝ (Set.range fun p : Fin s × Fin (r + 1) => (A ^ p.2.val).mulVec (q p.1))

/-- Standard Gaussian measure `N(0, I_n)` on `ℝⁿ`: the product of TCSlib's
`standardGaussianMeasure` (`= N(0,1)`) over the coordinates. -/
noncomputable abbrev stdGaussian (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi fun _ : Fin n => BooleanAnalysis.ThresholdFunctions.standardGaussianMeasure

/-- Uniform measure on the unit sphere of `ℝⁿ`, as the law of `g/‖g‖₂`, `g ∼ N(0, I_n)`. -/
noncomputable def sphereUniform (n : ℕ) : Measure (Fin n → ℝ) :=
  (stdGaussian n).map (fun g => (vnorm g)⁻¹ • g)

/-! ## Rubric lemma stubs -/

/-- **(2) Discrete polynomial growth.** Every polynomial of degree `≤ d` satisfies
`|f(1+2ε)| ≤ e^{2d√ε} max_{0≤i≤d} |f(cos(iπ/d))|`. [KrylovMethodsAreNearly, node_17] -/
theorem poly_growth_cosine_grid (d : ℕ) (hd : 1 ≤ d) (ε : ℝ) (hε : 0 < ε)
    (f : Polynomial ℝ) (hf : f.natDegree ≤ d) (M : ℝ)
    (hM : ∀ i : ℕ, i ≤ d → |f.eval (Real.cos (i * Real.pi / d))| ≤ M) :
    |f.eval (1 + 2 * ε)| ≤ Real.exp (2 * d * Real.sqrt ε) * M := by
  sorry

/-- **(6a) Optimal error is 1.** If `A` is symmetric, has a unit eigenvector `u⋆` of
eigenvalue `1 + 2ε`, a unit eigenvector `e` of eigenvalue `1`, and `‖Ax‖₂ ≤ ‖x‖₂` for
`x ⊥ u⋆`, then `min_u ‖A(I - uuᵀ)‖_op = 1`. [KrylovMethodsAreNearly, node_17] -/
theorem optRankOne_eq_one {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (hA : A.IsSymm)
    (ε : ℝ) (hε : 0 < ε) (ustar e : Fin n → ℝ) (hu : vnorm ustar = 1) (he : vnorm e = 1)
    (hAu : A.mulVec ustar = (1 + 2 * ε) • ustar) (hAe : A.mulVec e = e)
    (hbulk : ∀ x, inner2 x ustar = 0 → vnorm (A.mulVec x) ≤ vnorm x) :
    optRankOne A = 1 := by
  sorry

/-- **(6b) Alignment ⇒ strict failure for every (non-normalized) vector of a subspace.** If
`A` has unit eigenvector `u⋆` with eigenvalue `1+2ε`, `0 < ε < 1/2`, and every unit `z ∈ W`
has `⟨z, u⋆⟩² ≤ ε/100`, then every `v ∈ W` has `‖A(I - vvᵀ)‖_op > 1 + ε`. [KrylovMethodsAreNearly, node_17] -/
theorem residual_gt_of_small_alignment {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ)
    (hA : A.IsSymm) (ε : ℝ) (hε : 0 < ε) (hε' : ε < 1 / 2) (ustar : Fin n → ℝ)
    (hu : vnorm ustar = 1) (hAu : A.mulVec ustar = (1 + 2 * ε) • ustar)
    (W : Submodule ℝ (Fin n → ℝ))
    (hW : ∀ z ∈ W, vnorm z = 1 → inner2 z ustar ^ 2 ≤ ε / 100) :
    ∀ v ∈ W, 1 + ε < opNorm (residual A v) := by
  sorry

/-! ## Main theorem -/

/-- **Challenge.** Absolute constants `c ∈ (0,1)`, `C > 0` exist such that for `0 < ε < 1/2`
and `n ≥ C ε^{-2.01}` there is a probability distribution `𝒟` on symmetric `n × n` matrices
for which, with `s = r = ⌊c log n/√ε⌋` and `q₁, …, q_s` i.i.d. uniform on the sphere
independent of `A ∼ 𝒟`, with probability `≥ 9/10` every `v ∈ 𝒦_r(A; q)` has
`‖A(I - vvᵀ)‖_op > (1+ε) min_{‖u‖=1} ‖A(I - uuᵀ)‖_op`. [KrylovMethodsAreNearly, node_17] -/
theorem exists_hard_distribution_block_krylov :
    ∃ c C : ℝ, 0 < c ∧ c < 1 ∧ 0 < C ∧
      ∀ ε : ℝ, 0 < ε → ε < 1 / 2 → ∀ n : ℕ, C * ε ^ (-(2.01 : ℝ)) ≤ n →
        let r := ⌊c * Real.log n / Real.sqrt ε⌋₊
        ∃ 𝒟 : Measure (Fin n → Fin n → ℝ), IsProbabilityMeasure 𝒟 ∧
          (∀ᵐ A ∂𝒟, (Matrix.of A).IsSymm) ∧
          (𝒟.prod (Measure.pi (fun _ : Fin r => sphereUniform n)))
            {Aq | ∀ v ∈ blockKrylov (Matrix.of Aq.1) Aq.2 r,
                (1 + ε) * optRankOne (Matrix.of Aq.1)
                  < opNorm (residual (Matrix.of Aq.1) v)} ≥ 9 / 10 := by
  sorry

end TCSChallenge.KrylovMethodsAreNearly.node_17
