/-!
## Restoring a cut disk preserves linkage-equivalence

The proof that Planar Disjoint Paths is solvable in time `2^{O(k^2)} n^{O(1)}` cuts the plane
graph `F` open along a tree `T` containing the terminals. Each vertex `v ∈ Y = V(T) ∩ V(F)` is
replaced by one boundary copy per sector, producing a disk graph `K` whose boundary is the set
`B` of copies. The disk replacement gives a graph `L` that is `B`-linkage-equivalent to `K`.
Gluing every class `B_v` of copies back into `v` turns `K` into `F` and `L` into `F*`.

The main theorem `glue_linkageEquiv` says that the two glued graphs are `Y`-linkage-equivalent.
In the reference proof this is the singleton-blocking argument. The fact that the glued `K`
equals the original `F` is a property of the cutting construction and is not formalized.

We model a graph with labeled vertex set `Z` as a simple graph `G` on a vertex type `V`
together with an injective labeling `ι : Z → V`. Gluing along `g : B → Y` sends a boundary
vertex `ι b` to `Sum.inl (g b)` and an interior vertex `v` to `Sum.inr v`. Loops are deleted and
parallel edges merged, as in the paper.
-/

namespace TCSChallenge.PlanarDisjointPathsTreewidth.node_06

open SimpleGraph

/-- "a finite list `(a_1,b_1),...,(a_r,b_r)` of pairs from `Z` such that the sets `{a_i,b_i}`
are pairwise disjoint. Here `a_i = b_i` is permitted." -/
def IsRequest {Z : Type*} {r : ℕ} (a b : Fin r → Z) : Prop :=
  ∀ i j : Fin r, i ≠ j → a i ≠ a j ∧ a i ≠ b j ∧ b i ≠ a j ∧ b i ≠ b j

/-- "`H` contains mutually vertex-disjoint `a_i`–`b_i` paths" (a path may have length zero),
for a graph `H` on `V` whose labeled vertices are given by `ι : Z → V`. -/
def Linked {V Z : Type*} (H : SimpleGraph V) (ι : Z → V) {r : ℕ} (a b : Fin r → Z) : Prop :=
  ∃ P : (i : Fin r) → H.Walk (ι (a i)) (ι (b i)),
    (∀ i, (P i).IsPath) ∧
    ∀ i j : Fin r, i ≠ j → ∀ v : V, v ∈ (P i).support → v ∉ (P j).support

/-- "`H` and `H'` are `Z`-linkage-equivalent if for every request on `Z`, `H` contains mutually
vertex-disjoint `a_i`–`b_i` paths if and only if `H'` does." -/
def LinkageEquiv {V V' Z : Type*} (H : SimpleGraph V) (ι : Z → V)
    (H' : SimpleGraph V') (ι' : Z → V') : Prop :=
  ∀ (r : ℕ) (a b : Fin r → Z), IsRequest a b → (Linked H ι a b ↔ Linked H' ι' a b)

/-- Vertex map of the gluing: boundary copy `ι b` goes to the restored vertex `g b ∈ Y`;
an interior vertex `v` stays as `Sum.inr v`. (For injective `ι` the choice of `b` is
irrelevant.) -/
noncomputable def gluePi {V B Y : Type*} (ι : B → V) (g : B → Y) (v : V) : Y ⊕ V := by
  classical
  exact if h : ∃ b, ι b = v then Sum.inl (g (Classical.choose h)) else Sum.inr v

/-- "Restore the gluing by identifying all vertices of `B_v` into `v`, for every `v ∈ Y` ...
Delete any resulting loops and retain only one edge from each parallel class."
Here `B_v = g ⁻¹' {v}`. -/
noncomputable def glue {V B Y : Type*} (K : SimpleGraph V) (ι : B → V) (g : B → Y) :
    SimpleGraph (Y ⊕ V) :=
  SimpleGraph.fromRel fun x y => ∃ u w : V, K.Adj u w ∧ gluePi ι g u = x ∧ gluePi ι g w = y

/-- Linkage-equivalence is symmetric (used for "the argument is symmetric in `K` and `L`"). [PlanarDisjointPathsTreewidth, node_06] -/
theorem linkageEquiv_symm {V V' Z : Type*} (H : SimpleGraph V) (ι : Z → V)
    (H' : SimpleGraph V') (ι' : Z → V') (h : LinkageEquiv H ι H' ι') :
    LinkageEquiv H' ι' H ι := by
  sorry

/-- "`F` and `F*` are `Y`-linkage-equivalent, and hence also `X`-linkage-equivalent":
restricting the labeled set along an injection `X → Y` preserves linkage-equivalence. [PlanarDisjointPathsTreewidth, node_06] -/
theorem linkageEquiv_restrict {V V' Y X : Type*} (H : SimpleGraph V) (ι : Y → V)
    (H' : SimpleGraph V') (ι' : Y → V') (e : X → Y) (he : Function.Injective e)
    (h : LinkageEquiv H ι H' ι') :
    LinkageEquiv H (ι ∘ e) H' (ι' ∘ e) := by
  sorry

/-- Lifting step with singleton blocking. If the glued `K` realizes a request on `Y`, there is
a request on the boundary `B` (the endpoints of the lifted pieces, the lifted trivial paths, and
a blocking singleton for every unused copy) that is realized in `K`. Moreover, any realization
of it in a graph `L` with
the same boundary and gluing map glues back to a realization of the original request.
This is the collision analysis of the reference proof. [PlanarDisjointPathsTreewidth, node_06] -/
theorem lift_with_blocking {VK VL B Y : Type*}
    (K : SimpleGraph VK) (ιK : B → VK) (hιK : Function.Injective ιK)
    (L : SimpleGraph VL) (ιL : B → VL) (hιL : Function.Injective ιL)
    (g : B → Y) (hg : Function.Surjective g)
    {r : ℕ} (a b : Fin r → Y) (hreq : IsRequest a b)
    (hK : Linked (glue K ιK g) Sum.inl a b) :
    ∃ (s : ℕ) (a' b' : Fin s → B), IsRequest a' b' ∧
      Linked K ιK a' b' ∧
      (Linked L ιL a' b' → Linked (glue L ιL g) Sum.inl a b) := by
  sorry

/-- **Main theorem (correctness under identification).** Let `K` and `L` be graphs with the
same labeled boundary `B`, and let them be `B`-linkage-equivalent. Let `g : B → Y` be the
surjective map sending each boundary copy to the vertex it was cut from. Then the glued graphs
(`F` and `F*` in the paper) are `Y`-linkage-equivalent. [PlanarDisjointPathsTreewidth, node_06] -/
theorem glue_linkageEquiv {VK VL B Y : Type*}
    (K : SimpleGraph VK) (ιK : B → VK) (hιK : Function.Injective ιK)
    (L : SimpleGraph VL) (ιL : B → VL) (hιL : Function.Injective ιL)
    (g : B → Y) (hg : Function.Surjective g)
    (hKL : LinkageEquiv K ιK L ιL) :
    LinkageEquiv (glue K ιK g) Sum.inl (glue L ιL g) Sum.inl := by
  sorry

/-- **Running-time arithmetic (rubric item 5).** With `q ≤ 2k` terminals, treewidth bound
`w = 2^{a(k+1)}`, and a reduced instance of at most `C q^12 (w+6)^12` vertices, Schrijver's
bound `m^{Ap+B}` with `p ≤ k` pairs is `2^{O(k^2)}`, uniformly in `k ≥ 1`. [PlanarDisjointPathsTreewidth, node_06] -/
theorem schrijver_on_kernel_bound (a A B C : ℕ) :
    ∃ c : ℕ, ∀ k p : ℕ, 1 ≤ k → p ≤ k →
      (C * (2 * k) ^ 12 * (2 ^ (a * (k + 1)) + 6) ^ 12) ^ (A * p + B) ≤ 2 ^ (c * k ^ 2) := by
  sorry

end TCSChallenge.PlanarDisjointPathsTreewidth.node_06
