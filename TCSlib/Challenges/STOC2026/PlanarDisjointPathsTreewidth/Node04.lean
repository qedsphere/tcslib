/-!
## Polynomial linkage-equivalent kernels for planar graphs of bounded treewidth

Let `G` be a finite planar graph with a labeled terminal set `X` of size `k ≥ 1`
and treewidth `w ≥ 1`. A *linkage request* on `X` is a list of pairs of terminals
such that no terminal occurs in two different pairs (entries of one pair may
coincide). It is realizable if the pairs can be joined by pairwise vertex-disjoint
paths. Two graphs carrying the same labeled set are linkage-equivalent if they
realize the same requests.

Main theorem `exists_small_linkage_equivalent_planar`: there is a planar graph
`G'` on `O(k¹² w¹²)` vertices, containing the labeled terminals, that is
`X`-linkage-equivalent to `G`.

Lemma stubs: transitivity of linkage-equivalence, monotonicity of the treewidth
bound under subgraphs (safe deletions), and the embedding-free *restoration
compatibility* claim: if a graph is obtained from `H` by identifying some copies
of interface vertices, then replacing `H` by any interface-linkage-equivalent
`H'` and performing the same identifications preserves linkage-equivalence on
the terminals (this is where the occupancy argument with length-zero requests
lives).
-/

namespace TCSChallenge.PlanarDisjointPathsTreewidth.node_04

open SimpleGraph

/-! ### Linkage requests -/

/-- "A linkage request on `B` is a collection of pairs of vertices of `B` such that
no vertex occurs in two different pairs. The entries of a pair may coincide."
Labels live in an index type `ι`; listing the same pair twice is excluded too. -/
def IsRequest {ι : Type} (R : List (ι × ι)) : Prop :=
  R.Pairwise (fun p q => p.1 ≠ q.1 ∧ p.1 ≠ q.2 ∧ p.2 ≠ q.1 ∧ p.2 ≠ q.2)

/-- "A request is realizable if its pairs can be joined by pairwise vertex-disjoint
paths; a pair `(v,v)` is realized by the length-zero path at `v`. Paths may pass
through designated vertices that are not endpoints of requested pairs."
The labeling `ℓ : ι → V` places the designated set in `G`. (A closed walk that is a
path is the length-zero path, so `(v,v)` occupies exactly `v`.) -/
def Realizes {V ι : Type} (G : SimpleGraph V) (ℓ : ι → V) (R : List (ι × ι)) : Prop :=
  ∃ P : (j : Fin R.length) → G.Walk (ℓ (R.get j).1) (ℓ (R.get j).2),
    (∀ j, (P j).IsPath) ∧
    ∀ j j', j ≠ j' → ∀ v, v ∈ (P j).support → v ∉ (P j').support

/-- "Two graphs containing the same labeled set `B` are `B`-linkage-equivalent if
they realize exactly the same requests on `B`." -/
def LinkageEquiv {V V' ι : Type} (G : SimpleGraph V) (ℓ : ι → V)
    (G' : SimpleGraph V') (ℓ' : ι → V') : Prop :=
  ∀ R : List (ι × ι), IsRequest R → (Realizes G ℓ R ↔ Realizes G' ℓ' R)

/-! ### Planarity (via Wagner's theorem) and treewidth -/

/-- `H` is a minor of `G`: disjoint connected nonempty branch sets, with an edge of
`G` between the branch sets of every edge of `H`. -/
def HasMinor {V U : Type} (G : SimpleGraph V) (H : SimpleGraph U) : Prop :=
  ∃ br : U → Set V,
    (∀ u, (G.induce (br u)).Connected) ∧
    (∀ u u', u ≠ u' → Disjoint (br u) (br u')) ∧
    (∀ u u', H.Adj u u' → ∃ x ∈ br u, ∃ y ∈ br u', G.Adj x y)

/-- Planarity of a finite graph, stated through Wagner's theorem: no `K₅` minor and
no `K₃,₃` minor (Mathlib has no plane embeddings). -/
def IsPlanar {V : Type} (G : SimpleGraph V) : Prop :=
  ¬ HasMinor G (⊤ : SimpleGraph (Fin 5)) ∧
  ¬ HasMinor G (completeBipartiteGraph (Fin 3) (Fin 3))

/-- A tree decomposition of `G` indexed by a tree `T` on `Fin m` with bags `bag`. -/
def IsTreeDecomp {V : Type} (G : SimpleGraph V) (m : ℕ) (T : SimpleGraph (Fin m))
    (bag : Fin m → Finset V) : Prop :=
  T.IsTree ∧
  (∀ v, ∃ t, v ∈ bag t) ∧
  (∀ u v, G.Adj u v → ∃ t, u ∈ bag t ∧ v ∈ bag t) ∧
  (∀ v, (T.induce {t | v ∈ bag t}).Connected)

/-- `tw(G) ≤ w`: some tree decomposition has all bags of size at most `w + 1`. -/
def TreewidthAtMost {V : Type} (G : SimpleGraph V) (w : ℕ) : Prop :=
  ∃ (m : ℕ) (T : SimpleGraph (Fin m)) (bag : Fin m → Finset V),
    IsTreeDecomp G m T bag ∧ ∀ t, (bag t).card ≤ w + 1

/-! ### Identification of interface copies (cutting / restoration) -/

/-- The graph on `V` obtained from `H` on `W` by identifying vertices along
`π : W → V` (loops created by the identification are discarded). -/
def quotientGraph {W V : Type} (H : SimpleGraph W) (π : W → V) : SimpleGraph V :=
  SimpleGraph.fromRel (fun u v => ∃ a b, π a = u ∧ π b = v ∧ H.Adj a b)

/-- `π` only identifies interface vertices: two distinct vertices of `W` with the
same image are both in the range of the interface labeling `ι`. -/
def IdentifiesOnlyInterface {W V β : Type} (π : W → V) (ι : β → W) : Prop :=
  ∀ a a', π a = π a' → a = a' ∨ ((∃ b, ι b = a) ∧ (∃ b', ι b' = a'))

/-! ### Lemma stubs -/

/-- Linkage-equivalence is transitive (used to chain safe deletions and the final
replacement). [PlanarDisjointPathsTreewidth, node_04] -/
theorem linkageEquiv_trans {V₁ V₂ V₃ ι : Type}
    (G₁ : SimpleGraph V₁) (ℓ₁ : ι → V₁) (G₂ : SimpleGraph V₂) (ℓ₂ : ι → V₂)
    (G₃ : SimpleGraph V₃) (ℓ₃ : ι → V₃)
    (h₁₂ : LinkageEquiv G₁ ℓ₁ G₂ ℓ₂) (h₂₃ : LinkageEquiv G₂ ℓ₂ G₃ ℓ₃) :
    LinkageEquiv G₁ ℓ₁ G₃ ℓ₃ := by sorry

/-- Treewidth does not increase under edge deletion (more generally, passing to a
spanning subgraph), so safe deletions keep the bound `tw ≤ w`. [PlanarDisjointPathsTreewidth, node_04] -/
theorem treewidthAtMost_mono {V : Type} (G H : SimpleGraph V) (w : ℕ)
    (hHG : H ≤ G) (hG : TreewidthAtMost G w) : TreewidthAtMost H w := by sorry

/-- Restoration compatibility. `H` (on `W`) and `H'` (on `W'`) share the labeled
interface `β` (via `ι`, `ι'`). The graphs `G = H/π` and `G' = H'/π'` arise by
identifying interface copies in exactly the same pattern, and nothing else is
identified. The terminals are images of interface labels `σ i`. If `H` and `H'`
are `β`-linkage-equivalent, then `G` and `G'` are linkage-equivalent on the
terminals. (Proof idea: split paths into maximal pieces, request their endpoints on
`β` and add a length-zero request at every unused copy as an occupancy constraint.) [PlanarDisjointPathsTreewidth, node_04] -/
theorem restoration_compatible {W W' V V' β : Type} {k : ℕ}
    (H : SimpleGraph W) (ι : β → W) (π : W → V)
    (H' : SimpleGraph W') (ι' : β → W') (π' : W' → V')
    (hι : Function.Injective ι) (hι' : Function.Injective ι')
    (hπ : IdentifiesOnlyInterface π ι) (hπ' : IdentifiesOnlyInterface π' ι')
    (hpat : ∀ b b', π (ι b) = π (ι b') ↔ π' (ι' b) = π' (ι' b'))
    (σ : Fin k → β) (hσ : Function.Injective (fun i => π (ι (σ i))))
    (hH : LinkageEquiv H ι H' ι') :
    LinkageEquiv (quotientGraph H π) (fun i => π (ι (σ i)))
      (quotientGraph H' π') (fun i => π' (ι' (σ i))) := by sorry

/-! ### Main theorem -/

/-- **Main theorem.** There is an absolute constant `C` such that every finite planar
graph `G` with an injectively labeled terminal set `X` of size `k ≥ 1` and treewidth
at most `w` (`w ≥ 1`) has an `X`-linkage-equivalent planar graph `G'` on at most
`C · k¹² · w¹²` vertices containing the same labeled terminals. (The paper's bound
is stated for `w = tw(G)`; since it is monotone in `w`, any `w ≥ tw(G)` is
equivalent.) The polynomial running time of the construction is not captured. [PlanarDisjointPathsTreewidth, node_04] -/
theorem exists_small_linkage_equivalent_planar :
    ∃ C : ℕ, ∀ (Vt : Type) [Fintype Vt] [DecidableEq Vt] (G : SimpleGraph Vt)
      (k w : ℕ) (X : Fin k → Vt),
      1 ≤ k → 1 ≤ w → Function.Injective X →
      IsPlanar G → TreewidthAtMost G w →
      ∃ (N : ℕ) (G' : SimpleGraph (Fin N)) (X' : Fin k → Fin N),
        N ≤ C * k ^ 12 * w ^ 12 ∧ IsPlanar G' ∧ Function.Injective X' ∧
        LinkageEquiv G X G' X' := by sorry

end TCSChallenge.PlanarDisjointPathsTreewidth.node_04
