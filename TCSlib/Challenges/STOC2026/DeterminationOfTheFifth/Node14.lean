/-!
## Cyclers and Translated Cyclers from two matching transcript blocks

A deterministic Turing machine with bi-infinite tape `ℤ`, state set `Q`, alphabet `A` and
partial transition `δ : Q → A → Option (A × Dir × Q)` halts when `δ` is undefined on the
current (state, scanned symbol). Let `F(t) = (h(t), f(t, g(t)))` be the head label at time `t`.

If the two consecutive length-`l` transcripts starting at `t₀` and `t₀' = t₀ + l` agree and
`d = g(t₀') - g(t₀)`, then:
* if `d = 0` the machine is a Cycler (`cycler_of_zero_displacement`);
* if `d ≥ 0` and the right rays of the tapes at `t₀`, `t₀'` (anchored at the heads) agree,
  the run is a loop with per-block displacement `d` (`translatedCycler_of_rightRay`);
* if `d ≤ 0` and the left rays agree, likewise (`translatedCycler_of_leftRay`).
In all cases the period is `l`, the pre-period `t₀`, and `M` does not halt.

The hypotheses only compare *head labels* during two finite blocks and *one half* of the tapes
at `t₀`, `t₀'`; full configuration equality is never assumed.
-/

namespace TCSChallenge.DeterminationOfTheFifth.node_14

/-- Head moves `{L, R}`. -/
inductive Dir where
  | L
  | R

/-- Displacement of a head move: `L ↦ -1`, `R ↦ +1`. -/
def Dir.toInt : Dir → ℤ
  | Dir.L => -1
  | Dir.R => 1

/-- "partial transition function δ : 𝒬 × 𝒜 ⇀ 𝒜 × {L,R} × 𝒬". -/
abbrev Machine (Q A : Type) : Type := Q → A → Option (A × Dir × Q)

/-- A configuration: state, head position in `ℤ`, and tape contents `ℤ → A`. -/
structure Config (Q A : Type) where
  state : Q
  head : ℤ
  tape : ℤ → A

variable {Q A : Type}

/-- One transition: write, move, change state; `none` when `δ` is undefined (the machine halts). -/
def step (M : Machine Q A) (c : Config Q A) : Option (Config Q A) :=
  match M c.state (c.tape c.head) with
  | none => none
  | some (a, D, q) => some ⟨q, c.head + D.toInt, Function.update c.tape c.head a⟩

/-- The configuration at time `t` (`none` if the machine halted before time `t`). -/
def run (M : Machine Q A) (c₀ : Config Q A) : ℕ → Option (Config Q A)
  | 0 => some c₀
  | t + 1 => (run M c₀ t).bind (step M)

/-- `F_M(t, g(t)) = (h(t), f(t, g(t)))`, the head label at time `t` (if the configuration exists). -/
def label (M : Machine Q A) (c₀ : Config Q A) (t : ℕ) : Option (Q × A) :=
  (run M c₀ t).map fun c => (c.state, c.tape c.head)

/-- `g(t)`, the head position at time `t` (if the configuration exists). -/
def headAt (M : Machine Q A) (c₀ : Config Q A) (t : ℕ) : Option ℤ :=
  (run M c₀ t).map Config.head

/-- Two consecutive length-`l` head transcripts starting at `t` and `t + l` agree:
"`F_M(p_i) = F_M(p'_i)` for `0 ≤ i < l`", where all these configurations exist. -/
def Window (M : Machine Q A) (c₀ : Config Q A) (t l : ℕ) : Prop :=
  ∀ i : ℕ, i < l →
    (∃ c, run M c₀ (t + l + i) = some c) ∧ label M c₀ (t + i) = label M c₀ (t + l + i)

/-- Right-ray agreement anchored at the heads: `f(t, g(t)+z) = f(t', g(t')+z)` for all `z ∈ ℕ₀`. -/
def RightRay (M : Machine Q A) (c₀ : Config Q A) (t t' : ℕ) : Prop :=
  ∃ C C' : Config Q A, run M c₀ t = some C ∧ run M c₀ t' = some C' ∧
    ∀ z : ℕ, C.tape (C.head + (z : ℤ)) = C'.tape (C'.head + (z : ℤ))

/-- Left-ray agreement anchored at the heads: `f(t, g(t)-z) = f(t', g(t')-z)` for all `z ∈ ℕ₀`. -/
def LeftRay (M : Machine Q A) (c₀ : Config Q A) (t t' : ℕ) : Prop :=
  ∃ C C' : Config Q A, run M c₀ t = some C ∧ run M c₀ t' = some C' ∧
    ∀ z : ℕ, C.tape (C.head - (z : ℤ)) = C'.tape (C'.head - (z : ℤ))

/-- "A loop of period `l` and pre-period `t₀`" whose period blocks are displaced by `d`:
all future configurations exist, `F_M(t₀+nl+i, g(t₀+nl+i)) = F_M(t₀+i, g(t₀+i))` for all
`n` and `0 ≤ i < l`, and each period block is the previous one shifted by `d`. -/
def IsTranslatedLoop (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ) (d : ℤ) : Prop :=
  (∀ t : ℕ, ∃ c, run M c₀ t = some c) ∧
  (∀ n i : ℕ, i < l → label M c₀ (t₀ + n * l + i) = label M c₀ (t₀ + i)) ∧
  (∀ n i : ℕ, i < l →
    headAt M c₀ (t₀ + (n + 1) * l + i) = (headAt M c₀ (t₀ + n * l + i)).map (· + d))

/-- A loop of period `l` and pre-period `t₀` (transcript periodicity plus existence of all
future configurations). -/
def IsLoop (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ) : Prop :=
  (∀ t : ℕ, ∃ c, run M c₀ t = some c) ∧
  (∀ n i : ℕ, i < l → label M c₀ (t₀ + n * l + i) = label M c₀ (t₀ + i))

/-- A Cycler: a loop whose period blocks have displacement `0`. -/
def IsCycler (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ) : Prop :=
  IsTranslatedLoop M c₀ t₀ l 0

/-- The machine halts: some reachable configuration has an undefined transition. -/
def Halts (M : Machine Q A) (c₀ : Config Q A) : Prop :=
  ∃ (t : ℕ) (c : Config Q A), run M c₀ t = some c ∧ M c.state (c.tape c.head) = none

/-! ## Lemma stubs (subgoals of the strategy) -/

/-- Synchronize the head traces: matched labels force identical writes and moves, so the
transition after the last matched pair exists, `g(t₀'+i) = g(t₀+i) + d` for `0 ≤ i ≤ l`
(in particular `g(t*) = g(t₀') + d` with `t* = t₀ + 2l`), and `h(t*) = h(t₀')`. [DeterminationOfTheFifth, node_14] -/
theorem sync_heads (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ) (hl : 1 ≤ l)
    (hW : Window M c₀ t₀ l) (C C' : Config Q A)
    (hC : run M c₀ t₀ = some C) (hC' : run M c₀ (t₀ + l) = some C') :
    (∃ c, run M c₀ (t₀ + 2 * l) = some c) ∧
    (∀ i : ℕ, i ≤ l →
      headAt M c₀ (t₀ + l + i) = (headAt M c₀ (t₀ + i)).map (· + (C'.head - C.head))) ∧
    (run M c₀ (t₀ + 2 * l)).map Config.state = (run M c₀ (t₀ + l)).map Config.state := by
  sorry

/-- Endpoint closure, `d = 0`: the next head cell was visited at the start of the second block,
so the last-visit comparison gives `F_M(p*) = F_M(p'_0)`. [DeterminationOfTheFifth, node_14] -/
theorem endpoint_closure_zero (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ) (hl : 1 ≤ l)
    (hW : Window M c₀ t₀ l) (C C' : Config Q A)
    (hC : run M c₀ t₀ = some C) (hC' : run M c₀ (t₀ + l) = some C')
    (hd : C'.head = C.head) :
    label M c₀ (t₀ + 2 * l) = label M c₀ (t₀ + l) := by
  sorry

/-- Endpoint closure, `d ≥ 0` with right-ray agreement: visited cells are handled by paired
last visits, an untouched frontier cell by the right-ray hypothesis at offset `z = d`. [DeterminationOfTheFifth, node_14] -/
theorem endpoint_closure_right (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ) (hl : 1 ≤ l)
    (hW : Window M c₀ t₀ l) (C C' : Config Q A)
    (hC : run M c₀ t₀ = some C) (hC' : run M c₀ (t₀ + l) = some C')
    (hd : C.head ≤ C'.head)
    (hray : ∀ z : ℕ, C.tape (C.head + (z : ℤ)) = C'.tape (C'.head + (z : ℤ))) :
    label M c₀ (t₀ + 2 * l) = label M c₀ (t₀ + l) := by
  sorry

/-- Endpoint closure, `d ≤ 0` with left-ray agreement (mirror image, offset `z = -d`). [DeterminationOfTheFifth, node_14] -/
theorem endpoint_closure_left (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ) (hl : 1 ≤ l)
    (hW : Window M c₀ t₀ l) (C C' : Config Q A)
    (hC : run M c₀ t₀ = some C) (hC' : run M c₀ (t₀ + l) = some C')
    (hd : C'.head ≤ C.head)
    (hray : ∀ z : ℕ, C.tape (C.head - (z : ℤ)) = C'.tape (C'.head - (z : ℤ))) :
    label M c₀ (t₀ + 2 * l) = label M c₀ (t₀ + l) := by
  sorry

/-- Preservation of right-ray agreement under one paired transition: a right move stays inside
the compared ray; a left move exposes one new cell, whose equality is exactly the next
transcript equality. [DeterminationOfTheFifth, node_14] -/
theorem rightRay_step (M : Machine Q A) (c₀ : Config Q A) (t t' : ℕ)
    (hR : RightRay M c₀ t t') (hlab : label M c₀ t = label M c₀ t')
    (hex : ∃ c, run M c₀ (t' + 1) = some c)
    (hlab' : label M c₀ (t + 1) = label M c₀ (t' + 1)) :
    RightRay M c₀ (t + 1) (t' + 1) := by
  sorry

/-- Preservation of left-ray agreement under one paired transition (mirror image). [DeterminationOfTheFifth, node_14] -/
theorem leftRay_step (M : Machine Q A) (c₀ : Config Q A) (t t' : ℕ)
    (hL : LeftRay M c₀ t t') (hlab : label M c₀ t = label M c₀ t')
    (hex : ∃ c, run M c₀ (t' + 1) = some c)
    (hlab' : label M c₀ (t + 1) = label M c₀ (t' + 1)) :
    LeftRay M c₀ (t + 1) (t' + 1) := by
  sorry

/-- Rolling window: the `l - 1` overlapping equalities plus the closed endpoint give the next
window. [DeterminationOfTheFifth, node_14] -/
theorem window_shift (M : Machine Q A) (c₀ : Config Q A) (t l : ℕ) (hl : 1 ≤ l)
    (hW : Window M c₀ t l) (hex : ∃ c, run M c₀ (t + 2 * l) = some c)
    (hend : label M c₀ (t + 2 * l) = label M c₀ (t + l)) :
    Window M c₀ (t + 1) l := by
  sorry

/-- Classification: transcript equality between every time `t₀ + n` and `t₀ + l + n`, together
with the per-step head relation `g(t₀+l+n) = g(t₀+n) + d`, yields a translated loop of period
`l`, pre-period `t₀`, displacement `d`. [DeterminationOfTheFifth, node_14] -/
theorem translatedLoop_of_forall (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ) (d : ℤ)
    (hall : ∀ n : ℕ, (∃ c, run M c₀ (t₀ + l + n) = some c) ∧
      label M c₀ (t₀ + n) = label M c₀ (t₀ + l + n) ∧
      headAt M c₀ (t₀ + l + n) = (headAt M c₀ (t₀ + n)).map (· + d)) :
    IsTranslatedLoop M c₀ t₀ l d := by
  sorry

/-- Existence of all future configurations rules out halting. [DeterminationOfTheFifth, node_14] -/
theorem not_halts_of_forall_run (M : Machine Q A) (c₀ : Config Q A)
    (hall : ∀ t : ℕ, ∃ c, run M c₀ t = some c) : ¬ Halts M c₀ := by
  sorry

/-! ## Main theorems -/

/-- `d = 0`: the machine is a Cycler with period `l` and pre-period `t₀`, and does not halt. [DeterminationOfTheFifth, node_14] -/
theorem cycler_of_zero_displacement (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ)
    (hl : 1 ≤ l) (hW : Window M c₀ t₀ l) (C C' : Config Q A)
    (hC : run M c₀ t₀ = some C) (hC' : run M c₀ (t₀ + l) = some C')
    (hd : C'.head = C.head) :
    IsCycler M c₀ t₀ l ∧ ¬ Halts M c₀ := by
  sorry

/-- `d ≥ 0` with right-ray agreement `f(t₀, g(t₀)+z) = f(t₀', g(t₀')+z)`: the run is a loop of
period `l`, pre-period `t₀`, with every period block displaced by `d = g(t₀') - g(t₀)` (a positive
Translated Cycler when `d > 0`), and `M` does not halt. [DeterminationOfTheFifth, node_14] -/
theorem translatedCycler_of_rightRay (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ)
    (hl : 1 ≤ l) (hW : Window M c₀ t₀ l) (C C' : Config Q A)
    (hC : run M c₀ t₀ = some C) (hC' : run M c₀ (t₀ + l) = some C')
    (hd : C.head ≤ C'.head)
    (hray : ∀ z : ℕ, C.tape (C.head + (z : ℤ)) = C'.tape (C'.head + (z : ℤ))) :
    IsLoop M c₀ t₀ l ∧ IsTranslatedLoop M c₀ t₀ l (C'.head - C.head) ∧ ¬ Halts M c₀ := by
  sorry

/-- `d ≤ 0` with left-ray agreement `f(t₀, g(t₀)-z) = f(t₀', g(t₀')-z)`: the run is a loop of
period `l`, pre-period `t₀`, with every period block displaced by `d = g(t₀') - g(t₀)` (a negative
Translated Cycler when `d < 0`), and `M` does not halt. [DeterminationOfTheFifth, node_14] -/
theorem translatedCycler_of_leftRay (M : Machine Q A) (c₀ : Config Q A) (t₀ l : ℕ)
    (hl : 1 ≤ l) (hW : Window M c₀ t₀ l) (C C' : Config Q A)
    (hC : run M c₀ t₀ = some C) (hC' : run M c₀ (t₀ + l) = some C')
    (hd : C'.head ≤ C.head)
    (hray : ∀ z : ℕ, C.tape (C.head - (z : ℤ)) = C'.tape (C'.head - (z : ℤ))) :
    IsLoop M c₀ t₀ l ∧ IsTranslatedLoop M c₀ t₀ l (C'.head - C.head) ∧ ¬ Halts M c₀ := by
  sorry

