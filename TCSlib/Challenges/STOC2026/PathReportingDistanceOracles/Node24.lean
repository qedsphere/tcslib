/-!
## Interactive spanners of size `n + O(h(n/t))` with stretch `O(αt)`

Assume every `m`-vertex weighted graph has an `α`-spanner with at most `h(m)` edges
(`HasSpanners α h`), and the supplied cluster-partition fact (`ClusterPartitionFact c`):
every connected weighted `N`-vertex graph and `1 ≤ s ≤ N` admit a partition into at most
`N/s` parts, each with a spanning tree `T_C ⊆ K[C]` of hop-diameter `≤ c s` that is an MST
of the multigraph obtained by collapsing `(V ∖ C) ∪ {r_C}` to `r_C`. The challenge
`main_theorem`: for every `t ≥ 1` and `n`-vertex `G`, there is a parent array `par : V → V`
(cluster forest of height `O(t)`) and an edge set `S` with `|S| ≤ C h(n/t)` such that the
graph `F` on edges `{v, par v}` and `S` has at most `n + C h(n/t)` edges and contains, for
every connected `u, v`, a simple path of weight `≤ C α t · d_G(u,v)`.
-/

namespace TCSChallenge.PathReportingDistanceOracles.node_24

/-- Weight of a walk: the sum of `w` over its darts (oriented edges). -/
def walkWeight {V : Type} {G : SimpleGraph V} (w : V → V → ℝ) {u v : V}
    (p : G.Walk u v) : ℝ :=
  (p.darts.map fun d => w d.fst d.snd).sum

/-- Shortest-path distance `d_G(u,v)` = infimum of walk weights. For unreachable pairs the
infimum over an empty type is `0` in Lean; it is only used for reachable pairs. -/
def wdist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (u v : V) : ℝ :=
  ⨅ p : G.Walk u v, walkWeight w p

/-- "finite nonnegative edge weights": `w` is symmetric and nonnegative. -/
def IsWeighting {V : Type} (w : V → V → ℝ) : Prop :=
  ∀ x y, 0 ≤ w x y ∧ w x y = w y x

/-- Number of edges of a simple graph (as `Set.ncard` of its edge set). -/
def edgeCount {V : Type} (H : SimpleGraph V) : ℕ := H.edgeSet.ncard

/-- "Every m-vertex graph with nonnegative edge weights admits an interactive α-spanner of
size at most h(m)", used through its edge set: a subgraph `F ≤ K` with `≤ h(m)` edges that
contains, for every connected pair, a simple path of weight `≤ α d_K`. -/
def HasSpanners (α : ℝ) (h : ℕ → ℕ) : Prop :=
  ∀ (m : ℕ) (K : SimpleGraph (Fin m)) (w : Fin m → Fin m → ℝ), IsWeighting w →
    ∃ F : SimpleGraph (Fin m), F ≤ K ∧ edgeCount F ≤ h m ∧
      ∀ u v, K.Reachable u v →
        ∃ p : F.Walk u v, p.IsPath ∧ walkWeight w p ≤ α * wdist K w u v

/-- `h(x) = h(max{1, ⌊x⌋})` for real `x > 0`. -/
def hReal (h : ℕ → ℕ) (x : ℝ) : ℕ := h (max 1 ⌊x⌋₊)

/-- Collapsing map for the part with root `r`: vertices of the part (other than `r`) stay,
everything else (`(V ∖ C) ∪ {r_C}`) is identified with `r`. Parts are fibres of `root`. -/
def collapse {W : Type} (root : W → W) (r z : W) : W :=
  if root z = r then z else r

/-- MST condition for the tree `T` of the part with root `r`, in cycle-property form (which
characterises minimum spanning trees of the collapsed multigraph, loops discarded): for every
edge `xy` of `K` whose collapsed endpoints `a ≠ b` differ, every edge of the `T`-path from
`a` to `b` weighs at most `w(x,y)`. -/
def MSTCond {W : Type} (K : SimpleGraph W) (w : W → W → ℝ) (root : W → W)
    (T : SimpleGraph W) (r : W) : Prop :=
  ∀ x y, K.Adj x y → collapse root r x ≠ collapse root r y →
    ∀ p : T.Walk (collapse root r x) (collapse root r y), p.IsPath →
      ∀ d ∈ p.darts, w d.fst d.snd ≤ w x y

/-- Properties of the tree `T` of the part `C = {z | root z = r}` (with `root r = r`):
`T ⊆ K[C]`, acyclic and spanning `C`, every simple path has at most `L` edges, and the MST
condition holds. -/
def ClusterTree {W : Type} (K : SimpleGraph W) (w : W → W → ℝ) (root : W → W)
    (T : SimpleGraph W) (r : W) (L : ℝ) : Prop :=
  T ≤ K ∧ (∀ x y, T.Adj x y → root x = r ∧ root y = r) ∧ T.IsAcyclic ∧
  (∀ x y, root x = r → root y = r → T.Reachable x y) ∧
  (∀ x y (p : T.Walk x y), p.IsPath → (p.length : ℝ) ≤ L) ∧
  MSTCond K w root T r

/-- The supplied structural fact with absolute constant `c`. A partition is given by
`root : W → W` (each part is a fibre, `root` is idempotent so `r_C ∈ C`), and `T r` is the
tree of the part with root `r`. -/
def ClusterPartitionFact (c : ℝ) : Prop :=
  ∀ (W : Type) [Fintype W] [DecidableEq W] (K : SimpleGraph W) (w : W → W → ℝ),
    IsWeighting w → K.Connected → ∀ s : ℝ, 1 ≤ s → s ≤ Fintype.card W →
      ∃ (root : W → W) (T : W → SimpleGraph W),
        (∀ z, root (root z) = root z) ∧
        ((Finset.univ.image root).card : ℝ) ≤ Fintype.card W / s ∧
        ∀ r, root r = r → ClusterTree K w root (T r) r (c * s)

/-- Edge set represented by a parent array: `{v, par v}` for every non-root `v`. -/
def parentEdges {V : Type} (par : V → V) : Set (Sym2 V) :=
  {e | ∃ v, par v ≠ v ∧ e = Sym2.mk (v, par v)}

/-- The spanner support `F`: parent-array edges together with the extra edges `S`. -/
def supportGraph {V : Type} (par : V → V) (S : Set (Sym2 V)) : SimpleGraph V :=
  SimpleGraph.fromEdgeSet (parentEdges par ∪ S)

/-! ## Lemma stubs (rubric items) -/

/-- Rubric 3, first consequence: if a walk `R` from `x` to `y` stays inside the part with
root `r`, every edge of the tree path from `x` to `y` weighs at most `w(R)`. [PathReportingDistanceOracles, node_24] -/
theorem tree_edges_le_inside_walk {W : Type} (K : SimpleGraph W) (w : W → W → ℝ)
    (hw : IsWeighting w) (root : W → W) (T : SimpleGraph W) (r : W) (L : ℝ)
    (hroot : root r = r) (hT : ClusterTree K w root T r L) {x y : W} (R : K.Walk x y)
    (hR : ∀ z ∈ R.support, root z = r) (p : T.Walk x y) (hp : p.IsPath) :
    ∀ d ∈ p.darts, w d.fst d.snd ≤ walkWeight w R := by
  sorry

/-- Rubric 3, endpoint consequence: if a walk `R` starts at `u` in the part with root `r`
and later leaves it, every edge of the tree path from `u` to `r` weighs at most `w(R)`. [PathReportingDistanceOracles, node_24] -/
theorem tree_edges_le_leaving_walk {W : Type} (K : SimpleGraph W) (w : W → W → ℝ)
    (hw : IsWeighting w) (root : W → W) (T : SimpleGraph W) (r : W) (L : ℝ)
    (hroot : root r = r) (hT : ClusterTree K w root T r L) {u y : W} (R : K.Walk u y)
    (hu : root u = r) (hleave : ∃ z ∈ R.support, root z ≠ r)
    (p : T.Walk u r) (hp : p.IsPath) :
    ∀ d ∈ p.darts, w d.fst d.snd ≤ walkWeight w R := by
  sorry

/-- Rubric 5 (boundary case): a minimum spanning tree of a small connected component is a
valid inactive cluster: the cycle-property tree of the whole component satisfies the MST
condition with `root` constantly `r` (nothing is collapsed). [PathReportingDistanceOracles, node_24] -/
theorem mst_is_cluster_tree {W : Type} [Fintype W] [DecidableEq W] (K : SimpleGraph W)
    (w : W → W → ℝ) (hw : IsWeighting w) (hK : K.Connected) (r : W) :
    ∃ T : SimpleGraph W,
      ClusterTree K w (fun _ => r) T r ((Fintype.card W : ℝ) - 1) := by
  sorry

/-! ## Main theorem -/

/-- Main theorem: for every `t ≥ 1` and every `n`-vertex weighted graph, a spanner whose
support is a parent array of height `O(t)` plus `O(h(n/t))` extra edges, with at most
`n + O(h(n/t))` edges and stretch `O(α t)` realised by simple paths. `C` depends only on the
absolute constant `c` of the supplied fact. [PathReportingDistanceOracles, node_24] -/
theorem main_theorem (c : ℝ) (hc : 0 < c) (hfact : ClusterPartitionFact c) :
    ∃ C : ℝ, 0 < C ∧
      ∀ (α : ℝ) (h : ℕ → ℕ), 1 ≤ α → Monotone h → (∀ m, m ≤ h m) → HasSpanners α h →
        ∀ (V : Type) [Fintype V] [DecidableEq V] (G : SimpleGraph V) (w : V → V → ℝ),
          IsWeighting w → ∀ t : ℝ, 1 ≤ t →
            ∃ (par : V → V) (S : Set (Sym2 V)),
              (∀ v, par v ≠ v → G.Adj v (par v)) ∧
              (∀ v, ∃ i : ℕ, (i : ℝ) ≤ C * t ∧ par (par^[i] v) = par^[i] v) ∧
              S ⊆ G.edgeSet ∧
              (S.ncard : ℝ) ≤ C * hReal h (Fintype.card V / t) ∧
              (edgeCount (supportGraph par S) : ℝ) ≤
                Fintype.card V + C * hReal h (Fintype.card V / t) ∧
              ∀ u v, G.Reachable u v →
                ∃ p : (supportGraph par S).Walk u v,
                  p.IsPath ∧ walkWeight w p ≤ C * α * t * wdist G w u v := by
  sorry

end TCSChallenge.PathReportingDistanceOracles.node_24
