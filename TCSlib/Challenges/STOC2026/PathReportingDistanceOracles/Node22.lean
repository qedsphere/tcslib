/-!
## Compression of interactive spanners by shallow weight-dominated clusters

Assume a black box that gives, on every weighted graph with `m ≥ 1` vertices, a spanner of
stretch `α` with at most `h(m)` edges (`h` nondecreasing). Then for every real `t ≥ 1` every
`n`-vertex weighted graph has a spanner of stretch `O(α t)` with `O(h(n/t) + n)` edges, where
`h(z) = h(max{1, ⌊z⌋})`.

Main theorem: `spanner_compression`.
-/

namespace TCSChallenge.PathReportingDistanceOracles.node_22

/-- Weights are nonnegative and symmetric. -/
def WeightOK {V : Type} (w : V → V → ℝ) : Prop :=
  ∀ u v, 0 ≤ w u v ∧ w u v = w v u

/-- Weight `w(P)` of a walk (edges counted with multiplicity). -/
def walkW {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) {u v : V} (p : G.Walk u v) : ℝ :=
  (p.darts.map (fun d => w d.fst d.snd)).sum

/-- Fixed edge set `S ⊆ E` of an interactive spanner of stretch `β`: for every connected pair
`u, v` there is a path `P ⊆ S` with `w(P) ≤ β d_G(u,v)`. Stated distance-free: for every walk
`p` from `u` to `v`, some walk inside `S` has weight at most `β w(p)` (equivalent, since a
shortest walk exists; the lower bound `d_G ≤ w(P)` is automatic for a walk of `G`). -/
def IsSpannerFor {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (S : Finset (Sym2 V))
    (β : ℝ) : Prop :=
  (∀ e ∈ S, e ∈ G.edgeSet) ∧
    ∀ (u v : V) (p : G.Walk u v), ∃ q : G.Walk u v,
      (∀ e ∈ q.edges, e ∈ S) ∧ walkW G w q ≤ β * walkW G w p

/-- The black box: "on every weighted graph with `m ≥ 1` vertices, an interactive spanner of
stretch `α` … and size at most `h(m)`". Graphs on `m` vertices are taken on `Fin m`. -/
def BlackBox (α : ℝ) (h : ℕ → ℝ) : Prop :=
  ∀ m : ℕ, 1 ≤ m → ∀ (H : SimpleGraph (Fin m)) (w : Fin m → Fin m → ℝ), WeightOK w →
    ∃ S : Finset (Sym2 (Fin m)), (S.card : ℝ) ≤ h m ∧ IsSpannerFor H w S α

/-- `a` is an ancestor of `x` (including `x` itself) in the parent-pointer forest. -/
def IsAnc {V : Type} (parent : V → V) (a x : V) : Prop :=
  ∃ j : ℕ, parent^[j] x = a

/-- The tree edge `(a, parent a)` lies on the tree path `T_C[x,y]`: `a` is a non-root that is an
ancestor of exactly one of `x`, `y`. -/
def OnTreePath {V : Type} (parent : V → V) (a x y : V) : Prop :=
  parent a ≠ a ∧ Xor' (IsAnc parent a x) (IsAnc parent a y)

/-- Weight of the tree path `T_C[x,y]`. -/
def treePathW {V : Type} [Fintype V] (w : V → V → ℝ) (parent : V → V) (x y : V) : ℝ :=
  ∑ a ∈ Finset.univ.filter (fun a => OnTreePath parent a x y), w a (parent a)

/-- Weight of the root path `T_C[x, r_C]`. -/
def rootPathW {V : Type} (w : V → V → ℝ) (parent : V → V) (depth : V → ℕ) (x : V) : ℝ :=
  ∑ j ∈ Finset.range (depth x), w (parent^[j] x) (parent^[j + 1] x)

/-- The supplied partition structure, encoded by an idempotent root map (clusters are fibres,
`r_C = root v`), parent pointers of the rooted spanning trees `T_C`, and depths:
at most `max{1, ⌊N/t⌋}` clusters, root paths with at most `c t` edges, the internal-edge
property ("every edge of `T_C[x,y]` has weight at most `w(xy)`") and the external-edge property
("every edge of `T_C[x,r_C]` has weight at most `w(xy)`"). -/
def IsStretchPartition {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
    (t c : ℝ) (root parent : V → V) (depth : V → ℕ) : Prop :=
  (∀ v, root (root v) = root v) ∧
  ((Finset.univ.filter (fun v => root v = v)).card ≤
      max 1 ⌊(Fintype.card V : ℝ) / t⌋₊) ∧
  (∀ v, parent v = v ↔ root v = v) ∧
  (∀ v, root (parent v) = root v) ∧
  (∀ v, parent v ≠ v → G.Adj v (parent v) ∧ depth v = depth (parent v) + 1) ∧
  (∀ v, parent^[depth v] v = root v) ∧
  (∀ v, (depth v : ℝ) ≤ c * t) ∧
  (∀ x y, G.Adj x y → root x = root y → ∀ a, OnTreePath parent a x y →
      w a (parent a) ≤ w x y) ∧
  (∀ x y, G.Adj x y → root x ≠ root y → ∀ j, j < depth x →
      w (parent^[j] x) (parent^[j + 1] x) ≤ w x y)

/-! ## Lemma stubs (rubric items) -/

/-- The supplied structural fact (with an explicit absolute constant `c` for `O(t)`). [PathReportingDistanceOracles, node_22] -/
theorem partition_exists :
    ∃ c : ℝ, 0 < c ∧ ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W)
      (w : W → W → ℝ), G.Connected → WeightOK w → ∀ t : ℝ, 1 ≤ t →
      ∃ (root parent : W → W) (depth : W → ℕ), IsStretchPartition G w t c root parent depth := by
  sorry

/-- Local witness claim: if a walk stays inside one cluster, the tree path between its
endpoints weighs at most `2 c t` times the walk. [PathReportingDistanceOracles, node_22] -/
theorem treePath_local_witness {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
    (hw : WeightOK w) (t c : ℝ) (root parent : V → V) (depth : V → ℕ)
    (hP : IsStretchPartition G w t c root parent depth) {x y : V} (p : G.Walk x y)
    (hin : ∀ z ∈ p.support, root z = root x) :
    treePathW w parent x y ≤ 2 * c * t * walkW G w p := by
  sorry

/-- Terminal piece: if a walk from `u` leaves the cluster of `u`, the root path from `u`
weighs at most `3 c t` times the walk (prefix before the first exit plus the exit edge). [PathReportingDistanceOracles, node_22] -/
theorem rootPath_exit_bound {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
    (hw : WeightOK w) (t c : ℝ) (root parent : V → V) (depth : V → ℕ)
    (hP : IsStretchPartition G w t c root parent depth) {u v : V} (p : G.Walk u v)
    (hleave : ∃ z ∈ p.support, root z ≠ root u) :
    rootPathW w parent depth u ≤ 3 * c * t * walkW G w p := by
  sorry

/-! ## Main theorem -/

/-- Compression theorem: stretch `O(α t)` and size `O(h(n/t) + n)`, with
`h(n/t) = h(max{1, ⌊n/t⌋})`. [PathReportingDistanceOracles, node_22] -/
theorem spanner_compression :
    ∃ K : ℝ, 0 < K ∧ ∀ (α : ℝ) (h : ℕ → ℝ), 1 ≤ α → Monotone h → BlackBox α h →
      ∀ t : ℝ, 1 ≤ t →
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) (w : W → W → ℝ),
        WeightOK w →
        ∃ S : Finset (Sym2 W),
          (S.card : ℝ) ≤ K * (h (max 1 ⌊(Fintype.card W : ℝ) / t⌋₊) + (Fintype.card W : ℝ)) ∧
          IsSpannerFor G w S (K * α * t) := by
  sorry

