/-!
## Universal hopset with sparse shared support and a demand preserver

Let `G = (V, E, w)` be a connected graph with nonnegative symmetric weights, `k ≥ 3`,
`0 < ε ≤ C₀ log k`, and `γ_{4/3}(ε, k) = (C log k / ε)^{⌈log_{4/3} k⌉}`.
There is one shortcut set `H` with `|H| = O(n^{1+1/k})` and one original-edge support `S`
with `|S| = O(n^{1+1/k} + n log k)` containing an exact shortest path for every shortcut,
such that for every admissible `ε` the set `H` is a `(1+ε, γ_{4/3}(ε,k))`-hopset
(universality), and for every demand set `𝒫` the support extends to an edge set of size
`O(|𝒫| γ_{4/3}(ε,k) + n log k + n^{1+1/k})` containing a `(1+ε)`-approximate path for every
demand pair.

Main theorem: `universal_hopset_and_preserver`.
-/

namespace TCSChallenge.PathReportingDistanceOracles.node_13

/-- Weights are nonnegative and symmetric ("undirected graph with nonnegative edge weights"). -/
def WeightOK {V : Type} (w : V → V → ℝ) : Prop :=
  ∀ u v, 0 ≤ w u v ∧ w u v = w v u

/-- Weight `w(P)` of a walk: sum of the weights of its edges (with multiplicity). -/
def walkW {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) {u v : V} (p : G.Walk u v) : ℝ :=
  (p.darts.map (fun d => w d.fst d.snd)).sum

/-- Shortest-path distance `d_G(u,v)`: infimum of walk weights (for connected `G` the set is
nonempty and bounded below by `0`). -/
def gDist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (u v : V) : ℝ :=
  sInf {r : ℝ | ∃ p : G.Walk u v, walkW G w p = r}

/-- `(a,b)` is a shortcut of `H` (shortcuts are unordered: either orientation is stored). -/
def IsShortcut {V : Type} (H : Finset (V × V)) (a b : V) : Prop :=
  (a, b) ∈ H ∨ (b, a) ∈ H

/-- A path in `G ∪ H` with `m` hops given by its vertex sequence: every step is a graph edge
or a shortcut. -/
def AugValid {V : Type} (G : SimpleGraph V) (H : Finset (V × V)) {m : ℕ}
    (p : Fin (m + 1) → V) : Prop :=
  ∀ i : Fin m, G.Adj (p i.castSucc) (p i.succ) ∨ IsShortcut H (p i.castSucc) (p i.succ)

/-- Weight of a path in `G ∪ H`: "A shortcut is a vertex pair `(u,v)` of weight `d_G(u,v)`";
graph edges carry their weight `w`. -/
def augW {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (H : Finset (V × V)) {m : ℕ}
    (p : Fin (m + 1) → V) : ℝ :=
  ∑ i : Fin m,
    if IsShortcut H (p i.castSucc) (p i.succ) then gDist G w (p i.castSucc) (p i.succ)
    else w (p i.castSucc) (p i.succ)

/-- "A set `H` of shortcuts is a `(1+ε, β)`-hopset if every vertex pair has a path in `G ∪ H`
using at most `β` edges and of weight at most `(1+ε)` times its distance in `G`." -/
def IsHopset {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (H : Finset (V × V))
    (ε β : ℝ) : Prop :=
  ∀ x y : V, ∃ m : ℕ, ∃ p : Fin (m + 1) → V,
    p 0 = x ∧ p (Fin.last m) = y ∧ AugValid G H p ∧ (m : ℝ) ≤ β ∧
      augW G w H p ≤ (1 + ε) * gDist G w x y

/-- "A support for `H` is an original-edge set containing an exact shortest path for every
shortcut." -/
def IsSupport {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (H : Finset (V × V))
    (S : Finset (Sym2 V)) : Prop :=
  (∀ e ∈ S, e ∈ G.edgeSet) ∧
    ∀ ab ∈ H, ∃ q : G.Walk ab.1 ab.2, (∀ e ∈ q.edges, e ∈ S) ∧
      walkW G w q = gDist G w ab.1 ab.2

/-- `γ_{4/3}(ε,k) = (C log k / ε)^{⌈log_{4/3} k⌉}`. -/
def gamma43 (C ε : ℝ) (k : ℕ) : ℝ :=
  (C * Real.log k / ε) ^ (⌈Real.logb (4 / 3) k⌉₊)

/-- Original edges used by an augmented path (the non-shortcut steps). -/
def origEdges {V : Type} (H : Finset (V × V)) {m : ℕ} (p : Fin (m + 1) → V) :
    Finset (Sym2 V) :=
  (Finset.univ.filter (fun i : Fin m => ¬ IsShortcut H (p i.castSucc) (p i.succ))).image
    (fun i => Sym2.mk (p i.castSucc, p i.succ))

/-! ## Lemma stubs (rubric items) -/

/-- Half-bunch intersection charge, geometric core: if the shortest paths of a half-bunch pair
`{u,v}` and of a longer half-bunch pair `{y,z}` (with `d(y,z) < ½ d(y, A_{i+1})`) share a vertex
`x`, then `d(y,u), d(y,v) ≤ 2 d(y,z) < d(y, A_{i+1})`, so `u, v, z ∈ B_i(y)`. Stated for any
symmetric function obeying the triangle inequality. [PathReportingDistanceOracles, node_13] -/
theorem halfBunch_triangle {V : Type} (d : V → V → ℝ)
    (hsymm : ∀ a b, d a b = d b a) (htri : ∀ a b c, d a c ≤ d a b + d b c)
    (u v y z x : V) (Dy : ℝ)
    (hxuv : d u x + d x v = d u v) (hxyz : d y x + d x z = d y z)
    (hnonneg : ∀ a b, 0 ≤ d a b)
    (hlonger : d u v ≤ d y z) (hbunch : d y z < Dy / 2) :
    d y u ≤ 2 * d y z ∧ d y v ≤ 2 * d y z ∧ d y u < Dy ∧ d y v < Dy := by
  sorry

/-- Sampling schedule `q_i = ½ n^{-(4/3)^i/(3k)}`, `Q_i = ∏_{j<i} q_j`:
`Q_i = 2^{-i} n^{-((4/3)^i - 1)/k}` and `n Q_i / q_i^3 = 8 · 2^{-i} n^{1+1/k}`. [PathReportingDistanceOracles, node_13] -/
theorem schedule_closed_form (n : ℝ) (hn : 1 ≤ n) (k : ℕ) (hk : 1 ≤ k) (i : ℕ) :
    let q : ℕ → ℝ := fun j => (1 / 2) * n ^ (-((4 / 3 : ℝ) ^ j / (3 * k)))
    let Q : ℕ → ℝ := fun i => ∏ j ∈ Finset.range i, q j
    Q i = (1 / 2 : ℝ) ^ i * n ^ (-(((4 / 3 : ℝ) ^ i - 1) / k)) ∧
      n * Q i / q i ^ 3 = 8 * (1 / 2 : ℝ) ^ i * n ^ (1 + 1 / (k : ℝ)) := by
  sorry

/-- Terminal level: with `L = ⌈log_{4/3} k⌉ + 1`, `n Q_{L-1} ≤ 2^{-(L-1)} n^{1/k}`, and the
terminal fourth-moment cost `n^{4/k}` is `≤ n^{1+1/k}` because `k ≥ 3`. [PathReportingDistanceOracles, node_13] -/
theorem terminal_level_bound (n : ℝ) (hn : 1 ≤ n) (k : ℕ) (hk : 3 ≤ k) :
    let q : ℕ → ℝ := fun j => (1 / 2) * n ^ (-((4 / 3 : ℝ) ^ j / (3 * k)))
    let Q : ℕ → ℝ := fun i => ∏ j ∈ Finset.range i, q j
    let L : ℕ := ⌈Real.logb (4 / 3) k⌉₊ + 1
    n * Q (L - 1) ≤ (1 / 2 : ℝ) ^ (L - 1) * n ^ (1 / (k : ℝ)) ∧
      n ^ (4 / (k : ℝ)) ≤ n ^ (1 + 1 / (k : ℝ)) := by
  sorry

/-- Exact expansion: replacing every shortcut of a valid augmented path by its exact
shortest path in the support yields a walk of `G` inside `S ∪ (original edges of the path)`
of exactly the same weight. [PathReportingDistanceOracles, node_13] -/
theorem expand_augmented_path {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
    (hw : WeightOK w) (hG : G.Connected) (H : Finset (V × V)) (S : Finset (Sym2 V))
    (hS : IsSupport G w H S) {m : ℕ} (p : Fin (m + 1) → V) (hp : AugValid G H p) :
    ∃ q : G.Walk (p 0) (p (Fin.last m)),
      (∀ e ∈ q.edges, e ∈ S ∪ origEdges H p) ∧ walkW G w q = augW G w H p := by
  sorry

/-! ## Main theorem -/

/-- Universal `(1+ε, γ_{4/3}(ε,k))`-hopset of size `O(n^{1+1/k})` with support of size
`O(n^{1+1/k} + n log k)`, independent of `ε` and of the demands, and the demand preserver of
size `O(|𝒫| γ_{4/3}(ε,k) + n log k + n^{1+1/k})` built on the same support. [PathReportingDistanceOracles, node_13] -/
theorem universal_hopset_and_preserver :
    ∀ C0 : ℝ, 0 < C0 → ∃ C Cs : ℝ, 0 < C ∧ 0 < Cs ∧
      ∀ (W : Type) [Fintype W] [DecidableEq W] (G : SimpleGraph W) (w : W → W → ℝ),
        G.Connected → WeightOK w → ∀ k : ℕ, 3 ≤ k →
        ∃ H : Finset (W × W), ∃ S : Finset (Sym2 W),
          (H.card : ℝ) ≤ Cs * (Fintype.card W : ℝ) ^ (1 + 1 / (k : ℝ)) ∧
          (S.card : ℝ) ≤ Cs * ((Fintype.card W : ℝ) ^ (1 + 1 / (k : ℝ)) +
              (Fintype.card W : ℝ) * Real.log k) ∧
          IsSupport G w H S ∧
          (∀ ε : ℝ, 0 < ε → ε ≤ C0 * Real.log k → IsHopset G w H ε (gamma43 C ε k)) ∧
          (∀ P : Finset (W × W), ∀ ε : ℝ, 0 < ε → ε ≤ C0 * Real.log k →
            ∃ S' : Finset (Sym2 W), S ⊆ S' ∧ (∀ e ∈ S', e ∈ G.edgeSet) ∧
              (S'.card : ℝ) ≤ Cs * ((P.card : ℝ) * gamma43 C ε k +
                (Fintype.card W : ℝ) * Real.log k +
                (Fintype.card W : ℝ) ^ (1 + 1 / (k : ℝ))) ∧
              ∀ xy ∈ P, ∃ q : G.Walk xy.1 xy.2, (∀ e ∈ q.edges, e ∈ S') ∧
                walkW G w q ≤ (1 + ε) * gDist G w xy.1 xy.2) := by
  sorry

