/-!
## Interactive `O(k)`-emulators of size `O(n^{1+1/k})` with constant query overhead

`G = (V, E, w)` is a finite undirected graph with nonnegative weights and shortest-path
distance `d_G` (`wdist G w`). An interactive `α`-emulator is a weighted graph `H` on exactly
`V` with `d_G ≤ d_H ≤ α d_G` on connected pairs, plus an oracle reporting an `H`-path of
weight `≤ α d_G(u,v)`. Using the supplied ultrametric-hierarchy fact
(`UltrametricHierarchyFact A`), the challenge is `main_theorem`: there is an absolute `C`
such that every `G` and `k ≥ 1` admit an emulator `H` with `|E(H)| ≤ C n^{1+1/k}`,
stretch `≤ C k`, and a level-tree oracle (ranks and per-level trees inside `H`) whose record
count `∑_v (r(v)+1)` is `≤ C n^{1+1/k}` and whose answer to `(u,v)` is the path in the tree of
level `min (r u) (r v)`.
-/

namespace TCSChallenge.PathReportingDistanceOracles.node_16

/-- Weight of a walk: the sum of `w` over its darts (oriented edges). -/
def walkWeight {V : Type} {G : SimpleGraph V} (w : V → V → ℝ) {u v : V}
    (p : G.Walk u v) : ℝ :=
  (p.darts.map fun d => w d.fst d.snd).sum

/-- Shortest-path distance `d_G(u,v)` = infimum of walk weights. For unreachable pairs the
infimum over an empty type is `0` in Lean; it is only used for reachable pairs. -/
def wdist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (u v : V) : ℝ :=
  ⨅ p : G.Walk u v, walkWeight w p

/-- "finite nonnegative edge weights": `w` is symmetric and nonnegative. -/
def IsWeighting {V : Type} (w : V → V → ℝ) : Prop :=
  ∀ x y, 0 ≤ w x y ∧ w x y = w y x

/-- A (genuine) metric on a type. -/
def IsMetric {M : Type} (d : M → M → ℝ) : Prop :=
  (∀ x y, 0 ≤ d x y) ∧ (∀ x, d x x = 0) ∧ (∀ x y, x ≠ y → 0 < d x y) ∧
  (∀ x y, d x y = d y x) ∧ (∀ x y z, d x z ≤ d x y + d y z)

/-- "An ultrametric is a metric ρ satisfying ρ(x,z) ≤ max{ρ(x,y), ρ(y,z)}." -/
def IsUltrametric {M : Type} (ρ : M → M → ℝ) : Prop :=
  IsMetric ρ ∧ ∀ x y z, ρ x z ≤ max (ρ x y) (ρ y z)

/-- The supplied metric existence theorem, in the form "some outcome achieves the expected
bound": for every finite metric `(M,d)` with `|M| = m` and every `k ≥ 1` there is a nested
sequence `M = X_0 ⊇ ⋯ ⊇ X_s = ∅` with `∑_{j<s} |X_j| ≤ m^{1+1/k}` and ultrametrics `ρ_j`
with `d ≤ ρ_j` and `ρ_j(x,y) ≤ A k d(x,y)` whenever `y ∈ X_j \ X_{j+1}`. -/
def UltrametricHierarchyFact (A : ℝ) : Prop :=
  ∀ (M : Type) [Fintype M] [DecidableEq M] (d : M → M → ℝ), IsMetric d →
    ∀ k : ℕ, 1 ≤ k →
      ∃ (s : ℕ) (X : ℕ → Finset M) (ρ : ℕ → M → M → ℝ),
        X 0 = Finset.univ ∧ X s = ∅ ∧ (∀ j, j < s → X (j + 1) ⊆ X j) ∧
        ((∑ j ∈ Finset.range s, (X j).card : ℕ) : ℝ) ≤
          (Fintype.card M : ℝ) ^ (1 + 1 / (k : ℝ)) ∧
        ∀ j, j < s →
          IsUltrametric (ρ j) ∧ (∀ x y, d x y ≤ ρ j x y) ∧
          ∀ x y, y ∈ X j → y ∉ X (j + 1) → ρ j x y ≤ A * k * d x y

/-- Number of edges of a simple graph (as `Set.ncard` of its edge set). -/
def edgeCount {V : Type} (H : SimpleGraph V) : ℕ := H.edgeSet.ncard

/-- Emulator core: `H` on vertex set `V` with weights `wH`; every `H`-edge dominates the
original distance, `H` connects only pairs connected in `G`, and `d_H ≤ β d_G` on connected
pairs (via an explicit simple `H`-path of weight `≤ β d_G`). -/
def IsEmulator {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (H : SimpleGraph V)
    (wH : V → V → ℝ) (β : ℝ) : Prop :=
  IsWeighting wH ∧
  (∀ x y, H.Adj x y → G.Reachable x y ∧ wdist G w x y ≤ wH x y) ∧
  (∀ u v, G.Reachable u v →
    ∃ p : H.Walk u v, p.IsPath ∧ walkWeight wH p ≤ β * wdist G w u v)

/-- Sparse level-tree oracle: a rank per vertex (the "last membership index" `r(v)`) and a
tree-forest per level `j`, supported on vertices of rank `≥ j`, contained in `H`. -/
structure LevelTreeOracle (V : Type) where
  rank : V → ℕ
  tree : ℕ → SimpleGraph V

/-- Number of stored per-occurrence records, `∑_v (r(v) + 1)`. -/
def LevelTreeOracle.records {V : Type} [Fintype V] (O : LevelTreeOracle V) : ℕ :=
  ∑ v, (O.rank v + 1)

/-- Validity of the oracle for emulator `H`: the level-`j` tree lies in `H`, is acyclic, and
uses only vertices of rank `≥ j`; on every connected query `(u,v)` the reported simple path
of weight `≤ β d_G(u,v)` uses edges of the tree at level `j = min (r u) (r v)`, except for
at most two zero-weight endpoint edges (zero-distance classes). -/
def LevelTreeOracle.Valid {V : Type} (O : LevelTreeOracle V) (G : SimpleGraph V)
    (w : V → V → ℝ) (H : SimpleGraph V) (wH : V → V → ℝ) (β : ℝ) : Prop :=
  (∀ j, O.tree j ≤ H ∧ (O.tree j).IsAcyclic ∧
      ∀ x y, (O.tree j).Adj x y → j ≤ O.rank x ∧ j ≤ O.rank y) ∧
  ∀ u v, G.Reachable u v →
    ∃ p : H.Walk u v, p.IsPath ∧ walkWeight wH p ≤ β * wdist G w u v ∧
      ((p.darts.filter fun d =>
          ¬ (O.tree (min (O.rank u) (O.rank v))).Adj d.fst d.snd).length ≤ 2) ∧
      ∀ d ∈ p.darts, ¬ (O.tree (min (O.rank u) (O.rank v))).Adj d.fst d.snd →
        wH d.fst d.snd = 0

/-! ## Lemma stubs (rubric items) -/

/-- Rubric 1: every finite ultrametric is realized exactly as leaf distances of a
nonnegatively weighted tree (with auxiliary internal vertices). [PathReportingDistanceOracles, node_16] -/
theorem ultrametric_tree_realization (M : Type) [Fintype M] [DecidableEq M]
    (ρ : M → M → ℝ) (hρ : IsUltrametric ρ) :
    ∃ (N : Type) (_ : Fintype N) (T : SimpleGraph N) (wT : N → N → ℝ) (leaf : M → N),
      T.IsTree ∧ IsWeighting wT ∧ Function.Injective leaf ∧
      ∀ x y, wdist T wT (leaf x) (leaf y) = ρ x y := by
  sorry

/-- Terminal-only trees (the step the reference calls "Fact 2"; not supplied by the problem,
so it must be proved): a nonnegatively weighted tree and a terminal set `R` give a forest on
exactly `R`, connecting all of `R`, with `d_T ≤ d_S ≤ 8 d_T` on terminals. [PathReportingDistanceOracles, node_16] -/
theorem terminal_tree (N : Type) [Fintype N] [DecidableEq N] (T : SimpleGraph N)
    (wT : N → N → ℝ) (hT : T.IsTree) (hw : IsWeighting wT) (R : Finset N) :
    ∃ (S : SimpleGraph N) (wS : N → N → ℝ),
      S.IsAcyclic ∧ IsWeighting wS ∧
      (∀ x y, S.Adj x y → x ∈ R ∧ y ∈ R) ∧
      ∀ x ∈ R, ∀ y ∈ R, S.Reachable x y ∧
        wdist T wT x y ≤ wdist S wS x y ∧ wdist S wS x y ≤ 8 * wdist T wT x y := by
  sorry

/-- Rubric 2: if every `H`-edge dominates the original distance, every `H`-walk does
(global noncontraction of a union of trees). [PathReportingDistanceOracles, node_16] -/
theorem noncontracting_of_edges {V : Type} (G : SimpleGraph V) (w : V → V → ℝ)
    (hw : IsWeighting w) (H : SimpleGraph V) (wH : V → V → ℝ)
    (hedge : ∀ x y, H.Adj x y → G.Reachable x y ∧ wdist G w x y ≤ wH x y)
    (u v : V) (p : H.Walk u v) :
    G.Reachable u v ∧ wdist G w u v ≤ walkWeight wH p := by
  sorry

/-- Rubric 3: with `r(v)` the last membership index of a nested sequence, at level
`j = min (r u) (r v)` both endpoints are present and one of them exits. [PathReportingDistanceOracles, node_16] -/
theorem min_rank_level {M : Type} (s : ℕ) (X : ℕ → Finset M) (r : M → ℕ)
    (hr : ∀ x j, j < s → (x ∈ X j ↔ j ≤ r x)) (hs : ∀ x, r x < s) (u v : M) :
    u ∈ X (min (r u) (r v)) ∧ v ∈ X (min (r u) (r v)) ∧
      (u ∉ X (min (r u) (r v) + 1) ∨ v ∉ X (min (r u) (r v) + 1)) := by
  sorry

/-- Rubric 5: double counting `∑_v (r(v)+1) = ∑_{j<s} |X_j|` for a nested sequence with
`X_0 = M` and last membership index `r`. [PathReportingDistanceOracles, node_16] -/
theorem records_eq_membership {M : Type} [Fintype M] [DecidableEq M] (s : ℕ)
    (X : ℕ → Finset M) (r : M → ℕ)
    (hr : ∀ x j, j < s → (x ∈ X j ↔ j ≤ r x)) (hs : ∀ x, r x < s) :
    ∑ x, (r x + 1) = ∑ j ∈ Finset.range s, (X j).card := by
  sorry

/-! ## Main theorem -/

/-- Main theorem: an interactive `O(k)`-emulator of size `O(n^{1+1/k})` with a level-tree
oracle (query at level `min (r u) (r v)`) whose record count is `O(n^{1+1/k})`; the
constant `C` depends only on the absolute constant `A` of the supplied fact. [PathReportingDistanceOracles, node_16] -/
theorem main_theorem (A : ℝ) (hA : UltrametricHierarchyFact A) :
    ∃ C : ℝ, 0 < C ∧
      ∀ (V : Type) [Fintype V] [DecidableEq V] (G : SimpleGraph V) (w : V → V → ℝ),
        IsWeighting w → ∀ k : ℕ, 1 ≤ k →
          ∃ (H : SimpleGraph V) (wH : V → V → ℝ) (O : LevelTreeOracle V),
            IsEmulator G w H wH (C * k) ∧
            O.Valid G w H wH (C * k) ∧
            (edgeCount H : ℝ) ≤ C * (Fintype.card V : ℝ) ^ (1 + 1 / (k : ℝ)) ∧
            (O.records : ℝ) ≤ C * (Fintype.card V : ℝ) ^ (1 + 1 / (k : ℝ)) := by
  sorry

