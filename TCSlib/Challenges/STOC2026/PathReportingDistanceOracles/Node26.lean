/-!
## Interactive `(4+ε)k`-emulators with query overhead `O(1 + log log k + log(1/ε))`

`G` is connected with `n ≥ 2` vertices and positive weights; `Λ` is its aspect ratio. With
`ε̄ = min ε 1`, `a = 1 + ε̄/4`, `μ` the minimum distance and scales `W_i = μ a^i`
(`i ≤ h = ⌈log_a Λ⌉`), a multiscale structure consists of, per scale, a cluster family, a
designated cluster `T_i(v) ⊇ B(v, W_i)` per vertex, and a rooted tree inside each cluster
with root distances `≤ (2k-1) W_i`. The query for `(u,v)` with numerical estimate `z`
binary-searches the predicate `u ∈ T_i(v)` over `[L, R]` and reports the tree path.
`main_theorem`: such a structure exists with emulator size (and incidence count)
`O(k max{1, log Λ}/ε̄ · n^{1+1/k})`, every query path has weight `≤ (4+ε) k d_G(u,v)`, and the
search uses `O(1 + log log (k+2) + log(1/ε̄))` tests.
-/

namespace TCSChallenge.PathReportingDistanceOracles.node_26

/-- Weight of a walk: the sum of `w` over its darts (oriented edges). -/
def walkWeight {V : Type} {G : SimpleGraph V} (w : V → V → ℝ) {u v : V}
    (p : G.Walk u v) : ℝ :=
  (p.darts.map fun d => w d.fst d.snd).sum

/-- Shortest-path distance `d_G(u,v)` = infimum of walk weights. For unreachable pairs the
infimum over an empty type is `0` in Lean; it is only used for reachable pairs. -/
def wdist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (u v : V) : ℝ :=
  ⨅ p : G.Walk u v, walkWeight w p

/-- "finite nonnegative edge weights": `w` is symmetric and nonnegative. -/
def IsWeighting {V : Type} (w : V → V → ℝ) : Prop :=
  ∀ x y, 0 ≤ w x y ∧ w x y = w y x

/-- Number of edges of a simple graph (as `Set.ncard` of its edge set). -/
def edgeCount {V : Type} (H : SimpleGraph V) : ℕ := H.edgeSet.ncard

/-- Minimum distance between distinct vertices `min_{x≠y} d_G(x,y)` (infimum over the
subtype of distinct pairs, nonempty when `n ≥ 2`). -/
def minDist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) : ℝ :=
  ⨅ p : {p : V × V // p.1 ≠ p.2}, wdist G w p.1.1 p.1.2

/-- Maximum distance `max_{x,y} d_G(x,y)`. -/
def maxDist {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) : ℝ :=
  ⨆ p : V × V, wdist G w p.1 p.2

/-- Aspect ratio `Λ = max d_G / min_{x≠y} d_G`. -/
def aspectRatio {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) : ℝ :=
  maxDist G w / minDist G w

/-- Closed ball `B(v, W) = {x : d_G(v,x) ≤ W}`. -/
def ball {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ) (v : V) (W : ℝ) :
    Finset V :=
  Finset.univ.filter fun x => wdist G w v x ≤ W

/-- `S` has strong radius at most `R` with center `c ∈ S`: every vertex of `S` is joined to
`c` by a walk inside `G[S]` of weight `≤ R`. -/
def StrongRadiusLE {V : Type} (G : SimpleGraph V) (w : V → V → ℝ) (S : Finset V) (c : V)
    (R : ℝ) : Prop :=
  c ∈ S ∧ ∀ x ∈ S, ∃ p : G.Walk c x, (∀ z ∈ p.support, z ∈ S) ∧ walkWeight w p ≤ R

/-- Binary search used by the query: on `[l, r]`, test `P m` at `m = ⌊(l+r)/2⌋`, keep
`[l, m]` if true and `[m+1, r]` otherwise; returns `l` when `l ≥ r` (or fuel runs out). -/
def bsearch (P : ℕ → Prop) : ℕ → ℕ → ℕ → ℕ
  | 0, l, _ => l
  | fuel + 1, l, r =>
      if l < r then
        if P ((l + r) / 2) then bsearch P fuel l ((l + r) / 2)
        else bsearch P fuel ((l + r) / 2 + 1) r
      else l

/-- Number of predicate tests performed by `bsearch`. -/
def bsearchTests (P : ℕ → Prop) : ℕ → ℕ → ℕ → ℕ
  | 0, _, _ => 0
  | fuel + 1, l, r =>
      if l < r then
        if P ((l + r) / 2) then bsearchTests P fuel l ((l + r) / 2) + 1
        else bsearchTests P fuel ((l + r) / 2 + 1) r + 1
      else 0

/-- Multiscale data: per scale `i`, a cluster family, designated clusters, tree centers and
trees (a tree is a subgraph of `G` on the cluster's vertices). -/
structure Multiscale (V : Type) where
  clusters : ℕ → Finset (Finset V)
  des : ℕ → V → Finset V
  center : ℕ → Finset V → V
  tree : ℕ → Finset V → SimpleGraph V

/-- Validity of the multiscale data at scales `W i`, `i ≤ h`, with stretch parameter `k`. -/
def Multiscale.Valid {V : Type} [Fintype V] (M : Multiscale V) (G : SimpleGraph V)
    (w : V → V → ℝ) (k h : ℕ) (W : ℕ → ℝ) : Prop :=
  ∀ i, i ≤ h →
    (∀ v, M.des i v ∈ M.clusters i ∧ ball G w v (W i) ⊆ M.des i v) ∧
    (∀ T ∈ M.clusters i,
      M.tree i T ≤ G ∧ (M.tree i T).IsAcyclic ∧
      (∀ x y, (M.tree i T).Adj x y → x ∈ T ∧ y ∈ T) ∧
      StrongRadiusLE (M.tree i T) w T (M.center i T) ((2 * k - 1) * W i)) ∧
    (∀ x, (((M.clusters i).filter fun T => x ∈ T).card : ℝ) ≤
      k * (Fintype.card V : ℝ) ^ (1 / (k : ℝ)))

/-- The emulator graph: union of all cluster trees at scales `0, …, h`. -/
def Multiscale.emulator {V : Type} (M : Multiscale V) (h : ℕ) : SimpleGraph V :=
  ⨆ i ∈ Finset.range (h + 1), ⨆ T ∈ M.clusters i, M.tree i T

/-- Total number of vertex–cluster incidences over scales `0, …, h`. -/
def Multiscale.incidences {V : Type} (M : Multiscale V) (h : ℕ) : ℕ :=
  ∑ i ∈ Finset.range (h + 1), ∑ T ∈ M.clusters i, T.card

/-- `A_k = 2^{c ⌈log₂(k+2)⌉²}` (accuracy of the supplied numerical oracle with `t = k`). -/
def oracleAcc (c : ℝ) (k : ℕ) : ℝ := (2 : ℝ) ^ (c * (Nat.clog 2 (k + 2) : ℝ) ^ 2)

/-- Lower search index `L = max{0, ⌊log_a (zN / D)⌋}` (natural floor clips at `0`). -/
def lowIdx (a zN D : ℝ) : ℕ := ⌊Real.logb a (zN / D)⌋₊

/-- Upper search index `R = ⌈log_a zN⌉`. -/
def highIdx (a zN : ℝ) : ℕ := ⌈Real.logb a zN⌉₊

/-! ## Lemma stubs (rubric items) -/

/-- Rubric 1: sparse covers. A covering family `S_1, …, S_m` of strong radius `≤ R` is
coarsened into clusters of strong radius `≤ (2k-1)R`, each `S_j` inside one cluster, with
every vertex in at most `k m^{1/k}` clusters. [PathReportingDistanceOracles, node_26] -/
theorem sparse_cover {V : Type} [Fintype V] (G : SimpleGraph V) (w : V → V → ℝ)
    (hw : IsWeighting w) (k m : ℕ) (hk : 1 ≤ k) (R : ℝ) (S : Fin m → Finset V)
    (cS : Fin m → V) (hS : ∀ j, StrongRadiusLE G w (S j) (cS j) R) :
    ∃ (T : Finset (Finset V)) (cT : Finset V → V),
      (∀ j, ∃ T' ∈ T, S j ⊆ T') ∧
      (∀ T' ∈ T, StrongRadiusLE G w T' (cT T') ((2 * k - 1) * R)) ∧
      ∀ x, (((T.filter fun T' => x ∈ T').card : ℝ) ≤ k * (m : ℝ) ^ (1 / (k : ℝ))) := by
  sorry

/-- Rubric 3: the binary-search invariant without monotonicity. If `P R` holds and
`L ≤ R`, the result `i` lies in `[L, R]`, satisfies `P i`, and either `i = L` or
`¬ P (i - 1)`. [PathReportingDistanceOracles, node_26] -/
theorem bsearch_invariant (P : ℕ → Prop) (L R : ℕ) (hLR : L ≤ R) (hR : P R) :
    L ≤ bsearch P (R + 1) L R ∧ bsearch P (R + 1) L R ≤ R ∧
    P (bsearch P (R + 1) L R) ∧
    (bsearch P (R + 1) L R = L ∨ ¬ P (bsearch P (R + 1) L R - 1)) := by
  sorry

/-- Rubric 5: the binary search makes at most `⌈log₂ (R - L + 1)⌉` tests. [PathReportingDistanceOracles, node_26] -/
theorem bsearchTests_le (P : ℕ → Prop) (L R : ℕ) (hLR : L ≤ R) :
    bsearchTests P (R + 1) L R ≤ Nat.clog 2 (R + 1 - L) := by
  sorry

/-! ## Main theorem -/

/-- Main theorem. For the absolute constant `c ≥ 1` of the supplied oracle, there is an
absolute `C` such that every connected positively weighted `G` with `n ≥ 2`, every `k ≥ 1`
and `ε > 0` admit valid multiscale data at scales `μ a^i`, `i ≤ h`, whose emulator `H`
(a subgraph of `G`, hence noncontracting) and incidence count are
`≤ C k max{1, log Λ}/ε̄ · n^{1+1/k}`, and such that for all `u ≠ v` and every estimate `z`
with `A_k⁻¹ d ≤ z ≤ A_k d`, the search over `[L, R]` (with `zN = min (A_k z / μ) Λ`,
`D = A_k²`) returns a scale `i` with `u ∈ T_i(v)`, the tree of `T_i(v)` contains a simple
`u`–`v` path of weight `≤ (4+ε) k d`, and at most `C (1 + log log (k+2) + log (1/ε̄))` tests
are made. [PathReportingDistanceOracles, node_26] -/
theorem main_theorem (c : ℝ) (hc : 1 ≤ c) :
    ∃ C : ℝ, 0 < C ∧
      ∀ (V : Type) [Fintype V] [DecidableEq V] (G : SimpleGraph V) (w : V → V → ℝ),
        IsWeighting w → (∀ x y, G.Adj x y → 0 < w x y) → G.Connected →
        2 ≤ Fintype.card V → ∀ (k : ℕ) (ε : ℝ), 1 ≤ k → 0 < ε →
          ∃ M : Multiscale V,
            M.Valid G w k
              ⌈Real.logb (1 + min ε 1 / 4) (aspectRatio G w)⌉₊
              (fun i => minDist G w * (1 + min ε 1 / 4) ^ i) ∧
            M.emulator ⌈Real.logb (1 + min ε 1 / 4) (aspectRatio G w)⌉₊ ≤ G ∧
            (edgeCount (M.emulator
                ⌈Real.logb (1 + min ε 1 / 4) (aspectRatio G w)⌉₊) : ℝ) ≤
              C * k * max 1 (Real.log (aspectRatio G w)) / min ε 1 *
                (Fintype.card V : ℝ) ^ (1 + 1 / (k : ℝ)) ∧
            (M.incidences ⌈Real.logb (1 + min ε 1 / 4) (aspectRatio G w)⌉₊ : ℝ) ≤
              C * k * max 1 (Real.log (aspectRatio G w)) / min ε 1 *
                (Fintype.card V : ℝ) ^ (1 + 1 / (k : ℝ)) ∧
            ∀ u v, u ≠ v → ∀ z : ℝ,
              (oracleAcc c k)⁻¹ * wdist G w u v ≤ z → z ≤ oracleAcc c k * wdist G w u v →
              (let a := 1 + min ε 1 / 4
               let zN := min (oracleAcc c k * z / minDist G w) (aspectRatio G w)
               let P : ℕ → Prop := fun i => u ∈ M.des i v
               let L := lowIdx a zN (oracleAcc c k ^ 2)
               let R := highIdx a zN
               let i := bsearch P (R + 1) L R
               u ∈ M.des i v ∧
               (∃ p : (M.tree i (M.des i v)).Walk u v,
                  p.IsPath ∧ walkWeight w p ≤ (4 + ε) * k * wdist G w u v) ∧
               (bsearchTests P (R + 1) L R : ℝ) ≤
                 C * (1 + Real.log (Real.log (k + 2)) + Real.log (1 / min ε 1))) := by
  sorry

