/-!
## Small-depth Frege lower bound for the grid pigeonhole principle

For odd `m`, `G_m` is the grid graph on `{1,…,m}²` (here `Fin m × Fin m`). `PHP_m` has a
variable `x_e` per edge, the clause `C_v = ∨_{e ∋ v} x_e` for each vertex `v`, and
`¬x_e ∨ ¬x_f` for distinct edges sharing a vertex. Frege formulas are built from variables,
`false`, negation and disjunction; the rules are excluded middle, weakening, contraction,
association and cut. Size counts symbol occurrences, depth is alternating depth with
negations pushed to literals and same-connective layers flattened.

Main theorem `frege_php_grid_lower_bound`: there are absolute `c, C > 0` such that for every
`K > 0` and all sufficiently large odd `n`, every depth-`d` refutation of `PHP_n` with
`1 ≤ d ≤ K log n / log log n` has size at least `exp(c n^{1/(2d−1)} / (log n)^C)`.
-/

namespace TCSChallenge.OnSmallDepthFrege.node_27

/-! ## Frege formulas -/

/-- Frege formulas over variables `V`: variables, the constant `false`, negation and
(binary) disjunction. Conjunction is written by De Morgan duality; `true = ¬false`. -/
inductive Formula (V : Type) : Type
  | var : V → Formula V
  | fals : Formula V
  | neg : Formula V → Formula V
  | disj : Formula V → Formula V → Formula V

namespace Formula

variable {V : Type}

/-- The constant `true`, written as `¬false`. -/
def tru : Formula V := neg fals

/-- "Its size is the total number of symbol occurrences." -/
def size : Formula V → ℕ
  | var _ => 1
  | fals => 1
  | neg G => 1 + size G
  | disj p q => 1 + size p + size q

/-- Top connective of a formula read with polarity `pol` (negations pushed inward):
`some true` = disjunction, `some false` = conjunction, `none` = literal or constant. -/
def topConn : Formula V → Bool → Option Bool
  | var _, _ => none
  | fals, _ => none
  | neg G, pol => topConn G (!pol)
  | disj _ _, pol => some pol

/-- Alternating depth with polarity `pol`: "literals have depth zero, disjunction and dual
conjunction layers each contribute one, negations are handled by duality, and consecutive
layers of the same connective may be flattened". A child whose top connective equals the
current one is merged into the current layer (contributes its depth minus one). -/
def altDepth : Formula V → Bool → ℕ
  | var _, _ => 0
  | fals, _ => 0
  | neg G, pol => altDepth G (!pol)
  | disj p q, pol =>
      1 + max (if topConn p pol = some pol then altDepth p pol - 1 else altDepth p pol)
              (if topConn q pol = some pol then altDepth q pol - 1 else altDepth q pol)

/-- Depth of a formula. -/
def depth (F : Formula V) : ℕ := altDepth F true

/-- Right-nested disjunction of a list of formulas (`false` for the empty list). -/
def bigOr : List (Formula V) → Formula V
  | [] => fals
  | [p] => p
  | p :: q :: t => disj p (bigOr (q :: t))

end Formula

open Formula

/-- The five inference schemes:
`p ∨ ¬p`; `p ⟹ p ∨ q`; `p ∨ p ⟹ p`; `p ∨ (q ∨ r) ⟹ (p ∨ q) ∨ r`;
`p ∨ q, ¬p ∨ r ⟹ q ∨ r`. -/
def IsRuleInstance {V : Type} (prem : List (Formula V)) (concl : Formula V) : Prop :=
  (prem = [] ∧ ∃ p, concl = disj p (neg p)) ∨
  (∃ p q, prem = [p] ∧ concl = disj p q) ∨
  (∃ p, prem = [disj p p] ∧ concl = p) ∨
  (∃ p q r, prem = [disj p (disj q r)] ∧ concl = disj (disj p q) r) ∨
  (∃ p q r, prem = [disj p q, disj (neg p) r] ∧ concl = disj q r)

/-- A refutation from axioms `Ax`: a list of lines, each an axiom or obtained by an
inference scheme from earlier lines, ending with `false`. -/
def IsRefutation {V : Type} (Ax : Formula V → Prop) (π : List (Formula V)) : Prop :=
  π.getLast? = some fals ∧
  ∀ i : Fin π.length, Ax (π.get i) ∨
    ∃ js : List (Fin π.length), (∀ j ∈ js, j < i) ∧ IsRuleInstance (js.map π.get) (π.get i)

/-- Proof size: total number of symbol occurrences over all lines. -/
def proofSize {V : Type} (π : List (Formula V)) : ℕ := (π.map Formula.size).sum

/-- A proof has depth at most `d` if every line has depth at most `d`. -/
def ProofDepthLE {V : Type} (π : List (Formula V)) (d : ℕ) : Prop :=
  ∀ F ∈ π, F.depth ≤ d

/-! ## The grid pigeonhole principle -/

/-- Vertices of `G_m`: `{1,…,m}²`, indexed from `0` here. -/
abbrev Vtx (m : ℕ) : Type := Fin m × Fin m

/-- `G_m`: "edges join vertices at Euclidean distance one". -/
def gridGraph (m : ℕ) : SimpleGraph (Vtx m) :=
  SimpleGraph.fromRel (fun u v =>
    (u.1 = v.1 ∧ u.2.val + 1 = v.2.val) ∨ (u.2 = v.2 ∧ u.1.val + 1 = v.1.val))

/-- Edges of `G_m`; one propositional variable `x_e` per edge. -/
abbrev Edge (m : ℕ) : Type := ↥(gridGraph m).edgeSet

/-- `v` is an endpoint of `e`. -/
def Incident {m : ℕ} (v : Vtx m) (e : Edge m) : Prop := v ∈ (e : Sym2 (Vtx m))

/-- The clauses of `PHP_m`: `C_v = ∨_{e incident to v} x_e` (any order of the incident
literals, right-nested), and `¬x_e ∨ ¬x_f` for distinct edges sharing a vertex. -/
def PHPAxiom (m : ℕ) (F : Formula (Edge m)) : Prop :=
  (∃ (v : Vtx m) (l : List (Edge m)), l.Nodup ∧ (∀ e, e ∈ l ↔ Incident v e) ∧
      F = bigOr (l.map Formula.var)) ∨
  (∃ (v : Vtx m) (e f : Edge m), e ≠ f ∧ Incident v e ∧ Incident v f ∧
      F = disj (neg (var e)) (neg (var f)))

/-! ## Admissible matchings and matching decision trees -/

/-- A set of edges is a matching: distinct edges share no endpoint. -/
def IsMatching {m : ℕ} (M : Finset (Edge m)) : Prop :=
  ∀ e ∈ M, ∀ f ∈ M, e ≠ f → ∀ v, Incident v e → ¬ Incident v f

/-- `S ⊆ {1,…,m}` is a union of disjoint even-length intervals `[a, a + 2b)`. -/
def IsEvenIntervalUnion {m : ℕ} (S : Finset (Fin m)) : Prop :=
  ∃ I : Finset (ℕ × ℕ),
    (∀ p ∈ I, p.1 + 2 * p.2 ≤ m) ∧
    (∀ p ∈ I, ∀ q ∈ I, p ≠ q →
      Disjoint (Finset.Ico p.1 (p.1 + 2 * p.2)) (Finset.Ico q.1 (q.1 + 2 * q.2))) ∧
    ∀ x : Fin m, x ∈ S ↔ ∃ p ∈ I, x.val ∈ Finset.Ico p.1 (p.1 + 2 * p.2)

/-- "A partial matching M on G_m is admissible if it is contained in a perfect matching of
the induced grid on S × T, where S,T ⊆ {1,…,m} are unions of disjoint even-length
intervals and |S|,|T| ≤ 48|M|." -/
def Admissible {m : ℕ} (M : Finset (Edge m)) : Prop :=
  ∃ S T : Finset (Fin m), IsEvenIntervalUnion S ∧ IsEvenIntervalUnion T ∧
    S.card ≤ 48 * M.card ∧ T.card ≤ 48 * M.card ∧
    ∃ PM : Finset (Edge m), IsMatching PM ∧ M ⊆ PM ∧
      (∀ e ∈ PM, ∀ v, Incident v e → v.1 ∈ S ∧ v.2 ∈ T) ∧
      (∀ v : Vtx m, v.1 ∈ S → v.2 ∈ T → ∃ e ∈ PM, Incident v e)

/-- Supplied geometric fact 1: "Every submatching of an admissible matching is admissible." -/
def HereditaryFact (m : ℕ) : Prop :=
  ∀ M M' : Finset (Edge m), M' ⊆ M → Admissible M → Admissible M'

/-- Supplied geometric fact 2: "If M is admissible and |M| + 1 ≤ m/50, then for every
vertex v there is an edge e incident to v such that M ∪ {e} is admissible." -/
def ExtensionFact (m : ℕ) : Prop :=
  ∀ M : Finset (Edge m), Admissible M → ((M.card : ℝ) + 1 ≤ (m : ℝ) / 50) →
    ∀ v : Vtx m, ∃ e : Edge m, Incident v e ∧ Admissible (insert e M)

/-- Matching decision trees: a leaf labelled `0/1`, or a node querying the partner of a
vertex `v`, with a child for each possible answer `e` (only answers `e ∋ v` with
`M ∪ {e}` admissible are actual branches, see `PathOf`). -/
inductive MTree (m : ℕ) : Type
  | leaf : Bool → MTree m
  | node : Vtx m → (Edge m → MTree m) → MTree m

namespace MTree

variable {m : ℕ}

/-- Reverse all leaf labels. -/
def flipLabels : MTree m → MTree m
  | leaf b => leaf (!b)
  | node v ch => node v (fun e => flipLabels (ch e))

/-- Height bound: at most `k` queries on any branch. -/
inductive HeightLE : MTree m → ℕ → Prop
  | leaf (b : Bool) (k : ℕ) : HeightLE (leaf b) k
  | node (v : Vtx m) (ch : Edge m → MTree m) (k : ℕ) :
      (∀ e, HeightLE (ch e) k) → HeightLE (node v ch) (k + 1)

/-- `PathOf T M R b k`: starting at `T` with recorded matching `M`, there is a
root-to-leaf path with `k` queries, final recorded matching `R` and leaf label `b`.
At a node querying `v`, the branch `e` exists iff `e ∋ v` and `M ∪ {e}` is admissible. -/
inductive PathOf : MTree m → Finset (Edge m) → Finset (Edge m) → Bool → ℕ → Prop
  | leaf (b : Bool) (M : Finset (Edge m)) : PathOf (leaf b) M M b 0
  | node (v : Vtx m) (ch : Edge m → MTree m) (M R : Finset (Edge m)) (e : Edge m)
      (b : Bool) (k : ℕ) :
      Incident v e → Admissible (insert e M) → PathOf (ch e) (insert e M) R b k →
      PathOf (node v ch) M R b (k + 1)

/-- All leaves of `T` carry label `b`. -/
def AllLeaves (T : MTree m) (b : Bool) : Prop :=
  ∀ R b' k, PathOf T ∅ R b' k → b' = b

/-- `T|τ` has only `b`-leaves: every root-to-leaf path whose recorded matching has
admissible union with `τ` carries label `b`. -/
def AllLeavesUnder (T : MTree m) (τ : Finset (Edge m)) (b : Bool) : Prop :=
  ∀ R b' k, PathOf T ∅ R b' k → Admissible (R ∪ τ) → b' = b

end MTree

open MTree

/-- `D` is closed under immediate subformulas. -/
def SubformulaClosed {V : Type} (D : Set (Formula V)) : Prop :=
  ∀ F ∈ D, (∀ G, F = neg G → G ∈ D) ∧ (∀ p q, F = disj p q → p ∈ D ∧ q ∈ D)

/-- An evaluation of depth `t` on domain `D` (the map `T` assigns a tree to each formula):
* every `T_F` (`F ∈ D`) has depth at most `t`;
* `false` has only 0-leaves, `true` and every `PHP_m` axiom in `D` only 1-leaves;
* `T_{x_e}` queries an endpoint of `e` and outputs `1` exactly when the answer is `e`;
* `T_{¬F}` is `T_F` with labels reversed;
* for `F = p ∨ q` and a path `τ` of `T_F`: label `0` forces `T_p|τ, T_q|τ` to have only
  0-leaves; label `1` forces one of them to have only 1-leaves. -/
def IsEvaluation (m t : ℕ) (D : Set (Formula (Edge m))) (T : Formula (Edge m) → MTree m) :
    Prop :=
  (∀ F ∈ D, HeightLE (T F) t) ∧
  (fals ∈ D → AllLeaves (T fals) false) ∧
  (tru ∈ D → AllLeaves (T tru) true) ∧
  (∀ F ∈ D, PHPAxiom m F → AllLeaves (T F) true) ∧
  (∀ e : Edge m, var e ∈ D →
    ∃ v, Incident v e ∧ T (var e) = node v (fun f => leaf (if f = e then true else false))) ∧
  (∀ G, neg G ∈ D → T (neg G) = (T G).flipLabels) ∧
  (∀ p q, disj p q ∈ D → ∀ τ b k, PathOf (T (disj p q)) ∅ τ b k →
    (b = false → AllLeavesUnder (T p) τ false ∧ AllLeavesUnder (T q) τ false) ∧
    (b = true → AllLeavesUnder (T p) τ true ∨ AllLeavesUnder (T q) τ true))

/-! ## Lemma stubs -/

/-- Rubric 1 (evaluation soundness): if all lines of a refutation of `PHP_m` lie in a
subformula-closed domain carrying an evaluation of depth `t ≥ 1` and `m ≥ 400 t`, we get a
contradiction. (Proof: compatible nonempty prunings of at most seven trees per inference.) [OnSmallDepthFrege, node_27] -/
theorem evaluation_soundness (m t : ℕ) (hm : Odd m) (ht : 1 ≤ t) (hmt : 400 * t ≤ m)
    (hHer : HereditaryFact m) (hExt : ExtensionFact m)
    (π : List (Formula (Edge m))) (hπ : IsRefutation (PHPAxiom m) π)
    (D : Set (Formula (Edge m))) (T : Formula (Edge m) → MTree m)
    (hD : SubformulaClosed D) (hπD : ∀ F ∈ π, F ∈ D) (hT : IsEvaluation m t D T) :
    False := by
  sorry

/-- Elementary preliminary size bound: every refutation of `PHP_n` (odd `n`) uses every
white-vertex clause, hence has size at least `(n² + 1)/2` (exact division, `n² + 1` even). [OnSmallDepthFrege, node_27] -/
theorem refutation_size_ge (n : ℕ) (hn : Odd n) (π : List (Formula (Edge n)))
    (hπ : IsRefutation (PHPAxiom n) π) :
    (n ^ 2 + 1) / 2 ≤ proofSize π := by
  sorry

/-- Rubric 6 (rearranging the contradiction): if `n < J^d ℓ^{7d} S^{2d−1}` with
`ℓ = log₂ n` and `S = ⌈log₂ P⌉`, then `P ≥ exp(c n^{1/(2d−1)}/(log n)^7)` with `c` depending
only on `J`. [OnSmallDepthFrege, node_27] -/
theorem rearrange_bound (J : ℝ) (hJ : 1 ≤ J) :
    ∃ c : ℝ, 0 < c ∧ ∀ (n : ℕ), 2 ≤ n → ∀ (d : ℕ), 1 ≤ d → ∀ P : ℝ, 2 ≤ P →
      (n : ℝ) < J ^ d * (Real.logb 2 n) ^ (7 * d) *
        ((⌈Real.logb 2 P⌉₊ : ℕ) : ℝ) ^ (2 * d - 1) →
      Real.exp (c * (n : ℝ) ^ ((1 : ℝ) / (2 * (d : ℝ) - 1)) / (Real.log n) ^ (7 : ℕ)) ≤ P := by
  sorry

/-! ## Main theorem -/

/-- There are absolute constants `c, C > 0` such that for every fixed `K > 0` and all
sufficiently large odd `n`, every depth-`d` Frege refutation of `PHP_n` with
`1 ≤ d ≤ K log n / log log n` has size at least `exp(c n^{1/(2d−1)} / (log n)^C)`.
The threshold `N₀` may depend on `K`, but `c, C` may not. [OnSmallDepthFrege, node_27] -/
theorem frege_php_grid_lower_bound :
    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧ ∀ K : ℝ, 0 < K → ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n → Odd n →
      ∀ d : ℕ, 1 ≤ d → (d : ℝ) ≤ K * Real.log n / Real.log (Real.log n) →
      ∀ π : List (Formula (Edge n)), IsRefutation (PHPAxiom n) π → ProofDepthLE π d →
        Real.exp (c * (n : ℝ) ^ ((1 : ℝ) / (2 * (d : ℝ) - 1)) / (Real.log n) ^ C)
          ≤ (proofSize π : ℝ) := by
  sorry

