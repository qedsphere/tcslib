/-!
## Short zero-sum relations over `𝔽_q` with a `q`-independent sample bound

For `a ∈ 𝔽_q`, `q` an odd prime, `ã ∈ {-(q-1)/2, …, (q-1)/2}` is the centered representative
(`ZMod.valMinAbs`), and `‖x‖_{q,∞} = max_j |x̃_j|`. Take a prime `q ≥ 5`, `2 ≤ k ≤ ⌊q/2⌋`,
`t = ⌊q/(2k)⌋` and `m ≥ (k-1)^{(k-1)(k-2)/2} (n+k)^k`. Then every `V ∈ 𝔽_q^{n×m}` has a
nonzero kernel vector `x` with `‖x‖_{q,∞} ≤ t`. Consequently, for fixed `k`, worst-case SIS∞
with bound `⌊q/(2k)⌋` is solvable whenever `m ≥ C_k n^k`.

Main theorems: `exists_short_kernel_vector`, `exists_short_integer_relation`,
`sis_infty_fixed_k`.

Natural-number division `q / (2 * k)` is the floor `⌊q/(2k)⌋`. `(k-1)(k-2)/2` is exact
because the product of two consecutive integers is even.
-/

namespace TCSChallenge.NoExponentialQuantumSpeedupSIS.node_05

/-- `‖x‖_{q,∞} ≤ t`: every coordinate has a centered representative of absolute value `≤ t`. -/
def IsShort {q m : ℕ} (x : Fin m → ZMod q) (t : ℕ) : Prop :=
  ∀ j, (x j).valMinAbs.natAbs ≤ t

/-- The paper's sample bound `(k-1)^{(k-1)(k-2)/2} (n+k)^k`. -/
def sampleBound (k n : ℕ) : ℕ :=
  (k - 1) ^ ((k - 1) * (k - 2) / 2) * (n + k) ^ k

/-- "`R_D := ∏_{r=0}^{d-1} (d^r D + k)`" with `d = k - 1`: the number of vectors in
`𝔽_q^D` consumed by one compression tree. -/
def treeSize (k D : ℕ) : ℕ :=
  ∏ r ∈ Finset.range (k - 1), ((k - 1) ^ r * D + k)

/-! ## Lemma stubs (rubric items) -/

/-- With `h = (q-1)/2` and `q` odd, `⌊q/(2k)⌋ = ⌊h/k⌋`. [NoExponentialQuantumSpeedup, node_05] -/
theorem floor_identity (q k : ℕ) (hq : q % 2 = 1) (hk : 1 ≤ k) :
    q / (2 * k) = ((q - 1) / 2) / k := by
  sorry

/-- **Coefficient partition (rubric 1).** Split `{1, …, h}` (`h = (q-1)/2`) into classes
`B_0 = {1, …, t}, B_1, …, B_{k-1}`, each nonempty, where elements of one class differ by at
most `t`. This gives `B_i - B_i ⊆ H_0 = {-t, …, t}`. [NoExponentialQuantumSpeedup, node_05] -/
theorem coefficient_partition (q k : ℕ) [Fact q.Prime] (hq : 5 ≤ q)
    (hk : 2 ≤ k) (hkq : k ≤ q / 2) :
    ∃ cls : ℕ → Fin k,
      (∀ c, 1 ≤ c → c ≤ (q - 1) / 2 → (cls c = ⟨0, by omega⟩ ↔ c ≤ q / (2 * k))) ∧
      (∀ i : Fin k, ∃ c, 1 ≤ c ∧ c ≤ (q - 1) / 2 ∧ cls c = i) ∧
      (∀ c c', 1 ≤ c → c ≤ (q - 1) / 2 → 1 ≤ c' → c' ≤ (q - 1) / 2 → cls c = cls c' →
        c ≤ c' + q / (2 * k)) := by
  sorry

/-- **Base zero-sum procedure (rubric 2).** From `D + k` vectors in `𝔽_q^D` one obtains a
zero-sum in which every prescribed coefficient `a_0, …, a_{k-1}` occurs at distinct
positions. [NoExponentialQuantumSpeedup, node_05] -/
theorem base_zero_sum (q k D : ℕ) (y : Fin (D + k) → Fin D → ZMod q) (a : Fin k → ZMod q) :
    ∃ x : Fin (D + k) → ZMod q, ∑ j, x j • y j = 0 ∧
      ∃ e : Fin k → Fin (D + k), Function.Injective e ∧ ∀ i, x (e i) = a i := by
  sorry

/-- **Compression construction (rubric 3).** From `R_D` vectors in `𝔽_q^D` one obtains a
nontrivial `{±1}`-sum `u = ∑ δ_j w_j` such that, for every `c` outside
`H_0 = {-t, …, t}`, the vector `c u` is a nonzero `H_0`-combination of the same vectors. [NoExponentialQuantumSpeedup, node_05] -/
theorem compression (q k D : ℕ) [Fact q.Prime] (hq : 5 ≤ q)
    (hk : 2 ≤ k) (hkq : k ≤ q / 2) (w : Fin (treeSize k D) → Fin D → ZMod q) :
    ∃ δ : Fin (treeSize k D) → ℤ, δ ≠ 0 ∧ (∀ j, (δ j).natAbs ≤ 1) ∧
      ∀ c : ZMod q, q / (2 * k) < c.valMinAbs.natAbs →
        ∃ x : Fin (treeSize k D) → ZMod q, x ≠ 0 ∧ IsShort x (q / (2 * k)) ∧
          ∑ j, x j • w j = c • ∑ j, ((δ j : ℤ) : ZMod q) • w j := by
  sorry

/-- **Count (rubric 4).** `(n+k) R_n ≤ (k-1)^{(k-1)(k-2)/2} (n+k)^k`. [NoExponentialQuantumSpeedup, node_05] -/
theorem count_bound (k n : ℕ) (hk : 2 ≤ k) :
    (n + k) * treeSize k n ≤ sampleBound k n := by
  sorry

/-! ## Main theorems -/

/-- **Challenge, part 1 (kernel form).** A nonzero kernel vector with `‖x‖_{q,∞} ≤ ⌊q/(2k)⌋`
exists as soon as `m ≥ (k-1)^{(k-1)(k-2)/2} (n+k)^k`. [NoExponentialQuantumSpeedup, node_05] -/
theorem exists_short_kernel_vector (q k n m : ℕ) [Fact q.Prime] (hq : 5 ≤ q)
    (hk : 2 ≤ k) (hkq : k ≤ q / 2) (hm : sampleBound k n ≤ m)
    (V : Matrix (Fin n) (Fin m) (ZMod q)) :
    ∃ x : Fin m → ZMod q, x ≠ 0 ∧ V.mulVec x = 0 ∧ IsShort x (q / (2 * k)) := by
  sorry

/-- **Challenge, part 1 (coefficient form).** Integer coefficients `α_j ∈ {-t, …, t}`, not
all zero, with `∑_j α_j v_j = 0` in `𝔽_q^n`. [NoExponentialQuantumSpeedup, node_05] -/
theorem exists_short_integer_relation (q k n m : ℕ) [Fact q.Prime] (hq : 5 ≤ q)
    (hk : 2 ≤ k) (hkq : k ≤ q / 2) (hm : sampleBound k n ≤ m)
    (V : Matrix (Fin n) (Fin m) (ZMod q)) :
    ∃ α : Fin m → ℤ, α ≠ 0 ∧ (∀ j, (α j).natAbs ≤ q / (2 * k)) ∧
      V.mulVec (fun j => (α j : ZMod q)) = 0 := by
  sorry

/-- **Challenge, part 2.** For each fixed `k ≥ 2` there is a constant `C_k` such that, for every
prime `q ≥ 5` with `k ≤ ⌊q/2⌋`, every `H ∈ 𝔽_q^{n×m}` with `n ≥ 1` and `m ≥ C_k n^k` has a
nonzero `z ∈ ℤ^m` with `Hz = 0 (mod q)` and `‖z‖_∞ ≤ ⌊q/(2k)⌋`. [NoExponentialQuantumSpeedup, node_05] -/
theorem sis_infty_fixed_k (k : ℕ) (hk : 2 ≤ k) :
    ∃ C : ℕ, ∀ (q : ℕ) [Fact q.Prime], 5 ≤ q → k ≤ q / 2 →
      ∀ (n m : ℕ), 1 ≤ n → C * n ^ k ≤ m →
        ∀ H : Matrix (Fin n) (Fin m) (ZMod q),
          ∃ z : Fin m → ℤ, z ≠ 0 ∧ (∀ j, (z j).natAbs ≤ q / (2 * k)) ∧
            H.mulVec (fun j => (z j : ZMod q)) = 0 := by
  sorry

end TCSChallenge.NoExponentialQuantumSpeedupSIS.node_05
