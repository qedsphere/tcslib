/-!
## Average-case zero-sums with an arbitrary two-element coefficient set

Let `q ≥ 5` be prime, `k = ⌊(q+3)/4⌋`, `n ≥ 1`, and `L_ε = max{1, log(1/ε)}`. Assume the black
box: every list of `M_q(r) = (k-1)^{(k-1)(k-2)/2}(r+k)^k` vectors in `𝔽_q^r` has a nontrivial
`{-1,0,1}`-relation. Main theorem `two_element_average_case`: there is a universal constant
`C` such that for every `ε ∈ (0,1]`, every two-element `A ⊆ 𝔽_q` and every
`m ≥ q^{C q^2} n^{2k} L_ε^2`, at least a `1-ε` fraction of the inputs `(v_1, …, v_m)`
(uniform in `(𝔽_q^n)^m`) admit a nontrivial `A`-zero-sum.
-/

namespace TCSChallenge.NoExponentialQuantumSpeedupSIS.node_32

/-- "`k = floor((q + 3)/4)`". -/
def kOf (q : ℕ) : ℕ := (q + 3) / 4

/-- "`M_q(r) = (k − 1)^((k−1)(k−2)/2)(r + k)^k`". -/
def Mq (q r : ℕ) : ℕ :=
  (kOf q - 1) ^ ((kOf q - 1) * (kOf q - 2) / 2) * (r + kOf q) ^ kOf q

/-- The supplied black box, existence form: for every `r ≥ 1`, every list of `M_q(r)` vectors
in `𝔽_q^r` has coefficients `λ_i ∈ {-1,0,1}`, not all zero, with `∑ λ_i v_i = 0`. -/
def SignedRelationFact (q : ℕ) : Prop :=
  ∀ r : ℕ, 1 ≤ r → ∀ v : Fin (Mq q r) → Fin r → ZMod q,
    ∃ lam : Fin (Mq q r) → ℤ, lam ≠ 0 ∧ (∀ i, (lam i).natAbs ≤ 1) ∧
      ∑ i, ((lam i : ℤ) : ZMod q) • v i = 0

/-- "`L_ε = max{1, log(1/ε)}`" (natural logarithm). -/
def Leps (ε : ℝ) : ℝ := max 1 (Real.log (1 / ε))

/-- "`x ∈ C^m` is a nontrivial `C`-zero-sum if `∑ x_i v_i = 0` and `x ≠ 0`". -/
def HasNontrivialZeroSum {q n m : ℕ} (A : Finset (ZMod q)) (v : Fin m → Fin n → ZMod q) :
    Prop :=
  ∃ x : Fin m → ZMod q, x ≠ 0 ∧ (∀ i, x i ∈ A) ∧ ∑ i, x i • v i = 0

/-- Probability, over `m` independent uniform vectors of `𝔽_q^n`, that a nontrivial
`A`-zero-sum exists. -/
def successProb (q n m : ℕ) [NeZero q] (A : Finset (ZMod q)) : ℝ :=
  ((Finset.univ.filter (fun v : Fin m → Fin n → ZMod q => HasNontrivialZeroSum A v)).card : ℝ) /
    (Fintype.card (Fin m → Fin n → ZMod q) : ℝ)

/-! ## Lemma stubs (rubric items) -/

/-- **Scalar subset-hitting estimate (1).** For uniform `β ∈ 𝔽_q^d`,
`Pr[no nonempty T with ∑_{j∈T} β_j = 1] ≤ (q-1)/(2^d-1)`, written in cleared-denominator form. [NoExponentialQuantumSpeedup, node_32] -/
theorem subset_hitting (q d : ℕ) [Fact q.Prime] [NeZero q] (hd : 1 ≤ d) :
    (Finset.univ.filter (fun β : Fin d → ZMod q =>
        ¬ ∃ T : Finset (Fin d), T.Nonempty ∧ ∑ j ∈ T, β j = 1)).card * (2 ^ d - 1) ≤
      (q - 1) * q ^ d := by
  sorry

/-- **Recovery of subset-sum (rubric 2).** Given `M_q(r)` nonempty, disjoint
`{1,2}`-relations among vectors of `𝔽_q^r`, a new signed relation yields a nonempty subset
summing to zero. [NoExponentialQuantumSpeedup, node_32] -/
theorem mixed_to_subset_sum (q r N : ℕ) [Fact q.Prime] (hq : 5 ≤ q)
    (hfact : SignedRelationFact q) (hr : 1 ≤ r) (z : Fin N → Fin r → ZMod q)
    (S : Fin (Mq q r) → Finset (Fin N)) (hS : Pairwise (fun j j' => Disjoint (S j) (S j')))
    (hne : ∀ j, (S j).Nonempty) (γ : Fin N → ZMod q)
    (hγ : ∀ j, ∀ i ∈ S j, γ i = 1 ∨ γ i = 2)
    (hrel : ∀ j, ∑ i ∈ S j, γ i • z i = 0) :
    ∃ I : Finset (Fin N), I.Nonempty ∧ ∑ i ∈ I, z i = 0 := by
  sorry

/-- **High-probability subset-sum (Step 4).** For some universal `C₁`: if
`m ≥ q^{C₁ q^2} r^{2k} L_η`, then with probability `≥ 1-η` uniform vectors in `𝔽_q^r` have a
nonempty zero subset sum (a nontrivial `{0,1}`-zero-sum). [NoExponentialQuantumSpeedup, node_32] -/
theorem subset_sum_whp :
    ∃ C₁ : ℕ, ∀ (q : ℕ) [Fact q.Prime] [NeZero q], 5 ≤ q → SignedRelationFact q →
      ∀ (r m : ℕ), 1 ≤ r → ∀ η : ℝ, 0 < η → η ≤ 1 →
        (q : ℝ) ^ (C₁ * q ^ 2) * (r : ℝ) ^ (2 * kOf q) * Leps η ≤ m →
          1 - η ≤ successProb q r m {0, 1} := by
  sorry

/-! ## Main theorem -/

/-- **Challenge.** There is a universal constant `C` such that for every prime `q ≥ 5` (with
the black box), every `n ≥ 1`, `ε ∈ (0,1]`, every two-element `A ⊆ 𝔽_q`, and every
`m ≥ q^{C q^2} n^{2k} L_ε^2`, `m` independent uniform vectors in `𝔽_q^n` admit a nontrivial
`A`-zero-sum with probability at least `1 - ε`. [NoExponentialQuantumSpeedup, node_32] -/
theorem two_element_average_case :
    ∃ C : ℕ, ∀ (q : ℕ) [Fact q.Prime] [NeZero q], 5 ≤ q → SignedRelationFact q →
      ∀ (n m : ℕ), 1 ≤ n → ∀ ε : ℝ, 0 < ε → ε ≤ 1 →
        ∀ A : Finset (ZMod q), A.card = 2 →
          (q : ℝ) ^ (C * q ^ 2) * (n : ℝ) ^ (2 * kOf q) * Leps ε ^ 2 ≤ m →
            1 - ε ≤ successProb q n m A := by
  sorry

end TCSChallenge.NoExponentialQuantumSpeedupSIS.node_32
