/-!
## Average-case Constrained Integer Solution over a dense alphabet

Let `q` be prime, `k ≥ 2`, and `A ⊆ 𝔽_q` with `|A| = q - k + 1`. Given independent uniform
columns `v_1, …, v_m ∈ 𝔽_q^n`, find a nonzero `x ∈ A^m` with `∑ x_i v_i = 0`. The claim: for
every `ε ∈ (0, 1/3]` there is `C = C(k, ε)` such that whenever `q > 4^{k-1}` and
`m ≥ C log q · n²` a deterministic algorithm succeeds with probability `≥ 1 - ε` over the
input. Main theorem: `cis_average_case`.

Ingredients (lemma stubs):
* `density_threshold`: `q > 4^{k-1}` gives `|A| ≥ q - log₄(q+2)` and `q ≥ 5`;
* `exists_centered_affine_subset`: from the progression fact, `a J_q + b ⊆ A` with `a ≠ 0`;
* `target_transfer`: random targets are `J_q`-representable by `d·M` random columns;
* `affine_reconstruction`: `x_i = a y_i + b` with `∑ y_i v_i = -a⁻¹ b ∑ v_i` is a zero-sum;
* `affine_reconstruction_ne_zero`: nontriviality via an inactive (or reserved) column.

The uniform input distribution on `(𝔽_q^n)^m` is counting measure normalised by
`q^{n m}`; probability statements are stated as lower bounds on cardinalities.
-/

namespace TCSChallenge.NoExponentialQuantumSpeedupSIS.node_19

/-- Vectors in `𝔽_q^n`. -/
abbrev Vec (q n : ℕ) : Type := Fin n → ZMod q

/-- `s = ⌊q/4⌋` and `J_q = {-s, …, s} ⊆ 𝔽_q`: `x ∈ J_q` iff `x` is the image of an integer
`z` with `-s ≤ z ≤ s`. (Natural-number `q / 4` is the floor.) -/
def InJ (q : ℕ) (x : ZMod q) : Prop :=
  ∃ z : ℤ, -((q / 4 : ℕ) : ℤ) ≤ z ∧ z ≤ ((q / 4 : ℕ) : ℤ) ∧ ((z : ZMod q) = x)

/-- "An arithmetic progression of length `L` is `{c + a z : z = 0, …, L-1}` with `a ≠ 0`":
`S` contains such a progression. -/
def ContainsAP (q : ℕ) (S : Finset (ZMod q)) (L : ℕ) : Prop :=
  ∃ c a : ZMod q, a ≠ 0 ∧ ∀ z : ℕ, z < L → c + a * (z : ZMod q) ∈ S

/-- **Background fact 1 (supplied).** "If `q ≥ 5` and `S ⊆ 𝔽_q` satisfies
`|S| ≥ q - log₄(q+2)`, then `S` contains an arithmetic progression of length `(q+1)/2`."
(The `poly(q)` search time is dropped.) -/
def APFact : Prop :=
  ∀ (q : ℕ) [Fact q.Prime], 5 ≤ q → ∀ S : Finset (ZMod q),
    (q : ℝ) - Real.logb 4 ((q : ℝ) + 2) ≤ (S.card : ℝ) → ContainsAP q S ((q + 1) / 2)

/-- **Background fact 2 (supplied), for a given absolute constant `C0`.** "From any
`N ≥ C0 n²` vectors in `𝔽_q^n`, [one] finds a nonzero relation among them whose
coefficients all lie in `J_q`." Stated for primes `q ≥ 5` and `n ≥ 1` (for `q < 4`,
`J_q = {0}`, and for `N = 0` there is no nonzero relation); the running time is dropped. -/
def CenteredRelFact (C0 : ℕ) : Prop :=
  ∀ (q : ℕ) [Fact q.Prime], 5 ≤ q → ∀ (n N : ℕ), 1 ≤ n → C0 * n ^ 2 ≤ N →
    ∀ u : Fin N → Vec q n, ∃ y : Fin N → ZMod q,
      y ≠ 0 ∧ (∀ i, InJ q (y i)) ∧ ∑ i, y i • u i = 0

/-- Success predicate of a CIS output `x` on input columns `v`: `x ≠ 0`, `x ∈ A^m`,
`∑ x_i v_i = 0`. -/
def CISSolves {q n m : ℕ} (A : Finset (ZMod q)) (v : Fin m → Vec q n)
    (x : Fin m → ZMod q) : Prop :=
  x ≠ 0 ∧ (∀ i, x i ∈ A) ∧ ∑ i, x i • v i = 0

/-! ## Lemma stubs -/

/-- **Dense additive structure.** `q > 4^{k-1}` gives `k - 1 < log₄ q < log₄(q+2)`, hence
`|A| = q - k + 1 ≥ q - log₄(q+2)`; and `q ≥ 5`. [NoExponentialQuantumSpeedup, node_19] -/
theorem density_threshold (q k : ℕ) (hk : 2 ≤ k) (hq : 4 ^ (k - 1) < q) :
    5 ≤ q ∧ (q : ℝ) - Real.logb 4 ((q : ℝ) + 2) ≤ ((q - k + 1 : ℕ) : ℝ) := by
  sorry

/-- **Centered affine subset.** From the progression fact, a set `A` with `|A| = q - k + 1`
and `q > 4^{k-1}` contains `B = a J_q + b` with `a ≠ 0` (since `|J_q| = 1 + 2⌊q/4⌋ ≤ (q+1)/2`,
recenter consecutive terms of the progression). [NoExponentialQuantumSpeedup, node_19] -/
theorem exists_centered_affine_subset (hAP : APFact) (q k : ℕ) [Fact q.Prime]
    (hk : 2 ≤ k) (hq : 4 ^ (k - 1) < q) (A : Finset (ZMod q)) (hA : A.card = q - k + 1) :
    ∃ a b : ZMod q, a ≠ 0 ∧ ∀ x : ZMod q, InJ q x → a * x + b ∈ A := by
  sorry

/-- **Target-representation transfer (existence form).** There is an absolute `c` such that,
for `M ≥ C0 n²` and `d ≥ c · log₂(q/ε)` blocks, a uniformly random pair of `d·M` columns
`u` and target `w ∈ 𝔽_q^n` admits `y ∈ J_q^{dM}` with `∑ y_i u_i = w`, except on at most an
`ε`-fraction of pairs. (The deterministic decoder built from the centered relation finder is
not captured.) [NoExponentialQuantumSpeedup, node_19] -/
theorem target_transfer (C0 : ℕ) (hC0 : CenteredRelFact C0) :
    ∃ c : ℝ, ∀ (q : ℕ) [Fact q.Prime] [NeZero q], 5 ≤ q →
      ∀ (ε : ℝ), 0 < ε → ε ≤ 1 →
      ∀ (n M d : ℕ), 1 ≤ n → C0 * n ^ 2 ≤ M → c * Real.logb 2 ((q : ℝ) / ε) ≤ (d : ℝ) →
        (1 - ε) * (((q : ℝ) ^ n) ^ (d * M) * (q : ℝ) ^ n) ≤
          ((Finset.univ.filter (fun p : (Fin (d * M) → Vec q n) × Vec q n =>
            ∃ y : Fin (d * M) → ZMod q, (∀ i, InJ q (y i)) ∧
              ∑ i, y i • p.1 i = p.2)).card : ℝ) := by
  sorry

/-- **Affine reconstruction (zero-sum).** If `∑ y_i v_i = w` with
`w = -a⁻¹ b ∑_i v_i` and `a ≠ 0`, then `x_i = a y_i + b` satisfies `∑ x_i v_i = 0`. [NoExponentialQuantumSpeedup, node_19] -/
theorem affine_reconstruction (q n m : ℕ) [Fact q.Prime] (a b : ZMod q) (ha : a ≠ 0)
    (v : Fin m → Vec q n) (y : Fin m → ZMod q)
    (hy : ∑ i, y i • v i = (-(a⁻¹ * b)) • ∑ i, v i) :
    ∑ i, (a * y i + b) • v i = 0 := by
  sorry

/-- **Affine reconstruction (nontriviality).** If `b ≠ 0` and some (reserved or inactive)
column has `y_j = 0`, then `x = a y + b` is nonzero. [NoExponentialQuantumSpeedup, node_19] -/
theorem affine_reconstruction_ne_zero (q m : ℕ) [Fact q.Prime] (a b : ZMod q) (hb : b ≠ 0)
    (y : Fin m → ZMod q) (j : Fin m) (hj : y j = 0) :
    (fun i => a * y i + b) ≠ 0 := by
  sorry

/-! ## Main theorem -/

/-- **Average-case CIS for `|A| = q - k + 1`.** For fixed `k ≥ 2` and `ε ∈ (0, 1/3]` there is
`C = C(k, ε)` such that for every prime `q > 4^{k-1}`, every `A` with `|A| = q - k + 1`, and
`m ≥ C log q · n²`, some deterministic map `alg` from inputs to outputs solves CIS on at
least a `(1 - ε)`-fraction of the `q^{nm}` uniform inputs. [NoExponentialQuantumSpeedup, node_19] -/
theorem cis_average_case (hAP : APFact) (C0 : ℕ) (hC0 : CenteredRelFact C0)
    (k : ℕ) (hk : 2 ≤ k) (ε : ℝ) (hε0 : 0 < ε) (hε : ε ≤ 1 / 3) :
    ∃ C : ℝ, ∀ (q : ℕ) [Fact q.Prime] [NeZero q], 4 ^ (k - 1) < q →
      ∀ A : Finset (ZMod q), A.card = q - k + 1 →
      ∀ (n m : ℕ), 1 ≤ n → C * Real.log (q : ℝ) * (n : ℝ) ^ 2 ≤ (m : ℝ) →
        ∃ alg : (Fin m → Vec q n) → (Fin m → ZMod q),
          (1 - ε) * ((q : ℝ) ^ n) ^ m ≤
            ((Finset.univ.filter (fun v : Fin m → Vec q n => CISSolves A v (alg v))).card : ℝ) := by
  sorry

end TCSChallenge.NoExponentialQuantumSpeedupSIS.node_19
