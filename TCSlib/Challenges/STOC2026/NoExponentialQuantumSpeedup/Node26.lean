/-!
## Zero-sums avoiding `k` antipodal pairs of coefficients

Let `q ≥ 5` be prime, `1 ≤ a_1 < ⋯ < a_k ≤ ⌊q/2⌋` with `1 ≤ k < ⌊q/2⌋`, and set
`E = {±a_1, …, ±a_k}` and `A = 𝔽_q \ E`. An `A`-zero-sum of `v_1, …, v_m ∈ 𝔽_q^n` is
`x ∈ A^m` with `∑ x_i v_i = 0`. It is nontrivial if `x ≠ 0`. Main theorem
`exists_nontrivial_A_zero_sum`: if `m ≥ k^{k(k-1)/2} (n+k+1)^{k+1}`, every input has a
nontrivial `A`-zero-sum.

The `a_i` are indexed by `Fin k` (0-based) as natural numbers, cast into `ZMod q`.
`k(k-1)/2` is exact natural-number division.
-/

namespace TCSChallenge.NoExponentialQuantumSpeedupSIS.node_26

/-- "`E = {±a_1, …, ±a_k}`": the forbidden coefficients. -/
def InE {q k : ℕ} (a : Fin k → ℕ) (c : ZMod q) : Prop :=
  ∃ i, c = (a i : ZMod q) ∨ c = -(a i : ZMod q)

/-- "`A = 𝔽_q \ E`": the allowed coefficients. -/
def InA {q k : ℕ} (a : Fin k → ℕ) (c : ZMod q) : Prop :=
  ¬ InE a c

/-- "an `A`-zero-sum is `x ∈ A^m` with `∑ x_i v_i = 0`". -/
def IsAZeroSum {q k n m : ℕ} (a : Fin k → ℕ) (v : Fin m → Fin n → ZMod q)
    (x : Fin m → ZMod q) : Prop :=
  (∀ i, InA a (x i)) ∧ ∑ i, x i • v i = 0

/-- Hypotheses on the forbidden values: `1 ≤ a_1 < ⋯ < a_k ≤ ⌊q/2⌋`. -/
def ValidForbidden (q k : ℕ) (a : Fin k → ℕ) : Prop :=
  StrictMono a ∧ ∀ i, 1 ≤ a i ∧ a i ≤ q / 2

/-- `D_ℓ + k + 1` with `D_ℓ = k^{k-ℓ} n`, multiplied over `ℓ = 1, …, k`:
`N = ∏_{ℓ=1}^k (k^{k-ℓ} n + k + 1)`. -/
def blockSize (k n : ℕ) : ℕ :=
  ∏ l ∈ Finset.Icc 1 k, (k ^ (k - l) * n + k + 1)

/-! ## Lemma stubs (rubric items) -/

/-- **Primitive (rubric 1).** From `d + k + 1` vectors in `𝔽_q^d` one gets a zero-sum in
which `a_0, a_1, …, a_k` (here `b : Fin (k+1) → 𝔽_q`) occur at distinct positions. [NoExponentialQuantumSpeedup, node_26] -/
theorem full_field_zero_sum (q k d : ℕ) (y : Fin (d + k + 1) → Fin d → ZMod q)
    (b : Fin (k + 1) → ZMod q) :
    ∃ x : Fin (d + k + 1) → ZMod q, ∑ j, x j • y j = 0 ∧
      ∃ e : Fin (k + 1) → Fin (d + k + 1), Function.Injective e ∧ ∀ i, x (e i) = b i := by
  sorry

/-- An allowed nonzero coefficient `a_0 ∈ A \ {0}` exists. Also `A = -A` holds. [NoExponentialQuantumSpeedup, node_26] -/
theorem exists_allowed_nonzero (q k : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (a : Fin k → ℕ)
    (ha : ValidForbidden q k a) (hk : k < q / 2) :
    ∃ a0 : ZMod q, a0 ≠ 0 ∧ InA a a0 ∧ ∀ c : ZMod q, InA a c → InA a (-c) := by
  sorry

/-- **Auxiliary construction and elimination (rubrics 2–3).** From `N` vectors one obtains a
nonempty signed sum `u = ∑ δ_t v_t` (`δ_t ∈ {-1,0,1}`, not all zero) such that, for each
`c ∈ E`, `c u` is a nonzero `A`-combination of the same vectors (property `(*)`). [NoExponentialQuantumSpeedup, node_26] -/
theorem auxiliary_signed_sum (q k n : ℕ) [Fact q.Prime] (hq : 5 ≤ q) (a : Fin k → ℕ)
    (ha : ValidForbidden q k a) (hk1 : 1 ≤ k) (hk : k < q / 2)
    (w : Fin (blockSize k n) → Fin n → ZMod q) :
    ∃ δ : Fin (blockSize k n) → ℤ, δ ≠ 0 ∧ (∀ j, (δ j).natAbs ≤ 1) ∧
      ∀ c : ZMod q, InE a c →
        ∃ x : Fin (blockSize k n) → ZMod q, x ≠ 0 ∧ (∀ j, InA a (x j)) ∧
          ∑ j, x j • w j = c • ∑ j, ((δ j : ℤ) : ZMod q) • w j := by
  sorry

/-- **Count (rubric 5).** `(n+k+1) N ≤ k^{k(k-1)/2} (n+k+1)^{k+1}`. [NoExponentialQuantumSpeedup, node_26] -/
theorem count_bound (k n : ℕ) :
    (n + k + 1) * blockSize k n ≤ k ^ (k * (k - 1) / 2) * (n + k + 1) ^ (k + 1) := by
  sorry

/-! ## Main theorem -/

/-- **Challenge.** If `m ≥ k^{k(k-1)/2} (n+k+1)^{k+1}`, every `v_1, …, v_m ∈ 𝔽_q^n` admits a
nontrivial `A`-zero-sum. [NoExponentialQuantumSpeedup, node_26] -/
theorem exists_nontrivial_A_zero_sum (q k n m : ℕ) [Fact q.Prime] (hq : 5 ≤ q)
    (a : Fin k → ℕ) (ha : ValidForbidden q k a) (hk1 : 1 ≤ k) (hk : k < q / 2)
    (hm : k ^ (k * (k - 1) / 2) * (n + k + 1) ^ (k + 1) ≤ m)
    (v : Fin m → Fin n → ZMod q) :
    ∃ x : Fin m → ZMod q, x ≠ 0 ∧ IsAZeroSum a v x := by
  sorry

end TCSChallenge.NoExponentialQuantumSpeedupSIS.node_26
