/-!
## Average-case `𝔽_q^n`-Subset-Sum from a worst-case signed relation finder

Let `q > 3` be a fixed prime and `v_1, …, v_m` independent uniform in `𝔽_q^n`. Find a
nonempty `S ⊆ [m]` with `∑_{i∈S} v_i = 0`. Let `r_q` be the smallest even integer strictly
larger than `q/2`. Claim: there is `C_q > 0` such that a deterministic algorithm succeeds
with probability `≥ 0.99` whenever `m ≥ C_q n^{r_q}`. Main theorem: `subset_sum_average_case`.

Primitive: for `2 ≤ k ≤ ⌊q/2⌋`, `h_k = ⌊q/(2k)⌋`, `m̄_k = (k-1)^{(k-1)(k-2)/2}(n+k)^k`, on any
`m̄_k` vectors a nonzero integer relation with coefficients in `{-h_k, …, h_k}` exists.

Ingredients (lemma stubs): `k0_params` and `two_k0_isRq` (choice `k₀ = ⌊(q+3)/4⌋`, `h_{k₀} = 1`,
`2k₀ = r_q`); `target_shift` (a signed relation hitting `v* = -∑ v_i` yields a `{0,1,2}`
zero-sum); `subset_sum_hits_one` (uniform `β_1, …, β_d` have a subset summing to `1` except
with probability `≤ q/(2^d - 1)`); `boolean_cleanup` (disjoint `{1,2}` relations plus one
signed relation among the `y_j` expand to a genuine subset).

Natural-number `/` is the floor throughout; `(k-1)(k-2)/2` is exact.
-/

namespace TCSChallenge.NoExponentialQuantumSpeedupSIS.node_25

/-- Vectors in `𝔽_q^n`. -/
abbrev Vec (q n : ℕ) : Type := Fin n → ZMod q

/-- `m̄_k = (k-1)^{(k-1)(k-2)/2} (n+k)^k`. -/
def mbar (k n : ℕ) : ℕ := (k - 1) ^ ((k - 1) * (k - 2) / 2) * (n + k) ^ k

/-- **Supplied worst-case primitive `P_k`** (time bound dropped): "for every integer `k` with
`2 ≤ k ≤ ⌊q/2⌋` … on any `z_1, …, z_{m̄_k} ∈ 𝔽_q^n` [it] finds integers
`a_i ∈ {-h_k, …, h_k}`, not all zero, satisfying `∑ a_i z_i = 0`", `h_k = ⌊q/(2k)⌋`. -/
def PrimitiveFact (q : ℕ) : Prop :=
  ∀ (k n : ℕ), 2 ≤ k → k ≤ q / 2 → ∀ z : Fin (mbar k n) → Vec q n,
    ∃ a : Fin (mbar k n) → ℤ, a ≠ 0 ∧ (∀ i, (a i).natAbs ≤ q / (2 * k)) ∧
      ∑ i, (a i : ZMod q) • z i = 0

/-- `r` is "the smallest even integer strictly larger than `q/2`". -/
def IsRq (q r : ℕ) : Prop :=
  Even r ∧ q < 2 * r ∧ ∀ r' : ℕ, Even r' → q < 2 * r' → r ≤ r'

/-- Success of a subset output `S` on input `v`: `S` nonempty and `∑_{i∈S} v_i = 0`. -/
def SubsetSolves {q n m : ℕ} (v : Fin m → Vec q n) (S : Finset (Fin m)) : Prop :=
  S.Nonempty ∧ ∑ i ∈ S, v i = 0

/-! ## Lemma stubs -/

/-- **Tuning the primitive.** For prime `q > 3`, `k₀ = ⌊(q+3)/4⌋` satisfies
`2 ≤ k₀ ≤ ⌊q/2⌋` and `h_{k₀} = ⌊q/(2k₀)⌋ = 1`. [NoExponentialQuantumSpeedup, node_25] -/
theorem k0_params (q : ℕ) (hq : q.Prime) (hq3 : 3 < q) :
    2 ≤ (q + 3) / 4 ∧ (q + 3) / 4 ≤ q / 2 ∧ q / (2 * ((q + 3) / 4)) = 1 := by
  sorry

/-- **The exponent.** For prime `q > 3`, `2 k₀ = 2⌊(q+3)/4⌋ = r_q`. [NoExponentialQuantumSpeedup, node_25] -/
theorem two_k0_isRq (q : ℕ) (hq : q.Prime) (hq3 : 3 < q) :
    IsRq q (2 * ((q + 3) / 4)) := by
  sorry

/-- **Target shift.** On a block `u_0, …, u_D` put `v* = -∑_i u_i`. If signed coefficients
`α_i ∈ {-1,0,1}` on the first `D` vectors satisfy `∑ α_i u_i = v*`, then
`∑_{i<D} (1 + α_i) u_i + u_D = 0`: a nonzero zero-sum with coefficients in `{0,1,2}`. [NoExponentialQuantumSpeedup, node_25] -/
theorem target_shift (q n D : ℕ) (u : Fin (D + 1) → Vec q n) (α : Fin D → ℤ)
    (hα : ∀ i, (α i).natAbs ≤ 1)
    (hrel : ∑ i, (α i : ZMod q) • u (Fin.castSucc i) = -∑ i, u i) :
    (∑ i, ((1 + α i : ℤ) : ZMod q) • u (Fin.castSucc i)) + u (Fin.last D) = 0 ∧
      ∀ i, 0 ≤ 1 + α i ∧ 1 + α i ≤ 2 := by
  sorry

/-- **Hitting the target `1`.** For `d ≥ 1` independent uniform `β_1, …, β_d ∈ 𝔽_q`, the
fraction of `β` with no `T ⊆ [d]` satisfying `∑_{j∈T} β_j = 1` is at most `q / (2^d - 1)`
(second moment over the pairwise independent subset sums). With `d = ⌈log₂(q/η)⌉ + 1` this is
`≤ η`. [NoExponentialQuantumSpeedup, node_25] -/
theorem subset_sum_hits_one (q d : ℕ) [Fact q.Prime] [NeZero q] (hd : 1 ≤ d) :
    ((Finset.univ.filter (fun β : Fin d → ZMod q =>
        ¬ ∃ T : Finset (Fin d), ∑ j ∈ T, β j = 1)).card : ℝ) ≤
      (q : ℝ) / (2 ^ d - 1) * (q : ℝ) ^ d := by
  sorry

/-- **Boolean cleanup.** Let `(X_j, Y_j)`, `j < K`, be nonempty index sets, all pairwise
disjoint (within and across `j`), with `∑_{X_j} v + 2 ∑_{Y_j} v = 0`, and let `γ ∈ {-1,0,1}^K`
be nonzero with `∑_j γ_j y_j = 0` where `y_j = ∑_{Y_j} v`. Then
`S = ⋃_{γ_j = 1} Y_j ∪ ⋃_{γ_j = -1} (X_j ∪ Y_j)` is nonempty and `∑_{i∈S} v_i = 0`. [NoExponentialQuantumSpeedup, node_25] -/
theorem boolean_cleanup (q n m K : ℕ) [Fact q.Prime] (v : Fin m → Vec q n)
    (X Y : Fin K → Finset (Fin m))
    (hXne : ∀ j, (X j).Nonempty) (hYne : ∀ j, (Y j).Nonempty)
    (hXY : ∀ j, Disjoint (X j) (Y j))
    (hdisj : ∀ j j', j ≠ j' → Disjoint (X j ∪ Y j) (X j' ∪ Y j'))
    (hrel : ∀ j, ∑ i ∈ X j, v i + (2 : ZMod q) • ∑ i ∈ Y j, v i = 0)
    (γ : Fin K → ℤ) (hγ0 : γ ≠ 0) (hγ : ∀ j, (γ j).natAbs ≤ 1)
    (hγrel : ∑ j, (γ j : ZMod q) • ∑ i ∈ Y j, v i = 0) :
    SubsetSolves v
      ((Finset.univ.filter (fun j => γ j = 1)).biUnion Y ∪
        (Finset.univ.filter (fun j => γ j = -1)).biUnion (fun j => X j ∪ Y j)) := by
  sorry

/-! ## Main theorem -/

/-- **Average-case `𝔽_q^n`-Subset-Sum.** For a fixed prime `q > 3` (with the primitive `P_k`
available) and `r_q` the smallest even integer `> q/2`, there is `C_q > 0` such that for all
`n ≥ 1` and `m ≥ C_q n^{r_q}`, some deterministic map `alg` from inputs to subsets succeeds on
at least a `0.99`-fraction of the `q^{nm}` uniform inputs. [NoExponentialQuantumSpeedup, node_25] -/
theorem subset_sum_average_case (q : ℕ) [Fact q.Prime] [NeZero q] (hq3 : 3 < q)
    (hP : PrimitiveFact q) (r : ℕ) (hr : IsRq q r) :
    ∃ C : ℝ, 0 < C ∧ ∀ (n m : ℕ), 1 ≤ n → C * (n : ℝ) ^ r ≤ (m : ℝ) →
      ∃ alg : (Fin m → Vec q n) → Finset (Fin m),
        (99 / 100 : ℝ) * ((q : ℝ) ^ n) ^ m ≤
          ((Finset.univ.filter (fun v : Fin m → Vec q n => SubsetSolves v (alg v))).card : ℝ) := by
  sorry

end TCSChallenge.NoExponentialQuantumSpeedupSIS.node_25
