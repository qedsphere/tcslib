/-!
## Query lower bounds for log-concave sampling in the plane

For `κ ≥ 1`, `𝒱_κ` is the class of `C²` potentials `V : ℝ² → ℝ` with `∇V(0) = 0` and
`I ⪯ ∇²V(x) ⪯ κ I` everywhere; `π_V ∝ e^{-V}`. An algorithm queries an exact
value-and-gradient oracle adaptively, with independent internal randomness, and outputs a
point `X`. The main theorem `query_lower_bound` states: there are universal constants
`ε₀, c > 0`, `κ₀ ≥ 1` such that for every `κ ≥ κ₀` and every `n < c log κ`, every
`n`-query algorithm has an input `V ∈ 𝒱_κ` with `‖𝓛(X | V) − π_V‖_TV > ε₀`.
-/

namespace TCSChallenge.QueryLowerBoundsForLogConcaveSampling.node_03

open MeasureTheory

/-- Oracle answers: `(V(x), ∂₁V(x), ∂₂V(x))`. -/
abbrev Resp : Type := ℝ × ℝ × ℝ

/-- Squared Euclidean norm of a planar vector. -/
def sqNorm (v : ℝ × ℝ) : ℝ := v.1 ^ 2 + v.2 ^ 2

/-- Gradient of `V` at `x`, as the pair of partial derivatives. -/
def grad (V : ℝ × ℝ → ℝ) (x : ℝ × ℝ) : ℝ × ℝ :=
  (fderiv ℝ V x (1, 0), fderiv ℝ V x (0, 1))

/-- "`𝒱_κ = {V ∈ C²(ℝ²) : ∇V(0) = 0, I₂ ⪯ ∇²V(x) ⪯ κ I₂ for all x}`", the order being
the positive-semidefinite order, written via the Hessian quadratic form
`v ↦ D²V(x) v v`. -/
def PotClass (κ : ℝ) : Set (ℝ × ℝ → ℝ) :=
  {V | ContDiff ℝ 2 V ∧ grad V 0 = 0 ∧
    ∀ x v : ℝ × ℝ, sqNorm v ≤ fderiv ℝ (fderiv ℝ V) x v v ∧
      fderiv ℝ (fderiv ℝ V) x v v ≤ κ * sqNorm v}

/-- "An oracle returning `(V(x), ∇V(x))` exactly at any queried point." -/
def oracle (V : ℝ × ℝ → ℝ) (z : ℝ × ℝ) : Resp :=
  (V z, (grad V z).1, (grad V z).2)

/-- Normalizing constant `Z_V = ∫_{ℝ²} e^{-V(x)} dx`. -/
def partitionFn (V : ℝ × ℝ → ℝ) : ℝ := ∫ x, Real.exp (-V x)

/-- The Gibbs law `π_V(dx) = e^{-V(x)} / Z_V dx`. -/
def gibbs (V : ℝ × ℝ → ℝ) : Measure (ℝ × ℝ) :=
  volume.withDensity (fun x => ENNReal.ofReal (Real.exp (-V x) / partitionFn V))

/-- Total variation `‖P − Q‖_TV = sup_A |P(A) − Q(A)|` over measurable `A`. -/
def tvDist (P Q : Measure (ℝ × ℝ)) : ℝ :=
  ⨆ A : {A : Set (ℝ × ℝ) // MeasurableSet A}, |(P A.1).toReal - (Q A.1).toReal|

/-- A randomized adaptive `n`-query algorithm with seed space `Ω`: the `i`-th query point
is a function of the seed and the `i` previous answers; the output is a function of the
seed and all `n` answers. It is given `κ` implicitly (it may depend on `κ` because it is
quantified after `κ`). -/
structure QueryAlg (Ω : Type) (n : ℕ) where
  query : (i : Fin n) → Ω → (Fin i.val → Resp) → ℝ × ℝ
  output : Ω → (Fin n → Resp) → ℝ × ℝ

/-- Joint measurability of the algorithm in (seed, history), so that `𝓛(X | V)` is a
genuine pushforward law. -/
def QueryAlg.IsMeasurable {Ω : Type} [MeasurableSpace Ω] {n : ℕ} (A : QueryAlg Ω n) : Prop :=
  (∀ i : Fin n, Measurable (Function.uncurry (A.query i))) ∧
    Measurable (Function.uncurry A.output)

/-- The history of the first `k` oracle answers on input `V` and seed `ω`. -/
def QueryAlg.hist {Ω : Type} {n : ℕ} (A : QueryAlg Ω n) (V : ℝ × ℝ → ℝ) (ω : Ω) :
    (k : ℕ) → k ≤ n → (Fin k → Resp)
  | 0, _ => Fin.elim0
  | k + 1, h =>
    Fin.snoc (α := fun _ => Resp) (A.hist V ω k (Nat.le_of_succ_le h))
      (oracle V (A.query ⟨k, h⟩ ω (A.hist V ω k (Nat.le_of_succ_le h))))

/-- The output `X` of the algorithm on input `V` and seed `ω`. -/
def QueryAlg.run {Ω : Type} {n : ℕ} (A : QueryAlg Ω n) (V : ℝ × ℝ → ℝ) (ω : Ω) : ℝ × ℝ :=
  A.output ω (A.hist V ω n le_rfl)

/-- The law `𝓛(X | V)` of the output under the seed distribution `μ`. -/
def outputLaw {Ω : Type} [MeasurableSpace Ω] {n : ℕ} (A : QueryAlg Ω n)
    (V : ℝ × ℝ → ℝ) (μ : Measure Ω) : Measure (ℝ × ℝ) :=
  μ.map (A.run V)

/-- Rubric 4 (sampling ⇒ identification): a sampler within TV `ε` of `Q` puts mass at
least `Q(S) − ε` on any measurable `S`. [QueryLowerBoundsFor, node_03] -/
theorem mass_of_tv_le (P Q : Measure (ℝ × ℝ)) [IsProbabilityMeasure P]
    [IsProbabilityMeasure Q] (ε : ℝ) (hPQ : tvDist P Q ≤ ε) (S : Set (ℝ × ℝ))
    (hS : MeasurableSet S) : (Q S).toReal - ε ≤ (P S).toReal := by
  sorry

/-- Rubrics 1–3 and 5 combined: for large `N` there is a family `W_b`, `b ∈ {0,1}^N`, in
`𝒱_{D·2^{28N}}` with pairwise disjoint measurable sets `A_b` of `π_{W_b}`-mass `≥ γ`, such
that every `n`-query algorithm identifies a uniformly random `b` (via `X ∈ A_b`) with
probability at most `(C₀ n + 2)/N`. [QueryLowerBoundsFor, node_03] -/
theorem hard_family :
    ∃ γ : ℝ, 0 < γ ∧ ∃ D : ℝ, 1 ≤ D ∧ ∃ C₀ : ℝ, 0 < C₀ ∧ ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
      ∃ W : (Fin N → Bool) → ℝ × ℝ → ℝ, ∃ S : (Fin N → Bool) → Set (ℝ × ℝ),
        (∀ b, W b ∈ PotClass (D * 2 ^ (28 * N))) ∧
        (∀ b, MeasurableSet (S b)) ∧
        Pairwise (fun b b' => Disjoint (S b) (S b')) ∧
        (∀ b, γ ≤ (gibbs (W b) (S b)).toReal) ∧
        ∀ (n : ℕ) (Ω : Type) [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
          (A : QueryAlg Ω n), A.IsMeasurable →
          (∑ b, (outputLaw A (W b) μ (S b)).toReal) / 2 ^ N ≤ (C₀ * n + 2) / N := by
  sorry

/-- Main theorem: `Ω(log κ)` queries are needed to sample within a universal constant TV
error from strongly log-concave planar distributions of condition number `κ`. [QueryLowerBoundsFor, node_03] -/
theorem query_lower_bound :
    ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∃ c : ℝ, 0 < c ∧ ∃ κ₀ : ℝ, 1 ≤ κ₀ ∧
      ∀ κ : ℝ, κ₀ ≤ κ → ∀ n : ℕ, (n : ℝ) < c * Real.log κ →
        ∀ (Ω : Type) [MeasurableSpace Ω] (μ : Measure Ω) [IsProbabilityMeasure μ]
          (A : QueryAlg Ω n), A.IsMeasurable →
          ∃ V ∈ PotClass κ, ε₀ < tvDist (outputLaw A V μ) (gibbs V) := by
  sorry

end TCSChallenge.QueryLowerBoundsForLogConcaveSampling.node_03
