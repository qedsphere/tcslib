/-!
## Fully dynamic set cover with worst-case recourse

A finite universe `W` and a finite indexed family of sets `sets : ι → Finset W` covering `W`
are fixed. At every time step one element is inserted into or deleted from the live set
`L_t`. A deterministic online algorithm outputs a subfamily `C_t ⊆ ι` covering `L_t`, with
`C_0 = ∅`.

Main theorem `fullyDynamicSetCover_worstCaseRecourse`: there is a universal constant `c` such
that for every instance there is an online algorithm with, at every time `t`,
* feasibility: `C_t` covers `L_t`;
* approximation: `|C_t| ≤ c · log n · OPT(L_t)` with `n = max 2 |W|`;
* worst-case recourse: `|C_t \ C_{t-1}| ≤ c log n` and `|C_{t-1} \ C_t| ≤ c log n`
  (so `η_t ≤ 2 c log n`).
The update-time bound is not captured (see header).
-/

namespace TCSChallenge.FullyDynamicSetCover.node_04

variable {W ι : Type} [Fintype W] [DecidableEq W] [DecidableEq ι]

/-- "`⋃_{s ∈ C} s ⊇ L`": the subfamily `C` covers the live set `L`. -/
def Covers (sets : ι → Finset W) (C : Finset ι) (L : Finset W) : Prop :=
  ∀ e ∈ L, ∃ i ∈ C, e ∈ sets i

/-- "`OPT(L)` is the minimum number of sets covering `L`." (`sInf` of a set of naturals;
nonempty whenever the family covers the universe.) -/
def OPT (sets : ι → Finset W) (L : Finset W) : ℕ :=
  sInf {k : ℕ | ∃ C : Finset ι, C.card = k ∧ Covers sets C L}

/-- One update: "one element is inserted into or deleted from the live set". The element `e`
is inserted if absent and deleted if present. -/
def toggle (L : Finset W) (e : W) : Finset W :=
  if e ∈ L then L.erase e else insert e L

/-- The live set `L_t` after the update history `h` (oldest update first); `L_0 = ∅`. -/
def liveSet (h : List W) : Finset W :=
  h.foldl toggle ∅

/-- "`n := max{2, |U|}`", as a real number. -/
def nParam (X : Type) [Fintype X] : ℝ :=
  ((max 2 (Fintype.card X) : ℕ) : ℝ)

/-- Given fact: a feasible cover has at least `OPT` sets. [FullyDynamicSetCover, node_04] -/
theorem opt_le_card_of_covers (sets : ι → Finset W) (C : Finset ι) (L : Finset W)
    (hC : Covers sets C L) : OPT sets L ≤ C.card := by
  sorry

/-- Given fact: "`|OPT(L_t) - OPT(L_{t-1})| ≤ 1`" (one-update drift of the optimum),
using that the family covers the universe. [FullyDynamicSetCover, node_04] -/
theorem opt_drift (sets : ι → Finset W) (hcover : ∀ e : W, ∃ i, e ∈ sets i)
    (L : Finset W) (e : W) :
    OPT sets (toggle L e) ≤ OPT sets L + 1 ∧ OPT sets L ≤ OPT sets (toggle L e) + 1 := by
  sorry

/-- Given fact: deterministic static set cover admits an `O(log n)` approximation
(greedy, with factor `H_n ≤ 1 + ln n`). [FullyDynamicSetCover, node_04] -/
theorem static_approx [Fintype ι] (sets : ι → Finset W) (hcover : ∀ e : W, ∃ i, e ∈ sets i)
    (L : Finset W) :
    ∃ C : Finset ι, Covers sets C L ∧
      (C.card : ℝ) ≤ (1 + Real.log (nParam W)) * (OPT sets L : ℝ) := by
  sorry

/-- Main theorem (combinatorial core): a deterministic online algorithm, given as a function
`A` from update histories to subfamilies, with `C_0 = ∅`, that at every time is feasible,
`O(log n)`-approximate, and has `O(log n)` worst-case additions and deletions per update.
The universal constant `c` is chosen before the instance. [FullyDynamicSetCover, node_04] -/
theorem fullyDynamicSetCover_worstCaseRecourse :
    ∃ c : ℝ, 0 < c ∧
      ∀ (V J : Type) [Fintype V] [DecidableEq V] [Fintype J] [DecidableEq J]
        (sets : J → Finset V), (∀ e : V, ∃ i, e ∈ sets i) →
        ∃ A : List V → Finset J, A [] = ∅ ∧
          ∀ h : List V,
            Covers sets (A h) (liveSet h) ∧
            ((A h).card : ℝ) ≤ c * Real.log (nParam V) * (OPT sets (liveSet h) : ℝ) ∧
            ∀ e : V,
              ((A (h ++ [e]) \ A h).card : ℝ) ≤ c * Real.log (nParam V) ∧
              ((A h \ A (h ++ [e])).card : ℝ) ≤ c * Real.log (nParam V) := by
  sorry

end TCSChallenge.FullyDynamicSetCover.node_04
