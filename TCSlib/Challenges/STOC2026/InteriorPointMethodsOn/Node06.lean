/-!
## Hessian comparison along a geodesic for an α-self-concordant function

Let `(M, g)` be a Riemannian manifold, `D ⊆ M` open and geodesically convex, `f ∈ C³(D)`
geodesically convex with Riemannian Hessian `H = ∇²f`, and suppose
`|(∇_a H)_x(b,c)| ≤ (2/√α) √(H_x(a,a) H_x(b,b) H_x(c,c))`. If `q = Exp_p(u) ∈ D` and
`r = √(H_p(u,u)/α) < 1`, then for every `v ∈ T_pM`, with `τ` parallel transport along the
geodesic, `(1-r)² H_p(v,v) ≤ H_q(τv,τv) ≤ H_p(v,v)/(1-r)²`.

Main theorem: `hessian_comparison_along_geodesic`.
-/

namespace TCSChallenge.InteriorPointMethodsOnManifolds.node_06

open scoped BigOperators

/-! ## Shared framework: a Riemannian manifold in one global chart -/

/-- A (candidate) Riemannian manifold covered by a single global chart: the chart domain
`U ⊆ ℝⁿ` and the Gram matrix `g x` of the metric in coordinates at `x`. -/
structure ChartMetric (n : ℕ) where
  /-- the chart domain (the whole manifold) -/
  U : Set (Fin n → ℝ)
  /-- the metric coefficients `g_{ij}(x)` -/
  g : (Fin n → ℝ) → Matrix (Fin n) (Fin n) ℝ

/-- "Let `(M,g)` be a smooth Riemannian manifold": the domain is open, the metric
coefficients are `C^∞`, and the Gram matrix is positive definite (and symmetric) at each
point. -/
def ChartMetric.IsRiemannian {n : ℕ} (M : ChartMetric n) : Prop :=
  IsOpen M.U ∧
  (∀ i j : Fin n, ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x => M.g x i j) M.U) ∧
  (∀ x ∈ M.U, (M.g x).PosDef)

/-- Coordinate partial derivative `∂_k F (x)`. -/
noncomputable def partialD {n : ℕ} (F : (Fin n → ℝ) → ℝ) (k : Fin n) (x : Fin n → ℝ) : ℝ :=
  fderiv ℝ F x (Pi.single k 1)

/-- Christoffel symbols of the Levi-Civita connection,
`Γ^k_{ij} = ½ ∑_l g^{kl} (∂_i g_{jl} + ∂_j g_{il} - ∂_l g_{ij})`. -/
noncomputable def christoffel {n : ℕ} (M : ChartMetric n) (x : Fin n → ℝ) (k i j : Fin n) : ℝ :=
  (1 / 2 : ℝ) * ∑ l : Fin n, (M.g x)⁻¹ k l *
    (partialD (fun y => M.g y j l) i x + partialD (fun y => M.g y i l) j x
      - partialD (fun y => M.g y i j) l x)

/-- Components of the Riemannian Hessian `(∇²f)_{ij} = ∂_i ∂_j f - Γ^k_{ij} ∂_k f`. -/
noncomputable def hessComp {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x : Fin n → ℝ) (i j : Fin n) : ℝ :=
  partialD (fun y => partialD f j y) i x - ∑ k : Fin n, christoffel M x k i j * partialD f k x

/-- The Riemannian Hessian `H_x(a,b) = ∇²f_x(a,b)` as a bilinear form on `T_xM ≅ ℝⁿ`. -/
noncomputable def hess {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x a b : Fin n → ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, a i * b j * hessComp M f x i j

/-- The covariant derivative of the Hessian, `(∇_a H)_x(b,c) = ∇³f_x(a,b,c)`, with
`(∇_i H)_{jk} = ∂_i H_{jk} - Γ^l_{ij} H_{lk} - Γ^l_{ik} H_{jl}`. -/
noncomputable def covDerivHess {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x a b c : Fin n → ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, ∑ k : Fin n, a i * b j * c k *
    (partialD (fun y => hessComp M f y j k) i x
      - ∑ l : Fin n, christoffel M x l i j * hessComp M f x l k
      - ∑ l : Fin n, christoffel M x l i k * hessComp M f x j l)

/-- `γ` (with velocity field `γ'`) is a geodesic on `[a,b]`: it stays in the manifold,
`γ̇ = γ'`, and `γ̈^k = -Γ^k_{ij}(γ) γ̇^i γ̇^j` (one-sided derivatives at the endpoints). -/
def IsGeodesicOn {n : ℕ} (M : ChartMetric n) (γ γ' : ℝ → Fin n → ℝ) (a b : ℝ) : Prop :=
  ∀ t ∈ Set.Icc a b, γ t ∈ M.U ∧
    HasDerivWithinAt γ (γ' t) (Set.Icc a b) t ∧
    HasDerivWithinAt γ'
      (fun k => -∑ i : Fin n, ∑ j : Fin n, christoffel M (γ t) k i j * γ' t i * γ' t j)
      (Set.Icc a b) t

/-- `V` is a parallel vector field along the curve `γ` (velocity `γ'`) on `[a,b]`:
`V̇^k = -Γ^k_{ij}(γ) γ̇^i V^j`. -/
def IsParallelAlong {n : ℕ} (M : ChartMetric n) (γ γ' V : ℝ → Fin n → ℝ) (a b : ℝ) : Prop :=
  ∀ t ∈ Set.Icc a b,
    HasDerivWithinAt V
      (fun k => -∑ i : Fin n, ∑ j : Fin n, christoffel M (γ t) k i j * γ' t i * V t j)
      (Set.Icc a b) t

/-- "`D ⊆ M` is open and geodesically convex: every geodesic segment with endpoints in `D`
is contained in `D`." -/
def IsGeodesicallyConvexSet {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ)) : Prop :=
  D ⊆ M.U ∧ IsOpen D ∧
  ∀ γ γ' : ℝ → Fin n → ℝ, IsGeodesicOn M γ γ' 0 1 → γ 0 ∈ D → γ 1 ∈ D →
    ∀ t ∈ Set.Icc (0 : ℝ) 1, γ t ∈ D

/-- "`f` is geodesically convex on `D`": its restriction to every geodesic segment lying
in `D` is convex. -/
def IsGeodesicallyConvexFun {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ))
    (f : (Fin n → ℝ) → ℝ) : Prop :=
  ∀ (γ γ' : ℝ → Fin n → ℝ) (a b : ℝ), a < b → IsGeodesicOn M γ γ' a b →
    (∀ t ∈ Set.Icc a b, γ t ∈ D) → ConvexOn ℝ (Set.Icc a b) (f ∘ γ)

/-- α-self-concordance:
`|(∇_a H)_x(b,c)| ≤ (2/√α) √(H_x(a,a) H_x(b,b) H_x(c,c))` for `x ∈ D`, `a,b,c ∈ T_xM`. -/
def IsSelfConcordant {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ))
    (f : (Fin n → ℝ) → ℝ) (α : ℝ) : Prop :=
  ∀ x ∈ D, ∀ a b c : Fin n → ℝ,
    |covDerivHess M f x a b c|
      ≤ 2 / Real.sqrt α * Real.sqrt (hess M f x a a * hess M f x b b * hess M f x c c)

/-! ## Lemma stubs -/

/-- Geodesic convexity of `f` makes the Hessian positive semidefinite on `D`. [InteriorPointMethodsOn, node_06] -/
theorem hess_nonneg {n : ℕ} (M : ChartMetric n) (hM : M.IsRiemannian)
    (D : Set (Fin n → ℝ)) (hD : IsGeodesicallyConvexSet M D) (f : (Fin n → ℝ) → ℝ)
    (hf3 : ContDiffOn ℝ 3 f D) (hfconv : IsGeodesicallyConvexFun M D f)
    (x : Fin n → ℝ) (hx : x ∈ D) (a : Fin n → ℝ) :
    0 ≤ hess M f x a a := by
  sorry

/-- Rubric 1 (covariant product rule): along a geodesic lying in `D`, for parallel fields
`V, W`, `d/dt H_{γ(t)}(V(t),W(t)) = (∇³f)_{γ(t)}(γ̇(t), V(t), W(t))`. [InteriorPointMethodsOn, node_06] -/
theorem hasDerivWithinAt_hess_parallel {n : ℕ} (M : ChartMetric n) (hM : M.IsRiemannian)
    (D : Set (Fin n → ℝ)) (hD : IsGeodesicallyConvexSet M D) (f : (Fin n → ℝ) → ℝ)
    (hf3 : ContDiffOn ℝ 3 f D) (γ γ' V W : ℝ → Fin n → ℝ) (hγ : IsGeodesicOn M γ γ' 0 1)
    (hγD : ∀ t ∈ Set.Icc (0 : ℝ) 1, γ t ∈ D)
    (hV : IsParallelAlong M γ γ' V 0 1) (hW : IsParallelAlong M γ γ' W 0 1)
    (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) :
    HasDerivWithinAt (fun s => hess M f (γ s) (V s) (W s))
      (covDerivHess M f (γ t) (γ' t) (V t) (W t)) (Set.Icc 0 1) t := by
  sorry

/-- Rubric 2 (sharp velocity control): if `ψ ≥ 0` on `[0,1]`, `|ψ'| ≤ (2/√α) ψ^{3/2}`,
`ψ(0) = α r²` and `0 ≤ r < 1`, then `√ψ(t) ≤ r√α/(1 - r t)`. [InteriorPointMethodsOn, node_06] -/
theorem sqrt_velocity_bound (α r : ℝ) (hα : 0 < α) (hr0 : 0 ≤ r) (hr1 : r < 1)
    (ψ ψ' : ℝ → ℝ) (hψ : ∀ t ∈ Set.Icc (0 : ℝ) 1, HasDerivWithinAt ψ (ψ' t) (Set.Icc 0 1) t)
    (hψ0 : ∀ t ∈ Set.Icc (0 : ℝ) 1, 0 ≤ ψ t)
    (hψ' : ∀ t ∈ Set.Icc (0 : ℝ) 1, |ψ' t| ≤ 2 / Real.sqrt α * ψ t * Real.sqrt (ψ t))
    (hinit : ψ 0 = α * r ^ 2) (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) :
    Real.sqrt (ψ t) ≤ r * Real.sqrt α / (1 - r * t) := by
  sorry

/-- Rubrics 3–4 (two-sided integration, degenerate case included): if `φ ≥ 0` on `[0,1]` and
`|φ'| ≤ 2r φ/(1 - r t)` with `0 ≤ r < 1`, then
`(1 - r t)² φ(0) ≤ φ(t) ≤ φ(0)/(1 - r t)²`. [InteriorPointMethodsOn, node_06] -/
theorem two_sided_comparison (r : ℝ) (hr0 : 0 ≤ r) (hr1 : r < 1)
    (φ φ' : ℝ → ℝ) (hφ : ∀ t ∈ Set.Icc (0 : ℝ) 1, HasDerivWithinAt φ (φ' t) (Set.Icc 0 1) t)
    (hφ0 : ∀ t ∈ Set.Icc (0 : ℝ) 1, 0 ≤ φ t)
    (hφ' : ∀ t ∈ Set.Icc (0 : ℝ) 1, |φ' t| ≤ 2 * r / (1 - r * t) * φ t)
    (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) :
    (1 - r * t) ^ 2 * φ 0 ≤ φ t ∧ φ t ≤ φ 0 / (1 - r * t) ^ 2 := by
  sorry

/-! ## Main theorem -/

/-- **Hessian comparison along a geodesic.** With `q = Exp_p(u) = γ 1 ∈ D`,
`r = √(H_p(u,u)/α) < 1` and `τ v = V 1` for the parallel field `V` with `V 0 = v`:
`(1-r)² H_p(v,v) ≤ H_q(τv,τv) ≤ H_p(v,v)/(1-r)²`. [InteriorPointMethodsOn, node_06] -/
theorem hessian_comparison_along_geodesic {n : ℕ} (M : ChartMetric n) (hM : M.IsRiemannian)
    (D : Set (Fin n → ℝ)) (hD : IsGeodesicallyConvexSet M D) (f : (Fin n → ℝ) → ℝ)
    (hf3 : ContDiffOn ℝ 3 f D) (hfconv : IsGeodesicallyConvexFun M D f)
    (α : ℝ) (hα : 0 < α) (hsc : IsSelfConcordant M D f α)
    (p u : Fin n → ℝ) (hp : p ∈ D)
    (γ γ' : ℝ → Fin n → ℝ) (hγ : IsGeodesicOn M γ γ' 0 1) (hγ0 : γ 0 = p) (hγ'0 : γ' 0 = u)
    (hq : γ 1 ∈ D)
    (r : ℝ) (hr_def : r = Real.sqrt (hess M f p u u / α)) (hr : r < 1)
    (v : Fin n → ℝ) (V : ℝ → Fin n → ℝ) (hV : IsParallelAlong M γ γ' V 0 1) (hV0 : V 0 = v) :
    (1 - r) ^ 2 * hess M f p v v ≤ hess M f (γ 1) (V 1) (V 1) ∧
      hess M f (γ 1) (V 1) (V 1) ≤ hess M f p v v / (1 - r) ^ 2 := by
  sorry

end TCSChallenge.InteriorPointMethodsOnManifolds.node_06
