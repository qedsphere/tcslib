/-!
## Local quadratic convergence of the Riemannian Newton method for self-concordant functions

Let `(M, g)` be a geodesically complete Riemannian manifold, `D ⊆ M` open and geodesically
convex, `f ∈ C³(D)` geodesically convex with positive-definite Hessian `H = ∇²f`, whose
extension `f̄` by `+∞` outside `D` is lower semicontinuous, and which is α-self-concordant.
For `x ∈ D` let `n_x` minimise `v ↦ df_x(v) + ½ H_x(v,v)`, `λ(x) = √(H_x(n_x,n_x)/α)` and
`x_+ = Exp_x(n_x)`. If `λ(p) < 1` then `p_+ ∈ D` and `λ(p_+) ≤ (λ(p)/(1-λ(p)))²`.

Main theorem: `newton_step_feasible_and_quadratic`.
-/

namespace TCSChallenge.InteriorPointMethodsOnManifolds.node_09

open scoped BigOperators

/-! ## Shared framework: a Riemannian manifold in one global chart -/

/-- A (candidate) Riemannian manifold covered by a single global chart: the chart domain
`U ⊆ ℝⁿ` and the Gram matrix `g x` of the metric in coordinates at `x`. -/
structure ChartMetric (n : ℕ) where
  /-- the chart domain (the whole manifold) -/
  U : Set (Fin n → ℝ)
  /-- the metric coefficients `g_{ij}(x)` -/
  g : (Fin n → ℝ) → Matrix (Fin n) (Fin n) ℝ

/-- "Let `(M,g)` be a smooth Riemannian manifold": the domain is open, the metric
coefficients are `C^∞`, and the Gram matrix is positive definite (and symmetric) at each
point. -/
def ChartMetric.IsRiemannian {n : ℕ} (M : ChartMetric n) : Prop :=
  IsOpen M.U ∧
  (∀ i j : Fin n, ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x => M.g x i j) M.U) ∧
  (∀ x ∈ M.U, (M.g x).PosDef)

/-- Coordinate partial derivative `∂_k F (x)`. -/
noncomputable def partialD {n : ℕ} (F : (Fin n → ℝ) → ℝ) (k : Fin n) (x : Fin n → ℝ) : ℝ :=
  fderiv ℝ F x (Pi.single k 1)

/-- Christoffel symbols of the Levi-Civita connection,
`Γ^k_{ij} = ½ ∑_l g^{kl} (∂_i g_{jl} + ∂_j g_{il} - ∂_l g_{ij})`. -/
noncomputable def christoffel {n : ℕ} (M : ChartMetric n) (x : Fin n → ℝ) (k i j : Fin n) : ℝ :=
  (1 / 2 : ℝ) * ∑ l : Fin n, (M.g x)⁻¹ k l *
    (partialD (fun y => M.g y j l) i x + partialD (fun y => M.g y i l) j x
      - partialD (fun y => M.g y i j) l x)

/-- Components of the Riemannian Hessian `(∇²f)_{ij} = ∂_i ∂_j f - Γ^k_{ij} ∂_k f`. -/
noncomputable def hessComp {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x : Fin n → ℝ) (i j : Fin n) : ℝ :=
  partialD (fun y => partialD f j y) i x - ∑ k : Fin n, christoffel M x k i j * partialD f k x

/-- The Riemannian Hessian `H_x(a,b) = ∇²f_x(a,b)` as a bilinear form on `T_xM ≅ ℝⁿ`. -/
noncomputable def hess {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x a b : Fin n → ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, a i * b j * hessComp M f x i j

/-- The covariant derivative of the Hessian, `(∇_a H)_x(b,c) = ∇³f_x(a,b,c)`, with
`(∇_i H)_{jk} = ∂_i H_{jk} - Γ^l_{ij} H_{lk} - Γ^l_{ik} H_{jl}`. -/
noncomputable def covDerivHess {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x a b c : Fin n → ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, ∑ k : Fin n, a i * b j * c k *
    (partialD (fun y => hessComp M f y j k) i x
      - ∑ l : Fin n, christoffel M x l i j * hessComp M f x l k
      - ∑ l : Fin n, christoffel M x l i k * hessComp M f x j l)

/-- `γ` (with velocity field `γ'`) is a geodesic on `[a,b]`: it stays in the manifold,
`γ̇ = γ'`, and `γ̈^k = -Γ^k_{ij}(γ) γ̇^i γ̇^j` (one-sided derivatives at the endpoints). -/
def IsGeodesicOn {n : ℕ} (M : ChartMetric n) (γ γ' : ℝ → Fin n → ℝ) (a b : ℝ) : Prop :=
  ∀ t ∈ Set.Icc a b, γ t ∈ M.U ∧
    HasDerivWithinAt γ (γ' t) (Set.Icc a b) t ∧
    HasDerivWithinAt γ'
      (fun k => -∑ i : Fin n, ∑ j : Fin n, christoffel M (γ t) k i j * γ' t i * γ' t j)
      (Set.Icc a b) t

/-- `V` is a parallel vector field along the curve `γ` (velocity `γ'`) on `[a,b]`:
`V̇^k = -Γ^k_{ij}(γ) γ̇^i V^j`. -/
def IsParallelAlong {n : ℕ} (M : ChartMetric n) (γ γ' V : ℝ → Fin n → ℝ) (a b : ℝ) : Prop :=
  ∀ t ∈ Set.Icc a b,
    HasDerivWithinAt V
      (fun k => -∑ i : Fin n, ∑ j : Fin n, christoffel M (γ t) k i j * γ' t i * V t j)
      (Set.Icc a b) t

/-- "`D ⊆ M` is open and geodesically convex: every geodesic segment with endpoints in `D`
is contained in `D`." -/
def IsGeodesicallyConvexSet {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ)) : Prop :=
  D ⊆ M.U ∧ IsOpen D ∧
  ∀ γ γ' : ℝ → Fin n → ℝ, IsGeodesicOn M γ γ' 0 1 → γ 0 ∈ D → γ 1 ∈ D →
    ∀ t ∈ Set.Icc (0 : ℝ) 1, γ t ∈ D

/-- "`f` is geodesically convex on `D`": its restriction to every geodesic segment lying
in `D` is convex. -/
def IsGeodesicallyConvexFun {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ))
    (f : (Fin n → ℝ) → ℝ) : Prop :=
  ∀ (γ γ' : ℝ → Fin n → ℝ) (a b : ℝ), a < b → IsGeodesicOn M γ γ' a b →
    (∀ t ∈ Set.Icc a b, γ t ∈ D) → ConvexOn ℝ (Set.Icc a b) (f ∘ γ)

/-- α-self-concordance:
`|(∇_a H)_x(b,c)| ≤ (2/√α) √(H_x(a,a) H_x(b,b) H_x(c,c))` for `x ∈ D`, `a,b,c ∈ T_xM`. -/
def IsSelfConcordant {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ))
    (f : (Fin n → ℝ) → ℝ) (α : ℝ) : Prop :=
  ∀ x ∈ D, ∀ a b c : Fin n → ℝ,
    |covDerivHess M f x a b c|
      ≤ 2 / Real.sqrt α * Real.sqrt (hess M f x a a * hess M f x b b * hess M f x c c)

/-! ## Definitions specific to the Newton step -/

/-- "`(M,g)` is geodesically complete": from every point and in every direction there is a
geodesic defined on all of `ℝ`. -/
def IsGeodesicallyComplete {n : ℕ} (M : ChartMetric n) : Prop :=
  ∀ p ∈ M.U, ∀ u : Fin n → ℝ, ∃ γ γ' : ℝ → Fin n → ℝ,
    γ 0 = p ∧ γ' 0 = u ∧ ∀ a b : ℝ, a < b → IsGeodesicOn M γ γ' a b

/-- `f̄ : M → ℝ ∪ {+∞}`, equal to `f` on `D` and `+∞` off `D`. -/
noncomputable def extendByTop {n : ℕ} (D : Set (Fin n → ℝ)) (f : (Fin n → ℝ) → ℝ)
    (x : Fin n → ℝ) : EReal := by
  classical
  exact if x ∈ D then ((f x : ℝ) : EReal) else ⊤

/-- `nx` is a minimiser on `T_xM` of the Newton model `v ↦ df_x(v) + ½ H_x(v,v)`. -/
def IsNewtonVector {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x nx : Fin n → ℝ) : Prop :=
  ∀ v : Fin n → ℝ,
    fderiv ℝ f x nx + (1 / 2 : ℝ) * hess M f x nx nx
      ≤ fderiv ℝ f x v + (1 / 2 : ℝ) * hess M f x v v

/-- The local norm `‖v‖_{f,x,α} = √(H_x(v,v)/α)`. -/
noncomputable def localNorm {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ) (α : ℝ)
    (x v : Fin n → ℝ) : ℝ :=
  Real.sqrt (hess M f x v v / α)

/-! ## Lemma stubs -/

/-- Rubric 1: the two-sided Hessian comparison on the part of the Newton geodesic in `D`:
for parallel `V` and `t ∈ [0,1]` with `γ([0,t]) ⊆ D`,
`(1-tr)² H_p(v,v) ≤ H_{γ(t)}(V t, V t) ≤ H_p(v,v)/(1-tr)²` where `r = √(H_p(γ' 0,γ' 0)/α) < 1`. [InteriorPointMethodsOn, node_09] -/
theorem hessian_comparison_on_segment {n : ℕ} (M : ChartMetric n) (hM : M.IsRiemannian)
    (D : Set (Fin n → ℝ)) (hDsub : D ⊆ M.U) (hDopen : IsOpen D) (f : (Fin n → ℝ) → ℝ)
    (hf3 : ContDiffOn ℝ 3 f D) (hHpd : ∀ x ∈ D, ∀ v : Fin n → ℝ, v ≠ 0 → 0 < hess M f x v v)
    (α : ℝ) (hα : 0 < α) (hsc : IsSelfConcordant M D f α)
    (γ γ' V : ℝ → Fin n → ℝ) (hγ : IsGeodesicOn M γ γ' 0 1)
    (hV : IsParallelAlong M γ γ' V 0 1)
    (r : ℝ) (hr_def : r = localNorm M f α (γ 0) (γ' 0)) (hr : r < 1)
    (t : ℝ) (ht : t ∈ Set.Icc (0 : ℝ) 1) (hγD : ∀ s ∈ Set.Icc (0 : ℝ) t, γ s ∈ D) :
    (1 - t * r) ^ 2 * hess M f (γ 0) (V 0) (V 0) ≤ hess M f (γ t) (V t) (V t) ∧
      hess M f (γ t) (V t) (V t) ≤ hess M f (γ 0) (V 0) (V 0) / (1 - t * r) ^ 2 := by
  sorry

/-- Rubric 2 (domain feasibility, first-exit argument): the whole Newton segment lies in `D`. [InteriorPointMethodsOn, node_09] -/
theorem newton_segment_mem {n : ℕ} (M : ChartMetric n) (hM : M.IsRiemannian)
    (hcomplete : IsGeodesicallyComplete M)
    (D : Set (Fin n → ℝ)) (hD : IsGeodesicallyConvexSet M D) (f : (Fin n → ℝ) → ℝ)
    (hf3 : ContDiffOn ℝ 3 f D) (hfconv : IsGeodesicallyConvexFun M D f)
    (hHpd : ∀ x ∈ D, ∀ v : Fin n → ℝ, v ≠ 0 → 0 < hess M f x v v)
    (hlsc : LowerSemicontinuousOn (extendByTop D f) M.U)
    (α : ℝ) (hα : 0 < α) (hsc : IsSelfConcordant M D f α)
    (p np : Fin n → ℝ) (hp : p ∈ D) (hnp : IsNewtonVector M f p np)
    (hlam : localNorm M f α p np < 1)
    (γ γ' : ℝ → Fin n → ℝ) (hγ : IsGeodesicOn M γ γ' 0 1) (hγ0 : γ 0 = p) (hγ'0 : γ' 0 = np) :
    ∀ t ∈ Set.Icc (0 : ℝ) 1, γ t ∈ D := by
  sorry

/-- Rubric 3 (Newton cancellation): with `P_t v = V t` parallel,
`df_q(P_1 v) = ∫₀¹ (H_{γ(t)}(γ̇ t, V t) - H_p(n, v)) dt`. [InteriorPointMethodsOn, node_09] -/
theorem newton_residual_identity {n : ℕ} (M : ChartMetric n) (hM : M.IsRiemannian)
    (D : Set (Fin n → ℝ)) (hDsub : D ⊆ M.U) (hDopen : IsOpen D) (f : (Fin n → ℝ) → ℝ)
    (hf3 : ContDiffOn ℝ 3 f D)
    (p np : Fin n → ℝ) (hp : p ∈ D) (hnp : IsNewtonVector M f p np)
    (hHpd : ∀ v : Fin n → ℝ, v ≠ 0 → 0 < hess M f p v v)
    (γ γ' V : ℝ → Fin n → ℝ) (hγ : IsGeodesicOn M γ γ' 0 1) (hγ0 : γ 0 = p) (hγ'0 : γ' 0 = np)
    (hγD : ∀ t ∈ Set.Icc (0 : ℝ) 1, γ t ∈ D) (hV : IsParallelAlong M γ γ' V 0 1) :
    fderiv ℝ f (γ 1) (V 1)
      = ∫ t in (0 : ℝ)..1, (hess M f (γ t) (γ' t) (V t) - hess M f p np (V 0)) := by
  sorry

/-- Rubric 5 (mixed directions): a symmetric bilinear form `B` with `|B(v,v)| ≤ c H(v,v)` for a
positive-definite symmetric `H` satisfies `|B(u,v)| ≤ c √H(u,u) √H(v,v)`. [InteriorPointMethodsOn, node_09] -/
theorem mixed_bound_of_diagonal {n : ℕ} (B H : (Fin n → ℝ) →ₗ[ℝ] (Fin n → ℝ) →ₗ[ℝ] ℝ)
    (hB : ∀ u v, B u v = B v u) (hH : ∀ u v, H u v = H v u)
    (hHpd : ∀ v : Fin n → ℝ, v ≠ 0 → 0 < H v v) (c : ℝ)
    (hdiag : ∀ v, |B v v| ≤ c * H v v) (u v : Fin n → ℝ) :
    |B u v| ≤ c * Real.sqrt (H u u) * Real.sqrt (H v v) := by
  sorry

/-- Rubric 6 (dual characterisation of the decrement): `|df_x(w)| ≤ √(α H_x(w,w)) · λ(x)`,
with equality at `w = n_x`. [InteriorPointMethodsOn, node_09] -/
theorem decrement_dual {n : ℕ} (M : ChartMetric n) (hM : M.IsRiemannian)
    (D : Set (Fin n → ℝ)) (hDopen : IsOpen D) (f : (Fin n → ℝ) → ℝ) (hf3 : ContDiffOn ℝ 3 f D)
    (hHpd : ∀ x ∈ D, ∀ v : Fin n → ℝ, v ≠ 0 → 0 < hess M f x v v)
    (α : ℝ) (hα : 0 < α) (x nx : Fin n → ℝ) (hx : x ∈ D) (hnx : IsNewtonVector M f x nx) :
    (∀ w : Fin n → ℝ,
      |fderiv ℝ f x w| ≤ Real.sqrt (α * hess M f x w w) * localNorm M f α x nx) ∧
    |fderiv ℝ f x nx| = Real.sqrt (α * hess M f x nx nx) * localNorm M f α x nx := by
  sorry

/-! ## Main theorem -/

/-- **Feasibility and quadratic convergence of the Riemannian Newton step.** If `λ(p) < 1`,
then `p_+ = Exp_p(n_p) ∈ D` and `λ(p_+) ≤ (λ(p)/(1-λ(p)))²`. [InteriorPointMethodsOn, node_09] -/
theorem newton_step_feasible_and_quadratic {n : ℕ} (M : ChartMetric n) (hM : M.IsRiemannian)
    (hcomplete : IsGeodesicallyComplete M)
    (D : Set (Fin n → ℝ)) (hD : IsGeodesicallyConvexSet M D) (f : (Fin n → ℝ) → ℝ)
    (hf3 : ContDiffOn ℝ 3 f D) (hfconv : IsGeodesicallyConvexFun M D f)
    (hHpd : ∀ x ∈ D, ∀ v : Fin n → ℝ, v ≠ 0 → 0 < hess M f x v v)
    (hlsc : LowerSemicontinuousOn (extendByTop D f) M.U)
    (α : ℝ) (hα : 0 < α) (hsc : IsSelfConcordant M D f α)
    (p np : Fin n → ℝ) (hp : p ∈ D) (hnp : IsNewtonVector M f p np)
    (hlam : localNorm M f α p np < 1)
    (γ γ' : ℝ → Fin n → ℝ) (hγ : IsGeodesicOn M γ γ' 0 1) (hγ0 : γ 0 = p) (hγ'0 : γ' 0 = np) :
    γ 1 ∈ D ∧
      ∀ nq : Fin n → ℝ, IsNewtonVector M f (γ 1) nq →
        localNorm M f α (γ 1) nq
          ≤ (localNorm M f α p np / (1 - localNorm M f α p np)) ^ 2 := by
  sorry

