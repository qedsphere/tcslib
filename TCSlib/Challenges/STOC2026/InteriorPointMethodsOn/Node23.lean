/-!
## Self-concordance of the squared distance in hyperbolic space

On hyperbolic space of curvature `-κ`, let `f = d(·,p₀)²`, `g = d(·,p₀)`, `H = ∇²f`,
`T(w,u,v) = (∇_w H)(u,v)`, `Q_p(v) = H_p(v,v) - 2 dg_p(v)²` and
`ζ = sup_x |1/sinh x - 1/x|`. Then `f` is geodesically convex, `ζ ≤ 1/2`, `Q_p ≥ 0`,
`|T(w,u,u)| ≤ √(κ/2) √H(w,w) H(u,u)`, `|T(u,u,u)| ≤ √(8κ/27) H(u,u)^{3/2}`,
`|T(w,u,u)| ≤ 2ζ√κ |dg(w)| Q(u) + 2√κ |dg(u)| √Q(u) √Q(w)`; both constants are sharp (already in
dimension two); `f` is `(8/κ)`-self-concordant and its optimal parameter along geodesics is
`27/(2κ)`.

Main theorem: `hyperbolic_sqDist_selfConcordance`.
-/

namespace TCSChallenge.InteriorPointMethodsOnManifolds.node_23

open scoped BigOperators

/-! ## Shared framework: a Riemannian manifold in one global chart -/

/-- A (candidate) Riemannian manifold covered by a single global chart: the chart domain
`U ⊆ ℝⁿ` and the Gram matrix `g x` of the metric in coordinates at `x`. -/
structure ChartMetric (n : ℕ) where
  /-- the chart domain (the whole manifold) -/
  U : Set (Fin n → ℝ)
  /-- the metric coefficients `g_{ij}(x)` -/
  g : (Fin n → ℝ) → Matrix (Fin n) (Fin n) ℝ

/-- "Let `(M,g)` be a smooth Riemannian manifold": the domain is open, the metric
coefficients are `C^∞`, and the Gram matrix is positive definite (and symmetric) at each
point. -/
def ChartMetric.IsRiemannian {n : ℕ} (M : ChartMetric n) : Prop :=
  IsOpen M.U ∧
  (∀ i j : Fin n, ContDiffOn ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun x => M.g x i j) M.U) ∧
  (∀ x ∈ M.U, (M.g x).PosDef)

/-- Coordinate partial derivative `∂_k F (x)`. -/
noncomputable def partialD {n : ℕ} (F : (Fin n → ℝ) → ℝ) (k : Fin n) (x : Fin n → ℝ) : ℝ :=
  fderiv ℝ F x (Pi.single k 1)

/-- Christoffel symbols of the Levi-Civita connection,
`Γ^k_{ij} = ½ ∑_l g^{kl} (∂_i g_{jl} + ∂_j g_{il} - ∂_l g_{ij})`. -/
noncomputable def christoffel {n : ℕ} (M : ChartMetric n) (x : Fin n → ℝ) (k i j : Fin n) : ℝ :=
  (1 / 2 : ℝ) * ∑ l : Fin n, (M.g x)⁻¹ k l *
    (partialD (fun y => M.g y j l) i x + partialD (fun y => M.g y i l) j x
      - partialD (fun y => M.g y i j) l x)

/-- Components of the Riemannian Hessian `(∇²f)_{ij} = ∂_i ∂_j f - Γ^k_{ij} ∂_k f`. -/
noncomputable def hessComp {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x : Fin n → ℝ) (i j : Fin n) : ℝ :=
  partialD (fun y => partialD f j y) i x - ∑ k : Fin n, christoffel M x k i j * partialD f k x

/-- The Riemannian Hessian `H_x(a,b) = ∇²f_x(a,b)` as a bilinear form on `T_xM ≅ ℝⁿ`. -/
noncomputable def hess {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x a b : Fin n → ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, a i * b j * hessComp M f x i j

/-- The covariant derivative of the Hessian, `(∇_a H)_x(b,c) = ∇³f_x(a,b,c)`, with
`(∇_i H)_{jk} = ∂_i H_{jk} - Γ^l_{ij} H_{lk} - Γ^l_{ik} H_{jl}`. -/
noncomputable def covDerivHess {n : ℕ} (M : ChartMetric n) (f : (Fin n → ℝ) → ℝ)
    (x a b c : Fin n → ℝ) : ℝ :=
  ∑ i : Fin n, ∑ j : Fin n, ∑ k : Fin n, a i * b j * c k *
    (partialD (fun y => hessComp M f y j k) i x
      - ∑ l : Fin n, christoffel M x l i j * hessComp M f x l k
      - ∑ l : Fin n, christoffel M x l i k * hessComp M f x j l)

/-- `γ` (with velocity field `γ'`) is a geodesic on `[a,b]`: it stays in the manifold,
`γ̇ = γ'`, and `γ̈^k = -Γ^k_{ij}(γ) γ̇^i γ̇^j` (one-sided derivatives at the endpoints). -/
def IsGeodesicOn {n : ℕ} (M : ChartMetric n) (γ γ' : ℝ → Fin n → ℝ) (a b : ℝ) : Prop :=
  ∀ t ∈ Set.Icc a b, γ t ∈ M.U ∧
    HasDerivWithinAt γ (γ' t) (Set.Icc a b) t ∧
    HasDerivWithinAt γ'
      (fun k => -∑ i : Fin n, ∑ j : Fin n, christoffel M (γ t) k i j * γ' t i * γ' t j)
      (Set.Icc a b) t

/-- `V` is a parallel vector field along the curve `γ` (velocity `γ'`) on `[a,b]`:
`V̇^k = -Γ^k_{ij}(γ) γ̇^i V^j`. -/
def IsParallelAlong {n : ℕ} (M : ChartMetric n) (γ γ' V : ℝ → Fin n → ℝ) (a b : ℝ) : Prop :=
  ∀ t ∈ Set.Icc a b,
    HasDerivWithinAt V
      (fun k => -∑ i : Fin n, ∑ j : Fin n, christoffel M (γ t) k i j * γ' t i * V t j)
      (Set.Icc a b) t

/-- "`D ⊆ M` is open and geodesically convex: every geodesic segment with endpoints in `D`
is contained in `D`." -/
def IsGeodesicallyConvexSet {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ)) : Prop :=
  D ⊆ M.U ∧ IsOpen D ∧
  ∀ γ γ' : ℝ → Fin n → ℝ, IsGeodesicOn M γ γ' 0 1 → γ 0 ∈ D → γ 1 ∈ D →
    ∀ t ∈ Set.Icc (0 : ℝ) 1, γ t ∈ D

/-- "`f` is geodesically convex on `D`": its restriction to every geodesic segment lying
in `D` is convex. -/
def IsGeodesicallyConvexFun {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ))
    (f : (Fin n → ℝ) → ℝ) : Prop :=
  ∀ (γ γ' : ℝ → Fin n → ℝ) (a b : ℝ), a < b → IsGeodesicOn M γ γ' a b →
    (∀ t ∈ Set.Icc a b, γ t ∈ D) → ConvexOn ℝ (Set.Icc a b) (f ∘ γ)

/-- α-self-concordance:
`|(∇_a H)_x(b,c)| ≤ (2/√α) √(H_x(a,a) H_x(b,b) H_x(c,c))` for `x ∈ D`, `a,b,c ∈ T_xM`. -/
def IsSelfConcordant {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ))
    (f : (Fin n → ℝ) → ℝ) (α : ℝ) : Prop :=
  ∀ x ∈ D, ∀ a b c : Fin n → ℝ,
    |covDerivHess M f x a b c|
      ≤ 2 / Real.sqrt α * Real.sqrt (hess M f x a a * hess M f x b b * hess M f x c c)

/-! ## Definitions specific to hyperbolic space -/

/-- "α-self-concordant along geodesics": the self-concordance inequality only for
`x = y = z`. (Geodesic convexity is part of the problem's definition and is asserted
separately in the main theorem.) -/
def IsSelfConcordantAlongGeodesics {n : ℕ} (M : ChartMetric n) (D : Set (Fin n → ℝ))
    (f : (Fin n → ℝ) → ℝ) (α : ℝ) : Prop :=
  ∀ x ∈ D, ∀ a : Fin n → ℝ,
    |covDerivHess M f x a a a|
      ≤ 2 / Real.sqrt α * Real.sqrt (hess M f x a a * hess M f x a a * hess M f x a a)

/-- Upper half-space model of the complete simply connected `(m+1)`-manifold of constant
sectional curvature `-κ`: `U = {x_{m+1} > 0}`, `g_{ij}(x) = δ_{ij} / (κ x_{m+1}²)`. -/
noncomputable def hyperbolicHalfSpace (m : ℕ) (κ : ℝ) : ChartMetric (m + 1) where
  U := {x | 0 < x (Fin.last m)}
  g := fun x => (1 / (κ * x (Fin.last m) ^ 2)) • (1 : Matrix (Fin (m + 1)) (Fin (m + 1)) ℝ)

/-- `arcosh z = log (z + √(z² - 1))` (for `z ≥ 1`). -/
noncomputable def arcoshReal (z : ℝ) : ℝ :=
  Real.log (z + Real.sqrt (z ^ 2 - 1))

/-- Riemannian distance of the curvature `-κ` half-space:
`d(x,y) = κ^{-1/2} arcosh (1 + |x - y|² / (2 x_{m+1} y_{m+1}))`. -/
noncomputable def hypDist (m : ℕ) (κ : ℝ) (x y : Fin (m + 1) → ℝ) : ℝ :=
  1 / Real.sqrt κ *
    arcoshReal (1 + (∑ i : Fin (m + 1), (x i - y i) ^ 2) /
      (2 * x (Fin.last m) * y (Fin.last m)))

/-- `f(p) = d(p, p₀)²`. -/
noncomputable def sqDist (m : ℕ) (κ : ℝ) (p₀ : Fin (m + 1) → ℝ) (p : Fin (m + 1) → ℝ) : ℝ :=
  hypDist m κ p p₀ ^ 2

/-- `g(p) = d(p, p₀)`. -/
noncomputable def distFrom (m : ℕ) (κ : ℝ) (p₀ : Fin (m + 1) → ℝ) (p : Fin (m + 1) → ℝ) : ℝ :=
  hypDist m κ p p₀

/-- `H = ∇²f`. -/
noncomputable def Hf (m : ℕ) (κ : ℝ) (p₀ p u v : Fin (m + 1) → ℝ) : ℝ :=
  hess (hyperbolicHalfSpace m κ) (sqDist m κ p₀) p u v

/-- `T(w,u,v) = (∇_w H)(u,v) = ∇³f(w,u,v)`. -/
noncomputable def Tf (m : ℕ) (κ : ℝ) (p₀ p w u v : Fin (m + 1) → ℝ) : ℝ :=
  covDerivHess (hyperbolicHalfSpace m κ) (sqDist m κ p₀) p w u v

/-- `dg_p(v)`. -/
noncomputable def dg (m : ℕ) (κ : ℝ) (p₀ p v : Fin (m + 1) → ℝ) : ℝ :=
  fderiv ℝ (distFrom m κ p₀) p v

/-- `Q_p(v) = H_p(v,v) - 2 dg_p(v)²` (for `p ≠ p₀`). -/
noncomputable def Qf (m : ℕ) (κ : ℝ) (p₀ p v : Fin (m + 1) → ℝ) : ℝ :=
  Hf m κ p₀ p v v - 2 * dg m κ p₀ p v ^ 2

/-- `x ↦ 1/sinh x - 1/x`, extended continuously by `0` at `x = 0`. -/
noncomputable def zetaFun (x : ℝ) : ℝ :=
  if x = 0 then 0 else 1 / Real.sinh x - 1 / x

/-- `ζ = sup_{x ∈ ℝ} |1/sinh x - 1/x|`. -/
noncomputable def zeta : ℝ :=
  ⨆ x : ℝ, |zetaFun x|

