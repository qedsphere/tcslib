/-! ## Main theorem -/

/-- **Self-concordance of the hyperbolic squared distance**, all assertions together. [InteriorPointMethodsOn, node_23] -/
theorem hyperbolic_sqDist_selfConcordance (m : ℕ) (hm : 1 ≤ m) (κ : ℝ) (hκ : 0 < κ)
    (p₀ : Fin (m + 1) → ℝ) (hp₀ : p₀ ∈ (hyperbolicHalfSpace m κ).U) :
    IsGeodesicallyConvexFun (hyperbolicHalfSpace m κ) (hyperbolicHalfSpace m κ).U
        (sqDist m κ p₀) ∧
    zeta ≤ 1 / 2 ∧
    (∀ p ∈ (hyperbolicHalfSpace m κ).U, p ≠ p₀ → ∀ v, 0 ≤ Qf m κ p₀ p v) ∧
    (∀ p ∈ (hyperbolicHalfSpace m κ).U, ∀ u w : Fin (m + 1) → ℝ,
      |Tf m κ p₀ p w u u|
        ≤ Real.sqrt (κ / 2) * Real.sqrt (Hf m κ p₀ p w w) * Hf m κ p₀ p u u) ∧
    (∀ p ∈ (hyperbolicHalfSpace m κ).U, ∀ u : Fin (m + 1) → ℝ,
      |Tf m κ p₀ p u u u|
        ≤ Real.sqrt (8 * κ / 27) * (Hf m κ p₀ p u u * Real.sqrt (Hf m κ p₀ p u u))) ∧
    (∀ p ∈ (hyperbolicHalfSpace m κ).U, p ≠ p₀ → ∀ u w : Fin (m + 1) → ℝ,
      |Tf m κ p₀ p w u u|
        ≤ 2 * zeta * Real.sqrt κ * |dg m κ p₀ p w| * Qf m κ p₀ p u
