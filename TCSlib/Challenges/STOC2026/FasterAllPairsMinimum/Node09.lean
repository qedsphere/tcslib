/-!
## Exact all-pairs minimum cut from a friendly contraction plus degrees

Let `G` be a finite simple graph on `V` (`n = |V|`). For `S ⊆ V`,
`cut_G(S) = |E(S, V \ S)|` and `λ_G(s,t) = min {cut_G(S) : s ∈ S, t ∉ S}`.
A cut `S` is `α`-friendly if `1 - cr_S(v)/deg(v) ≥ α` for every nonisolated `v`.
A partition `𝒫` of `V` (given by a block map `block : V → ι`) is an
`(α, w)`-friendly contraction if every `α`-friendly cut of value `≤ w` is a union
of blocks.

The strategy chooses `α = 1/6`, `w = 2n`, recovers all inter-block edges and exact
degrees in a second pass, and builds the weighted graph `H_ap` on `V ⊕ ι`:
every inter-block edge of `G` with its original endpoints (weight 1), and for each
block `B` a proxy vertex joined to each `v ∈ B` with weight `d_B(v)` (the number of
neighbours of `v` inside `B`, which equals `deg v` minus the recovered external
degree).

Main theorem `apmc_exact`: if `G` has no vertex of degree one and `block` is a
`(1/6, 2n)`-friendly contraction, then for all `s ≠ t`
* `λ_{H_ap}(s,t) = λ_G(s,t)`, and
* every minimum `s,t`-cut of `H_ap` projects to a minimum `s,t`-cut of `G`
  with the same value.

Minimum `s,t`-cuts of `G` are the minimum cuts of TCSlib's unit-capacity network
`stNetwork G s t hst` (`Networks.Network.IsMinCut`), whose `capOf` equals `cutG`.
The proof routes through the structural dichotomy for inclusion-minimal minimum
cuts (`minimal_minCut_dichotomy`), domination of every `H_ap` cut by its projection
(`proxy_domination`), and equal-value lifts (`friendly_lift`, `exception_lift`).
-/

namespace TCSChallenge.FasterAllPairsMinimum.node_09

open Finset

variable {V : Type} [Fintype V] [DecidableEq V]

/-- Degree of `v` in `G`: number of neighbours. -/
def deg (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) : ℕ :=
  (univ.filter (fun w => G.Adj v w)).card

/-- "`cut_G(S) = |E(S, V \ S)|`": ordered pairs `(x, y)` with `x ∈ S`, `y ∉ S`
adjacent; each crossing undirected edge is counted exactly once. -/
def cutG (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V) : ℕ :=
  ((S ×ˢ Sᶜ).filter (fun p => G.Adj p.1 p.2)).card

/-- "`cr_S(v)` is the number of edges incident to `v` that cross the cut
`(S, V \ S)`". -/
def cr (G : SimpleGraph V) [DecidableRel G.Adj] (S : Finset V) (v : V) : ℕ :=
  (univ.filter (fun w => G.Adj v w ∧ (w ∈ S ↔ v ∉ S))).card

/-- "A cut is `α`-friendly if `1 - cr_S(v)/deg_G(v) ≥ α` for every nonisolated
vertex `v`." Stated division-free as `cr_S(v) ≤ (1 - α) deg(v)`, which is
equivalent when `deg v > 0`. -/
def IsFriendly (G : SimpleGraph V) [DecidableRel G.Adj] (α : ℝ) (S : Finset V) :
    Prop :=
  ∀ v, deg G v ≠ 0 → ((cr G S v : ℕ) : ℝ) ≤ (1 - α) * (deg G v : ℝ)

/-- `S` is an `s,t`-cut: `s ∈ S`, `t ∉ S`. -/
def IsSTCut (s t : V) (S : Finset V) : Prop := s ∈ S ∧ t ∉ S

/-- The unit-capacity `s,t`-network of `G` (TCSlib `Networks.Network`); its
`capOf S = ∑_{u ∈ S} ∑_{v ∉ S} [u ~ v]` is `cutG G S`. -/
def stNetwork (G : SimpleGraph V) [DecidableRel G.Adj] (s t : V) (h : s ≠ t) :
    Networks.Network V where
  cap u v := if G.Adj u v then 1 else 0
  X := {s}; Y := {t}; x := s; y := t
  hdisj := Finset.disjoint_singleton.mpr h
  hX := Finset.singleton_nonempty s
  hY := Finset.singleton_nonempty t

/-- `S` is a minimum `s,t`-cut of `G` (a minimum cut of the unit-capacity network). -/
def IsMinCut (G : SimpleGraph V) [DecidableRel G.Adj] (s t : V) (hst : s ≠ t)
    (S : Finset V) : Prop :=
  (stNetwork G s t hst).IsMinCut S

/-- An inclusion-minimal minimum `s,t`-cut side. -/
def IsMinimalMinCut (G : SimpleGraph V) [DecidableRel G.Adj] (s t : V) (hst : s ≠ t)
    (S : Finset V) : Prop :=
  IsMinCut G s t hst S ∧ ∀ S' : Finset V, IsMinCut G s t hst S' → S' ⊆ S → S' = S

/-- "`λ_G(s,t) = min{cut_G(S) : s ∈ S, t ∉ S}`" (the set is nonempty for `s ≠ t`). -/
def lam (G : SimpleGraph V) [DecidableRel G.Adj] (s t : V) : ℕ :=
  sInf {k : ℕ | ∃ S : Finset V, IsSTCut s t S ∧ cutG G S = k}

section Partition

variable {ι : Type} [Fintype ι] [DecidableEq ι]

/-- `S` is a union of blocks of the partition `{block⁻¹(b)}`. -/
def IsUnionOfBlocks (block : V → ι) (S : Finset V) : Prop :=
  ∀ u v, block u = block v → (u ∈ S ↔ v ∈ S)

/-- "`𝒫` defines an `(α,w)`-friendly contraction if every `α`-friendly cut of value
at most `w` is a union of blocks of `𝒫`" (such a cut is then automatically
represented with its exact value in the contracted multigraph, since all its
crossing edges are inter-block). -/
def IsFriendlyContraction (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι)
    (α : ℝ) (w : ℕ) : Prop :=
  ∀ S : Finset V, IsFriendly G α S → cutG G S ≤ w → IsUnionOfBlocks block S

/-- External degree of `v`: number of recovered inter-block edges at `v`. -/
def extDeg (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι) (v : V) : ℕ :=
  (univ.filter (fun w => G.Adj v w ∧ block w ≠ block v)).card

/-- "`d_B(v)`": number of neighbours of `v` inside its own block `B`. -/
def internalDeg (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι) (v : V) :
    ℕ :=
  (univ.filter (fun w => G.Adj v w ∧ block w = block v)).card

/-- The weighted graph `H_ap` on `V ⊕ ι` (symmetric weight function):
"reconnect every recovered inter-block edge to its original endpoints, add one
proxy vertex for each block, connect the proxy of `B` to every `v ∈ B` with weight
`d_B(v)`". -/
def proxyWeight (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι) :
    V ⊕ ι → V ⊕ ι → ℕ
  | Sum.inl u, Sum.inl v => if G.Adj u v ∧ block u ≠ block v then 1 else 0
  | Sum.inl u, Sum.inr b => if block u = b then internalDeg G block u else 0
  | Sum.inr b, Sum.inl u => if block u = b then internalDeg G block u else 0
  | Sum.inr _, Sum.inr _ => 0

/-- Weighted cut value `∑_{x ∈ T, y ∉ T} wt(x, y)` on a finite vertex type. -/
def cutW {W : Type} [Fintype W] [DecidableEq W] (wt : W → W → ℕ) (T : Finset W) :
    ℕ :=
  ∑ x ∈ T, ∑ y ∈ Tᶜ, wt x y

/-- Cut value in `H_ap`. -/
def cutH (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι)
    (T : Finset (V ⊕ ι)) : ℕ :=
  cutW (proxyWeight G block) T

/-- Projection of a cut of `H_ap` to the original vertices. -/
def proj (T : Finset (V ⊕ ι)) : Finset V :=
  univ.filter (fun v => Sum.inl v ∈ T)

/-- Minimum `s,t`-cut of `H_ap` (terminals are original vertices). -/
def IsMinCutH (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι) (s t : V)
    (T : Finset (V ⊕ ι)) : Prop :=
  (Sum.inl s ∈ T ∧ Sum.inl t ∉ T) ∧
    ∀ T' : Finset (V ⊕ ι), Sum.inl s ∈ T' → Sum.inl t ∉ T' →
      cutH G block T ≤ cutH G block T'

/-- `λ_{H_ap}(s,t)`. -/
def lamH (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι) (s t : V) : ℕ :=
  sInf {k : ℕ | ∃ T : Finset (V ⊕ ι), Sum.inl s ∈ T ∧ Sum.inl t ∉ T ∧
    cutH G block T = k}

/-! ## Lemma stubs -/

/-- Inclusion-minimal minimum cuts exist for distinct terminals. [FasterAllPairsMinimum, node_09] -/
theorem exists_minimalMinCut (G : SimpleGraph V) [DecidableRel G.Adj] (s t : V)
    (hst : s ≠ t) : ∃ S : Finset V, IsMinimalMinCut G s t hst S := by
  sorry

/-- Local optimality: in an inclusion-minimal minimum cut every nonterminal inside
`S` has `2 cr < deg` and every nonterminal outside has `2 cr ≤ deg`. [FasterAllPairsMinimum, node_09] -/
theorem minimalMinCut_nonterminal_half (G : SimpleGraph V) [DecidableRel G.Adj]
    (s t : V) (hst : s ≠ t) (S : Finset V) (hS : IsMinimalMinCut G s t hst S) (v : V)
    (hvs : v ≠ s) (hvt : v ≠ t) :
    (v ∈ S → deg G v ≠ 0 → 2 * cr G S v < deg G v) ∧
    (v ∉ S → 2 * cr G S v ≤ deg G v) := by
  sorry

/-- Structural bridge: an inclusion-minimal minimum `s,t`-cut (in a graph without
degree-one vertices) is `1/6`-friendly, or removing the exceptional terminal `s`
(resp. adding `t`) leaves a `1/6`-friendly cut of value at most `2 deg(s)`
(resp. `2 deg(t)`). [FasterAllPairsMinimum, node_09] -/
theorem minimal_minCut_dichotomy (G : SimpleGraph V) [DecidableRel G.Adj]
    (hdeg : ∀ v, deg G v ≠ 1) (s t : V) (hst : s ≠ t) (S : Finset V)
    (hS : IsMinimalMinCut G s t hst S) :
    IsFriendly G (1 / 6) S ∨
    (IsFriendly G (1 / 6) (S.erase s) ∧ cutG G (S.erase s) ≤ 2 * deg G s) ∨
    (IsFriendly G (1 / 6) (insert t S) ∧ cutG G (insert t S) ≤ 2 * deg G t) := by
  sorry

/-- The intra-block degrees are determined by exact degrees and recovered
inter-block edges: `d_B(v) = deg(v) - extDeg(v)`. [FasterAllPairsMinimum, node_09] -/
theorem internalDeg_eq (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι) (v : V) :
    internalDeg G block v = deg G v - extDeg G block v := by
  sorry

/-- Domination: every cut of `H_ap` costs at least the `G`-cut of its projection. [FasterAllPairsMinimum, node_09] -/
theorem proxy_domination (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι)
    (T : Finset (V ⊕ ι)) : cutG G (proj T) ≤ cutH G block T := by
  sorry

/-- Friendly lift: a union of blocks has an equal-valued lift (each proxy on its
block's side). [FasterAllPairsMinimum, node_09] -/
theorem friendly_lift (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι)
    (S : Finset V) (hS : IsUnionOfBlocks block S) :
    ∃ T : Finset (V ⊕ ι), proj T = S ∧ cutH G block T = cutG G S := by
  sorry

/-- Terminal-exception lift: if `S.erase s` is a union of blocks (and `s ∈ S`), then
`S` has an equal-valued lift (proxy of `s`'s block placed opposite `s`). [FasterAllPairsMinimum, node_09] -/
theorem exception_lift (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι)
    (S : Finset V) (s : V) (hs : s ∈ S) (hX : IsUnionOfBlocks block (S.erase s)) :
    ∃ T : Finset (V ⊕ ι), proj T = S ∧ cutH G block T = cutG G S := by
  sorry

/-- Symmetric terminal-exception lift for `t`: if `insert t S` is a union of blocks
(and `t ∉ S`), then `S` has an equal-valued lift (proxy of `t`'s block placed
opposite `t`, i.e. inside the lift). [FasterAllPairsMinimum, node_09] -/
theorem exception_lift_t (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι)
    (S : Finset V) (t : V) (ht : t ∉ S) (hX : IsUnionOfBlocks block (insert t S)) :
    ∃ T : Finset (V ⊕ ι), proj T = S ∧ cutH G block T = cutG G S := by
  sorry

/-! ## Main theorem -/

/-- Exact all-pairs minimum cut from the `(1/6, 2n)`-friendly contraction plus the
degree-based proxy gadget: values agree for every pair, and every minimum cut of
`H_ap` projects to a minimum cut of `G` of the same value. [FasterAllPairsMinimum, node_09] -/
theorem apmc_exact (G : SimpleGraph V) [DecidableRel G.Adj] (block : V → ι)
    (hdeg : ∀ v, deg G v ≠ 1)
    (hP : IsFriendlyContraction G block (1 / 6) (2 * Fintype.card V)) :
    ∀ s t : V, ∀ hst : s ≠ t,
      lamH G block s t = lam G s t ∧
      (∃ T : Finset (V ⊕ ι), IsMinCutH G block s t T) ∧
      ∀ T : Finset (V ⊕ ι), IsMinCutH G block s t T →
        IsMinCut G s t hst (proj T) ∧ cutG G (proj T) = cutH G block T := by
  sorry

end Partition

end TCSChallenge.FasterAllPairsMinimum.node_09
