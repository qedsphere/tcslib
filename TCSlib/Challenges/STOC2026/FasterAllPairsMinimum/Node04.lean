/-!
## All-pairs minimum cut from a friendly contraction (combinatorial core)

Let `G` be a finite simple graph. For distinct `s, t`, `λ_G(s,t)` is the minimum number of
edges crossing a vertex set separating `s` from `t`. A partition `blk : V → B` *preserves*
the `1/6`-friendly cuts of value at most `w` if each such cut is a union of parts.

From such a partition and the inter-part edges one builds the weighted auxiliary graph `K`
on `V ⊕ B`: inter-part edges with weight 1, and for each `v` an edge `v — p_{blk v}` of weight
`a_v`, the number of neighbours of `v` in its own part. The main theorem `aux_exact` states
that `λ_K(s,t) = λ_G(s,t)` and that the restriction to `V` of every minimum `s,t`-cut of `K`
is a minimum `s,t`-cut of `G`, provided `G` has no vertex of degree one and `2 deg v ≤ w`.
The peeling lemmas reduce an arbitrary graph to this situation.
-/

namespace TCSChallenge.FasterAllPairsMinimumCut.node_04

/-- `cut_G(A) = |E(A, V \ A)|`, counted as ordered pairs `(u, v)` with `u ∈ A`, `v ∉ A`. -/
def cutVal {V : Type} [Fintype V] (G : SimpleGraph V) (A : Finset V) : ℕ :=
  (Finset.univ.filter (fun p : V × V => p.1 ∈ A ∧ p.2 ∉ A ∧ G.Adj p.1 p.2)).card

/-- `d(v) = deg_G(v)`. -/
def deg {V : Type} [Fintype V] (G : SimpleGraph V) (v : V) : ℕ :=
  (Finset.univ.filter (fun w => G.Adj v w)).card

/-- `cr_A(v)`: "the number of edges incident to v that cross the cut (A, V \ A)". -/
def crossDeg {V : Type} [Fintype V] (G : SimpleGraph V) (A : Finset V) (v : V) : ℕ :=
  (Finset.univ.filter (fun w => G.Adj v w ∧ (w ∈ A ↔ v ∉ A))).card

/-- "`A` is α-friendly if `1 - cr_A(v)/deg(v) ≥ α` for every vertex `v` of positive degree;
vertices of degree zero impose no condition." -/
def IsFriendly {V : Type} [Fintype V] (G : SimpleGraph V) (α : ℝ) (A : Finset V) : Prop :=
  ∀ v, 0 < deg G v → α ≤ 1 - (crossDeg G A v : ℝ) / (deg G v : ℝ)

/-- `A` separates `s` and `t`: `|A ∩ {s,t}| = 1`. -/
def Separates {V : Type} (s t : V) (A : Finset V) : Prop :=
  (s ∈ A ∧ t ∉ A) ∨ (t ∈ A ∧ s ∉ A)

/-- `λ_G(s,t) = min { cut_G(A) : |A ∩ {s,t}| = 1 }`. -/
def minCutVal {V : Type} [Fintype V] (G : SimpleGraph V) (s t : V) : ℕ :=
  sInf {c : ℕ | ∃ A : Finset V, Separates s t A ∧ cutVal G A = c}

/-- `A` is a minimum `s,t`-cut of `G`. -/
def IsMinCut {V : Type} [Fintype V] (G : SimpleGraph V) (s t : V) (A : Finset V) : Prop :=
  Separates s t A ∧ cutVal G A = minCutVal G s t

/-- `A` is a union of parts of the partition `blk`. -/
def IsCompatible {V B : Type} (blk : V → B) (A : Finset V) : Prop :=
  ∀ u v, blk u = blk v → (u ∈ A ↔ v ∈ A)

/-- "Every α-friendly cut of value at most `w` is a union of parts of the returned partition." -/
def PreservesFriendly {V B : Type} [Fintype V] (G : SimpleGraph V) (blk : V → B)
    (α : ℝ) (w : ℕ) : Prop :=
  ∀ A : Finset V, IsFriendly G α A → cutVal G A ≤ w → IsCompatible blk A

/-- `a_v = deg(v) - |{vw ∈ E_ext : w ∉ U}|`, i.e. the number of neighbours of `v` lying in
its own part `U = blk v`. -/
def internalDeg {V B : Type} [Fintype V] (G : SimpleGraph V) (blk : V → B) (v : V) : ℕ :=
  (Finset.univ.filter (fun w => G.Adj v w ∧ blk w = blk v)).card

/-- Edge weights of the auxiliary graph `K` on `V ⊕ B`: "retain every edge in `E_ext` with
weight one ... add, for every `v ∈ U`, an edge `v p_U` of weight `a_v`." -/
def auxWeight {V B : Type} [Fintype V] (G : SimpleGraph V) (blk : V → B) :
    V ⊕ B → V ⊕ B → ℕ
  | Sum.inl u, Sum.inl v => if G.Adj u v ∧ blk u ≠ blk v then 1 else 0
  | Sum.inl v, Sum.inr U => if blk v = U then internalDeg G blk v else 0
  | Sum.inr U, Sum.inl v => if blk v = U then internalDeg G blk v else 0
  | Sum.inr _, Sum.inr _ => 0

/-- Weighted cut value `q_K(D)` of `D ⊆ V ⊕ B`. -/
def auxCut {V B : Type} [Fintype V] [Fintype B] (G : SimpleGraph V) (blk : V → B)
    (D : Finset (V ⊕ B)) : ℕ :=
  ∑ x ∈ D, ∑ y ∈ Finset.univ.filter (fun y => y ∉ D), auxWeight G blk x y

/-- `λ_K(s,t)` for original vertices `s, t`. -/
def auxMinCut {V B : Type} [Fintype V] [Fintype B] (G : SimpleGraph V) (blk : V → B)
    (s t : V) : ℕ :=
  sInf {c : ℕ | ∃ D : Finset (V ⊕ B), Sum.inl s ∈ D ∧ Sum.inl t ∉ D ∧ auxCut G blk D = c}

/-- `Y = D ∩ C`: the restriction of an auxiliary cut to the original vertices. -/
def restrictCut {V B : Type} [Fintype V] (D : Finset (V ⊕ B)) : Finset V :=
  Finset.univ.filter (fun v => Sum.inl v ∈ D)

/-- `C` is the set of survivors of peeling: there is an injective removal order `rank` on the
peeled vertices such that each peeled vertex has at most one neighbour among the core and
the vertices peeled after it, and every core vertex has at least two core neighbours. -/
def IsPeelingCore {V : Type} [Fintype V] (G : SimpleGraph V) (C : Finset V) : Prop :=
  ∃ rank : V → ℕ, Set.InjOn rank {v | v ∉ C} ∧
    (∀ v, v ∉ C →
      (Finset.univ.filter (fun w => G.Adj v w ∧ (w ∈ C ∨ rank v < rank w))).card ≤ 1) ∧
    (∀ v, v ∈ C → 2 ≤ (Finset.univ.filter (fun w => G.Adj v w ∧ w ∈ C)).card)

/-- `F = G[C]`, modelled on the full vertex type with all vertices outside `C` isolated. -/
def coreGraph {V : Type} (G : SimpleGraph V) (C : Finset V) : SimpleGraph V where
  Adj u v := G.Adj u v ∧ u ∈ C ∧ v ∈ C
  symm := fun _ _ h => ⟨G.symm h.1, h.2.2, h.2.1⟩
  loopless := fun v h => G.loopless v h.1

/-! ## Rubric item 1: low-degree reduction -/

/-- The core graph has no vertex of degree one. [FasterAllPairsMinimum, node_04] -/
theorem core_no_degree_one {V : Type} [Fintype V] (G : SimpleGraph V) (C : Finset V)
    (hC : IsPeelingCore G C) (v : V) : deg (coreGraph G C) v ≠ 1 := by
  sorry

/-- For core vertices, `λ_G(s,t) = λ_F(s,t)`. [FasterAllPairsMinimum, node_04] -/
theorem minCut_core_eq {V : Type} [Fintype V] (G : SimpleGraph V) (C : Finset V)
    (hC : IsPeelingCore G C) (s t : V) (hs : s ∈ C) (ht : t ∈ C) (hst : s ≠ t) :
    minCutVal G s t = minCutVal (coreGraph G C) s t := by
  sorry

/-- A pair involving a peeled vertex: connected pairs have minimum cut value exactly one. [FasterAllPairsMinimum, node_04] -/
theorem minCut_peeled_reachable {V : Type} [Fintype V] (G : SimpleGraph V) (C : Finset V)
    (hC : IsPeelingCore G C) (s t : V) (hs : s ∉ C) (hst : s ≠ t) (hr : G.Reachable s t) :
    minCutVal G s t = 1 := by
  sorry

/-- Disconnected pairs have minimum cut value zero. [FasterAllPairsMinimum, node_04] -/
theorem minCut_not_reachable {V : Type} [Fintype V] (G : SimpleGraph V) (s t : V)
    (hr : ¬ G.Reachable s t) : minCutVal G s t = 0 := by
  sorry

/-! ## Rubric item 2: minimum-cut dichotomy -/

/-- Every minimum `s,t`-cut of a graph without degree-one vertices is either `1/6`-friendly
for some choice, or of the form `X ∪ {r}` with `r ∈ {s,t}`, `X` a `1/6`-friendly set avoiding
both terminals, and `cut(X) ≤ 2 deg(r)`. [FasterAllPairsMinimum, node_04] -/
theorem minCut_dichotomy {V : Type} [Fintype V] (G : SimpleGraph V)
    (hdeg : ∀ v, deg G v ≠ 1) (s t : V) (hst : s ≠ t) :
    (∃ S, IsMinCut G s t S ∧ IsFriendly G (1/6) S) ∨
    (∃ r X, (r = s ∨ r = t) ∧ s ∉ X ∧ t ∉ X ∧ IsFriendly G (1/6) X ∧
      cutVal G X ≤ 2 * deg G r ∧ IsMinCut G s t (insert r X)) := by
  sorry

/-! ## Rubric items 3–4: auxiliary construction and exactness -/

/-- Domination (1): every cut of `K` costs at least the `G`-cut of its restriction. [FasterAllPairsMinimum, node_04] -/
theorem auxCut_ge_restrict {V B : Type} [Fintype V] [Fintype B] (G : SimpleGraph V)
    (blk : V → B) (D : Finset (V ⊕ B)) :
    cutVal G (restrictCut D) ≤ auxCut G blk D := by
  sorry

/-- **Main theorem (exact all-pairs preservation).** If `G` has no vertex of degree one,
`blk` preserves every `1/6`-friendly cut of value at most `w`, and `2 deg v ≤ w` for all `v`
(e.g. `w = 2m` on an `m`-vertex core), then for all distinct `s, t`, `λ_K(s,t) = λ_G(s,t)`
and every minimum `s,t`-cut of `K` restricts to a minimum `s,t`-cut of `G`. [FasterAllPairsMinimum, node_04] -/
theorem aux_exact {V B : Type} [Fintype V] [Fintype B] (G : SimpleGraph V) (blk : V → B)
    (w : ℕ) (hdeg : ∀ v, deg G v ≠ 1) (hw : ∀ v, 2 * deg G v ≤ w)
    (hpres : PreservesFriendly G blk (1/6) w) (s t : V) (hst : s ≠ t) :
    auxMinCut G blk s t = minCutVal G s t ∧
    ∀ D : Finset (V ⊕ B), Sum.inl s ∈ D → Sum.inl t ∉ D →
      auxCut G blk D = auxMinCut G blk s t →
      IsMinCut G s t (restrictCut D) ∧ cutVal G (restrictCut D) = auxCut G blk D := by
  sorry

end TCSChallenge.FasterAllPairsMinimumCut.node_04
