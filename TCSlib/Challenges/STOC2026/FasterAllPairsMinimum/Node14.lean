/-!
## Friendly cut sparsifier plus degrees determine all minimum `s,t`-cuts

Let `G` be a finite simple graph with no vertex of degree one, and `H` a labeled contraction
of `G` preserving every `1/6`-friendly cut of value at most `2n`. From `H` and the degree list
alone define candidates: compatible separating sets `C` with value `cut_H(C)`, and sets
`X ∪ {v}` (`v ∈ {s,t}`, `X` compatible avoiding both terminals) with value
`Φ_v(X) = cut_H(X) - 2 m_H(X,v) + d(v)`. The main theorem `recovery_correct` states that every
candidate is a real `s,t`-cut of `G` with exactly that value and that some candidate has value
`λ_G(s,t)`; `data_determine_lambda` is the resulting determination statement.
-/

namespace TCSChallenge.FasterAllPairsMinimumCut.node_14

/-- `cut_G(A) = |E(A, V \ A)|`, counted as ordered pairs `(u, v)` with `u ∈ A`, `v ∉ A`. -/
def cutVal {V : Type} [Fintype V] (G : SimpleGraph V) (A : Finset V) : ℕ :=
  (Finset.univ.filter (fun p : V × V => p.1 ∈ A ∧ p.2 ∉ A ∧ G.Adj p.1 p.2)).card

/-- `d(v) = deg_G(v)`. -/
def deg {V : Type} [Fintype V] (G : SimpleGraph V) (v : V) : ℕ :=
  (Finset.univ.filter (fun w => G.Adj v w)).card

/-- `cr_A(v)`: "the number of edges incident to v that cross the cut (A, V \ A)". -/
def crossDeg {V : Type} [Fintype V] (G : SimpleGraph V) (A : Finset V) (v : V) : ℕ :=
  (Finset.univ.filter (fun w => G.Adj v w ∧ (w ∈ A ↔ v ∉ A))).card

/-- "`A` is α-friendly if `1 - cr_A(v)/deg(v) ≥ α` for every vertex `v` of positive degree;
vertices of degree zero impose no condition." -/
def IsFriendly {V : Type} [Fintype V] (G : SimpleGraph V) (α : ℝ) (A : Finset V) : Prop :=
  ∀ v, 0 < deg G v → α ≤ 1 - (crossDeg G A v : ℝ) / (deg G v : ℝ)

/-- `A` separates `s` and `t`: `|A ∩ {s,t}| = 1`. -/
def Separates {V : Type} (s t : V) (A : Finset V) : Prop :=
  (s ∈ A ∧ t ∉ A) ∨ (t ∈ A ∧ s ∉ A)

/-- The unit-capacity `s,t`-network of `G` (TCSlib `Networks.Network`): capacity `1` on every
ordered adjacent pair, source `s`, sink `t`. Its `capOf A` equals `cut_G(A)`. -/
def stNetwork {V : Type} (G : SimpleGraph V) [DecidableRel G.Adj] (s t : V) (h : s ≠ t) :
    Networks.Network V where
  cap u v := if G.Adj u v then 1 else 0
  X := {s}; Y := {t}; x := s; y := t
  hdisj := Finset.disjoint_singleton.mpr h
  hX := Finset.singleton_nonempty s
  hY := Finset.singleton_nonempty t

/-- `λ_G(s,t) = min { cut_G(A) : s ∈ A, t ∉ A }`, the minimum cut capacity of `stNetwork G s t`.
Since `cut_G(A) = cut_G(Aᶜ)`, this is also `min { cut_G(A) : |A ∩ {s,t}| = 1 }`. -/
def minCutVal {V : Type} [Fintype V] (G : SimpleGraph V) (s t : V) (h : s ≠ t) : ℕ :=
  sInf {c : ℕ | ∃ A : Finset V, (stNetwork G s t h).IsCut A ∧ (stNetwork G s t h).capOf A = c}

/-- `A` is a minimum `s,t`-cut of `G`, in either orientation: a TCSlib minimum cut of
`stNetwork G s t` (`s ∈ A`) or of `stNetwork G t s` (`t ∈ A`). -/
def IsMinCut {V : Type} [Fintype V] (G : SimpleGraph V) (s t : V) (h : s ≠ t)
    (A : Finset V) : Prop :=
  (stNetwork G s t h).IsMinCut A ∨ (stNetwork G t s h.symm).IsMinCut A

/-- `A` is a union of parts of the partition `blk`. -/
def IsCompatible {V B : Type} (blk : V → B) (A : Finset V) : Prop :=
  ∀ u v, blk u = blk v → (u ∈ A ↔ v ∈ A)

/-- "Every α-friendly cut of value at most `w` is a union of parts of the returned partition." -/
def PreservesFriendly {V B : Type} [Fintype V] (G : SimpleGraph V) (blk : V → B)
    (α : ℝ) (w : ℕ) : Prop :=
  ∀ A : Finset V, IsFriendly G α A → cutVal G A ≤ w → IsCompatible blk A

/-- A labeled contraction: a partition into blocks `blk`, and the interblock edge units, each
labeled by its two original endpoints (`inter u v`). -/
structure LabeledContraction (V B : Type) where
  blk : V → B
  inter : V → V → Prop

/-- `H` is the labeled contraction of `G` for its partition: "edges internal to a block are
deleted, while each unit of interblock edge weight retains the labels of its two original
endpoints". -/
def IsLabeledContractionOf {V B : Type} (G : SimpleGraph V) (H : LabeledContraction V B) :
    Prop :=
  ∀ u v, H.inter u v ↔ (G.Adj u v ∧ H.blk u ≠ H.blk v)

/-- `cut_H(X)`: the number of interblock edge units leaving `X`. -/
def cutH {V B : Type} [Fintype V] (H : LabeledContraction V B) (X : Finset V) : ℕ :=
  (Finset.univ.filter (fun p : V × V => p.1 ∈ X ∧ p.2 ∉ X ∧ H.inter p.1 p.2)).card

/-- `m_H(X, v)`: the number of interblock edge units joining `X` to `v`. -/
def mH {V B : Type} [Fintype V] (H : LabeledContraction V B) (X : Finset V) (v : V) : ℕ :=
  (Finset.univ.filter (fun u => u ∈ X ∧ H.inter u v)).card

/-- The candidates of the recovery procedure, defined from `H` and the degree list `d` only:
compatible separating `C` with value `cut_H(C)`, and `X ∪ {v}` for `v ∈ {s,t}` and compatible
`X ⊆ V \ {s,t}`, with value `Φ_v(X) = cut_H(X) - 2 m_H(X,v) + d(v)` (computed in `ℤ`). -/
def IsCandidate {V B : Type} [Fintype V] (H : LabeledContraction V B) (d : V → ℕ)
    (s t : V) (S : Finset V) (val : ℤ) : Prop :=
  (IsCompatible H.blk S ∧ Separates s t S ∧ val = (cutH H S : ℤ)) ∨
  (∃ v X, (v = s ∨ v = t) ∧ IsCompatible H.blk X ∧ s ∉ X ∧ t ∉ X ∧ S = insert v X ∧
    val = (cutH H X : ℤ) - 2 * (mH H X v : ℤ) + (d v : ℤ))

/-- "`v` has friendliness ratio below `1/6` with respect to `A`." -/
def IsLowRatio {V : Type} [Fintype V] (G : SimpleGraph V) (A : Finset V) (v : V) : Prop :=
  0 < deg G v ∧ 1 - (crossDeg G A v : ℝ) / (deg G v : ℝ) < 1/6

/-! ## Rubric item 1: candidate values are true cut values -/

/-- `cut_G(X ∪ {v}) = cut_G(X) + d(v) - 2 |E_G(X, {v})|` for `v ∉ X`. [FasterAllPairsMinimum, node_14] -/
theorem cut_insert {V : Type} [Fintype V] (G : SimpleGraph V) (X : Finset V) (v : V)
    (hv : v ∉ X) :
    (cutVal G (insert v X) : ℤ) = (cutVal G X : ℤ) + (deg G v : ℤ)
      - 2 * ((Finset.univ.filter (fun u => u ∈ X ∧ G.Adj u v)).card : ℤ) := by
  sorry

/-- For compatible `X`, `cut_H(X) = cut_G(X)`. [FasterAllPairsMinimum, node_14] -/
theorem cutH_eq_of_compatible {V B : Type} [Fintype V] (G : SimpleGraph V)
    (H : LabeledContraction V B) (hH : IsLabeledContractionOf G H) (X : Finset V)
    (hX : IsCompatible H.blk X) : cutH H X = cutVal G X := by
  sorry

/-! ## Rubric item 2: structure of unfriendly minimum cuts -/

/-- Local optimality: a nonterminal has at most half of its edges crossing a minimum cut. [FasterAllPairsMinimum, node_14] -/
theorem nonterminal_half {V : Type} [Fintype V] (G : SimpleGraph V) (s t : V) (S : Finset V)
    (hst : s ≠ t) (hS : IsMinCut G s t hst S) (x : V) (hxs : x ≠ s) (hxt : x ≠ t) :
    2 * crossDeg G S x ≤ deg G x := by
  sorry

/-- The two terminals cannot both have ratio below `1/6` in a minimum cut. [FasterAllPairsMinimum, node_14] -/
theorem not_both_low {V : Type} [Fintype V] (G : SimpleGraph V) (hdeg : ∀ v, deg G v ≠ 1)
    (s t : V) (hst : s ≠ t) (S : Finset V) (hS : IsMinCut G s t hst S) :
    ¬ (IsLowRatio G S s ∧ IsLowRatio G S t) := by
  sorry

/-! ## Rubric items 3–4: friendly residual cut and the preservation threshold -/

/-- If no minimum `s,t`-cut is `1/6`-friendly, some minimum cut is `X ∪ {r}` with `r ∈ {s,t}`,
`X` avoiding both terminals, `X` `1/6`-friendly, and `cut_G(X) ≤ 2 d(r)`. [FasterAllPairsMinimum, node_14] -/
theorem friendly_residual {V : Type} [Fintype V] (G : SimpleGraph V)
    (hdeg : ∀ v, deg G v ≠ 1) (s t : V) (hst : s ≠ t)
    (hnone : ∀ S, IsMinCut G s t hst S → ¬ IsFriendly G (1/6) S) :
    ∃ r X, (r = s ∨ r = t) ∧ s ∉ X ∧ t ∉ X ∧ IsFriendly G (1/6) X ∧
      cutVal G X ≤ 2 * deg G r ∧ IsMinCut G s t hst (insert r X) := by
  sorry

/-- `2 d(v) < 2n`. [FasterAllPairsMinimum, node_14] -/
theorem two_deg_lt {V : Type} [Fintype V] (G : SimpleGraph V) (v : V) :
    2 * deg G v < 2 * Fintype.card V := by
  sorry

/-! ## Rubric item 5: main theorem -/

/-- **Main theorem.** The candidates built from `H` and the degree list are genuine
separating cuts with the stated values, and some candidate attains `λ_G(s,t)`. [FasterAllPairsMinimum, node_14] -/
theorem recovery_correct {V B : Type} [Fintype V] (G : SimpleGraph V)
    (H : LabeledContraction V B) (hH : IsLabeledContractionOf G H)
    (hdeg : ∀ v, deg G v ≠ 1)
    (hpres : PreservesFriendly G H.blk (1/6) (2 * Fintype.card V))
    (s t : V) (hst : s ≠ t) :
    (∀ S val, IsCandidate H (deg G) s t S val → Separates s t S ∧ (cutVal G S : ℤ) = val) ∧
    (∃ S, IsCandidate H (deg G) s t S (minCutVal G s t hst : ℤ)) := by
  sorry

/-- **Determination.** Two graphs satisfying the hypotheses with the same labeled
contraction and the same degree list have the same `λ(s,t)` for every pair. [FasterAllPairsMinimum, node_14] -/
theorem data_determine_lambda {V B : Type} [Fintype V] (G G' : SimpleGraph V)
    (H : LabeledContraction V B) (hH : IsLabeledContractionOf G H)
    (hH' : IsLabeledContractionOf G' H)
    (hdeg : ∀ v, deg G v ≠ 1) (hdd : ∀ v, deg G v = deg G' v)
    (hpres : PreservesFriendly G H.blk (1/6) (2 * Fintype.card V))
    (hpres' : PreservesFriendly G' H.blk (1/6) (2 * Fintype.card V))
    (s t : V) (hst : s ≠ t) :
    minCutVal G s t hst = minCutVal G' s t hst := by
  sorry

end TCSChallenge.FasterAllPairsMinimumCut.node_14
