/-!
## Boosting distribution-free testers via a composition assumption

`P = {P_s}` is a family of Boolean-function properties, `P s n ⊆ ({±1}^n → {±1})`, with
points of `{±1}^n` encoded as `BoolCube n` (`true` encodes `-1`, as in `boolToSign`).
An `(ε, a, b)`-tester has membership queries to `f` and free unlabelled samples from an unknown
distribution `μ : FinDist (BoolCube n)`; it accepts w.p. `≥ 2/3` if `f ∈ P_a(n)` and rejects
w.p. `≥ 2/3` if `dist_μ(f, P_b) > ε` (the infimum over the empty set being `+∞`, i.e. here:
every `h ∈ P_b(n)` disagrees with `f` on mass `> ε`).

Assuming (1) linear composition `u ∘ f ∈ P_{ℓr}(ℓn)` for `f ∈ P_r(n)`, (2) the distance
composition property for `g` with parameters `λ, ε_small, ε_large`, and (3) testers with
`q(ε_large, a, b)` queries for all positive `a, b`, the main theorem `boosting` gives an
`(ε_small, s, s'/λ)`-tester with `k · q(ε_large, ks, ks')` queries.
-/

namespace TCSChallenge.AStrongCompositionTheorem.node_19

open TCSlib.InformationTheory BooleanAnalysis

/-- Probability-vector predicate on a finite type. Distributions given as data are
`FinDist`s; this predicate is kept only for the computed `k`-fold product law `prodDist`. -/
def IsDist {X : Type} [Fintype X] (μ : X → ℝ) : Prop :=
  (∀ x, 0 ≤ μ x) ∧ ∑ x, μ x = 1

/-- `Pr_{X∼μ}[f(X) ≠ h(X)]`. -/
def disagree {X : Type} [Fintype X] (μ : X → ℝ) (f h : X → Bool) : ℝ :=
  ∑ x, if f x = h x then 0 else μ x

/-- The `i`-th block `x^{(i)} ∈ {±1}^n` of a point `(x^{(1)},…,x^{(k)})` of `{±1}^{kn}`;
coordinates of `Fin (k * n)` are identified with `Fin k × Fin n` via `finProdFinEquiv`. -/
def block {k n : ℕ} (z : BoolCube (k * n)) (i : Fin k) : BoolCube n :=
  fun j => z (finProdFinEquiv (i, j))

/-- The product distribution `μ^k` on `{±1}^{kn}`: the blocks `X^{(1)},…,X^{(k)}` are
independent with law `μ`. -/
def prodDist {k n : ℕ} (μ : BoolCube n → ℝ) (z : BoolCube (k * n)) : ℝ :=
  ∏ i : Fin k, μ (block z i)

/-- The block-composed function
`(x^{(1)},…,x^{(k)}) ↦ G(f(x^{(1)}),…,f(x^{(k)}))` on `{±1}^{kn}`. -/
def compose {k n : ℕ} (G : (Fin k → Bool) → Bool) (f : BoolCube n → Bool) :
    BoolCube (k * n) → Bool :=
  fun z => G (fun i => f (block z i))

/-- A randomized, possibly adaptive oracle algorithm on domain `X`, as a decision tree:
"membership-query access to `f`" (`query x c`: continue with `c (f x)`), "independent,
unlabelled samples from an unknown distribution" (`sample c`: continue with `c y`, `y ∼ μ`),
internal fair coins (`coin`), and accept / reject leaves. -/
inductive Tester (X : Type) : Type where
  | accept : Tester X
  | reject : Tester X
  | query : X → (Bool → Tester X) → Tester X
  | sample : (X → Tester X) → Tester X
  | coin : (Bool → Tester X) → Tester X

namespace Tester

variable {X : Type} [Fintype X]

/-- Acceptance probability of the tester run with oracle `f` and sample weights `μ`
(a `FinDist` is passed through its coercion `⇑μ`). -/
def acceptProb (f : X → Bool) (μ : X → ℝ) : Tester X → ℝ
  | .accept => 1
  | .reject => 0
  | .query x c => acceptProb f μ (c (f x))
  | .sample c => ∑ y, μ y * acceptProb f μ (c y)
  | .coin c => (acceptProb f μ (c true) + acceptProb f μ (c false)) / 2

/-- Worst-case number of membership queries along any branch. "Only membership queries are
charged": sample and coin nodes cost nothing. -/
def queries : Tester X → ℕ
  | .accept => 0
  | .reject => 0
  | .query _ c => 1 + max (queries (c true)) (queries (c false))
  | .sample c => Finset.univ.sup (fun y => queries (c y))
  | .coin c => max (queries (c true)) (queries (c false))

end Tester

/-- A family of properties: `P s n` is the set `P_s(n)` of functions `{±1}^n → {±1}`. -/
abbrev PropertyFamily : Type := ℕ → (n : ℕ) → Set (BoolCube n → Bool)

/-- `T` is an `(ε, a, b)`-tester for `P` in dimension `n`: for every `f` and every
distribution `μ`, it accepts w.p. `≥ 2/3` when `f ∈ P_a(n)` and rejects w.p. `≥ 2/3`
(accepts w.p. `≤ 1/3`) when `dist_μ(f, P_b) > ε`, i.e. every `h ∈ P_b(n)` has
`Pr_μ[f ≠ h] > ε` (vacuously when `P_b(n) = ∅`, matching `inf ∅ = +∞`). -/
def IsTester (P : PropertyFamily) {n : ℕ} (T : Tester (BoolCube n)) (ε : ℝ) (a b : ℕ) : Prop :=
  ∀ (f : BoolCube n → Bool) (μ : FinDist (BoolCube n)),
    (f ∈ P a n → 2 / 3 ≤ T.acceptProb f ⇑μ) ∧
    ((∀ h ∈ P b n, ε < disagree ⇑μ f h) → T.acceptProb f ⇑μ ≤ 1 / 3)

/-- Assumption 1 (linear composition): for `ℓ, n, r ≥ 1`, every `u : {±1}^ℓ → {±1}` and
`f ∈ P_r(n)`, the map `(x^{(1)},…,x^{(ℓ)}) ↦ u(f(x^{(1)}),…,f(x^{(ℓ)}))` lies in
`P_{ℓr}(ℓn)`. -/
def LinearComposition (P : PropertyFamily) : Prop :=
  ∀ ℓ n r : ℕ, 1 ≤ ℓ → 1 ≤ n → 1 ≤ r →
    ∀ (u : (Fin ℓ → Bool) → Bool) (f : BoolCube n → Bool), f ∈ P r n →
      compose u f ∈ P (ℓ * r) (ℓ * n)

/-- Assumption 2 (distance composition for `g`): whenever `r` and `λkr = N` are positive
integers, if some `H ∈ P_{λkr}(kn)` has `Pr_{μ^k}[H ≠ g ∘ f] ≤ ε_large`, then some
`h ∈ P_r(n)` has `Pr_μ[h ≠ f] ≤ ε_small`. -/
def DistanceComposition (P : PropertyFamily) (k : ℕ) (g : (Fin k → Bool) → Bool)
    (lam εL εS : ℝ) : Prop :=
  ∀ n r N : ℕ, 1 ≤ r → (N : ℝ) = lam * k * r →
    ∀ (f : BoolCube n → Bool) (μ : FinDist (BoolCube n)),
      (∃ H ∈ P N (k * n), disagree (prodDist (k := k) ⇑μ) H (compose g f) ≤ εL) →
      ∃ h ∈ P r n, disagree ⇑μ h f ≤ εS

/-- `μ^k` is a distribution whenever `μ` is. [AStrongCompositionTheorem, node_19] -/
theorem prodDist_isDist (k n : ℕ) (μ : FinDist (BoolCube n)) :
    IsDist (prodDist (k := k) ⇑μ) := by sorry

/-- Rubric (derived oracle, sampling, adaptive simulation): any tester `T` in dimension `kn`
can be simulated on `(f, μ)` by a tester `T'` in dimension `n` that answers each derived query
with at most `k` queries to `f` and each derived sample by `k` fresh samples from `μ`, so that
its acceptance probability equals that of `T` on `(G ∘ f, μ^k)`. [AStrongCompositionTheorem, node_19] -/
theorem simulation (k n : ℕ) (G : (Fin k → Bool) → Bool) (T : Tester (BoolCube (k * n))) :
    ∃ T' : Tester (BoolCube n), T'.queries ≤ k * T.queries ∧
      ∀ (f : BoolCube n → Bool) (μ : BoolCube n → ℝ),
        T'.acceptProb f μ = T.acceptProb (compose G f) (prodDist (k := k) μ) := by sorry

/-- Rubric (completeness): `f ∈ P_s(n)` implies `g ∘ f ∈ P_{ks}(kn)`. [AStrongCompositionTheorem, node_19] -/
theorem completeness_transfer (P : PropertyFamily) (hlin : LinearComposition P)
    (k : ℕ) (hk : 1 ≤ k) (g : (Fin k → Bool) → Bool) (s n : ℕ) (hs : 1 ≤ s) (hn : 1 ≤ n)
    (f : BoolCube n → Bool) (hf : f ∈ P s n) : compose g f ∈ P (k * s) (k * n) := by sorry

/-- Rubric (soundness and resource scaling): applying Assumption 2 at `r = s'/λ = t`,
`dist_μ(f, P_t) > ε_small` implies `dist_{μ^k}(g ∘ f, P_{ks'}) > ε_large`. [AStrongCompositionTheorem, node_19] -/
theorem soundness_transfer (P : PropertyFamily) (k : ℕ) (g : (Fin k → Bool) → Bool)
    (lam εS εL : ℝ) (hlam : 0 < lam) (hdist : DistanceComposition P k g lam εL εS)
    (s' t n : ℕ) (ht : 1 ≤ t) (hts : (t : ℝ) = s' / lam)
    (f : BoolCube n → Bool) (μ : FinDist (BoolCube n))
    (hfar : ∀ h ∈ P t n, εS < disagree ⇑μ f h) :
    ∀ H ∈ P (k * s') (k * n), εL < disagree (prodDist (k := k) ⇑μ) (compose g f) H := by sorry

/-- Main theorem: for all positive integers `s, s'` with `s'/λ = t` a positive integer, in
every dimension `n ≥ 1` there is an `(ε_small, s, s'/λ)`-tester making at most
`k · q(ε_large, ks, ks')` membership queries. [AStrongCompositionTheorem, node_19] -/
theorem boosting (P : PropertyFamily) (k : ℕ) (hk : 1 ≤ k) (g : (Fin k → Bool) → Bool)
    (lam εS εL : ℝ) (hlam : 0 < lam) (hεS : 0 < εS) (hSL : εS < εL) (hεL : εL < 1)
    (hlin : LinearComposition P) (hdist : DistanceComposition P k g lam εL εS)
    (q : ℝ → ℕ → ℕ → ℕ)
    (htest : ∀ a b : ℕ, 1 ≤ a → 1 ≤ b → ∀ m : ℕ,
      ∃ T : Tester (BoolCube m), T.queries ≤ q εL a b ∧ IsTester P T εL a b)
    (s s' t : ℕ) (hs : 1 ≤ s) (hs' : 1 ≤ s') (ht : 1 ≤ t) (hts : (t : ℝ) = s' / lam)
    (n : ℕ) (hn : 1 ≤ n) :
    ∃ T : Tester (BoolCube n), T.queries ≤ k * q εL (k * s) (k * s') ∧ IsTester P T εS s t := by
  sorry

end TCSChallenge.AStrongCompositionTheorem.node_19
