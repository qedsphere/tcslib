/-!
## Boosting non-tolerant distribution-free junta testers

A `(0, η, a, b)`-tester accepts w.p. `≥ 2/3` when `dist_D(f, J_a) = 0` and rejects w.p.
`≥ 2/3` when `dist_D(f, J_b) ≥ η`. Since the minimum is over a finite nonempty set,
`dist = 0 ↔ ∃ a-junta h, Pr_D[f ≠ h] = 0` and `dist ≥ η ↔ ∀ b-juntas h, Pr_D[f ≠ h] ≥ η`.
Given `(0, η, a, b)`-testers with `q(η, a, b)` queries for `η ∈ (0, 1/2]` and integers
`a ≤ b`, the main theorem `zero_tester_boosting` gives a `(0, ε_small, r, λ⁻¹r′)`-tester with
`k · q(ε_large, kr, kr′)` queries, where
`ε_large = [1 − (1 − 2ε_small)^{(1−λ)k/2}] / 2`.

Points of `{±1}^n` are TCSlib's `BoolCube n` (`true` encodes `-1`, as in `boolToSign`);
distributions on the cube are TCSlib `FinDist`s. The `k`-fold product `μ^k` is computed, so it
stays a plain function `prodDist μ`, with the local predicate `IsDist` kept only for it.
-/

namespace TCSChallenge.AStrongCompositionTheorem.node_35

open TCSlib.InformationTheory BooleanAnalysis

/-- "a distribution on a finite type": a probability vector. Used only for the computed
product distribution `prodDist μ`; given distributions are `FinDist`s. -/
def IsDist {X : Type} [Fintype X] (μ : X → ℝ) : Prop :=
  (∀ x, 0 ≤ μ x) ∧ ∑ x, μ x = 1

/-- `Pr_{X∼μ}[f(X) ≠ h(X)]`. -/
def disagree {X : Type} [Fintype X] (μ : X → ℝ) (f h : X → Bool) : ℝ :=
  ∑ x, if f x = h x then 0 else μ x

/-- The `i`-th block `x^{(i)} ∈ {±1}^n` of a point `(x^{(1)},…,x^{(k)})` of `{±1}^{kn}`;
coordinates of `Fin (k * n)` are identified with `Fin k × Fin n` via `finProdFinEquiv`. -/
def block {k n : ℕ} (z : BoolCube (k * n)) (i : Fin k) : BoolCube n :=
  fun j => z (finProdFinEquiv (i, j))

/-- The product distribution `μ^k` on `{±1}^{kn}`: the blocks `X^{(1)},…,X^{(k)}` are
independent with law `μ`. -/
def prodDist {k n : ℕ} (μ : BoolCube n → ℝ) (z : BoolCube (k * n)) : ℝ :=
  ∏ i : Fin k, μ (block z i)

/-- The block-composed function
`(x^{(1)},…,x^{(k)}) ↦ G(f(x^{(1)}),…,f(x^{(k)}))` on `{±1}^{kn}`. -/
def compose {k n : ℕ} (G : (Fin k → Bool) → Bool) (f : BoolCube n → Bool) :
    BoolCube (k * n) → Bool :=
  fun z => G (fun i => f (block z i))

/-- A randomized, possibly adaptive oracle algorithm on domain `X`, as a decision tree:
"membership-query access to `f`" (`query x c`: continue with `c (f x)`), "independent,
unlabelled samples from an unknown distribution" (`sample c`: continue with `c y`, `y ∼ μ`),
internal fair coins (`coin`), and accept / reject leaves. -/
inductive Tester (X : Type) : Type where
  | accept : Tester X
  | reject : Tester X
  | query : X → (Bool → Tester X) → Tester X
  | sample : (X → Tester X) → Tester X
  | coin : (Bool → Tester X) → Tester X

namespace Tester

variable {X : Type} [Fintype X]

/-- Acceptance probability of the tester run with oracle `f` and sample distribution `μ`. -/
def acceptProb (f : X → Bool) (μ : X → ℝ) : Tester X → ℝ
  | .accept => 1
  | .reject => 0
  | .query x c => acceptProb f μ (c (f x))
  | .sample c => ∑ y, μ y * acceptProb f μ (c y)
  | .coin c => (acceptProb f μ (c true) + acceptProb f μ (c false)) / 2

/-- Worst-case number of membership queries along any branch. "Only membership queries are
charged": sample and coin nodes cost nothing. -/
def queries : Tester X → ℕ
  | .accept => 0
  | .reject => 0
  | .query _ c => 1 + max (queries (c true)) (queries (c false))
  | .sample c => Finset.univ.sup (fun y => queries (c y))
  | .coin c => max (queries (c true)) (queries (c false))

end Tester

/-- "`h` depends on at most `s` coordinates" (an `s`-junta, `h ∈ J_s`), via TCSlib's
`KKL.IsJunta` applied to the `±1`-valued version `boolToSign ∘ h`. -/
def IsJunta {n : ℕ} (h : BoolCube n → Bool) (s : ℕ) : Prop :=
  ∃ S : Finset (Fin n), S.card ≤ s ∧ KKL.IsJunta (fun x => boolToSign (h x)) S

/-- The `±1`-product `∏ᵢ bᵢ` in the Bool encoding (`true = -1`): an odd number of `true`s.
(Named `xorBits` to avoid a clash with `BooleanAnalysis.parity`.) -/
def xorBits {k : ℕ} (b : Fin k → Bool) : Bool :=
  decide ((Finset.univ.filter (fun i => b i = true)).card % 2 = 1)

/-- `F(x^{(1)},…,x^{(k)}) = ∏_{i=1}^k f(x^{(i)})` on `{±1}^{kn}`. -/
def xorCompose {k n : ℕ} (f : BoolCube n → Bool) : BoolCube (k * n) → Bool :=
  compose (xorBits (k := k)) f

/-- `μ^k` is a distribution whenever `μ` is. [AStrongCompositionTheorem, node_35] -/
theorem prodDist_isDist (k n : ℕ) (μ : FinDist (BoolCube n)) :
    IsDist (prodDist (k := k) ⇑μ) := by sorry

/-- Rubric (derived oracle, sampling, adaptive simulation): any tester `T` in dimension `kn`
can be simulated on `(f, μ)` by a tester `T'` in dimension `n` that answers each derived query
with at most `k` queries to `f` and each derived sample by `k` fresh samples from `μ`, so that
its acceptance probability equals that of `T` on `(G ∘ f, μ^k)`. [AStrongCompositionTheorem, node_35] -/
theorem simulation (k n : ℕ) (G : (Fin k → Bool) → Bool) (T : Tester (BoolCube (k * n))) :
    ∃ T' : Tester (BoolCube n), T'.queries ≤ k * T.queries ∧
      ∀ (f : BoolCube n → Bool) (μ : BoolCube n → ℝ),
        T'.acceptProb f μ = T.acceptProb (compose G f) (prodDist (k := k) μ) := by sorry

/-- Rubric (approximation bound for arbitrary juntas): suppose every `B`-junta has error
`≥ δ` against `f` under `D`, and every allocation of at most `R` coordinates to the `k` blocks
leaves at least `L` blocks with at most `B` coordinates. Then every `R`-junta `H` on `{±1}^{kn}`
(with arbitrary cross-block dependence) has `Pr_{D^k}[F ≠ H] ≥ (1 − (1−2δ)^{L/2})/2`. [AStrongCompositionTheorem, node_35] -/
theorem xor_soundness (k n R B L : ℕ) (D : FinDist (BoolCube n)) (f : BoolCube n → Bool)
    (δ : ℝ) (hδ : 0 ≤ δ) (hfar : ∀ h : BoolCube n → Bool, IsJunta h B → δ ≤ disagree ⇑D f h)
    (hL : ∀ s : Fin k → ℕ, ∑ i, s i ≤ R → L ≤ (Finset.univ.filter (fun i => s i ≤ B)).card)
    (H : BoolCube (k * n) → Bool) (hH : IsJunta H R) :
    (1 - (1 - 2 * δ) ^ ((L : ℝ) / 2)) / 2 ≤
      disagree (prodDist (k := k) ⇑D) (xorCompose f) H := by sorry

/-- `ε_large = [1 − (1 − 2ε_small)^{(1−λ)k/2}] / 2` (real power). -/
def epsLarge (εS lam : ℝ) (k : ℕ) : ℝ :=
  (1 - (1 - 2 * εS) ^ ((1 - lam) * k / 2)) / 2

/-- `T` is a `(0, η, a, b)`-tester in dimension `m`: for every `f` and every `D`, accept
w.p. `≥ 2/3` when `dist_D(f, J_a) = 0` and reject w.p. `≥ 2/3` when `dist_D(f, J_b) ≥ η`. -/
def IsZeroTester {m : ℕ} (T : Tester (BoolCube m)) (η : ℝ) (a b : ℕ) : Prop :=
  ∀ (f : BoolCube m → Bool) (D : FinDist (BoolCube m)),
    ((∃ h : BoolCube m → Bool, IsJunta h a ∧ disagree ⇑D f h = 0) →
        2 / 3 ≤ T.acceptProb f ⇑D) ∧
    ((∀ h : BoolCube m → Bool, IsJunta h b → η ≤ disagree ⇑D f h) →
        T.acceptProb f ⇑D ≤ 1 / 3)

/-- `ε_large ∈ (0, 1/2]` for `ε_small ∈ (0, 1/2]`, `k ≥ 1`, `λ ∈ (0,1)`, so the assumed
tester is available at this threshold. [AStrongCompositionTheorem, node_35] -/
theorem epsLarge_mem (εS lam : ℝ) (k : ℕ) (hε0 : 0 < εS) (hε1 : εS ≤ 1 / 2) (hk : 1 ≤ k)
    (hlam0 : 0 < lam) (hlam1 : lam < 1) :
    0 < epsLarge εS lam k ∧ epsLarge εS lam k ≤ 1 / 2 := by sorry

/-- Rubric (zero-distance completeness): an almost-sure `r`-junta approximator `h` of `f`
gives the almost-sure `kr`-junta approximator `∏ᵢ h(x^{(i)})` of `F` under `D^k`. [AStrongCompositionTheorem, node_35] -/
theorem zero_completeness (k n r : ℕ) (D : FinDist (BoolCube n)) (f h : BoolCube n → Bool)
    (hh : IsJunta h r) (hfh : disagree ⇑D f h = 0) :
    IsJunta (xorCompose (k := k) h) (k * r) ∧
      disagree (prodDist (k := k) ⇑D) (xorCompose f) (xorCompose h) = 0 := by sorry

/-- Rubric (uneven budget allocation): any allocation of at most `kr′` coordinates to `k`
blocks leaves at least `(1−λ)k` blocks with at most `⌊r′/λ⌋` coordinates. [AStrongCompositionTheorem, node_35] -/
theorem light_blocks_count (k r' : ℕ) (lam : ℝ) (hlam0 : 0 < lam) (hlam1 : lam < 1)
    (s : Fin k → ℕ) (hs : ∑ i, s i ≤ k * r') :
    (1 - lam) * k ≤
      ((Finset.univ.filter (fun i => s i ≤ ⌊(r' : ℝ) / lam⌋₊)).card : ℝ) := by sorry

/-- Main theorem: for `ε_small ∈ (0, 1/2]`, `k ≥ 1`, `λ ∈ (0,1)`, integers `0 ≤ r ≤ r′`, in
every dimension there is a `(0, ε_small, r, λ⁻¹r′)`-tester with at most
`k · q(ε_large, kr, kr′)` membership queries. [AStrongCompositionTheorem, node_35] -/
theorem zero_tester_boosting (q : ℝ → ℕ → ℕ → ℕ)
    (hq : ∀ η : ℝ, 0 < η → η ≤ 1 / 2 → ∀ a b : ℕ, a ≤ b → ∀ m : ℕ,
      ∃ T : Tester (BoolCube m), T.queries ≤ q η a b ∧ IsZeroTester T η a b)
    (εS : ℝ) (hε0 : 0 < εS) (hε1 : εS ≤ 1 / 2) (k : ℕ) (hk : 1 ≤ k)
    (lam : ℝ) (hlam0 : 0 < lam) (hlam1 : lam < 1) (r r' : ℕ) (hrr : r ≤ r') (n : ℕ) :
    ∃ T : Tester (BoolCube n), T.queries ≤ k * q (epsLarge εS lam k) (k * r) (k * r') ∧
      IsZeroTester T εS r ⌊(r' : ℝ) / lam⌋₊ := by sorry

end TCSChallenge.AStrongCompositionTheorem.node_35
