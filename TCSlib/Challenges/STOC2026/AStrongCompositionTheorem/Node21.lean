/-!
## Tolerant junta testing: boosting the distance gap

`J_s^(m)` is the set of `s`-juntas on `{±1}^m` (TCSlib's `BoolCube m`), and
`dist_P(u, J_s) = min_h Pr_P[u ≠ h]` for a distribution `P : FinDist (BoolCube m)`
(a minimum over a finite nonempty set, so `dist ≤ c ↔ ∃ h, Pr ≤ c` and
`dist ≥ c ↔ ∀ h, Pr ≥ c`). Juntas are expressed through TCSlib's `KKL.IsJunta` applied to the
`±1`-valued function `boolToSign ∘ h`. The `k`-fold product `μ^k` is a computed distribution and
stays a plain function `prodDist μ`, with the local predicate `IsDist` kept only for it.
Given distribution-free `(1/4, 1/3)`-tolerant `s`-junta testers with `q(s)` queries in every
dimension, the main theorem `tolerant_boosting` gives an absolute `C > 0` and, for every
`n, r, ε > 0, λ ∈ (0,1)`, an algorithm with `(1/(4ε)) q(r/(4ε))` queries distinguishing
`dist_D(f, J_r) ≤ ε` from `dist_D(f, J_{r/λ}) ≥ Cε/(1−λ)`.
-/

namespace TCSChallenge.AStrongCompositionTheorem.node_21

open TCSlib.InformationTheory BooleanAnalysis

/-- "`μ` is a probability vector on a finite type"; used only for the computed product
distribution `prodDist μ` (input distributions are TCSlib `FinDist`s). -/
def IsDist {X : Type} [Fintype X] (μ : X → ℝ) : Prop :=
  (∀ x, 0 ≤ μ x) ∧ ∑ x, μ x = 1

/-- `Pr_{X∼μ}[f(X) ≠ h(X)]`. -/
def disagree {X : Type} [Fintype X] (μ : X → ℝ) (f h : X → Bool) : ℝ :=
  ∑ x, if f x = h x then 0 else μ x

/-- The `i`-th block `x^{(i)} ∈ {±1}^n` of a point `(x^{(1)},…,x^{(k)})` of `{±1}^{kn}`;
coordinates of `Fin (k * n)` are identified with `Fin k × Fin n` via `finProdFinEquiv`.
In `BoolCube`, `true` encodes `-1` and `false` encodes `+1` (the `boolToSign` convention). -/
def block {k n : ℕ} (z : BoolCube (k * n)) (i : Fin k) : BoolCube n :=
  fun j => z (finProdFinEquiv (i, j))

/-- The product distribution `μ^k` on `{±1}^{kn}`: the blocks `X^{(1)},…,X^{(k)}` are
independent with law `μ`. -/
def prodDist {k n : ℕ} (μ : BoolCube n → ℝ) (z : BoolCube (k * n)) : ℝ :=
  ∏ i : Fin k, μ (block z i)

/-- The block-composed function
`(x^{(1)},…,x^{(k)}) ↦ G(f(x^{(1)}),…,f(x^{(k)}))` on `{±1}^{kn}`. -/
def compose {k n : ℕ} (G : (Fin k → Bool) → Bool) (f : BoolCube n → Bool) :
    BoolCube (k * n) → Bool :=
  fun z => G (fun i => f (block z i))

/-- A randomized, possibly adaptive oracle algorithm on domain `X`, as a decision tree:
"membership-query access to `f`" (`query x c`: continue with `c (f x)`), "independent,
unlabelled samples from an unknown distribution" (`sample c`: continue with `c y`, `y ∼ μ`),
internal fair coins (`coin`), and accept / reject leaves. -/
inductive Tester (X : Type) : Type where
  | accept : Tester X
  | reject : Tester X
  | query : X → (Bool → Tester X) → Tester X
  | sample : (X → Tester X) → Tester X
  | coin : (Bool → Tester X) → Tester X

namespace Tester

variable {X : Type} [Fintype X]

/-- Acceptance probability of the tester run with oracle `f` and sample distribution `μ`. -/
def acceptProb (f : X → Bool) (μ : X → ℝ) : Tester X → ℝ
  | .accept => 1
  | .reject => 0
  | .query x c => acceptProb f μ (c (f x))
  | .sample c => ∑ y, μ y * acceptProb f μ (c y)
  | .coin c => (acceptProb f μ (c true) + acceptProb f μ (c false)) / 2

/-- Worst-case number of membership queries along any branch. "Only membership queries are
charged": sample and coin nodes cost nothing. -/
def queries : Tester X → ℕ
  | .accept => 0
  | .reject => 0
  | .query _ c => 1 + max (queries (c true)) (queries (c false))
  | .sample c => Finset.univ.sup (fun y => queries (c y))
  | .coin c => max (queries (c true)) (queries (c false))

end Tester

/-- "`h` depends on at most `s` coordinates" (an `s`-junta, `h ∈ J_s`): some set `S` of at most
`s` coordinates is a junta set for `±1`-valued `boolToSign ∘ h` in TCSlib's sense. -/
def IsJunta {n : ℕ} (h : BoolCube n → Bool) (s : ℕ) : Prop :=
  ∃ S : Finset (Fin n), S.card ≤ s ∧ KKL.IsJunta (fun x => boolToSign (h x)) S

/-- The `±1`-product `∏ᵢ bᵢ` in the Bool encoding (`true = -1`): an odd number of `true`s.
(Named `xorBits` to avoid a clash with TCSlib's `BooleanAnalysis.parity`.) -/
def xorBits {k : ℕ} (b : Fin k → Bool) : Bool :=
  decide ((Finset.univ.filter (fun i => b i = true)).card % 2 = 1)

/-- `F(x^{(1)},…,x^{(k)}) = ∏_{i=1}^k f(x^{(i)})` on `{±1}^{kn}`. -/
def xorCompose {k n : ℕ} (f : BoolCube n → Bool) : BoolCube (k * n) → Bool :=
  compose (xorBits (k := k)) f

/-- `μ^k` is a distribution whenever `μ` is. [AStrongCompositionTheorem, node_21] -/
theorem prodDist_isDist (k n : ℕ) (μ : FinDist (BoolCube n)) :
    IsDist (prodDist (k := k) ⇑μ) := by sorry

/-- Rubric (derived oracle, sampling, adaptive simulation): any tester `T` in dimension `kn`
can be simulated on `(f, μ)` by a tester `T'` in dimension `n` that answers each derived query
with at most `k` queries to `f` and each derived sample by `k` fresh samples from `μ`, so that
its acceptance probability equals that of `T` on `(G ∘ f, μ^k)`. [AStrongCompositionTheorem, node_21] -/
theorem simulation (k n : ℕ) (G : (Fin k → Bool) → Bool) (T : Tester (BoolCube (k * n))) :
    ∃ T' : Tester (BoolCube n), T'.queries ≤ k * T.queries ∧
      ∀ (f : BoolCube n → Bool) (μ : BoolCube n → ℝ),
        T'.acceptProb f μ = T.acceptProb (compose G f) (prodDist (k := k) μ) := by sorry

/-- Rubric (tolerant completeness): if an `r`-junta `v` has `Pr_D[f ≠ v] ≤ ε`, then
`∏ᵢ v(x^{(i)})` is a `kr`-junta with `Pr_{D^k}[F ≠ V] ≤ kε`. [AStrongCompositionTheorem, node_21] -/
theorem xor_completeness (k n r : ℕ) (D : FinDist (BoolCube n)) (f v : BoolCube n → Bool)
    (ε : ℝ) (hv : IsJunta v r) (hfv : disagree ⇑D f v ≤ ε) :
    IsJunta (xorCompose (k := k) v) (k * r) ∧
      disagree (prodDist (k := k) ⇑D) (xorCompose f) (xorCompose v) ≤ k * ε := by sorry

/-- Rubric (uneven budget allocation): if `∑ᵢ sᵢ ≤ R`, then at most `R / (B+1)` blocks are
heavy (`sᵢ > B`). [AStrongCompositionTheorem, node_21] -/
theorem heavy_blocks_count (k R B : ℕ) (s : Fin k → ℕ) (hs : ∑ i, s i ≤ R) :
    (B + 1) * (Finset.univ.filter (fun i => B < s i)).card ≤ R := by sorry

/-- Rubric (approximation bound for arbitrary juntas): suppose every `B`-junta has error
`≥ δ` against `f` under `D`, and every allocation of at most `R` coordinates to the `k` blocks
leaves at least `L` blocks with at most `B` coordinates. Then every `R`-junta `H` on `{±1}^{kn}`
(with arbitrary cross-block dependence) has `Pr_{D^k}[F ≠ H] ≥ (1 − (1−2δ)^{L/2})/2`. [AStrongCompositionTheorem, node_21] -/
theorem xor_soundness (k n R B L : ℕ) (D : FinDist (BoolCube n)) (f : BoolCube n → Bool)
    (δ : ℝ) (hδ : 0 ≤ δ) (hfar : ∀ h : BoolCube n → Bool, IsJunta h B → δ ≤ disagree ⇑D f h)
    (hL : ∀ s : Fin k → ℕ, ∑ i, s i ≤ R → L ≤ (Finset.univ.filter (fun i => s i ≤ B)).card)
    (H : BoolCube (k * n) → Bool) (hH : IsJunta H R) :
    (1 - (1 - 2 * δ) ^ ((L : ℝ) / 2)) / 2 ≤
      disagree (prodDist (k := k) ⇑D) (xorCompose f) H := by sorry

/-- `T` (dimension `m`) distinguishes `dist_P(u, J_a) ≤ c₁` (accept w.p. `≥ 2/3`) from
`dist_P(u, J_b) ≥ c₂` (reject w.p. `≥ 2/3`), for every `u` and every distribution `P`. -/
def IsTolerantTester {m : ℕ} (T : Tester (BoolCube m)) (c₁ c₂ : ℝ) (a b : ℕ) : Prop :=
  ∀ (u : BoolCube m → Bool) (P : FinDist (BoolCube m)),
    ((∃ h : BoolCube m → Bool, IsJunta h a ∧ disagree ⇑P u h ≤ c₁) →
      2 / 3 ≤ T.acceptProb u ⇑P) ∧
    ((∀ h : BoolCube m → Bool, IsJunta h b → c₂ ≤ disagree ⇑P u h) →
      T.acceptProb u ⇑P ≤ 1 / 3)

/-- Explicit-constant version (reference answer: `C = 10`). [AStrongCompositionTheorem, node_21] -/
theorem tolerant_boosting_C10 (q : ℕ → ℕ)
    (hq : ∀ m s : ℕ, ∃ T : Tester (BoolCube m), T.queries ≤ q s ∧
      IsTolerantTester T (1 / 4) (1 / 3) s s)
    (n r : ℕ) (ε lam : ℝ) (hε : 0 < ε) (hlam0 : 0 < lam) (hlam1 : lam < 1) :
    ∃ T : Tester (BoolCube n),
      (T.queries : ℝ) ≤ (1 / (4 * ε)) * (q ⌊(r : ℝ) / (4 * ε)⌋₊ : ℝ) ∧
      IsTolerantTester T ε (10 * ε / (1 - lam)) r ⌊(r : ℝ) / lam⌋₊ := by sorry

/-- Main theorem: there is an absolute constant `C > 0` such that for every `n`, integer
`r ≥ 0`, `ε > 0` and `λ ∈ (0,1)` some algorithm with query cost `≤ (1/(4ε)) q(r/(4ε))`
distinguishes `dist_D(f, J_r) ≤ ε` from `dist_D(f, J_{r/λ}) ≥ Cε/(1−λ)` w.p. `≥ 2/3`. [AStrongCompositionTheorem, node_21] -/
theorem tolerant_boosting (q : ℕ → ℕ)
    (hq : ∀ m s : ℕ, ∃ T : Tester (BoolCube m), T.queries ≤ q s ∧
      IsTolerantTester T (1 / 4) (1 / 3) s s) :
    ∃ C : ℝ, 0 < C ∧ ∀ (n r : ℕ) (ε lam : ℝ), 0 < ε → 0 < lam → lam < 1 →
      ∃ T : Tester (BoolCube n),
        (T.queries : ℝ) ≤ (1 / (4 * ε)) * (q ⌊(r : ℝ) / (4 * ε)⌋₊ : ℝ) ∧
        IsTolerantTester T ε (C * ε / (1 - lam)) r ⌊(r : ℝ) / lam⌋₊ := by sorry

end TCSChallenge.AStrongCompositionTheorem.node_21
