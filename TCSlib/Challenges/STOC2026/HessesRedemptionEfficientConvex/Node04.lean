/-!
## Bounded minimizers for convex polynomials over rational polyhedra

Let `f ∈ ℚ[x₁,…,xₙ]` be convex on `ℝⁿ` and `P = {x : Ax ≤ b}` a nonempty rational polyhedron.
Exactly one of the following holds: `f` is unbounded below on `P`, or `f` attains its minimum
over `P` at a point `x*` with `‖x*‖ ≤ 2^{poly(enc f, enc P)}` (Euclidean norm).  The polynomial
is uniform over all inputs.  Main theorem: `convex_poly_min_dichotomy`.
-/

namespace TCSChallenge.HessesRedemptionEfficientConvex.node_04

open MvPolynomial

/-- Bit length of a rational number `p/q` in lowest terms (binary encoding of numerator and
denominator, plus sign/overhead). -/
def ratBL (r : ℚ) : ℕ := Nat.log 2 r.num.natAbs + Nat.log 2 r.den + 2

/-- Bit length `bl(A)` of a rational matrix: sum of entry bit lengths. -/
def matBL {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℚ) : ℕ := ∑ i, ∑ j, ratBL (A i j)

/-- Bit length `bl(b)` of a rational vector. -/
def vecBL {m : ℕ} (b : Fin m → ℚ) : ℕ := ∑ i, ratBL (b i)

/-- `enc(f)`: "rational coefficients encoded in binary and exponent vectors in unary": for each
monomial in the support, the coefficient's bit length plus the total degree (unary exponents),
plus the number of variables. -/
def polyEnc {n : ℕ} (f : MvPolynomial (Fin n) ℚ) : ℕ :=
  n + ∑ μ ∈ f.support, (ratBL (coeff μ f) + ∑ i : Fin n, μ i + 1)

/-- `enc(P) = bl(A) + bl(b)`. -/
def polyhedronEnc {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℚ) (b : Fin m → ℚ) : ℕ :=
  matBL A + vecBL b

/-- Real evaluation of a rational polynomial at `x ∈ ℝⁿ`. -/
def evalR {n : ℕ} (f : MvPolynomial (Fin n) ℚ) (x : Fin n → ℝ) : ℝ :=
  eval₂ (Rat.castHom ℝ) x f

/-- Euclidean norm on `ℝⁿ` (the default norm on `Fin n → ℝ` is the sup norm). -/
def eNorm {n : ℕ} (x : Fin n → ℝ) : ℝ := Real.sqrt (∑ i, x i ^ 2)

/-- The polyhedron `P = {x ∈ ℝⁿ : Ax ≤ b}`. -/
def Polyhedron {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℚ) (b : Fin m → ℚ) : Set (Fin n → ℝ) :=
  {x | ∀ i, ∑ j, (A i j : ℝ) * x j ≤ (b i : ℝ)}

/-- `f` is unbounded from below on `S`. -/
def UnboundedBelowOn {n : ℕ} (f : MvPolynomial (Fin n) ℚ) (S : Set (Fin n → ℝ)) : Prop :=
  ∀ M : ℝ, ∃ x ∈ S, evalR f x < M

/-- `f` attains its global minimum on `S` at a point of Euclidean norm at most `R`. -/
def AttainsMinWithin {n : ℕ} (f : MvPolynomial (Fin n) ℚ) (S : Set (Fin n → ℝ)) (R : ℝ) :
    Prop :=
  ∃ xs ∈ S, (∀ y ∈ S, evalR f xs ≤ evalR f y) ∧ eNorm xs ≤ R

/-! ## Rubric lemma stubs -/

/-- Rubric 1 (dual certificate, effective Farkas): if the system `Ad ≤ 0, Ud = 0, wᵀd = 1` has no
real solution, then `w = Aᵀλ + Uᵀz` for some rational `λ ≥ 0` and `z`, of bit length
polynomial in that of `A, U, w`. [HessesRedemptionEfficientConvex, node_04] -/
theorem dual_certificate :
    ∃ C e : ℕ, ∀ (m n k : ℕ) (A : Matrix (Fin m) (Fin n) ℚ) (U : Matrix (Fin k) (Fin n) ℚ)
      (w : Fin n → ℚ),
      (¬ ∃ d : Fin n → ℝ, (∀ i, ∑ j, (A i j : ℝ) * d j ≤ 0) ∧
          (∀ i, ∑ j, (U i j : ℝ) * d j = 0) ∧ ∑ j, (w j : ℝ) * d j = 1) →
      ∃ (lam : Fin m → ℚ) (z : Fin k → ℚ), (∀ i, 0 ≤ lam i) ∧
        (∀ j, w j = ∑ i, A i j * lam i + ∑ i, U i j * z i) ∧
        vecBL lam + vecBL z ≤ C * (matBL A + matBL U + vecBL w + 1) ^ e := by
  sorry

/-- Rubric 3 (bounded representative): for every feasible `x ∈ P` and rational matrix `R`,
there is `y ∈ P` with `Ry = Rx` and `‖y‖ ≤ 2^{poly(enc A, b, R)} · (1 + ‖Rx‖)`.  (Removing the
lineality space of the slice and taking a vertex.) [HessesRedemptionEfficientConvex, node_04] -/
theorem bounded_representative :
    ∃ C e : ℕ, ∀ (m n r : ℕ) (A : Matrix (Fin m) (Fin n) ℚ) (b : Fin m → ℚ)
      (R : Matrix (Fin r) (Fin n) ℚ) (x : Fin n → ℝ), x ∈ Polyhedron A b →
      ∃ y ∈ Polyhedron A b,
        (∀ i, ∑ j, (R i j : ℝ) * y j = ∑ j, (R i j : ℝ) * x j) ∧
        eNorm y ≤ (2 : ℝ) ^ (C * (polyhedronEnc A b + matBL R + 1) ^ e) *
          (1 + eNorm (fun i => ∑ j, (R i j : ℝ) * x j)) := by
  sorry

/-- Rubric 4 (localization): if `f` is convex and bounded below on the nonempty `P`, there is
`R₀ = 2^{poly}` such that every value of `f` on `P` is matched or beaten inside the ball of
radius `R₀`. [HessesRedemptionEfficientConvex, node_04] -/
theorem localization :
    ∃ C e : ℕ, ∀ (m n : ℕ) (A : Matrix (Fin m) (Fin n) ℚ) (b : Fin m → ℚ)
      (f : MvPolynomial (Fin n) ℚ),
      ConvexOn ℝ Set.univ (evalR f) → (Polyhedron A b).Nonempty →
      ¬ UnboundedBelowOn f (Polyhedron A b) →
      ∀ x ∈ Polyhedron A b, ∃ y ∈ Polyhedron A b, evalR f y ≤ evalR f x ∧
        eNorm y ≤ (2 : ℝ) ^ (C * (polyEnc f + polyhedronEnc A b + 1) ^ e) := by
  sorry

/-! ## Main theorem -/

/-- **Dichotomy.** There is a uniform polynomial bound such that for every convex rational
polynomial `f` and nonempty rational polyhedron `P = {Ax ≤ b}`, exactly one holds:
`f` is unbounded below on `P`, or `f` attains its minimum on `P` at some `x*` with
`‖x*‖ ≤ 2^{C (enc f + enc P + 1)^e}`. [HessesRedemptionEfficientConvex, node_04] -/
theorem convex_poly_min_dichotomy :
    ∃ C e : ℕ, ∀ (m n : ℕ) (A : Matrix (Fin m) (Fin n) ℚ) (b : Fin m → ℚ)
      (f : MvPolynomial (Fin n) ℚ),
      ConvexOn ℝ Set.univ (evalR f) → (Polyhedron A b).Nonempty →
      Xor' (UnboundedBelowOn f (Polyhedron A b))
        (AttainsMinWithin f (Polyhedron A b)
          ((2 : ℝ) ^ (C * (polyEnc f + polyhedronEnc A b + 1) ^ e))) := by
  sorry

end TCSChallenge.HessesRedemptionEfficientConvex.node_04
