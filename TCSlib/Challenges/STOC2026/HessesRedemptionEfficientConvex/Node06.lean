/-!
## Effective linear decomposition and strongly convex quadratic minorant

For a convex `f ∈ ℚ[x₁,…,xₙ]` with `N = enc(f)` there are a rational matrix `U` with pairwise
orthogonal rows spanning `𝒰`, and `w ∈ ℚⁿ ∩ 𝒰^⊥`, with `f(x) = f(x_𝒰) - ⟨w,x⟩`, plus a rational
quadratic `q` on `ℝᵏ` with `∇²q ⪰ μ I`, `μ ≥ 2^{-poly(N)}`, `enc(q) ≤ poly(N)` and
`f(x_𝒰) ≥ q(Ux)`.  Main theorem: `convex_poly_structure`.
-/

namespace TCSChallenge.HessesRedemptionEfficientConvex.node_06

open MvPolynomial

/-- Bit length of a rational number `p/q` in lowest terms (binary encoding of numerator and
denominator, plus sign/overhead). -/
def ratBL (r : ℚ) : ℕ := Nat.log 2 r.num.natAbs + Nat.log 2 r.den + 2

/-- Bit length `bl(A)` of a rational matrix: sum of entry bit lengths. -/
def matBL {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℚ) : ℕ := ∑ i, ∑ j, ratBL (A i j)

/-- Bit length `bl(b)` of a rational vector. -/
def vecBL {m : ℕ} (b : Fin m → ℚ) : ℕ := ∑ i, ratBL (b i)

/-- `enc(f)`: "rational coefficients encoded in binary and exponent vectors in unary": for each
monomial in the support, the coefficient's bit length plus the total degree (unary exponents),
plus the number of variables. -/
def polyEnc {n : ℕ} (f : MvPolynomial (Fin n) ℚ) : ℕ :=
  n + ∑ μ ∈ f.support, (ratBL (coeff μ f) + ∑ i : Fin n, μ i + 1)

/-- Real evaluation of a rational polynomial at `x ∈ ℝⁿ`. -/
def evalR {n : ℕ} (f : MvPolynomial (Fin n) ℚ) (x : Fin n → ℝ) : ℝ :=
  eval₂ (Rat.castHom ℝ) x f

/-- Euclidean norm on `ℝⁿ` (the default norm on `Fin n → ℝ` is the sup norm). -/
def eNorm {n : ℕ} (x : Fin n → ℝ) : ℝ := Real.sqrt (∑ i, x i ^ 2)

/-- Real inner product `⟨u, x⟩` of a rational vector with a real vector. -/
def qdot {n : ℕ} (u : Fin n → ℚ) (x : Fin n → ℝ) : ℝ := ∑ j, (u j : ℝ) * x j

/-- `Ux ∈ ℝᵏ`. -/
def matApply {k n : ℕ} (U : Matrix (Fin k) (Fin n) ℚ) (x : Fin n → ℝ) : Fin k → ℝ :=
  fun i => qdot (U i) x

/-- "a matrix whose nonzero rows are pairwise orthogonal": distinct rows have zero dot product
(zero rows are automatically orthogonal to everything). -/
def RowsPairwiseOrthogonal {k n : ℕ} (U : Matrix (Fin k) (Fin n) ℚ) : Prop :=
  ∀ i i', i ≠ i' → ∑ j, U i j * U i' j = 0

/-- `x_𝒰`, the orthogonal projection onto `𝒰 = rowspan U`, written via the pairwise orthogonal
rows: `x_𝒰 = ∑_{U_i ≠ 0} (⟨U_i, x⟩ / ‖U_i‖²) U_i`.  (This is the orthogonal projection when
`RowsPairwiseOrthogonal U` holds.) -/
def rowProj {k n : ℕ} (U : Matrix (Fin k) (Fin n) ℚ) (x : Fin n → ℝ) : Fin n → ℝ :=
  fun j => ∑ i, (if (∑ l, U i l * U i l) = 0 then 0
    else qdot (U i) x / ((∑ l, U i l * U i l : ℚ) : ℝ) * (U i j : ℝ))

/-- `w ∈ 𝒰^⊥`: `w` is orthogonal to every row of `U`. -/
def OrthToRows {k n : ℕ} (U : Matrix (Fin k) (Fin n) ℚ) (w : Fin n → ℚ) : Prop :=
  ∀ i, ∑ j, U i j * w j = 0

/-- A rational quadratic on `ℝᵏ`, `q(y) = c + lᵀy + ½ yᵀQy`. -/
structure Quadratic (k : ℕ) where
  c : ℚ
  l : Fin k → ℚ
  Q : Matrix (Fin k) (Fin k) ℚ

/-- Evaluation of a quadratic at `y ∈ ℝᵏ`. -/
def Quadratic.eval {k : ℕ} (q : Quadratic k) (y : Fin k → ℝ) : ℝ :=
  (q.c : ℝ) + ∑ i, (q.l i : ℝ) * y i + (1 / 2 : ℝ) * ∑ i, ∑ j, (q.Q i j : ℝ) * y i * y j

/-- `enc(q)`: total bit length of the coefficient data. -/
def Quadratic.enc {k : ℕ} (q : Quadratic k) : ℕ := ratBL q.c + vecBL q.l + matBL q.Q + k

/-- "`q` is `μ`-strongly convex, `∇²q ⪰ μ I`": since `∇²q = (Q + Qᵀ)/2`, this is
`yᵀQy ≥ μ‖y‖²` for all `y`.  For `k = 0` this holds for every `μ` (the stated convention). -/
def Quadratic.StronglyConvex {k : ℕ} (q : Quadratic k) (μ : ℝ) : Prop :=
  ∀ y : Fin k → ℝ, μ * ∑ i, y i ^ 2 ≤ ∑ i, ∑ j, (q.Q i j : ℝ) * y i * y j

/-- Directional derivative `∇_v f(x) = ∑ᵢ vᵢ ∂ᵢf(x)`. -/
def dirDeriv {n : ℕ} (f : MvPolynomial (Fin n) ℚ) (v x : Fin n → ℝ) : ℝ :=
  ∑ i, v i * evalR (pderiv i f) x

/-- The Hessian of `f` as a matrix of polynomials. -/
def hessianPoly {n : ℕ} (f : MvPolynomial (Fin n) ℚ) : Matrix (Fin n) (Fin n) (MvPolynomial (Fin n) ℚ) :=
  Matrix.of fun i j => pderiv i (pderiv j f)

/-! ## Rubric lemma stubs -/

/-- Rubric 1 (linear-direction decomposition): there are `U` (pairwise orthogonal rows) and
`w ⊥ rows(U)` such that `rowspan(U)^⊥` is exactly the set of directions with constant
directional derivative, and `f(x) = f(x_𝒰) - ⟨w,x⟩`. [HessesRedemptionEfficientConvex, node_06] -/
theorem linear_direction_decomposition {n : ℕ} (f : MvPolynomial (Fin n) ℚ) :
    ∃ (k : ℕ) (U : Matrix (Fin k) (Fin n) ℚ) (w : Fin n → ℚ),
      RowsPairwiseOrthogonal U ∧ OrthToRows U w ∧
      (∀ v : Fin n → ℝ, (∀ i, qdot (U i) v = 0) ↔
        ∃ c : ℝ, ∀ x, dirDeriv f v x = c) ∧
      ∀ x : Fin n → ℝ, evalR f x = evalR f (rowProj U x) - qdot w x := by
  sorry

/-- Rubric 2 (identically singular Hessian ⇒ direction of linearity): if `g` is convex and
`det ∇²g ≡ 0`, then some nonzero direction has globally constant directional derivative.
(Proof via Sard's theorem and convexity of the gradient range.) [HessesRedemptionEfficientConvex, node_06] -/
theorem singular_hessian_linear_direction {k : ℕ} (g : MvPolynomial (Fin k) ℚ)
    (hconv : ConvexOn ℝ Set.univ (evalR g)) (hdet : (hessianPoly g).det = 0) :
    ∃ v : Fin k → ℝ, v ≠ 0 ∧ ∃ c : ℝ, ∀ y, dirDeriv g v y = c := by
  sorry

/-- Rubric 3 (global second-order inequality): for a convex polynomial `g` of degree `δ` and any
point `b`, `g(y) ≥ g(b) + ⟨∇g(b), y-b⟩ + (y-b)ᵀ∇²g(b)(y-b) / (4δ²)`. [HessesRedemptionEfficientConvex, node_06] -/
theorem second_order_minorant {k : ℕ} (g : MvPolynomial (Fin k) ℚ)
    (hconv : ConvexOn ℝ Set.univ (evalR g)) (b y : Fin k → ℝ) :
    evalR g b + ∑ i, evalR (pderiv i g) b * (y i - b i) +
        (∑ i, ∑ j, evalR (pderiv i (pderiv j g)) b * (y i - b i) * (y j - b j)) /
          (4 * (g.totalDegree : ℝ) ^ 2) ≤ evalR g y := by
  sorry

/-! ## Main theorem -/

/-- **Structure theorem for convex rational polynomials (effective form).**  Uniformly in `f`,
with `N = enc(f)`: there are `U ∈ ℚ^{k×n}` with pairwise orthogonal rows, `w ∈ ℚⁿ ∩ 𝒰^⊥` with
`f(x) = f(x_𝒰) - ⟨w,x⟩`, and a rational quadratic `q` with `∇²q ⪰ μ I`,
`μ ≥ 2^{-poly(N)}`, `f(x_𝒰) ≥ q(Ux)`; `U`, `w`, `q` all have bit length `≤ poly(N)`. [HessesRedemptionEfficientConvex, node_06] -/
theorem convex_poly_structure :
    ∃ C e : ℕ, ∀ (n : ℕ) (f : MvPolynomial (Fin n) ℚ),
      ConvexOn ℝ Set.univ (evalR f) →
      ∃ (k : ℕ) (U : Matrix (Fin k) (Fin n) ℚ) (w : Fin n → ℚ) (q : Quadratic k) (μ : ℝ),
        RowsPairwiseOrthogonal U ∧ OrthToRows U w ∧
        (∀ x : Fin n → ℝ, evalR f x = evalR f (rowProj U x) - qdot w x) ∧
        matBL U + vecBL w ≤ C * (polyEnc f + 1) ^ e ∧
        q.enc ≤ C * (polyEnc f + 1) ^ e ∧
        1 / (2 : ℝ) ^ (C * (polyEnc f + 1) ^ e) ≤ μ ∧
        q.StronglyConvex μ ∧
        (∀ x : Fin n → ℝ, q.eval (matApply U x) ≤ evalR f (rowProj U x)) := by
  sorry

end TCSChallenge.HessesRedemptionEfficientConvex.node_06
