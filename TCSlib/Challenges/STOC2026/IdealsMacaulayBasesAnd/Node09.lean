/-!
## Composing robust assignment testers: a PCP for 3-COLOR

A robust assignment tester for a predicate `φ` on primary variables `X` introduces auxiliary
variables `Y` and local tests `ψ_i` (`i ∈ I`), each reading a few coordinates of `X ⊕ Y`.
It is *complete* if every satisfying `σ` extends to an assignment accepted by every `ψ_i`, and
*`ρ`-robust* if `E_i[δ(view_i, ψ_i^{-1}(1))] ≥ ρ · δ(σ, φ^{-1}(1))` for all `σ, τ`.

We compose an outer tester (tester (I)) with inner testers (tester (II), applied to every
outer test `ψ_i` with primary variables `Z_i = Vars(ψ_i)` and fresh disjoint auxiliary sets
`W_i`), keeping the coordinates of `Z_i` global.  We state:

* completeness and `γ₀γ₁`-robustness of the composition (rubric 1–2);
* the randomness arithmetic `c₀ log N + c₁ √M = O(log N)` (rubric 3);
* the coloring predicate `φ_G` (two bits per vertex) is satisfiable iff `G` is 3-colorable,
  and local distance is at most the rejection indicator (rubric 4);
* main theorem `three_color_pcp_core`: the composed tester on `φ_G`, repeated
  `t = ⌈ln 2 / (γ₀γ₁)⌉` times, has perfect completeness and soundness `≤ 1/2` (rubric 5).
-/

namespace TCSChallenge.IdealsMacaulayBasesAndPCPs.node_09

/-- `δ(u, S)`: minimum relative Hamming distance from `u` to the set `S = {w | p w}`,
with `δ(u, ∅) = 1`. -/
def distToSat {ι : Type} [Fintype ι] (u : ι → Bool) (p : (ι → Bool) → Prop) : ℝ :=
  if h : (Finset.univ.filter p).Nonempty then
    (Finset.univ.filter p).inf' h
      (fun w => (hammingDist u w : ℝ) / (Fintype.card ι : ℝ))
  else 1

/-- A local predicate `ψ`: it reads `arity` coordinates `pos 0, …, pos (arity-1)` of the
global assignment and applies the Boolean function `test` to that local view. -/
structure LocalTest (Var : Type) where
  arity : ℕ
  pos : Fin arity → Var
  test : (Fin arity → Bool) → Bool

/-- The local view `(σ ∪ τ)|_{Vars(ψ)}`. -/
def LocalTest.view {Var : Type} (t : LocalTest Var) (a : Var → Bool) : Fin t.arity → Bool :=
  fun k => a (t.pos k)

/-- `ψ` accepts the global assignment `a`. -/
def LocalTest.Accepts {Var : Type} (t : LocalTest Var) (a : Var → Bool) : Prop :=
  t.test (t.view a) = true

/-- `δ((σ ∪ τ)|_{Vars(ψ)}, ψ^{-1}(1))`. -/
def LocalTest.localDist {Var : Type} (t : LocalTest Var) (a : Var → Bool) : ℝ :=
  distToSat (t.view a) (fun w => t.test w = true)

/-- Output of an assignment tester: local tests indexed by the random strings `I`
(the paper has `|I| = 2^{r(N)}`), over primary variables `X` and auxiliary variables `Y`. -/
structure TestSystem (X Y I : Type) where
  tests : I → LocalTest (X ⊕ Y)

/-- Uniform average `E_i[f i]` over a finite index type. -/
def avg {I : Type} [Fintype I] (f : I → ℝ) : ℝ :=
  (∑ i, f i) / (Fintype.card I : ℝ)

/-- "If `σ` satisfies `φ`, there is an assignment `τ` to `Y` for which every `ψ_i` accepts." -/
def IsComplete {X Y I : Type} (φ : (X → Bool) → Prop) (T : TestSystem X Y I) : Prop :=
  ∀ σ : X → Bool, φ σ → ∃ τ : Y → Bool, ∀ i, (T.tests i).Accepts (Sum.elim σ τ)

/-- "For every `σ` and every `τ`,
`E_i[δ((σ∪τ)|_{Vars(ψ_i)}, ψ_i^{-1}(1))] ≥ ρ · δ(σ, φ^{-1}(1))`." -/
def IsRobust {X Y I : Type} [Fintype X] [Fintype I] (φ : (X → Bool) → Prop)
    (T : TestSystem X Y I) (ρ : ℝ) : Prop :=
  ∀ (σ : X → Bool) (τ : Y → Bool),
    ρ * distToSat σ φ ≤ avg (fun i => (T.tests i).localDist (Sum.elim σ τ))

/-- The predicate `ψ_i^{-1}(1)` on the local coordinates `Z_i`, which becomes the
primary predicate of the inner tester. -/
def outerPred {X Y I : Type} (T : TestSystem X Y I) (i : I) :
    (Fin (T.tests i).arity → Bool) → Prop :=
  fun w => (T.tests i).test w = true

/-- Global identity of outer coordinates: primary `x ↦ x`, outer auxiliary `y ↦ y`. -/
def liftOuter {X Y I : Type} (W : I → Type) : X ⊕ Y → X ⊕ (Y ⊕ (Σ i, W i))
  | Sum.inl x => Sum.inl x
  | Sum.inr y => Sum.inr (Sum.inl y)

/-- The combined tester: primary variables `X`, auxiliary variables `Y ∪ ⋃_i W_i` with the
`W_i` disjoint, local tests `χ_{i,j}`.  An inner primary coordinate `p ∈ Z_i` refers to the
global coordinate `pos_i p ∈ X ∪ Y`; an inner auxiliary coordinate `w ∈ W_i` is fresh. -/
def compose {X Y I J : Type} (T₁ : TestSystem X Y I) (W : I → Type)
    (T₂ : ∀ i, TestSystem (Fin (T₁.tests i).arity) (W i) J) :
    TestSystem X (Y ⊕ (Σ i, W i)) (I × J) where
  tests ij :=
    { arity := ((T₂ ij.1).tests ij.2).arity
      pos := fun k =>
        Sum.elim (fun p => liftOuter W ((T₁.tests ij.1).pos p))
          (fun w => Sum.inr (Sum.inr ⟨ij.1, w⟩)) (((T₂ ij.1).tests ij.2).pos k)
      test := ((T₂ ij.1).tests ij.2).test }

/-! ## Rubric 1–2: the combined tester -/

theorem compose_complete {X Y I J : Type} (φ : (X → Bool) → Prop) (T₁ : TestSystem X Y I)
    (W : I → Type) (T₂ : ∀ i, TestSystem (Fin (T₁.tests i).arity) (W i) J)
    (h₁ : IsComplete φ T₁) (h₂ : ∀ i, IsComplete (outerPred T₁ i) (T₂ i)) :
    IsComplete φ (compose T₁ W T₂) := by
  sorry

/-- Averaging over `I × J` is averaging over `i` of the average over `j`. [IdealsMacaulayBasesAnd, node_09] -/
theorem avg_prod {I J : Type} [Fintype I] [Fintype J] [Nonempty J] (f : I × J → ℝ) :
    avg f = avg (fun i => avg (fun j => f (i, j))) := by
  sorry

theorem compose_robust {X Y I J : Type} [Fintype X] [Fintype I] [Fintype J]
    [Nonempty I] [Nonempty J]
    (φ : (X → Bool) → Prop) (T₁ : TestSystem X Y I)
    (W : I → Type) (T₂ : ∀ i, TestSystem (Fin (T₁.tests i).arity) (W i) J)
    (γ₀ γ₁ : ℝ) (hγ₁ : 0 ≤ γ₁)
    (h₁ : IsRobust φ T₁ γ₀) (h₂ : ∀ i, IsRobust (outerPred T₁ i) (T₂ i) γ₁) :
    IsRobust φ (compose T₁ W T₂) (γ₀ * γ₁) := by
  sorry

/-! ## Rubric 3: randomness arithmetic -/

/-- With `L = max{1, log N}` and `M = ⌈c₀ L²⌉`, `r₁(N) + r₂(M) ≤ c₀ L + c₁ √M = O(L)`. [IdealsMacaulayBasesAnd, node_09] -/
theorem randomness_bound (c₀ c₁ : ℝ) (hc₀ : 0 < c₀) (hc₁ : 0 < c₁) :
    ∃ C : ℝ, ∀ N : ℕ, 1 ≤ N →
      c₀ * max 1 (Real.logb 2 N) +
        c₁ * Real.sqrt (⌈c₀ * (max 1 (Real.logb 2 N)) ^ 2⌉₊ : ℝ)
        ≤ C * max 1 (Real.logb 2 N) := by
  sorry

/-! ## Rubric 4: PCP conversion -/

/-- Color of vertex `v` under the two-bit encoding. -/
def colorOf {n : ℕ} (σ : Fin n × Fin 2 → Bool) (v : Fin n) : Bool × Bool :=
  (σ (v, 0), σ (v, 1))

/-- The coloring predicate `φ_G`: forbid the unused fourth two-bit value and require distinct
colors on the endpoints of each edge. -/
def colorPred {n : ℕ} (G : SimpleGraph (Fin n)) (σ : Fin n × Fin 2 → Bool) : Prop :=
  (∀ v, colorOf σ v ≠ (true, true)) ∧ ∀ u v, G.Adj u v → colorOf σ u ≠ colorOf σ v

theorem colorPred_satisfiable_iff {n : ℕ} (G : SimpleGraph (Fin n)) :
    (∃ σ, colorPred G σ) ↔ G.Colorable 3 := by
  sorry

/-- If `φ^{-1}(1) = ∅` then `δ(σ, φ^{-1}(1)) = 1`. [IdealsMacaulayBasesAnd, node_09] -/
theorem distToSat_of_unsat {ι : Type} [Fintype ι] (p : (ι → Bool) → Prop)
    (hp : ∀ w, ¬ p w) (u : ι → Bool) : distToSat u p = 1 := by
  sorry

/-- `δ(local view, satisfying views) ≤ 1_{ψ rejects}`. [IdealsMacaulayBasesAnd, node_09] -/
theorem localDist_le_reject {Var : Type} (t : LocalTest Var) (a : Var → Bool) :
    t.localDist a ≤ if t.Accepts a then 0 else 1 := by
  sorry

/-- Fraction of random strings on which the verifier accepts proof `a`. -/
def acceptFrac {X Y I : Type} [Fintype I] (T : TestSystem X Y I) (a : X ⊕ Y → Bool) : ℝ :=
  ((Finset.univ.filter fun i => (T.tests i).Accepts a).card : ℝ) / (Fintype.card I : ℝ)

/-- Robustness `γ` on an unsatisfiable `φ` gives rejection probability `≥ γ`. [IdealsMacaulayBasesAnd, node_09] -/
theorem reject_of_robust {X Y I : Type} [Fintype X] [Fintype I] [Nonempty I]
    (φ : (X → Bool) → Prop) (T : TestSystem X Y I) (γ : ℝ) (hT : IsRobust φ T γ)
    (hunsat : ∀ σ, ¬ φ σ) (σ : X → Bool) (τ : Y → Bool) :
    acceptFrac T (Sum.elim σ τ) ≤ 1 - γ := by
  sorry

/-! ## Rubric 5: amplification -/

/-- Acceptance probability of `t` independent repetitions against the same proof: the fraction
of `t`-tuples of random strings on which every repetition accepts. -/
def repeatAcceptFrac {X Y I : Type} [Fintype I] (T : TestSystem X Y I) (a : X ⊕ Y → Bool)
    (t : ℕ) : ℝ :=
  ((Finset.univ.filter fun r : Fin t → I => ∀ s, (T.tests (r s)).Accepts a).card : ℝ) /
    (Fintype.card (Fin t → I) : ℝ)

theorem repeatAcceptFrac_eq_pow {X Y I : Type} [Fintype I] (T : TestSystem X Y I)
    (a : X ⊕ Y → Bool) (t : ℕ) : repeatAcceptFrac T a t = acceptFrac T a ^ t := by
  sorry

/-! ## Main theorem -/

/-- Main theorem (combinatorial core of `3-COLOR ∈ PCP_{1,1/2}[C log n, ℓ, a]`).
Let `T₁` be a complete `γ₀`-robust outer tester for `φ_G`, and `T₂ i` complete `γ₁`-robust
inner testers for the outer predicates `ψ_i`, with `γ₀, γ₁ > 0`.  The verifier picks a random
`(i,j)`, reads the view of `χ_{i,j}` in the proof `σ ∪ τ ∪ ⋃ η_i`, and is repeated
`t = ⌈ln 2 / (γ₀γ₁)⌉` times.  Then it accepts some proof with probability 1 if `G` is
3-colorable, and accepts every proof with probability `≤ 1/2` otherwise. [IdealsMacaulayBasesAnd, node_09] -/
theorem three_color_pcp_core {n : ℕ} (G : SimpleGraph (Fin n))
    {Y I J : Type} [Fintype I] [Fintype J] [Nonempty I] [Nonempty J]
    (T₁ : TestSystem (Fin n × Fin 2) Y I) (W : I → Type)
    (T₂ : ∀ i, TestSystem (Fin (T₁.tests i).arity) (W i) J)
    (γ₀ γ₁ : ℝ) (hγ₀ : 0 < γ₀) (hγ₁ : 0 < γ₁)
    (hc₁ : IsComplete (colorPred G) T₁) (hr₁ : IsRobust (colorPred G) T₁ γ₀)
    (hc₂ : ∀ i, IsComplete (outerPred T₁ i) (T₂ i))
    (hr₂ : ∀ i, IsRobust (outerPred T₁ i) (T₂ i) γ₁) :
    (G.Colorable 3 →
      ∃ a : (Fin n × Fin 2) ⊕ (Y ⊕ (Σ i, W i)) → Bool,
        repeatAcceptFrac (compose T₁ W T₂) a ⌈Real.log 2 / (γ₀ * γ₁)⌉₊ = 1) ∧
    (¬ G.Colorable 3 →
      ∀ a : (Fin n × Fin 2) ⊕ (Y ⊕ (Σ i, W i)) → Bool,
        repeatAcceptFrac (compose T₁ W T₂) a ⌈Real.log 2 / (γ₀ * γ₁)⌉₊ ≤ 1 / 2) := by
  sorry

