/-!
## Algebraic core of the 3-COLOR PCP via Macaulay bases

Let `F` be a finite field of characteristic `≠ 2`, `V ⊆ F^m` nonempty with extension degree
at most `d`, and `G` a simple graph on `V`.  Let `Ê` be a degree-`≤ 2d` polynomial in
`2m` variables with `Ê(u,v) = [uv ∈ E]` on `V × V`.

For `χ` a polynomial in `m` variables put
`A = χ (χ - 1) (χ + 1)` and `B(x,y) = Ê(x,y) ∏_{s ∈ (1,-1,2,-2)} (χ(x) - χ(y) - s)`.

The PCP verifier runs low-degree tests, the pointwise consistency tests
`Ã(a) = χ̃(a)(χ̃(a)-1)(χ̃(a)+1)` and `B̃(a,b) = Ê(a,b) ∏ (χ̃(a)-χ̃(b)-s)`, and vanishing tests.
We state:

* the arithmetization lemmas (degree bounds `3d`, `6d`; behaviour on `V`, `V × V`);
* completeness: a proper 3-coloring gives `χ̂` of degree `≤ d` with `A|_V ≡ 0`, `B|_{V×V} ≡ 0`;
* identity recovery: closeness of the oracles to low-degree polynomials plus a small
  consistency-test failure rate forces exact polynomial identities (via the polynomial
  distance bound);
* the main soundness theorem `algebraic_soundness`: if the tests' conclusions hold for the
  nearby polynomials (distance `≤ 4γ`, test failure `≤ γ`, `13γ < 1 - 6d/q`, and vanishing of
  `P_A` on `V` and of `P_B` on `V × V`), then `G` is 3-colorable.
-/

namespace TCSChallenge.IdealsMacaulayBasesAndPCPs.node_05

variable {F : Type} [Field F] [Fintype F]

/-- "Normalized Hamming distance" `δ(f,g)`: the fraction of points of the (finite) domain
where `f` and `g` differ. -/
def relDist {α : Type} [Fintype α] (f g : α → F) : ℝ :=
  ((Finset.univ.filter fun x => f x ≠ g x).card : ℝ) / (Fintype.card α : ℝ)

/-- "every function `V → F_q` is the restriction of a polynomial of total degree at most `d`". -/
def HasExtensionDegreeAtMost {m : ℕ} (V : Finset (Fin m → F)) (d : ℕ) : Prop :=
  ∀ f : V → F, ∃ P : MvPolynomial (Fin m) F,
    P.totalDegree ≤ d ∧ ∀ x : V, MvPolynomial.eval x.1 P = f x

/-- "the extension degree of `V` [is] the least `d` such that every function `V → F_q` is the
restriction of a polynomial of total degree at most `d`". -/
def extensionDegree {m : ℕ} (V : Finset (Fin m → F)) : ℕ :=
  sInf {d : ℕ | HasExtensionDegreeAtMost V d}

/-- `P ∈ I(V)`: `P` vanishes on `V`. -/
def VanishesOn {m : ℕ} (V : Finset (Fin m → F)) (P : MvPolynomial (Fin m) F) : Prop :=
  ∀ x ∈ V, MvPolynomial.eval x P = 0

/-- "A Macaulay basis of `I(V)` is a finite set `𝔊 ⊆ I(V)` for which every `P ∈ I(V)` admits a
representation `P = ∑_{g ∈ 𝔊} h_g g` with `deg(h_g g) ≤ deg P`." -/
def IsMacaulayBasis {m : ℕ} (V : Finset (Fin m → F))
    (𝔊 : Finset (MvPolynomial (Fin m) F)) : Prop :=
  (∀ g ∈ 𝔊, VanishesOn V g) ∧
  ∀ P : MvPolynomial (Fin m) F, VanishesOn V P →
    ∃ h : MvPolynomial (Fin m) F → MvPolynomial (Fin m) F,
      P = ∑ g ∈ 𝔊, h g * g ∧ ∀ g ∈ 𝔊, (h g * g).totalDegree ≤ P.totalDegree

/-- "The Macaulay complexity of `V` is the minimum cardinality of such a basis."
(Only used in the dropped randomness / proof-size bounds.) -/
def macaulayComplexity {m : ℕ} (V : Finset (Fin m → F)) : ℕ :=
  sInf {k : ℕ | ∃ 𝔊 : Finset (MvPolynomial (Fin m) F), IsMacaulayBasis V 𝔊 ∧ 𝔊.card = k}

/-- Evaluation of a polynomial in `2m` variables at the pair `(x, y)`. -/
def eval₂ {m : ℕ} (x y : Fin m → F) (P : MvPolynomial (Fin m ⊕ Fin m) F) : F :=
  MvPolynomial.eval (Sum.elim x y) P

/-- "`Ê(u,v) = 1 ⟺ (u,v) ∈ E` for `u, v ∈ V`" (and `Ê(u,v) = 0` otherwise, used in
completeness). -/
def IsEdgeIndicator {m : ℕ} {V : Finset (Fin m → F)} (G : SimpleGraph V)
    (E : MvPolynomial (Fin m ⊕ Fin m) F) : Prop :=
  ∀ u v : V, eval₂ u.1 v.1 E = if G.Adj u v then 1 else 0

/-- The four-term list `(1, -1, 2, -2)` (kept as a list so that repeated field elements in
characteristic 3 still give four factors). -/
def shiftList : List F := [1, -1, 2, -2]

/-- Color-validity polynomial `A(x) = χ(x)(χ(x) - 1)(χ(x) + 1)`. -/
def colorPoly {m : ℕ} (χ : MvPolynomial (Fin m) F) : MvPolynomial (Fin m) F :=
  χ * (χ - 1) * (χ + 1)

/-- Edge-validity polynomial `B(x,y) = Ê(x,y) ∏_{s ∈ (1,-1,2,-2)} (χ(x) - χ(y) - s)`. -/
def edgePoly {m : ℕ} (E : MvPolynomial (Fin m ⊕ Fin m) F) (χ : MvPolynomial (Fin m) F) :
    MvPolynomial (Fin m ⊕ Fin m) F :=
  E * ((shiftList.map fun s : F =>
      MvPolynomial.rename Sum.inl χ - MvPolynomial.rename Sum.inr χ - MvPolynomial.C s).prod)

/-- Failure fraction of the color consistency test
`Ã(a) = χ̃(a)(χ̃(a) - 1)(χ̃(a) + 1)` over uniform `a ∈ F^m`. -/
def colorTestFailure {m : ℕ} (χt At : (Fin m → F) → F) : ℝ :=
  relDist At (fun a => χt a * (χt a - 1) * (χt a + 1))

/-- Failure fraction of the edge consistency test
`B̃(a,b) = Ê(a,b) ∏_s (χ̃(a) - χ̃(b) - s)` over independent uniform `a, b ∈ F^m`. -/
def edgeTestFailure {m : ℕ} (E : MvPolynomial (Fin m ⊕ Fin m) F) (χt : (Fin m → F) → F)
    (Bt : (Fin m → F) × (Fin m → F) → F) : ℝ :=
  relDist Bt (fun p => eval₂ p.1 p.2 E * ((shiftList.map fun s : F => χt p.1 - χt p.2 - s).prod))

/-- Evaluation function of a polynomial in `2m` variables, viewed on pairs. -/
def evalPair {m : ℕ} (P : MvPolynomial (Fin m ⊕ Fin m) F) :
    (Fin m → F) × (Fin m → F) → F :=
  fun p => eval₂ p.1 p.2 P

/-! ## Rubric 1: constraint arithmetization -/

theorem colorPoly_totalDegree_le {m d : ℕ} (χ : MvPolynomial (Fin m) F)
    (hχ : χ.totalDegree ≤ d) : (colorPoly χ).totalDegree ≤ 3 * d := by
  sorry

theorem edgePoly_totalDegree_le {m d : ℕ} (E : MvPolynomial (Fin m ⊕ Fin m) F)
    (χ : MvPolynomial (Fin m) F) (hE : E.totalDegree ≤ 2 * d) (hχ : χ.totalDegree ≤ d) :
    (edgePoly E χ).totalDegree ≤ 6 * d := by
  sorry

/-- `z(z-1)(z+1) = 0 ⟺ z ∈ {-1, 0, 1}`. [IdealsMacaulayBasesAnd, node_05] -/
theorem colorPoly_eval_eq_zero_iff {m : ℕ} (χ : MvPolynomial (Fin m) F) (x : Fin m → F) :
    MvPolynomial.eval x (colorPoly χ) = 0 ↔
      MvPolynomial.eval x χ = -1 ∨ MvPolynomial.eval x χ = 0 ∨ MvPolynomial.eval x χ = 1 := by
  sorry

/-- Once `χ|_V` takes three-color values, `B(u,v) = 0` iff `(u,v) ∉ E` or `χ(u) ≠ χ(v)`
(characteristic `≠ 2`). [IdealsMacaulayBasesAnd, node_05] -/
theorem edgePoly_eval_eq_zero_iff (hchar : ringChar F ≠ 2) {m : ℕ} {V : Finset (Fin m → F)}
    (G : SimpleGraph V) (E : MvPolynomial (Fin m ⊕ Fin m) F) (hE : IsEdgeIndicator G E)
    (χ : MvPolynomial (Fin m) F) (u v : V)
    (hu : MvPolynomial.eval u.1 (colorPoly χ) = 0)
    (hv : MvPolynomial.eval v.1 (colorPoly χ) = 0) :
    eval₂ u.1 v.1 (edgePoly E χ) = 0 ↔
      (¬ G.Adj u v ∨ MvPolynomial.eval u.1 χ ≠ MvPolynomial.eval v.1 χ) := by
  sorry

/-! ## Rubric 2: completeness -/

/-- A proper 3-coloring yields a degree-`≤ d` extension `χ̂` with `A|_V ≡ 0` and
`B|_{V×V} ≡ 0`. [IdealsMacaulayBasesAnd, node_05] -/
theorem completeness {m d : ℕ} {V : Finset (Fin m → F)} (G : SimpleGraph V)
    (hext : HasExtensionDegreeAtMost V d)
    (E : MvPolynomial (Fin m ⊕ Fin m) F) (hE : IsEdgeIndicator G E)
    (hcol : G.Colorable 3) :
    ∃ χ : MvPolynomial (Fin m) F, χ.totalDegree ≤ d ∧
      VanishesOn V (colorPoly χ) ∧
      ∀ u ∈ V, ∀ v ∈ V, eval₂ u v (edgePoly E χ) = 0 := by
  sorry

/-! ## Rubric 3: recovery of exact identities -/

/-- Polynomial distance (from background fact 1): distinct polynomials of total degree
`≤ D` disagree on at least a `1 - D/q` fraction of `F^n`. [IdealsMacaulayBasesAnd, node_05] -/
theorem polynomial_distance {ι : Type} [Fintype ι] {D : ℕ} (P Q : MvPolynomial ι F)
    (hP : P.totalDegree ≤ D) (hQ : Q.totalDegree ≤ D) (hPQ : P ≠ Q) :
    1 - (D : ℝ) / (Fintype.card F : ℝ) ≤
      relDist (fun x => MvPolynomial.eval x P) (fun x => MvPolynomial.eval x Q) := by
  sorry

/-- Uniqueness of the nearby polynomial in the range used by the vanishing tester:
if `P, Q` of degree `≤ D` are within `ε₁, ε₂` of the same function `f`, and
`ε₁ + ε₂ < 1 - D/q`, then `P = Q`. [IdealsMacaulayBasesAnd, node_05] -/
theorem nearby_polynomial_unique {ι : Type} [Fintype ι] {D : ℕ} (f : (ι → F) → F)
    (P Q : MvPolynomial ι F) (hP : P.totalDegree ≤ D) (hQ : Q.totalDegree ≤ D)
    (ε₁ ε₂ : ℝ) (h₁ : relDist f (fun x => MvPolynomial.eval x P) ≤ ε₁)
    (h₂ : relDist f (fun x => MvPolynomial.eval x Q) ≤ ε₂)
    (hε : ε₁ + ε₂ < 1 - (D : ℝ) / (Fintype.card F : ℝ)) : P = Q := by
  sorry

/-- Identity (1): `P_A = P_χ (P_χ - 1)(P_χ + 1)`, from `δ ≤ 4γ` closeness, color-test failure
`≤ γ` and `9γ < 1 - 3d/q`. [IdealsMacaulayBasesAnd, node_05] -/
theorem recover_color_identity {m d : ℕ} (γ : ℝ)
    (χt At : (Fin m → F) → F) (Pχ PA : MvPolynomial (Fin m) F)
    (hPχ : Pχ.totalDegree ≤ d) (hPA : PA.totalDegree ≤ 3 * d)
    (hχ : relDist χt (fun x => MvPolynomial.eval x Pχ) ≤ 4 * γ)
    (hA : relDist At (fun x => MvPolynomial.eval x PA) ≤ 4 * γ)
    (htest : colorTestFailure χt At ≤ γ)
    (hγ : 9 * γ < 1 - (3 * d : ℝ) / (Fintype.card F : ℝ)) :
    PA = colorPoly Pχ := by
  sorry

/-- Identity (2): `P_B(x,y) = Ê(x,y) ∏_s (P_χ(x) - P_χ(y) - s)`, from `δ ≤ 4γ` closeness,
edge-test failure `≤ γ` and `13γ < 1 - 6d/q`. [IdealsMacaulayBasesAnd, node_05] -/
theorem recover_edge_identity {m d : ℕ} (γ : ℝ) (E : MvPolynomial (Fin m ⊕ Fin m) F)
    (hEdeg : E.totalDegree ≤ 2 * d)
    (χt : (Fin m → F) → F) (Bt : (Fin m → F) × (Fin m → F) → F)
    (Pχ : MvPolynomial (Fin m) F) (PB : MvPolynomial (Fin m ⊕ Fin m) F)
    (hPχ : Pχ.totalDegree ≤ d) (hPB : PB.totalDegree ≤ 6 * d)
    (hχ : relDist χt (fun x => MvPolynomial.eval x Pχ) ≤ 4 * γ)
    (hB : relDist Bt (evalPair PB) ≤ 4 * γ)
    (htest : edgeTestFailure E χt Bt ≤ γ)
    (hγ : 13 * γ < 1 - (6 * d : ℝ) / (Fintype.card F : ℝ)) :
    PB = edgePoly E Pχ := by
  sorry

/-! ## Rubric 4: soundness contradiction -/

/-- If `P_χ (P_χ-1)(P_χ+1)` vanishes on `V` and `Ê ∏ (P_χ(x) - P_χ(y) - s)` vanishes on
`V × V`, then `P_χ|_V` is a proper 3-coloring. [IdealsMacaulayBasesAnd, node_05] -/
theorem colorable_of_vanishing (hchar : ringChar F ≠ 2) {m : ℕ} {V : Finset (Fin m → F)}
    (G : SimpleGraph V) (E : MvPolynomial (Fin m ⊕ Fin m) F) (hE : IsEdgeIndicator G E)
    (Pχ : MvPolynomial (Fin m) F)
    (hA : VanishesOn V (colorPoly Pχ))
    (hB : ∀ u ∈ V, ∀ v ∈ V, eval₂ u v (edgePoly E Pχ) = 0) :
    G.Colorable 3 := by
  sorry

/-! ## Main theorem: algebraic soundness of the one-shot verifier -/

/-- Main theorem (algebraic core of soundness).  Suppose the oracle functions
`χ̃, Ã, B̃` are within distance `4γ` of polynomials `P_χ, P_A, P_B` of degrees `≤ d, 3d, 6d`
(the conclusion of the low-degree test), both consistency tests fail with probability `≤ γ`,
`13γ < 1 - 6d/q`, and `P_A` vanishes on `V`, `P_B` vanishes on `V × V` (the conclusion of the
vanishing tester when it rejects with probability `< ρ`).  Then `G` is 3-colorable.
Contrapositively, on a non-3-colorable graph one of the tests rejects with constant
probability. [IdealsMacaulayBasesAnd, node_05] -/
theorem algebraic_soundness (hchar : ringChar F ≠ 2) {m d : ℕ}
    {V : Finset (Fin m → F)} (hVne : V.Nonempty) (hext : HasExtensionDegreeAtMost V d)
    (G : SimpleGraph V) (E : MvPolynomial (Fin m ⊕ Fin m) F)
    (hEdeg : E.totalDegree ≤ 2 * d) (hE : IsEdgeIndicator G E)
    (γ : ℝ) (hγ0 : 0 ≤ γ) (hγ : 13 * γ < 1 - (6 * d : ℝ) / (Fintype.card F : ℝ))
    (χt At : (Fin m → F) → F) (Bt : (Fin m → F) × (Fin m → F) → F)
    (Pχ PA : MvPolynomial (Fin m) F) (PB : MvPolynomial (Fin m ⊕ Fin m) F)
    (hPχ : Pχ.totalDegree ≤ d) (hPA : PA.totalDegree ≤ 3 * d) (hPB : PB.totalDegree ≤ 6 * d)
    (hχ : relDist χt (fun x => MvPolynomial.eval x Pχ) ≤ 4 * γ)
    (hA : relDist At (fun x => MvPolynomial.eval x PA) ≤ 4 * γ)
    (hB : relDist Bt (evalPair PB) ≤ 4 * γ)
    (htestA : colorTestFailure χt At ≤ γ)
    (htestB : edgeTestFailure E χt Bt ≤ γ)
    (hvanA : VanishesOn V PA)
    (hvanB : ∀ u ∈ V, ∀ v ∈ V, eval₂ u v PB = 0) :
    G.Colorable 3 := by
  sorry

