/-!
## Restricted-domain lower bound and gap preservation for properly learning decision trees

For a graph `G` and amplification `ℓ`, `F_{G,ℓ}` accepts exactly the inputs whose original
support is an edge with all duplicate coordinates of both endpoints equal to 1. The sampling
set `D` consists of `0^N`, the edge inputs `a_e` (all `ℓ+1` coordinates of both endpoints set)
and their single-coordinate downward perturbations. The key lemma
`size_ge_of_agreesOn_coreset` says every tree agreeing with `F_{G,ℓ}` *only on `D`* has size
at least `(ℓ+1)(τ(G)+m)`.

The main theorem `learning_gap_core` packages the parameter choice of the reduction from gap
Vertex Cover on degree-`≤ d` graphs: for every `δ′ > 0` and `d ≥ 1` there are constants
`δ, L, c, C` such that, with `ℓ = L·n`, `s = ℓ(k+m)+2mn`, `N = n(ℓ+1)`, the budget is `O(N)`,
error `≤ c/N` on uniform `D` forces exact agreement, Yes instances are realizable with size
`≤ s`, and on No instances every tree agreeing with `F` on `D` exceeds `(1+δ)s`.
-/

namespace TCSChallenge.ProperlyLearningDecisionTrees.node_28

/-! ## Shared definitions (byte-identical across the files of this paper) -/

/-- "A deterministic decision tree is a finite rooted binary tree whose internal nodes query
individual coordinates of x, whose outgoing edges are labeled 0 and 1, and whose leaves are
labeled by output bits. Repeated queries are allowed." `node i lo hi` queries coordinate `i`
and continues in `lo` on answer 0 and in `hi` on answer 1. -/
inductive DTree (ι : Type) where
  | leaf (b : Bool) : DTree ι
  | node (i : ι) (lo hi : DTree ι) : DTree ι

namespace DTree

variable {ι : Type}

/-- The output of the tree on input `x`. -/
def eval : DTree ι → (ι → Bool) → Bool
  | leaf b, _ => b
  | node i lo hi, x => if x i then hi.eval x else lo.eval x

/-- "Its size |T| is its number of internal nodes." -/
def size : DTree ι → ℕ
  | leaf _ => 0
  | node _ lo hi => 1 + lo.size + hi.size

/-- The path followed by the all-zero input, recorded as the list of pairs
(queried coordinate, subtree at the 1-successor of that node), from the root downward. -/
def zeroPath : DTree ι → List (ι × DTree ι)
  | leaf _ => []
  | node i lo hi => (i, hi) :: lo.zeroPath

end DTree

/-- Coordinates `x_i^(j)` with `i ∈ V = Fin n` and `0 ≤ j ≤ ℓ`; `j = 0` is the original
coordinate, `j ≥ 1` are the duplicate coordinates. -/
abbrev Coord (n ℓ : ℕ) : Type := Fin n × Fin (ℓ + 1)

/-- `S(x) = {i ∈ V : x_i^(0) = 1}`. -/
def supp0 {n ℓ : ℕ} (x : Coord n ℓ → Bool) : Set (Fin n) :=
  {i | x (i, 0) = true}

/-- `F_{G,ℓ}(x) = 1` iff `S(x) ∈ E` and `x_i^(j) = 1` for every `i ∈ S(x)` and every
`1 ≤ j ≤ ℓ`. -/
def Fgl {n : ℕ} (G : SimpleGraph (Fin n)) (ℓ : ℕ) (x : Coord n ℓ → Bool) : Prop :=
  (∃ u v : Fin n, G.Adj u v ∧ supp0 x = {u, v}) ∧
    ∀ i ∈ supp0 x, ∀ j : Fin (ℓ + 1), j ≠ 0 → x (i, j) = true

/-- The tree `T` agrees with the Boolean function `f` (given as a predicate) on the set `D`. -/
def AgreesOn {ι : Type} (T : DTree ι) (f : (ι → Bool) → Prop) (D : Set (ι → Bool)) : Prop :=
  ∀ x ∈ D, (T.eval x = true ↔ f x)

/-- "The tree computes F when its output equals F(x) on every input." -/
def Computes {ι : Type} (T : DTree ι) (f : (ι → Bool) → Prop) : Prop :=
  AgreesOn T f Set.univ

/-- `s(f)`, the minimum number of internal nodes of a decision tree computing `f`. -/
noncomputable def dtSize {ι : Type} (f : (ι → Bool) → Prop) : ℕ :=
  sInf {k | ∃ T : DTree ι, Computes T f ∧ T.size = k}

/-- `C ⊆ V` is a vertex cover: `C ∩ e ≠ ∅` for every edge `e`. -/
def IsVertexCover {n : ℕ} (G : SimpleGraph (Fin n)) (C : Finset (Fin n)) : Prop :=
  ∀ u v : Fin n, G.Adj u v → u ∈ C ∨ v ∈ C

/-- `τ(G) = min{|C| : C is a vertex cover}`. -/
noncomputable def tau {n : ℕ} (G : SimpleGraph (Fin n)) : ℕ :=
  sInf {k | ∃ C : Finset (Fin n), IsVertexCover G C ∧ C.card = k}

/-- `m = |E|`. -/
noncomputable def numEdges {n : ℕ} (G : SimpleGraph (Fin n)) : ℕ :=
  G.edgeSet.ncard

/-- The vertex label `u_t` of the `t`-th query on the all-zero path. -/
def pathVertex {n ℓ : ℕ} (T : DTree (Coord n ℓ)) (t : Fin T.zeroPath.length) : Fin n :=
  (T.zeroPath.get t).1.1

/-- `E_t = {e ∈ E : u_t ∈ e and u_a ∉ e for every a < t}`: the edges whose first encountered
endpoint on the all-zero path is at position `t`. -/
def edgePart {n ℓ : ℕ} (G : SimpleGraph (Fin n)) (T : DTree (Coord n ℓ))
    (t : Fin T.zeroPath.length) : Set (Sym2 (Fin n)) :=
  {e | e ∈ G.edgeSet ∧ pathVertex T t ∈ e ∧ ∀ a : Fin T.zeroPath.length, a < t →
    pathVertex T a ∉ e}

/-- The subtree `S_t` rooted at the 1-successor of the `t`-th node of the all-zero path. -/
def sideSubtree {n ℓ : ℕ} (T : DTree (Coord n ℓ)) (t : Fin T.zeroPath.length) :
    DTree (Coord n ℓ) :=
  (T.zeroPath.get t).2

/-- The extracted cover `C_T = {u_t : E_t ≠ ∅}` (vertex labels at active positions). -/
noncomputable def activeCover {n ℓ : ℕ} (G : SimpleGraph (Fin n)) (T : DTree (Coord n ℓ)) :
    Finset (Fin n) :=
    (Finset.univ.filter (fun t : Fin T.zeroPath.length => (edgePart G T t).Nonempty)).image
      (pathVertex T)

/-! ## Definitions specific to this row -/

/-- "Every vertex meets at most d edges": maximum degree at most `d`. -/
def MaxDegreeLE {n : ℕ} (G : SimpleGraph (Fin n)) (d : ℕ) : Prop :=
  ∀ v : Fin n, (G.neighborSet v).ncard ≤ d

/-- "For an edge e = {u,v}, let a_e have 1 in every coordinate of u and v, and 0 elsewhere." -/
def edgeInput {n ℓ : ℕ} (u v : Fin n) : Coord n ℓ → Bool :=
  fun p => decide (p.1 = u ∨ p.1 = v)

/-- "D consists of 0^N, all a_e, and all points obtained from an a_e by changing one of its
2(ℓ+1) coordinates equal to 1 into 0." -/
def coreset {n : ℕ} (G : SimpleGraph (Fin n)) (ℓ : ℕ) : Set (Coord n ℓ → Bool) :=
  {x | (∀ p, x p = false) ∨
    ∃ u v : Fin n, G.Adj u v ∧
      (x = edgeInput u v ∨
        ∃ p : Coord n ℓ, edgeInput u v p = true ∧ x = Function.update (edgeInput u v) p false)}

/-- Number of points of `D` on which `T` disagrees with `f`; the uniform-distribution error
`dist_D(f,T)` is `errCount T f D / |D|`. -/
noncomputable def errCount {ι : Type} (T : DTree ι) (f : (ι → Bool) → Prop)
    (D : Set (ι → Bool)) : ℕ :=
  {x | x ∈ D ∧ ¬(T.eval x = true ↔ f x)}.ncard

/-! ## Rubric lemmas -/

/-- Rubric 1 (finite sampling set): for `ℓ ≥ 1` the listed points are distinct and
`|D| = m(2ℓ+3)+1`. [ProperlyLearningDecisionTrees, node_28] -/
theorem coreset_ncard {n : ℕ} (G : SimpleGraph (Fin n)) (ℓ : ℕ) (hℓ : 1 ≤ ℓ) :
    (coreset G ℓ).ncard = numEdges G * (2 * ℓ + 3) + 1 := by
  sorry

/-- Rubric 1 (labels on `D`): each `a_e` is a 1-input and each perturbation is a 0-input. [ProperlyLearningDecisionTrees, node_28] -/
theorem Fgl_edgeInput {n ℓ : ℕ} (G : SimpleGraph (Fin n)) (u v : Fin n) (huv : G.Adj u v) :
    Fgl G ℓ (edgeInput u v) ∧
      ∀ p : Coord n ℓ, edgeInput u v p = true →
        ¬ Fgl G ℓ (Function.update (edgeInput u v) p false) := by
  sorry

/-- Rubric 2 (restricted-domain lower bound): every tree agreeing with `F_{G,ℓ}` on `D`
has at least `(ℓ+1)(τ(G)+m)` internal nodes. [ProperlyLearningDecisionTrees, node_28] -/
theorem size_ge_of_agreesOn_coreset {n ℓ : ℕ} (G : SimpleGraph (Fin n))
    (T : DTree (Coord n ℓ)) (hT : AgreesOn T (Fgl G ℓ) (coreset G ℓ)) :
    (ℓ + 1) * (tau G + numEdges G) ≤ T.size := by
  sorry

/-- Rubric 3 (global small-tree construction): from any vertex cover `C` there is a tree
computing `F_{G,ℓ}` on the whole cube with at most `(ℓ+1)(|C|+m) + mn` internal nodes. [ProperlyLearningDecisionTrees, node_28] -/
theorem exists_tree_of_vertexCover {n : ℕ} (G : SimpleGraph (Fin n)) (ℓ : ℕ)
    (C : Finset (Fin n)) (hC : IsVertexCover G C) :
    ∃ T : DTree (Coord n ℓ), Computes T (Fgl G ℓ) ∧
      T.size ≤ (ℓ + 1) * (C.card + numEdges G) + numEdges G * n := by
  sorry

/-! ## Main theorem -/

/-- Combinatorial core of the reduction from gap Vertex Cover (degree `≤ d`, gap `δ′`) to
properly learning decision trees. With `ℓ = L·n`, `s = ℓ(k+m)+2mn`, `N = n(ℓ+1)` and the
uniform distribution on `D = coreset G ℓ`:
(i) `s ≤ C·N`; (ii) error `≤ c/N` on `D` forces exact agreement on `D`;
(iii) if `τ(G) ≤ k` then `DT(F_{G,ℓ}) ≤ s`;
(iv) if `τ(G) > (1+δ′)k` then every tree agreeing with `F_{G,ℓ}` on `D` has size `> (1+δ)s`. [ProperlyLearningDecisionTrees, node_28] -/
theorem learning_gap_core (δ' : ℝ) (hδ' : 0 < δ') (d : ℕ) (hd : 1 ≤ d) :
    ∃ δ : ℝ, 0 < δ ∧ ∃ L : ℕ, 0 < L ∧ ∃ c : ℝ, 0 < c ∧ ∃ Cs : ℕ,
      ∀ (n : ℕ) (G : SimpleGraph (Fin n)) (k : ℕ), MaxDegreeLE G d → 0 < numEdges G →
        1 ≤ k → k < min (numEdges G) n →
          (L * n) * (k + numEdges G) + 2 * numEdges G * n ≤ Cs * (n * (L * n + 1)) ∧
          (∀ T : DTree (Coord n (L * n)),
              ((errCount T (Fgl G (L * n)) (coreset G (L * n)) : ℝ) /
                  ((coreset G (L * n)).ncard : ℝ) ≤ c / ((n * (L * n + 1) : ℕ) : ℝ) →
                AgreesOn T (Fgl G (L * n)) (coreset G (L * n)))) ∧
          (tau G ≤ k →
              dtSize (Fgl G (L * n)) ≤ (L * n) * (k + numEdges G) + 2 * numEdges G * n) ∧
          ((1 + δ') * (k : ℝ) < (tau G : ℝ) →
              ∀ T : DTree (Coord n (L * n)), AgreesOn T (Fgl G (L * n)) (coreset G (L * n)) →
                (1 + δ) * (((L * n) * (k + numEdges G) + 2 * numEdges G * n : ℕ) : ℝ) <
                  (T.size : ℝ)) := by
  sorry

end TCSChallenge.ProperlyLearningDecisionTrees.node_28
