/-!
## Exact decision-tree size of the amplified edge function `F_{G,ℓ}`

For a simple graph `G` on `Fin n` with `m` edges and vertex cover number `τ(G)`, and
`ℓ ≥ 0`, inputs are arrays `x_i^(j)` (`i ∈ V`, `0 ≤ j ≤ ℓ`), and `F_{G,ℓ}(x) = 1` iff the
original support `S(x) = {i : x_i^(0) = 1}` is an edge and every duplicate coordinate of
both endpoints is 1. The main theorem `dtSize_Fgl_bounds` states

  `(ℓ+1)(τ(G)+m) ≤ s(F_{G,ℓ}) ≤ (ℓ+1)(τ(G)+m) + mn`,

where `s` counts internal nodes of a minimum decision tree computing `F_{G,ℓ}`.
-/

namespace TCSChallenge.ProperlyLearningDecisionTrees.node_13

/-! ## Shared definitions (byte-identical across the files of this paper) -/

/-- "A deterministic decision tree is a finite rooted binary tree whose internal nodes query
individual coordinates of x, whose outgoing edges are labeled 0 and 1, and whose leaves are
labeled by output bits. Repeated queries are allowed." `node i lo hi` queries coordinate `i`
and continues in `lo` on answer 0 and in `hi` on answer 1. -/
inductive DTree (ι : Type) where
  | leaf (b : Bool) : DTree ι
  | node (i : ι) (lo hi : DTree ι) : DTree ι

namespace DTree

variable {ι : Type}

/-- The output of the tree on input `x`. -/
def eval : DTree ι → (ι → Bool) → Bool
  | leaf b, _ => b
  | node i lo hi, x => if x i then hi.eval x else lo.eval x

/-- "Its size |T| is its number of internal nodes." -/
def size : DTree ι → ℕ
  | leaf _ => 0
  | node _ lo hi => 1 + lo.size + hi.size

/-- The path followed by the all-zero input, recorded as the list of pairs
(queried coordinate, subtree at the 1-successor of that node), from the root downward. -/
def zeroPath : DTree ι → List (ι × DTree ι)
  | leaf _ => []
  | node i lo hi => (i, hi) :: lo.zeroPath

end DTree

/-- Coordinates `x_i^(j)` with `i ∈ V = Fin n` and `0 ≤ j ≤ ℓ`; `j = 0` is the original
coordinate, `j ≥ 1` are the duplicate coordinates. -/
abbrev Coord (n ℓ : ℕ) : Type := Fin n × Fin (ℓ + 1)

/-- `S(x) = {i ∈ V : x_i^(0) = 1}`. -/
def supp0 {n ℓ : ℕ} (x : Coord n ℓ → Bool) : Set (Fin n) :=
  {i | x (i, 0) = true}

/-- `F_{G,ℓ}(x) = 1` iff `S(x) ∈ E` and `x_i^(j) = 1` for every `i ∈ S(x)` and every
`1 ≤ j ≤ ℓ`. -/
def Fgl {n : ℕ} (G : SimpleGraph (Fin n)) (ℓ : ℕ) (x : Coord n ℓ → Bool) : Prop :=
  (∃ u v : Fin n, G.Adj u v ∧ supp0 x = {u, v}) ∧
    ∀ i ∈ supp0 x, ∀ j : Fin (ℓ + 1), j ≠ 0 → x (i, j) = true

/-- The tree `T` agrees with the Boolean function `f` (given as a predicate) on the set `D`. -/
def AgreesOn {ι : Type} (T : DTree ι) (f : (ι → Bool) → Prop) (D : Set (ι → Bool)) : Prop :=
  ∀ x ∈ D, (T.eval x = true ↔ f x)

/-- "The tree computes F when its output equals F(x) on every input." -/
def Computes {ι : Type} (T : DTree ι) (f : (ι → Bool) → Prop) : Prop :=
  AgreesOn T f Set.univ

/-- `s(f)`, the minimum number of internal nodes of a decision tree computing `f`. -/
noncomputable def dtSize {ι : Type} (f : (ι → Bool) → Prop) : ℕ :=
  sInf {k | ∃ T : DTree ι, Computes T f ∧ T.size = k}

/-- `C ⊆ V` is a vertex cover: `C ∩ e ≠ ∅` for every edge `e`. -/
def IsVertexCover {n : ℕ} (G : SimpleGraph (Fin n)) (C : Finset (Fin n)) : Prop :=
  ∀ u v : Fin n, G.Adj u v → u ∈ C ∨ v ∈ C

/-- `τ(G) = min{|C| : C is a vertex cover}`. -/
noncomputable def tau {n : ℕ} (G : SimpleGraph (Fin n)) : ℕ :=
  sInf {k | ∃ C : Finset (Fin n), IsVertexCover G C ∧ C.card = k}

/-- `m = |E|`. -/
noncomputable def numEdges {n : ℕ} (G : SimpleGraph (Fin n)) : ℕ :=
  G.edgeSet.ncard

/-- The vertex label `u_t` of the `t`-th query on the all-zero path. -/
def pathVertex {n ℓ : ℕ} (T : DTree (Coord n ℓ)) (t : Fin T.zeroPath.length) : Fin n :=
  (T.zeroPath.get t).1.1

/-- `E_t = {e ∈ E : u_t ∈ e and u_a ∉ e for every a < t}`: the edges whose first encountered
endpoint on the all-zero path is at position `t`. -/
def edgePart {n ℓ : ℕ} (G : SimpleGraph (Fin n)) (T : DTree (Coord n ℓ))
    (t : Fin T.zeroPath.length) : Set (Sym2 (Fin n)) :=
  {e | e ∈ G.edgeSet ∧ pathVertex T t ∈ e ∧ ∀ a : Fin T.zeroPath.length, a < t →
    pathVertex T a ∉ e}

/-- The subtree `S_t` rooted at the 1-successor of the `t`-th node of the all-zero path. -/
def sideSubtree {n ℓ : ℕ} (T : DTree (Coord n ℓ)) (t : Fin T.zeroPath.length) :
    DTree (Coord n ℓ) :=
  (T.zeroPath.get t).2

/-- The extracted cover `C_T = {u_t : E_t ≠ ∅}` (vertex labels at active positions). -/
noncomputable def activeCover {n ℓ : ℕ} (G : SimpleGraph (Fin n)) (T : DTree (Coord n ℓ)) :
    Finset (Fin n) :=
    (Finset.univ.filter (fun t : Fin T.zeroPath.length => (edgePart G T t).Nonempty)).image
      (pathVertex T)

/-! ## Rubric lemmas -/

/-- Rubric 1–2 (upper-bound construction and accounting): from any vertex cover `C` there is
a tree computing `F_{G,ℓ}` with at most `(ℓ+1)(|C|+m) + mn` internal nodes. [ProperlyLearningDecisionTrees, node_13] -/
theorem exists_tree_of_vertexCover {n : ℕ} (G : SimpleGraph (Fin n)) (ℓ : ℕ)
    (C : Finset (Fin n)) (hC : IsVertexCover G C) :
    ∃ T : DTree (Coord n ℓ), Computes T (Fgl G ℓ) ∧
      T.size ≤ (ℓ + 1) * (C.card + numEdges G) + numEdges G * n := by
  sorry

/-- Rubric 3 (vertex cover from a tree path): the vertex labels queried along the
all-zero path of a tree computing `F_{G,ℓ}` form a vertex cover. [ProperlyLearningDecisionTrees, node_13] -/
theorem zeroPath_vertexCover {n ℓ : ℕ} (G : SimpleGraph (Fin n)) (T : DTree (Coord n ℓ))
    (hT : Computes T (Fgl G ℓ)) :
    ∀ u v : Fin n, G.Adj u v →
      ∃ t : Fin T.zeroPath.length, pathVertex T t = u ∨ pathVertex T t = v := by
  sorry

/-- Rubric 4 (local amplified query lower bound): for an active position `t`
(`E_t ≠ ∅`), the side subtree `S_t` has at least `ℓ + (ℓ+1)|E_t|` internal nodes. [ProperlyLearningDecisionTrees, node_13] -/
theorem sideSubtree_size_ge {n ℓ : ℕ} (G : SimpleGraph (Fin n)) (T : DTree (Coord n ℓ))
    (hT : Computes T (Fgl G ℓ)) (t : Fin T.zeroPath.length) (ht : (edgePart G T t).Nonempty) :
    ℓ + (ℓ + 1) * (edgePart G T t).ncard ≤ (sideSubtree T t).size := by
  sorry

/-- Rubric 5 (disjointness): the active positions yield a vertex cover. [ProperlyLearningDecisionTrees, node_13] -/
theorem activeCover_isVertexCover {n ℓ : ℕ} (G : SimpleGraph (Fin n)) (T : DTree (Coord n ℓ))
    (hT : Computes T (Fgl G ℓ)) : IsVertexCover G (activeCover G T) := by
  sorry

/-- Rubric 5 (final accounting): every tree computing `F_{G,ℓ}` satisfies
`(ℓ+1)(|C_T| + m) ≤ |T|` for its extracted cover `C_T`. [ProperlyLearningDecisionTrees, node_13] -/
theorem size_ge_activeCover {n ℓ : ℕ} (G : SimpleGraph (Fin n)) (T : DTree (Coord n ℓ))
    (hT : Computes T (Fgl G ℓ)) :
    (ℓ + 1) * ((activeCover G T).card + numEdges G) ≤ T.size := by
  sorry

/-! ## Main theorem -/

/-- For every graph `G` and every `ℓ`,
`(ℓ+1)(τ(G)+m) ≤ s(F_{G,ℓ}) ≤ (ℓ+1)(τ(G)+m) + mn`. [ProperlyLearningDecisionTrees, node_13] -/
theorem dtSize_Fgl_bounds (n ℓ : ℕ) (G : SimpleGraph (Fin n)) :
    (ℓ + 1) * (tau G + numEdges G) ≤ dtSize (Fgl G ℓ) ∧
      dtSize (Fgl G ℓ) ≤ (ℓ + 1) * (tau G + numEdges G) + numEdges G * n := by
  sorry

end TCSChallenge.ProperlyLearningDecisionTrees.node_13
