/-!
## Hardness distillation: `DT(f, D) ≥ s₁ + s₂`

Let `f : {0,1}ⁿ → {0,1}`, `D ⊆ {0,1}ⁿ`, `x ∈ D`. If every certificate for `x` over `D` has
size at least `s₁`, and for every certificate `ρ` and every ordering `π` of `ρ` the sum
`∑ᵢ Rel(f_{π|⊕i}; D) ≥ s₂`, then every decision tree (TCSlib `DecisionTree n`) computing `f`
over `D` has at least `s₁ + s₂` internal nodes (`Tree.nodeCount`). Restrictions are TCSlib's
`SwitchingLemma.Restriction n`. Main theorems: `dt_size_ge_of_hardness` (arbitrary tree) and
`DTsize_ge` (minimum size).
-/

namespace TCSChallenge.ProperlyLearningDecisionTrees.node_19

open SwitchingLemma

/-- Inputs `{0,1}ⁿ`. -/
abbrev Input (n : ℕ) := Fin n → Bool

/-- "|σ| is the number of assigned coordinates": the complement of `σ.freeVars`. -/
def restrSize {n : ℕ} (σ : Restriction n) : ℕ :=
  (σ.freeVars)ᶜ.card

/-- `y` is consistent with `σ`: it agrees with every assigned coordinate. -/
def Consistent {n : ℕ} (σ : Restriction n) (y : Input n) : Prop :=
  ∀ j b, σ j = some b → y j = b

/-- "`D_σ` is the set of inputs in `D` consistent with `σ`." -/
def domRestrict {n : ℕ} (D : Finset (Input n)) (σ : Restriction n) : Finset (Input n) :=
  D.filter (fun y => Consistent σ y)

/-- "`Rel(f_σ; D)` is the number of unassigned coordinates `j` (those in `σ.freeVars`) for
which there exist `y, z ∈ D_σ` differing only in coordinate `j` with `f(y) ≠ f(z)`."
(Zero when `D_σ = ∅`, automatically.) -/
def Rel {n : ℕ} (f : Input n → Bool) (σ : Restriction n) (D : Finset (Input n)) : ℕ :=
  (σ.freeVars.filter (fun j =>
    ∃ y ∈ domRestrict D σ, ∃ z ∈ domRestrict D σ,
      z = Function.update y j (!y j) ∧ f y ≠ f z)).card

/-- "A certificate ρ for x over D is a restriction consistent with x such that f(y) = f(x)
for every y ∈ D_ρ." -/
def IsCertificate {n : ℕ} (f : Input n → Bool) (D : Finset (Input n)) (x : Input n)
    (ρ : Restriction n) : Prop :=
  Consistent ρ x ∧ ∀ y ∈ domRestrict D ρ, f y = f x

/-- "The certificate complexity of x over D is the minimum size of such a restriction."
(The full assignment of `x` is a certificate, so the set is nonempty.) -/
def certComplexity {n : ℕ} (f : Input n → Bool) (D : Finset (Input n)) (x : Input n) : ℕ :=
  sInf {k | ∃ ρ, IsCertificate f D x ρ ∧ restrSize ρ = k}

/-- "When used as a restriction, this ordered list means its underlying partial assignment."
(First occurrence wins; for lists with distinct coordinates this is the obvious map.) -/
def listToRestr {n : ℕ} (l : List (Fin n × Bool)) : Restriction n :=
  fun j => (l.find? (fun p => decide (p.1 = j))).map Prod.snd

/-- "`Perm(ρ)` is the set of all orderings of the assignments in ρ": `π` lists each
assignment of `ρ` exactly once (distinct coordinates). -/
def IsOrdering {n : ℕ} (ρ : Restriction n) (π : List (Fin n × Bool)) : Prop :=
  (π.map Prod.fst).Nodup ∧ ∀ j b, (j, b) ∈ π ↔ ρ j = some b

/-- The list `[π|⊕1, …, π|⊕k]`, where
`π|⊕i = ((j₁,b₁),…,(j_{i-1},b_{i-1}),(jᵢ,1-bᵢ))`. -/
def flipPrefixes {n : ℕ} : List (Fin n × Bool) → List (List (Fin n × Bool))
  | [] => []
  | (j, b) :: t => [(j, !b)] :: (flipPrefixes t).map (fun p => (j, b) :: p)

/-- `∑_{i=1}^{|π|} Rel(f_{π|⊕i}; D)`. -/
def relSum {n : ℕ} (f : Input n → Bool) (D : Finset (Input n)) (π : List (Fin n × Bool)) : ℕ :=
  ((flipPrefixes π).map (fun p => Rel f (listToRestr p) D)).sum

/-! "A deterministic binary decision tree queries an input coordinate at each internal node,
branches on the observed bit, and outputs a bit at each leaf." Trees are TCSlib's
`DecisionTree n`: `branch i t₀ t₁` goes to `t₀` on `y i = false` and to `t₁` on `y i = true`;
`DecisionTree.eval` is the output. The functions below are local. -/

namespace Tree

variable {n : ℕ}

/-- "Its size is its number of internal nodes." (TCSlib's `DecisionTree.size` counts leaves.) -/
def nodeCount : DecisionTree n → ℕ
  | .leaf _ => 0
  | .branch _ t₀ t₁ => nodeCount t₀ + nodeCount t₁ + 1

/-- The set of coordinates queried somewhere in the tree. -/
def queried : DecisionTree n → Finset (Fin n)
  | .leaf _ => ∅
  | .branch i t₀ t₁ => insert i (queried t₀ ∪ queried t₁)

/-- No coordinate is queried twice along any root-to-leaf path. -/
def NoRepeat : DecisionTree n → Prop
  | .leaf _ => True
  | .branch i t₀ t₁ => i ∉ queried t₀ ∧ i ∉ queried t₁ ∧ NoRepeat t₀ ∧ NoRepeat t₁

/-- The ordered assignments `((j₁,x_{j₁}),…,(j_k,x_{j_k}))` queried along the computation
path of `x`. -/
def pathOf : DecisionTree n → Input n → List (Fin n × Bool)
  | .leaf _, _ => []
  | .branch i t₀ t₁, x => (i, x i) :: (if x i then pathOf t₁ x else pathOf t₀ x)

/-- The sibling subtrees hanging off the computation path of `x` (the subtree entered by the
opposite outcome at each path node), in path order. -/
def siblings : DecisionTree n → Input n → List (DecisionTree n)
  | .leaf _, _ => []
  | .branch i t₀ t₁, x =>
      (if x i then t₀ else t₁) :: (if x i then siblings t₁ x else siblings t₀ x)

end Tree

/-- "It computes f over D if its output equals f(y) for every y ∈ D." -/
def Computes {n : ℕ} (f : Input n → Bool) (D : Finset (Input n)) (T : DecisionTree n) : Prop :=
  ∀ y ∈ D, T.eval y = f y

/-- "`DT(f, D)` denotes the minimum size (internal nodes) of such a tree." (Nonempty: a
complete tree of depth `n` computes `f` everywhere.) -/
def DTsize {n : ℕ} (f : Input n → Bool) (D : Finset (Input n)) : ℕ :=
  sInf {s | ∃ T : DecisionTree n, Computes f D T ∧ Tree.nodeCount T = s}

/-! ## Intermediate claims of the strategy -/

/-- Normalization: repeated queries along a path can be removed without increasing size
or breaking correctness over `D`. [ProperlyLearningDecisionTrees, node_19] -/
theorem normalize_exists {n : ℕ} (f : Input n → Bool) (D : Finset (Input n))
    (T : DecisionTree n) (hT : Computes f D T) :
    ∃ T' : DecisionTree n, Computes f D T' ∧ Tree.NoRepeat T' ∧
      Tree.nodeCount T' ≤ Tree.nodeCount T := by
  sorry

/-- In a normalized tree, the computation path of `x` is an ordering of its own
underlying restriction. [ProperlyLearningDecisionTrees, node_19] -/
theorem pathOf_isOrdering {n : ℕ} (T : DecisionTree n) (hT : Tree.NoRepeat T) (x : Input n) :
    IsOrdering (listToRestr (Tree.pathOf T x)) (Tree.pathOf T x) := by
  sorry

/-- The path of `x` in a tree computing `f` over `D` (with `x ∈ D`) is a certificate. [ProperlyLearningDecisionTrees, node_19] -/
theorem pathOf_isCertificate {n : ℕ} (f : Input n → Bool) (D : Finset (Input n))
    (T : DecisionTree n) (hT : Computes f D T) (x : Input n) (hx : x ∈ D) :
    IsCertificate f D x (listToRestr (Tree.pathOf T x)) := by
  sorry

/-- The size of an ordering equals the size of its underlying restriction. [ProperlyLearningDecisionTrees, node_19] -/
theorem restrSize_listToRestr {n : ℕ} (π : List (Fin n × Bool))
    (hπ : (π.map Prod.fst).Nodup) :
    restrSize (listToRestr π) = π.length := by
  sorry

/-- Node-disjoint decomposition: the path nodes and the sibling subtrees partition the
internal nodes. [ProperlyLearningDecisionTrees, node_19] -/
theorem size_eq_path_add_siblings {n : ℕ} (T : DecisionTree n) (x : Input n) :
    Tree.nodeCount T =
      (Tree.pathOf T x).length + ((Tree.siblings T x).map Tree.nodeCount).sum := by
  sorry

/-- The `i`-th flipped prefix pairs with the `i`-th sibling subtree. [ProperlyLearningDecisionTrees, node_19] -/
theorem length_flipPrefixes_siblings {n : ℕ} (T : DecisionTree n) (x : Input n) :
    (flipPrefixes (Tree.pathOf T x)).length = (Tree.siblings T x).length := by
  sorry

/-- Each sibling subtree computes `f` over the compatible domain `D_{π|⊕i}`. [ProperlyLearningDecisionTrees, node_19] -/
theorem sibling_computes {n : ℕ} (f : Input n → Bool) (D : Finset (Input n))
    (T : DecisionTree n) (hT : Computes f D T) (hN : Tree.NoRepeat T) (x : Input n) :
    ∀ q ∈ (flipPrefixes (Tree.pathOf T x)).zip (Tree.siblings T x),
      Computes f (domRestrict D (listToRestr q.1)) q.2 := by
  sorry

/-- Relevance forces queries: every coordinate counted by `Rel(f_σ; D)` is queried by any
tree computing `f` over `D_σ`, so `Rel(f_σ; D) ≤ |queried T'| ≤ nodeCount T'`. [ProperlyLearningDecisionTrees, node_19] -/
theorem rel_le_size {n : ℕ} (f : Input n → Bool) (D : Finset (Input n)) (σ : Restriction n)
    (T' : DecisionTree n) (hT' : Computes f (domRestrict D σ) T') :
    Rel f σ D ≤ Tree.nodeCount T' := by
  sorry

/-- Combined accounting: `|T| ≥ |π| + ∑ᵢ Rel(f_{π|⊕i}; D)` for the path ordering `π`. [ProperlyLearningDecisionTrees, node_19] -/
theorem size_ge_path_add_relSum {n : ℕ} (f : Input n → Bool) (D : Finset (Input n))
    (T : DecisionTree n) (hT : Computes f D T) (hN : Tree.NoRepeat T) (x : Input n) :
    (Tree.pathOf T x).length + relSum f D (Tree.pathOf T x) ≤ Tree.nodeCount T := by
  sorry

/-! ## Main theorems -/

/-- Hardness distillation for an arbitrary correct tree. [ProperlyLearningDecisionTrees, node_19] -/
theorem dt_size_ge_of_hardness {n : ℕ} (hn : 1 ≤ n) (f : Input n → Bool)
    (D : Finset (Input n)) (x : Input n) (hx : x ∈ D) (s₁ s₂ : ℕ)
    (hcert : s₁ ≤ certComplexity f D x)
    (hrel : ∀ ρ : Restriction n, IsCertificate f D x ρ →
      ∀ π : List (Fin n × Bool), IsOrdering ρ π → s₂ ≤ relSum f D π)
    (T : DecisionTree n) (hT : Computes f D T) :
    s₁ + s₂ ≤ Tree.nodeCount T := by
  sorry

/-- Hardness distillation: `DT(f, D) ≥ s₁ + s₂`. [ProperlyLearningDecisionTrees, node_19] -/
theorem DTsize_ge {n : ℕ} (hn : 1 ≤ n) (f : Input n → Bool)
    (D : Finset (Input n)) (x : Input n) (hx : x ∈ D) (s₁ s₂ : ℕ)
    (hcert : s₁ ≤ certComplexity f D x)
    (hrel : ∀ ρ : Restriction n, IsCertificate f D x ρ →
      ∀ π : List (Fin n × Bool), IsOrdering ρ π → s₂ ≤ relSum f D π) :
    s₁ + s₂ ≤ DTsize f D := by
  sorry

end TCSChallenge.ProperlyLearningDecisionTrees.node_19
