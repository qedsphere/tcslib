/-!
## Monotone functions in AC⁰ with large monotone circuit complexity (padding)

Assume a family of monotone functions `g_m : {0,1}^{q(m)} → {0,1}` with `q(m) ≤ m^C`,
monotone circuit complexity `≥ 2^{m^{1/3 - ρ(m)}}` (`ρ → 0`), and constant-depth circuits of
size `≤ 2^{m^δ}` for every fixed `δ > 0`. Then for every `k` there is a monotone family
`f_k ∈ AC⁰` with `MC(f_{k,N}) ≥ N^{Ω((log N)^k)}`: `monotone_AC0_superpoly_lower_bound`.
Circuits are unbounded fan-in, size = number of gates.
-/

namespace TCSChallenge.MonotoneCircuitComplexityOfMatching.node_05

/-! ## Circuits (shared between node_03 and node_05) -/

/-- A wire of a circuit over input type `ι`: an input variable, a constant, or the output of
the `k`-th gate (0-indexed in the gate list). -/
inductive Wire (ι : Type) where
  | input (i : ι)
  | const (b : Bool)
  | gate (k : ℕ)

/-- A gate: unbounded-fan-in `∧` / `∨` over a list of wires, or a negation of one wire. -/
inductive Gate (ι : Type) where
  | and (ws : List (Wire ι))
  | or (ws : List (Wire ι))
  | not (w : Wire ι)

/-- The input wires of a gate. -/
def Gate.wires {ι : Type} : Gate ι → List (Wire ι)
  | .and ws => ws
  | .or ws => ws
  | .not w => [w]

/-- A circuit is a list of gates (a DAG in topological order) and an output wire. -/
structure Circuit (ι : Type) where
  gates : List (Gate ι)
  out : Wire ι

/-- "its size is its number of gates". -/
def Circuit.size {ι : Type} (C : Circuit ι) : ℕ := C.gates.length

/-- A wire refers only to gates with index `< k`. -/
def Wire.RefsBelow {ι : Type} (k : ℕ) : Wire ι → Prop
  | .gate j => j < k
  | _ => True

/-- Acyclicity / well-formedness: gate `k` reads only gates `< k`, the output reads an
existing gate. -/
def Circuit.WellFormed {ι : Type} (C : Circuit ι) : Prop :=
  (∀ (k : ℕ) (g : Gate ι), C.gates[k]? = some g → ∀ w ∈ g.wires, Wire.RefsBelow k w) ∧
    Wire.RefsBelow C.gates.length C.out

/-- Value of a wire given the input and the list of values of the gates computed so far. -/
def Wire.val {ι : Type} (x : ι → Bool) (acc : List Bool) : Wire ι → Bool
  | .input i => x i
  | .const b => b
  | .gate k => acc.getD k false

/-- Value of a gate given the values of earlier gates. -/
def Gate.val {ι : Type} (x : ι → Bool) (acc : List Bool) : Gate ι → Bool
  | .and ws => ws.all (fun w => Wire.val x acc w)
  | .or ws => ws.any (fun w => Wire.val x acc w)
  | .not w => !(Wire.val x acc w)

/-- Values of all gates, computed in order. -/
def gateValues {ι : Type} (x : ι → Bool) : List (Gate ι) → List Bool → List Bool
  | [], acc => acc
  | g :: gs, acc => gateValues x gs (acc ++ [Gate.val x acc g])

/-- The Boolean function computed by a circuit. -/
def Circuit.eval {ι : Type} (C : Circuit ι) (x : ι → Bool) : Bool :=
  Wire.val x (gateValues x C.gates []) C.out

/-- Depth of a wire given the depths of earlier gates (inputs and constants have depth 0). -/
def Wire.depth {ι : Type} (acc : List ℕ) : Wire ι → ℕ
  | .gate k => acc.getD k 0
  | _ => 0

/-- Depth of a gate: one more than the maximal depth of its inputs. -/
def Gate.depth {ι : Type} (acc : List ℕ) (g : Gate ι) : ℕ :=
  1 + (g.wires.map (fun w => Wire.depth acc w)).foldr max 0

/-- Depths of all gates, computed in order. -/
def gateDepths {ι : Type} : List (Gate ι) → List ℕ → List ℕ
  | [], acc => acc
  | g :: gs, acc => gateDepths gs (acc ++ [Gate.depth acc g])

/-- Depth of a circuit: depth of its output wire. -/
def Circuit.depth {ι : Type} (C : Circuit ι) : ℕ :=
  Wire.depth (gateDepths C.gates []) C.out

/-- "only `∧`- and `∨`-gates": a monotone circuit has no negation gate. -/
def Circuit.IsMonotone {ι : Type} (C : Circuit ι) : Prop :=
  ∀ g ∈ C.gates, ∀ w : Wire ι, g ≠ Gate.not w

/-- "a fan-in-two circuit over `{∧, ∨}` with no negated inputs". -/
def Circuit.IsFanInTwoMonotone {ι : Type} (C : Circuit ι) : Prop :=
  ∀ g ∈ C.gates, ∃ a b : Wire ι, g = Gate.and [a, b] ∨ g = Gate.or [a, b]

/-! ## AC⁰ and monotone lower bounds -/

/-- "A Boolean family belongs to nonuniform `AC⁰` if it is computed by polynomial-size,
constant-depth circuits over unbounded-fan-in `∧, ∨, ¬`." -/
def InAC0 (f : (N : ℕ) → (Fin N → Bool) → Bool) : Prop :=
  ∃ d c : ℕ, ∀ N : ℕ, ∃ C : Circuit (Fin N),
    C.WellFormed ∧ C.depth ≤ d ∧ C.size ≤ c * N ^ c + c ∧ ∀ x, C.eval x = f N x

/-- Every monotone circuit computing `h` has at least `s` gates, i.e. `MC(h) ≥ s`. -/
def MonotoneSizeAtLeast {ι : Type} (h : (ι → Bool) → Bool) (s : ℝ) : Prop :=
  ∀ C : Circuit ι, C.WellFormed → C.IsMonotone → (∀ x, C.eval x = h x) → s ≤ (C.size : ℝ)

/-! ## Lemma stubs -/

/-- Rubric 4. Fixing / renaming inputs of a monotone circuit (each input `i` is replaced by
`y (σ i)` if `σ i = some j`, and by the constant `0` if `σ i = none`) gives a monotone circuit
of no larger size. [MonotoneCircuitComplexityOf, node_05] -/
theorem restrict_monotone_circuit {ι κ : Type} (C : Circuit ι) (σ : ι → Option κ)
    (hwf : C.WellFormed) (hmono : C.IsMonotone) :
    ∃ C' : Circuit κ, C'.WellFormed ∧ C'.IsMonotone ∧ C'.size ≤ C.size ∧
      ∀ y : κ → Bool, C'.eval y = C.eval (fun i => (σ i).elim false y) := by
  sorry

/-- Rubric 3. Padding by ignored coordinates preserves monotonicity. [MonotoneCircuitComplexityOf, node_05] -/
theorem padding_monotone (q N : ℕ) (hqN : q ≤ N) (g : (Fin q → Bool) → Bool)
    (hg : Monotone g) :
    Monotone (fun z : Fin N → Bool => g (fun i => z (Fin.castLE hqN i))) := by
  sorry

/-! ## Main theorem -/

/-- For every fixed `k ≥ 0` there is a monotone family `f_k ∈ AC⁰` with
`MC(f_{k,N}) ≥ N^{c_k (log N)^k}` for all sufficiently large `N`. [MonotoneCircuitComplexityOf, node_05] -/
theorem monotone_AC0_superpoly_lower_bound
    (q : ℕ → ℕ) (Cexp : ℕ) (hq : ∀ m : ℕ, 1 ≤ m → q m ≤ m ^ Cexp)
    (g : (m : ℕ) → (Fin (q m) → Bool) → Bool) (hgmono : ∀ m, Monotone (g m))
    (ρ : ℕ → ℝ) (hρ : Filter.Tendsto ρ Filter.atTop (nhds 0))
    (hlow : ∃ m₀ : ℕ, ∀ m : ℕ, m₀ ≤ m →
      MonotoneSizeAtLeast (g m) ((2 : ℝ) ^ ((m : ℝ) ^ ((1 / 3 : ℝ) - ρ m))))
    (hsim : ∀ δ : ℝ, 0 < δ → ∃ d : ℕ, ∃ m₀ : ℕ, ∀ m : ℕ, m₀ ≤ m →
      ∃ C : Circuit (Fin (q m)), C.WellFormed ∧ C.depth ≤ d ∧
        (C.size : ℝ) ≤ (2 : ℝ) ^ ((m : ℝ) ^ δ) ∧ ∀ x, C.eval x = g m x) :
    ∀ k : ℕ, ∃ f : (N : ℕ) → (Fin N → Bool) → Bool,
      (∀ N, Monotone (f N)) ∧ InAC0 f ∧
      ∃ c : ℝ, 0 < c ∧ ∃ N₀ : ℕ, ∀ N : ℕ, N₀ ≤ N →
        MonotoneSizeAtLeast (f N) ((N : ℝ) ^ (c * (Real.logb 2 N) ^ k)) := by
  sorry

end TCSChallenge.MonotoneCircuitComplexityOfMatching.node_05
