/-!
## Monotone circuit lower bound for bipartite perfect matching

Inputs are edge indicators `x : Fin n × Fin n → Bool` of a bipartite graph on `L ⊔ R`,
`|L| = |R| = n`. `Match_n(x) = 1` iff the graph has a perfect matching. We prove (assuming the
robust sunflower estimate) that every fan-in-two monotone circuit computing `Match_n` has
`2^{Ω(n^{1/3} / (log n)^{2/3})}` gates: `match_monotone_lower_bound`, and the corollary
`match_monotone_lower_bound_exponent` (`2^{n^{1/3 - o(1)}}`).

Intermediate stubs: the odd-cut distribution has no perfect matchings, the matching
sunflower lemma, DNF compression, the containment probability `(n-ℓ)!/n! ≤ (e/n)^ℓ`, and the
correlation bound for `r`-small matching DNFs.
-/

namespace TCSChallenge.MonotoneCircuitComplexityOfMatching.node_03

/-! ## Circuits (shared between node_03 and node_05) -/

/-- A wire of a circuit over input type `ι`: an input variable, a constant, or the output of
the `k`-th gate (0-indexed in the gate list). -/
inductive Wire (ι : Type) where
  | input (i : ι)
  | const (b : Bool)
  | gate (k : ℕ)

/-- A gate: unbounded-fan-in `∧` / `∨` over a list of wires, or a negation of one wire. -/
inductive Gate (ι : Type) where
  | and (ws : List (Wire ι))
  | or (ws : List (Wire ι))
  | not (w : Wire ι)

/-- The input wires of a gate. -/
def Gate.wires {ι : Type} : Gate ι → List (Wire ι)
  | .and ws => ws
  | .or ws => ws
  | .not w => [w]

/-- A circuit is a list of gates (a DAG in topological order) and an output wire. -/
structure Circuit (ι : Type) where
  gates : List (Gate ι)
  out : Wire ι

/-- "its size is its number of gates". -/
def Circuit.size {ι : Type} (C : Circuit ι) : ℕ := C.gates.length

/-- A wire refers only to gates with index `< k`. -/
def Wire.RefsBelow {ι : Type} (k : ℕ) : Wire ι → Prop
  | .gate j => j < k
  | _ => True

/-- Acyclicity / well-formedness: gate `k` reads only gates `< k`, the output reads an
existing gate. -/
def Circuit.WellFormed {ι : Type} (C : Circuit ι) : Prop :=
  (∀ (k : ℕ) (g : Gate ι), C.gates[k]? = some g → ∀ w ∈ g.wires, Wire.RefsBelow k w) ∧
    Wire.RefsBelow C.gates.length C.out

/-- Value of a wire given the input and the list of values of the gates computed so far. -/
def Wire.val {ι : Type} (x : ι → Bool) (acc : List Bool) : Wire ι → Bool
  | .input i => x i
  | .const b => b
  | .gate k => acc.getD k false

/-- Value of a gate given the values of earlier gates. -/
def Gate.val {ι : Type} (x : ι → Bool) (acc : List Bool) : Gate ι → Bool
  | .and ws => ws.all (fun w => Wire.val x acc w)
  | .or ws => ws.any (fun w => Wire.val x acc w)
  | .not w => !(Wire.val x acc w)

/-- Values of all gates, computed in order. -/
def gateValues {ι : Type} (x : ι → Bool) : List (Gate ι) → List Bool → List Bool
  | [], acc => acc
  | g :: gs, acc => gateValues x gs (acc ++ [Gate.val x acc g])

/-- The Boolean function computed by a circuit. -/
def Circuit.eval {ι : Type} (C : Circuit ι) (x : ι → Bool) : Bool :=
  Wire.val x (gateValues x C.gates []) C.out

/-- Depth of a wire given the depths of earlier gates (inputs and constants have depth 0). -/
def Wire.depth {ι : Type} (acc : List ℕ) : Wire ι → ℕ
  | .gate k => acc.getD k 0
  | _ => 0

/-- Depth of a gate: one more than the maximal depth of its inputs. -/
def Gate.depth {ι : Type} (acc : List ℕ) (g : Gate ι) : ℕ :=
  1 + (g.wires.map (fun w => Wire.depth acc w)).foldr max 0

/-- Depths of all gates, computed in order. -/
def gateDepths {ι : Type} : List (Gate ι) → List ℕ → List ℕ
  | [], acc => acc
  | g :: gs, acc => gateDepths gs (acc ++ [Gate.depth acc g])

/-- Depth of a circuit: depth of its output wire. -/
def Circuit.depth {ι : Type} (C : Circuit ι) : ℕ :=
  Wire.depth (gateDepths C.gates []) C.out

/-- "only `∧`- and `∨`-gates": a monotone circuit has no negation gate. -/
def Circuit.IsMonotone {ι : Type} (C : Circuit ι) : Prop :=
  ∀ g ∈ C.gates, ∀ w : Wire ι, g ≠ Gate.not w

/-- "a fan-in-two circuit over `{∧, ∨}` with no negated inputs". -/
def Circuit.IsFanInTwoMonotone {ι : Type} (C : Circuit ι) : Prop :=
  ∀ g ∈ C.gates, ∃ a b : Wire ι, g = Gate.and [a, b] ∨ g = Gate.or [a, b]

/-! ## Bipartite graphs and matchings -/

/-- Edges of `K_{n,n}`: pairs `(u, v)` with `u ∈ L = Fin n`, `v ∈ R = Fin n`. -/
abbrev Edge (n : ℕ) : Type := Fin n × Fin n

/-- Vertices `L ⊔ R`. -/
abbrev Vertex (n : ℕ) : Type := Fin n ⊕ Fin n

/-- "`Match_n(x) = 1` exactly when that graph has a perfect matching". -/
def HasPerfectMatching {n : ℕ} (x : Edge n → Bool) : Prop :=
  ∃ σ : Equiv.Perm (Fin n), ∀ i : Fin n, x (i, σ i) = true

/-- The circuit computes `Match_n`. -/
def ComputesMatch {n : ℕ} (C : Circuit (Edge n)) : Prop :=
  ∀ x : Edge n → Bool, C.eval x = true ↔ HasPerfectMatching x

/-- A partial matching: distinct edges share no endpoint. -/
def IsPartialMatching {n : ℕ} (M : Finset (Edge n)) : Prop :=
  ∀ e ∈ M, ∀ f ∈ M, (e.1 = f.1 ∨ e.2 = f.2) → e = f

/-- The term `t_M(x) = ⋀_{e ∈ M} x_e`. -/
def termVal {n : ℕ} (M : Finset (Edge n)) (x : Edge n → Bool) : Prop :=
  ∀ e ∈ M, x e = true

/-- The DNF `F_𝓐 = ⋁_{M ∈ 𝓐} t_M`. -/
def dnfVal {n : ℕ} (A : Finset (Finset (Edge n))) (x : Edge n → Bool) : Prop :=
  ∃ M ∈ A, termVal M x

/-- "`r`-small: for every `ℓ`, the family contains at most `r^ℓ` matchings of size `ℓ`". -/
def IsRSmall {n : ℕ} (A : Finset (Finset (Edge n))) (r : ℕ) : Prop :=
  ∀ ℓ : ℕ, (A.filter (fun M => M.card = ℓ)).card ≤ r ^ ℓ

/-- Edge core `D = ⋂_{M ∈ 𝓜'} M` of a (nonempty) family. -/
def edgeCore {n : ℕ} (A : Finset (Finset (Edge n))) : Finset (Edge n) :=
  Finset.univ.filter (fun e => ∀ M ∈ A, e ∈ M)

/-! ## The two test distributions -/

/-- Colorings `a : L ⊔ R → {0,1}` with an odd number of vertices colored `1`. -/
def oddColorings (n : ℕ) : Finset (Vertex n → Bool) :=
  Finset.univ.filter (fun a => Odd (Finset.univ.filter (fun v => a v = true)).card)

/-- The odd-cut graph of a coloring: `x_{uv} = 1 ⟺ a(u) = a(v)`. -/
def oddCutGraph {n : ℕ} (a : Vertex n → Bool) : Edge n → Bool :=
  fun e => decide (a (Sum.inl e.1) = a (Sum.inr e.2))

/-- `Pr_{x ∼ 𝓓₀}[P x]` for the odd-cut distribution `𝓓₀`. -/
def probOddCut {n : ℕ} (P : (Edge n → Bool) → Prop) : ℝ :=
  (((oddColorings n).filter (fun a => P (oddCutGraph a))).card : ℝ) /
    ((oddColorings n).card : ℝ)

/-- Edge indicator of the perfect matching `{(i, σ i)}`. -/
def pmGraph {n : ℕ} (σ : Equiv.Perm (Fin n)) : Edge n → Bool :=
  fun e => decide (σ e.1 = e.2)

/-- `Pr_{x ∼ 𝓓₁}[P x]`, `𝓓₁` uniform on the `n!` perfect matchings of `K_{n,n}`. -/
def probPM {n : ℕ} (P : (Edge n → Bool) → Prop) : ℝ :=
  ((Finset.univ.filter (fun σ : Equiv.Perm (Fin n) => P (pmGraph σ))).card : ℝ) /
    (Fintype.card (Equiv.Perm (Fin n)) : ℝ)

/-- Accuracy of the DNF `F_𝓐` under `𝓓 = ½(𝓓₀ + 𝓓₁)`. -/
def dnfAccuracy {n : ℕ} (A : Finset (Finset (Edge n))) : ℝ :=
  (1 / 2) * probOddCut (fun x => ¬ dnfVal A x) + (1 / 2) * probPM (fun x => dnfVal A x)

/-! ## The supplied estimate -/

/-- The supplied robust sunflower estimate (natural log; restricted to `ε ≤ 1/2` and to
families with at least two members, the only regime used). For a random `W ⊆ U` with each
element in `W` independently with probability `1/2`, the probability is the fraction of all
`W ∈ 2^U`. -/
def RobustSunflowerFact : Prop :=
  ∃ c : ℝ, 0 < c ∧
    ∀ (U : Type) [Fintype U] [DecidableEq U] (k : ℕ) (ε : ℝ) (A : Finset (Finset U)),
      1 ≤ k → 0 < ε → ε ≤ 1 / 2 →
      (∀ B ∈ A, B.card = k) → 2 ≤ A.card →
      (c * Real.log ((k : ℝ) / ε)) ^ k ≤ (A.card : ℝ) →
      ∃ 𝓑 ⊆ A, 2 ≤ 𝓑.card ∧
        1 - ε ≤
          ((Finset.univ.filter (fun W : Finset U =>
              ∃ B ∈ 𝓑, B \ (Finset.univ.filter (fun u => ∀ B' ∈ 𝓑, u ∈ B')) ⊆ W)).card : ℝ) /
            (2 : ℝ) ^ (Fintype.card U)

/-! ## Lemma stubs -/

/-- Every odd-cut graph has no perfect matching. [MonotoneCircuitComplexityOf, node_03] -/
theorem oddCut_no_perfect_matching (n : ℕ) (a : Vertex n → Bool) (ha : a ∈ oddColorings n) :
    ¬ HasPerfectMatching (oddCutGraph a) := by
  sorry

/-- Rubric 1. Matching version of the robust sunflower estimate. [MonotoneCircuitComplexityOf, node_03] -/
theorem matching_sunflower (hRS : RobustSunflowerFact) :
    ∃ C : ℝ, 0 < C ∧
      ∀ (n ℓ : ℕ) (η : ℝ) (𝓜 : Finset (Finset (Edge n))),
        1 ≤ ℓ → 0 < η → η ≤ 1 / 2 →
        (∀ M ∈ 𝓜, IsPartialMatching M ∧ M.card = ℓ) → 2 ≤ 𝓜.card →
        (C * ℓ * (Real.log ((ℓ : ℝ) / η)) ^ 2) ^ ℓ ≤ (𝓜.card : ℝ) →
        ∃ 𝓜' ⊆ 𝓜, 2 ≤ 𝓜'.card ∧
          1 - η ≤ probOddCut (fun x => ∃ M ∈ 𝓜', termVal (M \ edgeCore 𝓜') x) := by
  sorry

/-- Rubric 2. DNF compression: for `1 ≤ w ≤ n` there is a threshold `r = O(w³ log² n)` such
that every matching DNF of width `≤ 2w` is dominated by an `r`-small matching DNF whose terms
are subsets of the original terms, with odd-cut false-positive probability `≤ n^{-14w}`. [MonotoneCircuitComplexityOf, node_03] -/
theorem dnf_compression (hRS : RobustSunflowerFact) :
    ∃ A₀ : ℝ, 0 < A₀ ∧ ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n → ∀ w : ℕ, 1 ≤ w → w ≤ n →
      ∃ r : ℕ, (r : ℝ) ≤ A₀ * (w : ℝ) ^ 3 * (Real.log n) ^ 2 ∧
        ∀ A : Finset (Finset (Edge n)),
          (∀ M ∈ A, IsPartialMatching M ∧ M.card ≤ 2 * w) →
          ∃ A' : Finset (Finset (Edge n)),
            (∀ M ∈ A', ∃ M₀ ∈ A, M ⊆ M₀) ∧
            IsRSmall A' r ∧
            (∀ x, dnfVal A x → dnfVal A' x) ∧
            probOddCut (fun x => dnfVal A' x ∧ ¬ dnfVal A x) ≤
              (n : ℝ) ^ (-(14 * (w : ℝ))) := by
  sorry

/-- Equation (6): a fixed `ℓ`-matching lies in a uniform perfect matching with probability
`(n-ℓ)!/n! ≤ (e/n)^ℓ`. [MonotoneCircuitComplexityOf, node_03] -/
theorem pm_contains_prob (n ℓ : ℕ) (hn : 1 ≤ n) (M : Finset (Edge n))
    (hM : IsPartialMatching M) (hcard : M.card = ℓ) :
    probPM (fun x => termVal M x) ≤ (Real.exp 1 / n) ^ ℓ := by
  sorry

/-- Rubric 4. An `r`-small matching DNF with `q = e r / n ≤ 1/100` has accuracy at most
`1/2 + q / (2(1-q))` under `𝓓 = ½(𝓓₀ + 𝓓₁)`. [MonotoneCircuitComplexityOf, node_03] -/
theorem small_dnf_poor_correlation (n r : ℕ) (hn : 1 ≤ n) (A : Finset (Finset (Edge n)))
    (hA : ∀ M ∈ A, IsPartialMatching M) (hsmall : IsRSmall A r)
    (hq : Real.exp 1 * r / n ≤ 1 / 100) :
    dnfAccuracy A ≤
      1 / 2 + (1 / 2) * ((Real.exp 1 * r / n) / (1 - Real.exp 1 * r / n)) := by
  sorry

/-! ## Main theorems -/

/-- Every fan-in-two monotone circuit computing `Match_n` has size
`2^{Ω(n^{1/3} / (log n)^{2/3})}`. [MonotoneCircuitComplexityOf, node_03] -/
theorem match_monotone_lower_bound (hRS : RobustSunflowerFact) :
    ∃ c : ℝ, 0 < c ∧ ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n →
      ∀ C : Circuit (Edge n), C.WellFormed → C.IsFanInTwoMonotone → ComputesMatch C →
        (2 : ℝ) ^ (c * (n : ℝ) ^ (1 / 3 : ℝ) / (Real.log n) ^ (2 / 3 : ℝ)) ≤ (C.size : ℝ) := by
  sorry

/-- Consequently, size `2^{n^{1/3 - o(1)}}`: for every `ε > 0`, eventually size
`≥ 2^{n^{1/3 - ε}}`. [MonotoneCircuitComplexityOf, node_03] -/
theorem match_monotone_lower_bound_exponent (hRS : RobustSunflowerFact) :
    ∀ ε : ℝ, 0 < ε → ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n →
      ∀ C : Circuit (Edge n), C.WellFormed → C.IsFanInTwoMonotone → ComputesMatch C →
        (2 : ℝ) ^ ((n : ℝ) ^ (1 / 3 - ε)) ≤ (C.size : ℝ) := by
  sorry

end TCSChallenge.MonotoneCircuitComplexityOfMatching.node_03
