/-- Rubric 1: the finite span of a line embedding of stretch `A` of a connected graph on `n`
vertices has `R - L ≤ A (n - 1)`. [ForbiddenSubgraphsOfGraphs, node_15] -/
theorem finite_span {V : Type} [Fintype V] (G : SimpleGraph V) (hG : G.Connected)
    (φ : V → ℤ) (A : ℤ) (hA : ∀ u v : V, G.Adj u v → |φ u - φ v| ≤ A) (u v : V) :
    |φ u - φ v| ≤ A * ((Fintype.card V : ℤ) - 1) := by
  sorry

/-- Rubric 1: finite S-contraction makes `φ` injective on `S`. [ForbiddenSubgraphsOfGraphs, node_15] -/
theorem injOn_of_contraction {V : Type} (G : SimpleGraph V) (hG : G.Connected)
    (S : Finset V) (φ : V → ℤ) (C : ℤ)
    (hC : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → (G.dist x y : ℤ) ≤ C * |φ x - φ y|) :
    Set.InjOn φ (S : Set V) := by
  sorry

/-- Rubric 2: for distinct `x, y ∈ S`,
`d_H(h x, h y) ≤ 4(k+1)(|S|+1)s · |φ x - φ y|`. [ForbiddenSubgraphsOfGraphs, node_15] -/
theorem segment_distance {V W : Type} (G : SimpleGraph V) (H : SimpleGraph W) (S : Finset V)
    (h : V → W) (φ : V → ℤ) (k s : ℕ) (hstr : QStretchLE G H S h s)
    (hC : ∀ x ∈ S, ∀ y ∈ S, x ≠ y →
      (G.dist x y : ℤ) ≤ 4 * ((k : ℤ) + 1) * ((S.card : ℤ) + 1) * |φ x - φ y|)
    (x y : V) (hx : x ∈ S) (hy : y ∈ S) (hxy : x ≠ y) :
    (H.dist (h x) (h y) : ℤ) ≤ 4 * ((k : ℤ) + 1) * ((S.card : ℤ) + 1) * s * |φ x - φ y| := by
  sorry

/-- Rubrics 2–4: the glued path embedding. Given a finite interval `[L, R]` with
`R - L + 1 ≤ K·|V(H)|` containing the images `φ(x)`, `x ∈ S`, where `φ` is injective on `S`
and the prescribed distances satisfy `d_H(h x, h y) ≤ D |φ x - φ y|`, there is `ψ : ℤ → V(H)`
with `ψ(φ x) = h x` on `S`, stretch at most `D` along consecutive integers of `[L, R]`, and
congestion on `[L, R]` at most `(|S|+1)(K+1)` (congestions of the segments are summed). [ForbiddenSubgraphsOfGraphs, node_15] -/
theorem glued_path_embedding (hPath : PathEmbeddingFact) {V W : Type} [Fintype W]
    (H : SimpleGraph W) (hH : H.Connected) (S : Finset V) (h : V → W) (φ : V → ℤ)
    (L R : ℤ) (D K : ℕ) (hD : 2 ≤ D) (hK : 2 ≤ K) (hLR : L ≤ R)
    (hsize : R - L + 1 ≤ (K : ℤ) * Fintype.card W)
    (hrange : ∀ x ∈ S, L ≤ φ x ∧ φ x ≤ R) (hinj : Set.InjOn φ (S : Set V))
    (hdist : ∀ x ∈ S, ∀ y ∈ S, (H.dist (h x) (h y) : ℤ) ≤ D * |φ x - φ y|) :
    ∃ ψ : ℤ → W, (∀ x ∈ S, ψ (φ x) = h x) ∧
      (∀ i : ℤ, L ≤ i → i < R → H.dist (ψ i) (ψ (i + 1)) ≤ D) ∧
      (∀ z : W, ((Finset.Icc L R).filter (fun i => ψ i = z)).card ≤ (S.card + 1) * (K + 1)) := by
  sorry

/-! ## Main theorem -/

/-- Main theorem: given connected `G` with a layout of bandwidth at most `k`, nonempty
`S ⊆ V(G)`, connected `H` with `|V(G)| ≤ r·|V(H)|` (`r ≥ 2`) and `h` of S-stretch at most `s`,
there is `g : V(G) → V(H)` with `g = h` on `S`, `str(g) ≤ 480(|S|+1)³(k+1)²s` and
`cong(g) ≤ 1300(|S|+1)⁴(k+1)r`. [ForbiddenSubgraphsOfGraphs, node_15] -/
theorem extension_embedding (hLine : LineEmbeddingFact) (hPath : PathEmbeddingFact)
    {V W : Type} [Fintype V] [Fintype W] (G : SimpleGraph V) (H : SimpleGraph W)
    (k s r : ℕ) (hk : 1 ≤ k) (hs : 1 ≤ s) (hr : 2 ≤ r)
    (hG : G.Connected) (hf : HasLayoutBW G k) (S : Finset V) (hS : S.Nonempty)
    (hH : H.Connected) (hsize : Fintype.card V ≤ r * Fintype.card W)
    (h : V → W) (hstr : QStretchLE G H S h s) :
    ∃ g : V → W, (∀ x ∈ S, g x = h x) ∧
      StretchLE G H g (480 * (S.card + 1) ^ 3 * (k + 1) ^ 2 * s) ∧
      CongLE g (1300 * (S.card + 1) ^ 4 * (k + 1) * r) := by
  sorry

