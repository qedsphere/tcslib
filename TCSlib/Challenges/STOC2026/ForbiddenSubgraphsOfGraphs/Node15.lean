/-!
## Extending a low-stretch map on prescribed vertices to a low-congestion embedding

Given a connected graph `G` with a layout of bandwidth at most `k`, a nonempty set `S ⊆ V(G)`,
a connected host `H` with `|V(H)| ≥ |V(G)|/r` (`r ≥ 2`) and a map `h : S → V(H)` of S-stretch
at most `s`, there is `g : V(G) → V(H)` agreeing with `h` on `S`, with
`str(g) ≤ 480(|S|+1)³(k+1)²s` and `cong(g) ≤ 1300(|S|+1)⁴(k+1)r`. The proof composes a line
embedding (`LineEmbeddingFact`) with piecewise path embeddings (`PathEmbeddingFact`).
The main theorem is `extension_embedding`.
-/

namespace TCSChallenge.ForbiddenSubgraphsOfGraphsWithLowBandwidth.node_15

/-- "A layout of an n-vertex graph G is a bijection λ : V(G) → {1,…,n}. Its bandwidth is
max{|λ(u)-λ(v)| : uv ∈ E(G)}." `HasLayoutBW G b` says some layout has bandwidth at most `b`
(positions are indexed from `0`; the condition is symmetric because adjacency is). -/
def HasLayoutBW {V : Type} [Fintype V] (G : SimpleGraph V) (b : ℕ) : Prop :=
  ∃ e : V ≃ Fin (Fintype.card V), ∀ u v : V, G.Adj u v → (e u : ℕ) ≤ (e v : ℕ) + b

/-- "bw(G) is the minimum bandwidth of a layout, with bw(G)=0 when G is edgeless." -/
noncomputable def bw {V : Type} [Fintype V] (G : SimpleGraph V) : ℕ :=
  sInf {b : ℕ | HasLayoutBW G b}

/-- "str(φ) = max{d_J(φ(u),φ(v)) : uv ∈ E(F)}"; `StretchLE F J φ c` means `str(φ) ≤ c`. -/
def StretchLE {V W : Type} (F : SimpleGraph V) (J : SimpleGraph W) (φ : V → W) (c : ℕ) :
    Prop :=
  ∀ u v : V, F.Adj u v → J.dist (φ u) (φ v) ≤ c

/-- "cong(φ) = max{|φ⁻¹(z)| : z ∈ V(J)}"; `CongLE φ c` means `cong(φ) ≤ c`. -/
def CongLE {V W : Type} [Fintype V] (φ : V → W) (c : ℕ) : Prop :=
  ∀ z : W, (Finset.univ.filter (fun x => φ x = z)).card ≤ c

/-- "η : Q → V(J) has Q-stretch at most s": `d_J(η x, η y) ≤ s · d_F(x,y)` for distinct
`x, y ∈ Q` (the ratio form, multiplied out). -/
def QStretchLE {V W : Type} (F : SimpleGraph V) (J : SimpleGraph W) (Q : Finset V)
    (η : V → W) (s : ℕ) : Prop :=
  ∀ x ∈ Q, ∀ y ∈ Q, x ≠ y → J.dist (η x) (η y) ≤ s * F.dist x y

/-- Supplied result 1: "Let F have a layout of bandwidth at most b, and let ∅≠Q⊆V(F). … one can
find a map φ:V(F)→ℤ such that str(φ)≤120(|Q|+1)²(b+1), cong(φ)≤10|Q|, and, for every distinct
x,y∈Q, d_F(x,y)≤4(b+1)(|Q|+1)|φ(x)−φ(y)|." (ℤ is the two-way infinite path, so
`d_ℤ(i,j) = |i - j|`.) All graphs are connected. -/
def LineEmbeddingFact : Prop :=
  ∀ (V : Type) [Fintype V] (F : SimpleGraph V) (b : ℕ) (Q : Finset V),
    F.Connected → HasLayoutBW F b → Q.Nonempty →
    ∃ φ : V → ℤ,
      (∀ u v : V, F.Adj u v →
        |φ u - φ v| ≤ 120 * ((Q.card : ℤ) + 1) ^ 2 * ((b : ℤ) + 1)) ∧
      CongLE φ (10 * Q.card) ∧
      (∀ x ∈ Q, ∀ y ∈ Q, x ≠ y →
        (F.dist x y : ℤ) ≤ 4 * ((b : ℤ) + 1) * ((Q.card : ℤ) + 1) * |φ x - φ y|)

/-- Supplied result 2: "Let R=(v₁,...,v_t) be a path, σ≥1 and K≥2 integers, J connected with
|V(J)|≥t/K. Whenever a,b∈V(J) satisfy d_J(a,b)≤σ(t−1), an embedding ψ:V(R)→V(J) can be computed
with ψ(v₁)=a, ψ(v_t)=b, str(ψ)≤max{2,σ}, cong(ψ)≤K+1." Here `t = m + 1` and the path has
vertices `Fin (m+1)` with edges `i ~ i+1`. -/
def PathEmbeddingFact : Prop :=
  ∀ (W : Type) [Fintype W] (J : SimpleGraph W) (m σ K : ℕ) (a b : W),
    1 ≤ σ → 2 ≤ K → J.Connected → m + 1 ≤ K * Fintype.card W → J.dist a b ≤ σ * m →
    ∃ ψ : Fin (m + 1) → W, ψ 0 = a ∧ ψ (Fin.last m) = b ∧
      (∀ i : Fin m, J.dist (ψ i.castSucc) (ψ i.succ) ≤ max 2 σ) ∧
      CongLE ψ (K + 1)

