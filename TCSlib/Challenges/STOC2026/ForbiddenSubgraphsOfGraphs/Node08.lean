/-!
## Subtrees of large pathwidth or small pathwidth

For a finite simple graph `G` and an integer `k ≥ 1`: either `G` contains a subtree `S`
(a subgraph that is a tree, not necessarily induced) with `pw(S) ≥ k`, or
`pw(G) ≤ (5·3^{k-1} - 5)/2`.

The strategy uses the tree family `H_j` (an edge; then three copies of `H_{j-1}` with a new
centre joined to the root of each copy), with `|V(H_j)| = (5·3^{j-1}-1)/2` and
`pw(H_j) ≥ j`, together with a pruning lemma turning a tree minor into a subtree.
Here `H_j` is `obsGraph (j-1)`.

Main theorem: `subtree_or_small_pathwidth`.
-/

namespace TCSChallenge.ForbiddenSubgraphsOfGraphs.node_08

/-- "a path decomposition is a sequence of vertex sets `(B_1,…,B_m)` such that every vertex
appears in a bag, the endpoints of every edge occur together in some bag, and the bags
containing any fixed vertex have consecutive indices"; `HasPathDecomp G w` says there is one
of width `max_i |B_i| - 1 ≤ w`. -/
def HasPathDecomp {V : Type} (G : SimpleGraph V) (w : ℕ) : Prop :=
  ∃ (m : ℕ) (B : Fin m → Finset V),
    (∀ v : V, ∃ i, v ∈ B i) ∧
    (∀ u v : V, G.Adj u v → ∃ i, u ∈ B i ∧ v ∈ B i) ∧
    (∀ (v : V) (i j l : Fin m), i ≤ j → j ≤ l → v ∈ B i → v ∈ B l → v ∈ B j) ∧
    (∀ i, (B i).card ≤ w + 1)

/-- "`pw(X)` is the minimum width of a path decomposition of `X`" (for finite `X` the set is
nonempty: one bag containing every vertex). -/
def pathwidth {V : Type} (G : SimpleGraph V) : ℕ :=
  sInf {w : ℕ | HasPathDecomp G w}

/-- "`H` is a minor of `X` if it can be obtained from a subgraph of `X` by contracting
edges", in the equivalent minor-model form: pairwise disjoint branch sets, each inducing a
connected (hence nonempty) subgraph of `X`, with an `X`-edge between the branch sets of
every edge of `H`. -/
def IsMinor {W V : Type} (H : SimpleGraph W) (X : SimpleGraph V) : Prop :=
  ∃ φ : W → Set V,
    (∀ w, (X.induce (φ w)).Connected) ∧
    Pairwise (fun a b => Disjoint (φ a) (φ b)) ∧
    ∀ a b, H.Adj a b → ∃ x ∈ φ a, ∃ y ∈ φ b, X.Adj x y

/-- `T - S` on the full vertex type: edges of `T` with both ends outside `S`. -/
def deleteVerts {V : Type} (T : SimpleGraph V) (S : Set V) : SimpleGraph V :=
  SimpleGraph.fromRel (fun x y => T.Adj x y ∧ x ∉ S ∧ y ∉ S)

/-- Vertex set of the component of `T - S` containing `v` (for `v ∉ S`). -/
def componentOf {V : Type} (T : SimpleGraph V) (S : Set V) (v : V) : Set V :=
  {u | u ∉ S ∧ (deleteVerts T S).Reachable v u}

/-! ## Supplied facts (used without proof; encoded as hypotheses) -/

/-- Fact 1: "Pathwidth is minor-monotone." -/
def MinorMonotoneFact : Prop :=
  ∀ (W V : Type) [Fintype W] [Fintype V] (H : SimpleGraph W) (X : SimpleGraph V),
    IsMinor H X → pathwidth H ≤ pathwidth X

/-- Fact 2: "If a graph `X` does not contain a given tree `H` as a minor, then
`pw(X) ≤ |V(H)| - 2`" (stated for trees with at least two vertices, avoiding truncation). -/
def ExcludedTreeFact : Prop :=
  ∀ (W V : Type) [Fintype W] [Fintype V] (H : SimpleGraph W) (X : SimpleGraph V),
    H.IsTree → 2 ≤ Fintype.card W → ¬ IsMinor H X → pathwidth X + 2 ≤ Fintype.card W

/-- Fact 3: "For every tree `T` and integer `r ≥ 1`, `pw(T) ≤ r` iff there is a path `P` in
`T` such that every component of `T - V(P)` has pathwidth at most `r - 1`." -/
def PathDeletionFact : Prop :=
  ∀ (W : Type) [Fintype W] (T : SimpleGraph W), T.IsTree → ∀ r : ℕ, 1 ≤ r →
    (pathwidth T ≤ r ↔
      ∃ (a b : W) (p : T.Walk a b), p.IsPath ∧
        ∀ v : W, v ∉ p.support →
          pathwidth (T.induce (componentOf T {x | x ∈ p.support} v)) ≤ r - 1)

/-! ## The obstruction family `H_{j+1} = obsGraph j` -/

/-- Vertex type of `H_{j+1}`: `H_1` has vertex set `Bool` (an edge); `H_{j+2}` has a new
centre `none` and three copies `some (i, x)`, `i : Fin 3`, of `H_{j+1}`. -/
def obsV : ℕ → Type
  | 0 => Bool
  | j + 1 => Option (Fin 3 × obsV j)

/-- The selected vertex of each copy (joined to the new centre at the next level). -/
def obsRoot : (j : ℕ) → obsV j
  | 0 => (false : Bool)
  | j + 1 => (none : Option (Fin 3 × obsV j))

/-- Vertex `x` of copy `i` of `H_{j+1}` inside `H_{j+2}`. -/
def obsCopy (j : ℕ) (i : Fin 3) (x : obsV j) : obsV (j + 1) :=
  (some (i, x) : Option (Fin 3 × obsV j))

/-- Fintype structure on `obsV j`, by recursion. -/
def obsFintype : (j : ℕ) → Fintype (obsV j)
  | 0 => (inferInstance : Fintype Bool)
  | j + 1 =>
      letI := obsFintype j
      (inferInstance : Fintype (Option (Fin 3 × obsV j)))

instance (j : ℕ) : Fintype (obsV j) := obsFintype j

/-- Adjacency relation of the obstruction: "form `H_j` from three disjoint copies of
`H_{j-1}` by adding one new central vertex and joining it to one selected vertex in each
copy". -/
def obsAdj : (j : ℕ) → obsV j → obsV j → Prop
  | 0, a, b => (a : Bool) ≠ b
  | j + 1, a, b =>
      match (a : Option (Fin 3 × obsV j)), (b : Option (Fin 3 × obsV j)) with
      | none, none => False
      | none, some (_, x) => x = obsRoot j
      | some (_, x), none => x = obsRoot j
      | some (i, x), some (i', y) => i = i' ∧ obsAdj j x y

/-- The tree `H_{j+1}`. -/
def obsGraph (j : ℕ) : SimpleGraph (obsV j) :=
  SimpleGraph.fromRel (obsAdj j)

/-! ## Rubric lemma stubs -/

/-- `H_{j+1}` is a tree. [ForbiddenSubgraphsOfGraphs, node_08] -/
theorem obsGraph_isTree (j : ℕ) : (obsGraph j).IsTree := by sorry

/-- Order recurrence `n_1 = 2`, `n_{j+1} = 3 n_j + 1`, solved:
`|V(H_{j+1})| = (5·3^j - 1)/2`. [ForbiddenSubgraphsOfGraphs, node_08] -/
theorem obsV_card (j : ℕ) : 2 * Fintype.card (obsV j) + 1 = 5 * 3 ^ j := by sorry

/-- Each copy is an induced copy of `H_{j+1}` inside `H_{j+2}`. [ForbiddenSubgraphsOfGraphs, node_08] -/
theorem obsCopy_adj (j : ℕ) (i : Fin 3) (x y : obsV j) :
    (obsGraph (j + 1)).Adj (obsCopy j i x) (obsCopy j i y) ↔ (obsGraph j).Adj x y := by
  sorry

/-- Key invariant: every path of `H_{j+2}` misses some entire copy of `H_{j+1}`. [ForbiddenSubgraphsOfGraphs, node_08] -/
theorem path_misses_copy (j : ℕ) (a b : obsV (j + 1)) (p : (obsGraph (j + 1)).Walk a b)
    (hp : p.IsPath) : ∃ i : Fin 3, ∀ x : obsV j, obsCopy j i x ∉ p.support := by sorry

/-- Pathwidth certification: `pw(H_{j+1}) ≥ j + 1`, by induction via the path-deletion
characterization with `r = j` and the untouched copy. [ForbiddenSubgraphsOfGraphs, node_08] -/
theorem obsGraph_pathwidth (h1 : MinorMonotoneFact) (h3 : PathDeletionFact) (j : ℕ) :
    j + 1 ≤ pathwidth (obsGraph j) := by sorry

/-- Minor-to-subtree conversion: if a tree `H` is a minor of `G`, then some subtree `S` of
`G` (a subgraph that is a tree) contains `H` as a minor. [ForbiddenSubgraphsOfGraphs, node_08] -/
theorem tree_minor_to_subtree {W V : Type} [Fintype W] [Fintype V]
    (H : SimpleGraph W) (G : SimpleGraph V) (hH : H.IsTree) (hm : IsMinor H G) :
    ∃ S : G.Subgraph, S.coe.IsTree ∧ IsMinor H S.coe := by sorry

/-- Arithmetic: `|V(H_k)| - 2 ≤ (5·3^{k-1} - 5)/2`, in integer form. [ForbiddenSubgraphsOfGraphs, node_08] -/
theorem obs_arith (k : ℕ) (n : ℕ) (hk : 1 ≤ k)
    (hn : 2 * Fintype.card (obsV (k - 1)) + 1 = 5 * 3 ^ (k - 1))
    (hpw : n + 2 ≤ Fintype.card (obsV (k - 1))) : 2 * n + 5 ≤ 5 * 3 ^ (k - 1) := by sorry

/-! ## Main theorem -/

/-- Either `G` contains a subtree `S` with `pw(S) ≥ k`, or
`pw(G) ≤ (5·3^{k-1} - 5)/2` (written as `2·pw(G) + 5 ≤ 5·3^{k-1}`). [ForbiddenSubgraphsOfGraphs, node_08] -/
theorem subtree_or_small_pathwidth
    (h1 : MinorMonotoneFact) (h2 : ExcludedTreeFact) (h3 : PathDeletionFact)
    {V : Type} [Fintype V] (G : SimpleGraph V) (k : ℕ) (hk : 1 ≤ k) :
    (∃ S : G.Subgraph, S.coe.IsTree ∧ k ≤ pathwidth S.coe) ∨
      2 * pathwidth G + 5 ≤ 5 * 3 ^ (k - 1) := by sorry

end TCSChallenge.ForbiddenSubgraphsOfGraphs.node_08
