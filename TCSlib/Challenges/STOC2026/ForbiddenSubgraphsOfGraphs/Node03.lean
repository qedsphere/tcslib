/-- The promised recursive claim `R_t`: for `t ≤ k`, a graph with no subtree of pathwidth at
least `t+1` has a subtree of bandwidth at least `k` or a layout of bandwidth at most `F_t`. [ForbiddenSubgraphsOfGraphs, node_03] -/
theorem promise_claim (hExt : ExtensionFact) (hRed : ReductionFact) (k : ℕ) (hk : 1 ≤ k) :
    ∀ t : ℕ, t ≤ k → ∀ (V : Type) [Fintype V] [DecidableEq V] (X : SimpleGraph V),
      NoPwSubtree X (t + 1) → HasBwSubtree X k ∨ HasLayoutBW X (boundF k t) := by
  sorry

/-! ## Main theorem -/

/-- Main theorem (combinatorial core of the algorithm): for every graph `G` and every `k ≥ 1`,
either `G` has a subtree `T` with `bw(T) ≥ k`, or `G` has a layout of bandwidth at most
`(10^85 · k^28)^(4^k)`. [ForbiddenSubgraphsOfGraphs, node_03] -/
theorem main_dichotomy (hExt : ExtensionFact) (hRed : ReductionFact)
    {V : Type} [Fintype V] [DecidableEq V] (G : SimpleGraph V) (k : ℕ) (hk : 1 ≤ k) :
    HasBwSubtree G k ∨ HasLayoutBW G ((10 ^ 85 * k ^ 28) ^ (4 ^ k)) := by
  sorry

