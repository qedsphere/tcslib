/-!
## Bandwidth versus subtrees of large bandwidth

A layout of an `n`-vertex graph is a bijection `V ≃ Fin n`; its bandwidth is the maximal
difference of positions of adjacent vertices, and `bw G` is the least bandwidth of a layout.
A subtree of `G` is a subgraph that is a tree (not necessarily induced or spanning).
Using a layout-extension result (`ExtensionFact`) and a one-level structural reduction
(`ReductionFact`) for graphs with no subtree of pathwidth `≥ t+1`, the challenge is
`main_dichotomy`: for every `k ≥ 1`, either `G` has a subtree of bandwidth `≥ k` or
`G` has a layout of bandwidth at most `(10^85 k^28)^(4^k)`.
-/

namespace TCSChallenge.ForbiddenSubgraphsOfGraphsWithLowBandwidth.node_03

/-- "A layout of an n-vertex graph G is a bijection λ : V(G) → {1,…,n}. Its bandwidth is
max{|λ(u)-λ(v)| : uv ∈ E(G)}." `HasLayoutBW G b` says some layout has bandwidth at most `b`
(positions are indexed from `0`; the condition is symmetric because adjacency is). -/
def HasLayoutBW {V : Type} [Fintype V] (G : SimpleGraph V) (b : ℕ) : Prop :=
  ∃ e : V ≃ Fin (Fintype.card V), ∀ u v : V, G.Adj u v → (e u : ℕ) ≤ (e v : ℕ) + b

/-- "bw(G) is the minimum bandwidth of a layout, with bw(G)=0 when G is edgeless." -/
noncomputable def bw {V : Type} [Fintype V] (G : SimpleGraph V) : ℕ :=
  sInf {b : ℕ | HasLayoutBW G b}

/-- The subgraph of `G` induced on the vertex set `W`, as a graph on the subtype `↥W`. -/
def inducedOn {V : Type} (G : SimpleGraph V) (W : Finset V) : SimpleGraph W :=
  SimpleGraph.comap (fun a : W => (a : V)) G

/-- "A path decomposition of G is a sequence (B₁,…,B_m) of vertex sets such that every vertex
belongs to some bag, the endpoints of every edge occur together in some bag, and the indices of
the bags containing any fixed vertex form an interval. Its width is max_i |B_i|-1."
`HasPathDecomp G w` says a path decomposition of width at most `w` exists. -/
def HasPathDecomp {V : Type} (G : SimpleGraph V) (w : ℕ) : Prop :=
  ∃ (m : ℕ) (B : Fin m → Finset V),
    (∀ v : V, ∃ i, v ∈ B i) ∧
    (∀ u v : V, G.Adj u v → ∃ i, u ∈ B i ∧ v ∈ B i) ∧
    (∀ (v : V) (i j l : Fin m), i ≤ j → j ≤ l → v ∈ B i → v ∈ B l → v ∈ B j) ∧
    (∀ i, (B i).card ≤ w + 1)

/-- "pw(G) is the minimum width of a path decomposition." -/
noncomputable def pw {V : Type} (G : SimpleGraph V) : ℕ :=
  sInf {w : ℕ | HasPathDecomp G w}

/-- "A subtree of G is any subgraph of G that is a tree; it need not be induced or spanning."
A subtree is given by its vertex set `W` and a tree `T` on `↥W` whose edges are edges of `G`. -/
def IsSubtree {V : Type} (G : SimpleGraph V) (W : Finset V) (T : SimpleGraph W) : Prop :=
  (∀ a b : W, T.Adj a b → G.Adj a b) ∧ T.IsTree

/-- `G` has a subtree of bandwidth at least `k`. -/
def HasBwSubtree {V : Type} (G : SimpleGraph V) (k : ℕ) : Prop :=
  ∃ (W : Finset V) (T : SimpleGraph W), IsSubtree G W T ∧ k ≤ bw T

/-- "G has no subtree of pathwidth at least t." -/
def NoPwSubtree {V : Type} (G : SimpleGraph V) (t : ℕ) : Prop :=
  ∀ (W : Finset V) (T : SimpleGraph W), IsSubtree G W T → pw T < t

/-- Maximum degree at most `D` (stated without decidability: every set of neighbours of a
vertex has at most `D` elements). -/
def MaxDegLE {V : Type} (G : SimpleGraph V) (D : ℕ) : Prop :=
  ∀ (v : V) (s : Finset V), (∀ u ∈ s, G.Adj v u) → s.card ≤ D

/-- Supplied result 2 (combinatorial content): "Let X have maximum degree at most D, let
∅ ≠ U ⊆ V(X), and let b ≥ 1. Given a layout of X-U of bandwidth at most b, one can construct
… a layout of X of bandwidth at most 12b|U|D." -/
def ExtensionFact : Prop :=
  ∀ (V : Type) [Fintype V] [DecidableEq V] (X : SimpleGraph V) (D b : ℕ) (U : Finset V),
    MaxDegLE X D → U.Nonempty → 1 ≤ b →
    HasLayoutBW (inducedOn X Uᶜ) b → HasLayoutBW X (12 * b * U.card * D)

/-- Supplied result 3 (combinatorial content of the one-level structural reduction): for
`1 ≤ t ≤ k` and connected `X` with no subtree of pathwidth at least `t+1`, either `X` has a
subtree of bandwidth at least `k`, or there is `d` with `2 ≤ d ≤ max{k,2}` and `Δ(X) ≤ 2k`
together with
(i) a set `U`, `|U| ≤ 1566 d³`, such that (every component of) `X-U` has no subtree of
pathwidth at least `t`; or
(ii) a pairwise disjoint family `ℋ` of vertex sets, each inducing a graph with no subtree of
pathwidth at least `t`, such that whenever every `X[H]`, `H ∈ ℋ`, has a layout of bandwidth at
most `B`, writing `B' = 19200 d³ k B`, either `X` has a subtree of bandwidth at least `k` or
there are disjoint `S, R` with `|S| ≤ 4d` and `N_X(R) ⊆ S`, and layouts of `X[R]` and
`X-(S∪R)` of bandwidth at most `B'` and `10^54 (4d+2)^11 (B'+1)^3 k^3` respectively. -/
def ReductionFact : Prop :=
  ∀ (V : Type) [Fintype V] [DecidableEq V] (X : SimpleGraph V) (t k : ℕ),
    1 ≤ t → t ≤ k → X.Connected → NoPwSubtree X (t + 1) →
    HasBwSubtree X k ∨
    ∃ d : ℕ, 2 ≤ d ∧ d ≤ max k 2 ∧ MaxDegLE X (2 * k) ∧
      ((∃ U : Finset V, U.card ≤ 1566 * d ^ 3 ∧ NoPwSubtree (inducedOn X Uᶜ) t) ∨
       (∃ Hs : Finset (Finset V),
          (∀ H₁ ∈ Hs, ∀ H₂ ∈ Hs, H₁ ≠ H₂ → Disjoint H₁ H₂) ∧
          (∀ H ∈ Hs, NoPwSubtree (inducedOn X H) t) ∧
          ∀ B : ℕ, 1 ≤ B → (∀ H ∈ Hs, HasLayoutBW (inducedOn X H) B) →
            HasBwSubtree X k ∨
            ∃ S R : Finset V, Disjoint S R ∧ S.card ≤ 4 * d ∧
              (∀ r ∈ R, ∀ u : V, X.Adj r u → u ∈ R ∨ u ∈ S) ∧
              HasLayoutBW (inducedOn X R) (19200 * d ^ 3 * k * B) ∧
              HasLayoutBW (inducedOn X (S ∪ R)ᶜ)
                (10 ^ 54 * (4 * d + 2) ^ 11 * (19200 * d ^ 3 * k * B + 1) ^ 3 * k ^ 3)))

/-- The constant `A = 10^85 k^28`. -/
def constA (k : ℕ) : ℕ := 10 ^ 85 * k ^ 28

/-- The recursive bound `F_t = A^{4^t}`. -/
def boundF (k t : ℕ) : ℕ := constA k ^ (4 ^ t)

