/-!
## Graphs in which every 2-separation is crossed are cycles

Let `G` be a simple graph on a possibly infinite vertex type `V`. `G` is 2-connected
if it has at least three vertices and stays connected after deleting at most one vertex.
A separation is an ordered pair `(A, B)` of vertex sets with `A ∪ B = V`, nonempty
`A \ B` and `B \ A`, and no edge between `A \ B` and `B \ A`. Its order is `|A ∩ B|`.
Two separations are nested if, after possibly swapping the entries of either pair,
`A ⊆ C` and `D ⊆ B`; otherwise they cross.

Main theorem `crossed_twoSeparations_imp_cycle`: if `G` is 2-connected, has a
2-separation, and every 2-separation is crossed by some 2-separation, then `G` is
isomorphic to `cycleGraph n` for some `n ≥ 4` (in particular `V` is finite).
-/

namespace TCSChallenge.CanonicalDecompositionsOf3.node_38

open SimpleGraph

variable {V : Type*}

/-- "G is 2-connected if it has at least three vertices and remains connected after
deletion of any set of at most one vertex." Deleting the empty set: `G.Connected`;
deleting a single vertex `v`: the induced subgraph on `V ∖ {v}` is connected. -/
def TwoConnected (G : SimpleGraph V) : Prop :=
  (∃ a b c : V, a ≠ b ∧ a ≠ c ∧ b ≠ c) ∧
  G.Connected ∧
  ∀ v : V, (G.induce {w : V | w ≠ v}).Connected

/-- "A separation of G is an ordered pair (A,B) of subsets of V(G) such that
A ∪ B = V(G), both A ∖ B and B ∖ A are nonempty, and no edge joins A ∖ B to B ∖ A." -/
def IsSeparation (G : SimpleGraph V) (A B : Set V) : Prop :=
  A ∪ B = Set.univ ∧ (A \ B).Nonempty ∧ (B \ A).Nonempty ∧
  ∀ x ∈ A \ B, ∀ y ∈ B \ A, ¬ G.Adj x y

/-- "Its order is |A ∩ B|. A separation of order two is a 2-separation."
(`Set.ncard` is `0` on infinite sets, so `ncard = 2` forces a finite separator of
exactly two vertices.) -/
def IsTwoSeparation (G : SimpleGraph V) (A B : Set V) : Prop :=
  IsSeparation G A B ∧ (A ∩ B).ncard = 2

/-- "Separations (A,B) and (C,D) are nested if, after independently interchanging the
entries within either pair, A ⊆ C and D ⊆ B." The four disjuncts are the four choices
of interchanging. -/
def Nested (A B C D : Set V) : Prop :=
  (A ⊆ C ∧ D ⊆ B) ∨ (B ⊆ C ∧ D ⊆ A) ∨ (A ⊆ D ∧ C ⊆ B) ∨ (B ⊆ D ∧ C ⊆ A)

/-- "Otherwise they cross." -/
def Cross (A B C D : Set V) : Prop := ¬ Nested A B C D

/-- Rubric 1 (attachment): if `{s,t}` is the separator of a 2-separation of a
2-connected graph, every component `K` of `G − {s,t}` has a neighbour of `s` and a
neighbour of `t`. A component is modelled as a nonempty vertex set avoiding `s,t`,
inducing a connected subgraph, with no edge to any vertex outside `K ∪ {s,t}`. [CanonicalDecompositionsOf3, node_38] -/
theorem component_attaches_to_both (G : SimpleGraph V) (hG : TwoConnected G)
    (A B : Set V) (s t : V) (hAB : IsTwoSeparation G A B) (hst : s ≠ t)
    (hsep : A ∩ B = {s, t}) (K : Set V) (hKs : s ∉ K) (hKt : t ∉ K)
    (hKne : K.Nonempty) (hKconn : (G.induce K).Connected)
    (hKclosed : ∀ x ∈ K, ∀ y : V, G.Adj x y → y ∈ K ∨ y = s ∨ y = t) :
    (∃ k ∈ K, G.Adj k s) ∧ (∃ k ∈ K, G.Adj k t) := by
  sorry

/-- Rubric 1 (starting reduction): a 2-connected graph with a 2-separation has a
2-separation `(A,B)` whose interior `A ∖ B` induces a connected subgraph. [CanonicalDecompositionsOf3, node_38] -/
theorem exists_twoSeparation_connected_interior (G : SimpleGraph V) (hG : TwoConnected G)
    (h : ∃ A B : Set V, IsTwoSeparation G A B) :
    ∃ A B : Set V, IsTwoSeparation G A B ∧ (G.induce (A \ B)).Connected := by
  sorry

/-- Rubric 2 (crossing observation): if `(A,B)` is a 2-separation of a 2-connected graph
with `G[A ∖ B]` connected and the 2-separation `(C,D)` crosses it, then the separators
are disjoint, each separator has one vertex strictly on each side of the other
separation, and the vertex of `C ∩ D` in `A ∖ B` separates the two vertices of `A ∩ B`
inside `G[A]` (and symmetrically for `B`): every walk between them staying in `A`
passes through it. [CanonicalDecompositionsOf3, node_38] -/
theorem crossing_observation (G : SimpleGraph V) (hG : TwoConnected G)
    (A B C D : Set V) (hAB : IsTwoSeparation G A B) (hCD : IsTwoSeparation G C D)
    (hconn : (G.induce (A \ B)).Connected) (hcross : Cross A B C D) :
    Disjoint (A ∩ B) (C ∩ D) ∧
    (∃ x ∈ A ∩ B, ∃ x' ∈ A ∩ B, x ∈ C \ D ∧ x' ∈ D \ C) ∧
    (∃ a ∈ C ∩ D, ∃ b ∈ C ∩ D, a ∈ A \ B ∧ b ∈ B \ A ∧
      (∀ x ∈ A ∩ B, ∀ x' ∈ A ∩ B, x ≠ x' →
        ∀ p : G.Walk x x', (∀ v ∈ p.support, v ∈ A) → a ∈ p.support) ∧
      (∀ x ∈ A ∩ B, ∀ x' ∈ A ∩ B, x ≠ x' →
        ∀ p : G.Walk x x', (∀ v ∈ p.support, v ∈ B) → b ∈ p.support)) := by
  sorry

/-- Main theorem: "if G is 2-connected, has a 2-separation, and every 2-separation of G
is crossed by another 2-separation, then G is a finite cycle of length at least four." [CanonicalDecompositionsOf3, node_38] -/
theorem crossed_twoSeparations_imp_cycle (G : SimpleGraph V) (hG : TwoConnected G)
    (hex : ∃ A B : Set V, IsTwoSeparation G A B)
    (hcrossed : ∀ A B : Set V, IsTwoSeparation G A B →
      ∃ C D : Set V, IsTwoSeparation G C D ∧ Cross A B C D) :
    ∃ n : ℕ, 4 ≤ n ∧ Nonempty (G ≃g cycleGraph n) := by
  sorry

end TCSChallenge.CanonicalDecompositionsOf3.node_38
