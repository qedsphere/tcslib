/-!
## Explicit finite four-qubit gate sets with a `1/(n poly k)` gap

For `G(n) = SO(2^n)` or `SU(2^n)` and `ρ_{n,k}(g) = g^{⊗k} ⊗ ḡ^{⊗k}`, the main theorem
`explicit_gate_gap` asserts: there are a finite nonempty inverse-symmetric multiset
`P₄ ⊆ G(4)` and constants `C, a > 0` such that for all `n ≥ 5`, `k ≥ 1`,
`L_{P̃₄ × ([n] choose 4)}(ρ_{n,k}) ⪰ (1/(C n k^a)) · L_{G(n)}(ρ_{n,k})`,
where `P̃₄` is the lazy law (identity w.p. `1/2`, else uniform from `P₄` with multiplicity),
and a uniformly random 4-subset `S ⊆ [n]` receives the gate in increasing order.
-/

namespace TCSChallenge.ExplicitOrthogonalAndUnitaryDesigns.node_06

/-- The two families of the paper: `G(r) = SO(2^r)` or `G(r) = SU(2^r)`. -/
inductive Family
  | orthogonal
  | unitary
  deriving DecidableEq

/-- "Identify `ℂ^{2^r}` with `(ℂ^2)^{⊗ r}`": the standard basis of `ℂ^{2^r}` is indexed by
binary strings of length `r` (binary coordinates), so `r`-qubit matrices are indexed by
`Qb r = Fin r → Fin 2`. Relabeling a basis does not change unitarity, reality of entries,
determinants, fixed spaces or operator norms. -/
abbrev Qb (r : ℕ) := Fin r → Fin 2

/-- Membership in `G(r)`, as complex `2^r × 2^r` matrices: `gᴴ g = I`, `det g = 1`, and in the
orthogonal case all entries are real (so `g ∈ SO(2^r) ⊆ SU(2^r)`). -/
def InG (F : Family) (r : ℕ) (g : Matrix (Qb r) (Qb r) ℂ) : Prop :=
  g.conjTranspose * g = 1 ∧ g.det = 1 ∧
    (F = Family.orthogonal → ∀ x y : Qb r, star (g x y) = g x y)

/-- The group `G(r)` as a set of matrices. -/
def GSet (F : Family) (r : ℕ) : Set (Matrix (Qb r) (Qb r) ℂ) := {g | InG F r g}

/-- Basis of `(ℂ^{2^r})^{⊗ k} ⊗ (\overline{ℂ^{2^r}})^{⊗ k}`: the first `k` slots are `inl`,
the conjugate slots are `inr`. -/
abbrev RIdx (k r : ℕ) := Fin k ⊕ Fin k → Qb r

/-- `ρ_{r,k}(g) = g^{⊗ k} ⊗ \bar g^{⊗ k}` (conjugation entrywise in the standard basis). -/
def tensorRep (k r : ℕ) (g : Matrix (Qb r) (Qb r) ℂ) : Matrix (RIdx k r) (RIdx k r) ℂ :=
  Matrix.of fun x y =>
    ∏ j : Fin k, (g (x (Sum.inl j)) (y (Sum.inl j)) * star (g (x (Sum.inr j)) (y (Sum.inr j))))

/-- `g_S`: for an increasing placement `e : Fin r → Fin n` of `r` qubits among `n`, act as `g`
on the tensor factors `e 0 < e 1 < …` and as the identity on the remaining factors. -/
def embedAlong {r n : ℕ} (e : Fin r → Fin n) (g : Matrix (Qb r) (Qb r) ℂ) :
    Matrix (Qb n) (Qb n) ℂ :=
  Matrix.of fun x y =>
    if (∀ i : Fin n, (∀ j : Fin r, e j ≠ i) → x i = y i) then
      g (fun j => x (e j)) (fun j => y (e j))
    else 0

/-- `P` is the Haar projection `∫_H ρ_{r,k}(g) dg` of a compact subgroup `H`: by Haar invariance
this average is the orthogonal projection onto the `ρ(H)`-fixed vectors, i.e. the Hermitian
idempotent whose fixed vectors are exactly the vectors fixed by every `ρ_{r,k}(g)`, `g ∈ H`. -/
def IsFixedProj (k r : ℕ) (H : Set (Matrix (Qb r) (Qb r) ℂ))
    (P : Matrix (RIdx k r) (RIdx k r) ℂ) : Prop :=
  P.IsHermitian ∧ P * P = P ∧
    ∀ v : RIdx k r → ℂ, P *ᵥ v = v ↔ ∀ g ∈ H, tensorRep k r g *ᵥ v = v

/-- `H_i ≤ G(n+1)`: the image of `G(n)` acting on all tensor factors other than the `i`-th
(in increasing order, via `Fin.succAbove i`) and as the identity on the `i`-th one. -/
def omitSubgroup (F : Family) (n : ℕ) (i : Fin (n + 1)) :
    Set (Matrix (Qb (n + 1)) (Qb (n + 1)) ℂ) :=
  {h | ∃ g, InG F n g ∧ h = embedAlong (fun j : Fin n => i.succAbove j) g}

/-- Euclidean norm of a vector (the sup norm on `ι → ℂ` is not the right one). -/
def vecNorm {ι : Type} [Fintype ι] (v : ι → ℂ) : ℝ :=
  Real.sqrt (∑ x, Complex.normSq (v x))

/-- Operator norm induced by the tensor-product (Euclidean) inner product. -/
def opNorm {ι : Type} [Fintype ι] (A : Matrix ι ι ℂ) : ℝ :=
  sSup {t : ℝ | ∃ v : ι → ℂ, vecNorm v = 1 ∧ t = vecNorm (A *ᵥ v)}

/-- Positive semidefinite (Loewner) order: `A ≼ B` iff `B - A ⪰ 0`. -/
def PSDLe {ι : Type} [Fintype ι] (A B : Matrix ι ι ℂ) : Prop := (B - A).PosSemidef

/-- `M_{k,m} = ∫ ρ_{k,m} dν_m = (1/m) ∑_i ∫_{H_i} ρ_{k,m}`, with `m = n + 1`, given the
subgroup Haar projections `Pis i`. -/
def omitAverage (k n : ℕ) (Pis : Fin (n + 1) → Matrix (RIdx k (n + 1)) (RIdx k (n + 1)) ℂ) :
    Matrix (RIdx k (n + 1)) (RIdx k (n + 1)) ℂ :=
  ((n + 1 : ℕ) : ℂ)⁻¹ • ∑ i, Pis i

/-- `γ_m = (1 − 1/m)(1 − 2^{2−m})/(4 − 2^{3−m})`. -/
def gammaConst (m : ℕ) : ℝ :=
  (1 - 1 / (m : ℝ)) * (1 - (2 : ℝ) ^ (2 - (m : ℝ))) / (4 - (2 : ℝ) ^ (3 - (m : ℝ)))

/-- The error term `1/m + √10 k m / 2^{m/2}`. -/
def sharpErr (k m : ℕ) : ℝ :=
  1 / (m : ℝ) + Real.sqrt 10 * (k : ℝ) * (m : ℝ) / (2 : ℝ) ^ ((m : ℝ) / 2)

/-- "A finite multiset `P` is inverse-symmetric if each element and its inverse have the same
multiplicity", for `P ⊆ G(4)` (so `g⁻¹ = gᴴ`); also nonempty, so the lazy law is defined. -/
def IsGateMultiset (F : Family) (P : Multiset (Matrix (Qb 4) (Qb 4) ℂ)) : Prop :=
  P ≠ 0 ∧ (∀ g ∈ P, InG F 4 g) ∧ P.map Matrix.conjTranspose = P

/-- `L_{P̃}(ρ_{4,k}) = I − (½ I + (1/(2|P|)) ∑_{g ∈ P} ρ_{4,k}(g))` on four qubits. -/
def lazyLaplacian (k : ℕ) (P : Multiset (Matrix (Qb 4) (Qb 4) ℂ)) :
    Matrix (RIdx k 4) (RIdx k 4) ℂ :=
  1 - ((1 / 2 : ℂ) • (1 : Matrix (RIdx k 4) (RIdx k 4) ℂ) +
    (2 * (Multiset.card P : ℂ))⁻¹ • (P.map fun g => tensorRep k 4 g).sum)

/-- `L_{P̃ × ([n] choose 4)}(ρ_{n,k})`: `I` minus the average, over the `C(n,4)` four-element
subsets `S ⊆ [n]` (uniform), of the lazy average `½ I + (1/(2|P|)) ∑_{g∈P} ρ_{n,k}(g_S)`,
where `g_S` places `g` on `S` in increasing order (`Finset.orderEmbOfFin`). -/
def lazySubsetLaplacian (k n : ℕ) (P : Multiset (Matrix (Qb 4) (Qb 4) ℂ)) :
    Matrix (RIdx k n) (RIdx k n) ℂ :=
  1 - ((Nat.choose n 4 : ℂ)⁻¹) •
    ∑ S : {S : Finset (Fin n) // S.card = 4},
      ((1 / 2 : ℂ) • (1 : Matrix (RIdx k n) (RIdx k n) ℂ) +
        (2 * (Multiset.card P : ℂ))⁻¹ •
          (P.map fun g =>
            tensorRep k n (embedAlong (fun j : Fin 4 => S.1.orderEmbOfFin S.2 j) g)).sum)

/-- Rubric 1: a fixed inverse-symmetric four-qubit gate multiset with a gap uniform over all
tensor orders: `L_{P̃₄}(ρ_{4,k}) ⪰ κ (I − Π_{4,k})` with `κ > 0` independent of `k`. [ExplicitOrthogonalAndUnitary, node_06] -/
theorem gate_local_gap (F : Family) :
    ∃ P : Multiset (Matrix (Qb 4) (Qb 4) ℂ), IsGateMultiset F P ∧
      ∃ κ : ℝ, 0 < κ ∧ ∀ k : ℕ, 1 ≤ k →
        ∀ Pi4 : Matrix (RIdx k 4) (RIdx k 4) ℂ, IsFixedProj k 4 (GSet F 4) Pi4 →
          PSDLe ((κ : ℂ) • (1 - Pi4)) (lazyLaplacian k P) := by
  sorry

/-- Rubric 2: uniform one-qubit-omission estimate on `m = n + 1 ≥ 4` qubits,
`‖M_{m,k} − Π_{m,k}‖ ≤ (1 − γ_m)^{1/4} ≤ 0.96`. [ExplicitOrthogonalAndUnitary, node_06] -/
theorem omission_uniform (F : Family) (n k : ℕ) (hm : 4 ≤ n + 1) (hk : 1 ≤ k)
    (Pi : Matrix (RIdx k (n + 1)) (RIdx k (n + 1)) ℂ)
    (hPi : IsFixedProj k (n + 1) (GSet F (n + 1)) Pi)
    (Pis : Fin (n + 1) → Matrix (RIdx k (n + 1)) (RIdx k (n + 1)) ℂ)
    (hPis : ∀ i, IsFixedProj k (n + 1) (omitSubgroup F n i) (Pis i)) :
    opNorm (omitAverage k n Pis - Pi) ≤ (1 - gammaConst (n + 1)) ^ ((1 : ℝ) / 4) ∧
      (1 - gammaConst (n + 1)) ^ ((1 : ℝ) / 4) ≤ 0.96 := by
  sorry

/-- Rubric 3: sharper large-scale estimate, for `m = n + 1 ≥ 5` and
`k ≤ 2^{m/2}/(√10 m)`: `L_{ν_m}(ρ_{m,k}) ⪰ (1 − 1/m − √10 k m/2^{m/2})(I − Π_{m,k})`. [ExplicitOrthogonalAndUnitary, node_06] -/
theorem omission_sharp (F : Family) (n k : ℕ) (hm : 5 ≤ n + 1) (hk : 1 ≤ k)
    (hkm : (k : ℝ) ≤ (2 : ℝ) ^ (((n + 1 : ℕ) : ℝ) / 2) / (Real.sqrt 10 * ((n + 1 : ℕ) : ℝ)))
    (Pi : Matrix (RIdx k (n + 1)) (RIdx k (n + 1)) ℂ)
    (hPi : IsFixedProj k (n + 1) (GSet F (n + 1)) Pi)
    (Pis : Fin (n + 1) → Matrix (RIdx k (n + 1)) (RIdx k (n + 1)) ℂ)
    (hPis : ∀ i, IsFixedProj k (n + 1) (omitSubgroup F n i) (Pis i)) :
    PSDLe (((1 - sharpErr k (n + 1) : ℝ) : ℂ) • (1 - Pi)) (1 - omitAverage k n Pis) := by
  sorry

/-- **Main theorem.** There are a finite nonempty inverse-symmetric multiset `P₄ ⊆ G(4)` and
constants `C, a > 0`, independent of `n` and `k`, such that for all `n ≥ 5` and `k ≥ 1`,
`L_{P̃₄ × ([n] choose 4)}(ρ_{n,k}) ⪰ (1/(C n k^a)) L_{G(n)}(ρ_{n,k})`. [ExplicitOrthogonalAndUnitary, node_06] -/
theorem explicit_gate_gap (F : Family) :
    ∃ P : Multiset (Matrix (Qb 4) (Qb 4) ℂ), IsGateMultiset F P ∧
      ∃ C a : ℝ, 0 < C ∧ 0 < a ∧ ∀ n k : ℕ, 5 ≤ n → 1 ≤ k →
        ∀ Pi : Matrix (RIdx k n) (RIdx k n) ℂ, IsFixedProj k n (GSet F n) Pi →
          PSDLe (((1 / (C * (n : ℝ) * (k : ℝ) ^ a) : ℝ) : ℂ) • (1 - Pi))
            (lazySubsetLaplacian k n P) := by
  sorry

end TCSChallenge.ExplicitOrthogonalAndUnitaryDesigns.node_06
