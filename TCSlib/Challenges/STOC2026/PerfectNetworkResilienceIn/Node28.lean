/-!
## Perfect network resilience: skipping patterns on every yes-instance

A rooted graph `(G, t)` is *perfectly resilient* if there is a local, deterministic forwarding
pattern `π = (π_v)` (each `π_v` sees only the incoming edge and the failed edges at `v`) such
that for every source `s` and every failure set `F`, the packet started at `s` reaches `t`
whenever `s` and `t` are connected in `G - F`.

A *skipping* pattern stores, for every vertex `v` and incoming edge `p ∈ E_v ∪ {⊥}`, a
permutation `L_{v,p}` of the incident edges and forwards along the first non-failed one.

Main theorem (`exists_resilient_skipping_pattern`): on a finite graph, if `(G, t)` is perfectly
resilient then it admits a perfectly resilient skipping pattern; this is the combinatorial
content of the claim that synthesis outputs a skipping pattern on every yes-instance.
The lemma stubs follow the proof strategy: reduction to the component of `t`, cut-vertex
decomposition into rooted blocks (with composition of skipping lists), invariance under
deletion of separating edges, the separator-free core, and rooted-minor closedness.
-/

namespace TCSChallenge.PerfectNetworkResilienceIn.node_28

variable {V : Type*}

/-- "the set of failed incident edges" at `v`, encoded as the set of neighbours `w` of `v`
whose edge `{v,w}` lies in the global failure set `F`. -/
def failedAt (G : SimpleGraph V) (F : Set (Sym2 V)) (v : V) : Set V :=
  {w | G.Adj v w ∧ Sym2.mk (v, w) ∈ F}

/-- "A local forwarding function `π_v : (E_v ∪ {⊥}) × 2^{E_v} → E_v ∪ {⊥}`". The incoming
edge is given by the neighbour it comes from (`none` = `⊥`, routing starts at `v`); the
output `some w` means "forward along `{v,w}`", `none` means `⊥`. -/
abbrev ForwardingPattern (V : Type*) := V → Option V → Set V → Option V

/-- One routing step. At `t` the packet stays (it has arrived). Otherwise `v` applies its
local function to the incoming edge and its local failure set; forwarding along a non-edge,
a failed edge, or `⊥` drops the packet (`none`). The new state records the incoming edge. -/
def step (G : SimpleGraph V) (t : V) (π : ForwardingPattern V) (F : Set (Sym2 V)) :
    V × Option V → Option (V × Option V)
  | (v, p) =>
    if v = t then some (v, p)
    else
      match π v p (failedAt G F v) with
      | some w => if G.Adj v w ∧ Sym2.mk (v, w) ∉ F then some (w, some v) else none
      | none => none

/-- "its deterministic route": the state after `k` steps from source `s` started with
incoming edge `⊥`. -/
def routeState (G : SimpleGraph V) (t : V) (π : ForwardingPattern V) (F : Set (Sym2 V))
    (s : V) : ℕ → Option (V × Option V)
  | 0 => some (s, none)
  | k + 1 => (routeState G t π F s k).bind (step G t π F)

/-- "the route reaches `t`". -/
def Reaches (G : SimpleGraph V) (t : V) (π : ForwardingPattern V) (F : Set (Sym2 V))
    (s : V) : Prop :=
  ∃ k : ℕ, ∃ p : Option V, routeState G t π F s k = some (t, p)

/-- "A forwarding pattern is perfectly resilient if, for every source `s` and global failure
set `F ⊆ E`, its deterministic route reaches `t` whenever `s` and `t` are connected in
`G - F`." -/
def IsResilient (G : SimpleGraph V) (t : V) (π : ForwardingPattern V) : Prop :=
  ∀ (s : V) (F : Set (Sym2 V)), (G.deleteEdges F).Reachable s t → Reaches G t π F s

/-- `(G, t)` is perfectly resilient: some forwarding pattern is (yes-instance of
Perfect Resilience Decision). -/
def PerfectlyResilient (G : SimpleGraph V) (t : V) : Prop :=
  ∃ π : ForwardingPattern V, IsResilient G t π

/-- "for every pair `(v,p)` it explicitly stores a permutation `L_{v,p}` of `E_v`": each list
is duplicate-free and lists exactly the neighbours of `v`. (Lists for irrelevant `p` are
also required to be permutations; this is harmless.) -/
def IsSkippingTable (G : SimpleGraph V) (L : V → Option V → List V) : Prop :=
  ∀ (v : V) (p : Option V), (L v p).Nodup ∧ ∀ w : V, w ∈ L v p ↔ G.Adj v w

/-- "forwards along the first nonfailed edge in that list". -/
def skipFwd (L : V → Option V → List V) : ForwardingPattern V :=
  fun v p X => (L v p).find? (fun w => decide (w ∉ X))

/-- A perfectly resilient skipping forwarding pattern (the required synthesis output). -/
def HasResilientSkipping (G : SimpleGraph V) (t : V) : Prop :=
  ∃ L : V → Option V → List V, IsSkippingTable G L ∧ IsResilient G t (skipFwd L)

/-- Biconnected: at least three vertices, connected, and deleting any single vertex `z`
leaves every two other vertices connected. -/
def Biconnected (G : SimpleGraph V) : Prop :=
  (∃ a b c : V, a ≠ b ∧ b ≠ c ∧ a ≠ c) ∧ G.Connected ∧
    ∀ z x y : V, x ≠ z → y ≠ z → ∃ q : G.Walk x y, z ∉ q.support

/-- "call an edge `{u,v}` separating if deleting the vertices `u` and `v` disconnects the
graph": two vertices outside `{u,v}` such that every walk between them meets `u` or `v`. -/
def IsSeparatingEdge (G : SimpleGraph V) (u v : V) : Prop :=
  G.Adj u v ∧ ∃ x y : V, x ≠ u ∧ x ≠ v ∧ y ≠ u ∧ y ≠ v ∧
    ∀ q : G.Walk x y, u ∈ q.support ∨ v ∈ q.support

/-- The set `S` of separating edges. -/
def sepEdges (G : SimpleGraph V) : Set (Sym2 V) :=
  {e | ∃ u v : V, e = Sym2.mk (u, v) ∧ IsSeparatingEdge G u v}

/-- "`(H,r)` is a rooted minor of `(G,t)` if it has pairwise disjoint connected branch sets
`(B_x)_{x ∈ V(H)}` in `G`, with every edge of `H` realized between the corresponding branch
sets and with `t ∈ B_r`." Branch sets are nonempty and induce connected subgraphs. -/
def IsRootedMinor {W : Type*} (H : SimpleGraph W) (r : W) (G : SimpleGraph V) (t : V) :
    Prop :=
  ∃ B : W → Set V,
    (∀ x y : W, x ≠ y → Disjoint (B x) (B y)) ∧
    (∀ x : W, (G.induce (B x)).Connected) ∧
    (∀ x y : W, H.Adj x y → ∃ a ∈ B x, ∃ b ∈ B y, G.Adj a b) ∧
    t ∈ B r

/-! ## Lemma stubs (rubric items) -/

/-- Perfect resilience is closed under rooted minors (consequence of the forbidden rooted
minor characterization; underlies the root-preserving minor tests in the decision step). [PerfectNetworkResilienceIn, node_28] -/
theorem perfectlyResilient_of_rootedMinor {W : Type*} [Finite V] [Finite W]
    (G : SimpleGraph V) (t : V) (H : SimpleGraph W) (r : W)
    (hmin : IsRootedMinor H r G t) (hG : PerfectlyResilient G t) :
    PerfectlyResilient H r := by sorry

/-- Connectivity preprocessing: if `V = A ⊔ B` with no edges between `A` and `B` and
`t ∈ A`, then `(G,t)` is perfectly resilient iff `(G[A], t)` is, and the same holds for
skipping patterns (lists on `B` are arbitrary). [PerfectNetworkResilienceIn, node_28] -/
theorem resilient_iff_component (G : SimpleGraph V) (t : V) (A : Set V) (ht : t ∈ A)
    (hcut : ∀ a b : V, a ∈ A → b ∉ A → ¬ G.Adj a b) :
    (PerfectlyResilient G t ↔ PerfectlyResilient (G.induce A) ⟨t, ht⟩) ∧
    (HasResilientSkipping G t ↔ HasResilientSkipping (G.induce A) ⟨t, ht⟩) := by sorry

/-- Block decomposition at a cut vertex `c`: `V = A ∪ B`, `A ∩ B = {c}`, no edges between
`A \ {c}` and `B \ {c}`, `t ∈ A`, and `c` reaches `t` inside `G[A]`. Then `(G,t)` is perfectly
resilient iff `(G[A], t)` and the child piece `(G[B], c)` (rooted at the articulation
towards `t`) are. [PerfectNetworkResilienceIn, node_28] -/
theorem resilient_iff_cutVertex (G : SimpleGraph V) (t c : V) (A B : Set V)
    (hcov : ∀ v : V, v ∈ A ∨ v ∈ B) (hcap : ∀ v : V, v ∈ A → v ∈ B → v = c)
    (hcA : c ∈ A) (hcB : c ∈ B) (ht : t ∈ A)
    (hsep : ∀ a b : V, a ∈ A → b ∈ B → G.Adj a b → a = c ∨ b = c)
    (hreach : (G.induce A).Reachable ⟨c, hcA⟩ ⟨t, ht⟩) :
    PerfectlyResilient G t ↔
      PerfectlyResilient (G.induce A) ⟨t, ht⟩ ∧ PerfectlyResilient (G.induce B) ⟨c, hcB⟩ := by
  sorry

/-- Composition of skipping lists at a cut vertex: traffic arriving at `c` from the child
piece is treated as a fresh start in the parent piece, and parent-piece choices precede
child-piece choices. Resilient skipping patterns of the two pieces combine into one for `G`. [PerfectNetworkResilienceIn, node_28] -/
theorem skipping_compose_cutVertex (G : SimpleGraph V) (t c : V) (A B : Set V)
    (hcov : ∀ v : V, v ∈ A ∨ v ∈ B) (hcap : ∀ v : V, v ∈ A → v ∈ B → v = c)
    (hcA : c ∈ A) (hcB : c ∈ B) (ht : t ∈ A)
    (hsep : ∀ a b : V, a ∈ A → b ∈ B → G.Adj a b → a = c ∨ b = c)
    (hA : HasResilientSkipping (G.induce A) ⟨t, ht⟩)
    (hB : HasResilientSkipping (G.induce B) ⟨c, hcB⟩) :
    HasResilientSkipping G t := by sorry

/-- Deleting a single separating edge preserves biconnectivity. [PerfectNetworkResilienceIn, node_28] -/
theorem biconnected_deleteEdge_separating (G : SimpleGraph V) (u v : V)
    (hG : Biconnected G) (huv : IsSeparatingEdge G u v) :
    Biconnected (G.deleteEdges {Sym2.mk (u, v)}) := by sorry

/-- Separator-free core reduction: for a biconnected finite rooted graph, perfect resilience of
`(G,t)` is equivalent to perfect resilience of `(G - S, t)`. [PerfectNetworkResilienceIn, node_28] -/
theorem resilient_iff_deleteSepEdges [Finite V] (G : SimpleGraph V) (t : V)
    (hG : Biconnected G) :
    PerfectlyResilient G t ↔ PerfectlyResilient (G.deleteEdges (sepEdges G)) t := by sorry

/-- Core construction (Fact 4 made constructive): a biconnected finite rooted graph without
separating edges that is perfectly resilient admits a perfectly resilient skipping (right-hand)
pattern. [PerfectNetworkResilienceIn, node_28] -/
theorem core_has_skipping_pattern [Finite V] (G : SimpleGraph V) (t : V)
    (hG : Biconnected G) (hS : sepEdges G = ∅) (hres : PerfectlyResilient G t) :
    HasResilientSkipping G t := by sorry

/-- Separating-edge lifting: a resilient skipping pattern for the core `G - S` of a
biconnected graph lifts to a resilient skipping pattern for `G` (priority prefixes for the
reinserted separating edges; failed inserted edges recover the core routing, live ones
simulate an endpoint-to-endpoint excursion). [PerfectNetworkResilienceIn, node_28] -/
theorem skipping_lift_sepEdges [Finite V] (G : SimpleGraph V) (t : V)
    (hG : Biconnected G)
    (hcore : HasResilientSkipping (G.deleteEdges (sepEdges G)) t) :
    HasResilientSkipping G t := by sorry

/-! ## Main theorem -/

/-- Synthesis core: on every finite yes-instance of Perfect Resilience Decision there is a
perfectly resilient skipping forwarding pattern; conversely a skipping pattern is a
forwarding pattern. [PerfectNetworkResilienceIn, node_28] -/
theorem exists_resilient_skipping_pattern [Finite V] (G : SimpleGraph V) (t : V) :
    PerfectlyResilient G t ↔ HasResilientSkipping G t := by sorry

end TCSChallenge.PerfectNetworkResilienceIn.node_28
