/-!
## Multilevel monotonicity correction from a binary swap primitive

Let `P` be a finite poset (a strict order on a finite vertex type `V`, `N = |V|`) whose Hasse
diagram has in/out-degree at most `Δ` and height at most `h`. Assume a binary-label primitive:
for every such order `Q` on `V` and every `b : V → Bool`, it returns a permutation `σ` such that
`b ∘ σ` is monotone on `Q` and `σ` arises from the identity by swaps `σ ← σ ∘ (u v)` with
`u <_Q v` and `b (σ u) = 1 > 0 = b (σ v)`.

From `f : V → [-1,1]` we quantize `F₀ = ⌊f/ε⌋ - L` (with `L = ⌊-1/ε⌋`) into `t` bits, and for
`j = 1..t` run the primitive on the order `Q_j` (P-comparable pairs with equal first `j-1`
bits of the current labels) with bit labels `b_j` = the `j`-th most significant bit, moving
the full labels: `F_j = F_{j-1} ∘ π_j`. The output is `g = clip_{[-1,1]} (ε (F_t + L))`.

Main theorem `multilevel_correction`: if `dist₁(f, mono) ≤ α` and `ε ∈ (0, 1/2)`, then `g`
is monotone, takes values in `[-1,1]`, and `‖f - g‖₁ ≤ 2α + 3ε`.
-/

namespace TCSChallenge.AgnosticProperLearningOf.node_05

variable {V : Type} [Fintype V] [DecidableEq V]

/-- "Let P be a finite poset": a strict partial order (irreflexive, transitive) on `V`. -/
def IsStrictPO (R : V → V → Prop) : Prop :=
  (∀ x, ¬ R x x) ∧ ∀ x y z, R x y → R y z → R x z

/-- Edges of the directed Hasse diagram: `u ⋖ v` iff `u < v` with nothing strictly between. -/
def Covers (R : V → V → Prop) (u v : V) : Prop :=
  R u v ∧ ¬ ∃ w, R u w ∧ R w v

/-- "Every vertex of its directed Hasse diagram has at most Δ incoming and at most Δ outgoing
edges, and every directed path has length at most h." -/
def DegreeHeightBounded (R : V → V → Prop) (Δ h : ℕ) : Prop :=
  (∀ v, Set.ncard {u | Covers R u v} ≤ Δ) ∧
  (∀ u, Set.ncard {v | Covers R u v} ≤ Δ) ∧
  ∀ (k : ℕ) (p : Fin (k + 1) → V),
    (∀ i : Fin k, Covers R (p i.castSucc) (p i.succ)) → k ≤ h

/-- "A function m is monotone if m(u) ≤ m(v) whenever u ≤_P v" (the case `u = v` is trivial). -/
def IsMonotoneOn {β : Type} [Preorder β] (R : V → V → Prop) (m : V → β) : Prop :=
  ∀ u v, R u v → m u ≤ m v

/-- "‖a − b‖₁ := (1/N) ∑_{x∈P} |a(x) − b(x)|". -/
def l1Dist (a b : V → ℝ) : ℝ :=
  (1 / (Fintype.card V : ℝ)) * ∑ x, |a x - b x|

/-- The binary primitive's swap condition: `σ` is obtainable from the identity by operations
`σ ← σ ∘ (u v)` with `u <_Q v` and `b(σ(u)) > b(σ(v))`, each condition evaluated immediately
before the operation. (`σ * swap u v` is `σ ∘ (u v)`.) -/
inductive BinSwapReachable (R : V → V → Prop) (b : V → Bool) : Equiv.Perm V → Prop
  | refl : BinSwapReachable R b 1
  | step (σ : Equiv.Perm V) (u v : V) :
      BinSwapReachable R b σ → R u v → b (σ u) = true → b (σ v) = false →
      BinSwapReachable R b (σ * Equiv.swap u v)

/-- Real-label analogue: `σ` is a finite sequence of swaps of inverted comparable pairs of the
full labels `a` (condition `a(σ u) ≥ a(σ v)` with `u <_R v`, evaluated before each swap). -/
inductive InvSwapReachable (R : V → V → Prop) (a : V → ℝ) : Equiv.Perm V → Prop
  | refl : InvSwapReachable R a 1
  | step (σ : Equiv.Perm V) (u v : V) :
      InvSwapReachable R a σ → R u v → a (σ v) ≤ a (σ u) →
      InvSwapReachable R a (σ * Equiv.swap u v)

/-- The assumed binary-label procedure (success event): for every order `Q` on the vertex set
with the same degree and height bounds and every `b : Q → {0,1}`, `prim Q b` is a permutation
`σ` with `b ∘ σ` monotone on `Q`, obtained by the swap operations above. -/
def PrimSpec (Δ h : ℕ) (prim : (V → V → Prop) → (V → Bool) → Equiv.Perm V) : Prop :=
  ∀ (Q : V → V → Prop) (b : V → Bool), IsStrictPO Q → DegreeHeightBounded Q Δ h →
    BinSwapReachable Q b (prim Q b) ∧
    ∀ u v, Q u v → b (prim Q b u) = true → b (prim Q b v) = true

/-- `L = ⌊−1/ε⌋`. -/
def quantL (ε : ℝ) : ℤ := ⌊-1 / ε⌋

/-- `K = ⌊1/ε⌋ − L + 1` (number of quantization levels). -/
def quantK (ε : ℝ) : ℕ := (⌊1 / ε⌋ - quantL ε + 1).toNat

/-- `t = ⌈log₂ K⌉`. -/
def numBits (ε : ℝ) : ℕ := Nat.clog 2 (quantK ε)

/-- `F₀(x) = ⌊f(x)/ε⌋ − L ∈ {0, …, K−1}` (as a natural number; nonnegative for `f ≥ −1`). -/
def quantize (ε : ℝ) (f : V → ℝ) (x : V) : ℕ := (⌊f x / ε⌋ - quantL ε).toNat

/-- `p_j(z) = ⌊z / 2^{t−j}⌋`: the first `j` most significant bits of a `t`-bit label. -/
def prefixBits (t j z : ℕ) : ℕ := z / 2 ^ (t - j)

/-- The `j`-th most significant bit (`1 ≤ j ≤ t`) of a `t`-bit label. -/
def bitAt (t j z : ℕ) : Bool := decide (z / 2 ^ (t - j) % 2 = 1)

/-- The restricted order at stage `j+1`: `u ≺_{Q} v` iff `u ≺_P v` and the current labels have
equal first `j` bits (equation (4) of the reference; equals the order generated by the retained
Hasse edges once the prefix-monotonicity invariant holds). -/
def restrictOrder (P : V → V → Prop) (t j : ℕ) (F : V → ℕ) : V → V → Prop :=
  fun u v => P u v ∧ prefixBits t j (F u) = prefixBits t j (F v)

/-- The multilevel construction: `F_0 = F₀`, and `F_{j+1} = F_j ∘ π_{j+1}` where `π_{j+1}` is the
primitive's permutation on the restricted order with labels the `(j+1)`-st bit of `F_j`.
Full labels are moved, not individual bits. -/
def stageLabels (P : V → V → Prop) (prim : (V → V → Prop) → (V → Bool) → Equiv.Perm V)
    (t : ℕ) (F₀ : V → ℕ) : ℕ → V → ℕ
  | 0 => F₀
  | j + 1 => fun x =>
      stageLabels P prim t F₀ j
        (prim (restrictOrder P t j (stageLabels P prim t F₀ j))
          (fun y => bitAt t (j + 1) (stageLabels P prim t F₀ j y)) x)

/-- The output `g(x) = min{1, max{−1, ε (F_t(x) + L)}}`. -/
def outputLabel (P : V → V → Prop) (prim : (V → V → Prop) → (V → Bool) → Equiv.Perm V)
    (ε : ℝ) (f : V → ℝ) (x : V) : ℝ :=
  max (-1) (min 1 (ε * ((stageLabels P prim (numBits ε) (quantize ε f) (numBits ε) x : ℝ)
    + (quantL ε : ℝ))))

/-! ### Rubric lemma stubs -/

/-- Swap inequality: for `A ≥ C` and `s ≤ t`, `|C−s| + |A−t| ≤ |A−s| + |C−t|`. [AgnosticProperLearningOf, node_05] -/
theorem swap_inequality (A C s t : ℝ) (hAC : C ≤ A) (hst : s ≤ t) :
    |C - s| + |A - t| ≤ |A - s| + |C - t| := by
  sorry

/-- Exchanging inverted comparable pairs never increases distance to a monotone comparator. [AgnosticProperLearningOf, node_05] -/
theorem invSwap_sum_le (R : V → V → Prop) (a m : V → ℝ) (hm : IsMonotoneOn R m)
    (σ : Equiv.Perm V) (hσ : InvSwapReachable R a σ) :
    ∑ x, |a (σ x) - m x| ≤ ∑ x, |a x - m x| := by
  sorry

/-- Consequence (1): `‖a∘σ − a‖₁ ≤ 2 ‖a − m‖₁`. [AgnosticProperLearningOf, node_05] -/
theorem invSwap_l1_le (R : V → V → Prop) (a m : V → ℝ) (hm : IsMonotoneOn R m)
    (σ : Equiv.Perm V) (hσ : InvSwapReachable R a σ) :
    l1Dist (fun x => a (σ x)) a ≤ 2 * l1Dist a m := by
  sorry

/-- Signed quantization: `F₀ < 2^t` and `|ε(F₀(x) + L) − f(x)| < ε` for `f(x) ∈ [−1,1]`. [AgnosticProperLearningOf, node_05] -/
theorem quantize_props (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1 / 2) (f : V → ℝ)
    (hf : ∀ x, f x ∈ Set.Icc (-1 : ℝ) 1) (x : V) :
    quantize ε f x < 2 ^ numBits ε ∧
    |ε * ((quantize ε f x : ℝ) + (quantL ε : ℝ)) - f x| < ε := by
  sorry

/-- Restricted-poset access: if the `j`-bit prefixes of `F` are monotone on `P`, the
restricted order is a strict order, its cover relations are exactly the `P`-covers with equal
prefixes (no new covers appear), and it keeps the degree and height bounds. [AgnosticProperLearningOf, node_05] -/
theorem restrictOrder_props (P : V → V → Prop) (hP : IsStrictPO P) (Δ h : ℕ)
    (hb : DegreeHeightBounded P Δ h) (t j : ℕ) (F : V → ℕ)
    (hmono : IsMonotoneOn P (fun x => prefixBits t j (F x))) :
    IsStrictPO (restrictOrder P t j F) ∧
    (∀ u v, Covers (restrictOrder P t j F) u v ↔
      (Covers P u v ∧ prefixBits t j (F u) = prefixBits t j (F v))) ∧
    DegreeHeightBounded (restrictOrder P t j F) Δ h := by
  sorry

/-- Order invariant: `p_j ∘ F_j` is monotone on `P` for every `j ≤ t`. [AgnosticProperLearningOf, node_05] -/
theorem stage_prefix_monotone (P : V → V → Prop) (hP : IsStrictPO P) (Δ h : ℕ)
    (hb : DegreeHeightBounded P Δ h)
    (prim : (V → V → Prop) → (V → Bool) → Equiv.Perm V) (hprim : PrimSpec Δ h prim)
    (t : ℕ) (F₀ : V → ℕ) (hF₀ : ∀ x, F₀ x < 2 ^ t) (j : ℕ) (hj : j ≤ t) :
    IsMonotoneOn P (fun x => prefixBits t j (stageLabels P prim t F₀ j x)) := by
  sorry

/-- Every binary-stage swap is an inversion of the current full labels: `F_j = F₀ ∘ τ` with `τ`
a sequence of swaps of `P`-comparable inverted pairs of the full labels. [AgnosticProperLearningOf, node_05] -/
theorem stage_inversion_perm (P : V → V → Prop) (hP : IsStrictPO P) (Δ h : ℕ)
    (hb : DegreeHeightBounded P Δ h)
    (prim : (V → V → Prop) → (V → Bool) → Equiv.Perm V) (hprim : PrimSpec Δ h prim)
    (t : ℕ) (F₀ : V → ℕ) (hF₀ : ∀ x, F₀ x < 2 ^ t) (j : ℕ) (hj : j ≤ t) :
    ∃ τ : Equiv.Perm V, InvSwapReachable P (fun x => (F₀ x : ℝ)) τ ∧
      ∀ x, stageLabels P prim t F₀ j x = F₀ (τ x) := by
  sorry

/-! ### Main theorem -/

/-- Fix `ε ∈ (0, 1/2)`. For every `f : P → [−1,1]` with `dist₁(f, mono) ≤ α`, the multilevel
construction built from the binary primitive outputs `g : P → [−1,1]` that is monotone and
satisfies `‖f − g‖₁ ≤ 2α + 3ε` (on the primitive's success event). [AgnosticProperLearningOf, node_05] -/
theorem multilevel_correction (P : V → V → Prop) (hP : IsStrictPO P) (Δ h : ℕ)
    (hb : DegreeHeightBounded P Δ h)
    (prim : (V → V → Prop) → (V → Bool) → Equiv.Perm V) (hprim : PrimSpec Δ h prim)
    (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1 / 2)
    (f : V → ℝ) (hf : ∀ x, f x ∈ Set.Icc (-1 : ℝ) 1)
    (α : ℝ) (hα : ∃ m : V → ℝ, IsMonotoneOn P m ∧ l1Dist f m ≤ α) :
    IsMonotoneOn P (outputLabel P prim ε f) ∧
    (∀ x, outputLabel P prim ε f x ∈ Set.Icc (-1 : ℝ) 1) ∧
    l1Dist f (outputLabel P prim ε f) ≤ 2 * α + 3 * ε := by
  sorry

end TCSChallenge.AgnosticProperLearningOf.node_05
