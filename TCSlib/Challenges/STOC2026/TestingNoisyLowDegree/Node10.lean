/-!
## Constant-sample noisy sparsity testing at or above the sparsity gap

Setting as in node_09, but labels are `y = r(x) + η` with independent noise `η`. If every
sparsity-gap value `t` (pairs `p, q` with `sparsity p ≤ s`, `sparsity q = t`,
`p(X^{⊗k}) =ᵈ q(X^{⊗k})`) satisfies `t ≤ T`, then there is a tester whose number of samples
`m` depends only on `X, d, η, s, T, K, ε` and not on `n`.

Main theorem `constant_sample_noisy_tester`. Lemma stubs: the two supplied prior results
(coarse tester, noisy moment estimation), dimension-free moment stability, a truncation lemma,
and the uniform moment separation that turns the threshold into a quantitative margin.
-/

namespace TCSChallenge.TestingNoisyLowDegree.node_10

/-! ## Shared definitions (byte-identical in node_09 and node_10) -/

/-- "a finitely supported real random variable X": atoms `val i` with probabilities `wt i`. -/
structure FinRV (ℓ : ℕ) where
  val : Fin ℓ → ℝ
  wt : Fin ℓ → ℝ

/-- "`E[X] = 0`, `Var(X) = 1`", atoms distinct and of positive probability. -/
def FinRV.IsStandard {ℓ : ℕ} (X : FinRV ℓ) : Prop :=
  Function.Injective X.val ∧ (∀ i, 0 < X.wt i) ∧ (∑ i, X.wt i) = 1 ∧
    (∑ i, X.wt i * X.val i) = 0 ∧ (∑ i, X.wt i * X.val i ^ 2) = 1

/-- Probability of the atom tuple `x` under the product distribution `X^{⊗ι}`. -/
def prodWt {ℓ : ℕ} (X : FinRV ℓ) {ι : Type} [Fintype ι] (x : ι → Fin ℓ) : ℝ :=
  ∏ j, X.wt (x j)

/-- "`r(x) = ∑_{A ⊆ [n]} r̂(A) ∏_{i ∈ A} x_i`": a multilinear polynomial as its coefficients. -/
abbrev MLPoly (n : ℕ) : Type := Finset (Fin n) → ℝ

/-- "degree at most `d`": no coefficient on a set of size `> d`. -/
def DegLE {n : ℕ} (d : ℕ) (r : MLPoly n) : Prop :=
  ∀ A : Finset (Fin n), d < A.card → r A = 0

/-- Evaluation of `r` at the point whose `i`-th coordinate is the atom `X.val (x i)`. -/
def evalML {ℓ n : ℕ} (X : FinRV ℓ) (r : MLPoly n) (x : Fin n → Fin ℓ) : ℝ :=
  ∑ A : Finset (Fin n), r A * ∏ i ∈ A, X.val (x i)

/-- "`sparsity(r) = #{A : r̂(A) ≠ 0}`". -/
def sparsity {n : ℕ} (r : MLPoly n) : ℕ :=
  (Finset.univ.filter (fun A => r A ≠ 0)).card

/-- "`‖r‖_coeff = (∑_A r̂(A)²)^{1/2}`". -/
def coeffNorm {n : ℕ} (r : MLPoly n) : ℝ :=
  Real.sqrt (∑ A, r A ^ 2)

/-- "`dist(r, T-sparse) ≥ ε`": every degree-`≤ d`, `T`-sparse `u` has
`‖r - u‖_coeff ≥ ε ‖r‖_coeff` (the min of the relative distance is at least `ε`). -/
def FarFromSparse {n : ℕ} (d T : ℕ) (ε : ℝ) (r : MLPoly n) : Prop :=
  ∀ u : MLPoly n, DegLE d u → sparsity u ≤ T → ε * coeffNorm r ≤ coeffNorm (r - u)

/-- The promise: degree at most `d` and `1/K ≤ ‖r‖_coeff ≤ K`. -/
def InPromise {n : ℕ} (d : ℕ) (K : ℝ) (r : MLPoly n) : Prop :=
  DegLE d r ∧ 1 / K ≤ coeffNorm r ∧ coeffNorm r ≤ K

/-- The law of `r(X^{⊗n})`: probability mass at `y`. -/
def outLaw {ℓ n : ℕ} (X : FinRV ℓ) (r : MLPoly n) (y : ℝ) : ℝ :=
  ∑ x : Fin n → Fin ℓ, if evalML X r x = y then prodWt X x else 0

/-- "`p(X^{⊗k}) =ᵈ q(X^{⊗k})`". -/
def SameLaw {ℓ k : ℕ} (X : FinRV ℓ) (p q : MLPoly k) : Prop :=
  ∀ y : ℝ, outLaw X p y = outLaw X q y

/-- `t` is realised as a sparsity gap: for some arity `k` there are degree-`≤ d` polynomials
`p, q` with `sparsity p ≤ s`, `sparsity q = t` and equal output laws. -/
def IsGapValue {ℓ : ℕ} (X : FinRV ℓ) (d s t : ℕ) : Prop :=
  ∃ (k : ℕ) (p q : MLPoly k), DegLE d p ∧ DegLE d q ∧ sparsity p ≤ s ∧ sparsity q = t ∧
    SameLaw X p q

/-- "`Max-Sparsity-Gap_{X,d}(s)`": the largest gap value (reference only). -/
def maxSparsityGap {ℓ : ℕ} (X : FinRV ℓ) (d s : ℕ) : ℕ :=
  sSup {t : ℕ | IsGapValue X d s t}

/-- A (randomized) tester on `m` labelled samples: its acceptance probability given the inputs
`xs` and the labels `ys`. -/
abbrev Tester (ℓ n m : ℕ) : Type := (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → ℝ

/-- Acceptance probabilities lie in `[0,1]`. -/
def IsValidTester {ℓ n m : ℕ} (A : Tester ℓ n m) : Prop :=
  ∀ xs ys, 0 ≤ A xs ys ∧ A xs ys ≤ 1

/-- Measurability in the (noisy, real-valued) labels. -/
def LabelMeasurable {ℓ n m : ℕ} (A : Tester ℓ n m) : Prop :=
  ∀ xs, Measurable (A xs)

/-- Acceptance probability on noiseless samples `(x, r(x))`, `x ∼ X^{⊗n}` i.i.d. -/
def noiselessAccept {ℓ n m : ℕ} (X : FinRV ℓ) (A : Tester ℓ n m) (r : MLPoly n) : ℝ :=
  ∑ xs : Fin m → Fin n → Fin ℓ, (∏ t, prodWt X (xs t)) * A xs (fun t => evalML X r (xs t))

/-- Acceptance probability on noisy samples `(x, r(x) + η)`, noise i.i.d. with law `η`. -/
def noisyAccept {ℓ n m : ℕ} (X : FinRV ℓ) (η : Measure ℝ) (A : Tester ℓ n m)
    (r : MLPoly n) : ℝ :=
  ∑ xs : Fin m → Fin n → Fin ℓ, (∏ t, prodWt X (xs t)) *
    ∫ e, A xs (fun t => evalML X r (xs t) + e t) ∂(Measure.pi fun _ : Fin m => η)

/-- The noiseless `(X,d,0,s,T,ε)` sparsity-testing guarantee. -/
def SolvesNoiseless {ℓ n m : ℕ} (X : FinRV ℓ) (d s T : ℕ) (K ε : ℝ) (A : Tester ℓ n m) :
    Prop :=
  (∀ r : MLPoly n, InPromise d K r → sparsity r ≤ s → 9 / 10 ≤ noiselessAccept X A r) ∧
  (∀ r : MLPoly n, InPromise d K r → FarFromSparse d T ε r → noiselessAccept X A r ≤ 1 / 10)

/-- The noisy `(X,d,η,s,T,ε)` sparsity-testing guarantee. -/
def SolvesNoisy {ℓ n m : ℕ} (X : FinRV ℓ) (η : Measure ℝ) (d s T : ℕ) (K ε : ℝ)
    (A : Tester ℓ n m) : Prop :=
  (∀ r : MLPoly n, InPromise d K r → sparsity r ≤ s → 9 / 10 ≤ noisyAccept X η A r) ∧
  (∀ r : MLPoly n, InPromise d K r → FarFromSparse d T ε r → noisyAccept X η A r ≤ 1 / 10)

/-- Place a `k`-variable polynomial on the coordinates `e 0, …, e (k-1)` of `[n]`
(correct as a relabelling when `e` is injective). -/
def embedPoly {k n : ℕ} (e : Fin k → Fin n) (r : MLPoly k) : MLPoly n :=
  fun A => ∑ B : Finset (Fin k), if B.image e = A then r B else 0

/-- `E[r(X^{⊗n})^j]`, the `j`-th noiseless moment. -/
def moment {ℓ n : ℕ} (X : FinRV ℓ) (r : MLPoly n) (j : ℕ) : ℝ :=
  ∑ x : Fin n → Fin ℓ, prodWt X x * evalML X r x ^ j

/-! ## Definitions specific to this row -/

/-- The noise has all absolute moments finite: "`E[|η|^j] < ∞` for every `j`". -/
def AllMomentsFinite (η : Measure ℝ) : Prop :=
  ∀ j : ℕ, Integrable (fun e : ℝ => |e| ^ j) η

/-- Probability, over `m` noisy samples, that the estimator `Est` returns all of the first `k`
moments of `r` to accuracy `τ`. -/
def momentEstSuccess {ℓ n m k : ℕ} (X : FinRV ℓ) (η : Measure ℝ)
    (Est : (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → Fin k → ℝ) (r : MLPoly n) (τ : ℝ) : ℝ :=
  ∑ xs : Fin m → Fin n → Fin ℓ, (∏ t, prodWt X (xs t)) *
    ((Measure.pi fun _ : Fin m => η)
      {e | ∀ i : Fin k,
        |Est xs (fun t => evalML X r (xs t) + e t) i - moment X r ((i : ℕ) + 1)| ≤ τ}).toReal

/-! ## Rubric lemma stubs -/

/-- Prior result 1 (coarse tester): for every `δ > 0` there is a level `Υ` and an
`n`-independent number of samples distinguishing `s`-sparse polynomials from those with
`dist_Υ ≥ δ`. [TestingNoisyLowDegree, node_10] -/
theorem coarse_tester {ℓ : ℕ} (X : FinRV ℓ) (hX : X.IsStandard) (η : Measure ℝ)
    [IsProbabilityMeasure η] (hη : AllMomentsFinite η) (d s : ℕ) (K : ℝ) (hK : 1 ≤ K)
    (δ : ℝ) (hδ : 0 < δ) :
    ∃ Υ m : ℕ, ∀ n : ℕ, ∃ A : Tester ℓ n m, IsValidTester A ∧ LabelMeasurable A ∧
      SolvesNoisy X η d s Υ K δ A := by
  sorry

/-- Prior result 2 (noisy moment estimation): the first `k` noiseless moments can be estimated
to accuracy `τ` with failure probability `≤ β` from `n`-independently many noisy samples. [TestingNoisyLowDegree, node_10] -/
theorem moment_estimation {ℓ : ℕ} (X : FinRV ℓ) (hX : X.IsStandard) (η : Measure ℝ)
    [IsProbabilityMeasure η] (hη : AllMomentsFinite η) (d : ℕ) (K : ℝ) (hK : 1 ≤ K)
    (k : ℕ) (τ β : ℝ) (hτ : 0 < τ) (hβ : 0 < β) :
    ∃ m : ℕ, ∀ n : ℕ, ∃ Est : (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → Fin k → ℝ,
      (∀ xs i, Measurable (fun ys => Est xs ys i)) ∧
      ∀ r : MLPoly n, InPromise d K r → 1 - β ≤ momentEstSuccess X η Est r τ := by
  sorry

/-- Dimension-free stability of the first `k` moments under coefficient perturbation. [TestingNoisyLowDegree, node_10] -/
theorem moment_stability {ℓ : ℕ} (X : FinRV ℓ) (hX : X.IsStandard) (d : ℕ) (K : ℝ)
    (hK : 1 ≤ K) (k : ℕ) (γ : ℝ) (hγ : 0 < γ) :
    ∃ ε' > 0, ∀ (n : ℕ) (r u : MLPoly n), InPromise d K r → DegLE d u →
      coeffNorm (r - u) ≤ ε' * coeffNorm r →
        ∀ j ≤ k, |moment X r j - moment X u j| ≤ γ := by
  sorry

/-- Truncation/normalisation: an input `ε`-far from `T`-sparse that is `ε'`-close to `u`
(`ε' ≤ min(ε/4, 1/2)`) yields `u` with norm in `[1/(2K), 2K]`, still `ε/2`-far from `T`-sparse. [TestingNoisyLowDegree, node_10] -/
theorem near_coarse_sparse_transfer {n : ℕ} (d T : ℕ) (K ε ε' : ℝ) (hK : 1 ≤ K)
    (hε : 0 < ε) (hε' : 0 < ε') (hε'ε : ε' ≤ ε / 4) (hε'1 : ε' ≤ 1 / 2)
    (r u : MLPoly n) (hr : InPromise d K r) (hfar : FarFromSparse d T ε r) (hu : DegLE d u)
    (hclose : coeffNorm (r - u) ≤ ε' * coeffNorm r) :
    1 / (2 * K) ≤ coeffNorm u ∧ coeffNorm u ≤ 2 * K ∧ FarFromSparse d T (ε / 2) u := by
  sorry

/-- Uniform moment separation (compactness + threshold): for every coarse level `Υ`, finitely
many moments separate, with an `n`-independent margin `γ`, every promised `s`-sparse polynomial
from every norm-controlled `Υ`-sparse polynomial that is `ε/2`-far from `T`-sparse. [TestingNoisyLowDegree, node_10] -/
theorem uniform_moment_separation {ℓ : ℕ} (X : FinRV ℓ) (hX : X.IsStandard) (d s T : ℕ)
    (K ε : ℝ) (hK : 1 ≤ K) (hε : 0 < ε) (hT : ∀ t : ℕ, IsGapValue X d s t → t ≤ T) (Υ : ℕ) :
    ∃ k : ℕ, ∃ γ > 0, ∀ (n : ℕ) (p u : MLPoly n), InPromise d K p → sparsity p ≤ s →
      DegLE d u → sparsity u ≤ Υ → 1 / (2 * K) ≤ coeffNorm u → coeffNorm u ≤ 2 * K →
      FarFromSparse d T (ε / 2) u →
        ∃ j < k, γ ≤ |moment X p (j + 1) - moment X u (j + 1)| := by
  sorry

/-! ## Main theorem -/

/-- **Constant-sample tester at or above the sparsity gap.** If every sparsity-gap value is at
most `T` (i.e. `T ≥ G_{X,d}(s)`), then one sample size `m`, depending only on
`X, d, η, s, T, K, ε`, suffices for the noisy sparsity-testing problem in every dimension `n`. [TestingNoisyLowDegree, node_10] -/
theorem constant_sample_noisy_tester {ℓ : ℕ} (X : FinRV ℓ) (hX : X.IsStandard)
    (η : Measure ℝ) [IsProbabilityMeasure η] (hη : AllMomentsFinite η)
    (d s T : ℕ) (K ε : ℝ) (hK : 1 ≤ K) (hε : 0 < ε)
    (hT : ∀ t : ℕ, IsGapValue X d s t → t ≤ T) :
    ∃ m : ℕ, ∀ n : ℕ, ∃ A : Tester ℓ n m, IsValidTester A ∧ LabelMeasurable A ∧
      SolvesNoisy X η d s T K ε A := by
  sorry

end TCSChallenge.TestingNoisyLowDegree.node_10
