/-!
## Ω(log n) lower bound for noiseless sparsity testing below the sparsity gap

`X` is a finitely supported real random variable (atoms `val i`, probabilities `wt i > 0`)
with mean `0` and variance `1`. Degree-`≤ d` multilinear polynomials in `n` variables are
coefficient functions `Finset (Fin n) → ℝ` vanishing on sets of size `> d`. A tester sees `m`
i.i.d. labelled samples `(x, r(x))`, `x ∼ X^{⊗n}`, and must accept `s`-sparse polynomials and
reject polynomials `ε`-far (relative coefficient distance) from `T`-sparse ones, both with
probability `≥ 9/10`, under the promise `1/K ≤ ‖r‖_coeff ≤ K`.

Main theorem `sparsity_testing_log_lower_bound`: if some pair `p, q` of degree-`≤ d`
polynomials with `sparsity p ≤ s`, `sparsity q = t > T` has `p(X^{⊗k}) =ᵈ q(X^{⊗k})`, then there
is an `n`-independent `ε > 0` and `c > 0` such that no tester with `m ≤ c log n` samples solves the
problem for large `n`.
-/

namespace TCSChallenge.TestingNoisyLowDegree.node_09

/-! ## Shared definitions (byte-identical in node_09 and node_10) -/

/-- "a finitely supported real random variable X": atoms `val i` with probabilities `wt i`. -/
structure FinRV (ℓ : ℕ) where
  val : Fin ℓ → ℝ
  wt : Fin ℓ → ℝ

/-- "`E[X] = 0`, `Var(X) = 1`", atoms distinct and of positive probability. -/
def FinRV.IsStandard {ℓ : ℕ} (X : FinRV ℓ) : Prop :=
  Function.Injective X.val ∧ (∀ i, 0 < X.wt i) ∧ (∑ i, X.wt i) = 1 ∧
    (∑ i, X.wt i * X.val i) = 0 ∧ (∑ i, X.wt i * X.val i ^ 2) = 1

/-- Probability of the atom tuple `x` under the product distribution `X^{⊗ι}`. -/
def prodWt {ℓ : ℕ} (X : FinRV ℓ) {ι : Type} [Fintype ι] (x : ι → Fin ℓ) : ℝ :=
  ∏ j, X.wt (x j)

/-- "`r(x) = ∑_{A ⊆ [n]} r̂(A) ∏_{i ∈ A} x_i`": a multilinear polynomial as its coefficients. -/
abbrev MLPoly (n : ℕ) : Type := Finset (Fin n) → ℝ

/-- "degree at most `d`": no coefficient on a set of size `> d`. -/
def DegLE {n : ℕ} (d : ℕ) (r : MLPoly n) : Prop :=
  ∀ A : Finset (Fin n), d < A.card → r A = 0

/-- Evaluation of `r` at the point whose `i`-th coordinate is the atom `X.val (x i)`. -/
def evalML {ℓ n : ℕ} (X : FinRV ℓ) (r : MLPoly n) (x : Fin n → Fin ℓ) : ℝ :=
  ∑ A : Finset (Fin n), r A * ∏ i ∈ A, X.val (x i)

/-- "`sparsity(r) = #{A : r̂(A) ≠ 0}`". -/
def sparsity {n : ℕ} (r : MLPoly n) : ℕ :=
  (Finset.univ.filter (fun A => r A ≠ 0)).card

/-- "`‖r‖_coeff = (∑_A r̂(A)²)^{1/2}`". -/
def coeffNorm {n : ℕ} (r : MLPoly n) : ℝ :=
  Real.sqrt (∑ A, r A ^ 2)

/-- "`dist(r, T-sparse) ≥ ε`": every degree-`≤ d`, `T`-sparse `u` has
`‖r - u‖_coeff ≥ ε ‖r‖_coeff` (the min of the relative distance is at least `ε`). -/
def FarFromSparse {n : ℕ} (d T : ℕ) (ε : ℝ) (r : MLPoly n) : Prop :=
  ∀ u : MLPoly n, DegLE d u → sparsity u ≤ T → ε * coeffNorm r ≤ coeffNorm (r - u)

/-- The promise: degree at most `d` and `1/K ≤ ‖r‖_coeff ≤ K`. -/
def InPromise {n : ℕ} (d : ℕ) (K : ℝ) (r : MLPoly n) : Prop :=
  DegLE d r ∧ 1 / K ≤ coeffNorm r ∧ coeffNorm r ≤ K

/-- The law of `r(X^{⊗n})`: probability mass at `y`. -/
def outLaw {ℓ n : ℕ} (X : FinRV ℓ) (r : MLPoly n) (y : ℝ) : ℝ :=
  ∑ x : Fin n → Fin ℓ, if evalML X r x = y then prodWt X x else 0

/-- "`p(X^{⊗k}) =ᵈ q(X^{⊗k})`". -/
def SameLaw {ℓ k : ℕ} (X : FinRV ℓ) (p q : MLPoly k) : Prop :=
  ∀ y : ℝ, outLaw X p y = outLaw X q y

/-- `t` is realised as a sparsity gap: for some arity `k` there are degree-`≤ d` polynomials
`p, q` with `sparsity p ≤ s`, `sparsity q = t` and equal output laws. -/
def IsGapValue {ℓ : ℕ} (X : FinRV ℓ) (d s t : ℕ) : Prop :=
  ∃ (k : ℕ) (p q : MLPoly k), DegLE d p ∧ DegLE d q ∧ sparsity p ≤ s ∧ sparsity q = t ∧
    SameLaw X p q

/-- "`Max-Sparsity-Gap_{X,d}(s)`": the largest gap value (reference only). -/
def maxSparsityGap {ℓ : ℕ} (X : FinRV ℓ) (d s : ℕ) : ℕ :=
  sSup {t : ℕ | IsGapValue X d s t}

/-- A (randomized) tester on `m` labelled samples: its acceptance probability given the inputs
`xs` and the labels `ys`. -/
abbrev Tester (ℓ n m : ℕ) : Type := (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → ℝ

/-- Acceptance probabilities lie in `[0,1]`. -/
def IsValidTester {ℓ n m : ℕ} (A : Tester ℓ n m) : Prop :=
  ∀ xs ys, 0 ≤ A xs ys ∧ A xs ys ≤ 1

/-- Measurability in the (noisy, real-valued) labels. -/
def LabelMeasurable {ℓ n m : ℕ} (A : Tester ℓ n m) : Prop :=
  ∀ xs, Measurable (A xs)

/-- Acceptance probability on noiseless samples `(x, r(x))`, `x ∼ X^{⊗n}` i.i.d. -/
def noiselessAccept {ℓ n m : ℕ} (X : FinRV ℓ) (A : Tester ℓ n m) (r : MLPoly n) : ℝ :=
  ∑ xs : Fin m → Fin n → Fin ℓ, (∏ t, prodWt X (xs t)) * A xs (fun t => evalML X r (xs t))

/-- Acceptance probability on noisy samples `(x, r(x) + η)`, noise i.i.d. with law `η`. -/
def noisyAccept {ℓ n m : ℕ} (X : FinRV ℓ) (η : Measure ℝ) (A : Tester ℓ n m)
    (r : MLPoly n) : ℝ :=
  ∑ xs : Fin m → Fin n → Fin ℓ, (∏ t, prodWt X (xs t)) *
    ∫ e, A xs (fun t => evalML X r (xs t) + e t) ∂(Measure.pi fun _ : Fin m => η)

/-- The noiseless `(X,d,0,s,T,ε)` sparsity-testing guarantee. -/
def SolvesNoiseless {ℓ n m : ℕ} (X : FinRV ℓ) (d s T : ℕ) (K ε : ℝ) (A : Tester ℓ n m) :
    Prop :=
  (∀ r : MLPoly n, InPromise d K r → sparsity r ≤ s → 9 / 10 ≤ noiselessAccept X A r) ∧
  (∀ r : MLPoly n, InPromise d K r → FarFromSparse d T ε r → noiselessAccept X A r ≤ 1 / 10)

/-- The noisy `(X,d,η,s,T,ε)` sparsity-testing guarantee. -/
def SolvesNoisy {ℓ n m : ℕ} (X : FinRV ℓ) (η : Measure ℝ) (d s T : ℕ) (K ε : ℝ)
    (A : Tester ℓ n m) : Prop :=
  (∀ r : MLPoly n, InPromise d K r → sparsity r ≤ s → 9 / 10 ≤ noisyAccept X η A r) ∧
  (∀ r : MLPoly n, InPromise d K r → FarFromSparse d T ε r → noisyAccept X η A r ≤ 1 / 10)

/-- Place a `k`-variable polynomial on the coordinates `e 0, …, e (k-1)` of `[n]`
(correct as a relabelling when `e` is injective). -/
def embedPoly {k n : ℕ} (e : Fin k → Fin n) (r : MLPoly k) : MLPoly n :=
  fun A => ∑ B : Finset (Fin k), if B.image e = A then r B else 0

/-- `E[r(X^{⊗n})^j]`, the `j`-th noiseless moment. -/
def moment {ℓ n : ℕ} (X : FinRV ℓ) (r : MLPoly n) (j : ℕ) : ℝ :=
  ∑ x : Fin n → Fin ℓ, prodWt X x * evalML X r x ^ j

/-! ## Definitions specific to this row -/

/-- `B` disjoint ordered blocks of size `k` in `[n]`, covering all but fewer than `k`
coordinates (so `B = ⌊n/k⌋`). -/
def IsBlockFamily {k n B : ℕ} (e : Fin B → Fin k → Fin n) : Prop :=
  (∀ b, Function.Injective (e b)) ∧ (∀ b b', b ≠ b' → ∀ j j', e b j ≠ e b' j') ∧
    n < k * (B + 1)

/-- Acceptance probability under the hard prior "pick a block `b` uniformly and plant `p`
on it". -/
def blockAvgAccept {ℓ k n m B : ℕ} (X : FinRV ℓ) (A : Tester ℓ n m)
    (e : Fin B → Fin k → Fin n) (p : MLPoly k) : ℝ :=
  (∑ b, noiselessAccept X A (embedPoly (e b) p)) / B

/-! ## Rubric lemma stubs -/

/-- For mean-0, variance-1 product inputs, `E[r(X^{⊗n})²] = ‖r‖²_coeff`. [TestingNoisyLowDegree, node_09] -/
theorem moment_two_eq_coeffNorm_sq {ℓ n : ℕ} (X : FinRV ℓ) (hX : X.IsStandard)
    (r : MLPoly n) : moment X r 2 = coeffNorm r ^ 2 := by
  sorry

/-- A shared scaling preserves equality of output laws. [TestingNoisyLowDegree, node_09] -/
theorem sameLaw_smul {ℓ k : ℕ} (X : FinRV ℓ) (p q : MLPoly k) (h : SameLaw X p q) (a : ℝ) :
    SameLaw X (a • p) (a • q) := by
  sorry

/-- Witnesses with equal output laws have equal coefficient norms (second moments agree). [TestingNoisyLowDegree, node_09] -/
theorem coeffNorm_eq_of_sameLaw {ℓ k : ℕ} (X : FinRV ℓ) (hX : X.IsStandard) (p q : MLPoly k)
    (h : SameLaw X p q) : coeffNorm p = coeffNorm q := by
  sorry

/-- Injective embedding preserves degree, sparsity and coefficient norm. [TestingNoisyLowDegree, node_09] -/
theorem embedPoly_props {k n : ℕ} (d : ℕ) (e : Fin k → Fin n) (he : Function.Injective e)
    (r : MLPoly k) (hr : DegLE d r) :
    DegLE d (embedPoly e r) ∧ sparsity (embedPoly e r) = sparsity r ∧
      coeffNorm (embedPoly e r) = coeffNorm r := by
  sorry

/-- Coefficient truncation: if `T < sparsity q`, then the relative distance of any embedded
copy of `q` from `T`-sparse is at least a fixed `ε > 0` (the norm of its `sparsity q - T`
smallest coefficients, relative to `‖q‖`), independent of `n`. [TestingNoisyLowDegree, node_09] -/
theorem far_of_sparsity_gt {k : ℕ} (d T : ℕ) (q : MLPoly k) (hq : DegLE d q)
    (hT : T < sparsity q) :
    ∃ ε > 0, ∀ (n : ℕ) (e : Fin k → Fin n), Function.Injective e →
      FarFromSparse d T ε (embedPoly e q) := by
  sorry

/-- Central quantitative estimate: under the two block-planted priors the full labelled
transcripts are `δ`-close (tested against every `[0,1]`-valued tester) once
`m ≤ c log n`, with `c > 0` depending only on `X` and `k`. [TestingNoisyLowDegree, node_09] -/
theorem blockMixture_indistinguishable {ℓ k : ℕ} (X : FinRV ℓ) (hX : X.IsStandard)
    (p q : MLPoly k) (hpq : SameLaw X p q) :
    ∃ c > 0, ∀ δ > 0, ∃ N : ℕ, ∀ n ≥ N, ∀ (B : ℕ) (e : Fin B → Fin k → Fin n),
      IsBlockFamily e → ∀ m : ℕ, (m : ℝ) ≤ c * Real.log n →
        ∀ A : Tester ℓ n m, IsValidTester A →
          |blockAvgAccept X A e p - blockAvgAccept X A e q| ≤ δ := by
  sorry

/-! ## Main theorem -/

/-- **Ω(log n) lower bound below the sparsity gap.** If `T < t` for some sparsity-gap value
`t` (i.e. `T ≤ G - 1`), then for some `n`-independent `ε > 0`, every tester for the noiseless
`(X,d,0,s,T,ε)` sparsity-testing problem needs more than `c log n` samples. [TestingNoisyLowDegree, node_09] -/
theorem sparsity_testing_log_lower_bound {ℓ : ℕ} (X : FinRV ℓ) (hX : X.IsStandard)
    (d s T : ℕ) (K : ℝ) (hK : 1 ≤ K) (hgap : ∃ t : ℕ, T < t ∧ IsGapValue X d s t) :
    ∃ ε > 0, ∃ c > 0, ∃ N : ℕ, ∀ n ≥ N, ∀ m : ℕ, (m : ℝ) ≤ c * Real.log n →
      ∀ A : Tester ℓ n m, IsValidTester A → ¬ SolvesNoiseless X d s T K ε A := by
  sorry

