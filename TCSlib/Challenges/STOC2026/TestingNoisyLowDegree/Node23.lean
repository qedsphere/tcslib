/-!
## Hidden coordinates force `Ω(log n)` samples

`X` has atoms indexed by `Fin ℓ` with probabilities `wt i ≥ α > 0`. Two functions
`p, q : S^k → ℝ` have the same output law `𝒪` under `X^{⊗k}`. For a coordinate tuple
`i ∈ [n]^k` the target `r_{p,i}(x) = p(x_{i_1}, …, x_{i_k})`. An algorithm sees `m` i.i.d.
examples `(x, r(x))`, `x ∼ X^{⊗n}`, for one fixed unknown target, and must decide between
`H_p` (some `r_{p,i}`) and `H_q` (some `r_{q,i}`) with success `≥ 2/3` on every target.

Main theorem `hidden_coordinates_log_lower_bound`: there are `c = c_{k,ℓ,α} > 0` and `N` such
that no algorithm with `m ≤ c log n` examples succeeds for `n ≥ N`.
-/

namespace TCSChallenge.TestingNoisyLowDegree.node_23

/-- Probability of the atom tuple `x` under the product distribution `X^{⊗ι}`. -/
def tupleWt {ℓ : ℕ} (wt : Fin ℓ → ℝ) {ι : Type} [Fintype ι] (x : ι → Fin ℓ) : ℝ :=
  ∏ j, wt (x j)

/-- The law `𝒪` of `p(X^{⊗k})`: its mass at `y`. -/
def funLaw {ℓ k : ℕ} (wt : Fin ℓ → ℝ) (p : (Fin k → Fin ℓ) → ℝ) (y : ℝ) : ℝ :=
  ∑ z : Fin k → Fin ℓ, if p z = y then tupleWt wt z else 0

/-- "`r_{p,𝐢}(x) = p(x_{i_1}, …, x_{i_k})`". -/
def plant {ℓ k n : ℕ} (p : (Fin k → Fin ℓ) → ℝ) (idx : Fin k → Fin n) :
    (Fin n → Fin ℓ) → ℝ :=
  fun x => p (x ∘ idx)

/-- Acceptance probability ("answer `H_p`") of the decision rule `A` on `m` i.i.d. labelled
examples of the target `r`. -/
def acceptProb {ℓ n m : ℕ} (wt : Fin ℓ → ℝ) (A : (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → ℝ)
    (r : (Fin n → Fin ℓ) → ℝ) : ℝ :=
  ∑ xs : Fin m → Fin n → Fin ℓ, (∏ t, tupleWt wt (xs t)) * A xs (fun t => r (xs t))

/-- Benchmark experiment: inputs `x ∼ X^{⊗n}` as usual, labels drawn i.i.d. from `𝒪`
(the law of `p(X^{⊗k})`) independently of the inputs. -/
def refAccept {ℓ k n m : ℕ} (wt : Fin ℓ → ℝ) (A : (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → ℝ)
    (p : (Fin k → Fin ℓ) → ℝ) : ℝ :=
  ∑ xs : Fin m → Fin n → Fin ℓ, (∏ t, tupleWt wt (xs t)) *
    ∑ zs : Fin m → Fin k → Fin ℓ, (∏ t, tupleWt wt (zs t)) * A xs (fun t => p (zs t))

/-- `B` disjoint ordered blocks of size `k` in `[n]`, covering all but fewer than `k`
coordinates (so `B = ⌊n/k⌋`). -/
def IsBlockFamily {k n B : ℕ} (e : Fin B → Fin k → Fin n) : Prop :=
  (∀ b, Function.Injective (e b)) ∧ (∀ b b', b ≠ b' → ∀ j j', e b j ≠ e b' j') ∧
    n < k * (B + 1)

/-- Acceptance probability under the hard prior "pick a block uniformly, plant `p` on it". -/
def blockAvgAccept {ℓ k n m B : ℕ} (wt : Fin ℓ → ℝ)
    (A : (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → ℝ) (e : Fin B → Fin k → Fin n)
    (p : (Fin k → Fin ℓ) → ℝ) : ℝ :=
  (∑ b, acceptProb wt A (plant p (e b))) / B

/-! ## Rubric lemma stubs -/

/-- The benchmark depends on `p` only through its output law, so it is common to `H_p`, `H_q`. [TestingNoisyLowDegree, node_23] -/
theorem refAccept_eq_of_sameLaw {ℓ k n m : ℕ} (wt : Fin ℓ → ℝ)
    (A : (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → ℝ) (p q : (Fin k → Fin ℓ) → ℝ)
    (hpq : ∀ y, funLaw wt p y = funLaw wt q y) :
    refAccept wt A p = refAccept wt A q := by
  sorry

/-- Central estimate (conditional empirical word histogram + concentration + union bound over
at most `ℓ^{km}` words of mass `≥ α^{km}`): the block-planted transcript is `δ`-close to the
independent-label benchmark, against every `[0,1]`-valued rule, once `m ≤ c log n`; `c` depends
only on `k, ℓ, α`. [TestingNoisyLowDegree, node_23] -/
theorem blockMixture_close_to_reference (k ℓ : ℕ) (hk : 1 ≤ k) (α : ℝ) (hα : 0 < α) :
    ∃ c > 0, ∀ δ > 0, ∃ N : ℕ, ∀ (wt : Fin ℓ → ℝ), (∀ i, α ≤ wt i) → (∑ i, wt i) = 1 →
      ∀ p : (Fin k → Fin ℓ) → ℝ, ∀ n ≥ N, ∀ (B : ℕ) (e : Fin B → Fin k → Fin n),
        IsBlockFamily e → ∀ m : ℕ, (m : ℝ) ≤ c * Real.log n →
          ∀ A : (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → ℝ,
            (∀ xs ys, 0 ≤ A xs ys ∧ A xs ys ≤ 1) →
              |blockAvgAccept wt A e p - refAccept wt A p| ≤ δ := by
  sorry

/-! ## Main theorem -/

/-- **Hidden coordinates force `Ω(log n)` samples.** For `m ≤ c_{k,ℓ,α} log n` and large `n`,
no `[0,1]`-valued decision rule accepts every `r_{p,𝐢}` with probability `≥ 2/3` and every
`r_{q,𝐢}` with probability `≤ 1/3`. [TestingNoisyLowDegree, node_23] -/
theorem hidden_coordinates_log_lower_bound (k ℓ : ℕ) (hk : 1 ≤ k) (α : ℝ) (hα : 0 < α) :
    ∃ c > 0, ∃ N : ℕ, ∀ (wt : Fin ℓ → ℝ), (∀ i, α ≤ wt i) → (∑ i, wt i) = 1 →
      ∀ p q : (Fin k → Fin ℓ) → ℝ, (∀ y, funLaw wt p y = funLaw wt q y) →
        ∀ n : ℕ, N ≤ n → k ≤ n → ∀ m : ℕ, (m : ℝ) ≤ c * Real.log n →
          ∀ A : (Fin m → Fin n → Fin ℓ) → (Fin m → ℝ) → ℝ,
            (∀ xs ys, 0 ≤ A xs ys ∧ A xs ys ≤ 1) →
              ¬ ((∀ idx : Fin k → Fin n, 2 / 3 ≤ acceptProb wt A (plant p idx)) ∧
                 (∀ idx : Fin k → Fin n, acceptProb wt A (plant q idx) ≤ 1 / 3)) := by
  sorry

