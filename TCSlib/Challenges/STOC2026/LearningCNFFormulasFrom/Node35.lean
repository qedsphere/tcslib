/-!
## Exact learning of random k-CNF formulas from uniform solutions (Valiant's elimination)

Variables are `Fin n`, a literal is a pair `(j, b)` (true iff `x_j = b`), a sampled clause is
an ordered `k`-tuple of literals drawn with replacement, and the random formula `Φ` is a
uniformly random element of `Fin m → Fin k → Fin n × Bool` with `m = ⌊α n⌋`. Repeated
literals and tautologies need no special treatment: a clause is satisfied iff some entry is.
Each drawn pair `(j, b)` is read as the TCSlib literal `toLiteral (j, b) : Literal n` (with
`neg := !b`) and evaluated with `Literal.eval`; the pair encoding is kept for the sample
space because `Literal n` has no `Fintype` instance at the pin.

Valiant's learner keeps every candidate width-`k` clause on distinct variables that no sample
falsifies; it succeeds when the satisfying set of the surviving conjunction equals `Sat(Φ)`.
Samples are a uniform tuple in `Sat(Φ)^T`, so success probabilities are counting ratios.

Main theorem `valiant_learns_random_kcnf`: for `k ≥ 10^5` and the density condition, there are
`C` and `ε` with `n ε(n) → 0` such that, for all large `n`, with probability `≥ 1 - ε(n)` over
`Φ`, `Φ` is satisfiable and for every `δ ∈ (0,1)` and every `T ≥ C n^{exp(-√k)} ln(n/δ)` the
learner succeeds with probability `≥ 1 - δ` over the samples.
-/

namespace TCSChallenge.LearningCNFFormulasFrom.node_35

/-- A drawn literal over `{x_1,…,x_n}` as a pair: `(j, true)` is `x_j`, `(j, false)` is `¬x_j`.
Kept as a pair (rather than TCSlib's `Literal n`) so that the formula space is a `Fintype`. -/
abbrev Lit (n : ℕ) : Type := Fin n × Bool

/-- The TCSlib literal denoted by a drawn pair: `(j, b)` is `x_j` if `b` and `¬x_j` otherwise. -/
def toLiteral {n : ℕ} (l : Lit n) : Literal n := ⟨l.1, !l.2⟩

/-- An assignment in `{0,1}^V`. -/
abbrev Assignment (n : ℕ) : Type := Fin n → Bool

/-- A sampled clause: "each of the `m` clauses [is formed] from `k` independent draws, with
replacement, from `{x_j, ¬x_j}`". -/
abbrev SampledClause (n k : ℕ) : Type := Fin k → Lit n

/-- A sampled formula `Φ = (V, C)` with `m` clauses. -/
abbrev Formula (n k m : ℕ) : Type := Fin m → SampledClause n k

/-- A clause is satisfied iff one of its drawn literals is true (repeated literals are thus
simplified and a sampled tautology is always satisfied). -/
def clauseSat {n k : ℕ} (x : Assignment n) (c : SampledClause n k) : Prop :=
  ∃ j : Fin k, (toLiteral (c j)).eval x = true

/-- `Sat(Φ) ⊆ {0,1}^V`, the satisfying assignments. -/
def Sat {n k m : ℕ} (Φ : Formula n k m) : Finset (Assignment n) :=
  Finset.univ.filter (fun x => ∀ i : Fin m, clauseSat x (Φ i))

/-- A sampled clause is a tautology if it contains both `x_j` and `¬x_j`. -/
def IsTautology {n k : ℕ} (c : SampledClause n k) : Prop :=
  ∃ j j' : Fin k, (c j).1 = (c j').1 ∧ (c j).2 ≠ (c j').2

/-- The set of variables of a sampled clause. -/
def clauseVars {n k : ℕ} (c : SampledClause n k) : Finset (Fin n) :=
  Finset.univ.image (fun j : Fin k => (c j).1)

/-- "The width of a non-tautological sampled clause is its number of distinct variables after
simplification." -/
def width {n k : ℕ} (c : SampledClause n k) : ℕ := (clauseVars c).card

/-- An (ordered) candidate clause: variables `(v_1,…,v_k)` and signs; the clause is
`⋁_i (x_{v_i} = s_i)`. It is a genuine candidate when the variables are distinct. -/
abbrev Candidate (n k : ℕ) : Type := (Fin k → Fin n) × (Fin k → Bool)

/-- "every non-tautological width-`k` clause on distinct variables". -/
def candidates (n k : ℕ) : Finset (Candidate n k) :=
  Finset.univ.filter (fun d : Candidate n k => Function.Injective d.1)

/-- `x` satisfies the candidate clause `d`. -/
def candSat {n k : ℕ} (x : Assignment n) (d : Candidate n k) : Prop :=
  ∃ i : Fin k, x (d.1 i) = d.2 i

/-- `x` falsifies `d`, i.e. `(x_{v_1},…,x_{v_k}) = a(d)` where `a(d)_i = ¬ s_i` is the unique
falsifying pattern. -/
def Falsifies {n k : ℕ} (x : Assignment n) (d : Candidate n k) : Prop :=
  ∀ i : Fin k, x (d.1 i) = !(d.2 i)

/-- Number of solutions agreeing with the falsifying pattern `a(d)` on the first `j`
variables of `d`. -/
def prefixCount {n k m : ℕ} (Φ : Formula n k m) (d : Candidate n k) (j : ℕ) : ℕ :=
  ((Sat Φ).filter (fun x => ∀ i : Fin k, (i : ℕ) < j → x (d.1 i) = !(d.2 i))).card

/-- `q_Φ(d) = P_{X∼μ_Φ}[(X_{v_1},…,X_{v_k}) = a(d)]` (real quotient; `0` if `Sat Φ = ∅`). -/
def q {n k m : ℕ} (Φ : Formula n k m) (d : Candidate n k) : ℝ :=
  (prefixCount Φ d k : ℝ) / ((Sat Φ).card : ℝ)

/-- The conditional step probability
`p_i(d) = P_{μ_Φ}[X_{v_i} = a_i | X_{v_1} = a_1, …, X_{v_{i-1}} = a_{i-1}]`
(real quotient, `0/0 = 0`). -/
def condStep {n k m : ℕ} (Φ : Formula n k m) (d : Candidate n k) (i : Fin k) : ℝ :=
  (prefixCount Φ d ((i : ℕ) + 1) : ℝ) / (prefixCount Φ d (i : ℕ) : ℝ)

/-- Valiant's elimination learner: the candidates falsified by no sample. -/
def survivors {n k T : ℕ} (X : Fin T → Assignment n) : Finset (Candidate n k) :=
  (candidates n k).filter (fun d => ∀ t : Fin T, ¬ Falsifies (X t) d)

/-- `Sat(Φ̂)` for the learner's output `Φ̂ = ⋀ survivors`. -/
def hypSat {n T : ℕ} (k : ℕ) (X : Fin T → Assignment n) : Finset (Assignment n) :=
  Finset.univ.filter (fun x => ∀ d ∈ survivors (k := k) X, candSat x d)

/-- Probability over `X^{(1)},…,X^{(T)} ∼ μ_Φ` i.i.d. that the learner exactly learns `Φ`,
i.e. `Sat(Φ̂) = Sat(Φ)`; computed as a ratio of counts in `Sat(Φ)^T`. -/
def sampleSuccessProb {n k m : ℕ} (Φ : Formula n k m) (T : ℕ) : ℝ :=
  ((Finset.univ.filter (fun X : Fin T → Assignment n =>
      (∀ t : Fin T, X t ∈ Sat Φ) ∧ hypSat k X = Sat Φ)).card : ℝ) /
    ((Sat Φ).card : ℝ) ^ T

/-- Probability of an event over the uniformly random formula. -/
def formulaProb {n k m : ℕ} (P : Formula n k m → Prop) : ℝ :=
  ((Finset.univ.filter P).card : ℝ) / (Fintype.card (Formula n k m) : ℝ)

/-- The positive-mass gap: every candidate has `q_Φ(d) = 0` or `q_Φ(d) ≥ θ`. -/
def GapProperty {n k m : ℕ} (Φ : Formula n k m) (θ : ℝ) : Prop :=
  ∀ d ∈ candidates n k, q Φ d = 0 ∨ θ ≤ q Φ d

/-- `θ_k(n) = 8^{-k} n^{-exp(-√k)}`. -/
def theta (k n : ℕ) : ℝ :=
  ((1 : ℝ) / 8) ^ k * (n : ℝ) ^ (-Real.exp (-Real.sqrt (k : ℝ)))

/-- The sufficient density condition `0 < α ≤ 2^{k-30k^{4/5} log₂ k}/(2^{10} e^2 k^8)`. -/
def DensityOK (k : ℕ) (α : ℝ) : Prop :=
  0 < α ∧
    α ≤ (2 : ℝ) ^ ((k : ℝ) - 30 * (k : ℝ) ^ ((4 : ℝ) / 5) * Real.logb 2 (k : ℝ)) /
      (2 ^ 10 * Real.exp 2 * (k : ℝ) ^ 8)

/-- `o(1/n)`: `n · ε(n) → 0`. -/
def LittleOInvN (ε : ℕ → ℝ) : Prop :=
  Filter.Tendsto (fun n : ℕ => (n : ℝ) * ε n) Filter.atTop (nhds 0)

/-! ## Lemma stubs -/

/-- Routine collision estimate: with probability `1 - o(1/n)`, every non-tautological clause
has width `≥ k - 2` and distinct clauses share at most `3` variables. [LearningCNFFormulasFrom, node_35] -/
theorem collision_estimates (k : ℕ) (α : ℝ) (hk : 100000 ≤ k) (hα : DensityOK k α) :
    ∃ ε : ℕ → ℝ, LittleOInvN ε ∧ ∀ᶠ n : ℕ in Filter.atTop,
      1 - ε n ≤ formulaProb (n := n) (k := k) (m := ⌊α * n⌋₊) (fun Φ =>
        (∀ i, ¬ IsTautology (Φ i) → k - 2 ≤ width (Φ i)) ∧
        (∀ i j, i ≠ j → (clauseVars (Φ i) ∩ clauseVars (Φ j)).card ≤ 3)) := by
  sorry

/-- Chain rule: `q_Φ(d) = ∏_i p_i(d)` (for satisfiable `Φ`). [LearningCNFFormulasFrom, node_35] -/
theorem q_eq_prod_condStep {n k m : ℕ} (Φ : Formula n k m) (hSat : (Sat Φ).Nonempty)
    (d : Candidate n k) :
    q Φ d = ∏ i : Fin k, condStep Φ d i := by
  sorry

/-- Conditional local-probability bound (the core, obtained from the structural event via the
conditional-law-preserving reveal and bounded-component peeling, `ζ_k k / 2 = k^{4/5}`):
with probability `1 - o(1/n)` over `Φ`, `Φ` is satisfiable and every candidate with positive
mass satisfies `p_i(d) ≥ (1/8)(1 - 2^{-(k^{4/5}-2)})^{ln n}` at every step `i`. [LearningCNFFormulasFrom, node_35] -/
theorem condStep_lower_bound_whp (k : ℕ) (α : ℝ) (hk : 100000 ≤ k) (hα : DensityOK k α) :
    ∃ ε : ℕ → ℝ, LittleOInvN ε ∧ ∀ᶠ n : ℕ in Filter.atTop,
      1 - ε n ≤ formulaProb (n := n) (k := k) (m := ⌊α * n⌋₊) (fun Φ =>
        (Sat Φ).Nonempty ∧
        ∀ d ∈ candidates n k, 0 < q Φ d → ∀ i : Fin k,
          (1 / 8 : ℝ) * (1 - (2 : ℝ) ^ (-((k : ℝ) ^ ((4 : ℝ) / 5) - 2))) ^ Real.log (n : ℝ)
            ≤ condStep Φ d i) := by
  sorry

/-- Exponent arithmetic: `8^{-k}(1 - 2^{-(k^{4/5}-2)})^{k ln n} ≥ 8^{-k} n^{-exp(-√k)}`. [LearningCNFFormulasFrom, node_35] -/
theorem exponent_arithmetic (k n : ℕ) (hk : 100000 ≤ k) (hn : 1 ≤ n) :
    theta k n ≤
      ((1 : ℝ) / 8) ^ k *
        ((1 - (2 : ℝ) ^ (-((k : ℝ) ^ ((4 : ℝ) / 5) - 2))) ^ Real.log (n : ℝ)) ^ k := by
  sorry

/-- The uniform positive-mass gap `q_Φ(d) = 0 ∨ q_Φ(d) ≥ θ_k(n)`, with probability
`1 - o(1/n)` over `Φ`. [LearningCNFFormulasFrom, node_35] -/
theorem gap_whp (k : ℕ) (α : ℝ) (hk : 100000 ≤ k) (hα : DensityOK k α) :
    ∃ ε : ℕ → ℝ, LittleOInvN ε ∧ ∀ᶠ n : ℕ in Filter.atTop,
      1 - ε n ≤ formulaProb (n := n) (k := k) (m := ⌊α * n⌋₊) (fun Φ =>
        (Sat Φ).Nonempty ∧ GapProperty Φ (theta k n)) := by
  sorry

/-- Width normalization: replacing each (width `≤ k`) clause by all its width-`k` completions
does not change `Sat(Φ)`; hence `Sat(Φ)` is exactly the set cut out by the forced candidates
(those with `q_Φ(d) = 0`). [LearningCNFFormulasFrom, node_35] -/
theorem sat_eq_forced_candidates {n k m : ℕ} (Φ : Formula n k m) (hkn : k ≤ n)
    (hSat : (Sat Φ).Nonempty) (x : Assignment n) :
    x ∈ Sat Φ ↔ ∀ d ∈ candidates n k, q Φ d = 0 → candSat x d := by
  sorry

/-- Elimination union bound: on the gap event, the learner fails with probability at most
`(2n)^k exp(-T θ)` over the samples. [LearningCNFFormulasFrom, node_35] -/
theorem elimination_union_bound {n k m : ℕ} (Φ : Formula n k m) (hkn : k ≤ n)
    (hSat : (Sat Φ).Nonempty) (θ : ℝ) (hθ : 0 < θ) (hgap : GapProperty Φ θ) (T : ℕ) :
    1 - (2 * (n : ℝ)) ^ k * Real.exp (-(T : ℝ) * θ) ≤ sampleSuccessProb Φ T := by
  sorry

/-! ## Main theorem -/

/-- **Main theorem.** For `k ≥ 10^5` and `α` in the local lemma regime, there are `C = C(k, α)`
and `ε = o(1/n)` such that for all large `n`, with probability `≥ 1 - ε(n)` over the random
`k`-CNF `Φ` with `⌊α n⌋` clauses, `Φ` is satisfiable and Valiant's learner, given any
`T ≥ C n^{exp(-√k)} ln(n/δ)` uniform samples, exactly learns `Sat(Φ)` with probability
`≥ 1 - δ` over the samples, for every `δ ∈ (0, 1)`. [LearningCNFFormulasFrom, node_35] -/
theorem valiant_learns_random_kcnf (k : ℕ) (α : ℝ) (hk : 100000 ≤ k) (hα : DensityOK k α) :
    ∃ C : ℝ, 0 < C ∧ ∃ ε : ℕ → ℝ, LittleOInvN ε ∧ ∀ᶠ n : ℕ in Filter.atTop,
      1 - ε n ≤ formulaProb (n := n) (k := k) (m := ⌊α * n⌋₊) (fun Φ =>
        (Sat Φ).Nonempty ∧
        ∀ δ : ℝ, 0 < δ → δ < 1 → ∀ T : ℕ,
          C * (n : ℝ) ^ Real.exp (-Real.sqrt (k : ℝ)) * Real.log ((n : ℝ) / δ) ≤ (T : ℝ) →
            1 - δ ≤ sampleSuccessProb Φ T) := by
  sorry

