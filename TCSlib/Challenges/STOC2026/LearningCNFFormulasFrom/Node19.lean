/-!
## An `Ω_k(log n)` sample lower bound for exactly learning `(k,1,0)`-CNFs

A `(k,1,0)`-CNF is a `k`-CNF (clauses of exactly `k` literals on distinct variables) in which
every variable occurs in at most one clause. A learner receives `T` i.i.d. samples from the
uniform distribution `μ_Φ` on satisfying assignments and must output a Boolean function equal
to the one defined by `Φ`.

Literals are TCSlib's `Literal n` (true at `x` iff `Literal.eval` returns `true`). Clauses and
formulas stay `Finset`s (`FClause`, `FCNF`), because clause width and variable degree are
counted with set semantics; the names avoid TCSlib's list-based root `Clause` / `CNF`.

Main theorem `main`: for every `k ≥ 2` there are `c_k > 0` and `n₀(k)` such that for every
`n ≥ n₀(k)` and every learner using `T ≤ c_k ln n` samples, some `n`-variable `(k,1,0)`-CNF is
learned with probability `< 1/3`.
-/

namespace TCSChallenge.LearningCNFFormulasFrom.node_19

/-- A clause: a finite set of TCSlib literals `Literal n` (a disjunction). -/
abbrev FClause (n : ℕ) := Finset (Literal n)

/-- A CNF formula: a finite set of clauses (a conjunction). -/
abbrev FCNF (n : ℕ) := Finset (FClause n)

/-- A Boolean assignment to the `n` variables. -/
abbrev Assignment (n : ℕ) := Fin n → Bool

/-- `vbl(c)`: the set of variables occurring in clause `c`. -/
def vbl {n : ℕ} (c : FClause n) : Finset (Fin n) := c.image Literal.var

/-- The literals of `c` involve pairwise distinct variables. -/
def DistinctVars {n : ℕ} (c : FClause n) : Prop := (vbl c).card = c.card

/-- "A `k`-clause is a disjunction of `k` literals involving `k` distinct Boolean variables." -/
def IsKClause {n : ℕ} (k : ℕ) (c : FClause n) : Prop := c.card = k ∧ DistinctVars c

/-- `x` satisfies the clause `c` (some literal of `c` is true at `x`). -/
def ClauseSat {n : ℕ} (x : Assignment n) (c : FClause n) : Prop := ∃ l ∈ c, l.eval x = true

/-- `x` satisfies every clause of `Φ`. -/
def CNFSat {n : ℕ} (x : Assignment n) (Φ : FCNF n) : Prop := ∀ c ∈ Φ, ClauseSat x c

/-- The set of satisfying assignments of `Φ` (the support of `μ_Φ`). -/
def solutions {n : ℕ} (Φ : FCNF n) : Finset (Assignment n) :=
  Finset.univ.filter (fun x => CNFSat x Φ)

/-- Number of clauses of `Φ` in which variable `v` occurs. -/
def degree {n : ℕ} (Φ : FCNF n) (v : Fin n) : ℕ := (Φ.filter (fun c => v ∈ vbl c)).card

/-- "A `(k,1,0)`-CNF is a `k`-CNF in which every variable occurs in at most one clause." -/
def IsK10CNF {n : ℕ} (k : ℕ) (Φ : FCNF n) : Prop :=
  (∀ c ∈ Φ, IsKClause k c) ∧ ∀ v, degree Φ v ≤ 1

/-- Boolean functions on `n` variables (the learner's output space). -/
abbrev BoolFun (n : ℕ) := Assignment n → Bool

/-- The Boolean function defined by `Φ`. -/
def cnfFun {n : ℕ} (Φ : FCNF n) : BoolFun n := fun x => decide (CNFSat x Φ)

/-- A randomized learner with `T` samples: for each sample tuple, a distribution
(probability vector) over output Boolean functions. -/
abbrev Learner (T n : ℕ) := (Fin T → Assignment n) → BoolFun n → ℝ

/-- The learner's output vectors are probability distributions. -/
def ValidLearner {T n : ℕ} (L : Learner T n) : Prop :=
  (∀ X f, 0 ≤ L X f) ∧ ∀ X, ∑ f, L X f = 1

/-- Exact-learning probability of `L` on target `Φ`: samples are `T` i.i.d. draws from `μ_Φ`
(a uniform tuple in `(solutions Φ)^T`), success means outputting `cnfFun Φ`. -/
def learnerSuccessProb {T n : ℕ} (L : Learner T n) (Φ : FCNF n) : ℝ :=
  (∑ X ∈ (Finset.univ : Finset (Fin T → Assignment n)).filter
      (fun X => ∀ t, X t ∈ solutions Φ), L X (cnfFun Φ)) /
    (((solutions Φ).card : ℕ) : ℝ) ^ T

/-- The variable `x_{j,i}` (block `j ∈ [k]`, position `i ∈ [m]`) among the first `k·m`
variables of `Fin n`. -/
def blockVar {k m n : ℕ} (hm : k * m ≤ n) (j : Fin k) (i : Fin m) : Fin n :=
  Fin.castLE hm (finProdFinEquiv (j, i))

/-- The hard formula `Φ_σ = ⋀_{i} (x_{1,σ₁(i)} ∨ ⋯ ∨ x_{k,σ_k(i)})` (all literals positive,
i.e. `neg := false`); the reference normalizes one permutation to the identity, leaving `k-1`
free permutations. -/
def hardCNF {k m n : ℕ} (hm : k * m ≤ n) (σ : Fin k → Equiv.Perm (Fin m)) : FCNF n :=
  Finset.univ.image (fun i : Fin m =>
    Finset.univ.image (fun j : Fin k =>
      ({ var := blockVar hm j (σ j i), neg := false } : Literal n)))

/-- Rubric 1: every member of the hard family is a satisfiable `(k,1,0)`-CNF. [LearningCNFFormulasFrom, node_19] -/
theorem hardCNF_isK10 {k m n : ℕ} (hm : k * m ≤ n) (σ : Fin k → Equiv.Perm (Fin m)) :
    IsK10CNF k (hardCNF hm σ) ∧ (solutions (hardCNF hm σ)).Nonempty := by
  sorry

/-- Rubric 2: normalized members (`σ j₀ = 1`) with different permutation tuples define
different Boolean functions; hence the family has `(m!)^{k-1}` semantically distinct members. [LearningCNFFormulasFrom, node_19] -/
theorem hardCNF_distinct {k m n : ℕ} (hm : k * m ≤ n) (j₀ : Fin k)
    (σ τ : Fin k → Equiv.Perm (Fin m)) (hσ : σ j₀ = 1) (hτ : τ j₀ = 1) (hne : σ ≠ τ) :
    cnfFun (hardCNF hm σ) ≠ cnfFun (hardCNF hm τ) := by
  sorry

/-- Rubrics 3–4 (Fano-type recovery inequality with information budget `T n ln 2`): for a
family of `M ≥ 2` satisfiable formulas defining pairwise distinct functions, the average
exact-learning probability of any learner is at most `(T n ln 2 + ln 2) / ln M`. [LearningCNFFormulasFrom, node_19] -/
theorem fano_average {n T : ℕ} (ι : Type) [Fintype ι] (hι : 2 ≤ Fintype.card ι)
    (F : ι → FCNF n) (hsat : ∀ i, (solutions (F i)).Nonempty)
    (hdist : ∀ i j, i ≠ j → cnfFun (F i) ≠ cnfFun (F j))
    (L : Learner T n) (hL : ValidLearner L) :
    (∑ i, learnerSuccessProb L (F i)) / (Fintype.card ι : ℝ) ≤
      ((T : ℝ) * (n : ℝ) * Real.log 2 + Real.log 2) / Real.log (Fintype.card ι : ℝ) := by
  sorry

/-- Rubric 5 (asymptotics): `ln(m!) ≥ m ln(m/e)` for `m ≥ 1`. [LearningCNFFormulasFrom, node_19] -/
theorem log_factorial_ge (m : ℕ) (hm : 1 ≤ m) :
    (m : ℝ) * Real.log ((m : ℝ) / Real.exp 1) ≤ Real.log (Nat.factorial m : ℝ) := by
  sorry

/-- Main theorem. For every `k ≥ 2` there are `c_k > 0` and `n₀(k)` such that for all
`n ≥ n₀(k)`, every (valid, randomized) learner using `T ≤ c_k ln n` samples fails, with
probability `> 2/3`, to exactly learn some `n`-variable `(k,1,0)`-CNF. [LearningCNFFormulasFrom, node_19] -/
theorem main (k : ℕ) (hk : 2 ≤ k) :
    ∃ c : ℝ, 0 < c ∧ ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n → ∀ T : ℕ, (T : ℝ) ≤ c * Real.log (n : ℝ) →
      ∀ L : Learner T n, ValidLearner L →
        ∃ Φ : FCNF n, IsK10CNF k Φ ∧ learnerSuccessProb L Φ < 1 / 3 := by
  sorry

end TCSChallenge.LearningCNFFormulasFrom.node_19
