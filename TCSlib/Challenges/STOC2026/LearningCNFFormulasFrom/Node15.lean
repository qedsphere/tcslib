/-!
## Exact learning of `(k,d,k^{1-η})`-CNFs by clause elimination

A `k`-clause is a disjunction of `k` literals on `k` distinct variables. A `(k,d,s)`-CNF has
only `k`-clauses, every variable in at most `d` clauses, and any two distinct clauses share at
most `s` variables. `μ_Φ` is the uniform distribution on satisfying assignments.

Literals are TCSlib's `Literal n` (evaluated by `Literal.eval`); clauses and formulas are
finite sets of them (`FClause`, `FCNF`), since widths and degrees are counted as set sizes.

The elimination algorithm starts with all `k`-clauses on the `n` variables, deletes every
clause falsified by some sample, and outputs the conjunction of the survivors.

Main theorem `main`: for `η ∈ (0,1)` and `s = k^{1-η}` there are `K_η` and `r_η(k) = o(k)`
such that for `k ≥ K_η` and `k ≥ log₂ d + r_η(k)`, every `(k,d,s)`-CNF is exactly learned
(output logically equivalent to `Φ`) with probability `≥ 1 - δ` from
`T = O_{k,η}(log(n/δ))` samples.
-/

namespace TCSChallenge.LearningCNFFormulasFrom.node_15

/-- A clause: a finite set of TCSlib literals `Literal n` (a disjunction). Kept as a `Finset`
rather than TCSlib's list-based `Clause`, because clause width is counted by `Finset.card`. -/
abbrev FClause (n : ℕ) := Finset (Literal n)

/-- A CNF formula: a finite set of clauses (a conjunction). Kept as a `Finset` rather than
TCSlib's list-based `CNF`, because variable degrees count distinct clauses. -/
abbrev FCNF (n : ℕ) := Finset (FClause n)

/-- The literal `(v, b)`, true at `x` iff `x v = b`, as a TCSlib `Literal` (`neg := !b`). -/
def toLit {n : ℕ} (p : Fin n × Bool) : Literal n := ⟨p.1, !p.2⟩

/-- A Boolean assignment to the `n` variables. -/
abbrev Assignment (n : ℕ) := Fin n → Bool

/-- `vbl(c)`: the set of variables occurring in clause `c`. -/
def vbl {n : ℕ} (c : FClause n) : Finset (Fin n) := c.image Literal.var

/-- The literals of `c` involve pairwise distinct variables. -/
def DistinctVars {n : ℕ} (c : FClause n) : Prop := (vbl c).card = c.card

/-- "A `k`-clause is a disjunction of `k` literals involving `k` distinct Boolean variables." -/
def IsKClause {n : ℕ} (k : ℕ) (c : FClause n) : Prop := c.card = k ∧ DistinctVars c

/-- `x` satisfies the clause `c` (some literal of `c` is true at `x`). -/
def ClauseSat {n : ℕ} (x : Assignment n) (c : FClause n) : Prop := ∃ l ∈ c, l.eval x = true

/-- `x` satisfies every clause of `Φ`. -/
def CNFSat {n : ℕ} (x : Assignment n) (Φ : FCNF n) : Prop := ∀ c ∈ Φ, ClauseSat x c

/-- The set of satisfying assignments of `Φ` (the support of `μ_Φ`). -/
def solutions {n : ℕ} (Φ : FCNF n) : Finset (Assignment n) :=
  Finset.univ.filter (fun x => CNFSat x Φ)

/-- Number of clauses of `Φ` in which variable `v` occurs. -/
def degree {n : ℕ} (Φ : FCNF n) (v : Fin n) : ℕ := (Φ.filter (fun c => v ∈ vbl c)).card

/-- "A `(k,d,s)`-CNF: every clause is a `k`-clause, every variable occurs in at most `d`
clauses, and any two distinct clauses share at most `s` variables." -/
def IsKDSCNF {n : ℕ} (k d : ℕ) (s : ℝ) (Φ : FCNF n) : Prop :=
  (∀ c ∈ Φ, IsKClause k c) ∧ (∀ v, degree Φ v ≤ d) ∧
    (∀ c ∈ Φ, ∀ c' ∈ Φ, c ≠ c' → (((vbl c ∩ vbl c').card : ℕ) : ℝ) ≤ s)

/-- The supplied local-uniformity lemma: if `Ψ` has clause sizes in `[a, k]` with `a > 0`
(distinct variables in each clause), every variable in at most `d` clauses, and
`2^a ≥ 2e·d·k`, then `Ψ` is satisfiable and for a uniform satisfying assignment `Y`,
`max_b Pr[Y_v = b] ≤ exp(1/k)/2` for every variable `v`. -/
def LocalUniformityFact : Prop :=
  ∀ (n : ℕ) (Ψ : FCNF n) (a k d : ℕ), 1 ≤ a →
    (∀ c ∈ Ψ, DistinctVars c ∧ a ≤ c.card ∧ c.card ≤ k) →
    (∀ v, degree Ψ v ≤ d) →
    2 * Real.exp 1 * (d : ℝ) * (k : ℝ) ≤ (2 : ℝ) ^ a →
    (solutions Ψ).Nonempty ∧
      ∀ (v : Fin n) (b : Bool),
        ((((solutions Ψ).filter (fun x => x v = b)).card : ℕ) : ℝ) ≤
          Real.exp (1 / (k : ℝ)) / 2 * (((solutions Ψ).card : ℕ) : ℝ)

/-- All `k`-clauses on the variables `Fin n` (the initial list of the algorithm). Every
`Finset (Literal n)` is the image under the bijection `toLit` of a set of pairs, so this is the
set of all `k`-clauses. -/
def allKClauses (n k : ℕ) : Finset (FClause n) :=
  ((Finset.univ : Finset (Finset (Fin n × Bool))).image (fun c => c.image toLit)).filter
    (fun c : FClause n => IsKClause k c)

/-- Output of the elimination algorithm on samples `X 0, …, X (T-1)`: the conjunction of all
`k`-clauses not falsified by any sample. -/
def eliminationOutput (n k T : ℕ) (X : Fin T → Assignment n) : FCNF n :=
  (allKClauses n k).filter (fun c => ∀ t, ClauseSat (X t) c)

/-- Two formulas are logically equivalent: same satisfying assignments. -/
def LogicallyEquiv {n : ℕ} (Φ Ψ : FCNF n) : Prop := ∀ x, CNFSat x Φ ↔ CNFSat x Ψ

/-- Probability, over `T` independent samples from `μ_Φ`, that the elimination algorithm
exactly learns `Φ`: the fraction of tuples in `(solutions Φ)^T` whose output is logically
equivalent to `Φ`. -/
def eliminationSuccessProb {n : ℕ} (k T : ℕ) (Φ : FCNF n) : ℝ :=
  ((((Finset.univ : Finset (Fin T → Assignment n)).filter
      (fun X => (∀ t, X t ∈ solutions Φ) ∧
        LogicallyEquiv (eliminationOutput n k T X) Φ)).card : ℕ) : ℝ) /
    (((solutions Φ).card : ℕ) : ℝ) ^ T

/-- `Pr_{X ∼ μ_Φ}[X violates c]`. -/
def violationProb {n : ℕ} (Φ : FCNF n) (c : FClause n) : ℝ :=
  ((((solutions Φ).filter (fun x => ¬ ClauseSat x c)).card : ℕ) : ℝ) /
    (((solutions Φ).card : ℕ) : ℝ)

/-- The reference's explicit slack `r_η(k) = log₂ k + log₂(2e) + L + p` with `p = k^{η/2}`
and `L = k/p + p·s/2 = (3/2) k^{1-η/2}`. -/
def rEta (η : ℝ) (k : ℕ) : ℝ :=
  Real.logb 2 (k : ℝ) + Real.logb 2 (2 * Real.exp 1) +
    (3 / 2) * (k : ℝ) ^ (1 - η / 2) + (k : ℝ) ^ (η / 2)

/-- Rubric 1 (large-overlap bound). If sets `S i ⊆ W`, `|W| = k ≥ 1`, all have size at least
`L = k/p + p·s/2` and pairwise intersect in at most `s` elements, then there are at most `p`
of them. [LearningCNFFormulasFrom, node_15] -/
theorem large_overlap_card_le {α : Type} [DecidableEq α] (W : Finset α) (ι : Finset ℕ)
    (S : ℕ → Finset α) (p s : ℝ) (hp : 1 ≤ p) (hs : 0 ≤ s) (hW : 0 < W.card)
    (hsub : ∀ i ∈ ι, S i ⊆ W)
    (hlarge : ∀ i ∈ ι, (W.card : ℝ) / p + p * s / 2 ≤ ((S i).card : ℝ))
    (hpair : ∀ i ∈ ι, ∀ j ∈ ι, i ≠ j → (((S i ∩ S j).card : ℕ) : ℝ) ≤ s) :
    (ι.card : ℝ) ≤ p := by
  sorry

/-- Rubric 2 (auxiliary pinning). Let `W` be a `k`-set of variables and `F` a family of
`k`-clauses, none with variable set `W`, pairwise sharing at most `s` variables, with
`|F| ≤ p` and `p(1 + s/2) < k`. Then the greedy procedure succeeds: some set of at most `|F|`
variables outside `W`, with values `τ`, satisfies every clause of `F`. [LearningCNFFormulasFrom, node_15] -/
theorem greedy_pinning {n : ℕ} (k : ℕ) (W : Finset (Fin n)) (hW : W.card = k)
    (F : Finset (FClause n)) (p s : ℝ) (hs : 0 ≤ s)
    (hF : ∀ c ∈ F, IsKClause k c) (hne : ∀ c ∈ F, vbl c ≠ W)
    (hpair : ∀ c ∈ F, ∀ c' ∈ F, c ≠ c' → (((vbl c ∩ vbl c').card : ℕ) : ℝ) ≤ s)
    (hFp : (F.card : ℝ) ≤ p) (hpk : p * (1 + s / 2) < (k : ℝ)) :
    ∃ (P : Finset (Fin n)) (τ : Assignment n),
      Disjoint P W ∧ P.card ≤ F.card ∧ ∀ c ∈ F, ∃ l ∈ c, l.var ∈ P ∧ l.eval τ = true := by
  sorry

/-- Rubric 3 (conditional probability gap). With the explicit `r_η`, for all large `k`, every
`k`-clause not in a `(k,d,k^{1-η})`-CNF `Φ` is violated with probability at least
`θ = (1 - exp(1/k)/2)^{k + k^{η/2}}` under `μ_Φ`. [LearningCNFFormulasFrom, node_15] -/
theorem probability_gap (hLU : LocalUniformityFact) (η : ℝ) (hη0 : 0 < η) (hη1 : η < 1) :
    ∃ K : ℕ, ∀ k : ℕ, K ≤ k → ∀ (d n : ℕ) (Φ : FCNF n),
      Real.logb 2 (d : ℝ) + rEta η k ≤ (k : ℝ) →
      IsKDSCNF k d ((k : ℝ) ^ (1 - η)) Φ →
      (solutions Φ).Nonempty ∧
      ∀ c : FClause n, IsKClause k c → c ∉ Φ →
        (1 - Real.exp (1 / (k : ℝ)) / 2) ^ ((k : ℝ) + (k : ℝ) ^ (η / 2)) ≤ violationProb Φ c := by
  sorry

/-- Rubric 4 (learning correctness and samples). If `Φ` is a satisfiable formula of
`k`-clauses and every `k`-clause outside `Φ` has violation probability at least `θ > 0`, then
`T ≥ (k ln(2n) + ln(1/δ))/θ` samples make the elimination output equivalent to `Φ` with
probability at least `1 - δ`. [LearningCNFFormulasFrom, node_15] -/
theorem learning_of_gap {n : ℕ} (k : ℕ) (Φ : FCNF n) (θ : ℝ) (hθ : 0 < θ)
    (hsat : (solutions Φ).Nonempty) (hk : ∀ c ∈ Φ, IsKClause k c)
    (hgap : ∀ c : FClause n, IsKClause k c → c ∉ Φ → θ ≤ violationProb Φ c)
    (δ : ℝ) (hδ0 : 0 < δ) (hδ1 : δ < 1) (T : ℕ)
    (hT : ((k : ℝ) * Real.log (2 * (n : ℝ)) + Real.log (1 / δ)) / θ ≤ (T : ℝ)) :
    1 - δ ≤ eliminationSuccessProb k T Φ := by
  sorry

/-- Rubric 5 (asymptotic condition): the explicit `r_η(k)` is `o(k)`. [LearningCNFFormulasFrom, node_15] -/
theorem rEta_isLittleO (η : ℝ) (hη0 : 0 < η) (hη1 : η < 1) :
    Filter.Tendsto (fun k : ℕ => rEta η k / (k : ℝ)) Filter.atTop (nhds 0) := by
  sorry

/-- Main theorem. For `η ∈ (0,1)` and `s = k^{1-η}` there are `K_η` and `r_η(k) = o(k)`
such that for `k ≥ K_η` with `k ≥ log₂ d + r_η(k)`, there is `B = B(k,η)` so that every
`(k,d,s)`-CNF on `n` variables is exactly learned by elimination with probability at least
`1 - δ` from any `T ≥ B · ln(n/δ)` samples. [LearningCNFFormulasFrom, node_15] -/
theorem main (hLU : LocalUniformityFact) (η : ℝ) (hη0 : 0 < η) (hη1 : η < 1) :
    ∃ (K : ℕ) (r : ℕ → ℝ),
      Filter.Tendsto (fun k : ℕ => r k / (k : ℝ)) Filter.atTop (nhds 0) ∧
      ∀ k : ℕ, K ≤ k → ∃ B : ℝ, ∀ (d n : ℕ) (Φ : FCNF n),
        Real.logb 2 (d : ℝ) + r k ≤ (k : ℝ) →
        IsKDSCNF k d ((k : ℝ) ^ (1 - η)) Φ →
        ∀ δ : ℝ, 0 < δ → δ < 1 → ∀ T : ℕ,
          B * Real.log ((n : ℝ) / δ) ≤ (T : ℝ) →
          1 - δ ≤ eliminationSuccessProb k T Φ := by
  sorry

end TCSChallenge.LearningCNFFormulasFrom.node_15
