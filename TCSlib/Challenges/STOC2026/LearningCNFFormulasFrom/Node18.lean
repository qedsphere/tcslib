/-!
## Exact learning of `(k,d,ζk)`-CNFs by clause elimination

A `(k,d,s)`-CNF has only `k`-clauses (on `k` distinct variables), every variable in at most
`d` clauses, and any two distinct clauses share at most `s` variables. Valiant's elimination
algorithm starts with all `k`-clauses and deletes those violated by some sample.

Literals are TCSlib's `Literal n` (`var`, `neg`) evaluated by `Literal.eval`. Clauses and
formulas stay finite *sets* (`LitClause`, `LitCNF`) rather than TCSlib's list-based `Clause` and
`CNF`, because clause width and variable degree are counted.

For `ζ ∈ (0,1)` with `s = ζk` an integer, put
`C(ζ) = 1/(1-√(2ζ))` for `ζ < 3 - 2√2` and `C(ζ) = 2/(1-ζ)` otherwise.

Main theorem `main`: there is an absolute `A > 0` such that whenever
`k ≥ C(ζ) log₂ d + A (C(ζ) log₂(4ek) + ζ^{-1/2})`, every `(k,d,ζk)`-CNF is exactly learned with
probability `≥ 1 - δ` from `T = O_{k,ζ}(log(n/δ))` uniform random solutions.
-/

namespace TCSChallenge.LearningCNFFormulasFrom.node_18

/-- A clause: a finite set of TCSlib literals `Literal n` (a disjunction). Kept as a `Finset`
(not TCSlib's list-based `Clause`) because clause width and variable degree are counted. -/
abbrev LitClause (n : ℕ) := Finset (Literal n)

/-- A CNF formula: a finite set of clauses (a conjunction). Kept as a `Finset` (not TCSlib's
list-based `CNF`) because clause counts and degrees use set semantics. -/
abbrev LitCNF (n : ℕ) := Finset (LitClause n)

/-- A Boolean assignment to the `n` variables. -/
abbrev Assignment (n : ℕ) := Fin n → Bool

/-- `vbl(c)`: the set of variables occurring in clause `c`. -/
def vbl {n : ℕ} (c : LitClause n) : Finset (Fin n) := c.image Literal.var

/-- The literals of `c` involve pairwise distinct variables. -/
def DistinctVars {n : ℕ} (c : LitClause n) : Prop := (vbl c).card = c.card

/-- "A `k`-clause is a disjunction of `k` literals involving `k` distinct Boolean variables." -/
def IsKClause {n : ℕ} (k : ℕ) (c : LitClause n) : Prop := c.card = k ∧ DistinctVars c

/-- `x` satisfies the clause `c` (some literal of `c` is true at `x`). -/
def ClauseSat {n : ℕ} (x : Assignment n) (c : LitClause n) : Prop := ∃ l ∈ c, l.eval x = true

/-- `x` satisfies every clause of `Φ`. -/
def CNFSat {n : ℕ} (x : Assignment n) (Φ : LitCNF n) : Prop := ∀ c ∈ Φ, ClauseSat x c

/-- The set of satisfying assignments of `Φ` (the support of `μ_Φ`). -/
def solutions {n : ℕ} (Φ : LitCNF n) : Finset (Assignment n) :=
  Finset.univ.filter (fun x => CNFSat x Φ)

/-- Number of clauses of `Φ` in which variable `v` occurs. -/
def degree {n : ℕ} (Φ : LitCNF n) (v : Fin n) : ℕ := (Φ.filter (fun c => v ∈ vbl c)).card

/-- "A `(k,d,s)`-CNF: every clause is a `k`-clause, every variable occurs in at most `d`
clauses, and any two distinct clauses share at most `s` variables." -/
def IsKDSCNF {n : ℕ} (k d : ℕ) (s : ℝ) (Φ : LitCNF n) : Prop :=
  (∀ c ∈ Φ, IsKClause k c) ∧ (∀ v, degree Φ v ≤ d) ∧
    (∀ c ∈ Φ, ∀ c' ∈ Φ, c ≠ c' → (((vbl c ∩ vbl c').card : ℕ) : ℝ) ≤ s)

/-- The supplied local-uniformity lemma: if `Ψ` has clause sizes in `[a, k]` with `a > 0`
(distinct variables in each clause), every variable in at most `d` clauses, and
`2^a ≥ 2e·d·k`, then `Ψ` is satisfiable and for a uniform satisfying assignment `Y`,
`max_b Pr[Y_v = b] ≤ exp(1/k)/2` for every variable `v`. -/
def LocalUniformityFact : Prop :=
  ∀ (n : ℕ) (Ψ : LitCNF n) (a k d : ℕ), 1 ≤ a →
    (∀ c ∈ Ψ, DistinctVars c ∧ a ≤ c.card ∧ c.card ≤ k) →
    (∀ v, degree Ψ v ≤ d) →
    2 * Real.exp 1 * (d : ℝ) * (k : ℝ) ≤ (2 : ℝ) ^ a →
    (solutions Ψ).Nonempty ∧
      ∀ (v : Fin n) (b : Bool),
        ((((solutions Ψ).filter (fun x => x v = b)).card : ℕ) : ℝ) ≤
          Real.exp (1 / (k : ℝ)) / 2 * (((solutions Ψ).card : ℕ) : ℝ)

/-- All `k`-clauses on the variables `Fin n` (the initial list of the algorithm). Every finite
set of literals is the image of a finite set of pairs `(v, b)` under `(v, b) ↦ ⟨v, b⟩`, so this
ranges over all clauses; the image avoids needing a `Fintype (Literal n)` instance. -/
def allKClauses (n k : ℕ) : Finset (LitClause n) :=
  ((Finset.univ : Finset (Finset (Fin n × Bool))).image
      (fun c => c.image (fun p => (⟨p.1, p.2⟩ : Literal n)))).filter
    (fun c : LitClause n => IsKClause k c)

/-- Output of the elimination algorithm on samples `X 0, …, X (T-1)`: the conjunction of all
`k`-clauses not falsified by any sample. -/
def eliminationOutput (n k T : ℕ) (X : Fin T → Assignment n) : LitCNF n :=
  (allKClauses n k).filter (fun c => ∀ t, ClauseSat (X t) c)

/-- Two formulas are logically equivalent: same satisfying assignments. -/
def LogicallyEquiv {n : ℕ} (Φ Ψ : LitCNF n) : Prop := ∀ x, CNFSat x Φ ↔ CNFSat x Ψ

/-- Probability, over `T` independent samples from `μ_Φ`, that the elimination algorithm
exactly learns `Φ`: the fraction of tuples in `(solutions Φ)^T` whose output is logically
equivalent to `Φ`. -/
def eliminationSuccessProb {n : ℕ} (k T : ℕ) (Φ : LitCNF n) : ℝ :=
  ((((Finset.univ : Finset (Fin T → Assignment n)).filter
      (fun X => (∀ t, X t ∈ solutions Φ) ∧
        LogicallyEquiv (eliminationOutput n k T X) Φ)).card : ℕ) : ℝ) /
    (((solutions Φ).card : ℕ) : ℝ) ^ T

/-- `Pr_{X ∼ μ_Φ}[X violates c]`. -/
def violationProb {n : ℕ} (Φ : LitCNF n) (c : LitClause n) : ℝ :=
  ((((solutions Φ).filter (fun x => ¬ ClauseSat x c)).card : ℕ) : ℝ) /
    (((solutions Φ).card : ℕ) : ℝ)

/-- The leading constant `C(ζ)`: `1/(1-√(2ζ))` for `0 < ζ < 3 - 2√2`, `2/(1-ζ)` otherwise. -/
def Czeta (ζ : ℝ) : ℝ :=
  if ζ < 3 - 2 * Real.sqrt 2 then 1 / (1 - Real.sqrt (2 * ζ)) else 2 / (1 - ζ)

/-- The finite-size hypothesis `k ≥ C(ζ) log₂ d + A (C(ζ) log₂(4ek) + ζ^{-1/2})`. -/
def SizeCondition (A ζ : ℝ) (k d : ℕ) : Prop :=
  Czeta ζ * Real.logb 2 (d : ℝ) +
      A * (Czeta ζ * Real.logb 2 (4 * Real.exp 1 * (k : ℝ)) + ζ ^ (-(1 / 2 : ℝ))) ≤ (k : ℝ)

/-- The probability gap `θ(k,ζ)` of the reference: with `α = 1 - exp(1/k)/2`,
`α^{k + √(2/ζ)}` for `ζ < 3 - 2√2` and `α^{k+1}` otherwise. -/
def thetaGap (k : ℕ) (ζ : ℝ) : ℝ :=
  if ζ < 3 - 2 * Real.sqrt 2 then
    (1 - Real.exp (1 / (k : ℝ)) / 2) ^ ((k : ℝ) + Real.sqrt (2 / ζ))
  else (1 - Real.exp (1 / (k : ℝ)) / 2) ^ ((k : ℝ) + 1)

/-- Rubric 1, part (i): at most one clause meets the candidate set `U` (|U| = k) in more than
`(1+ζ)k/2` variables, when distinct clauses share at most `ζk` variables. [LearningCNFFormulasFrom, node_18] -/
theorem at_most_one_big_clause {n : ℕ} (k : ℕ) (ζ : ℝ) (Φ : LitCNF n)
    (hpair : ∀ c ∈ Φ, ∀ c' ∈ Φ, c ≠ c' → (((vbl c ∩ vbl c').card : ℕ) : ℝ) ≤ ζ * k)
    (U : Finset (Fin n)) (hU : U.card = k) (c₀ c₁ : LitClause n) (h₀ : c₀ ∈ Φ) (h₁ : c₁ ∈ Φ)
    (hb₀ : (1 + ζ) / 2 * (k : ℝ) < (((vbl c₀ ∩ U).card : ℕ) : ℝ))
    (hb₁ : (1 + ζ) / 2 * (k : ℝ) < (((vbl c₁ ∩ U).card : ℕ) : ℝ)) :
    c₀ = c₁ := by
  sorry

/-- Rubric 1, part (ii) (large-overlap bound): if sets `S i ⊆ W`, `|W| = k ≥ 1`, all have size
at least `k/p + p·s/2` and pairwise intersect in at most `s` elements, there are at most `p`
of them (used with `p = √(2/ζ)`, where `k/p + ps/2 = √(2ζ)·k`). [LearningCNFFormulasFrom, node_18] -/
theorem large_overlap_card_le {α : Type} [DecidableEq α] (W : Finset α) (ι : Finset ℕ)
    (S : ℕ → Finset α) (p s : ℝ) (hp : 1 ≤ p) (hs : 0 ≤ s) (hW : 0 < W.card)
    (hsub : ∀ i ∈ ι, S i ⊆ W)
    (hlarge : ∀ i ∈ ι, (W.card : ℝ) / p + p * s / 2 ≤ ((S i).card : ℝ))
    (hpair : ∀ i ∈ ι, ∀ j ∈ ι, i ≠ j → (((S i ∩ S j).card : ℕ) : ℝ) ≤ s) :
    (ι.card : ℝ) ≤ p := by
  sorry

/-- Rubric 1, part (iii) (outside-variable pinning): `k`-clauses none of which has variable set
`W` (|W| = k), pairwise sharing at most `s` variables, with `|F| ≤ p` and `p(1 + s/2) < k`, can
all be satisfied by pinning at most `|F|` variables outside `W`. [LearningCNFFormulasFrom, node_18] -/
theorem greedy_pinning {n : ℕ} (k : ℕ) (W : Finset (Fin n)) (hW : W.card = k)
    (F : Finset (LitClause n)) (p s : ℝ) (hs : 0 ≤ s)
    (hF : ∀ c ∈ F, IsKClause k c) (hne : ∀ c ∈ F, vbl c ≠ W)
    (hpair : ∀ c ∈ F, ∀ c' ∈ F, c ≠ c' → (((vbl c ∩ vbl c').card : ℕ) : ℝ) ≤ s)
    (hFp : (F.card : ℝ) ≤ p) (hpk : p * (1 + s / 2) < (k : ℝ)) :
    ∃ (P : Finset (Fin n)) (τ : Assignment n),
      Disjoint P W ∧ P.card ≤ F.card ∧ ∀ c ∈ F, ∃ l ∈ c, l.var ∈ P ∧ l.eval τ = true := by
  sorry

/-- Rubrics 2–3 (uniform separation): there is an absolute `A > 0` such that under the size
condition every `(k,d,ζk)`-CNF is satisfiable and every `k`-clause not in it is violated with
probability at least `θ(k,ζ) > 0`. [LearningCNFFormulasFrom, node_18] -/
theorem uniform_separation (hLU : LocalUniformityFact) :
    ∃ A : ℝ, 0 < A ∧ ∀ ζ : ℝ, 0 < ζ → ζ < 1 → ∀ (k s d n : ℕ), (s : ℝ) = ζ * k →
      SizeCondition A ζ k d → ∀ Φ : LitCNF n, IsKDSCNF k d (s : ℝ) Φ →
        0 < thetaGap k ζ ∧ (solutions Φ).Nonempty ∧
        ∀ c : LitClause n, IsKClause k c → c ∉ Φ → thetaGap k ζ ≤ violationProb Φ c := by
  sorry

/-- Rubric 4 (exact-learning analysis): a uniform gap `θ` and
`T ≥ (k ln(2n) + ln(1/δ))/θ` give exact learning with probability at least `1 - δ`. [LearningCNFFormulasFrom, node_18] -/
theorem learning_of_gap {n : ℕ} (k : ℕ) (Φ : LitCNF n) (θ : ℝ) (hθ : 0 < θ)
    (hsat : (solutions Φ).Nonempty) (hk : ∀ c ∈ Φ, IsKClause k c)
    (hgap : ∀ c : LitClause n, IsKClause k c → c ∉ Φ → θ ≤ violationProb Φ c)
    (δ : ℝ) (hδ0 : 0 < δ) (hδ1 : δ < 1) (T : ℕ)
    (hT : ((k : ℝ) * Real.log (2 * (n : ℝ)) + Real.log (1 / δ)) / θ ≤ (T : ℝ)) :
    1 - δ ≤ eliminationSuccessProb k T Φ := by
  sorry

/-- The finite-size condition has the form `k ≥ C(ζ) log d + o(k) + O_ζ(1)`: for fixed `ζ`
and `A`, the term `A·C(ζ)·log₂(4ek)` is `o(k)`. [LearningCNFFormulasFrom, node_18] -/
theorem condition_form (A ζ : ℝ) (hζ0 : 0 < ζ) (hζ1 : ζ < 1) :
    Filter.Tendsto
      (fun k : ℕ => A * Czeta ζ * Real.logb 2 (4 * Real.exp 1 * (k : ℝ)) / (k : ℝ))
      Filter.atTop (nhds 0) := by
  sorry

/-- Main theorem. There is an absolute `A > 0` such that for all `ζ ∈ (0,1)` and `k` with
`s = ζk` an integer, there is `B = B(k,ζ)` such that whenever
`k ≥ C(ζ) log₂ d + A (C(ζ) log₂(4ek) + ζ^{-1/2})`, every `n`-variable `(k,d,ζk)`-CNF is exactly
learned by elimination with probability `≥ 1 - δ` from any `T ≥ B · ln(n/δ)` samples. [LearningCNFFormulasFrom, node_18] -/
theorem main (hLU : LocalUniformityFact) :
    ∃ A : ℝ, 0 < A ∧ ∀ ζ : ℝ, 0 < ζ → ζ < 1 → ∀ (k s : ℕ), (s : ℝ) = ζ * k →
      ∃ B : ℝ, ∀ (d n : ℕ) (Φ : LitCNF n),
        SizeCondition A ζ k d →
        IsKDSCNF k d (s : ℝ) Φ →
        ∀ δ : ℝ, 0 < δ → δ < 1 → ∀ T : ℕ,
          B * Real.log ((n : ℝ) / δ) ≤ (T : ℝ) →
          1 - δ ≤ eliminationSuccessProb k T Φ := by
  sorry

end TCSChallenge.LearningCNFFormulasFrom.node_18
