/-!
## Single-register unitary tomography with `O((d²/ε²) log(1/η))` queries

With `D(A,B) = min_{|λ|=1} ‖A − λB‖_op`, assuming a single-copy pure-state estimation
primitive using `≤ C₀ d/a` copies with failure probability `≤ 1/(100d)`, there is a
universal `C` such that for every `d ≥ 1`, `ε, η > 0`, a single-register algorithm outputs
`V ∈ U(d)` with `Pr[D(Z,V) > ε] ≤ η` using at most `C (d²/ε²)(1 + log⁺(1/η))` applications of
`Z`.

Main theorem: `single_register_unitary_tomography`.
-/

namespace TCSChallenge.QueryOptimalEstimationOfUnitaryChannels.node_11

open Matrix

/-- The unitary group `U(d)` as a type. -/
abbrev UMat (d : ℕ) : Type := ↥(Matrix.unitaryGroup (Fin d) ℂ)

/-- Euclidean norm on `ℂ^d`. -/
noncomputable def vecNorm {d : ℕ} (v : Fin d → ℂ) : ℝ :=
  Real.sqrt (∑ i, ‖v i‖ ^ 2)

/-- Inner product `⟨z, w⟩ = ∑ conj(z_i) w_i`. -/
def innerC {d : ℕ} (z w : Fin d → ℂ) : ℂ :=
  ∑ i, star (z i) * w i

/-- Operator norm `‖M‖_op = sup_{‖v‖=1} ‖M v‖` (Euclidean). -/
noncomputable def opNorm {d : ℕ} (M : Matrix (Fin d) (Fin d) ℂ) : ℝ :=
  sSup {r : ℝ | ∃ v : Fin d → ℂ, vecNorm v = 1 ∧ r = vecNorm (M *ᵥ v)}

/-- "`D(A,B) = min_{|λ|=1} ‖A − λB‖_op`". -/
noncomputable def phaseDist {d : ℕ} (A B : Matrix (Fin d) (Fin d) ℂ) : ℝ :=
  sInf {r : ℝ | ∃ c : ℂ, ‖c‖ = 1 ∧ r = opNorm (A - c • B)}

/-- Probability of an outcome sequence `hist`, after the prefix `pre`, when the vector
measured in the computational basis in the next round, given the history so far, is
`amp history`. -/
noncomputable def histProb {d : ℕ} (amp : List (Fin d) → Fin d → ℂ) :
    List (Fin d) → List (Fin d) → ℝ
  | _, [] => 1
  | pre, j :: rest => ‖amp pre j‖ ^ 2 * histProb amp (pre ++ [j]) rest

/-- An `R`-round single-register algorithm. Given the history `h`, the round prepares basis
state `init h`, applies `gate h 0`, then `numQueries h` times (`Z`, then `gate h (t+1)`), and
measures in the computational basis. The output is a unitary computed from the history. -/
structure SingleRegisterAlgorithm (d R : ℕ) where
  init : List (Fin d) → Fin d
  numQueries : List (Fin d) → ℕ
  gate : List (Fin d) → ℕ → Matrix (Fin d) (Fin d) ℂ
  gate_unitary : ∀ h t, gate h t ∈ Matrix.unitaryGroup (Fin d) ℂ
  out : (Fin R → Fin d) → UMat d

/-- Register contents after `t` oracle applications in the round with history `h`. -/
def roundState {d R : ℕ} (A : SingleRegisterAlgorithm d R) (Z : Matrix (Fin d) (Fin d) ℂ)
    (h : List (Fin d)) : ℕ → Fin d → ℂ
  | 0 => A.gate h 0 *ᵥ (fun i => if i = A.init h then 1 else 0)
  | t + 1 => A.gate h (t + 1) *ᵥ (Z *ᵥ roundState A Z h t)

/-- Vector measured at the end of the round with history `h`. -/
def roundAmp {d R : ℕ} (A : SingleRegisterAlgorithm d R) (Z : Matrix (Fin d) (Fin d) ℂ)
    (h : List (Fin d)) : Fin d → ℂ :=
  roundState A Z h (A.numQueries h)

/-- Number of applications of `Z` along the full history `h`. -/
def totalQueries {d R : ℕ} (A : SingleRegisterAlgorithm d R) (h : Fin R → Fin d) : ℕ :=
  ∑ r : Fin R, A.numQueries ((List.ofFn h).take r)

open Classical in
/-- "`Pr[D(Z,V) > ε]`". -/
noncomputable def failProb {d R : ℕ} (A : SingleRegisterAlgorithm d R)
    (Z : Matrix (Fin d) (Fin d) ℂ) (ε : ℝ) : ℝ :=
  ∑ h : Fin R → Fin d,
    if ε < phaseDist Z ((A.out h : UMat d) : Matrix (Fin d) (Fin d) ℂ)
    then histProb (roundAmp A Z) [] (List.ofFn h) else 0

open Classical in
/-- The supplied pure-state primitive: for `d ≥ 2`, `0 < a < 1`, a procedure measuring at most
`C₀ d / a` copies of `z` one at a time (adaptive bases `V`, a classical seed `σ` drawn with
weights `p`) returns a unit vector `u` with `Pr[1 − |⟨z,u⟩|² > a] ≤ 1/(100d)`. -/
def PureStatePrimitive (C₀ : ℝ) : Prop :=
  ∀ d : ℕ, 2 ≤ d → ∀ a : ℝ, 0 < a → a < 1 →
    ∃ R : ℕ, (R : ℝ) ≤ C₀ * d / a ∧ ∃ (s : ℕ) (p : Fin s → ℝ),
      (∀ σ, 0 ≤ p σ) ∧ (∑ σ, p σ = 1) ∧
      ∃ (V : Fin s → List (Fin d) → Matrix (Fin d) (Fin d) ℂ)
        (u : Fin s → (Fin R → Fin d) → Fin d → ℂ),
        (∀ σ h, V σ h ∈ Matrix.unitaryGroup (Fin d) ℂ) ∧
        (∀ σ h, vecNorm (u σ h) = 1) ∧
        ∀ z : Fin d → ℂ, vecNorm z = 1 →
          ∑ σ, p σ * ∑ h : Fin R → Fin d,
            (if a < 1 - ‖innerC z (u σ h)‖ ^ 2 then
              histProb (fun pre => (V σ pre).conjTranspose *ᵥ z) [] (List.ofFn h) else 0)
            ≤ 1 / (100 * (d : ℝ))

/-- `D` satisfies the triangle inequality on unitaries. [QueryOptimalEstimationOf, node_11] -/
theorem phaseDist_triangle {d : ℕ} (A B C : UMat d) :
    phaseDist (A : Matrix (Fin d) (Fin d) ℂ) (C : Matrix (Fin d) (Fin d) ℂ) ≤
      phaseDist (A : Matrix (Fin d) (Fin d) ℂ) (B : Matrix (Fin d) (Fin d) ℂ) +
        phaseDist (B : Matrix (Fin d) (Fin d) ℂ) (C : Matrix (Fin d) (Fin d) ℂ) := by
  sorry

/-- Rubric 3 (unitary rounding): from any matrix `U` one obtains a unitary `V` (the polar
factor) with `‖V − W‖_op ≤ 2‖U − W‖_op` for every unitary `W`. [QueryOptimalEstimationOf, node_11] -/
theorem unitary_rounding {d : ℕ} (U : Matrix (Fin d) (Fin d) ℂ) :
    ∃ V : UMat d, ∀ W : UMat d,
      opNorm ((V : Matrix (Fin d) (Fin d) ℂ) - (W : Matrix (Fin d) (Fin d) ℂ)) ≤
        2 * opNorm (U - (W : Matrix (Fin d) (Fin d) ℂ)) := by
  sorry

open Classical in
/-- Rubric 5 (majority selection): if a strict majority of `T` estimates are within `r` of
`Z`, some estimate has more than `T/2` estimates within `2r`, and every such estimate is
within `3r` of `Z`. [QueryOptimalEstimationOf, node_11] -/
theorem majority_selection {d T : ℕ} (H : Fin T → UMat d) (Z : UMat d) (r : ℝ)
    (hmaj : T < 2 * (Finset.univ.filter (fun k =>
      phaseDist (Z : Matrix (Fin d) (Fin d) ℂ) (H k : Matrix (Fin d) (Fin d) ℂ) ≤ r)).card) :
    (∃ j, T < 2 * (Finset.univ.filter (fun k =>
        phaseDist (H j : Matrix (Fin d) (Fin d) ℂ) (H k : Matrix (Fin d) (Fin d) ℂ)
          ≤ 2 * r)).card) ∧
    ∀ j, T < 2 * (Finset.univ.filter (fun k =>
        phaseDist (H j : Matrix (Fin d) (Fin d) ℂ) (H k : Matrix (Fin d) (Fin d) ℂ)
          ≤ 2 * r)).card →
      phaseDist (Z : Matrix (Fin d) (Fin d) ℂ) (H j : Matrix (Fin d) (Fin d) ℂ) ≤ 3 * r := by
  sorry

/-- Main theorem: given the primitive, for all `d ≥ 1`, `ε, η > 0` there is a single-register
algorithm with at most `C (d²/ε²)(1 + log⁺(1/η))` applications of `Z` on every history, and
`Pr[D(Z,V) > ε] ≤ η` for every `Z ∈ U(d)`. [QueryOptimalEstimationOf, node_11] -/
theorem single_register_unitary_tomography (C₀ : ℝ) (hprim : PureStatePrimitive C₀) :
    ∃ C : ℝ, ∀ d : ℕ, 1 ≤ d → ∀ ε η : ℝ, 0 < ε → 0 < η →
      ∃ (R : ℕ) (A : SingleRegisterAlgorithm d R),
        (∀ h : Fin R → Fin d, (totalQueries A h : ℝ) ≤
          C * ((d : ℝ) ^ 2 / ε ^ 2) * (1 + max 0 (Real.log (1 / η)))) ∧
        ∀ Z : UMat d, failProb A (Z : Matrix (Fin d) (Fin d) ℂ) ε ≤ η := by
  sorry

end TCSChallenge.QueryOptimalEstimationOfUnitaryChannels.node_11
