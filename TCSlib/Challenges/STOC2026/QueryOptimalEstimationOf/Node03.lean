/-!
## A `Ω(d²/ε)` query lower bound for unitary-channel estimation in diamond distance

For `Z ∈ U(d)` let `𝒰(Z)(X) = Z X Z†`. Any quantum query algorithm (with ancillas, adaptivity,
and access to `Z`, `Z†`, `cZ`, `c(Z†)`, each costing one query) which outputs `Ẑ ∈ U(d)` with
`Pr[‖𝒰(Ẑ) − 𝒰(Z)‖_⋄ < ε] ≥ 2/3` for every `Z` must make `Q ≥ c d² / ε` queries, for an
absolute constant `c > 0`, every `d ≥ 2` and every `0 < ε < 1/8`.

Main theorem: `unitary_estimation_query_lower_bound`.
-/

namespace TCSChallenge.QueryOptimalEstimationOfUnitaryChannels.node_03

open Matrix

/-- The unitary group `U(d)` as a type. -/
abbrev UMat (d : ℕ) : Type := ↥(Matrix.unitaryGroup (Fin d) ℂ)

/-- Trace norm "`‖X‖₁ = Tr √(X†X)`", in its variational form
`‖X‖₁ = sup_{W ∈ U(n)} |Tr(W X)|`. -/
noncomputable def traceNorm {n : Type} [Fintype n] [DecidableEq n]
    (X : Matrix n n ℂ) : ℝ :=
  sSup {r : ℝ | ∃ W ∈ Matrix.unitaryGroup n ℂ, r = ‖Matrix.trace (W * X)‖}

/-- `((𝒰(A) − 𝒰(B)) ⊗ id_k)(X) = (A⊗I_k) X (A⊗I_k)† − (B⊗I_k) X (B⊗I_k)†`. -/
def channelDiffTensor {d : ℕ} (A B : Matrix (Fin d) (Fin d) ℂ) (k : ℕ)
    (X : Matrix (Fin d × Fin k) (Fin d × Fin k) ℂ) :
    Matrix (Fin d × Fin k) (Fin d × Fin k) ℂ :=
  Matrix.kronecker A (1 : Matrix (Fin k) (Fin k) ℂ) * X *
      (Matrix.kronecker A (1 : Matrix (Fin k) (Fin k) ℂ)).conjTranspose -
    Matrix.kronecker B (1 : Matrix (Fin k) (Fin k) ℂ) * X *
      (Matrix.kronecker B (1 : Matrix (Fin k) (Fin k) ℂ)).conjTranspose

/-- Diamond distance of the unitary channels:
"`‖Φ‖_⋄ = sup_{k≥1} sup_{X≠0} ‖(Φ⊗id_k)(X)‖₁/‖X‖₁`" with `Φ = 𝒰(A) − 𝒰(B)`. -/
noncomputable def diamondDist {d : ℕ} (A B : Matrix (Fin d) (Fin d) ℂ) : ℝ :=
  sSup {r : ℝ | ∃ k : ℕ, 1 ≤ k ∧
    ∃ X : Matrix (Fin d × Fin k) (Fin d × Fin k) ℂ, X ≠ 0 ∧
      r = traceNorm (channelDiffTensor A B k X) / traceNorm X}

/-- The four oracle types "`Z`, `Z†`, `cZ`, `c(Z†)`", each costing one query. -/
inductive OracleKind
  | fwd
  | inv
  | ctrlFwd
  | ctrlInv

/-- Workspace: a control qubit, the `d`-dimensional target register, and an ancilla of
dimension `m`. -/
abbrev Space (d m : ℕ) : Type := Fin 2 × Fin d × Fin m

/-- `M` acting on the target register (ignoring the control). -/
def onTarget {d m : ℕ} (M : Matrix (Fin d) (Fin d) ℂ) : Matrix (Space d m) (Space d m) ℂ :=
  Matrix.of fun x y => if x.1 = y.1 ∧ x.2.2 = y.2.2 then M x.2.1 y.2.1 else 0

/-- Controlled `M`: "`cM = |0⟩⟨0| ⊗ I_d + |1⟩⟨1| ⊗ M`" (tensored with the ancilla identity). -/
def controlled {d m : ℕ} (M : Matrix (Fin d) (Fin d) ℂ) : Matrix (Space d m) (Space d m) ℂ :=
  Matrix.of fun x y =>
    if x.1 = y.1 ∧ x.2.2 = y.2.2 then
      (if x.1 = 0 then (1 : Matrix (Fin d) (Fin d) ℂ) x.2.1 y.2.1 else M x.2.1 y.2.1)
    else 0

/-- The operator applied by one oracle slot of the given kind. -/
def oracleOp {d m : ℕ} (Z : Matrix (Fin d) (Fin d) ℂ) :
    OracleKind → Matrix (Space d m) (Space d m) ℂ
  | .fwd => onTarget Z
  | .inv => onTarget Z.conjTranspose
  | .ctrlFwd => controlled Z
  | .ctrlInv => controlled Z.conjTranspose

/-- A purified `Q`-query algorithm: initial basis state, known unitaries `G_0, …, G_Q`
(independent of `Z`), oracle kinds of the `Q` slots, and the classical post-processing `out`
of the final computational-basis measurement. -/
structure QueryAlgorithm (d m Q : ℕ) (Out : Type) where
  init : Space d m
  gate : ℕ → Matrix (Space d m) (Space d m) ℂ
  gate_unitary : ∀ t, t ≤ Q → gate t ∈ Matrix.unitaryGroup (Space d m) ℂ
  slot : ℕ → OracleKind
  out : Space d m → Out

/-- State after `t` oracle slots: `G_t O_{t-1} G_{t-1} ⋯ O_0 G_0 |init⟩`. -/
def stateAt {d m Q : ℕ} {Out : Type} (A : QueryAlgorithm d m Q Out)
    (Z : Matrix (Fin d) (Fin d) ℂ) : ℕ → Space d m → ℂ
  | 0 => A.gate 0 *ᵥ (fun x => if x = A.init then 1 else 0)
  | t + 1 => A.gate (t + 1) *ᵥ (oracleOp Z (A.slot t) *ᵥ stateAt A Z t)

/-- Born probability of measurement outcome `ω` on the final state. -/
noncomputable def outcomeProb {d m Q : ℕ} {Out : Type} (A : QueryAlgorithm d m Q Out)
    (Z : Matrix (Fin d) (Fin d) ℂ) (ω : Space d m) : ℝ :=
  ‖stateAt A Z Q ω‖ ^ 2

open Classical in
/-- Probability that the algorithm outputs `o`. -/
noncomputable def probOut {d m Q : ℕ} {Out : Type} (A : QueryAlgorithm d m Q Out)
    (Z : Matrix (Fin d) (Fin d) ℂ) (o : Out) : ℝ :=
  ∑ ω, if A.out ω = o then outcomeProb A Z ω else 0

open Classical in
/-- "`Pr[‖𝒰(Ẑ) − 𝒰(Z)‖_⋄ < ε]`". -/
noncomputable def successProb {d m Q : ℕ} (A : QueryAlgorithm d m Q (UMat d))
    (Z : Matrix (Fin d) (Fin d) ℂ) (ε : ℝ) : ℝ :=
  ∑ ω, if diamondDist ((A.out ω : UMat d) : Matrix (Fin d) (Fin d) ℂ) Z < ε
    then outcomeProb A Z ω else 0

/-- Rubric 1: an exponentially large family of `d`-dimensional reflections (Hermitian
unitaries) with pairwise channel diamond distance at least `1/2` (global phase handled). [QueryOptimalEstimationOf, node_03] -/
theorem separated_reflection_family :
    ∃ a : ℝ, 0 < a ∧ ∃ d₀ : ℕ, ∀ d : ℕ, d₀ ≤ d →
      ∃ N : ℕ, Real.exp (a * (d : ℝ) ^ 2) ≤ (N : ℝ) ∧
        ∃ R : Fin N → Matrix (Fin d) (Fin d) ℂ,
          (∀ j, R j ∈ Matrix.unitaryGroup (Fin d) ℂ ∧ (R j).IsHermitian) ∧
          ∀ j k, j ≠ k → (1 / 2 : ℝ) ≤ diamondDist (R j) (R k) := by
  sorry

/-- Rubric 2 (telescoping): `‖𝒰(U^m) − 𝒰(Z^m)‖_⋄ ≤ m ‖𝒰(U) − 𝒰(Z)‖_⋄` for unitaries,
without commutativity. [QueryOptimalEstimationOf, node_03] -/
theorem diamondDist_pow_le {d : ℕ} (U Z : Matrix (Fin d) (Fin d) ℂ)
    (hU : U ∈ Matrix.unitaryGroup (Fin d) ℂ) (hZ : Z ∈ Matrix.unitaryGroup (Fin d) ℂ)
    (m : ℕ) : diamondDist (U ^ m) (Z ^ m) ≤ (m : ℝ) * diamondDist U Z := by
  sorry

/-- Rubric 4 (polynomial-span bound): a `T`-query algorithm using only forward queries to
one of `N` unknown `D`-dimensional unitaries has summed identification success at most
`binom(T + D² − 1, T)`, i.e. average success `≤ binom(T+D²−1,T)/N`. [QueryOptimalEstimationOf, node_03] -/
theorem identification_bound (D m T N : ℕ) (W : Fin N → UMat D)
    (A : QueryAlgorithm D m T (Option (Fin N))) (hfwd : ∀ t, t < T → A.slot t = .fwd) :
    ∑ j, probOut A ((W j : UMat D) : Matrix (Fin D) (Fin D) ℂ) (some j) ≤
      ((Nat.choose (T + D ^ 2 - 1) T : ℕ) : ℝ) := by
  sorry

/-- Bounded-dimension case: distinguishing `I` from `diag(e^{4iε},1,…,1)` forces
`Q ≥ 1/(48ε)` for every `d ≥ 2`. [QueryOptimalEstimationOf, node_03] -/
theorem query_lower_bound_inverse_eps (d : ℕ) (hd : 2 ≤ d) (ε : ℝ) (hε : 0 < ε)
    (hε' : ε < 1 / 8) (m Q : ℕ) (A : QueryAlgorithm d m Q (UMat d))
    (hA : ∀ Z : UMat d, (2 / 3 : ℝ) ≤ successProb A (Z : Matrix (Fin d) (Fin d) ℂ) ε) :
    1 / (48 * ε) ≤ (Q : ℝ) := by
  sorry

/-- Main theorem: `Q ≥ c d² / ε` for every `d ≥ 2`, `0 < ε < 1/8`, and every algorithm that
`ε`-estimates every `Z ∈ U(d)` in diamond distance with probability `≥ 2/3`. [QueryOptimalEstimationOf, node_03] -/
theorem unitary_estimation_query_lower_bound :
    ∃ c : ℝ, 0 < c ∧ ∀ d : ℕ, 2 ≤ d → ∀ ε : ℝ, 0 < ε → ε < 1 / 8 →
      ∀ (m Q : ℕ) (A : QueryAlgorithm d m Q (UMat d)),
        (∀ Z : UMat d, (2 / 3 : ℝ) ≤ successProb A (Z : Matrix (Fin d) (Fin d) ℂ) ε) →
          c * (d : ℝ) ^ 2 / ε ≤ (Q : ℝ) := by
  sorry

end TCSChallenge.QueryOptimalEstimationOfUnitaryChannels.node_03
