/-!
## Nonadaptive single-copy pure-state tomography with `O(d/ε)` copies

Let `d = 2^n`, `n ≥ 1`. For every `ε > 0` there is a scheme that measures `m = O(d/ε)` copies
of an unknown pure state `u` separately, each in the column basis of a unitary `V_t` (outcome
`j` with probability `|⟨j|V_t† u⟩|²`), with all `V_t` drawn from classical randomness in
advance, and reconstructs a unit vector `û` with `Pr[|⟨u,û⟩| < 1 − ε] ≤ d^{-100}`, uniformly
over `u`.

Main theorem: `nonadaptive_pure_state_tomography`.
-/

namespace TCSChallenge.QueryOptimalEstimationOfUnitaryChannels.node_24

open Matrix

/-- Euclidean norm on `ℂ^d`. -/
noncomputable def vecNorm {d : ℕ} (v : Fin d → ℂ) : ℝ :=
  Real.sqrt (∑ i, ‖v i‖ ^ 2)

/-- Inner product `⟨z, w⟩ = ∑ conj(z_i) w_i`. -/
def innerC {d : ℕ} (z w : Fin d → ℂ) : ℂ :=
  ∑ i, star (z i) * w i

/-- Operator norm `‖M‖_op = sup_{‖v‖=1} ‖M v‖` (Euclidean). -/
noncomputable def opNorm {d : ℕ} (M : Matrix (Fin d) (Fin d) ℂ) : ℝ :=
  sSup {r : ℝ | ∃ v : Fin d → ℂ, vecNorm v = 1 ∧ r = vecNorm (M *ᵥ v)}

/-- A nonadaptive `m`-copy scheme: a classical seed `σ ∈ Fin s` with weights `weight`, the
measurement unitaries `setting σ t` fixed by the seed before any outcome, and a
reconstruction `recon σ j` of a unit vector from the outcome record `j`. -/
structure NonadaptiveScheme (d m : ℕ) where
  s : ℕ
  weight : Fin s → ℝ
  weight_nonneg : ∀ σ, 0 ≤ weight σ
  weight_sum : ∑ σ, weight σ = 1
  setting : Fin s → Fin m → Matrix (Fin d) (Fin d) ℂ
  setting_unitary : ∀ σ t, setting σ t ∈ Matrix.unitaryGroup (Fin d) ℂ
  recon : Fin s → (Fin m → Fin d) → Fin d → ℂ
  recon_unit : ∀ σ j, vecNorm (recon σ j) = 1

/-- Probability of the outcome record `j` given seed `σ`: copies are measured independently,
copy `t` yields `j t` with probability `|⟨j_t | V_t† u⟩|²`. -/
noncomputable def recordProb {d m : ℕ} (S : NonadaptiveScheme d m) (u : Fin d → ℂ)
    (σ : Fin S.s) (j : Fin m → Fin d) : ℝ :=
  ∏ t, ‖((S.setting σ t).conjTranspose *ᵥ u) (j t)‖ ^ 2

open Classical in
/-- "`Pr[|⟨u, û⟩| < 1 − ε]`". -/
noncomputable def failProb {d m : ℕ} (S : NonadaptiveScheme d m) (u : Fin d → ℂ) (ε : ℝ) :
    ℝ :=
  ∑ σ, S.weight σ * ∑ j : Fin m → Fin d,
    if ‖innerC u (S.recon σ j)‖ < 1 - ε then recordProb S u σ j else 0

/-- Rubric 4 (moment-to-tail): for Hermitian `H` and even `k`, `‖H‖_op^k ≤ Tr(H^k)`. [QueryOptimalEstimationOf, node_24] -/
theorem opNorm_pow_le_trace_pow {d : ℕ} (H : Matrix (Fin d) (Fin d) ℂ) (hH : H.IsHermitian)
    (k : ℕ) (hk : Even k) : opNorm H ^ k ≤ (Matrix.trace (H ^ k)).re := by
  sorry

/-- Rubric 5 (reconstruction): if `A` is Hermitian with `‖A − |u⟩⟨u|‖_op ≤ δ ≤ 1/32`, `d = 2^n`,
and `c` is a column of `A^{n+2}` of maximal Euclidean norm, then the normalized column `û`
satisfies `|⟨u, û⟩| ≥ 1 − 9δ²`. [QueryOptimalEstimationOf, node_24] -/
theorem power_column_reconstruction (n : ℕ) (hn : 1 ≤ n) (A : Matrix (Fin (2 ^ n)) (Fin (2 ^ n)) ℂ)
    (hA : A.IsHermitian) (u : Fin (2 ^ n) → ℂ) (hu : vecNorm u = 1) (δ : ℝ) (hδ0 : 0 ≤ δ)
    (hδ : δ ≤ 1 / 32) (hclose : opNorm (A - Matrix.of fun i j => u i * star (u j)) ≤ δ)
    (c : Fin (2 ^ n))
    (hc : ∀ c' : Fin (2 ^ n),
      vecNorm (fun i => (A ^ (n + 2)) i c') ≤ vecNorm (fun i => (A ^ (n + 2)) i c)) :
    1 - 9 * δ ^ 2 ≤
      ‖innerC u (fun i => (A ^ (n + 2)) i c / (vecNorm (fun i => (A ^ (n + 2)) i c) : ℂ))‖ := by
  sorry

/-- Main theorem: there is an absolute `M` such that for every `n ≥ 1`, `d = 2^n`, and every
`ε > 0`, a nonadaptive scheme with `m ≤ M d / ε` copies has failure probability `≤ d^{-100}`
for every unit vector `u`. [QueryOptimalEstimationOf, node_24] -/
theorem nonadaptive_pure_state_tomography :
    ∃ M : ℝ, ∀ n : ℕ, 1 ≤ n → ∀ ε : ℝ, 0 < ε →
      ∃ (m : ℕ) (S : NonadaptiveScheme (2 ^ n) m),
        (m : ℝ) ≤ M * ((2 ^ n : ℕ) : ℝ) / ε ∧
        ∀ u : Fin (2 ^ n) → ℂ, vecNorm u = 1 →
          failProb S u ε ≤ 1 / ((2 ^ n : ℕ) : ℝ) ^ 100 := by
  sorry

end TCSChallenge.QueryOptimalEstimationOfUnitaryChannels.node_24
