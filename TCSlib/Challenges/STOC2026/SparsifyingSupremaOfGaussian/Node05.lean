/-!
## Sparsifying intersections of halfspaces with bounded offsets in Gaussian distance

Let `K = ⋂_{t ∈ T} {x : t·x ≤ r_t}` with `T ⊆ 𝕊^{n-1}` arbitrary and `0 ≤ r_t ≤ r`, `r ≥ 1`.
For `0 < ε < 1/2` there is an intersection `L` of at most `2^{exp(Õ(1/ε²) r⁴)}` halfspaces
with `γ_n(K △ L) ≤ ε`, uniformly in `n`, `|T|` and the offsets. Main theorem:
`exists_sparse_halfspace_approx`.

`ℝⁿ` is modelled as `Fin n → ℝ` with the Euclidean dot product and norm defined by hand,
and `γ_n` as the product of `n` copies of TCSlib's `standardGaussianMeasure` (`= N(0,1)`).
-/

namespace TCSChallenge.SparsifyingSupremaOfGaussianProcesses.node_05

open MeasureTheory ProbabilityTheory BooleanAnalysis.ThresholdFunctions
open scoped ENNReal NNReal

/-- Euclidean inner product `x · t = ∑ᵢ xᵢ tᵢ` on `ℝⁿ` (modelled as `Fin n → ℝ`). -/
def dotR {n : ℕ} (x t : Fin n → ℝ) : ℝ := ∑ i, x i * t i

/-- Euclidean norm `‖v‖₂ = (∑ᵢ vᵢ²)^{1/2}`. -/
noncomputable def norm2 {n : ℕ} (v : Fin n → ℝ) : ℝ := Real.sqrt (∑ i, v i ^ 2)

/-- Standard Gaussian measure `γ_n = N(0, I_n)` on `ℝⁿ`: the product of `n` copies of
`N(0,1)`. -/
noncomputable abbrev gaussMeasure (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi fun _ : Fin n => standardGaussianMeasure

/-- "`f_T(x) := sup_{t ∈ T} x · t`". (Real `sSup`; meaningful for nonempty bounded `T`.) -/
noncomputable def supFun {n : ℕ} (T : Set (Fin n → ℝ)) (x : Fin n → ℝ) : ℝ :=
  sSup ((fun t => dotR x t) '' T)

/-- Gaussian width "`w(T) := E f_T(g)`", `g ∼ N(0, I_n)`. -/
noncomputable def gaussWidth {n : ℕ} (T : Set (Fin n → ℝ)) : ℝ :=
  ∫ g, supFun T g ∂(gaussMeasure n)

/-- `T` is bounded in Euclidean norm. -/
def IsBoundedR {n : ℕ} (T : Set (Fin n → ℝ)) : Prop :=
  ∃ ρ : ℝ, ∀ t ∈ T, norm2 t ≤ ρ

/-- The (closed) halfspace `{x : a · x ≤ b}`. -/
def halfspace {n : ℕ} (a : Fin n → ℝ) (b : ℝ) : Set (Fin n → ℝ) := {x | dotR a x ≤ b}

/-- "`K = ⋂_{t ∈ T} {x ∈ ℝⁿ : t · x ≤ r_t}`". -/
def polytope {n : ℕ} (T : Set (Fin n → ℝ)) (roff : (Fin n → ℝ) → ℝ) : Set (Fin n → ℝ) :=
  ⋂ t ∈ T, halfspace t (roff t)

/-- An intersection of the `m` halfspaces `{x : aᵢ · x ≤ bᵢ}`. -/
def halfspaceInter {n m : ℕ} (a : Fin m → (Fin n → ℝ)) (b : Fin m → ℝ) : Set (Fin n → ℝ) :=
  ⋂ i, halfspace (a i) (b i)

/-- "`dist_G(A, B) = γ_d(A △ B)`". -/
noncomputable def distG {n : ℕ} (A B : Set (Fin n → ℝ)) : ℝ≥0∞ :=
  gaussMeasure n (symmDiff A B)

/-- The facet budget `2^{exp(C (1/ε²) (1 + log(1/ε))^k r⁴)}`. -/
noncomputable def facetBudget (C : ℝ) (k : ℕ) (ε r : ℝ) : ℝ :=
  (2 : ℝ) ^ Real.exp (C * (1 / ε ^ 2) * (1 + Real.log (1 / ε)) ^ k * r ^ 4)

/-! ### Facts supplied by the problem (usable without proof) -/

/-- Given fact 1 (supremum sparsification). [SparsifyingSupremaOfGaussian, node_05] -/
theorem fact1_sparsify :
    ∃ C : ℝ, 0 < C ∧ ∀ (d : ℕ) (A : Set (Fin d → ℝ)) (η : ℝ),
      A.Nonempty → IsBoundedR A → 0 < gaussWidth A → 0 < η → η < 1 / 2 →
      ∃ (S : Finset (Fin d → ℝ)) (hS : S.Nonempty), (↑S : Set (Fin d → ℝ)) ⊆ A ∧
        ∃ c : (Fin d → ℝ) → ℝ,
          (S.card : ℝ) ≤ (2 : ℝ) ^ ((2 : ℝ) ^ (C * gaussWidth A / η)) ∧
          ∫ g, |supFun A g - S.sup' hS (fun s => dotR g s + c s)| ∂(gaussMeasure d)
            ≤ η := by
  sorry

/-- Given fact 2: if `sup_{a ∈ A} ‖a‖₂ ≤ ρ` then
`Pr(|f_A(g) - w(A)| ≥ u) ≤ 2 exp(-u²/(2ρ²))`. [SparsifyingSupremaOfGaussian, node_05] -/
theorem fact2_concentration (d : ℕ) (A : Set (Fin d → ℝ)) (ρ u : ℝ)
    (hA : A.Nonempty) (hρ : 0 < ρ) (hAρ : ∀ a ∈ A, norm2 a ≤ ρ) (hu : 0 < u) :
    (gaussMeasure d {g | u ≤ |supFun A g - gaussWidth A|}).toReal
      ≤ 2 * Real.exp (-(u ^ 2) / (2 * ρ ^ 2)) := by
  sorry

/-- Given fact 3 (anticoncentration): if `A ⊆ 𝕊^{d-1}` then
`Pr(|f_A(g) - θ| ≤ u) ≤ 4u(1 + w(A))`. [SparsifyingSupremaOfGaussian, node_05] -/
theorem fact3_anticoncentration (d : ℕ) (A : Set (Fin d → ℝ)) (θ u : ℝ)
    (hA : A.Nonempty) (hsph : ∀ a ∈ A, norm2 a = 1) (hu : 0 < u) :
    (gaussMeasure d {g | |supFun A g - θ| ≤ u}).toReal ≤ 4 * u * (1 + gaussWidth A) := by
  sorry

/-! ### Rubric lemma stubs -/

/-- Rubric 1 (equal-offset case): for `R ≥ 1` and finite `U ⊆ 𝕊^{d-1}`, the body
`⋂_{u ∈ U} {x : u·x ≤ R}` is `α`-approximated by an intersection of at most
`2^{exp(Õ(1/α²) R⁴)}` halfspaces. [SparsifyingSupremaOfGaussian, node_05] -/
theorem equal_offset_sparsify :
    ∃ (C : ℝ) (k : ℕ), 0 < C ∧ ∀ (d : ℕ) (U : Finset (Fin d → ℝ)) (R α : ℝ),
      1 ≤ R → 0 < α → α < 1 / 2 → (∀ u ∈ U, norm2 u = 1) →
      ∃ (m : ℕ) (a : Fin m → (Fin d → ℝ)) (b : Fin m → ℝ),
        (m : ℝ) ≤ facetBudget C k α R ∧
        distG (polytope (↑U : Set (Fin d → ℝ)) (fun _ => R)) (halfspaceInter a b)
          ≤ ENNReal.ofReal α := by
  sorry

/-- Rubric 2 (offset calibration): with `m = ⌊exp(δ² Q²)⌋` i.i.d. standard Gaussians `Yᵢ`,
`Z = max_i Yᵢ / (√2 Q)` is within `2a` of `δ` except with probability `≤ p`, for all large
`Q`. [SparsifyingSupremaOfGaussian, node_05] -/
theorem max_gaussian_calibration (δ a p : ℝ) (hδ : 0 < δ) (ha : 0 < a) (hp : 0 < p) :
    ∃ Q₀ : ℝ, ∀ Q : ℝ, Q₀ ≤ Q →
      (gaussMeasure ⌊Real.exp (δ ^ 2 * Q ^ 2)⌋₊
        {y | 2 * a < |(⨆ i, y i / (Real.sqrt 2 * Q)) - δ|}).toReal ≤ p := by
  sorry

/-- Rubric 4 (slicing by Fubini): if `γ_{n+M}((K × ℝ^M) △ L') ≤ ε`, some cross-section
`L'_{y₀} = {x : (x, y₀) ∈ L'}` satisfies `γ_n(K △ L'_{y₀}) ≤ ε`. [SparsifyingSupremaOfGaussian, node_05] -/
theorem exists_good_section (n M : ℕ) (K : Set (Fin n → ℝ))
    (L' : Set ((Fin n → ℝ) × (Fin M → ℝ))) (ε : ℝ)
    (hK : MeasurableSet K) (hL : MeasurableSet L')
    (h : ((gaussMeasure n).prod (gaussMeasure M)) (symmDiff (K ×ˢ Set.univ) L')
      ≤ ENNReal.ofReal ε) :
    ∃ y₀ : Fin M → ℝ, distG K {x | (x, y₀) ∈ L'} ≤ ENNReal.ofReal ε := by
  sorry

/-- Rubric 5 (infinite families): an arbitrary intersection of closed halfspaces is
approximated in Gaussian measure by a finite subintersection. [SparsifyingSupremaOfGaussian, node_05] -/
theorem exists_finite_subfamily (n : ℕ) (T : Set (Fin n → ℝ)) (roff : (Fin n → ℝ) → ℝ)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ F : Finset (Fin n → ℝ), (↑F : Set (Fin n → ℝ)) ⊆ T ∧
      gaussMeasure n (polytope (↑F : Set (Fin n → ℝ)) roff \ polytope T roff)
        ≤ ENNReal.ofReal ε := by
  sorry

/-! ### Main theorem -/

/-- For `r ≥ 1`, `0 < ε < 1/2`, `T ⊆ 𝕊^{n-1}` arbitrary and offsets `0 ≤ r_t ≤ r`, the body
`K = ⋂_{t∈T} {x : t·x ≤ r_t}` is within Gaussian distance `ε` of an intersection of at most
`2^{exp(Õ(1/ε²) r⁴)}` halfspaces; the constants `C, k` are universal. [SparsifyingSupremaOfGaussian, node_05] -/
theorem exists_sparse_halfspace_approx :
    ∃ (C : ℝ) (k : ℕ), 0 < C ∧ ∀ (n : ℕ) (T : Set (Fin n → ℝ)) (roff : (Fin n → ℝ) → ℝ)
      (r ε : ℝ), 1 ≤ r → 0 < ε → ε < 1 / 2 → (∀ t ∈ T, norm2 t = 1) →
      (∀ t ∈ T, 0 ≤ roff t ∧ roff t ≤ r) →
      ∃ (m : ℕ) (a : Fin m → (Fin n → ℝ)) (b : Fin m → ℝ),
        (m : ℝ) ≤ facetBudget C k ε r ∧
        distG (polytope T roff) (halfspaceInter a b) ≤ ENNReal.ofReal ε := by
  sorry

end TCSChallenge.SparsifyingSupremaOfGaussianProcesses.node_05
