/-!
## Sparsifying the supremum of a Gaussian process (additive and relative error)

Let `g ∼ N(0, I_n)`. For nonempty `T ⊆ ℝⁿ` put `f_T(x) = sup_{t ∈ T} x·t` and
`w(T) = E f_T(g)`. Part (i) (`sparsify_additive`): if `0 < w(T) < ∞` and `ε ∈ (0, 1/2)`,
there is a finite `S ⊆ T` with `|S| ≤ 2^{2^{O(w(T)/ε)}}` and shifts `0 ≤ c_s ≤ w(T)` such that
`E |f_T(g) - max_{s∈S}(g·s + c_s)| ≤ ε`. Part (ii) (`sparsify_relative`): for every bounded
nonempty `T` and `α > 0` there are `S ⊆ T`, `|S| ≤ 2^{2^{O(1/α)}}`, and real shifts with
`E |sup_T X_t - max_S (X_s + c_s)| ≤ α E sup_T X_t`. Constants are universal.

`ℝⁿ` is modelled as `Fin n → ℝ` with the Euclidean dot product and norm defined by hand,
and `N(0, I_n)` as the product of `n` copies of TCSlib's `standardGaussianMeasure`.
-/

namespace TCSChallenge.SparsifyingSupremaOfGaussianProcesses.node_03

open MeasureTheory ProbabilityTheory BooleanAnalysis.ThresholdFunctions
open scoped ENNReal NNReal

/-- Euclidean inner product `x · t = ∑ᵢ xᵢ tᵢ` on `ℝⁿ` (modelled as `Fin n → ℝ`). -/
def dotR {n : ℕ} (x t : Fin n → ℝ) : ℝ := ∑ i, x i * t i

/-- Euclidean norm `‖v‖₂ = (∑ᵢ vᵢ²)^{1/2}`. -/
noncomputable def norm2 {n : ℕ} (v : Fin n → ℝ) : ℝ := Real.sqrt (∑ i, v i ^ 2)

/-- Standard Gaussian measure `γ_n = N(0, I_n)` on `ℝⁿ`: the product of `n` copies of
TCSlib's `standardGaussianMeasure` (`= N(0,1)`). -/
noncomputable abbrev gaussMeasure (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ : Fin n => standardGaussianMeasure)

/-- "`f_T(x) := sup_{t ∈ T} x · t`". (Real `sSup`; meaningful for nonempty bounded `T`.) -/
noncomputable def supFun {n : ℕ} (T : Set (Fin n → ℝ)) (x : Fin n → ℝ) : ℝ :=
  sSup ((fun t => dotR x t) '' T)

/-- Gaussian width "`w(T) := E f_T(g)`", `g ∼ N(0, I_n)`. -/
noncomputable def gaussWidth {n : ℕ} (T : Set (Fin n → ℝ)) : ℝ :=
  ∫ g, supFun T g ∂(gaussMeasure n)

/-- `T` is bounded in Euclidean norm. -/
def IsBoundedR {n : ℕ} (T : Set (Fin n → ℝ)) : Prop :=
  ∃ ρ : ℝ, ∀ t ∈ T, norm2 t ≤ ρ

/-- "`diam(U) := sup_{u,v ∈ U} ‖u - v‖₂`" (real `sSup`; `0` for empty `U`). -/
noncomputable def eDiam {n : ℕ} (U : Set (Fin n → ℝ)) : ℝ :=
  sSup {d : ℝ | ∃ u ∈ U, ∃ v ∈ U, d = norm2 (u - v)}

/-- "A sequence `(𝒜_h)_{h ≥ 0}` of partitions of `T` is admissible if `𝒜_0 = {T}`, each
`𝒜_{h+1}` refines `𝒜_h`, and `|𝒜_h| ≤ 2^{2^h}`." -/
structure IsAdmissible {n : ℕ} (T : Set (Fin n → ℝ)) (A : ℕ → Set (Set (Fin n → ℝ))) :
    Prop where
  cell_nonempty : ∀ h, ∀ P ∈ A h, P.Nonempty
  cell_subset : ∀ h, ∀ P ∈ A h, P ⊆ T
  cover_unique : ∀ h, ∀ t ∈ T, ∃! P, P ∈ A h ∧ t ∈ P
  zero : A 0 = {T}
  refines : ∀ h, ∀ P ∈ A (h + 1), ∃ Q ∈ A h, P ⊆ Q
  finite : ∀ h, (A h).Finite
  card_le : ∀ h, (A h).ncard ≤ 2 ^ (2 ^ h)

/-- The chaining sum `∑_{h ≥ 0} 2^{h/2} diam(𝒜_h(t))`, valued in `ℝ≥0∞`. The cell
`𝒜_h(t)` containing `t` is unique, so the inner supremum over cells containing `t` is its
value. -/
noncomputable def chainSum {n : ℕ} (A : ℕ → Set (Set (Fin n → ℝ))) (t : Fin n → ℝ) : ℝ≥0∞ :=
  ∑' h : ℕ, ⨆ P ∈ A h, ⨆ (_ : t ∈ P), ENNReal.ofReal ((2 : ℝ) ^ ((h : ℝ) / 2) * eDiam P)

/-- "`γ₂(T) := inf_{(𝒜_h) admissible} sup_{t ∈ T} ∑_{h ≥ 0} 2^{h/2} diam(𝒜_h(t))`". -/
noncomputable def gamma2 {n : ℕ} (T : Set (Fin n → ℝ)) : ℝ≥0∞ :=
  ⨅ (A : ℕ → Set (Set (Fin n → ℝ))) (_ : IsAdmissible T A), ⨆ t ∈ T, chainSum A t

/-! ### Facts supplied by the problem (usable without proof) -/

/-- Given fact 1: if `F` is `a`-Lipschitz, then
`Pr(|F(g) - E F(g)| ≥ r) ≤ 2 exp(-r² / (2a²))`. [SparsifyingSupremaOfGaussian, node_03] -/
theorem gaussian_lipschitz_concentration (n : ℕ) (F : (Fin n → ℝ) → ℝ) (a : ℝ)
    (ha : 0 < a) (hF : ∀ x y, |F x - F y| ≤ a * norm2 (x - y)) (r : ℝ) (hr : 0 ≤ r) :
    (gaussMeasure n {x | r ≤ |F x - ∫ y, F y ∂(gaussMeasure n)|}).toReal
      ≤ 2 * Real.exp (-(r ^ 2) / (2 * a ^ 2)) := by
  sorry

/-- Given fact 2 (majorizing measures): a universal `L` with `γ₂(T) ≤ L w(T)` for every
bounded nonempty `T` with `0 < w(T) < ∞`. [SparsifyingSupremaOfGaussian, node_03] -/
theorem majorizing_measures :
    ∃ L : ℝ, 0 < L ∧ ∀ (n : ℕ) (T : Set (Fin n → ℝ)), T.Nonempty → IsBoundedR T →
      0 < gaussWidth T → gamma2 T ≤ ENNReal.ofReal (L * gaussWidth T) := by
  sorry

/-! ### Rubric lemma stubs -/

/-- Rubric 1–2 (multiscale partition with exponential diameter budget). With `ρ = ε/3`,
stopping cells of the admissible sequence once `diam ≤ (ρ/4) 2^{-h/2}` yields a finite
partition `𝒫` of `T` with `|𝒫| ≤ 2^{2^{1 + 12Lw/ε}}`, cells of diameter `≤ ρ`, and
`∑_{P} exp(-ρ²/(2 d_P²)) < 1` (summand `0` when `d_P = 0`). [SparsifyingSupremaOfGaussian, node_03] -/
theorem exists_stopped_partition (n : ℕ) (T : Set (Fin n → ℝ)) (L ε : ℝ)
    (hT : T.Nonempty) (hb : IsBoundedR T) (hw : 0 < gaussWidth T) (hL : 0 < L)
    (hγ : gamma2 T ≤ ENNReal.ofReal (L * gaussWidth T))
    (hε : 0 < ε) (hε2 : ε < 1 / 2) (hlarge : ε < 2 * gaussWidth T) :
    ∃ P : Finset (Set (Fin n → ℝ)),
      (∀ Q ∈ P, Q.Nonempty ∧ Q ⊆ T) ∧
      (∀ t ∈ T, ∃! Q, Q ∈ P ∧ t ∈ Q) ∧
      (P.card : ℝ) ≤ (2 : ℝ) ^ ((2 : ℝ) ^ (1 + 12 * L * gaussWidth T / ε)) ∧
      (∀ Q ∈ P, eDiam Q ≤ ε / 3) ∧
      ∑ Q ∈ P, (if eDiam Q = 0 then 0
        else Real.exp (-((ε / 3) ^ 2) / (2 * eDiam Q ^ 2))) < 1 := by
  sorry

/-- Rubric 4 (shift bounds): for `s ∈ Q ⊆ T`, the local shift
`c = E sup_{t ∈ Q} g·(t - s)` satisfies `0 ≤ c ≤ w(T)`. [SparsifyingSupremaOfGaussian, node_03] -/
theorem local_shift_bounds (n : ℕ) (T Q : Set (Fin n → ℝ)) (s : Fin n → ℝ)
    (hb : IsBoundedR T) (hQ : Q ⊆ T) (hs : s ∈ Q) :
    0 ≤ ∫ g, (supFun Q g - dotR g s) ∂(gaussMeasure n) ∧
      ∫ g, (supFun Q g - dotR g s) ∂(gaussMeasure n) ≤ gaussWidth T := by
  sorry

/-- Elementary: `|max_P a_P - max_P b_P| ≤ max_P |a_P - b_P|` over a nonempty finset. [SparsifyingSupremaOfGaussian, node_03] -/
theorem abs_sup'_sub_sup'_le {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (a b : ι → ℝ) :
    |s.sup' hs a - s.sup' hs b| ≤ s.sup' hs (fun i => |a i - b i|) := by
  sorry

/-- Rubric 3 (local centered deviations): for a finite family of bounded cells of diameter
`≤ ρ` with representatives `s_Q ∈ Q` and exponential budget `≤ 1`, the expected maximum of
the centered local deviations `D_Q - E D_Q`, `D_Q(g) = sup_{t∈Q} g·(t - s_Q)`, is `≤ 3ρ`. [SparsifyingSupremaOfGaussian, node_03] -/
theorem expected_max_local_deviation (n : ℕ) (P : Finset (Set (Fin n → ℝ)))
    (hP : P.Nonempty) (s : Set (Fin n → ℝ) → (Fin n → ℝ)) (ρ : ℝ) (hρ : 0 < ρ)
    (hs : ∀ Q ∈ P, s Q ∈ Q) (hbd : ∀ Q ∈ P, IsBoundedR Q) (hdiam : ∀ Q ∈ P, eDiam Q ≤ ρ)
    (hbudget : ∑ Q ∈ P, (if eDiam Q = 0 then 0
        else Real.exp (-(ρ ^ 2) / (2 * eDiam Q ^ 2))) ≤ 1) :
    ∫ g, P.sup' hP (fun Q => |(supFun Q g - dotR g (s Q))
        - ∫ y, (supFun Q y - dotR y (s Q)) ∂(gaussMeasure n)|) ∂(gaussMeasure n)
      ≤ 3 * ρ := by
  sorry

/-! ### Main theorems -/

/-- Part (i): additive-error sparsification with `|S| ≤ 2^{2^{C w(T)/ε}}` and
`0 ≤ c_s ≤ w(T)`, `C` universal. [SparsifyingSupremaOfGaussian, node_03] -/
theorem sparsify_additive :
    ∃ C : ℝ, 0 < C ∧ ∀ (n : ℕ) (T : Set (Fin n → ℝ)) (ε : ℝ),
      T.Nonempty → IsBoundedR T → 0 < gaussWidth T → 0 < ε → ε < 1 / 2 →
      ∃ (S : Finset (Fin n → ℝ)) (hS : S.Nonempty), (↑S : Set (Fin n → ℝ)) ⊆ T ∧
        ∃ c : (Fin n → ℝ) → ℝ,
          (S.card : ℝ) ≤ (2 : ℝ) ^ ((2 : ℝ) ^ (C * gaussWidth T / ε)) ∧
          (∀ s ∈ S, 0 ≤ c s ∧ c s ≤ gaussWidth T) ∧
          ∫ g, |supFun T g - S.sup' hS (fun s => dotR g s + c s)| ∂(gaussMeasure n)
            ≤ ε := by
  sorry

/-- Part (ii): relative-error, dimension-independent sparsification:
`|S| ≤ 2^{2^{C/α}}` and `E|sup_T X_t - max_S (X_s + c_s)| ≤ α E sup_T X_t`. [SparsifyingSupremaOfGaussian, node_03] -/
theorem sparsify_relative :
    ∃ C : ℝ, 0 < C ∧ ∀ (n : ℕ) (T : Set (Fin n → ℝ)) (α : ℝ),
      T.Nonempty → IsBoundedR T → 0 < α →
      ∃ (S : Finset (Fin n → ℝ)) (hS : S.Nonempty), (↑S : Set (Fin n → ℝ)) ⊆ T ∧
        ∃ c : (Fin n → ℝ) → ℝ,
          (S.card : ℝ) ≤ (2 : ℝ) ^ ((2 : ℝ) ^ (C / α)) ∧
          ∫ g, |supFun T g - S.sup' hS (fun s => dotR g s + c s)| ∂(gaussMeasure n)
            ≤ α * gaussWidth T := by
  sorry

end TCSChallenge.SparsifyingSupremaOfGaussianProcesses.node_03
