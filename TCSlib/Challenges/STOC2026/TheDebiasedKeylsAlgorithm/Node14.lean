/-!
## Debiased Keyl estimator with k-copy entanglement (node_14)

Split the `n` copies into `n' = n/k` blocks of `k` copies each. On every block, run the Keyl
measurement and form the debiased estimate `X_b = U diag(λ↑/k) U†`. Then average:
`ρ̂ = (1/n') ∑_b X_b`. The supplied facts are unbiasedness, independence across blocks and
`E[ℓ(λ)] ≤ 2√k`. Add the one-block variance bound `V(X) ≤ 2d/k + d² E[ℓ]/k²`. Then some absolute
`C` has the following property: `n ≥ C max{d³/(√k ε²), d²/ε²}` implies
`Pr[D_tr(ρ, ρ̂) ≤ ε] ≥ 0.9`.

Main theorem: `blockKeyl_traceDistance`.
-/

open Matrix MeasureTheory ProbabilityTheory
open scoped ComplexOrder

namespace TCSChallenge.TheDebiasedKeylsAlgorithm.node_14

/-- `d × d` complex matrices. -/
abbrev CMat (d : ℕ) := Matrix (Fin d) (Fin d) ℂ

/-- "a weakly decreasing sequence of nonnegative integers λ = (λ_1,…,λ_d) satisfying
∑ λ_i = n". -/
def IsPartitionOf {d : ℕ} (n : ℕ) (lam : Fin d → ℕ) : Prop :=
  Antitone lam ∧ ∑ i, lam i = n

/-- "ℓ(λ) = |{i : λ_i > 0}|". -/
def ell {d : ℕ} (lam : Fin d → ℕ) : ℕ :=
  (Finset.univ.filter (fun i => 0 < lam i)).card

/-- "donate(λ)_i = λ_i - ∑_{j<i} 1[λ_j > λ_i] + ∑_{j>i} 1[λ_i > λ_j]" (an integer). -/
def donate {d : ℕ} (lam : Fin d → ℕ) (i : Fin d) : ℤ :=
  (lam i : ℤ) - ((Finset.univ.filter (fun j => j < i ∧ lam i < lam j)).card : ℤ)
    + ((Finset.univ.filter (fun j => i < j ∧ lam j < lam i)).card : ℤ)

/-- The debiased Keyl estimator "ρ̂ = ∑_i (λ_i↑ / m) |u_i⟩⟨u_i| = U diag(λ↑/m) U†",
where `m` is the number of copies measured. -/
def keylEstimator {d : ℕ} (m : ℕ) (lam : Fin d → ℕ) (U : CMat d) : CMat d :=
  U * Matrix.diagonal (fun i => (((donate lam i : ℝ) / (m : ℝ) : ℝ) : ℂ)) * Uᴴ

/-- Squared Hilbert–Schmidt norm `‖A‖₂² = ∑_{i,j} |A_{ij}|²`. -/
def hsSq {d : ℕ} (A : CMat d) : ℝ :=
  ∑ i, ∑ j, Complex.normSq (A i j)

/-- Trace (Schatten-1) norm, defined variationally as `‖A‖₁ = sup_{W unitary} Re tr(W A)`. -/
def traceNorm {d : ℕ} (A : CMat d) : ℝ :=
  ⨆ W : {W : CMat d // W ∈ Matrix.unitaryGroup (Fin d) ℂ}, (Matrix.trace (W.1 * A)).re

/-- "D_tr(ρ, ρ̂) = ½ ‖ρ - ρ̂‖₁". -/
def traceDist {d : ℕ} (A B : CMat d) : ℝ :=
  traceNorm (A - B) / 2

/-- A quantum state: "ρ ⪰ 0, tr ρ = 1". -/
def IsDensity {d : ℕ} (ρ : CMat d) : Prop :=
  ρ.PosSemidef ∧ ρ.trace = 1

/-! ### Block construction -/

/-- Block estimate `X_b = U_b diag(λ_b↑/k) U_b†` from the Keyl outcome on block `b`. -/
def blockX {d n' : ℕ} (k : ℕ) {Ω : Type} (lam : Fin n' → Ω → Fin d → ℕ)
    (U : Fin n' → Ω → CMat d) (b : Fin n') (ω : Ω) : CMat d :=
  keylEstimator k (lam b ω) (U b ω)

/-- Entry vector of a block estimate. It is measurable-space friendly and is used to state
block independence. -/
def blockEntries {d n' : ℕ} (k : ℕ) {Ω : Type} (lam : Fin n' → Ω → Fin d → ℕ)
    (U : Fin n' → Ω → CMat d) (b : Fin n') (ω : Ω) : Fin d × Fin d → ℂ :=
  fun p => blockX k lam U b ω p.1 p.2

/-- The averaged estimator `ρ̂ = (1/n') ∑_b X_b`. -/
def blockAverage {d n' : ℕ} (k : ℕ) {Ω : Type} (lam : Fin n' → Ω → Fin d → ℕ)
    (U : Fin n' → Ω → CMat d) (ω : Ω) : CMat d :=
  ((1 : ℂ) / (n' : ℂ)) • ∑ b, blockX k lam U b ω

/-- **The decisive one-block assertion** (the estimator-specific statement the blueprint must
establish via the Keyl measurement): for every block, `‖X_b - ρ‖₂²` is integrable and
`E‖X_b - ρ‖₂² ≤ 2d/k + d² E[ℓ(λ_b)]/k²`. -/
def OneBlockVarianceBound {d n' : ℕ} (k : ℕ) (ρ : CMat d) {Ω : Type} [MeasurableSpace Ω]
    (μ : Measure Ω) (lam : Fin n' → Ω → Fin d → ℕ) (U : Fin n' → Ω → CMat d) : Prop :=
  ∀ b : Fin n',
    Integrable (fun ω => hsSq (blockX k lam U b ω - ρ)) μ ∧
    ∫ ω, hsSq (blockX k lam U b ω - ρ) ∂μ ≤
      2 * (d : ℝ) / (k : ℝ) + (d : ℝ) ^ 2 * (∫ ω, (ell (lam b ω) : ℝ) ∂μ) / (k : ℝ) ^ 2

/-! ### Lemma stubs (rubric items) -/

/-- Partition-height control: plugging `E[ℓ] ≤ 2√k` into the one-block bound gives
`E‖X_b - ρ‖₂² ≤ 2d/k + 2d²/k^{3/2}`. [TheDebiasedKeylsAlgorithm, node_14] -/
theorem oneBlock_variance_height {d n' k : ℕ} (ρ : CMat d) {Ω : Type} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (lam : Fin n' → Ω → Fin d → ℕ)
    (U : Fin n' → Ω → CMat d) (hk : 1 ≤ k)
    (hvar : OneBlockVarianceBound k ρ μ lam U)
    (hheight : ∀ b, ∫ ω, (ell (lam b ω) : ℝ) ∂μ ≤ 2 * Real.sqrt (k : ℝ)) (b : Fin n') :
    ∫ ω, hsSq (blockX k lam U b ω - ρ) ∂μ ≤
      2 * (d : ℝ) / (k : ℝ) + 2 * (d : ℝ) ^ 2 / ((k : ℝ) * Real.sqrt (k : ℝ)) := by
  sorry

/-- Independent averaging: unbiasedness and independence make the Hilbert–Schmidt cross terms
vanish, so `E‖ρ̂ - ρ‖₂² ≤ 2d/n + 2d²/(n√k)` with `n = n' k`. [TheDebiasedKeylsAlgorithm, node_14] -/
theorem average_variance_le {d n' k : ℕ} (ρ : CMat d) {Ω : Type} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (lam : Fin n' → Ω → Fin d → ℕ)
    (U : Fin n' → Ω → CMat d) (hk : 1 ≤ k) (hn' : 1 ≤ n')
    (hpart : ∀ b ω, IsPartitionOf k (lam b ω))
    (hU : ∀ b ω, U b ω ∈ Matrix.unitaryGroup (Fin d) ℂ)
    (hindep : iIndepFun (fun b => blockEntries k lam U b) μ)
    (hintX : ∀ b i j, Integrable (fun ω => blockX k lam U b ω i j) μ)
    (hunbiased : ∀ b i j, ∫ ω, blockX k lam U b ω i j ∂μ = ρ i j)
    (hvar : OneBlockVarianceBound k ρ μ lam U)
    (hheight : ∀ b, ∫ ω, (ell (lam b ω) : ℝ) ∂μ ≤ 2 * Real.sqrt (k : ℝ)) :
    ∫ ω, hsSq (blockAverage k lam U ω - ρ) ∂μ ≤
      2 * (d : ℝ) / ((n' : ℝ) * k) +
        2 * (d : ℝ) ^ 2 / ((n' : ℝ) * k * Real.sqrt (k : ℝ)) := by
  sorry

/-- Supplied norm comparison, squared form: `D_tr(A, B)² ≤ (d/4) ‖A - B‖₂²` for Hermitian
`A - B`. [TheDebiasedKeylsAlgorithm, node_14] -/
theorem traceDist_sq_le {d : ℕ} (A B : CMat d) (hAB : (A - B).IsHermitian) :
    traceDist A B ^ 2 ≤ (d : ℝ) / 4 * hsSq (B - A) := by
  sorry

/-! ### Main theorem -/

/-- **Block-entangled debiased Keyl tomography.** There is an absolute constant `C > 0` with the
following property. Use blocks of `k` copies and `n'` blocks, so `n = n' k`. Assume unbiased,
independent block estimates with `E[ℓ(λ)] ≤ 2√k`, together with the one-block variance bound.
Then `n ≥ C max{d³/(√k ε²), d²/ε²}` gives `Pr[D_tr(ρ, ρ̂) ≤ ε] ≥ 0.9`. [TheDebiasedKeylsAlgorithm, node_14] -/
theorem blockKeyl_traceDistance :
    ∃ C : ℝ, 0 < C ∧
      ∀ (d k n' : ℕ) (ε : ℝ) (ρ : CMat d) {Ω : Type} [MeasurableSpace Ω]
        (μ : Measure Ω) [IsProbabilityMeasure μ]
        (lam : Fin n' → Ω → Fin d → ℕ) (U : Fin n' → Ω → CMat d),
        2 ≤ d → 1 ≤ k → 1 ≤ n' → 0 < ε → ε < 1 →
        IsDensity ρ →
        (∀ b ω, IsPartitionOf k (lam b ω)) →
        (∀ b ω, U b ω ∈ Matrix.unitaryGroup (Fin d) ℂ) →
        iIndepFun (fun b => blockEntries k lam U b) μ →
        (∀ b i j, Integrable (fun ω => blockX k lam U b ω i j) μ) →
        (∀ b i j, ∫ ω, blockX k lam U b ω i j ∂μ = ρ i j) →
        (∀ b, ∫ ω, (ell (lam b ω) : ℝ) ∂μ ≤ 2 * Real.sqrt (k : ℝ)) →
        OneBlockVarianceBound k ρ μ lam U →
        C * max ((d : ℝ) ^ 3 / (Real.sqrt (k : ℝ) * ε ^ 2)) ((d : ℝ) ^ 2 / ε ^ 2)
          ≤ (n' : ℝ) * (k : ℝ) →
        ENNReal.ofReal (9 / 10) ≤ μ {ω | traceDist ρ (blockAverage k lam U ω) ≤ ε} := by
  sorry

end TCSChallenge.TheDebiasedKeylsAlgorithm.node_14
