/-!
## Debiased Keyl estimator: low-rank trace-distance guarantee (node_09)

A Keyl measurement on `ρ^{⊗n}` returns a partition `λ ⊢ n` with at most `d` rows and a unitary
`U`. The debiased estimator is `ρ̂ = U diag(λ↑/n) U†`, where `λ↑ = donate(λ)`. Suppose
`rank ρ ≤ r`. The problem supplies two facts: `ℓ(λ) ≤ r` almost surely, and
`E‖ρ̂ - ρ‖₂² ≤ 2d/n + d² E[ℓ(λ)]/n²`. From these, the claim is that for every `δ ∈ (0,1)` some
`C_δ > 0` has the following property: `n ≥ C_δ r d / ε²` implies
`Pr[D_tr(ρ, ρ̂) ≤ ε] ≥ 1 - δ`.

The proof splits `ρ̂` into a head of rank ≤ ℓ(λ) and a scalar negative residual on the zero rows.
The residual has trace norm `ℓ(d-ℓ)/n`. A sign argument shows that the head's Hilbert–Schmidt
error is at most the full error. The rank-`2r` norm conversion then costs `√(2r)`, and Markov's
inequality finishes.

Main theorem: `debiasedKeyl_lowRank_traceDistance`.
-/

open Matrix MeasureTheory ProbabilityTheory
open scoped ComplexOrder

namespace TCSChallenge.TheDebiasedKeylsAlgorithm.node_09

/-- `d × d` complex matrices. -/
abbrev CMat (d : ℕ) := Matrix (Fin d) (Fin d) ℂ

/-- "a weakly decreasing sequence of nonnegative integers λ = (λ_1,…,λ_d) satisfying
∑ λ_i = n". -/
def IsPartitionOf {d : ℕ} (n : ℕ) (lam : Fin d → ℕ) : Prop :=
  Antitone lam ∧ ∑ i, lam i = n

/-- "ℓ(λ) = |{i : λ_i > 0}|". -/
def ell {d : ℕ} (lam : Fin d → ℕ) : ℕ :=
  (Finset.univ.filter (fun i => 0 < lam i)).card

/-- "donate(λ)_i = λ_i - ∑_{j<i} 1[λ_j > λ_i] + ∑_{j>i} 1[λ_i > λ_j]" (an integer). -/
def donate {d : ℕ} (lam : Fin d → ℕ) (i : Fin d) : ℤ :=
  (lam i : ℤ) - ((Finset.univ.filter (fun j => j < i ∧ lam i < lam j)).card : ℤ)
    + ((Finset.univ.filter (fun j => i < j ∧ lam j < lam i)).card : ℤ)

/-- The debiased Keyl estimator "ρ̂ = ∑_i (λ_i↑ / m) |u_i⟩⟨u_i| = U diag(λ↑/m) U†",
where `m` is the number of copies measured. -/
def keylEstimator {d : ℕ} (m : ℕ) (lam : Fin d → ℕ) (U : CMat d) : CMat d :=
  U * Matrix.diagonal (fun i => (((donate lam i : ℝ) / (m : ℝ) : ℝ) : ℂ)) * Uᴴ

/-- Squared Hilbert–Schmidt norm `‖A‖₂² = ∑_{i,j} |A_{ij}|²`. -/
def hsSq {d : ℕ} (A : CMat d) : ℝ :=
  ∑ i, ∑ j, Complex.normSq (A i j)

/-- Trace (Schatten-1) norm, defined variationally as `‖A‖₁ = sup_{W unitary} Re tr(W A)`. -/
def traceNorm {d : ℕ} (A : CMat d) : ℝ :=
  ⨆ W : {W : CMat d // W ∈ Matrix.unitaryGroup (Fin d) ℂ}, (Matrix.trace (W.1 * A)).re

/-- "D_tr(ρ, ρ̂) = ½ ‖ρ - ρ̂‖₁". -/
def traceDist {d : ℕ} (A B : CMat d) : ℝ :=
  traceNorm (A - B) / 2

/-- A quantum state: "ρ ⪰ 0, tr ρ = 1". -/
def IsDensity {d : ℕ} (ρ : CMat d) : Prop :=
  ρ.PosSemidef ∧ ρ.trace = 1

/-! ### Objects specific to the low-rank argument -/

/-- The head of the estimator: keep only the donated coordinates on the rows with `λ_i > 0`
(for a partition these are exactly the indices `i ≤ ℓ(λ)`). -/
def headEstimator {d : ℕ} (m : ℕ) (lam : Fin d → ℕ) (U : CMat d) : CMat d :=
  U * Matrix.diagonal
    (fun i => if 0 < lam i then (((donate lam i : ℝ) / (m : ℝ) : ℝ) : ℂ) else 0) * Uᴴ

/-- The residual `ρ̂ - head`, supported on the zero rows of `λ`. -/
def residualEstimator {d : ℕ} (m : ℕ) (lam : Fin d → ℕ) (U : CMat d) : CMat d :=
  keylEstimator m lam U - headEstimator m lam U

/-! ### Lemma stubs (rubric items) -/

/-- Supplied standard inequality: `‖A‖₁ ≤ √(rank A) ‖A‖₂` for Hermitian `A`. [TheDebiasedKeylsAlgorithm, node_09] -/
theorem traceNorm_le_sqrt_rank_mul_hs {d : ℕ} (A : CMat d) (hA : A.IsHermitian) :
    traceNorm A ≤ Real.sqrt (A.rank : ℝ) * Real.sqrt (hsSq A) := by
  sorry

/-- Donated zero-row spectrum: if `λ` is weakly decreasing and `λ_i = 0`, then
`λ↑_i = -ℓ(λ)`. [TheDebiasedKeylsAlgorithm, node_09] -/
theorem donate_of_eq_zero {d : ℕ} (lam : Fin d → ℕ) (hlam : Antitone lam) (i : Fin d)
    (hi : lam i = 0) :
    donate lam i = -((ell lam : ℕ) : ℤ) := by
  sorry

/-- The residual has trace norm exactly `ℓ(λ)(d - ℓ(λ))/n`. [TheDebiasedKeylsAlgorithm, node_09] -/
theorem traceNorm_residual {d n : ℕ} (lam : Fin d → ℕ) (U : CMat d) (hn : 1 ≤ n)
    (hlam : IsPartitionOf n lam) (hU : U ∈ Matrix.unitaryGroup (Fin d) ℂ) :
    traceNorm (residualEstimator n lam U) =
      (ell lam : ℝ) * ((d : ℝ) - (ell lam : ℝ)) / (n : ℝ) := by
  sorry

/-- The head has rank at most `ℓ(λ)`. [TheDebiasedKeylsAlgorithm, node_09] -/
theorem rank_headEstimator_le {d n : ℕ} (lam : Fin d → ℕ) (U : CMat d)
    (hU : U ∈ Matrix.unitaryGroup (Fin d) ℂ) :
    (headEstimator n lam U).rank ≤ ell lam := by
  sorry

/-- Low-rank reduction: if `ℓ(λ) ≤ r` and `rank ρ ≤ r`, the head error has rank at most `2r`. [TheDebiasedKeylsAlgorithm, node_09] -/
theorem rank_head_sub_le {d n r : ℕ} (lam : Fin d → ℕ) (U : CMat d) (ρ : CMat d)
    (hU : U ∈ Matrix.unitaryGroup (Fin d) ℂ) (hell : ell lam ≤ r) (hρ : ρ.rank ≤ r) :
    (headEstimator n lam U - ρ).rank ≤ 2 * r := by
  sorry

/-- Second-moment transfer: the head's Hilbert–Schmidt error is at most the full estimator's.
Proof idea: the supports are orthogonal, and `-tr(ρ · residual) ≥ 0` since `ρ ⪰ 0` and the
residual is a nonpositive multiple of a projector. [TheDebiasedKeylsAlgorithm, node_09] -/
theorem hsSq_head_le {d n : ℕ} (lam : Fin d → ℕ) (U : CMat d) (ρ : CMat d) (hn : 1 ≤ n)
    (hlam : IsPartitionOf n lam) (hU : U ∈ Matrix.unitaryGroup (Fin d) ℂ)
    (hρ : ρ.PosSemidef) :
    hsSq (headEstimator n lam U - ρ) ≤ hsSq (keylEstimator n lam U - ρ) := by
  sorry

/-- Deterministic head-plus-residual bound: if `ℓ(λ) ≤ r` and `rank ρ ≤ r`, then
`D_tr(ρ, ρ̂) ≤ (√(2r)/2) ‖ρ̂ - ρ‖₂ + r d/(2n)`. [TheDebiasedKeylsAlgorithm, node_09] -/
theorem traceDist_le_head_residual {d n r : ℕ} (lam : Fin d → ℕ) (U : CMat d) (ρ : CMat d)
    (hn : 1 ≤ n) (hlam : IsPartitionOf n lam) (hU : U ∈ Matrix.unitaryGroup (Fin d) ℂ)
    (hρ : IsDensity ρ) (hρr : ρ.rank ≤ r) (hell : ell lam ≤ r) :
    traceDist ρ (keylEstimator n lam U) ≤
      Real.sqrt (2 * (r : ℝ)) / 2 * Real.sqrt (hsSq (keylEstimator n lam U - ρ))
        + (r : ℝ) * (d : ℝ) / (2 * (n : ℝ)) := by
  sorry

/-- Expected trace-distance bound:
`E[D_tr] ≤ (√(2r)/2) √(2d/n + r d²/n²) + r d/(2n)`. [TheDebiasedKeylsAlgorithm, node_09] -/
theorem expected_traceDist_le {d r n : ℕ} (ρ : CMat d) {Ω : Type} [MeasurableSpace Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ] (lam : Ω → Fin d → ℕ) (U : Ω → CMat d)
    (hn : 1 ≤ n) (hρ : IsDensity ρ) (hρr : ρ.rank ≤ r)
    (hpart : ∀ ω, IsPartitionOf n (lam ω))
    (hU : ∀ ω, U ω ∈ Matrix.unitaryGroup (Fin d) ℂ)
    (hell : ∀ᵐ ω ∂μ, ell (lam ω) ≤ r)
    (hint : Integrable (fun ω => hsSq (keylEstimator n (lam ω) (U ω) - ρ)) μ)
    (hsecond : ∫ ω, hsSq (keylEstimator n (lam ω) (U ω) - ρ) ∂μ ≤
      2 * (d : ℝ) / (n : ℝ) + (d : ℝ) ^ 2 * (∫ ω, (ell (lam ω) : ℝ) ∂μ) / (n : ℝ) ^ 2) :
    ∫ ω, traceDist ρ (keylEstimator n (lam ω) (U ω)) ∂μ ≤
      Real.sqrt (2 * (r : ℝ)) / 2 *
          Real.sqrt (2 * (d : ℝ) / (n : ℝ) + (r : ℝ) * (d : ℝ) ^ 2 / (n : ℝ) ^ 2)
        + (r : ℝ) * (d : ℝ) / (2 * (n : ℝ)) := by
  sorry

/-! ### Main theorem -/

/-- **Low-rank tomography with the debiased Keyl estimator.** For each `δ ∈ (0,1)` there is
`C_δ > 0`, depending only on `δ`, with the following property. Let `ρ` be a state of rank
≤ `r`, and suppose the outcome law satisfies the supplied facts (ℓ(λ) ≤ r a.s. and the
second-moment bound). Then `n ≥ C_δ r d / ε²` gives `Pr[D_tr(ρ, ρ̂) ≤ ε] ≥ 1 - δ`. [TheDebiasedKeylsAlgorithm, node_09] -/
theorem debiasedKeyl_lowRank_traceDistance :
    ∀ δ : ℝ, 0 < δ → δ < 1 → ∃ C : ℝ, 0 < C ∧
      ∀ (d r n : ℕ) (ε : ℝ) (ρ : CMat d) {Ω : Type} [MeasurableSpace Ω]
        (μ : Measure Ω) [IsProbabilityMeasure μ] (lam : Ω → Fin d → ℕ) (U : Ω → CMat d),
        2 ≤ d → 1 ≤ r → r ≤ d → 0 < ε → ε < 1 → 1 ≤ n →
        IsDensity ρ → ρ.rank ≤ r →
        (∀ ω, IsPartitionOf n (lam ω)) →
        (∀ ω, U ω ∈ Matrix.unitaryGroup (Fin d) ℂ) →
        (∀ᵐ ω ∂μ, ell (lam ω) ≤ r) →
        Integrable (fun ω => hsSq (keylEstimator n (lam ω) (U ω) - ρ)) μ →
        (∫ ω, hsSq (keylEstimator n (lam ω) (U ω) - ρ) ∂μ ≤
          2 * (d : ℝ) / (n : ℝ) + (d : ℝ) ^ 2 * (∫ ω, (ell (lam ω) : ℝ) ∂μ) / (n : ℝ) ^ 2) →
        C * (r : ℝ) * (d : ℝ) / ε ^ 2 ≤ (n : ℝ) →
        ENNReal.ofReal (1 - δ) ≤ μ {ω | traceDist ρ (keylEstimator n (lam ω) (U ω)) ≤ ε} := by
  sorry

end TCSChallenge.TheDebiasedKeylsAlgorithm.node_09
