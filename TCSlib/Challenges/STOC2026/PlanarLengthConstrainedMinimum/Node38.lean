/-!
## Hardness of bicriteria length-constrained MST for slack `s < 2`

A length-constrained MST instance is a graph with nonnegative integral weights `w` and
lengths `ℓ` on its edges, a root `r` and a budget `H`. A spanning tree `T` is
`s`-feasible if `d_T(r, v) ≤ s H` for every vertex `v`.

From a rooted Group Steiner Tree instance `(F, r, g_1, …, g_k)` (nonempty groups) we build the
graph `G` on `V(F) ∪ {x_{i,v} : v ∈ g_i} ∪ {y_u : u ≠ r}` with
* original edges of `F` (weight `w_F`, length 0);
* pull edges `v x_{i,v}` (weight 0, length 1);
* cliques on each `X_i` (weight 0, length 0);
* paths `r – y_u – u` (`r y_u`: weight 0, length 1; `y_u u`: weight 0, length 0),
and take budget `H = 1`.

Main theorem `approx_transfer`: for every `s < 2`, every spanning tree of `G` with all root
distances at most `s` whose weight is within factor `a ≥ 0` of every exactly feasible tree
yields a feasible Group Steiner subtree within factor `a` of every Group Steiner solution.
-/

namespace TCSChallenge.PlanarLengthConstrainedMinimumSpanningTrees.node_38

/-! ## Length-constrained spanning trees -/

/-- "Let G be an undirected graph with nonnegative integral edge weights and lengths, let
r ∈ V(G)." -/
structure LCInstance (V : Type) where
  /-- The graph `G`. -/
  G : SimpleGraph V
  /-- Edge weights `w` (nonnegative integers). -/
  w : Sym2 V → ℕ
  /-- Edge lengths `ℓ` (nonnegative integers). -/
  len : Sym2 V → ℕ
  /-- The root `r`. -/
  root : V

/-- Length of a walk: sum of the lengths of its edges. -/
def walkLen {V : Type} {T : SimpleGraph V} (len : Sym2 V → ℕ) {a b : V} (p : T.Walk a b) : ℕ :=
  (p.edges.map len).sum

/-- `w(T)`: total weight of the edges of a subgraph `T`. -/
def treeWeight {V : Type} [Fintype V] (w : Sym2 V → ℕ) (T : SimpleGraph V) : ℕ :=
  ∑ e ∈ Finset.univ.filter (fun e => e ∈ T.edgeSet), w e

/-- `d_T(r, v) ≤ B` for every `v ∈ V(G)`, distances measured with edge lengths. Since lengths
are nonnegative, `d_T(r,v) ≤ B` iff some `r`-`v` walk in `T` has length at most `B`. -/
def RootDistWithin {V : Type} (I : LCInstance V) (T : SimpleGraph V) (B : ℝ) : Prop :=
  ∀ v : V, ∃ p : T.Walk I.root v, ((walkLen I.len p : ℕ) : ℝ) ≤ B

/-- `T` is a spanning tree of `G`. -/
def IsSpanningTreeOf {V : Type} (G T : SimpleGraph V) : Prop :=
  T ≤ G ∧ T.IsTree

/-! ## Group Steiner Tree -/

/-- "A rooted Group Steiner Tree instance consists of a nonnegatively edge-weighted graph F,
a root r, and explicitly listed groups g_1,…,g_k ⊆ V(F)." -/
structure GSTInstance (U : Type) (k : ℕ) where
  /-- The graph `F`. -/
  F : SimpleGraph U
  /-- Edge weights `w_F`. -/
  w : Sym2 U → ℕ
  /-- The root `r`. -/
  root : U
  /-- The groups `g_1, …, g_k`. -/
  group : Fin k → Finset U

/-- "explicitly listed nonempty groups". -/
def GSTInstance.Valid {U : Type} {k : ℕ} (J : GSTInstance U k) : Prop :=
  ∀ i : Fin k, (J.group i).Nonempty

/-- "A feasible solution is a connected subtree containing r and at least one vertex from
each group." -/
def IsGSTSolution {U : Type} {k : ℕ} (J : GSTInstance U k) (Q : J.F.Subgraph) : Prop :=
  J.root ∈ Q.verts ∧ Q.coe.IsTree ∧ ∀ i : Fin k, ∃ v ∈ J.group i, v ∈ Q.verts

/-- Weight `w_F(Q)` of a Group Steiner subtree. -/
def gstWeight {U : Type} [Fintype U] {k : ℕ} (J : GSTInstance U k) (Q : J.F.Subgraph) : ℕ :=
  ∑ e ∈ Finset.univ.filter (fun e => e ∈ Q.edgeSet), J.w e

/-! ## The reduction -/

/-- Vertex set `V(F) ∪ {x_{i,v} : v ∈ g_i} ∪ {y_u : u ∈ V(F) \ {r}}`. -/
abbrev RVert {U : Type} {k : ℕ} (J : GSTInstance U k) : Type :=
  U ⊕ ((Σ i : Fin k, {v : U // v ∈ J.group i}) ⊕ {u : U // u ≠ J.root})

/-- Base adjacency relation of the reduction graph (symmetrized by `SimpleGraph.fromRel`):
original edges of `F`; pull edges `v x_{i,v}`; cliques on each `X_i`; edges `r y_u`, `y_u u`. -/
def baseRel {U : Type} {k : ℕ} (J : GSTInstance U k) : RVert J → RVert J → Prop
  | Sum.inl a, Sum.inl b => J.F.Adj a b
  | Sum.inl a, Sum.inr (Sum.inl x) => a = x.2.1
  | Sum.inr (Sum.inl x), Sum.inr (Sum.inl y) => x.1 = y.1
  | Sum.inl a, Sum.inr (Sum.inr u) => a = J.root ∨ a = u.1
  | _, _ => False

/-- The reduction graph `G`. -/
def redGraph {U : Type} {k : ℕ} (J : GSTInstance U k) : SimpleGraph (RVert J) :=
  SimpleGraph.fromRel (baseRel J)

/-- Original vertices `u ∈ V(F)`. -/
def isOrig {U : Type} {k : ℕ} {J : GSTInstance U k} : RVert J → Bool
  | Sum.inl _ => true
  | _ => false

/-- Group copy vertices `x_{i,v}`. -/
def isCopy {U : Type} {k : ℕ} {J : GSTInstance U k} : RVert J → Bool
  | Sum.inr (Sum.inl _) => true
  | _ => false

/-- Auxiliary subdivision vertices `y_u`. -/
def isAux {U : Type} {k : ℕ} {J : GSTInstance U k} : RVert J → Bool
  | Sum.inr (Sum.inr _) => true
  | _ => false

/-- Projection to `V(F)` (only used on original vertices). -/
def proj {U : Type} {k : ℕ} {J : GSTInstance U k} : RVert J → U
  | Sum.inl u => u
  | _ => J.root

/-- Weights: an edge between two original vertices keeps its weight `w_F`; every other edge
has weight 0. -/
def redWeight {U : Type} {k : ℕ} (J : GSTInstance U k) (e : Sym2 (RVert J)) : ℕ :=
  if ∀ x ∈ e, isOrig x = true then J.w (Sym2.map (proj (J := J)) e) else 0

/-- Lengths: pull edges (original–copy) and edges `r y_u` have length 1; all other edges
(original edges, clique edges, `y_u u`) have length 0. -/
def redLen {U : Type} {k : ℕ} (J : GSTInstance U k) (e : Sym2 (RVert J)) : ℕ :=
  if (∃ x ∈ e, isCopy x = true) ∧ (∃ x ∈ e, isOrig x = true) then 1
  else if (∃ x ∈ e, x = (Sum.inl J.root : RVert J)) ∧ (∃ x ∈ e, isAux x = true) then 1
  else 0

/-- The length-constrained MST instance `(G, r)` (used with budget `H = 1`). -/
def redInstance {U : Type} {k : ℕ} (J : GSTInstance U k) : LCInstance (RVert J) where
  G := redGraph J
  w := redWeight J
  len := redLen J
  root := Sum.inl J.root

/-! ## Claims -/

/-- Size: `|V(G)| = 2|V(F)| - 1 + M`, where `M = Σ_i |g_i|`. [PlanarLengthConstrainedMinimum, node_38] -/
theorem card_redVert {U : Type} [Fintype U] {k : ℕ} (J : GSTInstance U k) :
    Fintype.card (RVert J) = 2 * Fintype.card U - 1 + ∑ i : Fin k, (J.group i).card := by
  sorry

/-- A connected spanning subgraph in which every vertex is at distance at most `B` from the
root contains a spanning tree with the same distance guarantee and no larger weight. [PlanarLengthConstrainedMinimum, node_38] -/
theorem exists_spanning_tree_of_rootDist {V : Type} [Fintype V] (I : LCInstance V)
    (S : SimpleGraph V) (B : ℝ) (hS : S ≤ I.G) (hdist : RootDistWithin I S B) :
    ∃ T : SimpleGraph V, IsSpanningTreeOf I.G T ∧ T ≤ S ∧ RootDistWithin I T B ∧
      treeWeight I.w T ≤ treeWeight I.w S := by
  sorry

/-- Claim 1 (completeness): every feasible Group Steiner subtree `Q` yields a spanning tree of
`G` with all root distances at most `1` and weight at most `w_F(Q)`. [PlanarLengthConstrainedMinimum, node_38] -/
theorem completeness {U : Type} [Fintype U] {k : ℕ} (J : GSTInstance U k) (hJ : J.Valid)
    (Q : J.F.Subgraph) (hQ : IsGSTSolution J Q) :
    ∃ T : SimpleGraph (RVert J), IsSpanningTreeOf (redGraph J) T ∧
      RootDistWithin (redInstance J) T 1 ∧ treeWeight (redWeight J) T ≤ gstWeight J Q := by
  sorry

/-- Claim 2 (short-path soundness): every spanning tree of `G` with all root distances at most
`s < 2` yields a feasible Group Steiner subtree (the root component of `T ∩ E(F)`) of weight at
most `w_G(T)`. [PlanarLengthConstrainedMinimum, node_38] -/
theorem soundness {U : Type} [Fintype U] {k : ℕ} (J : GSTInstance U k) (hJ : J.Valid)
    (s : ℝ) (hs : s < 2) (T : SimpleGraph (RVert J)) (hT : IsSpanningTreeOf (redGraph J) T)
    (hdist : RootDistWithin (redInstance J) T s) :
    ∃ Q : J.F.Subgraph, IsGSTSolution J Q ∧ gstWeight J Q ≤ treeWeight (redWeight J) T := by
  sorry

/-- `OPT_1(G) = OPT_GST(F)`, stated without `sInf`: the two problems achieve exactly the same
weight thresholds. [PlanarLengthConstrainedMinimum, node_38] -/
theorem opt_eq {U : Type} [Fintype U] {k : ℕ} (J : GSTInstance U k) (hJ : J.Valid) (c : ℕ) :
    (∃ T : SimpleGraph (RVert J), IsSpanningTreeOf (redGraph J) T ∧
        RootDistWithin (redInstance J) T 1 ∧ treeWeight (redWeight J) T ≤ c) ↔
      (∃ Q : J.F.Subgraph, IsGSTSolution J Q ∧ gstWeight J Q ≤ c) := by
  sorry

/-- Main theorem (approximation transfer): let `1 ≤ s < 2` and `a ≥ 0`. If a spanning tree `T`
of `G` has all root distances at most `s · H = s` and weight at most `a · w(T')` for every
spanning tree `T'` with all root distances at most `H = 1` (i.e. `w(T) ≤ a · OPT_1(G)`),
then some feasible Group Steiner subtree `Q_T` satisfies `w_F(Q_T) ≤ a · w_F(Q')` for every
feasible Group Steiner subtree `Q'` (i.e. `w_F(Q_T) ≤ a · OPT_GST(F)`). [PlanarLengthConstrainedMinimum, node_38] -/
theorem approx_transfer {U : Type} [Fintype U] {k : ℕ} (J : GSTInstance U k) (hJ : J.Valid)
    (s a : ℝ) (hs1 : 1 ≤ s) (hs2 : s < 2) (ha : 0 ≤ a)
    (T : SimpleGraph (RVert J)) (hT : IsSpanningTreeOf (redGraph J) T)
    (hdist : RootDistWithin (redInstance J) T (s * 1))
    (hratio : ∀ T' : SimpleGraph (RVert J), IsSpanningTreeOf (redGraph J) T' →
      RootDistWithin (redInstance J) T' 1 →
        ((treeWeight (redWeight J) T : ℕ) : ℝ) ≤ a * ((treeWeight (redWeight J) T' : ℕ) : ℝ)) :
    ∃ Q : J.F.Subgraph, IsGSTSolution J Q ∧
      ∀ Q' : J.F.Subgraph, IsGSTSolution J Q' →
        ((gstWeight J Q : ℕ) : ℝ) ≤ a * ((gstWeight J Q' : ℕ) : ℝ) := by
  sorry

end TCSChallenge.PlanarLengthConstrainedMinimumSpanningTrees.node_38
