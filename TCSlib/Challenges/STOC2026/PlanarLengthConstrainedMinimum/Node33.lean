/-!
## Planar length-constrained MST: combinatorial core of the `O(log^{1+ε} n)` bicriteria scheme

Let `G` be a graph with root `r`, nonnegative weights `w` and lengths `l`, and budget `h`.
The algorithm builds a hierarchy of regions, guesses discretized root distances
`g(Q) ∈ {0, h/β, …, h}` on interface pieces, solves few-terminal length-constrained Steiner
instances between a region and each child, and combines them by a bottom-up dynamic program.

This file states the analysis steps:
* `shortest_path_tree` — a connected subgraph contains a spanning tree preserving every root
  distance and of no larger weight;
* `local_walk_length` — with correct states the comparison walk has length `≤ h + 3h/β`;
* `dp_weight_induction` — `D[H, g] ≤ c α A · height(H) · q(H)`;
* `length_invariant_chain` — the telescoping bound `h - g(Q) + 3 i h/β`;
* `parameters_bound` — `α β^ξ d / ξ³ + α d ≤ C_ε (log n)^{1+ε}`;
* main theorem `planar_lcmst_extraction` — final assembly into a spanning tree `T` with
  `d_T(r,v) ≤ (1+ε) h` and `w(T) ≤ (c_B α d + K α A d) · OPT`.
-/

namespace TCSChallenge.PlanarLengthConstrainedMinimumSpanningTrees.node_33

/-! ## Weighted graphs with lengths -/

/-- "a connected … graph `G = (V, E)` with root `r`, nonnegative edge weights `w`,
nonnegative edge lengths `l`". -/
structure WLGraph (V : Type) where
  /-- The graph `G`. -/
  G : SimpleGraph V
  /-- Edge weights `w`. -/
  w : Sym2 V → ℝ
  /-- Edge lengths `l`. -/
  len : Sym2 V → ℝ
  /-- The root `r`. -/
  root : V

/-- Nonnegativity of weights and lengths. -/
def WLGraph.Nonneg {V : Type} (I : WLGraph V) : Prop :=
  ∀ e : Sym2 V, 0 ≤ I.w e ∧ 0 ≤ I.len e

/-- Length `l(P)` of a walk. -/
def walkLen {V : Type} {S : SimpleGraph V} (len : Sym2 V → ℝ) {a b : V} (p : S.Walk a b) : ℝ :=
  (p.edges.map len).sum

/-- Weight `w(S)` of a subgraph: the sum of the weights of its edges. -/
def subWeight {V : Type} [Fintype V] (w : Sym2 V → ℝ) (S : SimpleGraph V) : ℝ :=
  ∑ e ∈ Finset.univ.filter (fun e => e ∈ S.edgeSet), w e

/-- `d_S(r, v) ≤ B` for every `v ∈ V` (lengths are nonnegative, so this is witnessed by a walk). -/
def RootDistWithin {V : Type} (I : WLGraph V) (S : SimpleGraph V) (B : ℝ) : Prop :=
  ∀ v : V, ∃ p : S.Walk I.root v, walkLen I.len p ≤ B

/-- "`T` is a spanning tree of `G`". -/
def IsSpanningTreeOf {V : Type} (G T : SimpleGraph V) : Prop :=
  T ≤ G ∧ T.IsTree

/-! ## Step: shortest-path tree -/

/-- "Take a shortest-path tree of `S` rooted at `r` … It is a subgraph of `S`, so its weight is
at most `w(S)`, and it preserves all shortest distances from `r` in `S`." [PlanarLengthConstrainedMinimum, node_33] -/
theorem shortest_path_tree {V : Type} [Fintype V] (I : WLGraph V) (hI : I.Nonneg)
    (S : SimpleGraph V) (hS : S ≤ I.G) (hconn : ∀ v : V, Nonempty (S.Walk I.root v)) :
    ∃ T : SimpleGraph V, IsSpanningTreeOf I.G T ∧ T ≤ S ∧
      (∀ (v : V) (p : S.Walk I.root v), ∃ q : T.Walk I.root v, walkLen I.len q ≤ walkLen I.len p) ∧
      subWeight I.w T ≤ subWeight I.w S := by
  sorry

/-! ## Step: local feasibility estimate (length part) -/

/-- The comparison walk `s z_Q ⇝ a ⇝(R_x) x ⇝ z_{Q'} t_{Q'}` in `F(H,H',g,g')` has length
`≤ h + 3h/β` when the states are correct: `h*(Q) ≤ d_{T*}(r,a)`, `g(Q) ≤ h*(Q) + h/β`,
`h*(Q') = d_{T*}(r,x) ≤ g'(Q')`, `l(R_x) ≤ d_{T*}(r,x) - d_{T*}(r,a)`, and both in-piece paths
have length `≤ h/β` (piece diameter). [PlanarLengthConstrainedMinimum, node_33] -/
theorem local_walk_length (h β gQ gQ' hstarQ da dx lenIn lenR lenOut : ℝ)
    (hβ : 0 < β) (hstar_le : hstarQ ≤ da) (hg : gQ ≤ hstarQ + h / β)
    (hg' : dx ≤ gQ') (hin : lenIn ≤ h / β) (hR : lenR ≤ dx - da) (hout : lenOut ≤ h / β) :
    gQ + lenIn + lenR + lenOut + (h - gQ') ≤ h + 3 * h / β := by
  sorry

/-! ## Step: dynamic-programming weight induction -/

/-- Weight induction (3): regions `R` form a rooted hierarchy given by `children`, with heights
decreasing towards the leaves; the comparison numbers satisfy `q ≥ 0` and
`Σ_{K child of H} q(K) ≤ q(H)`; every region has at most `c α` children; and the DP value at a
correct state obeys `D[H] ≤ Σ_{H'} (D[H'] + A q(H))` (choosing the correct child state and using
the local bound (1)). Then `D[H] ≤ c α A · height(H) · q(H)`. [PlanarLengthConstrainedMinimum, node_33] -/
theorem dp_weight_induction {R : Type} (children : R → Finset R) (height : R → ℕ)
    (hheight : ∀ H K : R, K ∈ children H → height K + 1 ≤ height H)
    (q D : R → ℝ) (hq0 : ∀ H, 0 ≤ q H)
    (hq : ∀ H, ∑ K ∈ children H, q K ≤ q H)
    (c α A : ℝ) (hc : 0 ≤ c) (hα : 0 ≤ α) (hA : 0 ≤ A)
    (hdeg : ∀ H, ((children H).card : ℝ) ≤ c * α)
    (hD : ∀ H, D H ≤ ∑ K ∈ children H, (D K + A * q H)) :
    ∀ H : R, D H ≤ c * α * A * (height H : ℝ) * q H := by
  sorry

/-! ## Step: length invariant -/

/-- Telescoping invariant (5) along a chain of regions `H_0 ⊋ H_1 ⊋ … ⊋ H_m` (root to the region
containing `v` in its interface): `g j` is the selected guess of the piece used at level `j`,
`conn j` the length of the retained original-edge portion of the local Steiner solution between
levels `j` and `j+1`, which satisfies `conn j ≤ g(j+1) - g(j) + 3h/β`; the last piece path has
length `≤ h/β`, and guesses lie in `[0, h]`. Then the concatenated path from `z_{Q_0}` to `v` has
length at most `h - g(0) + 3 (m+1) h/β`. [PlanarLengthConstrainedMinimum, node_33] -/
theorem length_invariant_chain (h β : ℝ) (hβ : 0 < β) (m : ℕ) (g conn : ℕ → ℝ) (last : ℝ)
    (hg : ∀ j, j ≤ m → 0 ≤ g j ∧ g j ≤ h)
    (hconn : ∀ j, j < m → conn j ≤ g (j + 1) - g j + 3 * h / β)
    (hlast : last ≤ h / β) :
    (∑ j ∈ Finset.range m, conn j) + last ≤ h - g 0 + 3 * ((m : ℝ) + 1) * h / β := by
  sorry

/-! ## Step: parameters -/

/-- `ξ = ε/2`. -/
def xiParam (ε : ℝ) : ℝ := ε / 2

/-- `α = max{2, ⌈(log n)^ξ⌉}`. -/
def alphaParam (ε : ℝ) (n : ℕ) : ℝ :=
  max 2 (⌈Real.log n ^ xiParam ε⌉₊ : ℝ)

/-- Depth bound `d = c₀ (1 + log_α n)` from the hierarchy primitive. -/
def depthParam (c0 ε : ℝ) (n : ℕ) : ℝ :=
  c0 * (1 + Real.log n / Real.log (alphaParam ε n))

/-- `β = max{1, ⌈3d/ε⌉}`. -/
def betaParam (c0 ε : ℝ) (n : ℕ) : ℝ :=
  max 1 (⌈3 * depthParam c0 ε n / ε⌉₊ : ℝ)

/-- Parameter arithmetic (rubric 5): for fixed `0 < ε ≤ 1` and hierarchy constant `c₀ ≥ 1`,
`α β^ξ d / ξ³ + α d ≤ C (log n)^{1+ε}` for all `n ≥ 3`, with `C` depending only on `ε, c₀`. [PlanarLengthConstrainedMinimum, node_33] -/
theorem parameters_bound (ε c0 : ℝ) (hε : 0 < ε) (hε1 : ε ≤ 1) (hc0 : 1 ≤ c0) :
    ∃ C : ℝ, 0 < C ∧ ∀ n : ℕ, 3 ≤ n →
      alphaParam ε n * betaParam c0 ε n ^ xiParam ε * depthParam c0 ε n / xiParam ε ^ 3
        + alphaParam ε n * depthParam c0 ε n
        ≤ C * Real.log n ^ (1 + ε) := by
  sorry

/-! ## Main theorem: final assembly -/

/-- Final assembly: let `T*` be a spanning tree with `d_{T*}(r,v) ≤ h` and `OPT = w(T*)`.
Suppose the retained graph `S ⊆ G` satisfies the length bound (6) `d_S(r,v) ≤ h + 3dh/β` with
`β ≥ 3d/ε`, and the weight bound (7) `w(S) ≤ w(B) + D[G,g₀]` with `w(B) ≤ c_B α d · OPT` and
`D[G,g₀] ≤ K α A d · OPT`. Then there is a spanning tree `T` of `G` with
`d_T(r,v) ≤ (1+ε)h` for all `v` and `w(T) ≤ (c_B α d + K α A d) · OPT`. [PlanarLengthConstrainedMinimum, node_33] -/
theorem planar_lcmst_extraction {V : Type} [Fintype V] (I : WLGraph V) (hI : I.Nonneg)
    (h ε : ℝ) (hh : 0 ≤ h) (hε : 0 < ε)
    (Tstar : SimpleGraph V) (hTstar : IsSpanningTreeOf I.G Tstar)
    (hTstar_len : RootDistWithin I Tstar h)
    (S : SimpleGraph V) (hS : S ≤ I.G)
    (d β α A cB K wB Dval : ℝ) (hd : 0 ≤ d) (hβ : 0 < β) (hβd : 3 * d / ε ≤ β)
    (hSlen : RootDistWithin I S (h + 3 * d * h / β))
    (hSw : subWeight I.w S ≤ wB + Dval)
    (hwB : wB ≤ cB * α * d * subWeight I.w Tstar)
    (hDval : Dval ≤ K * α * A * d * subWeight I.w Tstar) :
    ∃ T : SimpleGraph V, IsSpanningTreeOf I.G T ∧ RootDistWithin I T ((1 + ε) * h) ∧
      subWeight I.w T ≤ (cB * α * d + K * α * A * d) * subWeight I.w Tstar := by
  sorry

end TCSChallenge.PlanarLengthConstrainedMinimumSpanningTrees.node_33
