/-!
## Optimal testing of generalized Reed–Muller codes

Let `F` be a finite field with `q = p^k` elements. The generalized Reed–Muller code
`RM_q(n, d)` consists of functions `𝔽_q^n → 𝔽_q` given by a polynomial of total degree `≤ d`
(equivalently, whose reduced representing polynomial has total degree `≤ d`).
`δ_d(f)` is the relative distance of `f` to the code.

The target theorem `optimal_grm_tester` asserts the existence of a (nonadaptive, randomized)
tester with perfect completeness, query budget
`Q ≤ 3 q^{p+c} (3q)^{⌈(d+1)/(q-1)⌉}` and rejection probability
`≥ q^{-C} min{1, Q δ_d(f)}`, with `c, C` absolute constants.

We also define the paper's sparse tester: block polynomial `P`, weights `H_e`, support `D`,
and the affine-map test, and state the algebraic facts and the strategy's lemmas about it.
-/

namespace TCSChallenge.OptimalTestingOfGeneralized.node_03

/-! ## Codes and distance -/

/-- "The generalized Reed-Muller code on `𝔽_q^n` consists of functions whose unique
representing polynomial with individual variable degrees at most `q-1` has total degree at
most `d`." Equivalently (reducing `x^q = x` does not raise total degree), `f` is the
evaluation of some polynomial of total degree `≤ d`. -/
def IsRM {F : Type} [Field F] (n d : ℕ) (f : (Fin n → F) → F) : Prop :=
  ∃ g : MvPolynomial (Fin n) F, g.totalDegree ≤ d ∧ ∀ x, f x = MvPolynomial.eval x g

/-- `Pr_{x ∈ 𝔽_q^n}[f(x) ≠ g(x)]` for uniform `x`. -/
def relDist {F : Type} [Fintype F] {n : ℕ} (f g : (Fin n → F) → F) : ℝ :=
  ((Finset.univ.filter fun x => f x ≠ g x).card : ℝ) / (Fintype.card F : ℝ) ^ n

/-! ## Nonadaptive randomized testers -/

/-- Rejection probability of a nonadaptive tester with uniform seed `ω ∈ Fin N`, which
queries the points `query ω i` (`i < Q`) and accepts iff `dec ω answers = true`. -/
def rejProb {F X : Type} {N Q : ℕ} (query : Fin N → Fin Q → X)
    (dec : Fin N → (Fin Q → F) → Bool) (f : X → F) : ℝ :=
  ((Finset.univ.filter fun ω => dec ω (fun i => f (query ω i)) = false).card : ℝ) / (N : ℝ)

/-! ## The sparse tester -/

/-- Numerator of the block polynomial, in variables `y_1, …, y_p` indexed by `Fin (pm+1)`
(`pm = p-1`; `y_p` is `Fin.last pm`, `y_i` for `i < p` is `Fin.castSucc`):
`∑_{I ⊆ {1,…,p-1}} (-1)^{|I|+1} (y_I + y_p)^{q-1}`, with `y_∅ = 0`. -/
def blockNumerator (F : Type) [Field F] [Fintype F] (pm : ℕ) : MvPolynomial (Fin (pm + 1)) F :=
  ∑ I : Finset (Fin pm), (-1 : MvPolynomial (Fin (pm + 1)) F) ^ (I.card + 1) *
    (∑ i ∈ I, MvPolynomial.X (Fin.castSucc i) + MvPolynomial.X (Fin.last pm)) ^
      (Fintype.card F - 1)

/-- Denominator `y_1 ⋯ y_{p-1}` of the block polynomial. -/
def blockDenominator (F : Type) [Field F] (pm : ℕ) : MvPolynomial (Fin (pm + 1)) F :=
  ∏ i : Fin pm, MvPolynomial.X (Fin.castSucc i)

/-- "`P(y_1,…,y_p) = (∑_I (-1)^{|I|+1}(y_I+y_p)^{q-1}) / (y_1⋯y_{p-1})`, … cancellation is
performed in the polynomial ring before evaluation at field points": the (unique, since
`MvPolynomial` over a field is a domain) quotient; `0` if the division were not exact (it is,
see `blockNumerator_dvd`). -/
def blockPoly (F : Type) [Field F] [Fintype F] (pm : ℕ) : MvPolynomial (Fin (pm + 1)) F :=
  if h : ∃ P, blockNumerator F pm = blockDenominator F pm * P then Classical.choose h else 0

/-- `q - q/p` (exact, since `p ∣ q`). -/
def wStep (p q : ℕ) : ℕ := q - q / p

/-- Number of blocks `s/p`, where `d+1 = s(q-q/p) + r`, `p ∣ s`, `0 < r ≤ p(q-q/p)`;
i.e. `s/p = ⌊d / (p(q-q/p))⌋`. -/
def numBlocks (p q d : ℕ) : ℕ := d / (p * wStep p q)

/-- `s = p · (s/p)`. -/
def sPar (p q d : ℕ) : ℕ := p * numBlocks p q d

/-- `r = d + 1 - s(q - q/p)`, which lies in `(0, p(q-q/p)]`. -/
def rPar (p q d : ℕ) : ℕ := d + 1 - numBlocks p q d * (p * wStep p q)

/-- `t = max{p+2, 10}`. -/
def tPar (p : ℕ) : ℕ := max (p + 2) 10

/-- `m = s + t`. -/
def mPar (p q d : ℕ) : ℕ := sPar p q d + tPar p

/-- Proof-free coordinate access: `x_i` (0-indexed) if `i < M`, else `0` (never used). -/
def coord {F : Type} [Field F] {M : ℕ} (x : Fin M → F) (i : ℕ) : F :=
  if h : i < M then x ⟨i, h⟩ else 0

/-- `E = {e ∈ {0,…,q-1}^t : ∑_j e_j ≤ t(q-1) - r}` (written additively, no truncation). -/
def expSet (F : Type) [Fintype F] (p d : ℕ) : Finset (Fin (tPar p) → Fin (Fintype.card F)) :=
  Finset.univ.filter fun e =>
    (∑ j, (e j).val) + rPar p (Fintype.card F) d ≤ tPar p * (Fintype.card F - 1)

/-- `H_e(x_1,…,x_m) = (∏_{i=1}^{s/p} P(x_{p(i-1)+1},…,x_{pi})) · ∏_{j=1}^t x_{s+j}^{e_j}`
(0-indexed coordinates here). -/
def Hval (F : Type) [Field F] [Fintype F] (p d : ℕ)
    (e : Fin (tPar p) → Fin (Fintype.card F))
    (x : Fin (mPar p (Fintype.card F) d) → F) : F :=
  (∏ i : Fin (numBlocks p (Fintype.card F) d),
      MvPolynomial.eval (fun j : Fin (p - 1 + 1) => coord x (p * i.val + j.val))
        (blockPoly F (p - 1))) *
    ∏ j : Fin (tPar p), coord x (sPar p (Fintype.card F) d + j.val) ^ (e j).val

/-- `D = ⋃_{e ∈ E} supp(H_e)`; the tester's query count is `Q = |D|`. -/
def querySet (F : Type) [Field F] [Fintype F] (p d : ℕ) :
    Finset (Fin (mPar p (Fintype.card F) d) → F) :=
  Finset.univ.filter fun x => ∃ e ∈ expSet F p d, Hval F p d e x ≠ 0

/-- An affine map `T : 𝔽_q^m → 𝔽_q^n`, `T x = A x + b` (no injectivity requirement). -/
abbrev AffMap (F : Type) (m n : ℕ) : Type := (Fin n → Fin m → F) × (Fin n → F)

/-- Application of an affine map. -/
def affApply {F : Type} [Field F] {m n : ℕ} (T : AffMap F m n) (x : Fin m → F) : Fin n → F :=
  fun i => (∑ j, T.1 i j * x j) + T.2 i

/-- The test with affine map `T` rejects iff `∑_x f(T x) H_e(x) ≠ 0` for some `e ∈ E`.
(Only `x ∈ D` contribute, so the test reads `f` on `T(D)` only.) -/
def sparseRejects (F : Type) [Field F] [Fintype F] (p d : ℕ) {n : ℕ}
    (f : (Fin n → F) → F) (T : AffMap F (mPar p (Fintype.card F) d) n) : Prop :=
  ∃ e ∈ expSet F p d, (∑ x, f (affApply T x) * Hval F p d e x) ≠ 0

/-- `R(f)`: rejection probability of the sparse tester for a uniformly random affine `T`. -/
def sparseRej (F : Type) [Field F] [Fintype F] (p d : ℕ) {n : ℕ}
    (f : (Fin n → F) → F) : ℝ :=
  ((Finset.univ.filter fun T : AffMap F (mPar p (Fintype.card F) d) n =>
      sparseRejects F p d f T).card : ℝ) /
    (Fintype.card (AffMap F (mPar p (Fintype.card F) d) n) : ℝ)

/-- Padding: lift `f` on `𝔽_q^n` to `𝔽_q^{n+n'}` by ignoring the added coordinates. -/
def liftPad {F : Type} {n n' : ℕ} (f : (Fin n → F) → F) : (Fin (n + n') → F) → F :=
  fun x => f (fun i => x (Fin.castAdd n' i))

/-! ## Algebraic facts and query accounting -/

/-- The division defining `P` is exact in the polynomial ring. [OptimalTestingOfGeneralized, node_03] -/
theorem blockNumerator_dvd (F : Type) [Field F] [Fintype F] (p k : ℕ) (hp : p.Prime)
    (hk : 1 ≤ k) [CharP F p] (hq : Fintype.card F = p ^ k) :
    ∃ P, blockNumerator F (p - 1) = blockDenominator F (p - 1) * P := by
  sorry

/-- Given fact: `|supp(P)| ≤ (2^{p-1} + p - 1) q^{p-1}`. [OptimalTestingOfGeneralized, node_03] -/
theorem blockPoly_support_card (F : Type) [Field F] [Fintype F] (p k : ℕ) (hp : p.Prime)
    (hk : 1 ≤ k) [CharP F p] (hq : Fintype.card F = p ^ k) :
    (Finset.univ.filter fun y : Fin (p - 1 + 1) → F =>
        MvPolynomial.eval y (blockPoly F (p - 1)) ≠ 0).card ≤
      (2 ^ (p - 1) + p - 1) * (Fintype.card F) ^ (p - 1) := by
  sorry

/-- Product-support bound: `Q ≤ ((2^{p-1}+p-1) q^{p-1})^{s/p} · q^t`. [OptimalTestingOfGeneralized, node_03] -/
theorem querySet_card_le_product (F : Type) [Field F] [Fintype F] (p k d : ℕ)
    (hp : p.Prime) (hk : 1 ≤ k) [CharP F p] (hq : Fintype.card F = p ^ k) :
    (querySet F p d).card ≤
      ((2 ^ (p - 1) + p - 1) * (Fintype.card F) ^ (p - 1)) ^ numBlocks p (Fintype.card F) d *
        (Fintype.card F) ^ tPar p := by
  sorry

/-- Comparison with the target: using `2^{p-1}+p-1 ≤ 3^{p-1}`, `s(q-q/p) ≤ d+1` and
`t ≤ p+8`, `Q ≤ q^{p+8} (3q)^{⌈(d+1)/(q-1)⌉}`. [OptimalTestingOfGeneralized, node_03] -/
theorem querySet_card_le_target (F : Type) [Field F] [Fintype F] (p k d : ℕ)
    (hp : p.Prime) (hk : 1 ≤ k) [CharP F p] (hq : Fintype.card F = p ^ k) :
    ((querySet F p d).card : ℝ) ≤
      (Fintype.card F : ℝ) ^ (p + 8) *
        (3 * (Fintype.card F : ℝ)) ^ ⌈((d : ℝ) + 1) / ((Fintype.card F : ℝ) - 1)⌉₊ := by
  sorry

/-- Given fact (exact characterization): `R(f) = 0 ⟺ deg(f) ≤ d`. In particular the sparse
tester has perfect completeness. [OptimalTestingOfGeneralized, node_03] -/
theorem sparseRej_eq_zero_iff (F : Type) [Field F] [Fintype F] (p k n d : ℕ)
    (hp : p.Prime) (hk : 1 ≤ k) [CharP F p] (hq : Fintype.card F = p ^ k) (hn : 1 ≤ n)
    (f : (Fin n → F) → F) :
    sparseRej F p d f = 0 ↔ IsRM n d f := by
  sorry

/-- Padding preserves normalized distance to the code: `f` is `δ`-close to `RM_q(n,d)` iff
its lift to `𝔽_q^{n+n'}` is `δ`-close to `RM_q(n+n',d)`. [OptimalTestingOfGeneralized, node_03] -/
theorem liftPad_dist_iff {F : Type} [Field F] [Fintype F] (n n' d : ℕ)
    (f : (Fin n → F) → F) (δ : ℝ) :
    (∃ g, IsRM n d g ∧ relDist f g ≤ δ) ↔
      (∃ G, IsRM (n + n') d G ∧ relDist (liftPad (n' := n') f) G ≤ δ) := by
  sorry

/-! ## Strategy lemmas (candidate claims) -/

/-- Local progress (candidate): below an inverse-polynomial rejection threshold, a single
point edit `f ↦ f[b ↦ v]` decreases `R` by at least `Q / (q^n · q^C)`; requires `q ≥ 3` and
ambient dimension padded beyond `m` by a constant (to control rank-deficient maps). [OptimalTestingOfGeneralized, node_03] -/
theorem local_progress :
    ∃ c0 C c1 : ℕ, ∀ (p k n d : ℕ) (F : Type) [Field F] [Fintype F] [CharP F p],
      p.Prime → 1 ≤ k → Fintype.card F = p ^ k → 3 ≤ Fintype.card F →
      mPar p (Fintype.card F) d + c1 ≤ n →
      ∀ f : (Fin n → F) → F, 0 < sparseRej F p d f →
        sparseRej F p d f ≤ 1 / (Fintype.card F : ℝ) ^ c0 →
        ∃ (b : Fin n → F) (v : F),
          sparseRej F p d (Function.update f b v) ≤
            sparseRej F p d f -
              ((querySet F p d).card : ℝ) /
                ((Fintype.card F : ℝ) ^ n * (Fintype.card F : ℝ) ^ C) := by
  sorry

/-- Soundness of the (padded) sparse tester, from iterating `local_progress` (at most
`q^{n+C} R(f) / Q` edits reach a codeword by exact characterization) and the threshold
argument in the saturated regime. [OptimalTestingOfGeneralized, node_03] -/
theorem sparse_tester_soundness :
    ∃ C c1 : ℕ, ∀ (p k n d : ℕ) (F : Type) [Field F] [Fintype F] [CharP F p],
      p.Prime → 1 ≤ k → Fintype.card F = p ^ k → 3 ≤ Fintype.card F →
      mPar p (Fintype.card F) d + c1 ≤ n →
      ∀ f : (Fin n → F) → F, ∃ g, IsRM n d g ∧
        min 1 (((querySet F p d).card : ℝ) * relDist f g) ≤
          (Fintype.card F : ℝ) ^ C * sparseRej F p d f := by
  sorry

/-! ## Main theorem -/

/-- **Target theorem.** There are absolute constants `c, C` such that for every prime `p`,
`k ≥ 1`, field `F` with `q = p^k` elements, `n ≥ 1` and `d ≥ 0`, there is a nonadaptive
randomized tester for `RM_q(n,d)` with perfect completeness, `Q ≤ 3 q^{p+c}(3q)^{⌈(d+1)/(q-1)⌉}`
queries, and rejection probability `≥ q^{-C} min{1, Q δ_d(f)}`. [OptimalTestingOfGeneralized, node_03] -/
theorem optimal_grm_tester :
    ∃ C c : ℕ, ∀ (p k n d : ℕ) (F : Type) [Field F] [Fintype F] [CharP F p],
      p.Prime → 1 ≤ k → Fintype.card F = p ^ k → 1 ≤ n →
      ∃ (N Q : ℕ) (query : Fin N → Fin Q → (Fin n → F)) (dec : Fin N → (Fin Q → F) → Bool),
        0 < N ∧
        (Q : ℝ) ≤ 3 * (Fintype.card F : ℝ) ^ (p + c) *
          (3 * (Fintype.card F : ℝ)) ^ ⌈((d : ℝ) + 1) / ((Fintype.card F : ℝ) - 1)⌉₊ ∧
        (∀ f : (Fin n → F) → F, IsRM n d f → rejProb query dec f = 0) ∧
        ∀ f : (Fin n → F) → F, ∃ g, IsRM n d g ∧
          min 1 ((Q : ℝ) * relDist f g) ≤ (Fintype.card F : ℝ) ^ C * rejProb query dec f := by
  sorry

end TCSChallenge.OptimalTestingOfGeneralized.node_03
