/-!
## Single-pair hardness of bounded weighted edit distance (combinatorial core)

The paper proves, under APSP, that bounded weighted edit distance with threshold
`k ≤ n^κ` has no `O(n^(1/2+3κ/2-δ))` algorithm, by reducing from a multi-query problem
(`min_i ed_w(X_i,Y) ≤ t`). The reduction builds

  X̂ = A_1 (UYV) A_2 (UYV) ⋯ (UYV) A_m,     A_i = ◇X_i◇,
  Ŷ = Z_0 ∏_{i=1}^m (U◇Y◇VZ_i),
  K = b + 2r + 2x + t,   b = (m-1)(h+4),  r = b + x + 2y + 1,

with fresh symbols ⊥, ◇, u_1..u_r, v_1..v_r, masked strings `Z_i`, and an extended
weight function ŵ. The main theorem `hat_ed_le_iff` states

  ed_ŵ(X̂, Ŷ) ≤ K  ↔  ∃ i < m, ed_w(X_i, Y) ≤ t.

Lemma stubs record the local distance estimates (2)–(5), the normalization and
denominator properties of ŵ, the size and alphabet bounds, mask existence, and the
exponent arithmetic for `β = 1/κ - 1`.
-/

namespace TCSChallenge.OptimalAlgorithmsForBoundedWeightedEditDistance.node_32

/-! ## Weighted edit distance -/

/-- One row of the edit-distance DP: given `prev = ed_w(S, ·)`, computes
`ed_w(a :: S, ·)`. Deletion costs `w(a, ε)`, insertion `w(ε, b)`, substitution or
match `w(a, b)`; `none` plays the role of the empty symbol `ε`. -/
noncomputable def edRow {β : Type} (w : Option β → Option β → ℝ) (a : β)
    (prev : List β → ℝ) : List β → ℝ
  | [] => w (some a) none + prev []
  | b :: T => min (w (some a) none + prev (b :: T))
      (min (w none (some b) + edRow w a prev T) (w (some a) (some b) + prev T))

/-- "Let ed_w(S,T) be the minimum alignment cost." Defined by the standard DP
recursion over deletions, insertions and substitutions/matches. -/
noncomputable def wed {β : Type} (w : Option β → Option β → ℝ) : List β → List β → ℝ
  | [], T => (T.map (fun b => w none (some b))).sum
  | a :: S, T => edRow w a (fun T' => wed w S T') T

/-- Hamming distance: "hd counts the positions at which two equal-length strings
differ". -/
def hd {α : Type} [DecidableEq α] (S T : List α) : ℕ :=
  ((S.zip T).filter (fun p => decide (p.1 ≠ p.2))).length

/-- "Call w normalized if w(a,a)=0 and w(a,b)≥1 for all distinct a,b∈Σ∪{ε}."
(The restricted instances additionally have all weights in `[0,2]`, and we record
symmetry too.) -/
def NormalizedIn12 {β : Type} (w : Option β → Option β → ℝ) : Prop :=
  (∀ p, w p p = 0) ∧ (∀ p q, w p q = w q p) ∧
    (∀ p q, p ≠ q → 1 ≤ w p q ∧ w p q ≤ 2)

/-! ## The source (multi-query) instance -/

/-- The promises of the source instance `X_1,…,X_m ∈ Σ_X^x`, `Y ∈ Σ_Y^y`, threshold
`t`, weight `w`: `1 ≤ x ≤ y`, `1 ≤ m`, `Σ_X ∩ Σ_Y = ∅`, `2y-x ≤ t < 2y-x+1`; `w` is
symmetric with zero diagonal and off-diagonal values in `[1,2]`; `w(a,ε)=1` for
`a ∈ Σ_X` and `w(ε,b)=2` for `b ∈ Σ_Y`. (The bounds `y ≤ s`, `m ≤ s^β`,
`hd(X_i,X_{i+1}) ≤ s^(1-β)` only matter for sizes; see `SizePromise`.) -/
structure SourcePromise {α : Type} (m x y : ℕ) (X : ℕ → List α) (Y : List α)
    (w : Option α → Option α → ℝ) (t : ℝ) : Prop where
  one_le_m : 1 ≤ m
  one_le_x : 1 ≤ x
  x_le_y : x ≤ y
  len_X : ∀ i, i < m → (X i).length = x
  len_Y : Y.length = y
  disjoint : ∀ i, i < m → ∀ a ∈ X i, a ∉ Y
  normalized : NormalizedIn12 w
  del_X : ∀ i, i < m → ∀ a ∈ X i, w (some a) none = 1
  ins_Y : ∀ b ∈ Y, w none (some b) = 2
  t_lo : 2 * (y : ℝ) - x ≤ t
  t_hi : t < 2 * (y : ℝ) - x + 1

/-- Size promises: `y ≤ s` and `hd(X_i, X_{i+1}) ≤ hmax`. The paper's
`m ≤ s^β` and `hmax ≤ s^(1-β)` are used only through their consequences
`m ≤ s` and `(m-1)·hmax ≤ s`, which are what we record. -/
structure SizePromise {α : Type} [DecidableEq α] (m s hmax : ℕ) (X : ℕ → List α)
    (Y : List α) : Prop where
  y_le_s : Y.length ≤ s
  m_le_s : m ≤ s
  mh_le_s : (m - 1) * hmax ≤ s
  hd_le : ∀ i, i + 1 < m → hd (X i) (X (i + 1)) ≤ hmax

/-! ## The construction -/

/-- Symbols of the constructed instance: old symbols, the fresh symbols `⊥` and `◇`,
and the mutually distinct fresh separator symbols `u_q`, `v_q`. -/
inductive Sym (α : Type) : Type
  | old : α → Sym α
  | bot : Sym α
  | dia : Sym α
  | u : ℕ → Sym α
  | v : ℕ → Sym α
  deriving DecidableEq

/-- "Extend w to ŵ by retaining its values on the old alphabet together with ε,
assigning zero to equal pairs, and assigning cost 1 to every unequal pair involving a
fresh symbol." -/
noncomputable def extW {α : Type} [DecidableEq α] (w : Option α → Option α → ℝ) :
    Option (Sym α) → Option (Sym α) → ℝ
  | some (Sym.old a), some (Sym.old b) => w (some a) (some b)
  | some (Sym.old a), none => w (some a) none
  | none, some (Sym.old b) => w none (some b)
  | p, q => if p = q then 0 else 1

/-- Embedding of a source string. -/
def oldStr {α : Type} (S : List α) : List (Sym α) := S.map Sym.old

/-- `U = u_1 ⋯ u_r` (0-based indices `u_0 … u_{r-1}`). -/
def blockU {α : Type} (r : ℕ) : List (Sym α) := (List.range r).map Sym.u

/-- `V = v_1 ⋯ v_r`. -/
def blockV {α : Type} (r : ℕ) : List (Sym α) := (List.range r).map Sym.v

/-- `A_i = ◇ X_i ◇`. -/
def gadgetA {α : Type} (Xi : List α) : List (Sym α) :=
  Sym.dia :: oldStr Xi ++ [Sym.dia]

/-- The source separator `U Y V`. -/
def sepX {α : Type} (r : ℕ) (Y : List α) : List (Sym α) :=
  blockU r ++ oldStr Y ++ blockV r

/-- The target block `U ◇ Y ◇ V`. -/
def targetBlock {α : Type} (r : ℕ) (Y : List α) : List (Sym α) :=
  blockU r ++ [Sym.dia] ++ oldStr Y ++ [Sym.dia] ++ blockV r

/-- `X̂ = A_1 (UYV) A_2 (UYV) ⋯ (UYV) A_m`. -/
def hatX {α : Type} (m r : ℕ) (X : ℕ → List α) (Y : List α) : List (Sym α) :=
  gadgetA (X 0) ++ (List.range (m - 1)).flatMap (fun i => sepX r Y ++ gadgetA (X (i + 1)))

/-- `Ŷ = Z_0 ∏_{i=1}^m (U◇Y◇V Z_i)`. -/
def hatY {α : Type} (m r : ℕ) (Z : ℕ → List (Sym α)) (Y : List α) : List (Sym α) :=
  Z 0 ++ (List.range m).flatMap (fun i => targetBlock r Y ++ Z (i + 1))

/-- `Zi` is obtained from `Xi` by replacing exactly `h` positions by `⊥`. -/
def IsMask {α : Type} [DecidableEq α] (h : ℕ) (Xi : List α) (Zi : List (Sym α)) : Prop :=
  Zi.length = Xi.length ∧ Zi.count Sym.bot = h ∧
    ∀ p ∈ Zi.zip Xi, p.1 = Sym.bot ∨ p.1 = Sym.old p.2

/-- "For every i, both Z_{i−1} and Z_i agree with X_i outside their h occurrences of
⊥" (0-based: `Z j` and `Z (j+1)` are masks of `X j`). -/
def MasksValid {α : Type} [DecidableEq α] (m h : ℕ) (X : ℕ → List α)
    (Z : ℕ → List (Sym α)) : Prop :=
  ∀ j, j < m → IsMask h (X j) (Z j) ∧ IsMask h (X j) (Z (j + 1))

/-- `b = (m-1)(h+4)`. -/
def bParam (m h : ℕ) : ℕ := (m - 1) * (h + 4)

/-- `r = b + x + 2y + 1`. -/
def rParam (m h x y : ℕ) : ℕ := bParam m h + x + 2 * y + 1

/-- `K = b + 2r + 2x + t`. -/
noncomputable def KParam (m h x y : ℕ) (t : ℝ) : ℝ :=
  (bParam m h : ℝ) + 2 * (rParam m h x y : ℝ) + 2 * (x : ℝ) + t

/-- Potential `Φ(S) = Σ_{a ∈ S} ŵ(ε,a)`, counting occurrences. -/
noncomputable def potential {α : Type} [DecidableEq α] (w : Option α → Option α → ℝ)
    (S : List (Sym α)) : ℝ :=
  (S.map (fun a => extW w none (some a))).sum

/-! ## Lemma stubs -/

/-- Masks exist: if `h ≥ hd(X_i,X_{i+1})` for all `i` and `h ≤ x`, one can choose
`Z_0, …, Z_m`. [OptimalAlgorithmsForBounded, node_32] -/
theorem masks_exist {α : Type} [DecidableEq α] (m x h : ℕ) (X : ℕ → List α)
    (hlen : ∀ i, i < m → (X i).length = x) (hhx : h ≤ x)
    (hhd : ∀ i, i + 1 < m → hd (X i) (X (i + 1)) ≤ h) :
    ∃ Z : ℕ → List (Sym α), MasksValid m h X Z := by
  sorry

/-- ŵ is symmetric, normalized, with all values in `[0,2]`. [OptimalAlgorithmsForBounded, node_32] -/
theorem extW_normalized {α : Type} [DecidableEq α] (w : Option α → Option α → ℝ)
    (hw : NormalizedIn12 w) : NormalizedIn12 (extW w) := by
  sorry

/-- ŵ keeps the common denominator `D` of the source weights. [OptimalAlgorithmsForBounded, node_32] -/
theorem extW_denominator {α : Type} [DecidableEq α] (w : Option α → Option α → ℝ)
    (D : ℕ) (hD : 0 < D) (hw : ∀ p q, ∃ k : ℤ, w p q = (k : ℝ) / D) :
    ∀ p q, ∃ k : ℤ, extW w p q = (k : ℝ) / D := by
  sorry

/-- Common-context cancellation on old symbols: `ed_ŵ` restricted to old symbols is
`ed_w`. [OptimalAlgorithmsForBounded, node_32] -/
theorem wed_extW_oldStr {α : Type} [DecidableEq α] (w : Option α → Option α → ℝ)
    (S T : List α) : wed (extW w) (oldStr S) (oldStr T) = wed w S T := by
  sorry

/-- Potential bound: every alignment from `S` to `T` costs at least `Φ(T) − Φ(S)`. [OptimalAlgorithmsForBounded, node_32] -/
theorem potential_le_wed {α : Type} [DecidableEq α] (w : Option α → Option α → ℝ)
    (hw : NormalizedIn12 w) (S T : List (Sym α)) :
    potential w T - potential w S ≤ wed (extW w) S T := by
  sorry

/-- Equation (2): `ed_ŵ(A_i, Z_{i−1}) = ed_ŵ(A_i, Z_i) = h + 2`. [OptimalAlgorithmsForBounded, node_32] -/
theorem wed_gadget_mask {α : Type} [DecidableEq α] (m x y h : ℕ) (X : ℕ → List α)
    (Y : List α) (w : Option α → Option α → ℝ) (t : ℝ) (Z : ℕ → List (Sym α))
    (hP : SourcePromise m x y X Y w t) (hZ : MasksValid m h X Z) (j : ℕ) (hj : j < m) :
    wed (extW w) (gadgetA (X j)) (Z j) = (h : ℝ) + 2 ∧
      wed (extW w) (gadgetA (X j)) (Z (j + 1)) = (h : ℝ) + 2 := by
  sorry

/-- Equation (3): `ed_ŵ(Y, ◇Y◇) = 2`. [OptimalAlgorithmsForBounded, node_32] -/
theorem wed_Y_diaYdia {α : Type} [DecidableEq α] (m x y : ℕ) (X : ℕ → List α)
    (Y : List α) (w : Option α → Option α → ℝ) (t : ℝ)
    (hP : SourcePromise m x y X Y w t) :
    wed (extW w) (oldStr Y) ([Sym.dia] ++ oldStr Y ++ [Sym.dia]) = 2 := by
  sorry

/-- Equation (4): `ed_ŵ(Y, ◇Y◇VZ_iU◇Y◇) = 4 + 2r + x + 2y` for `1 ≤ i < m`. [OptimalAlgorithmsForBounded, node_32] -/
theorem wed_Y_double {α : Type} [DecidableEq α] (m x y h : ℕ) (X : ℕ → List α)
    (Y : List α) (w : Option α → Option α → ℝ) (t : ℝ) (Z : ℕ → List (Sym α))
    (hP : SourcePromise m x y X Y w t) (hZ : MasksValid m h X Z)
    (i : ℕ) (hi1 : 1 ≤ i) (him : i < m) :
    wed (extW w) (oldStr Y)
        ([Sym.dia] ++ oldStr Y ++ [Sym.dia] ++ blockV (rParam m h x y) ++ Z i ++
          blockU (rParam m h x y) ++ [Sym.dia] ++ oldStr Y ++ [Sym.dia]) =
      4 + 2 * (rParam m h x y : ℝ) + x + 2 * y := by
  sorry

/-- Equation (5): `E_i ≤ 2r + 2x + t ↔ ed_w(X_i, Y) ≤ t`, where
`E_i = ed_ŵ(A_i, Z_{i−1} U◇Y◇V Z_i)`. Uses the strict interval `t < 2y − x + 1`. [OptimalAlgorithmsForBounded, node_32] -/
theorem local_query_iff {α : Type} [DecidableEq α] (m x y h : ℕ) (X : ℕ → List α)
    (Y : List α) (w : Option α → Option α → ℝ) (t : ℝ) (Z : ℕ → List (Sym α))
    (hP : SourcePromise m x y X Y w t) (hZ : MasksValid m h X Z) (j : ℕ) (hj : j < m) :
    wed (extW w) (gadgetA (X j)) (Z j ++ targetBlock (rParam m h x y) Y ++ Z (j + 1)) ≤
        2 * (rParam m h x y : ℝ) + 2 * x + t ↔
      wed w (X j) Y ≤ t := by
  sorry

/-- Equation (6): `K < 3r`, the bound driving the private-symbol counting argument. [OptimalAlgorithmsForBounded, node_32] -/
theorem K_lt_three_r (m x y h : ℕ) (t : ℝ) (ht : t < 2 * (y : ℝ) - x + 1) :
    KParam m h x y t < 3 * (rParam m h x y : ℝ) := by
  sorry

/-- Lengths: `|X̂| = x+2+(m−1)(2r+y+x+2)` and `|Ŷ| = x+m(2r+y+x+2)`. [OptimalAlgorithmsForBounded, node_32] -/
theorem hat_lengths {α : Type} [DecidableEq α] (m x y h : ℕ) (X : ℕ → List α)
    (Y : List α) (w : Option α → Option α → ℝ) (t : ℝ) (Z : ℕ → List (Sym α))
    (hP : SourcePromise m x y X Y w t) (hZ : MasksValid m h X Z) :
    (hatX m (rParam m h x y) X Y).length =
        x + 2 + (m - 1) * (2 * rParam m h x y + y + x + 2) ∧
      (hatY m (rParam m h x y) Z Y).length = x + m * (2 * rParam m h x y + y + x + 2) := by
  sorry

/-- Alphabet bound: the number of distinct symbols in `X̂` and `Ŷ` is at most
`x + Σ_{i<m-1} hd(X_i,X_{i+1}) + y + 2r + 2`. [OptimalAlgorithmsForBounded, node_32] -/
theorem hat_alphabet_card {α : Type} [DecidableEq α] (m x y h : ℕ) (X : ℕ → List α)
    (Y : List α) (w : Option α → Option α → ℝ) (t : ℝ) (Z : ℕ → List (Sym α))
    (hP : SourcePromise m x y X Y w t) (hZ : MasksValid m h X Z) :
    (hatX m (rParam m h x y) X Y ++ hatY m (rParam m h x y) Z Y).toFinset.card ≤
      x + ((List.range (m - 1)).map (fun i => hd (X i) (X (i + 1)))).sum + y +
        2 * rParam m h x y + 2 := by
  sorry

/-- Size bounds in terms of `s`: with `h = hmax`, `r ≤ 12 s + 1`, `K ≤ 40 s + 2`, and
both lengths at most `C · s · m` with `C = 40`. (The constants are explicit
consequences of the formulas above; `K` uses `t < 2y − x + 1`.) [OptimalAlgorithmsForBounded, node_32] -/
theorem hat_size_bounds {α : Type} [DecidableEq α] (m x y s hmax : ℕ) (X : ℕ → List α)
    (Y : List α) (w : Option α → Option α → ℝ) (t : ℝ) (Z : ℕ → List (Sym α))
    (hP : SourcePromise m x y X Y w t) (hS : SizePromise m s hmax X Y)
    (hZ : MasksValid m hmax X Z) (hs : 1 ≤ s) :
    rParam m hmax x y ≤ 12 * s + 1 ∧ KParam m hmax x y t ≤ 40 * (s : ℝ) + 2 ∧
      0 < KParam m hmax x y t ∧
      (hatX m (rParam m hmax x y) X Y).length ≤ 40 * s * m ∧
      (hatY m (rParam m hmax x y) Z Y).length ≤ 40 * s * m := by
  sorry

/-- Exponent arithmetic: with `β = 1/κ − 1`, `κ ∈ [1/2,1]`, `0 < δ₀ ≤ 1/8`, we have
`β ∈ [0,1]`, `κ(1+β) = 1`,
`(1+β)(1/2+3κ/2−δ₀) = 2 + β/2 − (1+β)δ₀`, and the saving exceeds the construction
cost: `2 + β/2 − (1+β)δ₀ − (1+β) ≥ 1/4`. [OptimalAlgorithmsForBounded, node_32] -/
theorem exponent_arith (κ δ₀ : ℝ) (hκ1 : 1 / 2 ≤ κ) (hκ2 : κ ≤ 1) (hδ1 : 0 < δ₀)
    (hδ2 : δ₀ ≤ 1 / 8) :
    let β := 1 / κ - 1
    0 ≤ β ∧ β ≤ 1 ∧ κ * (1 + β) = 1 ∧
      (1 + β) * (1 / 2 + 3 * κ / 2 - δ₀) = 2 + β / 2 - (1 + β) * δ₀ ∧
      1 / 4 ≤ 2 + β / 2 - (1 + β) * δ₀ - (1 + β) := by
  sorry

/-! ## Main theorem -/

/-- Equation (1), the correctness of the single-pair minimum selector:
`ed_ŵ(X̂, Ŷ) ≤ K ↔ min_i ed_w(X_i, Y) ≤ t`, for every source instance satisfying the
promises and every valid choice of masks with `h` occurrences of `⊥`. [OptimalAlgorithmsForBounded, node_32] -/
theorem hat_ed_le_iff {α : Type} [DecidableEq α] (m x y h : ℕ) (X : ℕ → List α)
    (Y : List α) (w : Option α → Option α → ℝ) (t : ℝ) (Z : ℕ → List (Sym α))
    (hP : SourcePromise m x y X Y w t) (hZ : MasksValid m h X Z) :
    wed (extW w) (hatX m (rParam m h x y) X Y) (hatY m (rParam m h x y) Z Y) ≤
        KParam m h x y t ↔
