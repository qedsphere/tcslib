/-!
## Relaxed tolerant junta testing: `(1/γ)^{Ω(log(1/δ))}`

A `(k, k', ε₁, ε₂)`-tester accepts (w.p. `≥ 2/3`) functions `ε₁`-close to `k`-juntas and
rejects (w.p. `≥ 2/3`) functions `ε₂`-far from `⌊k'⌋`-juntas, in every ambient dimension.
The main theorem `relaxed_junta_lower_bound` gives absolute `γ₀, c, A > 0` such that for all
`k ≥ 1`, `0.01 ≤ ε₁ < ε₂ ≤ 0.49`, `δ = ε₂ - ε₁ ≥ 2^{-k^{0.1}}` and `1/k ≤ γ ≤ γ₀`, every
randomized adaptive `(k, (1+γ)k, ε₁, ε₂)`-tester makes at least `A (1/γ)^{c log₂(1/δ)}`
queries.

Proof ingredients, as stubs: bounds on `Δ_t`, the distance-`d` colouring of `{0,1}^ℓ`, the
smaller-scale lower bound for `(m, m + ⌊L/20⌋)`-testers, and the block-parity enlargement,
which preserves distances to juntas exactly.
-/

namespace TCSChallenge.NewLowerBoundsForAdaptiveTolerantJuntaTesting.node_06

/-! ## Boolean functions, juntas and distance -/

/-- A Boolean function on `{0,1}^n` (TCSlib's `BoolCube n`), with Boolean values. -/
abbrev BoolFun (n : ℕ) := BoolCube n → Bool

/-- "`g` depends on at most `k` coordinates": some set `S` of at most `k` coordinates is a
junta set (TCSlib `KKL.IsJunta`) for the `±1` version `boolToSign ∘ g`; since `boolToSign`
is injective, this says that `S` determines `g`. -/
def IsJunta {n : ℕ} (g : BoolFun n) (k : ℕ) : Prop :=
  ∃ S : Finset (Fin n), S.card ≤ k ∧ KKL.IsJunta (fun x => boolToSign (g x)) S

/-- `d(f,g) = 2^{-n} |{x : f x ≠ g x}|`. -/
def boolDist {n : ℕ} (f g : BoolFun n) : ℝ :=
  ((univ.filter (fun x : BoolCube n => f x ≠ g x)).card : ℝ) / (2 : ℝ) ^ n

/-- `d(f, J_k) = min_{g ∈ J_k} d(f,g)`. The set is finite and nonempty (constants are
juntas), so the infimum is a minimum. -/
def distJunta {n : ℕ} (f : BoolFun n) (k : ℕ) : ℝ :=
  sInf {d : ℝ | ∃ g : BoolFun n, IsJunta g k ∧ d = boolDist f g}

/-! ## Adaptive query trees and randomized testers -/

/-- A deterministic adaptive query algorithm: either it stops with a verdict
(`true` = accept), or it queries `f x` and continues depending on the answer. -/
inductive QTree (n : ℕ) : Type
  | leaf : Bool → QTree n
  | query : BoolCube n →(Bool → QTree n) → QTree n

/-- Output of a query tree run on the oracle `f`. -/
def QTree.eval {n : ℕ} : QTree n → BoolFun n → Bool
  | .leaf b, _ => b
  | .query x c, f => (c (f x)).eval f

/-- Number of queries made by a query tree on the oracle `f`. -/
def QTree.pathLen {n : ℕ} : QTree n → BoolFun n → ℕ
  | .leaf _, _ => 0
  | .query x c, f => (c (f x)).pathLen f + 1

/-- A randomized adaptive tester on `{0,1}^n`: tree `tree i` is run with probability
`w i`, where `w` is a finite probability distribution (TCSlib `FinDist`). -/
structure RandTester (n : ℕ) where
  m : ℕ
  w : FinDist (Fin m)
  tree : Fin m → QTree n

/-- Probability that `T` accepts `f`. -/
def RandTester.acceptProb {n : ℕ} (T : RandTester n) (f : BoolFun n) : ℝ :=
  ∑ i, T.w i * (if (T.tree i).eval f then 1 else 0)

/-- `T` makes at most `q` queries on every input satisfying `Good`, for every realization of
its randomness that has positive probability. -/
def RandTester.QueryBoundedOn {n : ℕ} (T : RandTester n) (Good : BoolFun n → Prop)
    (q : ℕ) : Prop :=
  ∀ i, 0 < T.w i → ∀ f, Good f → (T.tree i).pathLen f ≤ q

/-- `(k, k', ε₁, ε₂)`-tester: accepts with probability `≥ 2/3` if `d(f,J_k) ≤ ε₁`, and
rejects with probability `≥ 2/3` if `d(f,J_{k'}) ≥ ε₂`. -/
def RandTester.IsRelaxedTester {n : ℕ} (T : RandTester n) (k k' : ℕ) (ε₁ ε₂ : ℝ) : Prop :=
  (∀ f : BoolFun n, distJunta f k ≤ ε₁ → 2 / 3 ≤ T.acceptProb f) ∧
  (∀ f : BoolFun n, ε₂ ≤ distJunta f k' → T.acceptProb f ≤ 1 / 3)

/-! ## Minority cost -/

/-- Hamming weight of a bit string. -/
def weight {m : ℕ} (x : Fin m → Bool) : ℕ :=
  (univ.filter (fun i : Fin m => x i = true)).card

/-- `h(x) = min(|x|, m - |x|)`, the distance of `x` to the two constant strings. -/
def minCost {m : ℕ} (x : Fin m → Bool) : ℕ :=
  min (weight x) (m - weight x)

/-- `Δ_m = E[h(U)]/m` for a uniform `m`-bit string `U`. -/
def deltaAvg (m : ℕ) : ℝ :=
  (∑ x : Fin m → Bool, (minCost x : ℝ)) / ((2 : ℝ) ^ m * m)

/-! ## Block-parity enlargement -/

/-- Parity of block `j` of `y ∈ {0,1}^{n·b}`, where block `j` is the set of coordinates
`finProdFinEquiv (j, i)` with `i < b`. -/
def blockParity {n b : ℕ} (y : BoolCube (n * b)) (j : Fin n) : Bool :=
  decide (weight (fun i : Fin b => y (finProdFinEquiv (j, i))) % 2 = 1)

/-- "Partition `nb` input coordinates into `n` blocks of size `b` and define `F` by applying
`f` to their block parities." Each query to `F` costs one query to `f`. -/
def blockLift {n : ℕ} (b : ℕ) (f : BoolFun n) : BoolFun (n * b) :=
  fun y => f (fun j => blockParity y j)

/-! ## Lemma stubs -/

/-- Eq. (2): `1/(2√(3t)) ≤ 1/2 - Δ_t ≤ 1/(2√t)`. [NewLowerBoundsFor, node_06] -/
theorem deltaAvg_bounds (t : ℕ) (ht : 0 < t) :
    1 / (2 * Real.sqrt (3 * t)) ≤ 1 / 2 - deltaAvg t ∧
      1 / 2 - deltaAvg t ≤ 1 / (2 * Real.sqrt t) := by
  sorry

/-- Greedy colouring: there is a colouring of `{0,1}^ℓ` with `M = Σ_{j ≤ d} binom(ℓ,j)`
colours in which distinct points at Hamming distance at most `d` get distinct colours. [NewLowerBoundsFor, node_06] -/
theorem exists_distance_coloring (ℓ d : ℕ) :
    ∃ χ : (Fin ℓ → Bool) → Fin (∑ j ∈ range (d + 1), ℓ.choose j),
      ∀ z z' : Fin ℓ → Bool, z ≠ z' → hammingDist z z' ≤ d → χ z ≠ χ z' := by
  sorry

/-- Eq. (12): block parities preserve the distance to juntas,
`d(F, J_{tb}) = d(F, J_{tb+b-1}) = d(f, J_t)` for `0 ≤ t < n`. [NewLowerBoundsFor, node_06] -/
theorem blockLift_distJunta {n : ℕ} (b : ℕ) (hb : 1 ≤ b) (f : BoolFun n) (t : ℕ)
    (ht : t < n) :
    distJunta (blockLift b f) (t * b) = distJunta f t ∧
      distJunta (blockLift b f) (t * b + b - 1) = distJunta f t := by
  sorry

/-- Eq. (1), the smaller-scale lower bound: with `L = log₂(1/δ)` and `s = ⌊L/20⌋`, every
randomized adaptive `(m, m+s, ε₁, ε₂)`-tester, for `m ≥ C L`, needs at least
`c₀ (m/L)^{c₁ L}` queries. [NewLowerBoundsFor, node_06] -/
theorem smaller_scale_lower_bound :
    ∃ C c₀ c₁ : ℝ, 0 < C ∧ 0 < c₀ ∧ 0 < c₁ ∧
      ∀ ε₁ ε₂ : ℝ, 0.01 ≤ ε₁ → ε₁ < ε₂ → ε₂ ≤ 0.49 →
        ∀ m : ℕ, C * Real.logb 2 (1 / (ε₂ - ε₁)) ≤ m →
          ∀ T : (n : ℕ) → RandTester n,
            (∀ n, (T n).IsRelaxedTester m (m + ⌊Real.logb 2 (1 / (ε₂ - ε₁)) / 20⌋₊) ε₁ ε₂) →
            ∀ q : ℕ, (∀ n, (T n).QueryBoundedOn (fun _ => True) q) →
              c₀ * ((m : ℝ) / Real.logb 2 (1 / (ε₂ - ε₁))) ^
                (c₁ * Real.logb 2 (1 / (ε₂ - ε₁))) ≤ q := by
  sorry

/-! ## Main theorem -/

/-- **Main theorem.** There are absolute `γ₀, c, A > 0` such that for every `k ≥ 1`, all
`0.01 ≤ ε₁ < ε₂ ≤ 0.49` with `δ = ε₂ - ε₁ ≥ 2^{-k^{0.1}}`, and `1/k ≤ γ ≤ γ₀`, every
randomized adaptive `(k, (1+γ)k, ε₁, ε₂)`-tester (soundness class `J_{⌊(1+γ)k⌋}`) has query
complexity at least `A (1/γ)^{c log₂(1/δ)}`. [NewLowerBoundsFor, node_06] -/
theorem relaxed_junta_lower_bound :
    ∃ γ₀ c A : ℝ, 0 < γ₀ ∧ 0 < c ∧ 0 < A ∧
      ∀ k : ℕ, 1 ≤ k → ∀ ε₁ ε₂ γ : ℝ, 0.01 ≤ ε₁ → ε₁ < ε₂ → ε₂ ≤ 0.49 →
        (2 : ℝ) ^ (-((k : ℝ) ^ (0.1 : ℝ))) ≤ ε₂ - ε₁ → 1 / (k : ℝ) ≤ γ → γ ≤ γ₀ →
        ∀ T : (n : ℕ) → RandTester n,
          (∀ n, (T n).IsRelaxedTester k ⌊(1 + γ) * (k : ℝ)⌋₊ ε₁ ε₂) →
          ∀ q : ℕ, (∀ n, (T n).QueryBoundedOn (fun _ => True) q) →
            A * (1 / γ) ^ (c * Real.logb 2 (1 / (ε₂ - ε₁))) ≤ q := by
  sorry

end TCSChallenge.NewLowerBoundsForAdaptiveTolerantJuntaTesting.node_06
