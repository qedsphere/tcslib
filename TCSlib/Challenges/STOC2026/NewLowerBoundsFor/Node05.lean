/-!
## Adaptive tolerant junta testing: a `k^{Ω(log(1/δ))}` lower bound

Boolean functions on `{0,1}^n` are `BoolCube n → Bool` (TCSlib's `BoolCube n = Fin n → Bool`);
juntas use TCSlib's `KKL.IsJunta`. A deterministic adaptive tester is a query tree `QTree n`.
A randomized tester is a finite family of trees with probability weights given by a TCSlib
`FinDist`. The main theorem `tolerant_junta_lower_bound` says: there is an absolute `c > 0`
such that for every `A > 0`, all large `k`, all `0.01 ≤ ε₁ < ε₂ ≤ 0.49` with
`δ = ε₂ - ε₁ ≥ 2^{-A k^{0.99}}`, some dimension `n ≥ k` forces every randomized adaptive
`(k, ε₁, ε₂)`-tolerant junta tester to make at least `k^{c log₂(1/δ)}` queries on some
promise input.

The lemma stubs follow the reference proof: the odd-parity minority improvement, the
proper-subset marginals of odd-parity strings, the explicit YES/NO distributions together
with their indistinguishability and distance bounds, and the baseline `Ω(√k)` bound.
-/

namespace TCSChallenge.NewLowerBoundsForAdaptiveTolerantJuntaTesting.node_05

/-! ## Boolean functions, juntas and distance -/

/-- A Boolean function on `{0,1}^n` (Bool-valued, on TCSlib's `BoolCube n`). -/
abbrev BoolFun (n : ℕ) := BoolCube n → Bool

/-- "`g` depends on at most `k` coordinates": some set `S` of at most `k` coordinates
determines `g`, stated with TCSlib's `KKL.IsJunta` on the `±1` version of `g`
(`boolToSign` is injective, so this is the same as `S` determining `g`). -/
def IsJunta {n : ℕ} (g : BoolFun n) (k : ℕ) : Prop :=
  ∃ S : Finset (Fin n), S.card ≤ k ∧ KKL.IsJunta (fun x => boolToSign (g x)) S

/-- `d(f,g) = 2^{-n} |{x : f x ≠ g x}|`. -/
def boolDist {n : ℕ} (f g : BoolFun n) : ℝ :=
  ((univ.filter (fun x : BoolCube n => f x ≠ g x)).card : ℝ) / (2 : ℝ) ^ n

/-- `d(f, J_k) = min_{g ∈ J_k} d(f,g)`. The set is finite and nonempty (constants are
juntas), so the infimum is a minimum. -/
def distJunta {n : ℕ} (f : BoolFun n) (k : ℕ) : ℝ :=
  sInf {d : ℝ | ∃ g : BoolFun n, IsJunta g k ∧ d = boolDist f g}

/-! ## Adaptive query trees and randomized testers -/

/-- A deterministic adaptive query algorithm: either it stops with a verdict
(`true` = accept), or it queries `f x` and continues depending on the answer. -/
inductive QTree (n : ℕ) : Type
  | leaf : Bool → QTree n
  | query : (Fin n → Bool) → (Bool → QTree n) → QTree n

/-- Output of a query tree run on the oracle `f`. -/
def QTree.eval {n : ℕ} : QTree n → BoolFun n → Bool
  | .leaf b, _ => b
  | .query x c, f => (c (f x)).eval f

/-- Number of queries made by a query tree on the oracle `f`. -/
def QTree.pathLen {n : ℕ} : QTree n → BoolFun n → ℕ
  | .leaf _, _ => 0
  | .query x c, f => (c (f x)).pathLen f + 1

/-- A randomized adaptive tester on `{0,1}^n`: tree `tree i` is run with probability
`w i`, where `w` is a finite probability distribution on the tree indices. -/
structure RandTester (n : ℕ) where
  m : ℕ
  w : FinDist (Fin m)
  tree : Fin m → QTree n

/-- Probability that `T` accepts `f`. -/
def RandTester.acceptProb {n : ℕ} (T : RandTester n) (f : BoolFun n) : ℝ :=
  ∑ i, T.w i * (if (T.tree i).eval f then 1 else 0)

/-- `T` makes at most `q` queries on every input satisfying `Good`, for every realization of
its randomness that has positive probability. -/
def RandTester.QueryBoundedOn {n : ℕ} (T : RandTester n) (Good : BoolFun n → Prop)
    (q : ℕ) : Prop :=
  ∀ i, 0 < T.w i → ∀ f, Good f → (T.tree i).pathLen f ≤ q

/-- `(k, k', ε₁, ε₂)`-tester: accepts with probability `≥ 2/3` if `d(f,J_k) ≤ ε₁`, and
rejects with probability `≥ 2/3` if `d(f,J_{k'}) ≥ ε₂`. -/
def RandTester.IsRelaxedTester {n : ℕ} (T : RandTester n) (k k' : ℕ) (ε₁ ε₂ : ℝ) : Prop :=
  (∀ f : BoolFun n, distJunta f k ≤ ε₁ → 2 / 3 ≤ T.acceptProb f) ∧
  (∀ f : BoolFun n, ε₂ ≤ distJunta f k' → T.acceptProb f ≤ 1 / 3)

/-- `(k, ε₁, ε₂)`-tolerant junta tester. -/
def RandTester.IsTolerantTester {n : ℕ} (T : RandTester n) (k : ℕ) (ε₁ ε₂ : ℝ) : Prop :=
  T.IsRelaxedTester k k ε₁ ε₂

/-- Inputs satisfying one of the two promises of the `(k, ε₁, ε₂)` tolerant problem. -/
def PromiseInput {n : ℕ} (k : ℕ) (ε₁ ε₂ : ℝ) (f : BoolFun n) : Prop :=
  distJunta f k ≤ ε₁ ∨ ε₂ ≤ distJunta f k

/-! ## Minority cost and odd-parity strings -/

/-- Hamming weight of a bit string. -/
def weight {m : ℕ} (x : Fin m → Bool) : ℕ :=
  (univ.filter (fun i : Fin m => x i = true)).card

/-- `h(x) = min(|x|, m - |x|)`, the distance of `x` to the two constant strings. -/
def minCost {m : ℕ} (x : Fin m → Bool) : ℕ :=
  min (weight x) (m - weight x)

/-- `Δ_m = E[h(U)]/m` for a uniform `m`-bit string `U`. -/
def deltaAvg (m : ℕ) : ℝ :=
  (∑ x : Fin m → Bool, (minCost x : ℝ)) / ((2 : ℝ) ^ m * m)

/-- The `m`-bit strings of odd parity. -/
def oddStrings (m : ℕ) : Finset (Fin m → Bool) :=
  univ.filter (fun x : Fin m → Bool => weight x % 2 = 1)

/-! ## The hard distributions (probability mass functions on truth tables) -/

/-- "`x` restricted to the prefix `[r]` is zero" (coordinates `0, …, r-1`). -/
def PrefixZero {n : ℕ} (r : ℕ) (x : Fin n → Bool) : Prop :=
  ∀ i : Fin n, i.val < r → x i = false

/-- Bernoulli(`p`) mass of a bit. -/
def bern (p : ℝ) (b : Bool) : ℝ := if b then p else 1 - p

/-- NO distribution `P`: independent entries, fair on the zero-prefix subcube and
Bernoulli(`p`) elsewhere. -/
def noPmf (n r : ℕ) (p : ℝ) (f : BoolFun n) : ℝ :=
  ∏ x : Fin n → Bool, (if PrefixZero r x then (1 / 2 : ℝ) else bern p (f x))

/-- The `J`-fiber of `x` (all points agreeing with `x` outside `J`) has an odd number of
ones of `f`. -/
def FiberOdd {n : ℕ} (J : Finset (Fin n)) (f : BoolFun n) (x : Fin n → Bool) : Prop :=
  (univ.filter (fun y : Fin n → Bool => (∀ i, i ∉ J → y i = x i) ∧ f y = true)).card % 2 = 1

/-- Number of points in the zero-prefix subcube. -/
def numZero (n r : ℕ) : ℕ := (univ.filter (fun x : Fin n → Bool => PrefixZero r x)).card

/-- The YES distribution `Q` conditioned on the hidden set `J ⊆ {r+1,…,n}`: Bernoulli(`p`)
entries outside the zero-prefix subcube; inside it, every `J`-fiber is an independent
uniformly random odd-parity string (each of the `numZero / 2^|J|` fibers has `2^{|J|-1}`
odd completions). -/
def yesPmfGiven (n r : ℕ) (p : ℝ) (J : Finset (Fin n)) (f : BoolFun n) : ℝ :=
  (∏ x : Fin n → Bool, (if PrefixZero r x then (1 : ℝ) else bern p (f x))) *
    (if ∀ x, PrefixZero r x → FiberOdd J f x then
      (1 / 2 : ℝ) ^ numZero n r * (2 : ℝ) ^ (numZero n r / 2 ^ J.card) else 0)

/-- Candidate hidden sets: `ℓ`-subsets of the non-prefix coordinates `{r+1,…,n}`. -/
def candidateSets (n r ℓ : ℕ) : Finset (Finset (Fin n)) :=
  (univ.filter (fun i : Fin n => r ≤ i.val)).powersetCard ℓ

/-- The YES distribution `Q`: uniform hidden `J`, then `yesPmfGiven`. -/
def yesPmf (n r ℓ : ℕ) (p : ℝ) (f : BoolFun n) : ℝ :=
  (∑ J ∈ candidateSets n r ℓ, yesPmfGiven n r p J f) / ((candidateSets n r ℓ).card : ℝ)

/-- Mass of an event under a mass function on truth tables. -/
def massOf {n : ℕ} (μ : BoolFun n → ℝ) (E : BoolFun n → Prop) : ℝ :=
  ∑ f ∈ univ.filter E, μ f

/-- Probability that the deterministic tree `t` accepts when the oracle is drawn from `μ`. -/
def treeAccept {n : ℕ} (μ : BoolFun n → ℝ) (t : QTree n) : ℝ :=
  ∑ f, μ f * (if t.eval f then 1 else 0)

/-! ## Lemma stubs -/

/-- Eq. (3): if `4 ∣ m`, a uniform odd-parity string has expected minority cost at least
`1/m` below a uniform string. [NewLowerBoundsFor, node_05] -/
theorem oddParity_minority_improvement (m : ℕ) (hm : 0 < m) (h4 : 4 ∣ m) :
    (∑ x ∈ oddStrings m, (minCost x : ℝ)) / ((oddStrings m).card : ℝ) ≤
      (∑ x : Fin m → Bool, (minCost x : ℝ)) / (2 : ℝ) ^ m - 1 / (m : ℝ) := by
  sorry

/-- Proper-subset marginals: fixing `s < m` coordinates leaves exactly `2^{m-s-1}` odd
completions, so a uniform odd-parity string is uniform on every proper subset. [NewLowerBoundsFor, node_05] -/
theorem oddParity_proper_marginal (m : ℕ) (s : Finset (Fin m)) (hs : s ≠ univ)
    (a : Fin m → Bool) :
    ((oddStrings m).filter (fun x => ∀ i ∈ s, x i = a i)).card = 2 ^ (m - s.card - 1) := by
  sorry

/-- Eq. (6): adaptive indistinguishability. For every deterministic adaptive tree making at
most `q` queries, the acceptance probabilities under `P` and `Q` differ by at most
`binom(q,2)/binom(n-r,ℓ)`. [NewLowerBoundsFor, node_05] -/
theorem adaptive_indistinguishability (n r ℓ q : ℕ) (p : ℝ) (hp0 : 0 ≤ p) (hp1 : p ≤ 1)
    (hℓ : 1 ≤ ℓ) (hrℓ : r + ℓ ≤ n) (t : QTree n) (ht : ∀ f, t.pathLen f ≤ q) :
    |treeAccept (noPmf n r p) t - treeAccept (yesPmf n r ℓ p) t| ≤
      (q.choose 2 : ℝ) / ((n - r).choose ℓ : ℝ) := by
  sorry

/-- Eq. (7): NO samples are far from every `k`-junta (uniformly over all coordinate sets),
except with probability `ζ_k = (2k)^k exp(-2·2^{k/3})`. Here
`B = p(1-a) + aΔ_m`, `a = 2^{-r}`, `m = 2^ℓ`, `E = exp(-m(1/2-p)²/12)`,
`s_k = 2^{-k/3}`. [NewLowerBoundsFor, node_05] -/
theorem no_far (k r ℓ : ℕ) (p : ℝ) (hr : r ≤ k) (hℓ2 : 2 ≤ ℓ) (hℓk : ℓ ≤ k)
    (hp0 : 0 ≤ p) (hp : p < 1 / 2) :
    massOf (noPmf (k + ℓ) r p)
        (fun f => distJunta f k <
          p * (1 - (1 / 2 : ℝ) ^ r) + (1 / 2 : ℝ) ^ r * deltaAvg (2 ^ ℓ)
            - Real.exp (-((2 : ℝ) ^ ℓ * (1 / 2 - p) ^ 2 / 12))
            - (2 : ℝ) ^ (-(k : ℝ) / 3)) ≤
      (2 * (k : ℝ)) ^ k * Real.exp (-2 * (2 : ℝ) ^ ((k : ℝ) / 3)) := by
  sorry

/-- Eq. (8): YES samples are close to `J_k` (via the junta on `[n] ∖ J`), with the
odd-parity saving `D = a/m²`, except with probability `ζ_k`. [NewLowerBoundsFor, node_05] -/
theorem yes_close (k r ℓ : ℕ) (p : ℝ) (hr : r ≤ k) (hℓ2 : 2 ≤ ℓ) (hℓk : ℓ ≤ k)
    (hp0 : 0 ≤ p) (hp : p < 1 / 2) :
    massOf (yesPmf (k + ℓ) r ℓ p)
        (fun f => p * (1 - (1 / 2 : ℝ) ^ r) + (1 / 2 : ℝ) ^ r * deltaAvg (2 ^ ℓ)
            - (1 / 2 : ℝ) ^ r / ((2 : ℝ) ^ ℓ) ^ 2 + (2 : ℝ) ^ (-(k : ℝ) / 3) <
          distJunta f k) ≤
      (2 * (k : ℝ)) ^ k * Real.exp (-2 * (2 : ℝ) ^ ((k : ℝ) / 3)) := by
  sorry

/-- Eq. (16), the baseline bound: in dimension `n = k + 12`, every randomized adaptive
`(k, ε₁, ε₂)`-tolerant tester with `0 ≤ ε₁ < ε₂ ≤ 0.49` needs `√(n/24)` queries on some
promise input, for all large `k`. [NewLowerBoundsFor, node_05] -/
theorem baseline_sqrt_bound :
    ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k → ∀ ε₁ ε₂ : ℝ, 0 ≤ ε₁ → ε₁ < ε₂ → ε₂ ≤ 0.49 →
      ∀ T : RandTester (k + 12), T.IsTolerantTester k ε₁ ε₂ →
        ∀ q : ℕ, T.QueryBoundedOn (PromiseInput k ε₁ ε₂) q →
          Real.sqrt (((k : ℝ) + 12) / 24) ≤ q := by
  sorry

/-! ## Main theorem -/

/-- **Main theorem.** There is an absolute `c > 0` such that for every `A > 0` and all
`k ≥ k₀(A)`, all `0.01 ≤ ε₁ < ε₂ ≤ 0.49` with `δ = ε₂ - ε₁ ≥ 2^{-A k^{0.99}}`: some
dimension `n ≥ k` forces every randomized adaptive `(k, ε₁, ε₂)`-tolerant junta tester to
make at least `k^{c log₂(1/δ)}` queries on some promise input. [NewLowerBoundsFor, node_05] -/
theorem tolerant_junta_lower_bound :
    ∃ c : ℝ, 0 < c ∧ ∀ A : ℝ, 0 < A → ∃ k₀ : ℕ, ∀ k : ℕ, k₀ ≤ k →
      ∀ ε₁ ε₂ : ℝ, 0.01 ≤ ε₁ → ε₁ < ε₂ → ε₂ ≤ 0.49 →
        (2 : ℝ) ^ (-(A * (k : ℝ) ^ (0.99 : ℝ))) ≤ ε₂ - ε₁ →
        ∃ n : ℕ, k ≤ n ∧
          ∀ T : RandTester n, T.IsTolerantTester k ε₁ ε₂ →
            ∀ q : ℕ, T.QueryBoundedOn (PromiseInput k ε₁ ε₂) q →
              (k : ℝ) ^ (c * Real.logb 2 (1 / (ε₂ - ε₁))) ≤ q := by
  sorry

end TCSChallenge.NewLowerBoundsForAdaptiveTolerantJuntaTesting.node_05
