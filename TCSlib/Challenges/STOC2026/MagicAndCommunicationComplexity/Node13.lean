/-!
## Adaptive Clifford+Magic circuits vs. interactive randomized communication

An adaptive Clifford+Magic circuit starts on `|x⟩_A|y⟩_B|ψ⟩`, applies Clifford gates, magic
gates on `≤ c_M` qubits and computational-basis measurements of `≤ c_M` qubits, with later
operations depending on earlier outcomes. Its cost is the maximum, over branches, of the
number of magic gates plus mid-circuit measurements. Every such circuit of cost `m` with
error `ε` yields a randomized protocol with `≤ 2 c_M m + 1` bits, so
`(R_ε(f) - 1)/(2 c_M) ≤ M^adaptive_{ε,c_M}(f)`. Main theorem: `magic_adaptive_lower_bound`.
-/

namespace TCSChallenge.MagicAndCommunicationComplexity.node_13

/-! ## Shared quantum definitions (byte-identical in node_09, node_12, node_13) -/

/-- Computational-basis strings of a set `Q` of qubits. -/
abbrev CBasis (Q : Type) : Type := Q → Bool

/-- The qubits: Alice's input register `A` (`nA` qubits), Bob's input register `B`
(`nB` qubits) and `k` auxiliary (advice) qubits `E`. -/
abbrev Qubit (nA nB k : ℕ) : Type := Fin nA ⊕ Fin nB ⊕ Fin k

/-- The Pauli operator `X^a Z^b` on the qubits `Q`: `Z^b |v⟩ = (-1)^{b·v} |v⟩`, then
`X^a |v⟩ = |v ⊕ a⟩`. -/
def pauli {Q : Type} [Fintype Q] [DecidableEq Q] (a b : Q → Bool) :
    Matrix (CBasis Q) (CBasis Q) ℂ :=
  fun u v =>
    if u = (fun i => xor (v i) (a i)) then
      (-1 : ℂ) ^ (Finset.univ.filter (fun i => b i = true ∧ v i = true)).card
    else 0

/-- "the `N`-qubit Pauli group consists of tensor products of the one-qubit Pauli operators,
including scalar phases": the elements `i^j X^a Z^b`. -/
def IsPauliGroupElem {Q : Type} [Fintype Q] [DecidableEq Q]
    (P : Matrix (CBasis Q) (CBasis Q) ℂ) : Prop :=
  ∃ (j : ℕ) (a b : Q → Bool), P = Complex.I ^ j • pauli a b

/-- "An `N`-qubit Clifford unitary is a unitary that normalizes this group":
`C 𝒫 Cᴴ = 𝒫`, written as `P ∈ 𝒫 ↔ C P Cᴴ ∈ 𝒫` (equivalent for unitary `C`). -/
def IsClifford {Q : Type} [Fintype Q] [DecidableEq Q]
    (C : Matrix (CBasis Q) (CBasis Q) ℂ) : Prop :=
  C ∈ Matrix.unitaryGroup (CBasis Q) ℂ ∧
    ∀ P : Matrix (CBasis Q) (CBasis Q) ℂ,
      IsPauliGroupElem P ↔ IsPauliGroupElem (C * P * Matrix.conjTranspose C)

/-- "acts nontrivially on at most the qubits in `S`": `U = V ⊗ I` with `V` acting on `S`. -/
def SupportedOn {Q : Type} [Fintype Q] [DecidableEq Q] (S : Finset Q)
    (U : Matrix (CBasis Q) (CBasis Q) ℂ) : Prop :=
  ∃ V : Matrix (↥S → Bool) (↥S → Bool) ℂ, ∀ u v : CBasis Q,
    U u v = if (∀ i, i ∉ S → u i = v i) then V (fun i => u i.1) (fun i => v i.1) else 0

/-- The initial state `|x⟩_A |y⟩_B |ψ⟩_E`. -/
def initState {nA nB k : ℕ} (x : Fin nA → Bool) (y : Fin nB → Bool)
    (ψ : CBasis (Fin k) → ℂ) : CBasis (Qubit nA nB k) → ℂ :=
  fun u =>
    if (∀ i, u (Sum.inl i) = x i) ∧ (∀ j, u (Sum.inr (Sum.inl j)) = y j) then
      ψ (fun l => u (Sum.inr (Sum.inr l)))
    else 0

/-- Probability that measuring qubit `o` of the (unnormalized) state `ψ` in the
computational basis gives `b`. -/
def measureProb {Q : Type} [Fintype Q] [DecidableEq Q] (ψ : CBasis Q → ℂ) (o : Q)
    (b : Bool) : ℝ :=
  ∑ u ∈ Finset.univ.filter (fun u : CBasis Q => u o = b), Complex.normSq (ψ u)

/-! ## Adaptive circuits -/

/-- An adaptive Clifford+Magic circuit on qubits `Q`, as a tree. `measure S next` measures the
qubits of `S` in the computational basis and continues with `next z` on outcome `z`;
`output o` is the final measurement of the designated output qubit `o`. -/
inductive AdaptiveCircuit (Q : Type) where
  | output (o : Q)
  | clifford (C : Matrix (CBasis Q) (CBasis Q) ℂ) (next : AdaptiveCircuit Q)
  | magic (S : Finset Q) (M : Matrix (CBasis Q) (CBasis Q) ℂ) (next : AdaptiveCircuit Q)
  | measure (S : Finset Q) (next : (↥S → Bool) → AdaptiveCircuit Q)

/-- Projection of `ψ` onto outcome `z` of measuring `S` (unnormalized). -/
def projectOutcome {Q : Type} (S : Finset Q) (z : ↥S → Bool) (ψ : CBasis Q → ℂ) :
    CBasis Q → ℂ :=
  fun u => if (∀ i : ↥S, u i.1 = z i) then ψ u else 0

/-- Probability that the circuit, run on the unnormalized state `ψ`, outputs `b`
(sum over measurement branches of the joint probabilities). -/
def AdaptiveCircuit.outProb {Q : Type} [Fintype Q] [DecidableEq Q] :
    AdaptiveCircuit Q → (CBasis Q → ℂ) → Bool → ℝ
  | .output o, ψ, b => measureProb ψ o b
  | .clifford C c, ψ, b => AdaptiveCircuit.outProb c (C.mulVec ψ) b
  | .magic _ M c, ψ, b => AdaptiveCircuit.outProb c (M.mulVec ψ) b
  | .measure S c, ψ, b =>
      ∑ z : (↥S → Bool), AdaptiveCircuit.outProb (c z) (projectOutcome S z ψ) b

/-- Cost: the maximum over branches of the number of magic gates plus mid-circuit
measurements (the final output measurement is excluded). -/
def AdaptiveCircuit.cost {Q : Type} [DecidableEq Q] : AdaptiveCircuit Q → ℕ
  | .output _ => 0
  | .clifford _ c => AdaptiveCircuit.cost c
  | .magic _ _ c => AdaptiveCircuit.cost c + 1
  | .measure S c => Finset.univ.sup (fun z : (↥S → Bool) => AdaptiveCircuit.cost (c z)) + 1

/-- Admissibility: Clifford gates are Clifford, magic gates are unitaries supported on
`≤ cM` qubits, mid-circuit measurements touch `≤ cM` qubits. -/
def AdaptiveCircuit.Valid {Q : Type} [Fintype Q] [DecidableEq Q] (cM : ℕ) :
    AdaptiveCircuit Q → Prop
  | .output _ => True
  | .clifford C c => IsClifford C ∧ AdaptiveCircuit.Valid cM c
  | .magic S M c => M ∈ Matrix.unitaryGroup (CBasis Q) ℂ ∧ SupportedOn S M ∧
      S.card ≤ cM ∧ AdaptiveCircuit.Valid cM c
  | .measure S c => S.card ≤ cM ∧ ∀ z, AdaptiveCircuit.Valid cM (c z)

/-- An adaptive Clifford+Magic circuit for `n`-bit inputs with `k` ancilla qubits in the fixed
(input-independent) state `ancilla`. -/
structure AdaptiveCMCircuit (n : ℕ) where
  k : ℕ
  ancilla : CBasis (Fin k) → ℂ
  circ : AdaptiveCircuit (Qubit n n k)

/-- Admissibility: normalized ancilla state, admissible operations. -/
def AdaptiveCMCircuit.Valid {n : ℕ} (cM : ℕ) (Q : AdaptiveCMCircuit n) : Prop :=
  (∑ w, Complex.normSq (Q.ancilla w)) = 1 ∧ Q.circ.Valid cM

/-- Worst-case error at most `ε`. -/
def AdaptiveCMCircuit.ComputesWithError {n : ℕ} (Q : AdaptiveCMCircuit n)
    (f : (Fin n → Bool) → (Fin n → Bool) → Bool) (ε : ℝ) : Prop :=
  ∀ x y, 1 - ε ≤ Q.circ.outProb (initState x y Q.ancilla) (f x y)

/-- `M^adaptive_{ε,c_M}(f)`. -/
def magicAdaptive (cM : ℕ) {n : ℕ} (f : (Fin n → Bool) → (Fin n → Bool) → Bool) (ε : ℝ) :
    ℕ :=
  sInf {m | ∃ Q : AdaptiveCMCircuit n, Q.Valid cM ∧ Q.ComputesWithError f ε ∧
    Q.circ.cost = m}

/-! ## Interactive randomized classical protocols -/

/-- A randomized protocol tree. At `alice p next` Alice sends bit `1` with probability `p x`
and play continues at `next bit`; similarly for Bob. At `output p` Alice outputs `true` with
probability `p x`. -/
inductive RandProtocol (X Y : Type) where
  | output (p : X → ℝ)
  | alice (p : X → ℝ) (next : Bool → RandProtocol X Y)
  | bob (p : Y → ℝ) (next : Bool → RandProtocol X Y)

/-- All probabilities lie in `[0,1]`. -/
def RandProtocol.Valid {X Y : Type} : RandProtocol X Y → Prop
  | .output p => ∀ x, 0 ≤ p x ∧ p x ≤ 1
  | .alice p next => (∀ x, 0 ≤ p x ∧ p x ≤ 1) ∧ ∀ b, RandProtocol.Valid (next b)
  | .bob p next => (∀ y, 0 ≤ p y ∧ p y ≤ 1) ∧ ∀ b, RandProtocol.Valid (next b)

/-- Worst-case number of bits exchanged. -/
def RandProtocol.depth {X Y : Type} : RandProtocol X Y → ℕ
  | .output _ => 0
  | .alice _ next => max (RandProtocol.depth (next false)) (RandProtocol.depth (next true)) + 1
  | .bob _ next => max (RandProtocol.depth (next false)) (RandProtocol.depth (next true)) + 1

/-- Probability that Alice outputs `true` on input `(x, y)`. -/
def RandProtocol.probTrue {X Y : Type} : RandProtocol X Y → X → Y → ℝ
  | .output p, x, _ => p x
  | .alice p next, x, y =>
      p x * RandProtocol.probTrue (next true) x y +
        (1 - p x) * RandProtocol.probTrue (next false) x y
  | .bob p next, x, y =>
      p y * RandProtocol.probTrue (next true) x y +
        (1 - p y) * RandProtocol.probTrue (next false) x y

/-- "Alice outputs `f(x,y)` with probability at least `1-ε` on every input". -/
def RandProtocol.ComputesWithError {n : ℕ} (P : RandProtocol (Fin n → Bool) (Fin n → Bool))
    (f : (Fin n → Bool) → (Fin n → Bool) → Bool) (ε : ℝ) : Prop :=
  ∀ x y, 1 - ε ≤ (if f x y then P.probTrue x y else 1 - P.probTrue x y)

/-- `R_ε(f)`. -/
def randCC {n : ℕ} (f : (Fin n → Bool) → (Fin n → Bool) → Bool) (ε : ℝ) : ℕ :=
  sInf {c | ∃ P : RandProtocol (Fin n → Bool) (Fin n → Bool),
    P.Valid ∧ P.ComputesWithError f ε ∧ P.depth ≤ c}

/-! ## Lemma stubs -/

/-- Clifford conjugation sends a Pauli `X^a Z^b` to a phase times a Pauli. [MagicAndCommunicationComplexity, node_13] -/
theorem clifford_conj_pauli {Q : Type} [Fintype Q] [DecidableEq Q]
    (C : Matrix (CBasis Q) (CBasis Q) ℂ) (hC : IsClifford C) (a b : Q → Bool) :
    ∃ (j : ℕ) (a' b' : Q → Bool),
      C * pauli a b * Matrix.conjTranspose C = Complex.I ^ j • pauli a' b' := by
  sorry

/-- Initial frame: `|x⟩|0⟩|ψ⟩ = X_B^y |x⟩|y⟩|ψ⟩`. [MagicAndCommunicationComplexity, node_13] -/
theorem input_frame_bob {n k : ℕ} (x y : Fin n → Bool) (ψ : CBasis (Fin k) → ℂ) :
    (pauli (Sum.elim (fun _ => false) (Sum.elim y (fun _ => false))) (fun _ => false)).mulVec
        (initState x y ψ) =
      initState x (fun _ => false) ψ := by
  sorry

/-- A Pauli supported outside the support `S` of a magic gate commutes with it. [MagicAndCommunicationComplexity, node_13] -/
theorem magic_commutes_pauli_off_support {Q : Type} [Fintype Q] [DecidableEq Q]
    (S : Finset Q) (M : Matrix (CBasis Q) (CBasis Q) ℂ) (hM : SupportedOn S M)
    (a b : Q → Bool) (ha : ∀ i ∈ S, a i = false) (hb : ∀ i ∈ S, b i = false) :
    M * pauli a b = pauli a b * M := by
  sorry

/-- Measurement with a residual frame having no `X`-part on `S`: outcome probabilities are
unchanged, and the post-measurement state differs from the ideal one by the frame up to a
phase. [MagicAndCommunicationComplexity, node_13] -/
theorem measure_with_Z_frame {Q : Type} [Fintype Q] [DecidableEq Q] (S : Finset Q)
    (a b : Q → Bool) (ha : ∀ i ∈ S, a i = false) (ψ : CBasis Q → ℂ) (z : ↥S → Bool) :
    (∑ u, Complex.normSq (projectOutcome S z ((pauli a b).mulVec ψ) u)) =
        ∑ u, Complex.normSq (projectOutcome S z ψ u) ∧
      ∃ s : ℂ, (s = 1 ∨ s = -1) ∧
        projectOutcome S z ((pauli a b).mulVec ψ) =
          s • (pauli a b).mulVec (projectOutcome S z ψ) := by
  sorry

/-- Per-circuit simulation: an admissible adaptive circuit of cost `m` with error `ε` yields a
randomized protocol of cost `≤ 2 c_M m + 1` with the same error. [MagicAndCommunicationComplexity, node_13] -/
theorem randCC_le_of_adaptive (cM : ℕ) (hcM : 1 ≤ cM) {n : ℕ}
    (f : (Fin n → Bool) → (Fin n → Bool) → Bool) (ε : ℝ) (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1)
    (Q : AdaptiveCMCircuit n) (hQ : Q.Valid cM) (hf : Q.ComputesWithError f ε) :
    randCC f ε ≤ 2 * cM * Q.circ.cost + 1 := by
  sorry

/-! ## Main theorem -/

/-- `(R_ε(f) - 1) / (2 c_M) ≤ M^adaptive_{ε,c_M}(f)`. [MagicAndCommunicationComplexity, node_13] -/
theorem magic_adaptive_lower_bound (cM : ℕ) (hcM : 1 ≤ cM) {n : ℕ}
    (f : (Fin n → Bool) → (Fin n → Bool) → Bool) (ε : ℝ) (hε0 : 0 ≤ ε) (hε1 : ε ≤ 1)
    (hex : ∃ Q : AdaptiveCMCircuit n, Q.Valid cM ∧ Q.ComputesWithError f ε) :
    ((randCC f ε : ℝ) - 1) / (2 * (cM : ℝ)) ≤ (magicAdaptive cM f ε : ℝ) := by
  sorry

