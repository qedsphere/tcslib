/-!
## Unitary Clifford+Magic circuits vs. deterministic simultaneous messages

A unitary Clifford+Magic circuit acts on `|x⟩|y⟩|ψ⟩` (advice `ψ` independent of the input),
applies Clifford unitaries and magic unitaries (each supported on at most `c_M` qubits), and
measures one output qubit in the computational basis. If it computes `f` with error `ε < 1/2`
using `m` magic gates, then `D^∥(f) ≤ 4 c_M m + 2`, where `D^∥` is deterministic
simultaneous-message (SMP) complexity. Main theorem: `magic_unitary_lower_bound`.
-/

namespace TCSChallenge.MagicAndCommunicationComplexity.node_09

/-! ## Shared quantum definitions (byte-identical in node_09, node_12, node_13) -/

/-- Computational-basis strings of a set `Q` of qubits. -/
abbrev CBasis (Q : Type) : Type := Q → Bool

/-- The qubits: Alice's input register `A` (`nA` qubits), Bob's input register `B`
(`nB` qubits) and `k` auxiliary (advice) qubits `E`. -/
abbrev Qubit (nA nB k : ℕ) : Type := Fin nA ⊕ Fin nB ⊕ Fin k

/-- The Pauli operator `X^a Z^b` on the qubits `Q`: `Z^b |v⟩ = (-1)^{b·v} |v⟩`, then
`X^a |v⟩ = |v ⊕ a⟩`. -/
def pauli {Q : Type} [Fintype Q] [DecidableEq Q] (a b : Q → Bool) :
    Matrix (CBasis Q) (CBasis Q) ℂ :=
  fun u v =>
    if u = (fun i => xor (v i) (a i)) then
      (-1 : ℂ) ^ (Finset.univ.filter (fun i => b i = true ∧ v i = true)).card
    else 0

/-- "the `N`-qubit Pauli group consists of tensor products of the one-qubit Pauli operators,
including scalar phases": the elements `i^j X^a Z^b`. -/
def IsPauliGroupElem {Q : Type} [Fintype Q] [DecidableEq Q]
    (P : Matrix (CBasis Q) (CBasis Q) ℂ) : Prop :=
  ∃ (j : ℕ) (a b : Q → Bool), P = Complex.I ^ j • pauli a b

/-- "An `N`-qubit Clifford unitary is a unitary that normalizes this group":
`C 𝒫 Cᴴ = 𝒫`, written as `P ∈ 𝒫 ↔ C P Cᴴ ∈ 𝒫` (equivalent for unitary `C`). -/
def IsClifford {Q : Type} [Fintype Q] [DecidableEq Q]
    (C : Matrix (CBasis Q) (CBasis Q) ℂ) : Prop :=
  C ∈ Matrix.unitaryGroup (CBasis Q) ℂ ∧
    ∀ P : Matrix (CBasis Q) (CBasis Q) ℂ,
      IsPauliGroupElem P ↔ IsPauliGroupElem (C * P * Matrix.conjTranspose C)

/-- "acts nontrivially on at most the qubits in `S`": `U = V ⊗ I` with `V` acting on `S`. -/
def SupportedOn {Q : Type} [Fintype Q] [DecidableEq Q] (S : Finset Q)
    (U : Matrix (CBasis Q) (CBasis Q) ℂ) : Prop :=
  ∃ V : Matrix (↥S → Bool) (↥S → Bool) ℂ, ∀ u v : CBasis Q,
    U u v = if (∀ i, i ∉ S → u i = v i) then V (fun i => u i.1) (fun i => v i.1) else 0

/-- The initial state `|x⟩_A |y⟩_B |ψ⟩_E`. -/
def initState {nA nB k : ℕ} (x : Fin nA → Bool) (y : Fin nB → Bool)
    (ψ : CBasis (Fin k) → ℂ) : CBasis (Qubit nA nB k) → ℂ :=
  fun u =>
    if (∀ i, u (Sum.inl i) = x i) ∧ (∀ j, u (Sum.inr (Sum.inl j)) = y j) then
      ψ (fun l => u (Sum.inr (Sum.inr l)))
    else 0

/-- Probability that measuring qubit `o` of the (unnormalized) state `ψ` in the
computational basis gives `b`. -/
def measureProb {Q : Type} [Fintype Q] [DecidableEq Q] (ψ : CBasis Q → ℂ) (o : Q)
    (b : Bool) : ℝ :=
  ∑ u ∈ Finset.univ.filter (fun u : CBasis Q => u o = b), Complex.normSq (ψ u)

/-! ## Shared gate model (byte-identical in node_09 and node_12) -/

/-- A gate: a Clifford unitary, or a designated magic gate together with its support. -/
inductive Gate (Q : Type) where
  | clifford (C : Matrix (CBasis Q) (CBasis Q) ℂ)
  | magic (S : Finset Q) (M : Matrix (CBasis Q) (CBasis Q) ℂ)

/-- The matrix of a gate. -/
def Gate.mat {Q : Type} : Gate Q → Matrix (CBasis Q) (CBasis Q) ℂ
  | .clifford C => C
  | .magic _ M => M

/-- Whether a gate is a designated magic gate. -/
def Gate.isMagic {Q : Type} : Gate Q → Bool
  | .clifford _ => false
  | .magic _ _ => true

/-- Admissible gates: Clifford gates are Clifford; magic gates are arbitrary unitaries acting
nontrivially on at most `cM` qubits. -/
def Gate.Valid {Q : Type} [Fintype Q] [DecidableEq Q] (cM : ℕ) : Gate Q → Prop
  | .clifford C => IsClifford C
  | .magic S M => M ∈ Matrix.unitaryGroup (CBasis Q) ℂ ∧ SupportedOn S M ∧ S.card ≤ cM

/-! ## Unitary circuits with pure advice -/

/-- A unitary Clifford+Magic circuit on `nA + nB` input qubits with `k` advice qubits
in a fixed state `advice`, gate list `gates` (applied left to right) and output qubit `out`. -/
structure UnitaryCircuit (nA nB : ℕ) where
  k : ℕ
  advice : CBasis (Fin k) → ℂ
  gates : List (Gate (Qubit nA nB k))
  out : Qubit nA nB k

/-- Final state on input `(x, y)` (no intermediate measurements). -/
def UnitaryCircuit.finalState {nA nB : ℕ} (U : UnitaryCircuit nA nB)
    (x : Fin nA → Bool) (y : Fin nB → Bool) : CBasis (Qubit nA nB U.k) → ℂ :=
  U.gates.foldl (fun s g => (Gate.mat g).mulVec s) (initState x y U.advice)

/-- The number of magic gates. -/
def UnitaryCircuit.magicCount {nA nB : ℕ} (U : UnitaryCircuit nA nB) : ℕ :=
  U.gates.countP (fun g => g.isMagic)

/-- Admissibility: normalized advice state and admissible gates. -/
def UnitaryCircuit.Valid {nA nB : ℕ} (cM : ℕ) (U : UnitaryCircuit nA nB) : Prop :=
  (∑ w, Complex.normSq (U.advice w)) = 1 ∧ ∀ g ∈ U.gates, Gate.Valid cM g

/-- "for every `(x,y)`, the measured bit equals `f(x,y)` with probability at least `1-ε`". -/
def UnitaryCircuit.ComputesWithError {nA nB : ℕ} (U : UnitaryCircuit nA nB)
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) (ε : ℝ) : Prop :=
  ∀ x y, 1 - ε ≤ measureProb (U.finalState x y) U.out (f x y)

/-- `M^unitary_ε(f)`: the minimum number of magic gates of an admissible circuit for `f`. -/
def magicUnitary (cM : ℕ) {nA nB : ℕ} (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool)
    (ε : ℝ) : ℕ :=
  sInf {m | ∃ U : UnitaryCircuit nA nB, U.Valid cM ∧ U.ComputesWithError f ε ∧
    U.magicCount = m}

/-! ## Deterministic simultaneous-message protocols -/

/-- A deterministic SMP protocol: messages `A(x)`, `B(y)` and a referee. -/
structure DetSMP (nA nB : ℕ) where
  alice : (Fin nA → Bool) → List Bool
  bob : (Fin nB → Bool) → List Bool
  referee : List Bool → List Bool → Bool

/-- "the referee must determine `f(x,y)` from `(A(x), B(y))` for every input". -/
def DetSMP.Computes {nA nB : ℕ} (P : DetSMP nA nB)
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) : Prop :=
  ∀ x y, P.referee (P.alice x) (P.bob y) = f x y

/-- Cost at most `c`: the sum of the two message lengths is `≤ c` on every input. -/
def DetSMP.CostLe {nA nB : ℕ} (P : DetSMP nA nB) (c : ℕ) : Prop :=
  ∀ x y, (P.alice x).length + (P.bob y).length ≤ c

/-- `D^∥(f)`. -/
def detSMPComplexity {nA nB : ℕ} (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) : ℕ :=
  sInf {c | ∃ P : DetSMP nA nB, P.Computes f ∧ P.CostLe c}

/-! ## Lemma stubs -/

/-- Clifford conjugation sends a Pauli `X^a Z^b` to a phase times a Pauli. [MagicAndCommunicationComplexity, node_09] -/
theorem clifford_conj_pauli {Q : Type} [Fintype Q] [DecidableEq Q]
    (C : Matrix (CBasis Q) (CBasis Q) ℂ) (hC : IsClifford C) (a b : Q → Bool) :
    ∃ (j : ℕ) (a' b' : Q → Bool),
      C * pauli a b * Matrix.conjTranspose C = Complex.I ^ j • pauli a' b' := by
  sorry

/-- Pauli labels compose additively (xor) up to phase; hence the conjugation map
`(a, b) ↦ (a', b')` of a Clifford is linear over `𝔽₂`. [MagicAndCommunicationComplexity, node_09] -/
theorem pauli_mul_pauli {Q : Type} [Fintype Q] [DecidableEq Q] (a b a' b' : Q → Bool) :
    ∃ j : ℕ, pauli a b * pauli a' b' =
      Complex.I ^ j • pauli (fun i => xor (a i) (a' i)) (fun i => xor (b i) (b' i)) := by
  sorry

/-- The input-dependent frame: `X^{(x,y,0)} |x⟩|y⟩|ψ⟩ = |0⟩|0⟩|ψ⟩`. [MagicAndCommunicationComplexity, node_09] -/
theorem input_frame {nA nB k : ℕ} (x : Fin nA → Bool) (y : Fin nB → Bool)
    (ψ : CBasis (Fin k) → ℂ) :
    (pauli (Sum.elim x (Sum.elim y (fun _ => false))) (fun _ => false)).mulVec
        (initState x y ψ) =
      initState (fun _ => false) (fun _ => false) ψ := by
  sorry

/-- A Pauli supported outside the support `S` of a magic gate commutes with it. [MagicAndCommunicationComplexity, node_09] -/
theorem magic_commutes_pauli_off_support {Q : Type} [Fintype Q] [DecidableEq Q]
    (S : Finset Q) (M : Matrix (CBasis Q) (CBasis Q) ℂ) (hM : SupportedOn S M)
    (a b : Q → Bool) (ha : ∀ i ∈ S, a i = false) (hb : ∀ i ∈ S, b i = false) :
    M * pauli a b = pauli a b * M := by
  sorry

/-- Final measurement: under a residual Pauli frame `X^a Z^b`, only the `X`-label on the
output qubit matters, and it flips the outcome. [MagicAndCommunicationComplexity, node_09] -/
theorem measureProb_pauli {Q : Type} [Fintype Q] [DecidableEq Q] (a b : Q → Bool)
    (ψ : CBasis Q → ℂ) (o : Q) (r : Bool) :
    measureProb ((pauli a b).mulVec ψ) o r = measureProb ψ o (xor r (a o)) := by
  sorry

/-- Per-circuit simulation: every admissible circuit with error `ε < 1/2` and `m` magic gates
gives a deterministic SMP protocol of cost `≤ 4 c_M m + 2`. [MagicAndCommunicationComplexity, node_09] -/
theorem detSMP_le_of_circuit (cM : ℕ) (hcM : 1 ≤ cM) {nA nB : ℕ}
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) (ε : ℝ) (hε : ε < 1 / 2)
    (U : UnitaryCircuit nA nB) (hU : U.Valid cM) (hf : U.ComputesWithError f ε) :
    detSMPComplexity f ≤ 4 * cM * U.magicCount + 2 := by
  sorry

/-! ## Main theorem -/

/-- `(D^∥(f) - 2) / (4 c_M) ≤ M^unitary_ε(f)` for every `ε < 1/2`. [MagicAndCommunicationComplexity, node_09] -/
theorem magic_unitary_lower_bound (cM : ℕ) (hcM : 1 ≤ cM) {nA nB : ℕ}
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) (ε : ℝ) (hε : ε < 1 / 2)
    (hex : ∃ U : UnitaryCircuit nA nB, U.Valid cM ∧ U.ComputesWithError f ε) :
    ((detSMPComplexity f : ℝ) - 2) / (4 * (cM : ℝ)) ≤ (magicUnitary cM f ε : ℝ) := by
  sorry

