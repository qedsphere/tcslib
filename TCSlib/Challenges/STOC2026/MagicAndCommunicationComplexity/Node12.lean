/-!
## Mixed Clifford+Magic circuits vs. public-coin simultaneous messages

A mixed Clifford+magic circuit samples an input-independent branch `U_i` with probability
`p_i` and runs it on `|x⟩⟨x| ⊗ |y⟩⟨y| ⊗ ρ_E`; its magic cost is `max_{p_i > 0} m(U_i)`.
If it computes `f` on `D` with error `ε`, then `R^∥pub_ε(f) ≤ 4 c_M M + 2`, hence
`(R^∥pub_ε(f) - 2)/(4 c_M) ≤ M^mixed_ε(f)`. Main theorem: `magic_mixed_lower_bound`.
-/

namespace TCSChallenge.MagicAndCommunicationComplexity.node_12

/-! ## Shared quantum definitions (byte-identical in node_09, node_12, node_13) -/

/-- Computational-basis strings of a set `Q` of qubits. -/
abbrev CBasis (Q : Type) : Type := Q → Bool

/-- The qubits: Alice's input register `A` (`nA` qubits), Bob's input register `B`
(`nB` qubits) and `k` auxiliary (advice) qubits `E`. -/
abbrev Qubit (nA nB k : ℕ) : Type := Fin nA ⊕ Fin nB ⊕ Fin k

/-- The Pauli operator `X^a Z^b` on the qubits `Q`: `Z^b |v⟩ = (-1)^{b·v} |v⟩`, then
`X^a |v⟩ = |v ⊕ a⟩`. -/
def pauli {Q : Type} [Fintype Q] [DecidableEq Q] (a b : Q → Bool) :
    Matrix (CBasis Q) (CBasis Q) ℂ :=
  fun u v =>
    if u = (fun i => xor (v i) (a i)) then
      (-1 : ℂ) ^ (Finset.univ.filter (fun i => b i = true ∧ v i = true)).card
    else 0

/-- "the `N`-qubit Pauli group consists of tensor products of the one-qubit Pauli operators,
including scalar phases": the elements `i^j X^a Z^b`. -/
def IsPauliGroupElem {Q : Type} [Fintype Q] [DecidableEq Q]
    (P : Matrix (CBasis Q) (CBasis Q) ℂ) : Prop :=
  ∃ (j : ℕ) (a b : Q → Bool), P = Complex.I ^ j • pauli a b

/-- "An `N`-qubit Clifford unitary is a unitary that normalizes this group":
`C 𝒫 Cᴴ = 𝒫`, written as `P ∈ 𝒫 ↔ C P Cᴴ ∈ 𝒫` (equivalent for unitary `C`). -/
def IsClifford {Q : Type} [Fintype Q] [DecidableEq Q]
    (C : Matrix (CBasis Q) (CBasis Q) ℂ) : Prop :=
  C ∈ Matrix.unitaryGroup (CBasis Q) ℂ ∧
    ∀ P : Matrix (CBasis Q) (CBasis Q) ℂ,
      IsPauliGroupElem P ↔ IsPauliGroupElem (C * P * Matrix.conjTranspose C)

/-- "acts nontrivially on at most the qubits in `S`": `U = V ⊗ I` with `V` acting on `S`. -/
def SupportedOn {Q : Type} [Fintype Q] [DecidableEq Q] (S : Finset Q)
    (U : Matrix (CBasis Q) (CBasis Q) ℂ) : Prop :=
  ∃ V : Matrix (↥S → Bool) (↥S → Bool) ℂ, ∀ u v : CBasis Q,
    U u v = if (∀ i, i ∉ S → u i = v i) then V (fun i => u i.1) (fun i => v i.1) else 0

/-- The initial state `|x⟩_A |y⟩_B |ψ⟩_E`. -/
def initState {nA nB k : ℕ} (x : Fin nA → Bool) (y : Fin nB → Bool)
    (ψ : CBasis (Fin k) → ℂ) : CBasis (Qubit nA nB k) → ℂ :=
  fun u =>
    if (∀ i, u (Sum.inl i) = x i) ∧ (∀ j, u (Sum.inr (Sum.inl j)) = y j) then
      ψ (fun l => u (Sum.inr (Sum.inr l)))
    else 0

/-- Probability that measuring qubit `o` of the (unnormalized) state `ψ` in the
computational basis gives `b`. -/
def measureProb {Q : Type} [Fintype Q] [DecidableEq Q] (ψ : CBasis Q → ℂ) (o : Q)
    (b : Bool) : ℝ :=
  ∑ u ∈ Finset.univ.filter (fun u : CBasis Q => u o = b), Complex.normSq (ψ u)

/-! ## Shared gate model (byte-identical in node_09 and node_12) -/

/-- A gate: a Clifford unitary, or a designated magic gate together with its support. -/
inductive Gate (Q : Type) where
  | clifford (C : Matrix (CBasis Q) (CBasis Q) ℂ)
  | magic (S : Finset Q) (M : Matrix (CBasis Q) (CBasis Q) ℂ)

/-- The matrix of a gate. -/
def Gate.mat {Q : Type} : Gate Q → Matrix (CBasis Q) (CBasis Q) ℂ
  | .clifford C => C
  | .magic _ M => M

/-- Whether a gate is a designated magic gate. -/
def Gate.isMagic {Q : Type} : Gate Q → Bool
  | .clifford _ => false
  | .magic _ _ => true

/-- Admissible gates: Clifford gates are Clifford; magic gates are arbitrary unitaries acting
nontrivially on at most `cM` qubits. -/
def Gate.Valid {Q : Type} [Fintype Q] [DecidableEq Q] (cM : ℕ) : Gate Q → Prop
  | .clifford C => IsClifford C
  | .magic S M => M ∈ Matrix.unitaryGroup (CBasis Q) ℂ ∧ SupportedOn S M ∧ S.card ≤ cM

/-! ## Unitary circuits with mixed advice, and mixed circuits -/

/-- A unitary Clifford+magic circuit with `k` advice qubits in the (mixed) state `advice`
(`ρ_E`), gate list `gates` (applied left to right) and output qubit `out`. -/
structure DensityCircuit (nA nB : ℕ) where
  k : ℕ
  advice : Matrix (CBasis (Fin k)) (CBasis (Fin k)) ℂ
  gates : List (Gate (Qubit nA nB k))
  out : Qubit nA nB k

/-- The initial density matrix `|x⟩⟨x|_A ⊗ |y⟩⟨y|_B ⊗ ρ_E`. -/
def initDensity {nA nB k : ℕ} (x : Fin nA → Bool) (y : Fin nB → Bool)
    (ρE : Matrix (CBasis (Fin k)) (CBasis (Fin k)) ℂ) :
    Matrix (CBasis (Qubit nA nB k)) (CBasis (Qubit nA nB k)) ℂ :=
  fun u v =>
    if (∀ i, u (Sum.inl i) = x i) ∧ (∀ j, u (Sum.inr (Sum.inl j)) = y j) ∧
        (∀ i, v (Sum.inl i) = x i) ∧ (∀ j, v (Sum.inr (Sum.inl j)) = y j) then
      ρE (fun l => u (Sum.inr (Sum.inr l))) (fun l => v (Sum.inr (Sum.inr l)))
    else 0

/-- Final density matrix `U ρ₀ Uᴴ` on input `(x, y)`. -/
def DensityCircuit.finalDensity {nA nB : ℕ} (U : DensityCircuit nA nB)
    (x : Fin nA → Bool) (y : Fin nB → Bool) :
    Matrix (CBasis (Qubit nA nB U.k)) (CBasis (Qubit nA nB U.k)) ℂ :=
  U.gates.foldl (fun ρ g => Gate.mat g * ρ * Matrix.conjTranspose (Gate.mat g))
    (initDensity x y U.advice)

/-- Probability that the output qubit is measured as `b` on input `(x, y)`. -/
def DensityCircuit.outProb {nA nB : ℕ} (U : DensityCircuit nA nB)
    (x : Fin nA → Bool) (y : Fin nB → Bool) (b : Bool) : ℝ :=
  ∑ u ∈ Finset.univ.filter (fun u : CBasis (Qubit nA nB U.k) => u U.out = b),
    (U.finalDensity x y u u).re

/-- `m(U)`: the number of designated magic gates. -/
def DensityCircuit.magicCount {nA nB : ℕ} (U : DensityCircuit nA nB) : ℕ :=
  U.gates.countP (fun g => g.isMagic)

/-- Admissibility: `ρ_E` is a density matrix and every gate is admissible. -/
def DensityCircuit.Valid {nA nB : ℕ} (cM : ℕ) (U : DensityCircuit nA nB) : Prop :=
  U.advice.PosSemidef ∧ U.advice.trace = 1 ∧ ∀ g ∈ U.gates, Gate.Valid cM g

/-- A mixed circuit: an input-independent index `i ∈ Fin r` sampled with probability
`weight i`, then branch `branch i` is run. -/
structure MixedCircuit (nA nB : ℕ) where
  r : ℕ
  weight : Fin r → ℝ
  branch : Fin r → DensityCircuit nA nB

/-- Admissibility: `(weight i)` is a probability distribution and every branch is admissible. -/
def MixedCircuit.Valid {nA nB : ℕ} (cM : ℕ) (C : MixedCircuit nA nB) : Prop :=
  (∀ i, 0 ≤ C.weight i) ∧ (∑ i, C.weight i) = 1 ∧ ∀ i, (C.branch i).Valid cM

/-- Magic cost `max_{i : p_i > 0} m(U_i)`. -/
def MixedCircuit.magicCost {nA nB : ℕ} (C : MixedCircuit nA nB) : ℕ :=
  open Classical in
  (Finset.univ.filter (fun i => 0 < C.weight i)).sup (fun i => (C.branch i).magicCount)

/-- "output equals `f(x,y)` with probability at least `1-ε` for every `(x,y) ∈ D`". -/
def MixedCircuit.ComputesWithError {nA nB : ℕ} (C : MixedCircuit nA nB)
    (D : Set ((Fin nA → Bool) × (Fin nB → Bool)))
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) (ε : ℝ) : Prop :=
  ∀ x y, (x, y) ∈ D → 1 - ε ≤ ∑ i, C.weight i * (C.branch i).outProb x y (f x y)

/-- `M^mixed_ε(f)`. -/
def magicMixed (cM : ℕ) {nA nB : ℕ} (D : Set ((Fin nA → Bool) × (Fin nB → Bool)))
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) (ε : ℝ) : ℕ :=
  sInf {m | ∃ C : MixedCircuit nA nB, C.Valid cM ∧ C.ComputesWithError D f ε ∧
    C.magicCost = m}

/-! ## Public-coin simultaneous-message protocols -/

/-- A public-coin SMP protocol: a shared seed `s ∈ Fin r` drawn with probability `weight s`;
Alice sends `alice s x`, Bob sends `bob s y`; the referee answers `true` with probability
`referee s mA mB` (its private randomness is free). -/
structure PubSMP (nA nB : ℕ) where
  r : ℕ
  weight : Fin r → ℝ
  alice : Fin r → (Fin nA → Bool) → List Bool
  bob : Fin r → (Fin nB → Bool) → List Bool
  referee : Fin r → List Bool → List Bool → ℝ

/-- Well-formedness: the seed distribution is a probability distribution and the referee's
answer probabilities lie in `[0,1]`. -/
def PubSMP.Valid {nA nB : ℕ} (P : PubSMP nA nB) : Prop :=
  (∀ s, 0 ≤ P.weight s) ∧ (∑ s, P.weight s) = 1 ∧
    ∀ s mA mB, 0 ≤ P.referee s mA mB ∧ P.referee s mA mB ≤ 1

/-- Probability that the referee outputs `b` on input `(x, y)`. -/
def PubSMP.outProb {nA nB : ℕ} (P : PubSMP nA nB) (x : Fin nA → Bool) (y : Fin nB → Bool)
    (b : Bool) : ℝ :=
  ∑ s, P.weight s *
    (if b then P.referee s (P.alice s x) (P.bob s y)
      else 1 - P.referee s (P.alice s x) (P.bob s y))

/-- Error at most `ε` on every input in `D`. -/
def PubSMP.ComputesWithError {nA nB : ℕ} (P : PubSMP nA nB)
    (D : Set ((Fin nA → Bool) × (Fin nB → Bool)))
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) (ε : ℝ) : Prop :=
  ∀ x y, (x, y) ∈ D → 1 - ε ≤ P.outProb x y (f x y)

/-- Cost at most `c`: total message length `≤ c` over all valid inputs and all seeds. -/
def PubSMP.CostLe {nA nB : ℕ} (P : PubSMP nA nB)
    (D : Set ((Fin nA → Bool) × (Fin nB → Bool))) (c : ℕ) : Prop :=
  ∀ s x y, (x, y) ∈ D → (P.alice s x).length + (P.bob s y).length ≤ c

/-- `R^∥pub_ε(f)`. -/
def pubSMPComplexity {nA nB : ℕ} (D : Set ((Fin nA → Bool) × (Fin nB → Bool)))
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) (ε : ℝ) : ℕ :=
  sInf {c | ∃ P : PubSMP nA nB, P.Valid ∧ P.ComputesWithError D f ε ∧ P.CostLe D c}

/-! ## Lemma stubs -/

/-- Clifford conjugation sends a Pauli `X^a Z^b` to a phase times a Pauli. [MagicAndCommunicationComplexity, node_12] -/
theorem clifford_conj_pauli {Q : Type} [Fintype Q] [DecidableEq Q]
    (C : Matrix (CBasis Q) (CBasis Q) ℂ) (hC : IsClifford C) (a b : Q → Bool) :
    ∃ (j : ℕ) (a' b' : Q → Bool),
      C * pauli a b * Matrix.conjTranspose C = Complex.I ^ j • pauli a' b' := by
  sorry

/-- The input frame: `ρ₀(x,y) = X^{(x,y,0)} ρ₀(0,0) X^{(x,y,0)}`. [MagicAndCommunicationComplexity, node_12] -/
theorem input_frame_density {nA nB k : ℕ} (x : Fin nA → Bool) (y : Fin nB → Bool)
    (ρE : Matrix (CBasis (Fin k)) (CBasis (Fin k)) ℂ) :
    initDensity x y ρE =
      pauli (Sum.elim x (Sum.elim y (fun _ => false))) (fun _ => false) *
        initDensity (fun _ => false) (fun _ => false) ρE *
        Matrix.conjTranspose
          (pauli (Sum.elim x (Sum.elim y (fun _ => false))) (fun _ => false)) := by
  sorry

/-- A Pauli supported outside the support `S` of a magic gate commutes with it. [MagicAndCommunicationComplexity, node_12] -/
theorem magic_commutes_pauli_off_support {Q : Type} [Fintype Q] [DecidableEq Q]
    (S : Finset Q) (M : Matrix (CBasis Q) (CBasis Q) ℂ) (hM : SupportedOn S M)
    (a b : Q → Bool) (ha : ∀ i ∈ S, a i = false) (hb : ∀ i ∈ S, b i = false) :
    M * pauli a b = pauli a b * M := by
  sorry

/-- Per-branch simulation: each admissible branch `U` has an exact public-coin SMP
simulation (same output distribution on every input) of cost `≤ 4 c_M m(U) + 2`. [MagicAndCommunicationComplexity, node_12] -/
theorem branch_simulation (cM : ℕ) (hcM : 1 ≤ cM) {nA nB : ℕ} (U : DensityCircuit nA nB)
    (hU : U.Valid cM) :
    ∃ P : PubSMP nA nB, P.Valid ∧ P.CostLe Set.univ (4 * cM * U.magicCount + 2) ∧
      ∀ x y b, P.outProb x y b = U.outProb x y b := by
  sorry

/-- Per-circuit bound: an admissible mixed circuit of magic cost `M` computing `f` on `D` with
error `ε` gives `R^∥pub_ε(f) ≤ 4 c_M M + 2`. [MagicAndCommunicationComplexity, node_12] -/
theorem pubSMP_le_of_mixed (cM : ℕ) (hcM : 1 ≤ cM) {nA nB : ℕ}
    (D : Set ((Fin nA → Bool) × (Fin nB → Bool)))
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) (ε : ℝ)
    (C : MixedCircuit nA nB) (hC : C.Valid cM) (hf : C.ComputesWithError D f ε) :
    pubSMPComplexity D f ε ≤ 4 * cM * C.magicCost + 2 := by
  sorry

/-! ## Main theorem -/

/-- `(R^∥pub_ε(f) - 2) / (4 c_M) ≤ M^mixed_ε(f)`. [MagicAndCommunicationComplexity, node_12] -/
theorem magic_mixed_lower_bound (cM : ℕ) (hcM : 1 ≤ cM) {nA nB : ℕ}
    (D : Set ((Fin nA → Bool) × (Fin nB → Bool)))
    (f : (Fin nA → Bool) → (Fin nB → Bool) → Bool) (ε : ℝ)
    (hex : ∃ C : MixedCircuit nA nB, C.Valid cM ∧ C.ComputesWithError D f ε) :
    ((pubSMPComplexity D f ε : ℝ) - 2) / (4 * (cM : ℝ)) ≤ (magicMixed cM D f ε : ℝ) := by
  sorry

