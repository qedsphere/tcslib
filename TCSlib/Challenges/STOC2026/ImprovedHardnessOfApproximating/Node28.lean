/-!
## Amplifying a constant gap to k / (ln k)^{λ ln ln ln k}

Let `G` be a graph with a partition into `k` independent parts. Fix an indexed family
`I₁, …, I_m` of `L`-subsets of `[k]` such that every `r` differently indexed members cover at
least `(1−δ)k` parts (`covering_family_exists`, with `r = ⌈Dk/L⌉`, `m = ⌊exp(k/r)⌋`, `δD > 3`).
The `m`-partite graph `H` has, in part `W_i`, all clique selections `u : I_i → V(G)` with
`u(j) ∈ V_j`; `u ∈ W_i`, `v ∈ W_j` (`i ≠ j`) are adjacent when they agree on `I_i ∩ I_j` and
their union is a clique of `G`.

Main theorem `gap_amplification`: for any `c₀ > 1`, `a > 0` and `λ = 2/a`, for all sufficiently
large `k` and every `L` with `k^{a/ln ln k} ≤ L ≤ 2k^{a/ln ln k}` there is such a family for
which `ω(G) = k ⇒ ω(H) = m` and `ω(G) ≤ k/c₀ ⇒ ω(H) ≤ (ln m)^{λ ln ln ln m} = m/γ_λ(m)`,
where `γ_λ(m) = m / (ln m)^{λ ln ln ln m} > 1`.
-/

namespace TCSChallenge.ImprovedHardnessOfApproximating.node28

/-- `r = ⌈Dk/L⌉`. -/
def rPar (D k L : ℕ) : ℕ := ⌈((D : ℝ) * k / L)⌉₊

/-- `m = ⌊exp(k/r)⌋`. -/
def mPar (D k L : ℕ) : ℕ := ⌊Real.exp ((k : ℝ) / rPar D k L)⌋₊

/-- "The union of every `r` differently indexed members has size at least `T`." -/
def Covers {k m : ℕ} (I : Fin m → Finset (Fin k)) (r : ℕ) (T : ℝ) : Prop :=
  ∀ J : Finset (Fin m), J.card = r → T ≤ ((J.biUnion I).card : ℝ)

/-- `γ_λ(m) = m / (ln m)^{λ ln ln ln m}`. -/
def gammaLam (lam : ℝ) (m : ℝ) : ℝ :=
  m / Real.log m ^ (lam * Real.log (Real.log (Real.log m)))

/-- Rubric 1: the covering family exists (union bound
`binom(m,r) binom(k,t) e^{−δLr} ≤ e^{(1+ln 2−δD)k} < 1`). [ImprovedHardnessOfApproximating, node_28] -/
theorem covering_family_exists (δ : ℝ) (hδ : 0 < δ) (hδ1 : δ < 1) (D : ℕ)
    (hD : 3 < δ * D) (k L : ℕ) (hk : 1 ≤ k) (hL : 1 ≤ L) (hLk : L ≤ k) :
    ∃ I : Fin (mPar D k L) → Finset (Fin k),
      (∀ i, (I i).card = L) ∧ Covers I (rPar D k L) ((1 - δ) * k) := by
  sorry

section Reduction

variable {V : Type} {k m : ℕ}

/-- A vertex of `W_i`: a function `u` on `I_i` with `u(j) ∈ V_j` whose selected vertices form a
clique of `G`. -/
abbrev RedVertex (G : SimpleGraph V) (part : V → Fin k) (I : Fin m → Finset (Fin k)) : Type :=
  Σ i : Fin m, {u : {j // j ∈ I i} → V //
    (∀ j, part (u j) = j.1) ∧ ∀ j j', j ≠ j' → G.Adj (u j) (u j')}

/-- `u ∈ W_i`, `v ∈ W_{i'}` with `i ≠ i'` are adjacent precisely when they agree on
`I_i ∩ I_{i'}` and the union of their selected vertices is a clique in `G`. -/
def RedEdge (G : SimpleGraph V) (part : V → Fin k) (I : Fin m → Finset (Fin k))
    (v w : RedVertex G part I) : Prop :=
  v.1 ≠ w.1 ∧
  (∀ (j : Fin k) (h₁ : j ∈ I v.1) (h₂ : j ∈ I w.1), v.2.1 ⟨j, h₁⟩ = w.2.1 ⟨j, h₂⟩) ∧
  ∀ (j : {j // j ∈ I v.1}) (j' : {j // j ∈ I w.1}), j.1 ≠ j'.1 → G.Adj (v.2.1 j) (w.2.1 j')

/-- The reduced `m`-partite graph `H`. -/
def redGraph (G : SimpleGraph V) (part : V → Fin k) (I : Fin m → Finset (Fin k)) :
    SimpleGraph (RedVertex G part I) :=
  SimpleGraph.fromRel (RedEdge G part I)

/-- `N = |V(H)| ≤ m n^L`. [ImprovedHardnessOfApproximating, node_28] -/
theorem redGraph_card_le [Fintype V] (G : SimpleGraph V) (part : V → Fin k)
    (I : Fin m → Finset (Fin k)) (L : ℕ) (hI : ∀ i, (I i).card = L) :
    Fintype.card (RedVertex G part I) ≤ m * Fintype.card V ^ L := by
  sorry

/-- Completeness: a `k`-clique of `G` restricts to an `m`-clique of `H`. [ImprovedHardnessOfApproximating, node_28] -/
theorem redGraph_complete (G : SimpleGraph V) (part : V → Fin k)
    (hpart : ∀ u v, G.Adj u v → part u ≠ part v) (I : Fin m → Finset (Fin k))
    (hG : ∃ s : Finset V, G.IsNClique k s) :
    ∃ S : Finset (RedVertex G part I), (redGraph G part I).IsNClique m S := by
  sorry

/-- The crucial invariant: a clique of local selections induces a consistent clique of `G`
whose size is the size of the union of the supports. [ImprovedHardnessOfApproximating, node_28] -/
theorem clique_union (G : SimpleGraph V) (part : V → Fin k)
    (hpart : ∀ u v, G.Adj u v → part u ≠ part v) (I : Fin m → Finset (Fin k))
    (S : Finset (RedVertex G part I))
    (hS : (redGraph G part I).IsClique (S : Set (RedVertex G part I))) :
    ∃ s : Finset V, G.IsClique (s : Set V) ∧
      s.card = ((S.image Sigma.fst).biUnion I).card := by
  sorry

/-- Soundness: if every `r` members cover `≥ T` parts and every clique of `G` is smaller than
`T`, then `H` has no `r`-clique. [ImprovedHardnessOfApproximating, node_28] -/
theorem redGraph_sound (G : SimpleGraph V) (part : V → Fin k)
    (hpart : ∀ u v, G.Adj u v → part u ≠ part v) (I : Fin m → Finset (Fin k))
    (r : ℕ) (T : ℝ) (hcov : Covers I r T)
    (hG : ∀ s : Finset V, G.IsClique (s : Set V) → (s.card : ℝ) < T)
    (S : Finset (RedVertex G part I))
    (hS : (redGraph G part I).IsClique (S : Set (RedVertex G part I))) :
    S.card < r := by
  sorry

end Reduction

/-- Rubric 3: the iterated-logarithmic threshold. For `a > 0`, `λ = 2/a`, and `L` in
`[k^{a/ln ln k}, 2k^{a/ln ln k}]`, eventually `L ≤ k`, `2 ≤ r ≤ m`,
`r ≤ (ln m)^{λ ln ln ln m}`, and this threshold is `< m` (so `γ_λ(m) > 1`). [ImprovedHardnessOfApproximating, node_28] -/
theorem threshold_bound (a : ℝ) (ha : 0 < a) (D : ℕ) (hD : 1 ≤ D) :
    ∃ K₀ : ℕ, ∀ k : ℕ, K₀ ≤ k → ∀ L : ℕ,
      (k : ℝ) ^ (a / Real.log (Real.log k)) ≤ L →
      (L : ℝ) ≤ 2 * (k : ℝ) ^ (a / Real.log (Real.log k)) →
      1 ≤ L ∧ L ≤ k ∧ 2 ≤ rPar D k L ∧ rPar D k L ≤ mPar D k L ∧
      (rPar D k L : ℝ) ≤
        Real.log (mPar D k L) ^ ((2 / a) * Real.log (Real.log (Real.log (mPar D k L)))) ∧
      Real.log (mPar D k L) ^ ((2 / a) * Real.log (Real.log (Real.log (mPar D k L)))) <
        (mPar D k L : ℝ) := by
  sorry

/-- Rubric 5: constant multiples of the new exponent are eventually below the ETH exponent. [ImprovedHardnessOfApproximating, node_28] -/
theorem exponent_absorb (a a₀ B : ℝ) (ha : 0 < a) (haa : a < a₀) :
    ∃ K₀ : ℕ, ∀ k : ℕ, K₀ ≤ k →
      2 * B * (k : ℝ) ^ (a / Real.log (Real.log k)) <
        (k : ℝ) ^ (a₀ / Real.log (Real.log k)) := by
  sorry

/-- **Gap amplification** (combinatorial core of the main theorem, with `λ = 2/a`). [ImprovedHardnessOfApproximating, node_28] -/
theorem gap_amplification (c₀ a : ℝ) (hc₀ : 1 < c₀) (ha : 0 < a) :
    ∃ D K₀ : ℕ, ∀ k : ℕ, K₀ ≤ k → ∀ L : ℕ,
      (k : ℝ) ^ (a / Real.log (Real.log k)) ≤ L →
      (L : ℝ) ≤ 2 * (k : ℝ) ^ (a / Real.log (Real.log k)) →
      1 < gammaLam (2 / a) (mPar D k L) ∧
      ∃ I : Fin (mPar D k L) → Finset (Fin k), (∀ i, (I i).card = L) ∧
        ∀ (W : Type) [Fintype W] (G : SimpleGraph W) (part : W → Fin k),
          (∀ u v, G.Adj u v → part u ≠ part v) →
          ((∃ s : Finset W, G.IsNClique k s) →
              ∃ S : Finset (RedVertex G part I), (redGraph G part I).IsNClique (mPar D k L) S) ∧
          ((∀ s : Finset W, G.IsClique (s : Set W) → (s.card : ℝ) ≤ k / c₀) →
              ∀ S : Finset (RedVertex G part I),
                (redGraph G part I).IsClique (S : Set (RedVertex G part I)) →
                (S.card : ℝ) ≤ (mPar D k L : ℝ) / gammaLam (2 / a) (mPar D k L)) := by
  sorry

end TCSChallenge.ImprovedHardnessOfApproximating.node28
