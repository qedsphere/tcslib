/-!
## Gap k-CLIQUE from locally testable and smoothly decodable codes

An exact a-partite clique instance `H` is encoded by vector labels `h(v) ∈ 𝔽_p^t` into unary
constraints `x_i ∈ S_i` and pairwise-sum constraints `x_i + x_j ∈ S_{ij}` (`encoding_correct`,
using labels with the collision property from `labels_exist`). Given a code `C_t` with an
11-query tester and 2-query smooth decoders, the *gap graph* has one independent part per
tester seed `r`, whose vertices are the accepting local views on the query set `Q_r`; two
views in different parts are adjacent when they agree on overlaps and every decoder whose two
queries are covered by them returns a value satisfying its constraint.

Main theorem `gap_reduction` (δ = 1/25, ρ = 1 − 2δ/13 = 323/325): satisfiable constraints give
a clique with one vertex per part (size R), and any clique of size ≥ ρR yields a satisfying
assignment. `gapGraph_card_le` bounds the vertex count by `R · |A|^{11}`. The parameter lemmas
record the numerical choices α = 2^{100}, m = αd, a_d = binom((α+1)d, d), r = (d−1)/2.
-/

namespace TCSChallenge.ImprovedHardnessOfApproximating.node24

/-! ## Constraints and decoder targets -/

/-- A decoder target: "a decoder recovers `x_i`" (`unary i`) or "another decoder recovers
`x_i + x_j`" (`pair i j`, used for `i < j`). -/
inductive DecTarget (a : ℕ) where
  | unary (i : Fin a)
  | pair (i j : Fin a)

/-- Targets actually supplied: every `i ∈ [a]`, and pairs `1 ≤ i < j ≤ a`. -/
def DecTarget.Valid {a : ℕ} : DecTarget a → Prop
  | .unary _ => True
  | .pair i j => i < j

/-- The value a target decodes from the message `x`: `x_i` or `x_i + x_j`. -/
def DecTarget.eval {a : ℕ} {M : Type} [Add M] (x : Fin a → M) : DecTarget a → M
  | .unary i => x i
  | .pair i j => x i + x j

/-- `x` satisfies the vector constraints `x_i ∈ S_i`, `x_i + x_j ∈ S_{ij}` (here `cons T` is
the constraint set attached to target `T`). -/
def Satisfies {a : ℕ} {M : Type} [Add M] (cons : DecTarget a → Set M) (x : Fin a → M) : Prop :=
  ∀ T : DecTarget a, T.Valid → T.eval x ∈ cons T

/-! ## Encoding an exact multipartite clique instance -/

/-- Labels with the collision property: (i) different vertices of the same part get different
labels; (ii) for different parts `V_i, V_j`, `(u,v) ↦ h(u)+h(v)` is injective on `V_i × V_j`. -/
def LabelsGood {V : Type} {a t p : ℕ} (part : V → Fin a) (h : V → Fin t → ZMod p) : Prop :=
  (∀ u v : V, part u = part v → u ≠ v → h u ≠ h v) ∧
  (∀ u v u' v' : V, part u = part u' → part v = part v' → part u ≠ part v →
      h u + h v = h u' + h v' → u = u' ∧ v = v')

/-- `S_i = {h(v) : v ∈ V_i}` and `S_{ij} = {h(u)+h(v) : u ∈ V_i, v ∈ V_j, uv ∈ E(H)}`. -/
def encCons {V : Type} {a t p : ℕ} (H : SimpleGraph V) (part : V → Fin a)
    (h : V → Fin t → ZMod p) : DecTarget a → Set (Fin t → ZMod p)
  | .unary i => {y | ∃ v, part v = i ∧ h v = y}
  | .pair i j => {y | ∃ u v, part u = i ∧ part v = j ∧ H.Adj u v ∧ h u + h v = y}

/-- Existence of collision-free labels once `p^t ≥ (n₀+1)^5` (the paper's
`t = ⌈5 log_p(n₀+1)⌉`): the expected number of bad events is `< (n₀²+n₀⁴)/(n₀+1)^5 < 1`. [ImprovedHardnessOfApproximating, node_24] -/
theorem labels_exist {V : Type} [Fintype V] {a : ℕ} (part : V → Fin a) (p t : ℕ)
    (hp : p.Prime) (ht : (Fintype.card V + 1) ^ 5 ≤ p ^ t) :
    ∃ h : V → Fin t → ZMod p, LabelsGood part h := by
  sorry

/-- The vector constraints are satisfiable exactly when `H` has a clique meeting every part. [ImprovedHardnessOfApproximating, node_24] -/
theorem encoding_correct {V : Type} {a t p : ℕ} (H : SimpleGraph V) (part : V → Fin a)
    (hpart : ∀ u v, H.Adj u v → part u ≠ part v)
    (h : V → Fin t → ZMod p) (hh : LabelsGood part h) :
    (∃ x, Satisfies (encCons H part h) x) ↔
      ∃ f : Fin a → V, (∀ i, part (f i) = i) ∧ ∀ i j, i ≠ j → H.Adj (f i) (f j) := by
  sorry

/-! ## Codes with a tester and smooth decoders -/

/-- Data of one code `C_t : M^a → A^L` (with `M = 𝔽_p^t`, `A = (𝔽_p^s)^t` in the paper) together
with its tester (seed space `[R]`, query sets `Q r`, acceptance predicate on the local view)
and its decoders (seed space `[R_d]`, two query positions, output from the two symbols).
Query positions depend only on the seed. -/
structure CodeData (a L R Rd : ℕ) (M A : Type) where
  enc : (Fin a → M) → Fin L → A
  Q : Fin R → Finset (Fin L)
  acc : (r : Fin R) → ({z // z ∈ Q r} → A) → Prop
  q₁ : DecTarget a → Fin Rd → Fin L
  q₂ : DecTarget a → Fin Rd → Fin L
  out : DecTarget a → Fin Rd → A → A → M

variable {a L R Rd : ℕ} {M A : Type}

/-- "The fraction of their L positions at which their entire symbols differ." -/
def relDist (w w' : Fin L → A) : ℝ :=
  ((Finset.univ.filter fun z : Fin L => w z ≠ w' z).card : ℝ) / L

/-- Acceptance probability of the tester on `w` under a uniform seed. -/
def accProb (C : CodeData a L R Rd M A) (w : Fin L → A) : ℝ :=
  ((Finset.univ.filter fun r : Fin R => C.acc r (fun z => w z.1)).card : ℝ) / R

/-- The hypotheses on the coding family, for one code `C_t`. -/
structure IsGoodCode [Add M] (C : CodeData a L R Rd M A) : Prop where
  L_pos : 0 < L
  R_pos : 0 < R
  /-- the tester queries at most 11 positions -/
  query_card : ∀ r, (C.Q r).card ≤ 11
  /-- it accepts `C_t(x)` for every `x` and every seed -/
  tester_complete : ∀ (x : Fin a → M) (r : Fin R), C.acc r (fun z => C.enc x z.1)
  /-- for δ ∈ (0.035, 0.06), acceptance probability ≥ 1 − 2δ/13 implies distance ≤ δ from
  the image of `C_t` -/
  tester_sound : ∀ δ : ℝ, 35 / 1000 < δ → δ < 6 / 100 → ∀ w : Fin L → A,
    1 - 2 * δ / 13 ≤ accProb C w → ∃ x, relDist w (C.enc x) ≤ δ
  /-- decoders are correct on every codeword for every seed -/
  decoder_complete : ∀ T : DecTarget a, T.Valid → ∀ (x : Fin a → M) (σ : Fin Rd),
    C.out T σ (C.enc x (C.q₁ T σ)) (C.enc x (C.q₂ T σ)) = T.eval x
  /-- each of the two query positions is marginally uniform on `[L]` -/
  smooth₁ : ∀ T : DecTarget a, T.Valid → ∀ z : Fin L,
    (Finset.univ.filter fun σ : Fin Rd => C.q₁ T σ = z).card * L = Rd
  smooth₂ : ∀ T : DecTarget a, T.Valid → ∀ z : Fin L,
    (Finset.univ.filter fun σ : Fin Rd => C.q₂ T σ = z).card * L = Rd

/-- Codeword separation forced by decoding: distinct codewords are at distance > 5δ = 1/5. [ImprovedHardnessOfApproximating, node_24] -/
theorem codeword_separation [AddCommGroup M] (C : CodeData a L R Rd M A) (hC : IsGoodCode C)
    (x y : Fin a → M) (hxy : x ≠ y) :
    1 / 5 < relDist (C.enc x) (C.enc y) := by
  sorry

/-- Coverage (1): every set of ≥ ρR tester seeds (ρ = 323/325) queries at least
`(1 − 2δ)L = (23/25)L` positions, provided `L > 1/δ = 25`. [ImprovedHardnessOfApproximating, node_24] -/
theorem coverage [AddCommGroup M] [Nonempty A] (C : CodeData a L R Rd M A) (hC : IsGoodCode C)
    (hL : 25 < L) (I : Finset (Fin R)) (hI : (323 / 325 : ℝ) * R ≤ I.card) :
    (23 / 25 : ℝ) * L ≤ ((I.biUnion C.Q).card : ℝ) := by
  sorry

/-! ## The gap graph -/

/-- A vertex of the part of tester seed `r`: an assignment `π_v : Q_r → A` making the tester
accept. -/
abbrev GapVertex (C : CodeData a L R Rd M A) : Type :=
  Σ r : Fin R, {π : {z // z ∈ C.Q r} → A // C.acc r π}

/-- The union assignment of two vertices (first `v`, then `w`), undefined outside
`dom π_v ∪ dom π_w`. -/
def unionVal (C : CodeData a L R Rd M A) (v w : GapVertex C) (z : Fin L) : Option A :=
  if h : z ∈ C.Q v.1 then some (v.2.1 ⟨z, h⟩)
  else if h' : z ∈ C.Q w.1 then some (w.2.1 ⟨z, h'⟩) else none

/-- Edge condition: different parts; the partial assignments agree on their common domain;
and for every decoder and seed whose two queries lie in `dom π_v ∪ dom π_w`, the decoder run on
the union assignment returns a value in the corresponding `S_i` or `S_{ij}`. -/
def GapEdge [Add M] (C : CodeData a L R Rd M A) (cons : DecTarget a → Set M)
    (v w : GapVertex C) : Prop :=
  v.1 ≠ w.1 ∧
  (∀ (z : Fin L) (h₁ : z ∈ C.Q v.1) (h₂ : z ∈ C.Q w.1), v.2.1 ⟨z, h₁⟩ = w.2.1 ⟨z, h₂⟩) ∧
  ∀ T : DecTarget a, T.Valid → ∀ (σ : Fin Rd) (b₁ b₂ : A),
    unionVal C v w (C.q₁ T σ) = some b₁ → unionVal C v w (C.q₂ T σ) = some b₂ →
    C.out T σ b₁ b₂ ∈ cons T

/-- The gap graph (symmetrised edge relation; parts indexed by tester seeds are independent). -/
def gapGraph [Add M] (C : CodeData a L R Rd M A) (cons : DecTarget a → Set M) :
    SimpleGraph (GapVertex C) :=
  SimpleGraph.fromRel (GapEdge C cons)

/-- Vertex count (2): `N ≤ R · |A|^{11}` (with `|A| = p^{st}` this is `K p^{11st}`). [ImprovedHardnessOfApproximating, node_24] -/
theorem gapGraph_card_le [AddCommGroup M] [Fintype A] [Nonempty A]
    (C : CodeData a L R Rd M A) (hC : IsGoodCode C) :
    Fintype.card (GapVertex C) ≤ R * Fintype.card A ^ 11 := by
  sorry

/-- The tester parts are independent sets. [ImprovedHardnessOfApproximating, node_24] -/
theorem gapGraph_parts_independent [Add M] (C : CodeData a L R Rd M A)
    (cons : DecTarget a → Set M) (v w : GapVertex C) (h : (gapGraph C cons).Adj v w) :
    v.1 ≠ w.1 := by
  sorry

/-- **Gap reduction** (δ = 1/25, ρ = 323/325). Completeness: a satisfying assignment gives a
clique with one vertex in each of the `R` parts. Soundness: any clique of size ≥ ρR yields a
satisfying assignment. (`L > 25` and `ρR ≥ 2` hold for the paper's parameters.) [ImprovedHardnessOfApproximating, node_24] -/
theorem gap_reduction [AddCommGroup M] [Nonempty A] (C : CodeData a L R Rd M A)
    (hC : IsGoodCode C) (hL : 25 < L) (hR : 2 ≤ (323 / 325 : ℝ) * R)
    (cons : DecTarget a → Set M) :
    ((∃ x, Satisfies cons x) → ∃ s : Finset (GapVertex C), (gapGraph C cons).IsNClique R s) ∧
    (∀ s : Finset (GapVertex C), (gapGraph C cons).IsClique (s : Set (GapVertex C)) →
      (323 / 325 : ℝ) * R ≤ s.card → ∃ x, Satisfies cons x) := by
  sorry

/-! ## Parameters -/

/-- α = 2^{100}. -/
def alpha : ℕ := 2 ^ 100

/-- `m = αd`. -/
def mPar (d : ℕ) : ℕ := alpha * d

/-- Message length `a_d = binom((α+1)d, d)`. -/
def aSeq (d : ℕ) : ℕ := Nat.choose ((alpha + 1) * d) d

/-- `r = (d−1)/2` (exact for odd `d`). -/
def rPar (d : ℕ) : ℕ := (d - 1) / 2

/-- Alphabet exponent `s = (d+1) binom(2m+r, r)`. -/
def sPar (d : ℕ) : ℕ := (d + 1) * Nat.choose (2 * mPar d + rPar d) (rPar d)

/-- Output parameter `K = R_T = p^{34m+8}`. -/
def KPar (p d : ℕ) : ℕ := p ^ (34 * mPar d + 8)

/-- Admissibility: for large odd `d` and prime `p > 3d`, `p > 9216` and `p^m ≥ a_d`. [ImprovedHardnessOfApproximating, node_24] -/
theorem params_admissible :
    ∃ D₀ : ℕ, ∀ d : ℕ, D₀ ≤ d → Odd d → ∀ p : ℕ, p.Prime → 3 * d < p →
      9216 < p ∧ aSeq d ≤ p ^ mPar d := by
  sorry

/-- Alphabet optimisation (3): `s ≤ a^{0.54}` for all sufficiently large odd `d`. [ImprovedHardnessOfApproximating, node_24] -/
theorem alphabet_sublinear :
    ∃ D₀ : ℕ, ∀ d : ℕ, D₀ ≤ d → Odd d →
      (sPar d : ℝ) ≤ (aSeq d : ℝ) ^ (54 / 100 : ℝ) := by
  sorry

/-- (4): `log K / log log K ≤ C log a` for large odd `d` and the prime `3d < p ≤ 6d`. [ImprovedHardnessOfApproximating, node_24] -/
theorem logK_le_loga :
    ∃ Cc : ℝ, 0 < Cc ∧ ∃ D₀ : ℕ, ∀ d : ℕ, D₀ ≤ d → Odd d → ∀ p : ℕ, p.Prime → 3 * d < p →
      p ≤ 6 * d →
      Real.log (KPar p d) / Real.log (Real.log (KPar p d)) ≤ Cc * Real.log (aSeq d) := by
  sorry

/-- Parameter inversion (5): a fixed `λ > 0` with `K^{λ / log log K} ≤ a^{1/4}`. [ImprovedHardnessOfApproximating, node_24] -/
theorem parameter_inversion :
    ∃ lam : ℝ, 0 < lam ∧ ∃ D₀ : ℕ, ∀ d : ℕ, D₀ ≤ d → Odd d → ∀ p : ℕ, p.Prime → 3 * d < p →
      p ≤ 6 * d →
      (KPar p d : ℝ) ^ (lam / Real.log (Real.log (KPar p d))) ≤ (aSeq d : ℝ) ^ (1 / 4 : ℝ) := by
  sorry

/-- Padding: consecutive odd terms grow by at most
`C_α = 3^{2(α+1)} (α+1)^{2(α+1)} / α^{2α}` (cleared of denominators), and strictly increase. [ImprovedHardnessOfApproximating, node_24] -/
theorem padding_ratio (d : ℕ) (hd : 1 ≤ d) :
    aSeq d < aSeq (d + 2) ∧
    aSeq (d + 2) * alpha ^ (2 * alpha) ≤
      3 ^ (2 * (alpha + 1)) * (alpha + 1) ^ (2 * (alpha + 1)) * aSeq d := by
  sorry

end TCSChallenge.ImprovedHardnessOfApproximating.node24
