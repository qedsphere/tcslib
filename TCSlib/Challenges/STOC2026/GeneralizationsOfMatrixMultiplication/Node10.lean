/-!
## Light-bulb exponent from generalized matrix multiplication: combinatorial core

A real trilinear form `T = ∑ t^{ij}_{uv;kℓ} X_{u,k} Y_{v,ℓ} Z_{i,j}` is modelled as a function
`T : ι × κ → ι × κ → ι × ι → ℝ` with `T (u,k) (v,ℓ) (i,j) = t^{ij}_{uv;kℓ}` (the paper has
`ι = [q]`, `κ = [q_k]`). Its efficacy at `(i,j)` is `(∑_k t^{ij}_{ij;kk}) / B_{ij}`, and the
non-skewness of a relation `S ⊆ ι × ι` is `V_x(S), V_y(S) ≤ |S|^{3/2}`.

The paper's theorem `ω_ℓ ≤ log R / log (f √|S|)` is a running-time statement and is not
formalized. The main theorem `lightBulb_combinatorial_core` bundles the purely mathematical
facts the proof needs: the rank lower bound `|A| f² ≤ R`, and, for every tensor level `c`,
rank `≤ R^c`, efficacy `≥ f^c` on `S^{⊗c}`, and a constant-probability (≥ 1/4) collision of
random `t`-subset placements with `S^{⊗c}` when `t √(|S|^c) ≥ |ι|^c`.
-/

namespace TCSChallenge.GeneralizationsOfMatrixMultiplication.node_10

/-- A real trilinear form in the variable families `X_{u,k}`, `Y_{v,ℓ}`, `Z_{i,j}`:
`T (u,k) (v,ℓ) (i,j) = t^{ij}_{uv;kℓ}`. -/
abbrev Tensor (ι κ : Type*) : Type _ := ι × κ → ι × κ → ι × ι → ℝ

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- "the least number of products of three linear forms, one in each variable family, whose
sum is `T`": `HasRankLE T R` says `T` is a sum of `R` such products. -/
def HasRankLE (T : Tensor ι κ) (R : ℕ) : Prop :=
  ∃ α β : Fin R → ι × κ → ℝ, ∃ γ : Fin R → ι × ι → ℝ,
    ∀ x y z, T x y z = ∑ l, α l x * β l y * γ l z

/-- `B_{ij} = (∑_{u,v,k,ℓ} (t^{ij}_{uv;kℓ})²)^{1/2}`. -/
def coeffNorm (T : Tensor ι κ) (i j : ι) : ℝ :=
  Real.sqrt (∑ x : ι × κ, ∑ y : ι × κ, T x y (i, j) ^ 2)

/-- The signal numerator `∑_k t^{ij}_{ij;kk}`. -/
def signal (T : Tensor ι κ) (i j : ι) : ℝ :=
  ∑ k : κ, T (i, k) (j, k) (i, j)

/-- `eff_{ij}(T) = (∑_k t^{ij}_{ij;kk}) / B_{ij}` if `B_{ij} > 0`, and `0` if `B_{ij} = 0`. -/
def eff (T : Tensor ι κ) (i j : ι) : ℝ :=
  if coeffNorm T i j = 0 then 0 else signal T i j / coeffNorm T i j

/-- Row degree `|{j : (i,j) ∈ S}|`. -/
def rowDeg (S : Finset (ι × ι)) (i : ι) : ℕ := (S.filter (fun p => p.1 = i)).card

/-- Column degree `|{i : (i,j) ∈ S}|`. -/
def colDeg (S : Finset (ι × ι)) (j : ι) : ℕ := (S.filter (fun p => p.2 = j)).card

/-- `V_x(S) = ∑_i |{j : (i,j) ∈ S}|²`. -/
def Vx (S : Finset (ι × ι)) : ℕ := ∑ i : ι, rowDeg S i ^ 2

/-- `V_y(S) = ∑_j |{i : (i,j) ∈ S}|²`. -/
def Vy (S : Finset (ι × ι)) : ℕ := ∑ j : ι, colDeg S j ^ 2

/-- The tensor power `T^{⊗c}`: row labels in `ι^c`, inner labels in `κ^c`, coefficients
multiply coordinatewise. -/
def tensorPow (T : Tensor ι κ) (c : ℕ) : Tensor (Fin c → ι) (Fin c → κ) :=
  fun x y z => ∏ l : Fin c, T (x.1 l, x.2 l) (y.1 l, y.2 l) (z.1 l, z.2 l)

/-- "`S^{⊗c}` … requiring membership in `S` in every coordinate". -/
def relPow (S : Finset (ι × ι)) (c : ℕ) : Finset ((Fin c → ι) × (Fin c → ι)) :=
  Finset.univ.filter (fun p => ∀ l : Fin c, (p.1 l, p.2 l) ∈ S)

/-- Number of pairs `(L_x, L_y)` of `t`-element subsets of the row labels such that
`(L_x × L_y) ∩ S' ≠ ∅` ("a good planted row pair exists"). Dividing by `(choose m t)²`
gives the probability for independent uniform `t`-subsets. -/
def hitCount {α : Type*} [Fintype α] [DecidableEq α] (S' : Finset (α × α)) (t : ℕ) : ℕ :=
  ((Finset.powersetCard t (Finset.univ : Finset α) ×ˢ
      Finset.powersetCard t (Finset.univ : Finset α)).filter
    (fun L => ∃ p ∈ S', p.1 ∈ L.1 ∧ p.2 ∈ L.2)).card

/-- A sign `±1` from a bit. -/
def sgn (b : Bool) : ℝ := if b then 1 else -1

/-! ## Rubric item 1: tensor setup -/

/-- Inequality (1), X side: if `T` has rank at most `R` and efficacy at least `f` on `S`,
then (number of active X-rows) `· f² ≤ R`. [GeneralizationsOfMatrixMultiplication, node_10] -/
theorem active_rows_mul_sq_le_rank (T : Tensor ι κ) (S : Finset (ι × ι)) (f : ℝ) (R : ℕ)
    (hf : 0 ≤ f) (heff : ∀ p ∈ S, f ≤ eff T p.1 p.2) (hR : HasRankLE T R) :
    ((S.image Prod.fst).card : ℝ) * f ^ 2 ≤ R := by sorry

/-- Inequality (1), Y side. [GeneralizationsOfMatrixMultiplication, node_10] -/
theorem active_cols_mul_sq_le_rank (T : Tensor ι κ) (S : Finset (ι × ι)) (f : ℝ) (R : ℕ)
    (hf : 0 ≤ f) (heff : ∀ p ∈ S, f ≤ eff T p.1 p.2) (hR : HasRankLE T R) :
    ((S.image Prod.snd).card : ℝ) * f ^ 2 ≤ R := by sorry

/-- Rank is submultiplicative under tensor powers. [GeneralizationsOfMatrixMultiplication, node_10] -/
theorem hasRankLE_tensorPow (T : Tensor ι κ) (R c : ℕ) (hR : HasRankLE T R) :
    HasRankLE (tensorPow T c) (R ^ c) := by sorry

/-- Efficacy is multiplicative under tensor powers ("both the signal numerator and the
squared coefficient norm factor under tensor products"). [GeneralizationsOfMatrixMultiplication, node_10] -/
theorem eff_tensorPow (T : Tensor ι κ) (c : ℕ) (i j : Fin c → ι) :
    eff (tensorPow T c) i j = ∏ l : Fin c, eff T (i l) (j l) := by sorry

/-- Degree second moments are multiplicative: (3). [GeneralizationsOfMatrixMultiplication, node_10] -/
theorem Vx_relPow (S : Finset (ι × ι)) (c : ℕ) : Vx (relPow S c) = Vx S ^ c := by sorry

theorem Vy_relPow (S : Finset (ι × ι)) (c : ℕ) : Vy (relPow S c) = Vy S ^ c := by sorry

theorem card_relPow (S : Finset (ι × ι)) (c : ℕ) : (relPow S c).card = S.card ^ c := by sorry

/-! ## Rubric item 3: constant-probability collision -/

/-- Second-moment estimate (4): for independent uniform `t`-subsets `L_x, L_y` of the `m`
row labels with `α √h ≥ 1` (`α = t/m`, `h = |S'|`) and `V_x(S'), V_y(S') ≤ h^{3/2}`,
`Pr[(L_x × L_y) ∩ S' ≠ ∅] ≥ 1/4`. [GeneralizationsOfMatrixMultiplication, node_10] -/
theorem collision_prob_ge_quarter {α : Type*} [Fintype α] [DecidableEq α]
    (S' : Finset (α × α)) (t : ℕ) (hS : S'.Nonempty) (ht : t ≤ Fintype.card α)
    (hcover : (Fintype.card α : ℝ) ≤ t * Real.sqrt (S'.card : ℝ))
    (hVx : (Vx S' : ℝ) ≤ (S'.card : ℝ) ^ ((3 : ℝ) / 2))
    (hVy : (Vy S' : ℝ) ≤ (S'.card : ℝ) ^ ((3 : ℝ) / 2)) :
    ((Fintype.card α).choose t : ℝ) ^ 2 ≤ 4 * (hitCount S' t : ℝ) := by sorry

/-! ## Rubric item 4: two-stage random-sign anti-concentration -/

/-- Fact (10): for any real matrix `P` and independent uniform sign vectors `ε, δ`,
`Pr(|∑_{u,v} ε_u δ_v P_{uv}| ≥ |P_{ij}|) ≥ 1/4`. [GeneralizationsOfMatrixMultiplication, node_10] -/
theorem sign_anticoncentration (P : ι → κ → ℝ) (i : ι) (j : κ) :
    ((2 : ℝ) ^ Fintype.card ι * 2 ^ Fintype.card κ) ≤
      4 * ((Finset.univ.filter (fun ed : (ι → Bool) × (κ → Bool) =>
        |P i j| ≤ |∑ u : ι, ∑ v : κ, sgn (ed.1 u) * sgn (ed.2 v) * P u v|)).card : ℝ) := by
  sorry

/-! ## Main theorem: combinatorial core of the light-bulb exponent bound -/

/-- Under the paper's hypotheses (`f ≥ 1`, `S ≠ ∅`, efficacy `≥ f` on `S`,
`V_x(S), V_y(S) ≤ |S|^{3/2}`, rank `≤ R`):
(a) inequality (1) on both sides; and for every tensor level `c`,
(b) `T^{⊗c}` has rank `≤ R^c`,
(c) efficacy `≥ f^c` on every coordinate of `S^{⊗c}`,
(d) random `t`-subset placements with `t √(|S|^c) ≥ |ι|^c` hit `S^{⊗c}` with probability
`≥ 1/4`. [GeneralizationsOfMatrixMultiplication, node_10] -/
theorem lightBulb_combinatorial_core (T : Tensor ι κ) (S : Finset (ι × ι)) (f : ℝ) (R : ℕ)
    (hf : 1 ≤ f) (hS : S.Nonempty) (heff : ∀ p ∈ S, f ≤ eff T p.1 p.2)
    (hVx : (Vx S : ℝ) ≤ (S.card : ℝ) ^ ((3 : ℝ) / 2))
    (hVy : (Vy S : ℝ) ≤ (S.card : ℝ) ^ ((3 : ℝ) / 2))
    (hR : HasRankLE T R) :
    (((S.image Prod.fst).card : ℝ) * f ^ 2 ≤ R ∧ ((S.image Prod.snd).card : ℝ) * f ^ 2 ≤ R) ∧
    ∀ c : ℕ,
      HasRankLE (tensorPow T c) (R ^ c) ∧
      (∀ p ∈ relPow S c, f ^ c ≤ eff (tensorPow T c) p.1 p.2) ∧
      ∀ t : ℕ, t ≤ Fintype.card (Fin c → ι) →
        (Fintype.card (Fin c → ι) : ℝ) ≤ t * Real.sqrt ((S.card : ℝ) ^ c) →
        ((Fintype.card (Fin c → ι)).choose t : ℝ) ^ 2 ≤ 4 * (hitCount (relPow S c) t : ℝ) := by
  sorry

end TCSChallenge.GeneralizationsOfMatrixMultiplication.node_10
