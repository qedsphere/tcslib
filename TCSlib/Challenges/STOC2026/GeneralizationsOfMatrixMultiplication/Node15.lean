/-!
## A rank-5 tensor with efficacy above `5^{1/1.797}`

For `q = 2`, a real trilinear form `T = ∑ t^{ab}_{ik,k'j} X_{ik} Y_{k'j} Z_{ab}` is a function
`T : Idx → Idx → Idx → ℝ` (`Idx = Fin 2 × Fin 2`) with `T (i,k) (k',j) (a,b) = t^{ab}_{ik,k'j}`.
We define the explicit tensor `T_ε = ¼ ∑_{s,t ∈ {±1}} A_{s,t} B_{s,t} C_{s,t} − ε⁻⁵ X₀₁Y₀₀Z₁₁`
of the reference solution and state `rank(T_{1/40}) ≤ 5`, `eff(T_{1/40}) > 5^{1/1.797}`
(`main_T2112`), its existential form (`exists_tensor_rank_le_five_eff_gt`), and
`ω_ℓ < 1.797` from the transfer principle (`omega_lt`).
-/

namespace TCSChallenge.GeneralizationsOfMatrixMultiplication.node_15

/-- Index pairs in `{0,1}²`. -/
abbrev Idx : Type := Fin 2 × Fin 2

/-- A real trilinear form: `T (i,k) (k',j) (a,b) = t^{ab}_{ik,k'j}`. -/
abbrev Tensor2 : Type := Idx → Idx → Idx → ℝ

/-- `T` is a sum of `r` products `A(X) B(Y) C(Z)` of real linear forms. -/
def HasRankLE (T : Tensor2) (r : ℕ) : Prop :=
  ∃ α β γ : Fin r → Idx → ℝ, ∀ x y z, T x y z = ∑ l, α l x * β l y * γ l z

/-- `rank(T)`: the least number of products of real linear forms whose sum is `T`. -/
def tensorRank (T : Tensor2) : ℕ := sInf {r : ℕ | HasRankLE T r}

/-- The matrix-product signal of slice `ab`: `∑_k t^{ab}_{ak,kb}`. -/
def signal (T : Tensor2) (a b : Fin 2) : ℝ := ∑ k : Fin 2, T (a, k) (k, b) (a, b)

/-- The squared noise norm of slice `ab`: `∑_{i,j,k,k'} (t^{ab}_{ik,k'j})²`. -/
def noise (T : Tensor2) (a b : Fin 2) : ℝ := ∑ x : Idx, ∑ y : Idx, T x y (a, b) ^ 2

/-- `eff(T)² = ∑_{a,b} (∑_k t^{ab}_{ak,kb})² / ∑ (t^{ab}_{ik,k'j})²`, a summand with zero
denominator being zero. -/
def effSq (T : Tensor2) : ℝ :=
  ∑ a : Fin 2, ∑ b : Fin 2, if noise T a b = 0 then 0 else signal T a b ^ 2 / noise T a b

/-- `eff(T) ≥ 0`, the square root of `effSq`. -/
def eff (T : Tensor2) : ℝ := Real.sqrt (effSq T)

/-- The sign `s ∈ {−1, 1}` indexed by `Fin 2` (`0 ↦ 1`, `1 ↦ −1`). -/
def signPM (s : Fin 2) : ℝ := if s = 0 then 1 else -1

/-- `A_{s,t} = X₀₀ + s ε⁻¹ X₁₀ + t ε⁻³ X₀₁ + st X₁₁` (coefficient of `X_{ik}` at `(i,k)`). -/
def coefA (ε s t : ℝ) : Idx → ℝ :=
  fun x => (![![1, t * ε⁻¹ ^ 3], ![s * ε⁻¹, s * t]] : Fin 2 → Fin 2 → ℝ) x.1 x.2

/-- `B_{s,t} = ε⁻³ Y₀₀ + t Y₁₀ + st Y₀₁ + s ε⁻¹ Y₁₁` (coefficient of `Y_{k'j}` at `(k',j)`). -/
def coefB (ε s t : ℝ) : Idx → ℝ :=
  fun y => (![![ε⁻¹ ^ 3, s * t], ![t, s * ε⁻¹]] : Fin 2 → Fin 2 → ℝ) y.1 y.2

/-- `C_{s,t} = ε³ Z₀₀ + s ε⁴ Z₁₀ + st ε⁴ Z₀₁ + t ε Z₁₁` (coefficient of `Z_{ab}` at `(a,b)`). -/
def coefC (ε s t : ℝ) : Idx → ℝ :=
  fun z => (![![ε ^ 3, s * t * ε ^ 4], ![s * ε ^ 4, t * ε]] : Fin 2 → Fin 2 → ℝ) z.1 z.2

/-- `T_ε = ¼ ∑_{s,t ∈ {±1}} A_{s,t} B_{s,t} C_{s,t} − ε⁻⁵ X₀₁ Y₀₀ Z₁₁`. -/
def Teps (ε : ℝ) : Tensor2 := fun x y z =>
  (1 / 4 : ℝ) * ∑ s : Fin 2, ∑ t : Fin 2,
      coefA ε (signPM s) (signPM t) x * coefB ε (signPM s) (signPM t) y *
        coefC ε (signPM s) (signPM t) z
    - ε⁻¹ ^ 5 * (if x = (0, 1) ∧ y = (0, 0) ∧ z = (1, 1) then 1 else 0)

/-- The claimed sparse coefficient form of `T_ε` (15 monomials):
`Z₀₀: X₀₀Y₀₀ + X₀₁Y₁₀ + ε³X₁₁Y₀₁ + εX₁₀Y₁₁`,
`Z₀₁: ε⁴X₀₀Y₀₁ + X₀₁Y₁₁ + εX₁₁Y₀₀ + ε³X₁₀Y₁₀`,
`Z₁₀: X₁₀Y₀₀ + ε⁴X₁₁Y₁₀ + εX₀₁Y₀₁ + ε³X₀₀Y₁₁`,
`Z₁₁: X₁₀Y₀₁ + X₁₁Y₁₁ + εX₀₀Y₁₀`. -/
def Tclosed (ε : ℝ) : Tensor2 := fun x y z =>
  if z = (0, 0) then
    (if x = (0, 0) ∧ y = (0, 0) then 1 else 0) + (if x = (0, 1) ∧ y = (1, 0) then 1 else 0)
    + (if x = (1, 1) ∧ y = (0, 1) then ε ^ 3 else 0) + (if x = (1, 0) ∧ y = (1, 1) then ε else 0)
  else if z = (0, 1) then
    (if x = (0, 0) ∧ y = (0, 1) then ε ^ 4 else 0) + (if x = (0, 1) ∧ y = (1, 1) then 1 else 0)
    + (if x = (1, 1) ∧ y = (0, 0) then ε else 0) + (if x = (1, 0) ∧ y = (1, 0) then ε ^ 3 else 0)
  else if z = (1, 0) then
    (if x = (1, 0) ∧ y = (0, 0) then 1 else 0) + (if x = (1, 1) ∧ y = (1, 0) then ε ^ 4 else 0)
    + (if x = (0, 1) ∧ y = (0, 1) then ε else 0) + (if x = (0, 0) ∧ y = (1, 1) then ε ^ 3 else 0)
  else
    (if x = (1, 0) ∧ y = (0, 1) then 1 else 0) + (if x = (1, 1) ∧ y = (1, 1) then 1 else 0)
    + (if x = (0, 0) ∧ y = (1, 0) then ε else 0)

/-! ## Rubric items 1–2: construction and coefficient structure -/

/-- `T_ε` is a sum of five products of linear forms. [GeneralizationsOfMatrixMultiplication, node_15] -/
theorem Teps_hasRankLE_five (ε : ℝ) : HasRankLE (Teps ε) 5 := by sorry

/-- Coefficient verification, including cancellation of the `ε⁻⁵ X₀₁Y₀₀Z₁₁` term and the
absence of further monomials. [GeneralizationsOfMatrixMultiplication, node_15] -/
theorem Teps_eq_Tclosed (ε : ℝ) (hε : ε ≠ 0) : Teps ε = Tclosed ε := by sorry

/-! ## Rubric item 3: efficacy -/

/-- Exact efficacy identity for `ε > 0`. [GeneralizationsOfMatrixMultiplication, node_15] -/
theorem effSq_Teps (ε : ℝ) (hε : 0 < ε) :
    effSq (Teps ε) =
      4 / (2 + ε ^ 2 + ε ^ 6) + 2 * (1 + ε ^ 4) ^ 2 / (1 + ε ^ 2 + ε ^ 6 + ε ^ 8)
        + 4 / (2 + ε ^ 2) := by sorry

/-- Certified numerical bound at `ε = 1/40`. [GeneralizationsOfMatrixMultiplication, node_15] -/
theorem effSq_Teps_one_fortieth : (5.9974 : ℝ) < effSq (Teps (1 / 40)) := by sorry

/-- A rank-one tensor has `eff² ≤ 1` (so `T_{1/40}`, with `eff > 1`, has rank `≥ 2`). [GeneralizationsOfMatrixMultiplication, node_15] -/
theorem effSq_le_one_of_rank_le_one (T : Tensor2) (hT : HasRankLE T 1) : effSq T ≤ 1 := by
  sorry

/-! ## Rubric item 4 and main theorems -/

/-- `T_{2112} = T_{1/40}`: `rank ≤ 5` and `eff > 5^{1/1.797}`. [GeneralizationsOfMatrixMultiplication, node_15] -/
theorem main_T2112 :
    HasRankLE (Teps (1 / 40)) 5 ∧ (5 : ℝ) ^ ((1 : ℝ) / 1.797) < eff (Teps (1 / 40)) := by
  sorry

/-- Existential form: an explicit real tensor with `rank(T) ≤ 5` and `eff(T) > 5^{1/1.797}`. [GeneralizationsOfMatrixMultiplication, node_15] -/
theorem exists_tensor_rank_le_five_eff_gt :
    ∃ T : Tensor2, tensorRank T ≤ 5 ∧ (5 : ℝ) ^ ((1 : ℝ) / 1.797) < eff T := by sorry

/-- Hence `ω_ℓ < 1.797`, assuming the transfer principle: a fixed real tensor of rank
`r ≥ 2` and efficacy `E > 1` gives `ω_ℓ ≤ log r / log E`. [GeneralizationsOfMatrixMultiplication, node_15] -/
theorem omega_lt (ω : ℝ)
    (htransfer : ∀ T : Tensor2, 2 ≤ tensorRank T → 1 < eff T →
      ω ≤ Real.log (tensorRank T) / Real.log (eff T)) :
    ω < 1.797 := by sorry

end TCSChallenge.GeneralizationsOfMatrixMultiplication.node_15
