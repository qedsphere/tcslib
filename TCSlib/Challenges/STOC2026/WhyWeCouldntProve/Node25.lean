/-!
## Exact rank-only compression of SVP_p queries for even p

`SVP_p` asks whether `λ₁^{(p)}(𝓛(B)) = min_{z ≠ 0} ‖Bz‖_p ≤ d`. For a reduced basis, some
(indeed every) shortest nonzero vector has coefficients bounded by `T = m·2^{2r}`. For even
`p`, `‖Bz‖_p^p = ∑_{I∈[r]^p} a_I ∏ⱼ z_{Iⱼ}` with `a_I = ∑ₗ ∏ⱼ B_{ℓ,Iⱼ}`, so the decision
`‖Bz‖_p^p ≤ d^p` is the sign of `a · u(z)` with `a = ((a_I), d^p)` and
`u(z) = ((∏ⱼ z_{Iⱼ}), −1)`. Sign-preserving replacement on test vectors of ℓ₁-norm
`< N = hT^p + 1` gives a short record that an unbounded receiver decides by enumerating the
nonzero points of `[−T,T]^r`.

Main theorem: `TCSChallenge.WhyWeCouldntProve.node_25.svpp_exact_compression`.
-/

namespace TCSChallenge.WhyWeCouldntProve.node_25

/-! ## Shared lattice definitions (identical in node_23, node_24, node_25) -/

/-- Squared Euclidean norm `‖x‖₂² = ∑ₖ xₖ²`. -/
def sqNorm {m : ℕ} (x : Fin m → ℝ) : ℝ := ∑ k, x k ^ 2

/-- Euclidean inner product `⟨x, y⟩ = ∑ₖ xₖ yₖ`. -/
def ip {m : ℕ} (x y : Fin m → ℝ) : ℝ := ∑ k, x k * y k

/-- The lattice vector `Cz = ∑ᵢ zᵢ cᵢ`; the basis is given by its columns `C i : Fin m → ℝ`.
"Write `𝓛(B) = Bℤ^r`." -/
def latVec {m r : ℕ} (C : Fin r → Fin m → ℝ) (z : Fin r → ℤ) : Fin m → ℝ :=
  fun k => ∑ i, (z i : ℝ) * C i k

/-- Gram–Schmidt data of the basis `C`: the vectors `gᵢ = cᵢ*` are pairwise orthogonal and
nonzero (full column rank), and `cᵢ = gᵢ + ∑_{j<i} μᵢⱼ gⱼ`. -/
def IsGSData {m r : ℕ} (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ) : Prop :=
  (∀ i j, i ≠ j → ip (g i) (g j) = 0) ∧ (∀ i, g i ≠ 0) ∧
    ∀ i k, C i k = g i k + ∑ j, (if j < i then μ i j * g j k else 0)

/-- LLL-type reduction inequalities used by the reference proof: size reduction
`|μᵢⱼ| ≤ 1/2` for `j < i`, and "`‖g_j‖² ≤ 2^{i−j} ‖g_i‖²` for `j ≤ i`". -/
def IsLLLReduced {m r : ℕ} (g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ) : Prop :=
  (∀ i j : Fin r, j < i → |μ i j| ≤ 1 / 2) ∧
    ∀ i j : Fin r, j ≤ i → sqNorm (g j) ≤ 2 ^ ((i : ℕ) - (j : ℕ)) * sqNorm (g i)

/-- A normalized target: "`u = t_⊥ + ∑ᵢ ξᵢ gᵢ` with `t_⊥ ⊥ span(C)` and `|ξᵢ| ≤ 1/2`". -/
def IsNormalizedTarget {m r : ℕ} (g : Fin r → Fin m → ℝ) (u : Fin m → ℝ) : Prop :=
  ∃ (ξ : Fin r → ℝ) (tperp : Fin m → ℝ),
    (∀ i, ip tperp (g i) = 0) ∧ (∀ i, |ξ i| ≤ 1 / 2) ∧
      ∀ k, u k = tperp k + ∑ i, ξ i * g i k

/-- The shifted target `t − Cw` for an integer vector `w`. -/
def shiftTarget {m r : ℕ} (C : Fin r → Fin m → ℝ) (t : Fin m → ℝ) (w : Fin r → ℤ) :
    Fin m → ℝ :=
  fun k => t k - latVec C w k

/-- Output guarantee of sign-preserving integer replacement: "`sign(a·v) = sign(b·v)` for
every `v ∈ ℤ^s` with `‖v‖₁ < N`". -/
def SignPreservingBelow {ι : Type} [Fintype ι] (a b : ι → ℤ) (N : ℕ) : Prop :=
  ∀ v : ι → ℤ, ∑ x, |v x| < (N : ℤ) → Int.sign (dotProduct a v) = Int.sign (dotProduct b v)

/-- `a` is a positive multiple of the real coefficient vector `q` ("multiply all
coefficients by one positive common denominator"). -/
def IsScaledCoeff {ι : Type} (a : ι → ℤ) (q : ι → ℝ) : Prop :=
  ∃ D : ℝ, 0 < D ∧ ∀ x, (a x : ℝ) = D * q x

/-! ## Shared ℓ_p definition (identical in node_24, node_25) -/

/-- `‖x‖_p^p = ∑ₖ xₖ^p` (equal to `∑ₖ |xₖ|^p` because `p` is even). -/
def pPow (p : ℕ) {m : ℕ} (x : Fin m → ℝ) : ℝ := ∑ k, x k ^ p

/-! ## Definitions specific to the SVP_p row -/

/-- YES instances of SVP_p: "`λ₁^{(p)}(𝓛(B)) ≤ d`", via `p`-th powers (`d > 0`, `p` even). -/
def SVPpYes (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (d : ℝ) : Prop :=
  ∃ z : Fin r → ℤ, z ≠ 0 ∧ pPow p (latVec C z) ≤ d ^ p

/-- `Cz` is a shortest nonzero lattice vector in ℓ_p. -/
def IsShortestP (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (z : Fin r → ℤ) : Prop :=
  z ≠ 0 ∧ ∀ q : Fin r → ℤ, q ≠ 0 → pPow p (latVec C z) ≤ pPow p (latVec C q)

/-- The coordinate bound "`T = m·2^{2r}`". -/
def boxT (m r : ℕ) : ℕ := m * 2 ^ (2 * r)

/-- Index set of size `h = r^p + 1`: ordered tuples `I ∈ [r]^p` and the threshold slot. -/
abbrev SvpIdx (p r : ℕ) : Type := (Fin p → Fin r) ⊕ Unit

/-- "`a = ((a_I)_{I∈[r]^p}, d^p)`" with "`a_I = ∑_ℓ ∏ⱼ B_{ℓ,iⱼ}`". -/
def svpCoeff (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (d : ℝ) : SvpIdx p r → ℝ
  | Sum.inl I => ∑ k, ∏ l, C (I l) k
  | Sum.inr _ => d ^ p

/-- "`u(z) = ((∏ⱼ z_{iⱼ})_{I∈[r]^p}, −1)`". -/
def svpTestVec (p : ℕ) {r : ℕ} (z : Fin r → ℤ) : SvpIdx p r → ℤ
  | Sum.inl I => ∏ l, z (I l)
  | Sum.inr _ => -1

/-- The norm parameter "`N = hT^p + 1`" with `h = r^p + 1`. -/
def recordNS (p m r : ℕ) : ℕ := (r ^ p + 1) * boxT m r ^ p + 1

/-- The receiver's decoder on `(r, T, â)`: "enumerate every nonzero integer `z` in `[−T,T]^r`
and return YES exactly when `â·u(z) ≤ 0` for at least one such `z`". -/
def decodeSVP (p r T : ℕ) (ahat : SvpIdx p r → ℤ) : Prop :=
  ∃ z : Fin r → ℤ, z ≠ 0 ∧ (∀ i, |z i| ≤ (T : ℤ)) ∧ dotProduct ahat (svpTestVec p z) ≤ 0

/-! ## Lemma stubs -/

/-- A shortest nonzero vector exists (the lattice is discrete and has positive rank). [WhyWeCouldntProve, node_25] -/
theorem exists_shortestP (p : ℕ) (hp : Even p) (hp2 : 2 ≤ p) {m r : ℕ} (hr : 1 ≤ r)
    (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ) (hGS : IsGSData C g μ) :
    ∃ z : Fin r → ℤ, IsShortestP p C z := by
  sorry

/-- Rubric 1: "`‖z‖_∞ ≤ T = m·2^{2r}`" for a shortest nonzero vector `Cz` of a reduced basis. [WhyWeCouldntProve, node_25] -/
theorem shortestP_coeff_bound (p : ℕ) (hp : Even p) (hp2 : 2 ≤ p) {m r : ℕ}
    (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ)
    (hGS : IsGSData C g μ) (hLLL : IsLLLReduced g μ)
    (z : Fin r → ℤ) (hz : IsShortestP p C z) :
    ∀ i, |z i| ≤ (boxT m r : ℤ) := by
  sorry

/-- Rubric 2: "`a·u(z) = ‖Bz‖_p^p − t^p`". [WhyWeCouldntProve, node_25] -/
theorem svp_expansion (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (d : ℝ) (z : Fin r → ℤ) :
    pPow p (latVec C z) - d ^ p = ∑ x, svpCoeff p C d x * (svpTestVec p z x : ℝ) := by
  sorry

/-- Rubric 2: "`‖u(z)‖₁ ≤ r^p T^p + 1 ≤ hT^p`" on the box, hence `< N`. [WhyWeCouldntProve, node_25] -/
theorem svpTestVec_l1_lt (p : ℕ) {m r : ℕ} (hm : 1 ≤ m) (z : Fin r → ℤ)
    (hz : ∀ i, |z i| ≤ (boxT m r : ℤ)) :
    ∑ x, |svpTestVec p z x| < (recordNS p m r : ℤ) := by
  sorry

/-! ## Main theorem -/

/-- Exact rank-only compression of an SVP_p query (rubrics 1–2): for a reduced basis `C`,
the integer coefficient vector `a` of `‖Cz‖_p^p − d^p`, and any `â` sign-equivalent to `a` on
test vectors of ℓ₁-norm `< N`, the receiver's decoder on `(r, T, â)` returns exactly the
answer to "`λ₁^{(p)}(𝓛(C)) ≤ d`". [WhyWeCouldntProve, node_25] -/
theorem svpp_exact_compression (p : ℕ) (hp : Even p) (hp2 : 2 ≤ p) {m r : ℕ} (hr : 1 ≤ r)
    (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ)
    (hGS : IsGSData C g μ) (hLLL : IsLLLReduced g μ) (d : ℝ) (hd : 0 < d)
    (a ahat : SvpIdx p r → ℤ) (ha : IsScaledCoeff a (svpCoeff p C d))
    (hsp : SignPreservingBelow a ahat (recordNS p m r)) :
    SVPpYes p C d ↔ decodeSVP p r (boxT m r) ahat := by
  sorry

