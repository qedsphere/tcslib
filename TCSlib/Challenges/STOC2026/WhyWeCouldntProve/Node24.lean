/-!
## Exact rank-only compression of promise CVP_p queries for even p

For even `p`, `‖Cz − t‖_p^p = ∑ⱼ (∑ᵢ Cⱼᵢ zᵢ − tⱼ)^p` is a polynomial of degree `p` in `z`.
Under the promise `dist_p(𝓛(B), t) ≤ T λ₁^{(p)}(𝓛(B))`, after basis reduction and a lattice
shift of the target, every closest vector has coefficients bounded by `R = (1 + mT2^r)2^r`,
so sign-preserving replacement applied to the coefficient vector of
`F(z) = ‖Cz − t'‖_p^p − d^p` (tested on monomial vectors of ℓ₁-norm `< N = sR^p + 1`) yields a
short record decided exactly by enumerating `[−R, R]^r`.

Main theorem: `TCSChallenge.WhyWeCouldntProve.node_24.cvpp_exact_compression`.
-/

namespace TCSChallenge.WhyWeCouldntProve.node_24

/-! ## Shared lattice definitions (identical in node_23, node_24, node_25) -/

/-- Squared Euclidean norm `‖x‖₂² = ∑ₖ xₖ²`. -/
def sqNorm {m : ℕ} (x : Fin m → ℝ) : ℝ := ∑ k, x k ^ 2

/-- Euclidean inner product `⟨x, y⟩ = ∑ₖ xₖ yₖ`. -/
def ip {m : ℕ} (x y : Fin m → ℝ) : ℝ := ∑ k, x k * y k

/-- The lattice vector `Cz = ∑ᵢ zᵢ cᵢ`; the basis is given by its columns `C i : Fin m → ℝ`.
"Write `𝓛(B) = Bℤ^r`." -/
def latVec {m r : ℕ} (C : Fin r → Fin m → ℝ) (z : Fin r → ℤ) : Fin m → ℝ :=
  fun k => ∑ i, (z i : ℝ) * C i k

/-- Gram–Schmidt data of the basis `C`: the vectors `gᵢ = cᵢ*` are pairwise orthogonal and
nonzero (full column rank), and `cᵢ = gᵢ + ∑_{j<i} μᵢⱼ gⱼ`. -/
def IsGSData {m r : ℕ} (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ) : Prop :=
  (∀ i j, i ≠ j → ip (g i) (g j) = 0) ∧ (∀ i, g i ≠ 0) ∧
    ∀ i k, C i k = g i k + ∑ j, (if j < i then μ i j * g j k else 0)

/-- LLL-type reduction inequalities used by the reference proof: size reduction
`|μᵢⱼ| ≤ 1/2` for `j < i`, and "`‖g_j‖² ≤ 2^{i−j} ‖g_i‖²` for `j ≤ i`". -/
def IsLLLReduced {m r : ℕ} (g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ) : Prop :=
  (∀ i j : Fin r, j < i → |μ i j| ≤ 1 / 2) ∧
    ∀ i j : Fin r, j ≤ i → sqNorm (g j) ≤ 2 ^ ((i : ℕ) - (j : ℕ)) * sqNorm (g i)

/-- A normalized target: "`u = t_⊥ + ∑ᵢ ξᵢ gᵢ` with `t_⊥ ⊥ span(C)` and `|ξᵢ| ≤ 1/2`". -/
def IsNormalizedTarget {m r : ℕ} (g : Fin r → Fin m → ℝ) (u : Fin m → ℝ) : Prop :=
  ∃ (ξ : Fin r → ℝ) (tperp : Fin m → ℝ),
    (∀ i, ip tperp (g i) = 0) ∧ (∀ i, |ξ i| ≤ 1 / 2) ∧
      ∀ k, u k = tperp k + ∑ i, ξ i * g i k

/-- The shifted target `t − Cw` for an integer vector `w`. -/
def shiftTarget {m r : ℕ} (C : Fin r → Fin m → ℝ) (t : Fin m → ℝ) (w : Fin r → ℤ) :
    Fin m → ℝ :=
  fun k => t k - latVec C w k

/-- Output guarantee of sign-preserving integer replacement: "`sign(a·v) = sign(b·v)` for
every `v ∈ ℤ^s` with `‖v‖₁ < N`". -/
def SignPreservingBelow {ι : Type} [Fintype ι] (a b : ι → ℤ) (N : ℕ) : Prop :=
  ∀ v : ι → ℤ, ∑ x, |v x| < (N : ℤ) → Int.sign (dotProduct a v) = Int.sign (dotProduct b v)

/-- `a` is a positive multiple of the real coefficient vector `q` ("multiply all
coefficients by one positive common denominator"). -/
def IsScaledCoeff {ι : Type} (a : ι → ℤ) (q : ι → ℝ) : Prop :=
  ∃ D : ℝ, 0 < D ∧ ∀ x, (a x : ℝ) = D * q x

/-! ## Shared ℓ_p definition (identical in node_24, node_25) -/

/-- `‖x‖_p^p = ∑ₖ xₖ^p` (equal to `∑ₖ |xₖ|^p` because `p` is even). -/
def pPow (p : ℕ) {m : ℕ} (x : Fin m → ℝ) : ℝ := ∑ k, x k ^ p

/-! ## Definitions specific to the promise CVP_p row -/

/-- YES instances: "`dist_p(𝓛(B), t) ≤ d`", via `p`-th powers (`d > 0`, `p` even). -/
def CVPpYes (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (t : Fin m → ℝ) (d : ℝ) : Prop :=
  ∃ z : Fin r → ℤ, pPow p (fun k => latVec C z k - t k) ≤ d ^ p

/-- The promise "`dist_p(𝓛(B), t) ≤ T · λ₁^{(p)}(𝓛(B))`", with attained minima, in `p`-th
powers: some lattice vector `Cz` satisfies `‖Cz − t‖_p ≤ T ‖Cq‖_p` for every `q ≠ 0`. -/
def PromiseCVP (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (t : Fin m → ℝ) (T : ℕ) : Prop :=
  ∃ z : Fin r → ℤ, ∀ q : Fin r → ℤ, q ≠ 0 →
    pPow p (fun k => latVec C z k - t k) ≤ (T : ℝ) ^ p * pPow p (latVec C q)

/-- `Cz` is an ℓ_p-closest lattice vector to `u`. -/
def IsClosestP (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (u : Fin m → ℝ) (z : Fin r → ℤ) :
    Prop :=
  ∀ q : Fin r → ℤ, pPow p (fun k => latVec C z k - u k) ≤ pPow p (fun k => latVec C q k - u k)

/-- The box radius "`R = (1 + mT2^r)2^r`". -/
def boxRP (m r T : ℕ) : ℕ := (1 + m * T * 2 ^ r) * 2 ^ r

/-- Index set: ordered `p`-tuples over `{constant} ∪ [r]` (`none` is the constant). -/
abbrev TupIdx (p r : ℕ) : Type := Fin p → Option (Fin r)

/-- Homogenized coordinates `z' = (1, z)`. -/
def extVal {r : ℕ} (z : Fin r → ℤ) : Option (Fin r) → ℤ
  | none => 1
  | some i => z i

/-- Monomial test vector `v(z)_I = ∏ₗ z'_{I l}`. -/
def monVecP (p : ℕ) {r : ℕ} (z : Fin r → ℤ) : TupIdx p r → ℤ :=
  fun I => ∏ l, extVal z (I l)

/-- Homogenized row `k` of `[C | −t']`. -/
def extCoeff {m r : ℕ} (C : Fin r → Fin m → ℝ) (u : Fin m → ℝ) (k : Fin m) :
    Option (Fin r) → ℝ
  | none => -u k
  | some i => C i k

/-- Coefficients of `F(z) = ∑ⱼ (∑ᵢ Cⱼᵢ zᵢ − t'ⱼ)^p − d^p` in the tuple basis. -/
def fCoeff (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (u : Fin m → ℝ) (d : ℝ) :
    TupIdx p r → ℝ :=
  fun I => (∑ k, ∏ l, extCoeff C u k (I l)) - (if I = (fun _ => none) then d ^ p else 0)

/-- The norm parameter `N = sR^p + 1` with `s = (r+1)^p`. -/
def recordNP (p r R : ℕ) : ℕ := (r + 1) ^ p * R ^ p + 1

/-- The fixed decoder on a record `(r, R, â)`: "enumerate `[−R,R]^r ∩ ℤ^r` and answer YES
precisely when `â·v(z) ≤ 0` for some `z`". -/
def decodeRecordP (p r R : ℕ) (ahat : TupIdx p r → ℤ) : Prop :=
  ∃ z : Fin r → ℤ, (∀ i, |z i| ≤ (R : ℤ)) ∧ dotProduct ahat (monVecP p z) ≤ 0

/-! ## Lemma stubs -/

/-- Rubric 1: rounding in descending order gives a lattice shift normalizing the target. [WhyWeCouldntProve, node_24] -/
theorem exists_normalizing_shift {m r : ℕ} (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ)
    (hGS : IsGSData C g μ) (t : Fin m → ℝ) :
    ∃ w : Fin r → ℤ, IsNormalizedTarget g (shiftTarget C t w) := by
  sorry

/-- Rubric 1: the lattice shift preserves the answer. [WhyWeCouldntProve, node_24] -/
theorem cvppYes_shift_iff (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (t : Fin m → ℝ) (d : ℝ)
    (w : Fin r → ℤ) : CVPpYes p C t d ↔ CVPpYes p C (shiftTarget C t w) d := by
  sorry

/-- The lattice shift preserves the promise. [WhyWeCouldntProve, node_24] -/
theorem promise_shift_iff (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (t : Fin m → ℝ) (T : ℕ)
    (w : Fin r → ℤ) : PromiseCVP p C t T ↔ PromiseCVP p C (shiftTarget C t w) T := by
  sorry

/-- An ℓ_p-closest lattice vector exists. [WhyWeCouldntProve, node_24] -/
theorem exists_closestP (p : ℕ) (hp : Even p) (hp2 : 2 ≤ p) {m r : ℕ}
    (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ) (hGS : IsGSData C g μ)
    (u : Fin m → ℝ) : ∃ z : Fin r → ℤ, IsClosestP p C u z := by
  sorry

/-- Rubric 2 (bounded search region): under the promise, every ℓ_p-closest vector to the
normalized target has coefficients in `[−R, R]`, `R = (1 + mT2^r)2^r`. [WhyWeCouldntProve, node_24] -/
theorem closestP_coeff_bound (p : ℕ) (hp : Even p) (hp2 : 2 ≤ p) {m r : ℕ}
    (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ)
    (hGS : IsGSData C g μ) (hLLL : IsLLLReduced g μ) (T : ℕ) (hT : 1 ≤ T)
    (u : Fin m → ℝ) (hu : IsNormalizedTarget g u) (hprom : PromiseCVP p C u T)
    (z : Fin r → ℤ) (hz : IsClosestP p C u z) :
    ∀ i, |z i| ≤ (boxRP m r T : ℤ) := by
  sorry

/-- Rubric 3 (polynomial description): `‖Cz − u‖_p^p − d^p = ∑_I F_I · v(z)_I`. [WhyWeCouldntProve, node_24] -/
theorem pPow_expansion (p : ℕ) {m r : ℕ} (C : Fin r → Fin m → ℝ) (u : Fin m → ℝ) (d : ℝ)
    (z : Fin r → ℤ) :
    pPow p (fun k => latVec C z k - u k) - d ^ p =
      ∑ I, fCoeff p C u d I * (monVecP p z I : ℝ) := by
  sorry

/-- Rubric 3: monomial vectors of box points have ℓ₁-norm `≤ sR^p < N`. [WhyWeCouldntProve, node_24] -/
theorem monVecP_l1_lt (p : ℕ) {r : ℕ} (R : ℕ) (hR : 1 ≤ R) (z : Fin r → ℤ)
    (hz : ∀ i, |z i| ≤ (R : ℤ)) :
    ∑ I, |monVecP p z I| < (recordNP p r R : ℤ) := by
  sorry

/-! ## Main theorem -/

/-- Exact rank-only compression of a promised CVP_p query (rubrics 1–3), including equality at
the threshold: the finite decoder on `(r, R, â)` with `R = (1 + mT2^r)2^r` returns exactly
the answer to "`dist_p(𝓛(C), t) ≤ d`". [WhyWeCouldntProve, node_24] -/
theorem cvpp_exact_compression (p : ℕ) (hp : Even p) (hp2 : 2 ≤ p) {m r : ℕ}
    (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ)
    (hGS : IsGSData C g μ) (hLLL : IsLLLReduced g μ) (t : Fin m → ℝ) (d : ℝ) (hd : 0 < d)
    (T : ℕ) (hT : 1 ≤ T) (hprom : PromiseCVP p C t T)
    (w : Fin r → ℤ) (hu : IsNormalizedTarget g (shiftTarget C t w))
    (a ahat : TupIdx p r → ℤ) (ha : IsScaledCoeff a (fCoeff p C (shiftTarget C t w) d))
    (hsp : SignPreservingBelow a ahat (recordNP p r (boxRP m r T))) :
    CVPpYes p C t d ↔ decodeRecordP p r (boxRP m r T) ahat := by
  sorry

end TCSChallenge.WhyWeCouldntProve.node_24
