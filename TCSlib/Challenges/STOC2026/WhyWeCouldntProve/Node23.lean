/-!
## Exact rank-only compression of Euclidean CVP queries

A CVP₂ instance is a basis `C = [c₁,…,c_r]` (columns in `ℝ^m`), a target `t` and a threshold
`d > 0`; it is YES iff `min_{z ∈ ℤ^r} ‖Cz − t‖₂ ≤ d`.

The proof of the barrier first compresses every query into a record whose length depends on
the rank only: reduce the basis, shift the target by a lattice vector so that its
Gram–Schmidt coordinates lie in `[−1/2, 1/2]`, prove that every closest vector then has
coefficients in `[−R, R]` with `R = 2^{r²}`, expand `Q(z) = ‖Cz − u‖² − d²` as a linear form
`a · v(z)` in the monomial vector `v(z) = ((zᵢzⱼ)ᵢⱼ, (zᵢ)ᵢ, 1)`, and replace `a` by a short
sign-equivalent integer vector `â`. An unbounded party decides the record by enumerating
the box.

Main theorem: `TCSChallenge.WhyWeCouldntProve.node_23.cvp2_exact_compression`.
-/

namespace TCSChallenge.WhyWeCouldntProve.node_23

/-! ## Shared lattice definitions (identical in node_23, node_24, node_25) -/

/-- Squared Euclidean norm `‖x‖₂² = ∑ₖ xₖ²`. -/
def sqNorm {m : ℕ} (x : Fin m → ℝ) : ℝ := ∑ k, x k ^ 2

/-- Euclidean inner product `⟨x, y⟩ = ∑ₖ xₖ yₖ`. -/
def ip {m : ℕ} (x y : Fin m → ℝ) : ℝ := ∑ k, x k * y k

/-- The lattice vector `Cz = ∑ᵢ zᵢ cᵢ`; the basis is given by its columns `C i : Fin m → ℝ`.
"Write `𝓛(B) = Bℤ^r`." -/
def latVec {m r : ℕ} (C : Fin r → Fin m → ℝ) (z : Fin r → ℤ) : Fin m → ℝ :=
  fun k => ∑ i, (z i : ℝ) * C i k

/-- Gram–Schmidt data of the basis `C`: the vectors `gᵢ = cᵢ*` are pairwise orthogonal and
nonzero (full column rank), and `cᵢ = gᵢ + ∑_{j<i} μᵢⱼ gⱼ`. -/
def IsGSData {m r : ℕ} (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ) : Prop :=
  (∀ i j, i ≠ j → ip (g i) (g j) = 0) ∧ (∀ i, g i ≠ 0) ∧
    ∀ i k, C i k = g i k + ∑ j, (if j < i then μ i j * g j k else 0)

/-- LLL-type reduction inequalities used by the reference proof: size reduction
`|μᵢⱼ| ≤ 1/2` for `j < i`, and "`‖g_j‖² ≤ 2^{i−j} ‖g_i‖²` for `j ≤ i`". -/
def IsLLLReduced {m r : ℕ} (g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ) : Prop :=
  (∀ i j : Fin r, j < i → |μ i j| ≤ 1 / 2) ∧
    ∀ i j : Fin r, j ≤ i → sqNorm (g j) ≤ 2 ^ ((i : ℕ) - (j : ℕ)) * sqNorm (g i)

/-- A normalized target: "`u = t_⊥ + ∑ᵢ ξᵢ gᵢ` with `t_⊥ ⊥ span(C)` and `|ξᵢ| ≤ 1/2`". -/
def IsNormalizedTarget {m r : ℕ} (g : Fin r → Fin m → ℝ) (u : Fin m → ℝ) : Prop :=
  ∃ (ξ : Fin r → ℝ) (tperp : Fin m → ℝ),
    (∀ i, ip tperp (g i) = 0) ∧ (∀ i, |ξ i| ≤ 1 / 2) ∧
      ∀ k, u k = tperp k + ∑ i, ξ i * g i k

/-- The shifted target `t − Cw` for an integer vector `w`. -/
def shiftTarget {m r : ℕ} (C : Fin r → Fin m → ℝ) (t : Fin m → ℝ) (w : Fin r → ℤ) :
    Fin m → ℝ :=
  fun k => t k - latVec C w k

/-- Output guarantee of sign-preserving integer replacement: "`sign(a·v) = sign(b·v)` for
every `v ∈ ℤ^s` with `‖v‖₁ < N`". -/
def SignPreservingBelow {ι : Type} [Fintype ι] (a b : ι → ℤ) (N : ℕ) : Prop :=
  ∀ v : ι → ℤ, ∑ x, |v x| < (N : ℤ) → Int.sign (dotProduct a v) = Int.sign (dotProduct b v)

/-- `a` is a positive multiple of the real coefficient vector `q` ("multiply all
coefficients by one positive common denominator"). -/
def IsScaledCoeff {ι : Type} (a : ι → ℤ) (q : ι → ℝ) : Prop :=
  ∃ D : ℝ, 0 < D ∧ ∀ x, (a x : ℝ) = D * q x

/-! ## Definitions specific to the Euclidean CVP row -/

/-- YES instances of CVP₂: "`min_{z ∈ ℤ^r} ‖Bz − t‖₂ ≤ d`" (squared, `d > 0`). -/
def CVPYes {m r : ℕ} (C : Fin r → Fin m → ℝ) (t : Fin m → ℝ) (d : ℝ) : Prop :=
  ∃ z : Fin r → ℤ, sqNorm (fun k => latVec C z k - t k) ≤ d ^ 2

/-- `Cz` is a closest lattice vector to `u`. -/
def IsClosest {m r : ℕ} (C : Fin r → Fin m → ℝ) (u : Fin m → ℝ) (z : Fin r → ℤ) : Prop :=
  ∀ q : Fin r → ℤ,
    sqNorm (fun k => latVec C z k - u k) ≤ sqNorm (fun k => latVec C q k - u k)

/-- The box radius `R = 2^{r²}`. -/
def boxR (r : ℕ) : ℕ := 2 ^ (r ^ 2)

/-- Monomial index set, of size `s = r² + r + 1`: pairs `(i,j)`, singletons `i`, constant. -/
abbrev MonIdx (r : ℕ) : Type := (Fin r × Fin r) ⊕ (Fin r ⊕ Unit)

/-- "`v(z) = ((zᵢzⱼ)_{i,j∈[r]}, (zᵢ)_{i∈[r]}, 1) ∈ ℤ^s`". -/
def monVec {r : ℕ} (z : Fin r → ℤ) : MonIdx r → ℤ
  | Sum.inl ij => z ij.1 * z ij.2
  | Sum.inr (Sum.inl i) => z i
  | Sum.inr (Sum.inr _) => 1

/-- Coefficients `a⁽⁰⁾` of `Q(z) = ∑ᵢⱼ ⟨cᵢ,cⱼ⟩zᵢzⱼ − 2∑ᵢ ⟨cᵢ,u⟩zᵢ + ‖u‖² − d²`. -/
def qCoeff {m r : ℕ} (C : Fin r → Fin m → ℝ) (u : Fin m → ℝ) (d : ℝ) : MonIdx r → ℝ
  | Sum.inl ij => ip (C ij.1) (C ij.2)
  | Sum.inr (Sum.inl i) => -2 * ip (C i) u
  | Sum.inr (Sum.inr _) => sqNorm u - d ^ 2

/-- The norm parameter "`N = sR² + 1`" with `s = r² + r + 1`. -/
def recordN (r : ℕ) : ℕ := (r ^ 2 + r + 1) * boxR r ^ 2 + 1

/-- The fixed decision procedure on a record `(r, â)`: "enumerate every
`z ∈ [−R,R]^r ∩ ℤ^r`, and answer YES iff at least one satisfies `â·v(z) ≤ 0`". -/
def decodeRecord (r : ℕ) (ahat : MonIdx r → ℤ) : Prop :=
  ∃ z : Fin r → ℤ, (∀ i, |z i| ≤ (boxR r : ℤ)) ∧ dotProduct ahat (monVec z) ≤ 0

/-! ## Lemma stubs -/

/-- Rubric 1 (target normalization): nearest-integer rounding in descending order produces
an integer shift `w` such that `t − Cw` has Gram–Schmidt coordinates in `[−1/2, 1/2]`. [WhyWeCouldntProve, node_23] -/
theorem exists_normalizing_shift {m r : ℕ} (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ)
    (hGS : IsGSData C g μ) (t : Fin m → ℝ) :
    ∃ w : Fin r → ℤ, IsNormalizedTarget g (shiftTarget C t w) := by
  sorry

/-- Shifting the target by a lattice vector preserves the CVP answer. [WhyWeCouldntProve, node_23] -/
theorem cvpYes_shift_iff {m r : ℕ} (C : Fin r → Fin m → ℝ) (t : Fin m → ℝ) (d : ℝ)
    (w : Fin r → ℤ) : CVPYes C t d ↔ CVPYes C (shiftTarget C t w) d := by
  sorry

/-- A closest lattice vector exists (the lattice is discrete). [WhyWeCouldntProve, node_23] -/
theorem exists_closest {m r : ℕ} (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ)
    (hGS : IsGSData C g μ) (u : Fin m → ℝ) : ∃ z : Fin r → ℤ, IsClosest C u z := by
  sorry

/-- Rubric 1 (coefficient bound): "every closest vector `Cz` to `u` satisfies
`‖z‖_∞ ≤ R := 2^{r²}`". [WhyWeCouldntProve, node_23] -/
theorem closest_coeff_bound {m r : ℕ} (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ)
    (hGS : IsGSData C g μ) (hLLL : IsLLLReduced g μ) (u : Fin m → ℝ)
    (hu : IsNormalizedTarget g u) (z : Fin r → ℤ) (hz : IsClosest C u z) :
    ∀ i, |z i| ≤ (boxR r : ℤ) := by
  sorry

/-- Rubric 2 (quadratic encoding): `‖Cz − u‖² − d² = a⁽⁰⁾ · v(z)`. [WhyWeCouldntProve, node_23] -/
theorem quad_expansion {m r : ℕ} (C : Fin r → Fin m → ℝ) (u : Fin m → ℝ) (d : ℝ)
    (z : Fin r → ℤ) :
    sqNorm (fun k => latVec C z k - u k) - d ^ 2 =
      ∑ x, qCoeff C u d x * (monVec z x : ℝ) := by
  sorry

/-- Rubric 3 (norm parameter): on the box, "`‖v(z)‖₁ ≤ sR² < N`". [WhyWeCouldntProve, node_23] -/
theorem monVec_l1_lt {r : ℕ} (z : Fin r → ℤ) (hz : ∀ i, |z i| ≤ (boxR r : ℤ)) :
    ∑ x, |monVec z x| < (recordN r : ℤ) := by
  sorry

/-! ## Main theorem -/

/-- Exact rank-only compression of a CVP₂ query (rubrics 1–3): for a reduced basis `C` with
Gram–Schmidt data `(g, μ)`, a lattice shift `w` normalizing the target, the integer
coefficient vector `a` of `Q`, and any `â` that is sign-equivalent to `a` on test vectors of
ℓ₁-norm `< N = sR² + 1`, the finite decoder on `(r, â)` returns exactly the CVP answer. [WhyWeCouldntProve, node_23] -/
theorem cvp2_exact_compression {m r : ℕ} (C g : Fin r → Fin m → ℝ) (μ : Fin r → Fin r → ℝ)
    (hGS : IsGSData C g μ) (hLLL : IsLLLReduced g μ) (t : Fin m → ℝ) (d : ℝ) (hd : 0 < d)
    (w : Fin r → ℤ) (hu : IsNormalizedTarget g (shiftTarget C t w))
    (a ahat : MonIdx r → ℤ) (ha : IsScaledCoeff a (qCoeff C (shiftTarget C t w) d))
    (hsp : SignPreservingBelow a ahat (recordN r)) :
    CVPYes C t d ↔ decodeRecord r ahat := by
  sorry

end TCSChallenge.WhyWeCouldntProve.node_23
