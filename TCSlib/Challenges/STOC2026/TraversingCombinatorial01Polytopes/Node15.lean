/-!
## Greedy λ-minimizing traversal of a prefix graph is a genlex Hamilton path

`X ⊆ {0,1}ⁿ` finite, `G` a simple graph whose relevant edges join points of `X`.
`λ(x,y)` is the largest index where `x` and `y` differ. `G` is a *prefix graph* if for all
distinct `x, z ∈ X` some neighbour `y ∈ X` of `x` has `λ(x,y) = λ(x,z)`.

The procedure starts at `x̃`, and while the current vertex has an unvisited neighbour moves
to one minimizing `λ`; ties are arbitrary (even history-dependent), so every sequence
obeying the rule is a run. Main theorem `greedy_prefix_graph_genlex_hamilton`: every
terminated run visits all of `X` exactly once along edges of `G`, in genlex order.

A run is `p : ℕ → (Fin n → Bool)` with length `m`; only `p 0, …, p (m-1)` matter.
-/

namespace TCSChallenge.TraversingCombinatorial01Polytopes.node_15

/-- The set of coordinates on which `x` and `y` differ, `{i : x_i ≠ y_i}`. -/
def diffSet {n : ℕ} (x y : Fin n → Bool) : Finset (Fin n) :=
  Finset.univ.filter (fun i => x i ≠ y i)

/-- `λ(x,y) = max{i : x_i ≠ y_i}`, 1-based (so `λ ∈ {1,…,n}` for `x ≠ y`, and `0` if
`x = y`). -/
def lam {n : ℕ} (x y : Fin n → Bool) : ℕ :=
  (diffSet x y).sup (fun i => i.val + 1)

/-- The vertices used before step `k+1`, i.e. `{x₁,…,x_{k+1}}` = `{p 0, …, p k}`. -/
def usedUpTo {n : ℕ} (p : ℕ → Fin n → Bool) (k : ℕ) : Finset (Fin n → Bool) :=
  (Finset.range (k + 1)).image p

/-- Prefix graph: "for every pair of distinct vertices x, z ∈ X, there exists a neighbor y
of x such that λ(x,y) = λ(x,z)". -/
def IsPrefixGraph {n : ℕ} (X : Finset (Fin n → Bool)) (G : SimpleGraph (Fin n → Bool)) :
    Prop :=
  ∀ x ∈ X, ∀ z ∈ X, x ≠ z → ∃ y ∈ X, G.Adj x y ∧ lam x y = lam x z

/-- A terminated run of the procedure of length `m` from `x̃`: `p 0 = x̃`; each move goes to
an unvisited neighbour in `X` minimizing `λ(current, ·)` among unvisited neighbours in `X`;
and at the last recorded vertex `p (m-1)` no unvisited neighbour in `X` remains. -/
def IsGreedyRun {n : ℕ} (X : Finset (Fin n → Bool)) (G : SimpleGraph (Fin n → Bool))
    (xt : Fin n → Bool) (p : ℕ → Fin n → Bool) (m : ℕ) : Prop :=
  1 ≤ m ∧ p 0 = xt ∧
    (∀ k, k + 1 < m →
      p (k + 1) ∈ X ∧ G.Adj (p k) (p (k + 1)) ∧ p (k + 1) ∉ usedUpTo p k ∧
        ∀ y ∈ X, G.Adj (p k) y → y ∉ usedUpTo p k → lam (p k) (p (k + 1)) ≤ lam (p k) y) ∧
    (∀ y ∈ X, G.Adj (p (m - 1)) y → y ∈ usedUpTo p (m - 1))

/-- `x` and `y` agree on their last `k` bits (coordinates `i` with `n - k ≤ i`). -/
def SameSuffix {n : ℕ} (k : ℕ) (x y : Fin n → Bool) : Prop :=
  ∀ i : Fin n, n - k ≤ i.val → x i = y i

/-- Genlex: for every `k ≤ n` and every suffix class, the positions `< m` whose vertex lies
in that class form an interval. -/
def IsGenlex {n : ℕ} (p : ℕ → Fin n → Bool) (m : ℕ) : Prop :=
  ∀ k, k ≤ n → ∀ i l j, i ≤ l → l ≤ j → j < m →
    SameSuffix k (p i) (p j) → SameSuffix k (p i) (p l)

/-- Hamilton path in `G[X]` given by `p 0, …, p (m-1)`. -/
def IsHamiltonPath {n : ℕ} (X : Finset (Fin n → Bool)) (G : SimpleGraph (Fin n → Bool))
    (p : ℕ → Fin n → Bool) (m : ℕ) : Prop :=
  m = X.card ∧
    (∀ i j, i < m → j < m → p i = p j → i = j) ∧
    (∀ i, i < m → p i ∈ X) ∧
    (∀ z ∈ X, ∃ i, i < m ∧ p i = z) ∧
    (∀ k, k + 1 < m → G.Adj (p k) (p (k + 1)))

/-! ## Rubric lemma stubs -/

/-- Rubric 2 (separation): within a last-bit class λ is unchanged by deleting the last bit
(and hence `≤ n`), across classes it equals `n + 1`. [TraversingCombinatorial01Polytopes, node_15] -/
theorem lam_init_of_last_eq {n : ℕ} (x y : Fin (n + 1) → Bool)
    (h : x (Fin.last n) = y (Fin.last n)) :
    lam x y = lam (Fin.init x) (Fin.init y) ∧ lam (Fin.init x) (Fin.init y) ≤ n := by
  sorry

theorem lam_of_last_ne {n : ℕ} (x y : Fin (n + 1) → Bool)
    (h : x (Fin.last n) ≠ y (Fin.last n)) :
    lam x y = n + 1 := by
  sorry

/-- Rubric 2 (recursion): each last-bit class of a prefix graph is again a prefix graph. [TraversingCombinatorial01Polytopes, node_15] -/
theorem prefixGraph_slice {n : ℕ} (X : Finset (Fin (n + 1) → Bool))
    (G : SimpleGraph (Fin (n + 1) → Bool)) (hG : IsPrefixGraph X G) (b : Bool) :
    IsPrefixGraph (X.filter (fun z => z (Fin.last n) = b)) G := by
  sorry

/-- Rubric 3 (exhaustion of the initial class): the first `|X_b|` recorded vertices are
exactly in the class `X_b` of `x̃`, and the run has at least that many vertices. [TraversingCombinatorial01Polytopes, node_15] -/
theorem initial_class_exhausted {n : ℕ} (X : Finset (Fin (n + 1) → Bool))
    (G : SimpleGraph (Fin (n + 1) → Bool)) (hG : IsPrefixGraph X G)
    (xt : Fin (n + 1) → Bool) (hxt : xt ∈ X) (p : ℕ → Fin (n + 1) → Bool) (m : ℕ)
    (hp : IsGreedyRun X G xt p m) :
    (X.filter (fun z => z (Fin.last n) = xt (Fin.last n))).card ≤ m ∧
      ∀ k, k < (X.filter (fun z => z (Fin.last n) = xt (Fin.last n))).card →
        p k (Fin.last n) = xt (Fin.last n) := by
  sorry

/-- Rubric 4 (guaranteed transition): if the opposite class is nonempty, the run does not
halt at the end of the initial class. [TraversingCombinatorial01Polytopes, node_15] -/
theorem transition_to_opposite_class {n : ℕ} (X : Finset (Fin (n + 1) → Bool))
    (G : SimpleGraph (Fin (n + 1) → Bool)) (hG : IsPrefixGraph X G)
    (xt : Fin (n + 1) → Bool) (hxt : xt ∈ X) (p : ℕ → Fin (n + 1) → Bool) (m : ℕ)
    (hp : IsGreedyRun X G xt p m)
    (hopp : (X.filter (fun z => z (Fin.last n) ≠ xt (Fin.last n))).Nonempty) :
    (X.filter (fun z => z (Fin.last n) = xt (Fin.last n))).card < m := by
  sorry

/-! ## Main theorem -/

/-- On every prefix graph, from every initial vertex and for every resolution of ties, the
greedy λ-minimizing procedure records a genlex Hamilton path of `G[X]`. [TraversingCombinatorial01Polytopes, node_15] -/
theorem greedy_prefix_graph_genlex_hamilton {n : ℕ} (X : Finset (Fin n → Bool))
    (G : SimpleGraph (Fin n → Bool)) (hG : IsPrefixGraph X G)
    (xt : Fin n → Bool) (hxt : xt ∈ X) (p : ℕ → Fin n → Bool) (m : ℕ)
    (hp : IsGreedyRun X G xt p m) :
    IsHamiltonPath X G p m ∧ IsGenlex p m := by
  sorry

