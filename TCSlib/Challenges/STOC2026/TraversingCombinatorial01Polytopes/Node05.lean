/-- Rubric 1–2 (geometric claim). Let `x ∈ Y` and `j` a coordinate. If `y ∈ Y` with
`y_j ≠ x_j` minimizes `d(x, ·)` among all points of `Y` differing from `x` at `j`, then
`[x,y]` is an edge of `conv(Y)`. Holds for every tied minimizer. [TraversingCombinatorial01Polytopes, node_05] -/
theorem minimizer_across_coordinate_is_edge {n : ℕ} (Y : Finset (Fin n → Bool))
    (x y : Fin n → Bool) (j : Fin n) (hx : x ∈ Y) (hy : y ∈ Y) (hyj : y j ≠ x j)
    (hmin : ∀ z ∈ Y, z j ≠ x j → hd x y ≤ hd x z) :
    SkeletonAdj Y x y := by
  sorry

/-- Rubric 3 (slices are faces). An edge of the coordinate slice
`conv{z ∈ X : z_i = b}` is an edge of `conv(X)`. [TraversingCombinatorial01Polytopes, node_05] -/
theorem slice_edge_is_edge {n : ℕ} (X : Finset (Fin n → Bool)) (i : Fin n) (b : Bool)
    (x y : Fin n → Bool) (h : SkeletonAdj (X.filter (fun z => z i = b)) x y) :
    SkeletonAdj X x y := by
  sorry

/-- Rubric 3 (deleting a common final coordinate preserves λ and d). [TraversingCombinatorial01Polytopes, node_05] -/
theorem lam_hd_init_of_last_eq {n : ℕ} (x y : Fin (n + 1) → Bool)
    (h : x (Fin.last n) = y (Fin.last n)) :
    lam x y = lam (Fin.init x) (Fin.init y) ∧ hd x y = hd (Fin.init x) (Fin.init y) := by
