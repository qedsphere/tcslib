/-!
## Greedy (λ, d)-traversal of a 0/1-polytope skeleton is Hamiltonian

`X ⊆ {0,1}ⁿ` is a nonempty finset of Boolean vectors, `P = conv(X)` with `X` embedded in
`ℝⁿ` by `true ↦ 1`, `false ↦ 0`. Two distinct points of `X` are adjacent in the skeleton when
`[x,y]` is an edge of `P`, i.e. some linear functional is minimized over `X` exactly at
`{x,y}`.

For distinct `x, y`, `λ(x,y)` is the largest index where they differ and `d(x,y)` their
Hamming distance. The traversal starts at any `x₁ ∈ X` and, at each step, chooses an unused
vertex lexicographically minimizing `(λ(x_k, ·), d(x_k, ·))`. Main theorem
`greedy_traversal_hamiltonian`: every such run `x₁,…,x_N` (`N = |X|`), for every start and
every tie choice, is a Hamilton path of the skeleton.

A run is a function `p : ℕ → (Fin n → Bool)`; only `p 0, …, p (N-1)` matter.
-/

namespace TCSChallenge.TraversingCombinatorial01Polytopes.node_05

/-- The set of coordinates on which `x` and `y` differ, `{i : x_i ≠ y_i}`. -/
def diffSet {n : ℕ} (x y : Fin n → Bool) : Finset (Fin n) :=
  Finset.univ.filter (fun i => x i ≠ y i)

/-- `λ(x,y) = max{i : x_i ≠ y_i}`, 1-based (so `λ ∈ {1,…,n}` for `x ≠ y`, and `0` if
`x = y`). -/
def lam {n : ℕ} (x y : Fin n → Bool) : ℕ :=
  (diffSet x y).sup (fun i => i.val + 1)

/-- Hamming distance `d(x,y) = |{i : x_i ≠ y_i}|`. -/
def hd {n : ℕ} (x y : Fin n → Bool) : ℕ :=
  (diffSet x y).card

/-- Lexicographic order on pairs of naturals: `(a,b) ≤ (c,e)` iff `a < c` or
(`a = c` and `b ≤ e`). -/
def lexLE (a b c e : ℕ) : Prop :=
  a < c ∨ (a = c ∧ b ≤ e)

/-- The 0/1 point of `ℝⁿ` corresponding to a Boolean vector. -/
def toReal {n : ℕ} (x : Fin n → Bool) (i : Fin n) : ℝ :=
  if x i then 1 else 0

/-- Value of the linear functional `c` at the 0/1 point `x`. -/
def pairing {n : ℕ} (c : Fin n → ℝ) (x : Fin n → Bool) : ℝ :=
  ∑ i, c i * toReal x i

/-- Skeleton adjacency in `conv(X)`: "distinct x,y are adjacent iff [x,y] is a
one-dimensional face of P". Encoded as: `x ≠ y`, both lie in `X`, and some linear
functional `c` attains its minimum over `X` exactly at the points `x` and `y`
(so the minimizing face of `c` on `conv X` is `conv{x,y}`). -/
def SkeletonAdj {n : ℕ} (X : Finset (Fin n → Bool)) (x y : Fin n → Bool) : Prop :=
  x ≠ y ∧ x ∈ X ∧ y ∈ X ∧
    ∃ c : Fin n → ℝ, ∀ z ∈ X,
      pairing c x ≤ pairing c z ∧ (pairing c z = pairing c x ↔ (z = x ∨ z = y))

/-- The vertices used before step `k+1`, i.e. `{x₁,…,x_{k+1}}` = `{p 0, …, p k}`. -/
def usedUpTo {n : ℕ} (p : ℕ → Fin n → Bool) (k : ℕ) : Finset (Fin n → Bool) :=
  (Finset.range (k + 1)).image p

/-- A run of the traversal of length `N = |X|`: `p 0 ∈ X`, and for each `k + 1 < N` the
next vertex `p (k+1)` is an unused vertex of `X` with
`(λ(p k, p (k+1)), d(p k, p (k+1))) = min_lex {(λ(p k, z), d(p k, z)) : z ∈ X unused}`.
Arbitrary tie choices are allowed because any such `p` counts as a run. -/
def IsGreedyTraversal {n : ℕ} (X : Finset (Fin n → Bool)) (p : ℕ → Fin n → Bool) : Prop :=
  p 0 ∈ X ∧
    ∀ k, k + 1 < X.card →
      p (k + 1) ∈ X ∧ p (k + 1) ∉ usedUpTo p k ∧
        ∀ z ∈ X, z ∉ usedUpTo p k →
          lexLE (lam (p k) (p (k + 1))) (hd (p k) (p (k + 1))) (lam (p k) z) (hd (p k) z)

/-- `p 0, …, p (X.card - 1)` is a Hamilton path in the skeleton of `conv X`:
no repetition, every vertex of `X` appears, consecutive vertices are skeleton-adjacent. -/
def IsHamiltonPathSkeleton {n : ℕ} (X : Finset (Fin n → Bool)) (p : ℕ → Fin n → Bool) :
    Prop :=
  (∀ i j, i < X.card → j < X.card → p i = p j → i = j) ∧
    (∀ z ∈ X, ∃ i, i < X.card ∧ p i = z) ∧
    (∀ i, i < X.card → p i ∈ X) ∧
    (∀ k, k + 1 < X.card → SkeletonAdj X (p k) (p (k + 1)))

