/-- Rubric 3 (vertices in different last-coordinate slices have λ = n+1, the maximum). [TraversingCombinatorial01Polytopes, node_05] -/
theorem lam_of_last_ne {n : ℕ} (x y : Fin (n + 1) → Bool)
    (h : x (Fin.last n) ≠ y (Fin.last n)) :
    lam x y = n + 1 := by
