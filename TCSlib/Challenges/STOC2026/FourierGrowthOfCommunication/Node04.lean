/-!
## Level-two Fourier growth of XOR-lifted communication protocols

Same encoding as the level-one challenge: inputs `x, y ∈ {±1}^n` are TCSlib
`BooleanAnalysis.BoolCube n = Fin n → Bool` with the sign map `boolToSign` (`true ↦ -1`),
`x ⊙ y` is coordinatewise `xor`, protocols are TCSlib
`CommunicationComplexity.Deterministic.Protocol`s with Boolean (`±1`) leaves and
`complexity` = depth. `h(z) = E[C(x,y) | x ⊙ y = z] = 2^{-n} ∑_x C(x, x ⊙ z)`, and
`ĥ(S)` is TCSlib's `fourierCoeff h S`.
The main theorem `level_two_fourier_growth` states that for `n ≥ 2`,
`L_{1,2}(h) = ∑_{i<j} |ĥ({i,j})| ≤ K d^{3/2} log^3 n` (natural log).
The standard Gaussian is built from TCSlib's `standardGaussianMeasure`.
-/

namespace TCSChallenge.FourierGrowthOfCommunication.node_04

open CommunicationComplexity.Deterministic
open BooleanAnalysis
open BooleanAnalysis.ThresholdFunctions (standardGaussianMeasure)

/-- Boolean protocols on `n`-bit inputs for both parties with `±1` (Boolean) leaf labels:
"a rooted binary tree … Each internal vertex is assigned to one of the parties, who selects
the outgoing edge using only that party's input and the preceding transcript. Each leaf is
labeled by an element of `{-1,1}`." -/
abbrev BoolProtocol (n : ℕ) := Protocol (BoolCube n) (BoolCube n) Bool

/-- `C(x,y)`: the `±1` label reached on inputs `(x,y)` (`true ↦ -1`, via `boolToSign`). -/
def outVal {n : ℕ} (P : BoolProtocol n) (x y : BoolCube n) : ℝ := boolToSign (P.run x y)

/-- `x ⊙ y`, i.e. `(x ⊙ y)_i = x_i y_i` in the `±1` encoding. -/
def odot {n : ℕ} (x y : BoolCube n) : BoolCube n := fun i => xor (x i) (y i)

/-- `h(z) = E[C(x,y) | x ⊙ y = z]` for independent uniform `x, y`; the fibre
`{(x,y) : x ⊙ y = z}` is `{(x, x ⊙ z)}`, of size `2^n`. -/
def hFun {n : ℕ} (P : BoolProtocol n) : BooleanFunc n := fun z =>
  (2 : ℝ)⁻¹ ^ n * ∑ x : BoolCube n, outVal P x (odot x z)

/-- `ĥ(S) = 2^{-n} ∑_z h(z) ∏_{i ∈ S} z_i`, i.e. TCSlib's `fourierCoeff (hFun P) S`. -/
abbrev hHat {n : ℕ} (P : BoolProtocol n) (S : Finset (Fin n)) : ℝ :=
  fourierCoeff (hFun P) S

/-- `L_{1,2}(h) = ∑_{1 ≤ i < j ≤ n} |ĥ({i,j})|`. -/
def L12 {n : ℕ} (P : BoolProtocol n) : ℝ :=
  ∑ i : Fin n, ∑ j ∈ Finset.univ.filter (fun j : Fin n => i < j), |hHat P {i, j}|

/-- Standard Gaussian measure `γ^m` on `ℝ^m`, the product of TCSlib's
`standardGaussianMeasure`. -/
abbrev stdGaussian (m : ℕ) : Measure (Fin m → ℝ) :=
  Measure.pi (fun _ : Fin m => standardGaussianMeasure)

/-- Euclidean distance on `ℝ^m` (the Pi-type norm in Mathlib is the sup norm). -/
def euclDist {m : ℕ} (a b : Fin m → ℝ) : ℝ := Real.sqrt (∑ k : Fin m, (a k - b k) ^ 2)

/-- Supplied without proof: Gaussian concentration for `1`-Lipschitz functions (Euclidean
distance): `Pr[|F(G) - E F(G)| ≥ t] ≤ 2 e^{-t²/2}`. [FourierGrowthOfCommunication, node_04] -/
theorem gaussian_lipschitz_concentration (m : ℕ) (hm : 1 ≤ m) (F : (Fin m → ℝ) → ℝ)
    (hF : ∀ a b, |F a - F b| ≤ euclDist a b) (t : ℝ) (ht : 0 ≤ t) :
    (stdGaussian m {G | t ≤ |F G - ∫ G', F G' ∂(stdGaussian m)|}).toReal
      ≤ 2 * Real.exp (-t ^ 2 / 2) := by
  sorry

/-- Combinatorial identity: `ĥ({i,j}) = E[C(x,y) x_i x_j y_i y_j]` for `i ≠ j`. [FourierGrowthOfCommunication, node_04] -/
theorem hHat_pair_eq {n : ℕ} (P : BoolProtocol n) (i j : Fin n) (hij : i ≠ j) :
    hHat P {i, j} = (2 : ℝ)⁻¹ ^ n * (2 : ℝ)⁻¹ ^ n *
      ∑ x : BoolCube n, ∑ y : BoolCube n,
        outVal P x y * boolToSign (x i) * boolToSign (x j) *
          boolToSign (y i) * boolToSign (y j) := by
  sorry

/-- Preliminary reduction (Parseval + Cauchy–Schwarz): `L_{1,2}(h) ≤ n`. [FourierGrowthOfCommunication, node_04] -/
theorem L12_le_n {n : ℕ} (P : BoolProtocol n) : L12 P ≤ n := by
  sorry

/-- Main theorem: there is a universal constant `K` such that for every `n ≥ 2` and every
deterministic protocol of depth at most `d`, `L_{1,2}(h) ≤ K d^{3/2} (log n)^3`. [FourierGrowthOfCommunication, node_04] -/
theorem level_two_fourier_growth :
    ∃ K : ℝ, ∀ (n d : ℕ), 2 ≤ n → ∀ P : BoolProtocol n, P.complexity ≤ d →
      L12 P ≤ K * (d : ℝ) ^ ((3 : ℝ) / 2) * Real.log n ^ 3 := by
  sorry

end TCSChallenge.FourierGrowthOfCommunication.node_04
