/-!
## Level-one Fourier growth of XOR-lifted communication protocols

Inputs `x, y ∈ {-1,1}^n` are encoded as `BoolCube n = Fin n → Bool` with `true ↦ -1`,
`false ↦ 1` (TCSlib's `boolToSign`). Under this encoding the coordinatewise product `x ⊙ y`
is the coordinatewise `xor`. A deterministic protocol of depth `≤ d` is a TCSlib
`CommunicationComplexity.Deterministic.Protocol` with `complexity ≤ d` and Boolean leaves
(read as `±1` via `boolToSign`). For uniform independent `x, y`,
`h(z) = E[C(x,y) | x ⊙ y = z] = 2^{-n} ∑_x C(x, x ⊙ z)`, since each `z` has exactly `2^n`
preimages. Its Fourier coefficients are TCSlib's `fourierCoeff` (uniform normalisation).
The main theorem `level_one_fourier_growth` states that
`L_{1,1}(h) = ∑_i |ĥ({i})| ≤ K √d` for an absolute constant `K`.
-/

namespace TCSChallenge.FourierGrowthOfCommunication.node_03

open CommunicationComplexity.Deterministic
open BooleanAnalysis BooleanAnalysis.ThresholdFunctions

/-- Boolean protocols on `n`-bit inputs for both parties with `±1` (Boolean) leaf labels:
"a rooted binary tree … Each internal vertex is assigned to one of the parties, who selects
the outgoing edge using only that party's input and the preceding transcript. Each leaf is
labeled by an element of `{-1,1}`." -/
abbrev BoolProtocol (n : ℕ) := Protocol (BoolCube n) (BoolCube n) Bool

/-- `C(x,y)`: the `±1` label reached on inputs `(x,y)`. -/
def outVal {n : ℕ} (P : BoolProtocol n) (x y : BoolCube n) : ℝ := boolToSign (P.run x y)

/-- `x ⊙ y`, i.e. `(x ⊙ y)_i = x_i y_i` in the `±1` encoding. -/
def odot {n : ℕ} (x y : BoolCube n) : BoolCube n := fun i => xor (x i) (y i)

/-- `h(z) = E[C(x,y) | x ⊙ y = z]` for independent uniform `x, y`; the fibre
`{(x,y) : x ⊙ y = z}` is `{(x, x ⊙ z)}`, of size `2^n`. -/
def hFun {n : ℕ} (P : BoolProtocol n) : BooleanFunc n := fun z =>
  (2 : ℝ)⁻¹ ^ n * ∑ x : BoolCube n, outVal P x (odot x z)

/-- `L_{1,1}(h) = ∑_{i=1}^n |ĥ({i})|`, with `ĥ(S) = fourierCoeff h S
= 2^{-n} ∑_z h(z) ∏_{i ∈ S} z_i`. -/
def L11 {n : ℕ} (P : BoolProtocol n) : ℝ :=
  ∑ i : Fin n, |fourierCoeff (hFun P) {i}|

/-- Standard Gaussian measure `γ^n` on `ℝ^n`. -/
abbrev stdGaussian (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi (fun _ : Fin n => standardGaussianMeasure)

/-- Sign pattern of a real vector (`true` iff the coordinate is negative), so that
`boolToSign (signVec G i) = sgn G_i` almost surely. -/
def signVec {n : ℕ} (G : Fin n → ℝ) : BoolCube n := fun i => decide (G i < 0)

/-- Combinatorial identity: `ĥ({i}) = E[C(x,y) x_i y_i]` for uniform independent `x, y`. [FourierGrowthOfCommunication, node_03] -/
theorem hHat_singleton_eq {n : ℕ} (P : BoolProtocol n) (i : Fin n) :
    fourierCoeff (hFun P) {i} = (2 : ℝ)⁻¹ ^ n * (2 : ℝ)⁻¹ ^ n *
      ∑ x : BoolCube n, ∑ y : BoolCube n,
        outVal P x y * boolToSign (x i) * boolToSign (y i) := by
  sorry

/-- Rubric 1 (Fourier-to-Gaussian reduction):
`ĥ({i}) = (π/2) E[C(sgn G, sgn H) G_i H_i]` for independent standard Gaussians `G, H`. [FourierGrowthOfCommunication, node_03] -/
theorem hHat_singleton_gaussian {n : ℕ} (P : BoolProtocol n) (i : Fin n) :
    fourierCoeff (hFun P) {i} = (Real.pi / 2) *
      ∫ GH, outVal P (signVec GH.1) (signVec GH.2) * GH.1 i * GH.2 i
        ∂((stdGaussian n).prod (stdGaussian n)) := by
  sorry

/-- Gaussian centroid bound (9): for a set `E` of positive Gaussian measure, its conditional
mean `m = γ(E)⁻¹ ∫_E z dγ` satisfies `‖m‖² ≤ 2 log(1/γ(E))` (Euclidean norm). [FourierGrowthOfCommunication, node_03] -/
theorem gaussian_centroid_bound {n : ℕ} (E : Set (Fin n → ℝ)) (hE : MeasurableSet E)
    (hpos : 0 < (stdGaussian n E).toReal) :
    ∑ j : Fin n, ((stdGaussian n E).toReal⁻¹ * ∫ z in E, z j ∂(stdGaussian n)) ^ 2
      ≤ 2 * Real.log (1 / (stdGaussian n E).toReal) := by
  sorry

/-- Main theorem: there is an absolute constant `K` such that every deterministic protocol
of depth at most `d` on `n ≥ 1` input bits per party has `L_{1,1}(h) ≤ K √d`. [FourierGrowthOfCommunication, node_03] -/
theorem level_one_fourier_growth :
    ∃ K : ℝ, ∀ (n d : ℕ), 1 ≤ n → ∀ P : BoolProtocol n, P.complexity ≤ d →
      L11 P ≤ K * Real.sqrt d := by
  sorry

end TCSChallenge.FourierGrowthOfCommunication.node_03
