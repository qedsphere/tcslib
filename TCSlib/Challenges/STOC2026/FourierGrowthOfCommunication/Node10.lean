/-!
## Tail bound for a sum of squared orthonormal off-diagonal Gaussian quadratic forms

Let `M_1, …, M_m ∈ ℝ^{n×n}` have zero diagonal and be Frobenius-orthonormal (no symmetry).
With `(x^{•⊗}x)_{ab} = x_a x_b` for `a ≠ b` and `0` on the diagonal, and `X ∼ γ^n`, the main
theorem `orthonormal_quadratic_tail` states: there is an absolute `c > 0` such that for every
`r ≥ 98 m`,
`Pr[∑_i ⟨X^{•⊗}X, M_i⟩_F² ≥ r] ≤ exp(-c r / (m + √r))`.
Matrices are modelled as `Fin n → Fin n → ℝ`.
-/

namespace TCSChallenge.FourierGrowthOfCommunication.node_10

/-- Standard Gaussian measure `γ^n` on `ℝ^n`, the product of TCSlib's
`standardGaussianMeasure` (`= gaussianReal 0 1`). -/
abbrev stdGaussian (n : ℕ) : Measure (Fin n → ℝ) :=
  Measure.pi fun _ : Fin n => standardGaussianMeasure

/-- Euclidean norm on `ℝ^n` (the Pi-type norm in Mathlib is the sup norm). -/
def euclNorm {n : ℕ} (z : Fin n → ℝ) : ℝ := Real.sqrt (∑ a : Fin n, z a ^ 2)

/-- Frobenius inner product `⟨A,B⟩_F = ∑_{a,b} A_{ab} B_{ab}`. -/
def frob {n : ℕ} (A B : Fin n → Fin n → ℝ) : ℝ := ∑ a : Fin n, ∑ b : Fin n, A a b * B a b

/-- The off-diagonal tensor square `(x^{•⊗}x)_{ab} = x_a x_b` (`a ≠ b`), `0` (`a = b`). -/
def offDiagSq {n : ℕ} (x : Fin n → ℝ) : Fin n → Fin n → ℝ :=
  fun a b => if a = b then 0 else x a * x b

/-- Hypotheses: every `M_i` has zero diagonal, and the family is Frobenius-orthonormal. -/
def ZeroDiagOrthonormal {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ) : Prop :=
  (∀ i a, M i a a = 0) ∧ ∀ i j, frob (M i) (M j) = if i = j then 1 else 0

/-- The random variable `K(x) = ∑_i ⟨x^{•⊗}x, M_i⟩_F²`. -/
def quadEnergy {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ) (x : Fin n → ℝ) : ℝ :=
  ∑ i : Fin m, frob (offDiagSq x) (M i) ^ 2

/-- `T(U) = (⟨U, M_i⟩_F)_i`, as its Euclidean norm `‖T(U)‖₂`. -/
def Tnorm {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ) (U : Fin n → Fin n → ℝ) : ℝ :=
  Real.sqrt (∑ i : Fin m, frob U (M i) ^ 2)

/-- The rank-one matrix `u ⊗ v = u vᵀ`. -/
def outer {n : ℕ} (u v : Fin n → ℝ) : Fin n → Fin n → ℝ := fun a b => u a * v b

/-- `f(y) = ‖T(y ⊗ y)‖₂` (equal to `√K(y)` under zero diagonal). -/
def fCtrl {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ) (y : Fin n → ℝ) : ℝ :=
  Tnorm M (outer y y)

/-- `g(y) = sup_{‖z‖₂ = 1} ‖T(z ⊗ y)‖₂`. -/
def gCtrl {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ) (y : Fin n → ℝ) : ℝ :=
  ⨆ z : {z : Fin n → ℝ // euclNorm z = 1}, Tnorm M (outer z.1 y)

/-- `h(y) = sup_{‖z‖₂ = 1} ‖T(y ⊗ z)‖₂`. -/
def hCtrl {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ) (y : Fin n → ℝ) : ℝ :=
  ⨆ z : {z : Fin n → ℝ // euclNorm z = 1}, Tnorm M (outer y z.1)

/-- Rubric 1: Bessel, `‖T(U)‖₂ ≤ ‖U‖_F`. [FourierGrowthOfCommunication, node_10] -/
theorem Tnorm_le_frob {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ)
    (hM : ZeroDiagOrthonormal M) (U : Fin n → Fin n → ℝ) :
    Tnorm M U ≤ Real.sqrt (frob U U) := by
  sorry

/-- Rubric 1: `E f(X) ≤ √(2m)`. [FourierGrowthOfCommunication, node_10] -/
theorem integral_fCtrl_le {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ)
    (hM : ZeroDiagOrthonormal M) :
    ∫ x, fCtrl M x ∂(stdGaussian n) ≤ Real.sqrt (2 * m) := by
  sorry

/-- Rubric 2: `E g(X) ≤ √m` and `E h(X) ≤ √m`. [FourierGrowthOfCommunication, node_10] -/
theorem integral_gCtrl_hCtrl_le {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ)
    (hM : ZeroDiagOrthonormal M) :
    ∫ x, gCtrl M x ∂(stdGaussian n) ≤ Real.sqrt m ∧
      ∫ x, hCtrl M x ∂(stdGaussian n) ≤ Real.sqrt m := by
  sorry

/-- Rubric 3: the set `A = {f < 6√(2m), g < 6√m, h < 6√m}` has Gaussian measure `≥ 1/2`. [FourierGrowthOfCommunication, node_10] -/
theorem measure_goodSet_ge_half {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ)
    (hM : ZeroDiagOrthonormal M) :
    (1 / 2 : ℝ) ≤ (stdGaussian n {y | fCtrl M y < 6 * Real.sqrt (2 * m) ∧
      gCtrl M y < 6 * Real.sqrt m ∧ hCtrl M y < 6 * Real.sqrt m}).toReal := by
  sorry

/-- Rubric 4: perturbation estimate on the enlargement `A + t B₂ⁿ`. [FourierGrowthOfCommunication, node_10] -/
theorem fCtrl_perturb {n m : ℕ} (M : Fin m → Fin n → Fin n → ℝ)
    (hM : ZeroDiagOrthonormal M) (t : ℝ) (ht : 0 ≤ t) (y z : Fin n → ℝ)
    (hy : fCtrl M y < 6 * Real.sqrt (2 * m) ∧ gCtrl M y < 6 * Real.sqrt m ∧
      hCtrl M y < 6 * Real.sqrt m)
    (hz : euclNorm z ≤ 1) :
    fCtrl M (y + t • z) < 6 * Real.sqrt (2 * m) + 12 * t * Real.sqrt m + t ^ 2 := by
  sorry

/-- Rubric 5 (Gaussian isoperimetry, usable): if `γ(A) ≥ 1/2` then the complement of the
Euclidean `t`-enlargement of `A` has measure at most `e^{-t²/2}`. [FourierGrowthOfCommunication, node_10] -/
theorem gaussian_isoperimetric_tail {n : ℕ} (A : Set (Fin n → ℝ)) (hA : MeasurableSet A)
    (hhalf : (1 / 2 : ℝ) ≤ (stdGaussian n A).toReal) (t : ℝ) (ht : 0 ≤ t) :
    (stdGaussian n {x | ∀ y ∈ A, t < euclNorm (x - y)}).toReal ≤ Real.exp (-t ^ 2 / 2) := by
  sorry

/-- Main theorem: there is an absolute `c > 0` such that for all positive `n, m`, all
zero-diagonal Frobenius-orthonormal `M_1, …, M_m`, and all `r ≥ 98 m`,
`Pr[∑_i ⟨X^{•⊗}X, M_i⟩_F² ≥ r] ≤ exp(-c r / (m + √r))`. [FourierGrowthOfCommunication, node_10] -/
theorem orthonormal_quadratic_tail :
    ∃ c : ℝ, 0 < c ∧ ∀ (n m : ℕ), 1 ≤ n → 1 ≤ m →
      ∀ M : Fin m → Fin n → Fin n → ℝ, ZeroDiagOrthonormal M →
      ∀ r : ℝ, 98 * (m : ℝ) ≤ r →
        (stdGaussian n {x | r ≤ quadEnergy M x}).toReal
          ≤ Real.exp (-c * r / ((m : ℝ) + Real.sqrt r)) := by
  sorry

end TCSChallenge.FourierGrowthOfCommunication.node_10
