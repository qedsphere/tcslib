/-!
## Permutation challenge games vs. the middle game

A permutation challenge game `PC(N, 𝒟, ℳ, tr, post, suc)` samples a uniform permutation Σ of
`[N]` and an independent uniform secret `D ∈ 𝒟`. An outer query `m` is answered by
`post(D, Σ(tr(D, m)))`, and `tr` is `u`-uniform. A non-adaptive preprocessing algorithm
`(A₀, A₁)` computes advice `Z = A₀(Σ)` with at most `2^S` values. Then, depending only on `Z`,
it makes `T₁` direct permutation queries and `T₂` outer queries, with `T₁ + T₂ ≤ T`.

The middle game `MID` lets a preprocessing adversary fix at most `T₁` input/output constraints
`(I, O)`. Σ is then uniform among the permutations consistent with them, and the online adversary
makes at most `T₂` outer queries. `MaxS T` is the supremum of middle-game success probabilities.

Main theorem `pPC_le_min`:
`p_PC ≤ min (2·MaxS(T) + 4 ln2·S·T/u, MaxS(T) + √(ln2·S·T/u))`.

Lemma stubs follow the proof plan:
* the uniform-completion comparison experiment is realised by a middle-game adversary;
* the true success decomposes into conditional successes under the posterior;
* the secret-indexed success functions form a read-`k` family with `k ≤ T₂|𝒟|/u`;
* a Shearer-like KL inequality for random bijections (factor `2k/n`);
* the conditional linear and square-root comparisons;
* the averaged posterior divergence is at most `S ln 2`.
-/

namespace TCSChallenge.NonAdaptiveCryptanalyticTime.node_21

/-- Permutations of `[N]`, modelled as `Fin N`. -/
abbrev Perm (N : ℕ) := Equiv.Perm (Fin N)

/-- A permutation challenge game: maps `tr : 𝒟 × ℳ → [N]` and `post : 𝒟 × [N] → [N]`
together with a success predicate `suc` on (secret, final output). -/
structure PCGame (N : ℕ) (Dsec Msg Ans : Type) where
  tr : Dsec → Msg → Fin N
  post : Dsec → Fin N → Fin N
  suc : Dsec → Ans → Bool

/-- "`tr` is `u`-uniform: for every `m ∈ ℳ` and `j ∈ [N]`,
`|{d ∈ 𝒟 : tr(d,m) = j}| ≤ |𝒟|/u`." -/
def IsUUniform {N : ℕ} {Dsec Msg Ans : Type} [Fintype Dsec]
    (G : PCGame N Dsec Msg Ans) (u : ℝ) : Prop :=
  ∀ (m : Msg) (j : Fin N),
    ((univ.filter fun d : Dsec => G.tr d m = j).card : ℝ) ≤ (Fintype.card Dsec : ℝ) / u

/-- Answers to a list of outer queries `q` under secret `d` and permutation `σ`:
"an outer query `m` is answered by `post(D, Σ(tr(D, m)))`". -/
def outerAnswers {N k : ℕ} {Dsec Msg Ans : Type} (G : PCGame N Dsec Msg Ans)
    (d : Dsec) (σ : Perm N) (q : Fin k → Msg) : Fin k → Fin N :=
  fun i => G.post d (σ (G.tr d (q i)))

/-- A deterministic non-adaptive preprocessing algorithm `(A₀, A₁)`. `A₀` maps the permutation
to advice. Given the advice, `A₁` fixes `T₁` direct queries `dq z` and `T₂` outer queries
`oq z` (repetitions allowed, so "at most"), then outputs from the answers. -/
structure NAAlg (N T1 T2 : ℕ) (Adv Msg Ans : Type) where
  A0 : Perm N → Adv
  dq : Adv → Fin T1 → Fin N
  oq : Adv → Fin T2 → Msg
  out : Adv → (Fin T1 → Fin N) → (Fin T2 → Fin N) → Ans

/-- The direct-query input set `𝒮(z) ⊆ [N]`. -/
def dqSet {N T1 T2 : ℕ} {Adv Msg Ans : Type} (A : NAAlg N T1 T2 Adv Msg Ans) (z : Adv) :
    Finset (Fin N) :=
  univ.image (A.dq z)

/-- Whether `A₁` (run with advice `z` fixed) succeeds against permutation `τ` and secret `d`. -/
def fixedRun {N T1 T2 : ℕ} {Dsec Msg Ans Adv : Type} (G : PCGame N Dsec Msg Ans)
    (A : NAAlg N T1 T2 Adv Msg Ans) (z : Adv) (τ : Perm N) (d : Dsec) : Bool :=
  G.suc d (A.out z (fun i => τ (A.dq z i)) (outerAnswers G d τ (A.oq z)))

/-- `p_PC`: success probability of `(A₀, A₁)` over uniform Σ and uniform `D`. -/
def pPC {N T1 T2 : ℕ} {Dsec Msg Ans Adv : Type} [Fintype Dsec]
    (G : PCGame N Dsec Msg Ans) (A : NAAlg N T1 T2 Adv Msg Ans) : ℝ :=
  (1 / (Fintype.card (Perm N) : ℝ)) * ∑ σ : Perm N,
    (1 / (Fintype.card Dsec : ℝ)) * ∑ d : Dsec,
      (if fixedRun G A (A.A0 σ) σ d then (1 : ℝ) else 0)

/-- `τ` agrees with `σ` on the set `s`. -/
def Agree {N : ℕ} (s : Finset (Fin N)) (σ τ : Perm N) : Prop := ∀ j ∈ s, σ j = τ j

/-- Completions of the partial bijection `σ|_s`: all permutations agreeing with `σ` on `s`. -/
def completions {N : ℕ} (s : Finset (Fin N)) (σ : Perm N) : Finset (Perm N) :=
  univ.filter fun τ => Agree s σ τ

/-- Uniform law on the completions of `σ|_s` ("a uniformly random bijection consistent with
the fixed direct-query values"). -/
def uniformCompletion {N : ℕ} (s : Finset (Fin N)) (σ : Perm N) : Perm N → ℝ :=
  fun τ => if τ ∈ completions s σ then 1 / ((completions s σ).card : ℝ) else 0

/-- Posterior law of Σ given `(Z, Σ^in) = (A₀ σ₀, σ₀|_{𝒮(A₀ σ₀)})`, under uniform Σ. -/
def posterior {N T1 T2 : ℕ} {Adv Msg Ans : Type} (A : NAAlg N T1 T2 Adv Msg Ans)
    (σ0 : Perm N) : Perm N → ℝ :=
  fun τ =>
    if A.A0 τ = A.A0 σ0 ∧ Agree (dqSet A (A.A0 σ0)) σ0 τ then
      1 / ((univ.filter fun τ' : Perm N =>
              A.A0 τ' = A.A0 σ0 ∧ Agree (dqSet A (A.A0 σ0)) σ0 τ').card : ℝ)
    else 0

/-- Conditional success of `A₁` with advice `z` fixed when Σ is drawn from `law`
(averaged over the uniform secret). -/
def condSuccess {N T1 T2 : ℕ} {Dsec Msg Ans Adv : Type} [Fintype Dsec]
    (G : PCGame N Dsec Msg Ans) (A : NAAlg N T1 T2 Adv Msg Ans) (z : Adv)
    (law : Perm N → ℝ) : ℝ :=
  (1 / (Fintype.card Dsec : ℝ)) * ∑ d : Dsec, ∑ τ : Perm N,
    law τ * (if fixedRun G A z τ d then (1 : ℝ) else 0)

/-- Comparison experiment: same law of `(Z, Σ^in)`, but `Σ^rem` is replaced by a uniform
completion of the direct-query values. -/
def compSuccess {N T1 T2 : ℕ} {Dsec Msg Ans Adv : Type} [Fintype Dsec]
    (G : PCGame N Dsec Msg Ans) (A : NAAlg N T1 T2 Adv Msg Ans) : ℝ :=
  (1 / (Fintype.card (Perm N) : ℝ)) * ∑ σ0 : Perm N,
    condSuccess G A (A.A0 σ0) (uniformCompletion (dqSet A (A.A0 σ0)) σ0)

/-! ### The middle game -/

/-- A middle-game adversary with shared uniform randomness `ρ ∈ Fin r`: preprocessing outputs
constraints `cons ρ` (pairs `(I, O)`), and the online stage makes `k2` outer queries `oq ρ`
and outputs `out ρ answers`. Its dependence on `ρ` covers "knowing `(I,O)` and sharing
randomness with `Â₀`". -/
structure MidAdv (N k2 r : ℕ) (Msg Ans : Type) where
  cons : Fin r → Finset (Fin N × Fin N)
  oq : Fin r → Fin k2 → Msg
  out : Fin r → (Fin k2 → Fin N) → Ans

/-- "At most `k1` distinct input-output constraints", which must form a partial injection. -/
def ValidConstraints {N : ℕ} (k1 : ℕ) (C : Finset (Fin N × Fin N)) : Prop :=
  C.card ≤ k1 ∧ ∀ p ∈ C, ∀ q ∈ C, (p.1 = q.1 ↔ p.2 = q.2)

/-- Permutations satisfying all constraints in `C`. -/
def consistentPerms {N : ℕ} (C : Finset (Fin N × Fin N)) : Finset (Perm N) :=
  univ.filter fun σ => ∀ p ∈ C, σ p.1 = p.2

/-- Success probability in `MID`: uniform `ρ`, uniform secret, Σ uniform among permutations
consistent with the constraints. -/
def midSuccess {N k2 r : ℕ} {Dsec Msg Ans : Type} [Fintype Dsec]
    (G : PCGame N Dsec Msg Ans) (B : MidAdv N k2 r Msg Ans) : ℝ :=
  (1 / (r : ℝ)) * ∑ ρ : Fin r, (1 / (Fintype.card Dsec : ℝ)) * ∑ d : Dsec,
    (1 / ((consistentPerms (B.cons ρ)).card : ℝ)) *
      ∑ σ ∈ consistentPerms (B.cons ρ),
        (if G.suc d (B.out ρ (outerAnswers G d σ (B.oq ρ))) then (1 : ℝ) else 0)

/-- `\widehat{MaxS}(T)`: supremum of middle-game success over adversaries with
`k1` constraints and `k2` outer queries, `k1 + k2 ≤ T`. -/
def MaxS {N : ℕ} {Dsec Msg Ans : Type} [Fintype Dsec] (G : PCGame N Dsec Msg Ans) (T : ℕ) : ℝ :=
  sSup {q : ℝ | ∃ (k1 k2 r : ℕ) (B : MidAdv N k2 r Msg Ans),
    k1 + k2 ≤ T ∧ 0 < r ∧ (∀ ρ, ValidConstraints k1 (B.cons ρ)) ∧ q = midSuccess G B}

/-! ### KL divergence for finite laws -/

/-- `D_KL(R ‖ W) = ∑_{x : R(x) > 0} R(x) log(R(x)/W(x))` (natural log). Only used where
`R ≪ W`; Lean's `log 0 = 0` would otherwise make the value wrong. -/
def klDiv {Ω : Type} [Fintype Ω] (R W : Ω → ℝ) : ℝ :=
  ∑ x ∈ univ.filter (fun x => 0 < R x), R x * Real.log (R x / W x)

/-- Bernoulli law of mean `a`. -/
def bern (a : ℝ) : Bool → ℝ := fun b => if b then a else 1 - a

/-- `D_KL(Ber(a) ‖ Ber(b))`. -/
def klBer (a b : ℝ) : ℝ := klDiv (bern a) (bern b)

/-- Average success of the family `f` under law `P`: `(1/|Idx|) ∑_i E_P[f_i]`. -/
def avgSucc {N : ℕ} {Idx : Type} [Fintype Idx] (f : Idx → Perm N → Bool)
    (P : Perm N → ℝ) : ℝ :=
  (1 / (Fintype.card Idx : ℝ)) * ∑ i : Idx, ∑ τ : Perm N,
    P τ * (if f i τ then (1 : ℝ) else 0)

/-! ### Lemma stubs -/

/-- Comparison and middle-game simulation: the uniform-completion experiment is exactly the
success of a legal middle-game adversary with `T₁` constraints and `T₂` outer queries. Its
randomness is an auxiliary uniform permutation σ'; the constraints are
`{(s, σ' s) : s ∈ 𝒮(A₀ σ')}`. [NonAdaptiveCryptanalyticTime, node_21] -/
theorem compSuccess_realized_in_mid {N T1 T2 : ℕ} {Dsec Msg Ans Adv : Type} [Fintype Dsec]
    (G : PCGame N Dsec Msg Ans) (A : NAAlg N T1 T2 Adv Msg Ans) :
    ∃ (r : ℕ) (B : MidAdv N T2 r Msg Ans), 0 < r ∧
      (∀ ρ, ValidConstraints T1 (B.cons ρ)) ∧ midSuccess G B = compSuccess G A := by
  sorry

/-- Hence the comparison success is at most `\widehat{MaxS}(T)` whenever `T₁ + T₂ ≤ T`. [NonAdaptiveCryptanalyticTime, node_21] -/
theorem compSuccess_le_MaxS {N T1 T2 T : ℕ} {Dsec Msg Ans Adv : Type} [Fintype Dsec]
    [Nonempty Dsec] (G : PCGame N Dsec Msg Ans) (A : NAAlg N T1 T2 Adv Msg Ans)
    (hT : T1 + T2 ≤ T) :
    compSuccess G A ≤ MaxS G T := by
  sorry

/-- Decomposition of the true success over `(Z, Σ^in)`: `p_PC` is the average conditional
success under the posterior law. [NonAdaptiveCryptanalyticTime, node_21] -/
theorem pPC_eq_avg_posterior {N T1 T2 : ℕ} {Dsec Msg Ans Adv : Type} [Fintype Dsec]
    (G : PCGame N Dsec Msg Ans) (A : NAAlg N T1 T2 Adv Msg Ans) :
    pPC G A = (1 / (Fintype.card (Perm N) : ℝ)) * ∑ σ0 : Perm N,
      condSuccess G A (A.A0 σ0) (posterior A σ0) := by
  sorry

/-- Localization and read bound: with `(Z, Σ^in)` fixed, the success indicator for secret `d`
depends only on the coordinates `J d = {tr(d, oq z i)}`, and each coordinate is read by at most
`T₂|𝒟|/u` secrets. [NonAdaptiveCryptanalyticTime, node_21] -/
theorem readK_of_uUniform {N T1 T2 : ℕ} {Dsec Msg Ans Adv : Type} [Fintype Dsec]
    (G : PCGame N Dsec Msg Ans) (A : NAAlg N T1 T2 Adv Msg Ans) (u : ℝ) (hu : 0 < u)
    (hunif : IsUUniform G u) (σ0 : Perm N) :
    let z := A.A0 σ0
    let J : Dsec → Finset (Fin N) := fun d => univ.image (fun i => G.tr d (A.oq z i))
    (∀ (d : Dsec) (τ τ' : Perm N), τ ∈ completions (dqSet A z) σ0 →
        τ' ∈ completions (dqSet A z) σ0 → (∀ j ∈ J d, τ j = τ' j) →
        fixedRun G A z τ d = fixedRun G A z τ' d) ∧
    (∀ j : Fin N, ((univ.filter fun d : Dsec => j ∈ J d).card : ℝ) ≤
        (T2 : ℝ) * (Fintype.card Dsec : ℝ) / u) := by
  sorry

/-- Shearer-like read-`k` inequality for random bijections. On the completions of a fixed
partial bijection `σ₀|_s`, let `f_i` (`i` in an `n`-element index set) each depend only on the
coordinates `J i`, with every free coordinate read by at most `k` of the `f_i`. Then for every
law `P` on the completions, `D_KL(Ber(E_P f̄) ‖ Ber(E_U f̄)) ≤ (2k/n) D_KL(P ‖ U)`, where `U`
is the uniform completion. [NonAdaptiveCryptanalyticTime, node_21] -/
theorem shearer_like_readK {N : ℕ} {Idx : Type} [Fintype Idx] [Nonempty Idx]
    (s : Finset (Fin N)) (σ0 : Perm N) (f : Idx → Perm N → Bool) (J : Idx → Finset (Fin N))
    (k : ℝ)
    (hdep : ∀ (i : Idx) (τ τ' : Perm N), τ ∈ completions s σ0 → τ' ∈ completions s σ0 →
      (∀ j ∈ J i, τ j = τ' j) → f i τ = f i τ')
    (hread : ∀ j : Fin N, j ∉ s → ((univ.filter fun i : Idx => j ∈ J i).card : ℝ) ≤ k)
    (P : Perm N → ℝ) (hP0 : ∀ τ, 0 ≤ P τ) (hP1 : ∑ τ, P τ = 1)
    (hPsupp : ∀ τ, τ ∉ completions s σ0 → P τ = 0) :
    klBer (avgSucc f P) (avgSucc f (uniformCompletion s σ0)) ≤
      (2 * k / (Fintype.card Idx : ℝ)) * klDiv P (uniformCompletion s σ0) := by
  sorry

/-- Conditional comparisons (after the Bernoulli conversions `a ≤ 2(b+δ)` and
`a ≤ b + √(δ/2)`): for every conditioning value, the true conditional success `a` and the
uniform-completion success `b` satisfy `a ≤ 2b + (4T₂/u)·KL` and `a ≤ b + √((T₂/u)·KL)`. [NonAdaptiveCryptanalyticTime, node_21] -/
theorem conditional_comparison {N T1 T2 : ℕ} {Dsec Msg Ans Adv : Type} [Fintype Dsec]
    [Nonempty Dsec] (G : PCGame N Dsec Msg Ans) (A : NAAlg N T1 T2 Adv Msg Ans) (u : ℝ)
    (hu : 0 < u) (hunif : IsUUniform G u) (σ0 : Perm N) :
    let z := A.A0 σ0
    let a := condSuccess G A z (posterior A σ0)
    let b := condSuccess G A z (uniformCompletion (dqSet A z) σ0)
    let δ := klDiv (posterior A σ0) (uniformCompletion (dqSet A z) σ0)
    a ≤ 2 * b + 4 * (T2 : ℝ) / u * δ ∧ a ≤ b + Real.sqrt ((T2 : ℝ) / u * δ) := by
  sorry

/-- Global information accounting: averaged over uniform Σ, the divergence between the
posterior of Σ given `(Z, Σ^in)` and the uniform completion is at most
`I(Σ; Z) ≤ H(Z) ≤ S ln 2`. This is an average bound, not a bound for every advice value. [NonAdaptiveCryptanalyticTime, node_21] -/
theorem avg_posterior_divergence_le {N T1 T2 S : ℕ} {Msg Ans Adv : Type}
    (A : NAAlg N T1 T2 Adv Msg Ans) (hS : (univ.image A.A0).card ≤ 2 ^ S) :
    (1 / (Fintype.card (Perm N) : ℝ)) * ∑ σ0 : Perm N,
      klDiv (posterior A σ0) (uniformCompletion (dqSet A (A.A0 σ0)) σ0)
      ≤ (S : ℝ) * Real.log 2 := by
  sorry

/-! ### Main theorem -/

/-- **Non-adaptive permutation challenge games reduce to the middle game.**
`p_PC ≤ min(2·MaxS(T) + 4 ln2·S·T/u, MaxS(T) + √(ln2·S·T/u))`. [NonAdaptiveCryptanalyticTime, node_21] -/
theorem pPC_le_min {N T1 T2 T S : ℕ} {Dsec Msg Ans Adv : Type} [Fintype Dsec] [Nonempty Dsec]
    (G : PCGame N Dsec Msg Ans) (u : ℝ) (hu : 0 < u) (hunif : IsUUniform G u)
    (A : NAAlg N T1 T2 Adv Msg Ans) (hT : T1 + T2 ≤ T)
    (hS : (univ.image A.A0).card ≤ 2 ^ S) :
    pPC G A ≤ min
      (2 * MaxS G T + 4 * Real.log 2 * (S : ℝ) * (T : ℝ) / u)
      (MaxS G T + Real.sqrt (Real.log 2 * (S : ℝ) * (T : ℝ) / u)) := by
  sorry

end TCSChallenge.NonAdaptiveCryptanalyticTime.node_21
