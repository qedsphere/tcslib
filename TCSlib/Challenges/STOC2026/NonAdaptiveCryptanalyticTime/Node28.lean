/-!
## Exact simulation of the constrained-permutation game

A secret `D ∼ μ` and a uniform permutation `Σ` of `[N]` are independent. Inner query `x`
returns `Σ(x)`, outer query `m` returns `Σ(tr(D,m))`. `MaxS(T)` is the best success
probability of non-preprocessing, non-adaptive algorithms with `≤ T` queries;
`\widehat{MaxS}(T)` is the best success in the game where the oracle is a uniform
permutation `Τ` constrained by `Τ(I_j) = O_j` and the second stage makes only outer queries.

Claims: every constrained strategy is exactly simulated (same budget, same success) by an
ordinary non-adaptive algorithm (`simulation`), so `\widehat{MaxS}(T) ≤ MaxS(T)`
(`maxSHat_le_maxS`), and plugging into the supplied preprocessing estimate gives the bound
with `MaxS` (main theorem `preprocessing_bound_maxS`).
-/

namespace TCSChallenge.NonAdaptiveCryptanalyticTime.node_28

/-- A non-preprocessing, non-adaptive algorithm: `t1` inner and `t2` outer queries fixed in
advance, and an answer computed from the responses. -/
structure NonAdaptiveAlg (N : ℕ) (M Ans : Type) where
  t1 : ℕ
  t2 : ℕ
  inner : Fin t1 → Fin N
  outer : Fin t2 → M
  answer : (Fin t1 → Fin N) → (Fin t2 → Fin N) → Ans

/-- Success probability `Pr_{D,Σ}[suc(D, a)]` in the original game. -/
def successProb {N : ℕ} {D M Ans : Type} [Fintype D] (μ : FinDist D) (tr : D → M → Fin N)
    (suc : D → Ans → Prop) (A : NonAdaptiveAlg N M Ans) : ℝ :=
  ∑ d, ∑ σ : Equiv.Perm (Fin N),
    μ d / (Fintype.card (Equiv.Perm (Fin N)) : ℝ) *
      (if suc d (A.answer (fun j => σ (A.inner j)) (fun i => σ (tr d (A.outer i))))
        then 1 else 0)

/-- `MaxS(T)`: supremum success over non-preprocessing non-adaptive algorithms with at most
`T` queries in total. -/
def maxS {N : ℕ} {D M Ans : Type} [Fintype D] (μ : FinDist D) (tr : D → M → Fin N)
    (suc : D → Ans → Prop) (T : ℕ) : ℝ :=
  sSup {p : ℝ | ∃ A : NonAdaptiveAlg N M Ans, A.t1 + A.t2 ≤ T ∧ successProb μ tr suc A = p}

/-- A strategy in the constrained-permutation game: first stage tuples `I, O` of length
`t1`, then `t2` outer queries chosen (after seeing `I, O`) before any response, and an
answer computed from the responses `Τ(tr(D, m_i))`. -/
structure ConstrainedStrategy (N : ℕ) (M Ans : Type) where
  t1 : ℕ
  t2 : ℕ
  I : Fin t1 → Fin N
  O : Fin t1 → Fin N
  outer : Fin t2 → M
  answer : (Fin t2 → Fin N) → Ans

/-- No repetitions within `I` or `O`, and `T_1 + T_2 ≤ T`. -/
def ConstrainedStrategy.Valid {N : ℕ} {M Ans : Type} (B : ConstrainedStrategy N M Ans)
    (T : ℕ) : Prop :=
  Function.Injective B.I ∧ Function.Injective B.O ∧ B.t1 + B.t2 ≤ T

/-- `𝒞_{I,O} = {τ ∈ S_N : τ(I_j) = O_j for all j}`. -/
def constraintSet {N t : ℕ} (I O : Fin t → Fin N) : Finset (Equiv.Perm (Fin N)) :=
  Finset.univ.filter (fun τ : Equiv.Perm (Fin N) => ∀ j, τ (I j) = O j)

/-- Success probability in the constrained game: `Τ` uniform on `𝒞_{I,O}`, independent
of `D`. -/
def constrainedSuccess {N : ℕ} {D M Ans : Type} [Fintype D] (μ : FinDist D)
    (tr : D → M → Fin N) (suc : D → Ans → Prop) (B : ConstrainedStrategy N M Ans) : ℝ :=
  ∑ d, ∑ τ ∈ constraintSet B.I B.O,
    μ d / ((constraintSet B.I B.O).card : ℝ) *
      (if suc d (B.answer (fun i => τ (tr d (B.outer i)))) then 1 else 0)

/-- `\widehat{MaxS}(T)`. -/
def maxSHat {N : ℕ} {D M Ans : Type} [Fintype D] (μ : FinDist D) (tr : D → M → Fin N)
    (suc : D → Ans → Prop) (T : ℕ) : ℝ :=
  sSup {p : ℝ | ∃ B : ConstrainedStrategy N M Ans, B.Valid T ∧
    constrainedSuccess μ tr suc B = p}

/-- A non-adaptive algorithm with `S` bits of preprocessing advice about `Σ`: the online
queries (fixed before responses) and the answer may depend on the advice. -/
structure PreprocAlg (N S : ℕ) (M Ans : Type) where
  advice : Equiv.Perm (Fin N) → (Fin S → Bool)
  t1 : ℕ
  t2 : ℕ
  inner : (Fin S → Bool) → Fin t1 → Fin N
  outer : (Fin S → Bool) → Fin t2 → M
  answer : (Fin S → Bool) → (Fin t1 → Fin N) → (Fin t2 → Fin N) → Ans

/-- Success probability `p_A` of a preprocessing algorithm. -/
def preprocSuccess {N S : ℕ} {D M Ans : Type} [Fintype D] (μ : FinDist D)
    (tr : D → M → Fin N) (suc : D → Ans → Prop) (A : PreprocAlg N S M Ans) : ℝ :=
  ∑ d, ∑ σ : Equiv.Perm (Fin N),
    μ d / (Fintype.card (Equiv.Perm (Fin N)) : ℝ) *
      (if suc d (A.answer (A.advice σ) (fun j => σ (A.inner (A.advice σ) j))
            (fun i => σ (tr d (A.outer (A.advice σ) i))))
        then 1 else 0)

/-- The supplied estimate: `p_A ≤ min(2·\widehat{MaxS}(T) + 4 ln2 · ST/u,
\widehat{MaxS}(T) + √(ln2 · ST/u))`. -/
def PreprocEstimate {N : ℕ} {D M Ans : Type} [Fintype D] (μ : FinDist D) (tr : D → M → Fin N)
    (suc : D → Ans → Prop) (u : ℝ) : Prop :=
  ∀ (S T : ℕ) (A : PreprocAlg N S M Ans), A.t1 + A.t2 ≤ T →
    preprocSuccess μ tr suc A ≤
      min (2 * maxSHat μ tr suc T + 4 * Real.log 2 * (S : ℝ) * (T : ℝ) / u)
        (maxSHat μ tr suc T + Real.sqrt (Real.log 2 * (S : ℝ) * (T : ℝ) / u))

/-- "`Pr[tr(D,m) = x] ≤ 1/u` for every `m` and `x`." -/
def TrSpread {N : ℕ} {D M : Type} [Fintype D] (μ : FinDist D) (tr : D → M → Fin N) (u : ℝ) :
    Prop :=
  ∀ (m : M) (x : Fin N), ∑ d ∈ Finset.univ.filter (fun d : D => tr d m = x), μ d ≤ 1 / u

/-! ## Rubric lemma stubs -/

/-- Rubric 2: the partial bijection `a_j ↦ O_j` (distinct entries) extends to a
permutation of `[N]`. [NonAdaptiveCryptanalyticTime, node_28] -/
theorem exists_completion {N t : ℕ} (a O : Fin t → Fin N) (ha : Function.Injective a)
    (hO : Function.Injective O) :
    ∃ π : Equiv.Perm (Fin N), ∀ j, π (a j) = O j := by sorry

/-- `|𝒞_{I,O}| = (N - T_1)!` for duplicate-free `I, O`. [NonAdaptiveCryptanalyticTime, node_28] -/
theorem card_constraintSet {N t : ℕ} (I O : Fin t → Fin N) (hI : Function.Injective I)
    (hO : Function.Injective O) :
    (constraintSet I O).card = Nat.factorial (N - t) := by sorry

/-- Rubric 3: for any completion rule `π_a` (with `π_a(a_j) = O_j` for duplicate-free `a`),
the map `F(σ) = π_{σ(I)} ∘ σ` has exactly `(N)_{T_1}` preimages over every `τ ∈ 𝒞_{I,O}`;
hence `F(Σ)` is uniform on `𝒞_{I,O}`. [NonAdaptiveCryptanalyticTime, node_28] -/
theorem card_fiber_completion {N t : ℕ} (I O : Fin t → Fin N) (hI : Function.Injective I)
    (hO : Function.Injective O) (π : (Fin t → Fin N) → Equiv.Perm (Fin N))
    (hπ : ∀ a : Fin t → Fin N, Function.Injective a → ∀ j, π a (a j) = O j)
    (τ : Equiv.Perm (Fin N)) (hτ : τ ∈ constraintSet I O) :
    (Finset.univ.filter (fun σ : Equiv.Perm (Fin N) =>
        π (fun j => σ (I j)) * σ = τ)).card = Nat.descFactorial N t := by sorry

/-- Rubrics 1–4: every constrained strategy is simulated exactly, with the same budget, by
a non-preprocessing non-adaptive algorithm. [NonAdaptiveCryptanalyticTime, node_28] -/
theorem simulation {N : ℕ} {D M Ans : Type} [Fintype D] (μ : FinDist D) (tr : D → M → Fin N)
    (suc : D → Ans → Prop) (T : ℕ) (B : ConstrainedStrategy N M Ans) (hB : B.Valid T) :
    ∃ A : NonAdaptiveAlg N M Ans, A.t1 + A.t2 ≤ T ∧
      successProb μ tr suc A = constrainedSuccess μ tr suc B := by sorry

/-- Rubric 5: `\widehat{MaxS}(T) ≤ MaxS(T)`. [NonAdaptiveCryptanalyticTime, node_28] -/
theorem maxSHat_le_maxS {N : ℕ} {D M Ans : Type} [Fintype D] [Nonempty Ans]
    (μ : FinDist D) (tr : D → M → Fin N) (suc : D → Ans → Prop) (T : ℕ) :
    maxSHat μ tr suc T ≤ maxS μ tr suc T := by sorry

/-! ## Main theorem -/

/-- Main: every non-adaptive algorithm with `S` bits of advice and `≤ T` online queries has
success probability at most
`min(2·MaxS(T) + 4 ln2 · ST/u, MaxS(T) + √(ln2 · ST/u))`. [NonAdaptiveCryptanalyticTime, node_28] -/
theorem preprocessing_bound_maxS {N : ℕ} {D M Ans : Type} [Fintype D] [Nonempty Ans]
    (μ : FinDist D) (tr : D → M → Fin N) (suc : D → Ans → Prop)
    (u : ℝ) (hu : 0 < u) (htr : TrSpread μ tr u)
    (hest : PreprocEstimate μ tr suc u)
    (S T : ℕ) (A : PreprocAlg N S M Ans) (hA : A.t1 + A.t2 ≤ T) :
    preprocSuccess μ tr suc A ≤
      min (2 * maxS μ tr suc T + 4 * Real.log 2 * (S : ℝ) * (T : ℝ) / u)
        (maxS μ tr suc T + Real.sqrt (Real.log 2 * (S : ℝ) * (T : ℝ) / u)) := by sorry

