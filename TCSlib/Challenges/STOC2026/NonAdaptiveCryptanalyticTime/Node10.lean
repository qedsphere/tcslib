/-!
## Read-`k` families of `[0,1]`-valued functions of a uniform random bijection

`Ω` is the set of bijections `[N] → 𝒳` (`|𝒳| = N`), `Q` uniform, `P` arbitrary. If
`f_1, …, f_m : 𝒳^N → [0,1]` form a read-`k` family (each `f_j` depends only on `X_{U_j}`
and each coordinate lies in at most `k` sets `U_j`), with `p_j = E_P f_j`, `q_j = E_Q f_j`,
`p, q` their averages and `d(·‖·)` the Bernoulli KL divergence, then
`2k · D(P‖Q) ≥ m · d(p‖q)`.
Main theorem: `read_k_bernoulli_bound`.
-/

namespace TCSChallenge.NonAdaptiveCryptanalyticTime.node_10

/-- "Let `Ω` be the set of bijections `x : [N] → 𝒳`." -/
abbrev Bij (N : ℕ) (X : Type) : Type := Fin N ≃ X

/-- The uniform distribution `Q` on a finite type, as a plain function with mass `1/|α|`. Kept
local because `FinDist.uniform` needs a `Nonempty` instance that `Fin N ≃ X` does not have. -/
def unif (α : Type) [Fintype α] : α → ℝ := fun _ => 1 / (Fintype.card α : ℝ)

/-- KL divergence `D(P‖Q) = ∑ P log (P/Q)` (with `0 log 0 = 0` via `Real.log 0 = 0`). -/
def kl {α : Type} [Fintype α] (P Q : α → ℝ) : ℝ :=
  ∑ a, P a * Real.log (P a / Q a)

/-- `X_U = (X_i)_{i ∈ U}`, the restriction of a configuration to the coordinates in `U`. -/
def restrictTo {N : ℕ} {X : Type} (U : Finset (Fin N)) (x : Fin N → X) : ↥U → X :=
  fun i => x i

/-- "`P_{X_U}`, the marginal law of `(X_i)_{i∈U}` under `P`." -/
def marginal {N : ℕ} {X : Type} [Fintype X] (P : Bij N X → ℝ) (U : Finset (Fin N))
    (z : ↥U → X) : ℝ :=
  ∑ x ∈ Finset.univ.filter (fun x : Bij N X => restrictTo U (⇑x) = z), P x

/-- `E_Q[g]` for `Q` uniform on `Ω`. -/
def expect {N : ℕ} {X : Type} [Fintype X] (g : Bij N X → ℝ) : ℝ :=
  ∑ x, unif (Bij N X) x * g x

/-- "`Ent_Q(g) = E_Q[g log g] - E_Q[g] log E_Q[g]`, where `0 log 0 = 0`." -/
def ent {N : ℕ} {X : Type} [Fintype X] (g : Bij N X → ℝ) : ℝ :=
  expect (fun x => g x * Real.log (g x)) - expect g * Real.log (expect g)

/-- "`(T_A g)(x) = E_Q[g(Y) | Y_i = x_i for all i ∈ Aᶜ]`": under the uniform `Q` this is the
average of `g` over the fibre of bijections agreeing with `x` outside `A`. -/
def condExp {N : ℕ} {X : Type} [Fintype X] (A : Finset (Fin N)) (g : Bij N X → ℝ)
    (x : Bij N X) : ℝ :=
  (∑ y ∈ Finset.univ.filter (fun y : Bij N X => ∀ i, i ∉ A → y i = x i), g y) /
    ((Finset.univ.filter (fun y : Bij N X => ∀ i, i ∉ A → y i = x i)).card : ℝ)

/-- `Pr({r,s} ⊆ 𝐀)` for a random subset `𝐀` with law `θ`. -/
def pairProb {N : ℕ} (θ : Finset (Fin N) → ℝ) (r s : Fin N) : ℝ :=
  ∑ A ∈ Finset.univ.filter (fun A : Finset (Fin N) => r ∈ A ∧ s ∈ A), θ A

/-- The supplied estimate: if `N ≥ 2`, for every random subset `𝐀` (law `θ`) and every
`g ≥ 0`, `E_𝐀[Ent_Q(T_𝐀 g)] ≤ (1 - κ) Ent_Q(g)` with `κ = min_{r≠s} Pr({r,s} ⊆ 𝐀)`.
Encoded for every lower bound `κ` of the pair probabilities, and for `g` of positive mean. -/
def ContractionFact (N : ℕ) (X : Type) [Fintype X] : Prop :=
  2 ≤ N → Fintype.card X = N →
    ∀ θ : FinDist (Finset (Fin N)),
    ∀ κ : ℝ, (∀ r s : Fin N, r ≠ s → κ ≤ pairProb θ r s) →
    ∀ g : Bij N X → ℝ, (∀ x, 0 ≤ g x) → 0 < expect g →
      ∑ A, θ A * ent (condExp A g) ≤ (1 - κ) * ent g

/-- "Every `i ∈ [N]` belongs to at most `k` of the sets `𝒰_1, …, 𝒰_m`." -/
def ReadK {N m : ℕ} (U : Fin m → Finset (Fin N)) (k : ℕ) : Prop :=
  ∀ i : Fin N, (Finset.univ.filter (fun j : Fin m => i ∈ U j)).card ≤ k

/-- The law of `𝐀 = [N] ∖ 𝒰_J` for `J` uniform on `[m]`. -/
def complementLaw {N m : ℕ} (U : Fin m → Finset (Fin N)) (A : Finset (Fin N)) : ℝ :=
  ((Finset.univ.filter (fun j : Fin m => (U j)ᶜ = A)).card : ℝ) / (m : ℝ)

/-- The likelihood ratio `f = P/Q`. -/
def likelihoodRatio {N : ℕ} {X : Type} [Fintype X] (P : Bij N X → ℝ) : Bij N X → ℝ :=
  fun x => P x / unif (Bij N X) x

/-- "`f_j` depends only on `X_{U_j}`." -/
def DependsOn {N : ℕ} {X : Type} (f : (Fin N → X) → ℝ) (U : Finset (Fin N)) : Prop :=
  ∀ x y : Fin N → X, (∀ i ∈ U, x i = y i) → f x = f y

/-- `E_μ[f(X)]` for a distribution `μ` on `Ω`. -/
def expectUnder {N : ℕ} {X : Type} [Fintype X] (μ : Bij N X → ℝ)
    (f : (Fin N → X) → ℝ) : ℝ :=
  ∑ x, μ x * f (⇑x)

/-- "`d(a‖b) = a log(a/b) + (1-a) log((1-a)/(1-b))`" (Lean conventions at the endpoints). -/
def binKL (a b : ℝ) : ℝ :=
  a * Real.log (a / b) + (1 - a) * Real.log ((1 - a) / (1 - b))

/-! ## Rubric lemma stubs -/

/-- Rubrics 1–3: the Shearer-like marginal inequality for the dependency sets. [NonAdaptiveCryptanalyticTime, node_10] -/
theorem sum_kl_marginal_le {N m k : ℕ} {X : Type} [Fintype X] (hX : Fintype.card X = N)
    (hfact : ContractionFact N X)
    (P : FinDist (Bij N X))
    (U : Fin m → Finset (Fin N)) (hU : ReadK U k) :
    ∑ j, kl (marginal P (U j)) (marginal (unif (Bij N X)) (U j)) ≤
      2 * (k : ℝ) * kl P (unif (Bij N X)) := by sorry

/-- Rubric 2: `Ent_Q(P/Q) = D(P‖Q)`. [NonAdaptiveCryptanalyticTime, node_10] -/
theorem ent_likelihoodRatio {N : ℕ} {X : Type} [Fintype X] (hX : Fintype.card X = N)
    (P : FinDist (Bij N X)) :
    ent (likelihoodRatio P) = kl P (unif (Bij N X)) := by sorry

/-- Rubric 2: `Ent_Q(T_A h) = D(P_{X_{Aᶜ}} ‖ Q_{X_{Aᶜ}})`. [NonAdaptiveCryptanalyticTime, node_10] -/
theorem ent_condExp_likelihoodRatio {N : ℕ} {X : Type} [Fintype X]
    (hX : Fintype.card X = N) (P : FinDist (Bij N X)) (A : Finset (Fin N)) :
    ent (condExp A (likelihoodRatio P)) =
      kl (marginal P Aᶜ) (marginal (unif (Bij N X)) Aᶜ) := by sorry

/-- Rubric 3: `κ ≥ 1 - 2k/m` for the complement weighting. [NonAdaptiveCryptanalyticTime, node_10] -/
theorem pairProb_complementLaw_ge {N m k : ℕ} (U : Fin m → Finset (Fin N)) (hm : 1 ≤ m)
    (hU : ReadK U k) (r s : Fin N) (hrs : r ≠ s) :
    1 - 2 * (k : ℝ) / (m : ℝ) ≤ pairProb (complementLaw U) r s := by sorry

/-- Endpoint conventions are harmless: `q = 0 → p = 0` and `q = 1 → p = 1`. [NonAdaptiveCryptanalyticTime, node_10] -/
theorem bernoulli_abs_cont {N : ℕ} {X : Type} [Fintype X] (hX : Fintype.card X = N)
    (P : FinDist (Bij N X)) (f : (Fin N → X) → ℝ)
    (hf : ∀ x, 0 ≤ f x ∧ f x ≤ 1) :
    (expectUnder (unif (Bij N X)) f = 0 → expectUnder P f = 0) ∧
      (expectUnder (unif (Bij N X)) f = 1 → expectUnder P f = 1) := by sorry

/-- Rubric 4: data processing through the Bernoulli kernel `Pr[B = 1 | y] = φ_j(y)`. [NonAdaptiveCryptanalyticTime, node_10] -/
theorem kl_marginal_ge_binKL {N : ℕ} {X : Type} [Fintype X] (hX : Fintype.card X = N)
    (P : FinDist (Bij N X)) (f : (Fin N → X) → ℝ)
    (hf : ∀ x, 0 ≤ f x ∧ f x ≤ 1) (U : Finset (Fin N)) (hdep : DependsOn f U) :
    binKL (expectUnder P f) (expectUnder (unif (Bij N X)) f) ≤
      kl (marginal P U) (marginal (unif (Bij N X)) U) := by sorry

/-- Rubric 5: joint convexity, `m · d(p‖q) ≤ ∑_j d(p_j‖q_j)`. [NonAdaptiveCryptanalyticTime, node_10] -/
theorem binKL_avg_le {m : ℕ} (hm : 1 ≤ m) (a b : Fin m → ℝ)
    (ha : ∀ j, 0 ≤ a j ∧ a j ≤ 1) (hb : ∀ j, 0 ≤ b j ∧ b j ≤ 1)
    (hab : ∀ j, (b j = 0 → a j = 0) ∧ (b j = 1 → a j = 1)) :
    (m : ℝ) * binKL ((∑ j, a j) / (m : ℝ)) ((∑ j, b j) / (m : ℝ)) ≤
      ∑ j, binKL (a j) (b j) := by sorry

/-! ## Main theorem -/

/-- Rubric 6 / main: `2k · D(P‖Q) ≥ m · d(p‖q)`. [NonAdaptiveCryptanalyticTime, node_10] -/
theorem read_k_bernoulli_bound {N m k : ℕ} {X : Type} [Fintype X]
    (hN : 1 ≤ N) (hm : 1 ≤ m) (hk : 1 ≤ k) (hX : Fintype.card X = N)
    (hfact : ContractionFact N X)
    (P : FinDist (Bij N X))
    (f : Fin m → (Fin N → X) → ℝ) (hf : ∀ j x, 0 ≤ f j x ∧ f j x ≤ 1)
    (U : Fin m → Finset (Fin N)) (hdep : ∀ j, DependsOn (f j) (U j)) (hU : ReadK U k) :
    (m : ℝ) * binKL ((∑ j, expectUnder P (f j)) / (m : ℝ))
        ((∑ j, expectUnder (unif (Bij N X)) (f j)) / (m : ℝ)) ≤
      2 * (k : ℝ) * kl P (unif (Bij N X)) := by sorry

end TCSChallenge.NonAdaptiveCryptanalyticTime.node_10
