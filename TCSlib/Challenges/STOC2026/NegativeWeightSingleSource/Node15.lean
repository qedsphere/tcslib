/-!
## Recursive reweighting for restricted graphs (combinatorial core)

A directed graph `G = (V, E, w)` with source `s` is *restricted* if all weights are integers
`≥ -1`, every directed cycle `C` has `w(C) ≥ |C|`, and every `v ≠ s` has an edge `s → v` of
weight `0`. `κ(H)` is the maximum number of negative edges on a simple `s`-path of nonpositive
weight; `η_H(v)` is the minimum number of negative edges on a shortest `s–v` path.
For a potential `φ`, `w_φ(u,v) = w(u,v) + φ(u) - φ(v)`.

The paper's algorithm recursively solves the strongly connected components of `H \ S`, uses
their distances and a component-rank potential to make every edge outside `S` nonnegative,
and then runs an η-sensitive shortest path algorithm, whose cost is controlled by
`η_{H_φ}(v) ≤ |P_v ∩ S|` for shortest paths `P_v` fixed in advance.

Main theorem: `restricted_cut_potential`.
-/

namespace TCSChallenge.NegativeWeightSingleSource.node_15

/-- A finite edge-weighted directed graph on the vertex type `V`: an edge set `E ⊆ V × V` and an
integer weight `w (u, v)` (only pairs in `E` are ever used). -/
structure WDigraph (V : Type) where
  E : Finset (V × V)
  w : V × V → ℤ

namespace WDigraph

variable {V : Type}

/-- `p : Fin (k+1) → V` is a directed walk with `k` edges `p i → p (i+1)`, all in `E`. -/
def IsWalk (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  ∀ i : Fin k, (p i.castSucc, p i.succ) ∈ G.E

/-- The weight `r(P) = ∑_{e ∈ P} r(e)` of the walk `p` under a weighting `r`. -/
def walkWeight (r : V × V → ℤ) {k : ℕ} (p : Fin (k + 1) → V) : ℤ :=
  ∑ i : Fin k, r (p i.castSucc, p i.succ)

/-- `p` is a walk from `u` to `v` (the empty walk `k = 0` is allowed when `u = v`). -/
def IsWalkFrom (G : WDigraph V) (u v : V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  G.IsWalk p ∧ p 0 = u ∧ p (Fin.last k) = v

/-- `v` is reachable from `u`. -/
def Reach (G : WDigraph V) (u v : V) : Prop :=
  ∃ (k : ℕ) (p : Fin (k + 1) → V), G.IsWalkFrom u v p

/-- A directed cycle with `k ≥ 1` edges: a closed walk whose first `k` vertices are distinct;
`|C| = k`. -/
def IsCycle (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  1 ≤ k ∧ G.IsWalk p ∧ p 0 = p (Fin.last k) ∧
    Function.Injective (fun i : Fin k => p i.castSucc)

/-- `p` is a shortest `u–v` walk under the weighting `r`: no `u–v` walk is lighter. -/
def IsShortest (G : WDigraph V) (r : V × V → ℤ) (u v : V) {k : ℕ}
    (p : Fin (k + 1) → V) : Prop :=
  G.IsWalkFrom u v p ∧
    ∀ (j : ℕ) (q : Fin (j + 1) → V), G.IsWalkFrom u v q → walkWeight r p ≤ walkWeight r q

/-- Reweighting by a potential: `r_φ(u,v) = r(u,v) + φ(u) - φ(v)`. -/
def reweight (r : V × V → ℤ) (φ : V → ℤ) : V × V → ℤ :=
  fun e => r e + φ e.1 - φ e.2

/-- No directed cycle has negative weight under `r`. -/
def NoNegCycle (G : WDigraph V) (r : V × V → ℤ) : Prop :=
  ∀ (k : ℕ) (p : Fin (k + 1) → V), G.IsCycle p → 0 ≤ walkWeight r p

/-- "restricted": edge weights are integers at least `-1`, every directed cycle `C` has
`w(C) ≥ |C|`, and every vertex `v ≠ s` has an incoming edge `s → v` of weight `0`. -/
def IsRestricted (G : WDigraph V) (s : V) : Prop :=
  (∀ e ∈ G.E, -1 ≤ G.w e) ∧
  (∀ (k : ℕ) (p : Fin (k + 1) → V), G.IsCycle p → (k : ℤ) ≤ walkWeight G.w p) ∧
  (∀ v : V, v ≠ s → (s, v) ∈ G.E ∧ G.w (s, v) = 0)

end WDigraph

namespace WDigraph

variable {V : Type}

/-- Number of negative edges (counted with multiplicity) of the walk `p` under `r`. -/
def negCount (r : V × V → ℤ) {k : ℕ} (p : Fin (k + 1) → V) : ℕ :=
  (Finset.univ.filter (fun i : Fin k => r (p i.castSucc, p i.succ) < 0)).card

/-- `|E(P) ∩ S|`: number of edges of the walk `p` lying in the cut set `S`. -/
def hitCount [DecidableEq V] (S : Finset (V × V)) {k : ℕ} (p : Fin (k + 1) → V) : ℕ :=
  (Finset.univ.filter (fun i : Fin k => (p i.castSucc, p i.succ) ∈ S)).card

/-- `κ(H) ≤ K`: "the maximum number of negative edges on a simple path starting at `s` with
nonpositive total weight" is at most `K`. -/
def KappaLE (G : WDigraph V) (s : V) (K : ℕ) : Prop :=
  ∀ (v : V) (k : ℕ) (p : Fin (k + 1) → V), G.IsWalkFrom s v p → Function.Injective p →
    walkWeight G.w p ≤ 0 → negCount G.w p ≤ K

/-- `η(v) ≤ t` under the weighting `r`: "the minimum number of negative edges on a shortest
`s–v` path" is at most `t`, i.e. some shortest `s–v` path has at most `t` negative edges. -/
def EtaLE (G : WDigraph V) (r : V × V → ℤ) (s v : V) (t : ℕ) : Prop :=
  ∃ (k : ℕ) (p : Fin (k + 1) → V), G.IsShortest r s v p ∧ negCount r p ≤ t

end WDigraph

open WDigraph

/-- Telescoping: `w_φ(P) = w(P) + φ(u) - φ(v)` for every `u–v` walk `P`. [NegativeWeightSingleSource, node_15] -/
theorem walkWeight_reweight {V : Type} (r : V × V → ℤ) (φ : V → ℤ) {k : ℕ}
    (p : Fin (k + 1) → V) :
    walkWeight (reweight r φ) p = walkWeight r p + φ (p 0) - φ (p (Fin.last k)) := by
  sorry

/-- Reweighting by a potential preserves shortest paths (no unproved reweighting theorem). [NegativeWeightSingleSource, node_15] -/
theorem isShortest_reweight_iff {V : Type} (G : WDigraph V) (r : V × V → ℤ) (φ : V → ℤ)
    (u v : V) {k : ℕ} (p : Fin (k + 1) → V) :
    G.IsShortest (reweight r φ) u v p ↔ G.IsShortest r u v p := by
  sorry

/-- Distances give nonnegative reduced weights: if `d(v)` is the `r`-distance from `s` for every
`v`, then `r(u,v) + d(u) - d(v) ≥ 0` on every edge. [NegativeWeightSingleSource, node_15] -/
theorem reweight_dist_nonneg {V : Type} (G : WDigraph V) (r : V × V → ℤ) (s : V)
    (d : V → ℤ)
    (hd : ∀ v : V, ∃ (k : ℕ) (p : Fin (k + 1) → V), G.IsShortest r s v p ∧ walkWeight r p = d v) :
    ∀ e ∈ G.E, 0 ≤ reweight r d e := by
  sorry

/-- Construction 2 (component-rank potential): if every edge inside a strongly connected
component is nonnegative, some potential `ψ`, constant on each component, makes every edge
nonnegative. [NegativeWeightSingleSource, node_15] -/
theorem exists_component_potential {V : Type} [Fintype V] [DecidableEq V] (J : WDigraph V)
    (r : V × V → ℤ) (hin : ∀ e ∈ J.E, J.Reach e.2 e.1 → 0 ≤ r e) :
    ∃ ψ : V → ℤ, (∀ u v : V, J.Reach u v → J.Reach v u → ψ u = ψ v) ∧
      ∀ e ∈ J.E, 0 ≤ reweight r ψ e := by
  sorry

/-- `η ≤ κ` in restricted graphs: if `κ(G) ≤ K`, every vertex has a shortest `s`-path with at
most `K` negative edges. [NegativeWeightSingleSource, node_15] -/
theorem eta_le_kappa {V : Type} [Fintype V] [DecidableEq V] (G : WDigraph V) (s : V)
    (hR : G.IsRestricted s) (K : ℕ) (hK : G.KappaLE s K) (v : V) :
    G.EtaLE G.w s v K := by
  sorry

/-- Simultaneous size/parameter progress: in a non-base call (`q ≥ 4` non-source vertices,
`K > 2`), a child component with `c ≤ q` vertices and parameter `K_i = K` if
`c ≤ 3(q+1)/4`, `K_i = K/2` otherwise, satisfies `c · K_i ≤ (15/16) q K`. [NegativeWeightSingleSource, node_15] -/
theorem child_progress (q c : ℕ) (K Ki : ℝ) (hq : 4 ≤ q) (hK : 2 < K) (hc : c ≤ q)
    (hKi : Ki = if (c : ℝ) ≤ 3 * ((q : ℝ) + 1) / 4 then K else K / 2) :
    (c : ℝ) * Ki ≤ 15 / 16 * (q : ℝ) * K := by
  sorry

/-- Pointwise sparse hitting: if every edge outside `S` is nonnegative under `w_φ` and `P` is a
shortest `s–v` path of the original graph, then `η_{H_φ}(v) ≤ |E(P) ∩ S|`. [NegativeWeightSingleSource, node_15] -/
theorem eta_le_hitCount {V : Type} [DecidableEq V] (G : WDigraph V) (s v : V)
    (S : Finset (V × V)) (φ : V → ℤ) (hφ : ∀ e ∈ G.E, e ∉ S → 0 ≤ reweight G.w φ e)
    {k : ℕ} (P : Fin (k + 1) → V) (hP : G.IsShortest G.w s v P) :
    G.EtaLE (reweight G.w φ) s v (hitCount S P) := by
  sorry

/-- **Main theorem (combinatorial core of the recursive step).** For a restricted graph `G` and
any cut set `S ⊆ E`, there is a potential `φ` (in the paper: child distances on the components
of `G \ S` plus a component-rank term) such that every edge outside `S` is nonnegative under
`w_φ`, and for every vertex `v` and every original shortest `s–v` path `P_v` fixed in advance,
`η_{G_φ}(v) ≤ |E(P_v) ∩ S|`. [NegativeWeightSingleSource, node_15] -/
theorem restricted_cut_potential {V : Type} [Fintype V] [DecidableEq V] (G : WDigraph V)
    (s : V) (hR : G.IsRestricted s) (S : Finset (V × V)) (hS : S ⊆ G.E) :
    ∃ φ : V → ℤ, (∀ e ∈ G.E, e ∉ S → 0 ≤ reweight G.w φ e) ∧
      ∀ (v : V) (k : ℕ) (P : Fin (k + 1) → V), G.IsShortest G.w s v P →
        G.EtaLE (reweight G.w φ) s v (hitCount S P) := by
  sorry

end TCSChallenge.NegativeWeightSingleSource.node_15
