/-!
## Scaling reduction from general negative weights to restricted graphs (combinatorial core)

Given `G = (V, E, w)` with integer weights and no negative cycle, the algorithm scales the
weights to `r₀ = 4n·w` and repeatedly, while `B = max(0, max_e -r(e)) > 3`, sets
`a = ⌊B/3⌋ + 1`, builds the auxiliary graph `H` with weights `h(e) = ⌈r(e)/a⌉ + 1` plus a new
source `q` with `0`-edges to every vertex, obtains exact distances `d` in `H` from the oracle,
and reweights by `φ = a·d`. Finally negative weights (all `≥ -3`) are replaced by `0` and a
nonnegative shortest path tree is computed.

Main theorem: `truncated_shortest_is_shortest`.
-/

namespace TCSChallenge.NegativeWeightSingleSource.node_17

/-- A finite edge-weighted directed graph on the vertex type `V`: an edge set `E ⊆ V × V` and an
integer weight `w (u, v)` (only pairs in `E` are ever used). -/
structure WDigraph (V : Type) where
  E : Finset (V × V)
  w : V × V → ℤ

namespace WDigraph

variable {V : Type}

/-- `p : Fin (k+1) → V` is a directed walk with `k` edges `p i → p (i+1)`, all in `E`. -/
def IsWalk (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  ∀ i : Fin k, (p i.castSucc, p i.succ) ∈ G.E

/-- The weight `r(P) = ∑_{e ∈ P} r(e)` of the walk `p` under a weighting `r`. -/
def walkWeight (r : V × V → ℤ) {k : ℕ} (p : Fin (k + 1) → V) : ℤ :=
  ∑ i : Fin k, r (p i.castSucc, p i.succ)

/-- `p` is a walk from `u` to `v` (the empty walk `k = 0` is allowed when `u = v`). -/
def IsWalkFrom (G : WDigraph V) (u v : V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  G.IsWalk p ∧ p 0 = u ∧ p (Fin.last k) = v

/-- `v` is reachable from `u`. -/
def Reach (G : WDigraph V) (u v : V) : Prop :=
  ∃ (k : ℕ) (p : Fin (k + 1) → V), G.IsWalkFrom u v p

/-- A directed cycle with `k ≥ 1` edges: a closed walk whose first `k` vertices are distinct;
`|C| = k`. -/
def IsCycle (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  1 ≤ k ∧ G.IsWalk p ∧ p 0 = p (Fin.last k) ∧
    Function.Injective (fun i : Fin k => p i.castSucc)

/-- `p` is a shortest `u–v` walk under the weighting `r`: no `u–v` walk is lighter. -/
def IsShortest (G : WDigraph V) (r : V × V → ℤ) (u v : V) {k : ℕ}
    (p : Fin (k + 1) → V) : Prop :=
  G.IsWalkFrom u v p ∧
    ∀ (j : ℕ) (q : Fin (j + 1) → V), G.IsWalkFrom u v q → walkWeight r p ≤ walkWeight r q

/-- Reweighting by a potential: `r_φ(u,v) = r(u,v) + φ(u) - φ(v)`. -/
def reweight (r : V × V → ℤ) (φ : V → ℤ) : V × V → ℤ :=
  fun e => r e + φ e.1 - φ e.2

/-- No directed cycle has negative weight under `r`. -/
def NoNegCycle (G : WDigraph V) (r : V × V → ℤ) : Prop :=
  ∀ (k : ℕ) (p : Fin (k + 1) → V), G.IsCycle p → 0 ≤ walkWeight r p

/-- "restricted": edge weights are integers at least `-1`, every directed cycle `C` has
`w(C) ≥ |C|`, and every vertex `v ≠ s` has an incoming edge `s → v` of weight `0`. -/
def IsRestricted (G : WDigraph V) (s : V) : Prop :=
  (∀ e ∈ G.E, -1 ≤ G.w e) ∧
  (∀ (k : ℕ) (p : Fin (k + 1) → V), G.IsCycle p → (k : ℤ) ≤ walkWeight G.w p) ∧
  (∀ v : V, v ≠ s → (s, v) ∈ G.E ∧ G.w (s, v) = 0)

end WDigraph

namespace WDigraph

variable {V : Type}

/-- Integer ceiling `⌈x / a⌉`, computed as `-⌊-x / a⌋`; Lean's `Int` division `/` rounds
toward `-∞` when `a > 0`, so this is the exact ceiling for `a ≥ 1`. -/
def ceilDiv (x a : ℤ) : ℤ := -((-x) / a)

/-- The auxiliary graph `H` on `Option V`: every original edge `e = (u,v)` becomes
`(some u, some v)` with weight `h(e) = ⌈r(e)/a⌉ + 1`, and the new source `q = none` gets a
weight-`0` edge to every original vertex. No edge enters `q`. -/
def aux [Fintype V] [DecidableEq V] (G : WDigraph V) (r : V × V → ℤ) (a : ℤ) :
    WDigraph (Option V) where
  E := G.E.image (fun e => (some e.1, some e.2)) ∪
    Finset.univ.image (fun v : V => ((none : Option V), some v))
  w := fun e =>
    match e with
    | (some u, some v) => ceilDiv (r (u, v)) a + 1
    | _ => 0

/-- Scaling of a weighting by an integer constant `c`. -/
def scale (c : ℤ) (r : V × V → ℤ) : V × V → ℤ := fun e => c * r e

/-- Final truncation `r*(e) = max(r(e), 0)` (not a potential transformation). -/
def truncate (r : V × V → ℤ) : V × V → ℤ := fun e => max (r e) 0

end WDigraph

open WDigraph

/-- All three promises of `R` hold for the auxiliary graph, when `r` has no negative cycle,
`a ≥ 1` and every edge has `r(e) > -3a`. [NegativeWeightSingleSource, node_17] -/
theorem aux_isRestricted {V : Type} [Fintype V] [DecidableEq V] (G : WDigraph V)
    (r : V × V → ℤ) (a : ℤ) (ha : 1 ≤ a) (hneg : G.NoNegCycle r)
    (hlow : ∀ e ∈ G.E, -3 * a < r e) :
    (aux G r a).IsRestricted none := by
  sorry

/-- Local potential improvement: with `d` the exact distances from `q` in the auxiliary graph,
`φ(v) = a·d(v)` gives `r_φ(e) > -2a` for every original edge. [NegativeWeightSingleSource, node_17] -/
theorem local_improvement {V : Type} [Fintype V] [DecidableEq V] (G : WDigraph V)
    (r : V × V → ℤ) (a : ℤ) (ha : 1 ≤ a) (hneg : G.NoNegCycle r)
    (hlow : ∀ e ∈ G.E, -3 * a < r e) (d : Option V → ℤ)
    (hd : ∀ x : Option V, ∃ (k : ℕ) (p : Fin (k + 1) → Option V),
      (aux G r a).IsShortest (aux G r a).w none x p ∧ walkWeight (aux G r a).w p = d x) :
    ∀ e ∈ G.E, -2 * a < reweight r (fun v => a * d (some v)) e := by
  sorry

/-- Telescoping: `r_φ(P) = r(P) + φ(u) - φ(v)` for every `u–v` walk `P`. [NegativeWeightSingleSource, node_17] -/
theorem walkWeight_reweight {V : Type} (r : V × V → ℤ) (φ : V → ℤ) {k : ℕ}
    (p : Fin (k + 1) → V) :
    walkWeight (reweight r φ) p = walkWeight r p + φ (p 0) - φ (p (Fin.last k)) := by
  sorry

/-- Reweighting by a potential preserves the absence of negative cycles. [NegativeWeightSingleSource, node_17] -/
theorem noNegCycle_reweight {V : Type} (G : WDigraph V) (r : V × V → ℤ) (φ : V → ℤ)
    (h : G.NoNegCycle r) : G.NoNegCycle (reweight r φ) := by
  sorry

/-- Positive scaling preserves the absence of negative cycles. [NegativeWeightSingleSource, node_17] -/
theorem noNegCycle_scale {V : Type} (G : WDigraph V) (r : V × V → ℤ) (c : ℤ) (hc : 0 < c)
    (h : G.NoNegCycle r) : G.NoNegCycle (scale c r) := by
  sorry

/-- Integer-safe schedule: for `B > 3` and `a = ⌊B/3⌋ + 1`, a new bound `B' ≤ 2a - 1`
satisfies `B' ≤ (11/12) B`, i.e. `12 B' ≤ 11 B`. [NegativeWeightSingleSource, node_17] -/
theorem schedule_progress (B B' : ℤ) (hB : 3 < B) (hB' : B' ≤ 2 * (B / 3 + 1) - 1) :
    12 * B' ≤ 11 * B := by
  sorry

/-- **Main theorem (exact recovery after truncation).** Let `G` have no negative cycle under
its integer weights `w`, let `n = |V|`, and let `r_L = (4n·w)_Φ` be obtained from the scaled
weights by a potential `Φ`, with `r_L(e) ≥ -3` on every edge. Then every simple path `Q` from
`s` to `v` that is shortest under `r* = max(r_L, 0)` is a shortest `s–v` path under `w`. [NegativeWeightSingleSource, node_17] -/
theorem truncated_shortest_is_shortest {V : Type} [Fintype V] [DecidableEq V]
    (G : WDigraph V) (s v : V) (hneg : G.NoNegCycle G.w) (Φ : V → ℤ)
    (hlow : ∀ e ∈ G.E, -3 ≤ reweight (scale (4 * (Fintype.card V : ℤ)) G.w) Φ e)
    {k : ℕ} (Q : Fin (k + 1) → V)
    (hQ : G.IsShortest (truncate (reweight (scale (4 * (Fintype.card V : ℤ)) G.w) Φ)) s v Q)
    (hQs : Function.Injective Q) :
    G.IsShortest G.w s v Q := by
  sorry

end TCSChallenge.NegativeWeightSingleSource.node_17
