/-!
## Single-source distances with negative cycles (combinatorial core)

For `G = (V, E, w)` with integer weights and source `s`, `dist_G(s,v)` is the infimum of the
weights of all finite `s–v` walks (the empty walk included): `+∞` if there is none and `-∞`
if the weights are unbounded below. The algorithm restricts to vertices reachable from `s`,
tests each strongly connected component for a negative cycle with certified calls, outputs `-∞`
on the forward closure `A` of the components with negative cycles, and computes the remaining
finite distances by Dijkstra on weights reduced by a verified feasible vector `x`.

Main theorem: `dist_classification`.
-/

namespace TCSChallenge.NegativeWeightSingleSource.node_28

/-- A finite edge-weighted directed graph on the vertex type `V`: an edge set `E ⊆ V × V` and an
integer weight `w (u, v)` (only pairs in `E` are ever used). -/
structure WDigraph (V : Type) where
  E : Finset (V × V)
  w : V × V → ℤ

namespace WDigraph

variable {V : Type}

/-- `p : Fin (k+1) → V` is a directed walk with `k` edges `p i → p (i+1)`, all in `E`. -/
def IsWalk (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  ∀ i : Fin k, (p i.castSucc, p i.succ) ∈ G.E

/-- The weight `r(P) = ∑_{e ∈ P} r(e)` of the walk `p` under a weighting `r`. -/
def walkWeight (r : V × V → ℤ) {k : ℕ} (p : Fin (k + 1) → V) : ℤ :=
  ∑ i : Fin k, r (p i.castSucc, p i.succ)

/-- `p` is a walk from `u` to `v` (the empty walk `k = 0` is allowed when `u = v`). -/
def IsWalkFrom (G : WDigraph V) (u v : V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  G.IsWalk p ∧ p 0 = u ∧ p (Fin.last k) = v

/-- `v` is reachable from `u`. -/
def Reach (G : WDigraph V) (u v : V) : Prop :=
  ∃ (k : ℕ) (p : Fin (k + 1) → V), G.IsWalkFrom u v p

/-- A directed cycle with `k ≥ 1` edges: a closed walk whose first `k` vertices are distinct;
`|C| = k`. -/
def IsCycle (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V) : Prop :=
  1 ≤ k ∧ G.IsWalk p ∧ p 0 = p (Fin.last k) ∧
    Function.Injective (fun i : Fin k => p i.castSucc)

/-- `p` is a shortest `u–v` walk under the weighting `r`: no `u–v` walk is lighter. -/
def IsShortest (G : WDigraph V) (r : V × V → ℤ) (u v : V) {k : ℕ}
    (p : Fin (k + 1) → V) : Prop :=
  G.IsWalkFrom u v p ∧
    ∀ (j : ℕ) (q : Fin (j + 1) → V), G.IsWalkFrom u v q → walkWeight r p ≤ walkWeight r q

/-- Reweighting by a potential: `r_φ(u,v) = r(u,v) + φ(u) - φ(v)`. -/
def reweight (r : V × V → ℤ) (φ : V → ℤ) : V × V → ℤ :=
  fun e => r e + φ e.1 - φ e.2

/-- No directed cycle has negative weight under `r`. -/
def NoNegCycle (G : WDigraph V) (r : V × V → ℤ) : Prop :=
  ∀ (k : ℕ) (p : Fin (k + 1) → V), G.IsCycle p → 0 ≤ walkWeight r p

/-- "restricted": edge weights are integers at least `-1`, every directed cycle `C` has
`w(C) ≥ |C|`, and every vertex `v ≠ s` has an incoming edge `s → v` of weight `0`. -/
def IsRestricted (G : WDigraph V) (s : V) : Prop :=
  (∀ e ∈ G.E, -1 ≤ G.w e) ∧
  (∀ (k : ℕ) (p : Fin (k + 1) → V), G.IsCycle p → (k : ℤ) ≤ walkWeight G.w p) ∧
  (∀ v : V, v ≠ s → (s, v) ∈ G.E ∧ G.w (s, v) = 0)

end WDigraph

namespace WDigraph

variable {V : Type}

/-- `dist_G(s,v) = -∞`: the weights of `s–v` walks are unbounded below. -/
def DistNegInf (G : WDigraph V) (s v : V) : Prop :=
  ∀ B : ℤ, ∃ (k : ℕ) (p : Fin (k + 1) → V), G.IsWalkFrom s v p ∧ walkWeight G.w p < B

/-- `dist_G(s,v) = d ∈ ℤ`: some `s–v` walk has weight `d` and none is lighter. -/
def DistEq (G : WDigraph V) (s v : V) (d : ℤ) : Prop :=
  (∃ (k : ℕ) (p : Fin (k + 1) → V), G.IsWalkFrom s v p ∧ walkWeight G.w p = d) ∧
    ∀ (k : ℕ) (p : Fin (k + 1) → V), G.IsWalkFrom s v p → d ≤ walkWeight G.w p

/-- The set `A`: vertices reachable from a negative directed cycle that is itself reachable
from `s` (equivalently, the forward closure inside `G[R]` of the strongly connected
components containing a negative cycle). -/
def NegInfSet (G : WDigraph V) (s : V) : Set V :=
  {v | ∃ (k : ℕ) (p : Fin (k + 1) → V), G.IsCycle p ∧ walkWeight G.w p < 0 ∧
    G.Reach s (p 0) ∧ G.Reach (p 0) v}

/-- A feasible vector: `x(v) - x(u) ≤ w(u,v)` for every edge. -/
def IsFeasible (G : WDigraph V) (x : V → ℤ) : Prop :=
  ∀ e ∈ G.E, x e.2 - x e.1 ≤ G.w e

end WDigraph

open WDigraph

/-- Certificate soundness: a feasible vector certifies that there is no negative cycle. [NegativeWeightSingleSource, node_28] -/
theorem noNegCycle_of_feasible {V : Type} (G : WDigraph V) (x : V → ℤ) (hx : G.IsFeasible x) :
    G.NoNegCycle G.w := by
  sorry

/-- Localization: all vertices of a directed cycle are mutually reachable, so every cycle lies
inside one strongly connected component. [NegativeWeightSingleSource, node_28] -/
theorem cycle_mutually_reachable {V : Type} (G : WDigraph V) {k : ℕ} (p : Fin (k + 1) → V)
    (hp : G.IsCycle p) (i j : Fin (k + 1)) : G.Reach (p i) (p j) := by
  sorry

/-- SCC form of `A`: `v ∈ A` iff some vertex `u` reachable from `s` reaches `v` and lies in the
same strongly connected component as a negative cycle. [NegativeWeightSingleSource, node_28] -/
theorem mem_negInfSet_iff_scc {V : Type} (G : WDigraph V) (s v : V) :
    v ∈ G.NegInfSet s ↔ ∃ u : V, G.Reach s u ∧ G.Reach u v ∧
      ∃ (k : ℕ) (p : Fin (k + 1) → V), G.IsCycle p ∧ walkWeight G.w p < 0 ∧
        G.Reach u (p 0) ∧ G.Reach (p 0) u := by
  sorry

/-- Recovery of finite distances: for a feasible `x`, all reduced weights are nonnegative, and
a shortest `s–v` walk `p` under `w_x` is shortest under `w` with
`w(p) = w_x(p) - x(s) + x(v)`. [NegativeWeightSingleSource, node_28] -/
theorem recover_from_feasible {V : Type} (G : WDigraph V) (x : V → ℤ) (hx : G.IsFeasible x)
    (s v : V) {k : ℕ} (p : Fin (k + 1) → V) (hp : G.IsShortest (reweight G.w x) s v p) :
    (∀ e ∈ G.E, 0 ≤ reweight G.w x e) ∧ G.IsShortest G.w s v p ∧
      walkWeight G.w p = walkWeight (reweight G.w x) p - x s + x v := by
  sorry

/-- Size-dependent repetitions: for `1 ≤ b ≤ n`, `c > 0` and
`k_b = ⌈(c+2) log(n+2) / (2 log(b+2))⌉`, the failure probability `(b+2)^{-2 k_b}` of `k_b`
independent experiments is at most `(n+2)^{-(c+2)}`. [NegativeWeightSingleSource, node_28] -/
theorem repetition_bound (n b : ℕ) (c : ℝ) (hc : 0 < c) (hb : 1 ≤ b) (hbn : b ≤ n) :
    ((b : ℝ) + 2) ^ (-(2 * (⌈(c + 2) * Real.log ((n : ℝ) + 2) /
        (2 * Real.log ((b : ℝ) + 2))⌉₊ : ℝ))) ≤ ((n : ℝ) + 2) ^ (-(c + 2)) := by
  sorry

/-- **Main theorem (exact classification of distances).** For every vertex `v`:
`dist(s,v) = -∞` iff `v` lies in the forward closure `A` of the negative cycles reachable from
`s`; and every vertex reachable from `s` outside `A` has a finite distance, attained by a simple
path; vertices not reachable from `s` have no `s`-walk (`dist = +∞`). [NegativeWeightSingleSource, node_28] -/
theorem dist_classification {V : Type} [Fintype V] [DecidableEq V] (G : WDigraph V)
    (s v : V) :
    (G.DistNegInf s v ↔ v ∈ G.NegInfSet s) ∧
    (G.Reach s v → v ∉ G.NegInfSet s →
      ∃ (d : ℤ) (k : ℕ) (p : Fin (k + 1) → V), G.DistEq s v d ∧
        G.IsWalkFrom s v p ∧ Function.Injective p ∧ walkWeight G.w p = d) ∧
    (¬ G.Reach s v → ∀ (k : ℕ) (p : Fin (k + 1) → V), ¬ G.IsWalkFrom s v p) := by
  sorry

end TCSChallenge.NegativeWeightSingleSource.node_28
