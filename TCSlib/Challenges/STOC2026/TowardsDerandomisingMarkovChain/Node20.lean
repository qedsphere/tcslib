/-!
## Deterministic counting of hypergraph colourings from a marginal sampler

Fix `k ≥ 20`, `Δ ≥ 2`, `q ≥ 2` with `Δ ≤ (q/64)^{(k-5)/3}`. For a `k`-uniform
hypergraph with edges `e₁, …, e_m` and maximum degree `≤ Δ`, `Z(H)` is the number of
proper `q`-colourings. With `H_i` the hypergraph of the first `i` edges and
`p_i = Pr_{μ_{i-1}}[e_i not monochromatic]`, one has `Z(H) = q^n ∏ p_i` and, by a
conditional local-lemma argument, `p_i ≥ 1/2`. Given, for each `i`, a law on
`[q]^{e_i}` within TV distance `η = ε/(20m)` of the `e_i`-marginal of `μ_{i-1}`
(the exactly evaluated output law of the supplied sampler, a TCSlib `FinDist`), the estimator
`Ẑ = q^n ∏ p̂_i` is a `(1 ± ε)` approximation: main theorem `estimate_correct`.
-/

namespace TCSChallenge.TowardsDerandomisingMarkovChain.node_20

variable {V : Type} [Fintype V] [DecidableEq V]

/-- `σ|_e` is monochromatic. -/
def IsMono {q : ℕ} (e : Finset V) (σ : V → Fin q) : Prop :=
  ∃ c : Fin q, ∀ v ∈ e, σ v = c

/-- `σ` is proper on the edges indexed by `A`: no such edge is monochromatic. -/
def ProperOn {m q : ℕ} (edge : Fin m → Finset V) (A : Finset (Fin m)) (σ : V → Fin q) : Prop :=
  ∀ j ∈ A, ¬ IsMono (edge j) σ

/-- The first `i` edges (indices `j < i`): the edge set of `H_i`. -/
def firstEdges (m i : ℕ) : Finset (Fin m) := Finset.univ.filter (fun j : Fin m => j.val < i)

/-- Number of proper colourings w.r.t. the edges in `A`. -/
def Zon {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (A : Finset (Fin m)) : ℕ :=
  (Finset.univ.filter (fun σ : V → Fin q => ProperOn edge A σ)).card

/-- `Z(H)`: number of proper `q`-colourings of the whole hypergraph. -/
def Z {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) : ℕ := Zon edge q Finset.univ

/-- "every edge has exactly k vertices" -/
def IsUniform {m : ℕ} (edge : Fin m → Finset V) (k : ℕ) : Prop := ∀ j, (edge j).card = k

/-- "each vertex belongs to at most Δ edges" -/
def MaxDegreeLE {m : ℕ} (edge : Fin m → Finset V) (Δ : ℕ) : Prop :=
  ∀ v : V, (Finset.univ.filter (fun j : Fin m => v ∈ edge j)).card ≤ Δ

/-- Parameter regime `k ≥ 20`, `Δ ≥ 2`, `q ≥ 2`, `Δ ≤ (q/64)^{(k-5)/3}`. -/
def ParamRegime (k Δ q : ℕ) : Prop :=
  20 ≤ k ∧ 2 ≤ Δ ∧ 2 ≤ q ∧
    (Δ : ℝ) ≤ ((q : ℝ) / 64) ^ (((k : ℝ) - 5) / 3)

/-- Restriction of a colouring to an edge. -/
def restrictTo {q : ℕ} (e : Finset V) (σ : V → Fin q) : (↥e → Fin q) := fun v => σ v.1

/-- The `e_i`-marginal of the uniform distribution `μ_{i-1}` on proper colourings of
`H_{i-1}`. -/
def trueMarginal {m q : ℕ} (edge : Fin m → Finset V) (i : Fin m) (τ : ↥(edge i) → Fin q) : ℝ :=
  ((Finset.univ.filter (fun σ : V → Fin q =>
      ProperOn edge (firstEdges m i.val) σ ∧ restrictTo (edge i) σ = τ)).card : ℝ) /
    (Zon edge q (firstEdges m i.val) : ℝ)

/-- Acceptance probability `p_i = Pr_{μ_{i-1}}[e_i not monochromatic]`. -/
def acceptProb {m q : ℕ} (edge : Fin m → Finset V) (i : Fin m) : ℝ :=
  ((Finset.univ.filter (fun σ : V → Fin q =>
      ProperOn edge (firstEdges m i.val) σ ∧ ¬ IsMono (edge i) σ)).card : ℝ) /
    (Zon edge q (firstEdges m i.val) : ℝ)

/-- Total variation distance `½ ∑ |P ω − Q ω|` between real-valued functions. Kept local
(not `statDist`) because the second argument, `trueMarginal`, is a computed conditional
law that cannot be bundled as a `FinDist` without proofs. -/
def tvDist {α : Type} [Fintype α] (P Q : α → ℝ) : ℝ := (1 / 2) * ∑ a, |P a - Q a|

/-- `p̂_i`: probability under the law `P` on `[q]^{e_i}` that the output is not
monochromatic. -/
def acceptEst {q : ℕ} (e : Finset V) (P : FinDist (↥e → Fin q)) : ℝ :=
  ∑ τ : ↥e → Fin q, if (∃ c : Fin q, ∀ v, τ v = c) then 0 else P τ

/-- The output `Ẑ = q^n ∏ᵢ p̂_i`. -/
def estimator {m q : ℕ} (edge : Fin m → Finset V)
    (P : (i : Fin m) → FinDist (↥(edge i) → Fin q)) : ℝ :=
  (q : ℝ) ^ Fintype.card V * ∏ i : Fin m, acceptEst (edge i) (P i)

/-- Rubric 1: the regime gives `q^{k-1} ≥ 4kΔ`, i.e. `q^{1-k} ≤ 1/(4d)`, `d = kΔ`. [TowardsDerandomisingMarkovChain, node_20] -/
theorem param_numeric (k Δ q : ℕ) (h : ParamRegime k Δ q) :
    4 * (k : ℝ) * Δ ≤ (q : ℝ) ^ (k - 1) := by sorry

/-- Rubric 2 (conditional avoidance, with positivity): for any set `T` of edges and an
edge `f ∉ T`, there are proper colourings on `T`, and among them at most a fraction
`x = 1/(2kΔ)` make `f` monochromatic. [TowardsDerandomisingMarkovChain, node_20] -/
theorem conditional_avoidance (k Δ q : ℕ) (hp : ParamRegime k Δ q) {m : ℕ}
    (edge : Fin m → Finset V) (hu : IsUniform edge k) (hd : MaxDegreeLE edge Δ)
    (T : Finset (Fin m)) (f : Fin m) (hf : f ∉ T) :
    0 < Zon edge q T ∧
      ((Finset.univ.filter (fun σ : V → Fin q => ProperOn edge T σ ∧ IsMono (edge f) σ)).card
        : ℝ) ≤ (1 / (2 * (k : ℝ) * Δ)) * (Zon edge q T : ℝ) := by sorry

/-- Acceptance lower bound (2): `p_i ≥ 1/2`. [TowardsDerandomisingMarkovChain, node_20] -/
theorem acceptProb_ge_half (k Δ q : ℕ) (hp : ParamRegime k Δ q) {m : ℕ}
    (edge : Fin m → Finset V) (hu : IsUniform edge k) (hd : MaxDegreeLE edge Δ)
    (i : Fin m) : (1 : ℝ) / 2 ≤ acceptProb (q := q) edge i := by sorry

/-- Telescoping identity (3): `Z(H) = q^n ∏ᵢ p_i`. [TowardsDerandomisingMarkovChain, node_20] -/
theorem count_eq_prod (k Δ q : ℕ) (hp : ParamRegime k Δ q) {m : ℕ}
    (edge : Fin m → Finset V) (hu : IsUniform edge k) (hd : MaxDegreeLE edge Δ) :
    (Z edge q : ℝ) = (q : ℝ) ^ Fintype.card V * ∏ i : Fin m, acceptProb (q := q) edge i := by
  sorry

/-- TV closeness transfers to the acceptance event: `|p̂_i − p_i| ≤ η`. [TowardsDerandomisingMarkovChain, node_20] -/
theorem acceptEst_close {m q : ℕ} (edge : Fin m → Finset V) (i : Fin m)
    (P : FinDist (↥(edge i) → Fin q)) (η : ℝ)
    (hZ : 0 < Zon edge q (firstEdges m i.val))
    (hTV : tvDist P.prob (trueMarginal edge i) ≤ η) :
    |acceptEst (edge i) P - acceptProb (q := q) edge i| ≤ η := by sorry

/-- Main theorem: if every law `P i` (the exactly evaluated output law of the supplied
sampler on `G = H_{i-1}`, `S = e_i`, `η = ε/(20m)`) is within TV distance `η` of the
true `e_i`-marginal, then `(1-ε) Z(H) ≤ q^n ∏ p̂_i ≤ (1+ε) Z(H)`. (For `m = 0` the
estimator is `q^n = Z(H)`.) [TowardsDerandomisingMarkovChain, node_20] -/
theorem estimate_correct (k Δ q : ℕ) (hp : ParamRegime k Δ q) {m : ℕ}
    (edge : Fin m → Finset V) (hu : IsUniform edge k) (hd : MaxDegreeLE edge Δ)
    (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1)
    (P : (i : Fin m) → FinDist (↥(edge i) → Fin q))
    (hTV : ∀ i, tvDist (P i).prob (trueMarginal edge i) ≤ ε / (20 * (m : ℝ))) :
    (1 - ε) * (Z edge q : ℝ) ≤ estimator edge P ∧
      estimator edge P ≤ (1 + ε) * (Z edge q : ℝ) := by sorry

end TCSChallenge.TowardsDerandomisingMarkovChain.node_20
