/-!
## Deterministic approximate counting of hypergraph independent sets

Fix `k ≥ 2`, `Δ ≥ 2` with `Δ ≤ 2^{k/2} / (√(8e) k²)`. For a `k`-uniform hypergraph
`H = (V, E)` of maximum degree `≤ Δ`, `Z(H)` is the number of sets `I ⊆ V` containing
no edge. The paper builds a deterministic FPTAS by (i) a coupling-from-the-past style
local sampler for the marginal of one vertex driven by fair bits, (ii) a tail bound on
the bad-component exploration, and (iii) the self-reduction
`Z(H) = ∏ᵢ q_i⁻¹`, `q_i = Pr_{H_i}[v_i ∉ I] ≥ 1/2`.

We model the sampler's randomness as the bits of a finite-window systematic-scan chain
(the forward process the paper couples with). The combinatorial core is:

* `update_preserves_uniform`: the single-site update preserves the uniform law;
* `coalescence_tail`: with window `L = n((D+1)h+3)`, `D = 2Δk²`, at most a `2^{-h}`
  fraction of bit strings leave the target vertex's final value dependent on the
  initial independent set (the content of bound (1) and the CFTP reconstruction);
* `marginal_absent_ge_half`, `count_eq_prod_inv`: the self-reduction;
* main theorem `fptas_estimate_correct`: the estimator `Ẑ = ∏ q̃_i⁻¹`, where `q̃_i`
  is the exact probability that the chain on `H_i` started from `∅` ends with `v_i`
  absent, satisfies `(1-ε) Z(H) ≤ Ẑ ≤ (1+ε) Z(H)`.
-/

namespace TCSChallenge.TowardsDerandomisingMarkovChain.node_11

variable {V : Type} [Fintype V] [DecidableEq V]

/-- "every edge has exactly k vertices" -/
def IsUniform (E : Finset (Finset V)) (k : ℕ) : Prop :=
  ∀ e ∈ E, e.card = k

/-- "every vertex belongs to at most Δ edges" -/
def MaxDegreeLE (E : Finset (Finset V)) (Δ : ℕ) : Prop :=
  ∀ v : V, (E.filter (fun e => v ∈ e)).card ≤ Δ

/-- Independent set: "a ⊈ I for every a ∈ E". -/
def IsIndep (E : Finset (Finset V)) (I : Finset V) : Prop :=
  ∀ e ∈ E, ¬ e ⊆ I

/-- Independent sets of `H` contained in the vertex subset `U`. -/
def indepSetsIn (E : Finset (Finset V)) (U : Finset V) : Finset (Finset V) :=
  U.powerset.filter (fun I => IsIndep E I)

/-- `Z(H) = |{I ⊆ V : a ⊈ I for every a ∈ E}|`. -/
def Z (E : Finset (Finset V)) : ℕ :=
  (indepSetsIn E Finset.univ).card

/-- The paper's parameter regime `Δ ≤ 2^{k/2} / (√(8e) k²)`, `k ≥ 2`, `Δ ≥ 2`. -/
def ParamRegime (k Δ : ℕ) : Prop :=
  2 ≤ k ∧ 2 ≤ Δ ∧
    (Δ : ℝ) ≤ (2 : ℝ) ^ ((k : ℝ) / 2) / (Real.sqrt (8 * Real.exp 1) * (k : ℝ) ^ 2)

/-- The degree bound `D = 2Δk²` of the timestamp graph `G`. -/
def Dbound (k Δ : ℕ) : ℕ := 2 * Δ * k ^ 2

/-- Single-site update at `v` with fair bit `b`, on the subproblem whose live vertices
are `U` (vertices outside `U` are frozen and never updated): "put v equal to 0 if B = 0;
if B = 1, put v equal to 1 exactly when this does not complete an edge". -/
def updateAt (E : Finset (Finset V)) (U : Finset V) (v : V) (b : Bool)
    (X : Finset V) : Finset V :=
  if v ∉ U then X
  else if b = false then X.erase v
  else if ∃ e ∈ E, v ∈ e ∧ e.erase v ⊆ X then X.erase v
  else insert v X

/-- The cyclic schedule: at time `t` the vertex `σ (t mod n)` is updated. -/
def schedule (σ : Fin (Fintype.card V) ≃ V) (hn : 0 < Fintype.card V) (t : ℕ) : V :=
  σ ⟨t % Fintype.card V, Nat.mod_lt _ hn⟩

/-- Extend a finite bit string by `false` (unused). -/
def extendBits {L : ℕ} (B : Fin L → Bool) (t : ℕ) : Bool :=
  if h : t < L then B ⟨t, h⟩ else false

/-- The forward systematic-scan chain started at `X0`, using bit `B t` at time `t`. -/
def runChain (E : Finset (Finset V)) (U : Finset V) (σ : Fin (Fintype.card V) ≃ V)
    (hn : 0 < Fintype.card V) (X0 : Finset V) (B : ℕ → Bool) : ℕ → Finset V
  | 0 => X0
  | t + 1 => updateAt E U (schedule σ hn t) (B t) (runChain E U σ hn X0 B t)

/-- Live vertex set of `H_i`: `{v_i, …, v_n}` (0-indexed: `σ j` with `j ≥ i`). -/
def liveSet (σ : Fin (Fintype.card V) ≃ V) (i : Fin (Fintype.card V)) : Finset V :=
  (Finset.univ.filter (fun j : Fin (Fintype.card V) => i ≤ j)).image σ

/-- Absence marginal `q_i`: probability that `v_i` is absent in a uniform independent set
of `H_i` (independent sets of `H` inside the live set). -/
def absMarginal (E : Finset (Finset V)) (U : Finset V) (v : V) : ℝ :=
  (((indepSetsIn E U).filter (fun I => v ∉ I)).card : ℝ) / ((indepSetsIn E U).card : ℝ)

/-- The exact law (over `2^L` bit strings) that the chain on live set `U`, started from
`∅`, ends after `L` steps with `v` absent: the quantity `q̃_i`. -/
def chainAbsentProb (E : Finset (Finset V)) (U : Finset V) (σ : Fin (Fintype.card V) ≃ V)
    (hn : 0 < Fintype.card V) (L : ℕ) (v : V) : ℝ :=
  ((Finset.univ.filter (fun B : Fin L → Bool =>
      v ∉ runChain E U σ hn ∅ (extendBits B) L)).card : ℝ) / (2 : ℝ) ^ L

/-- Number of fair bits / window parameter `h = ⌈log₂(20 n / ε)⌉`. -/
def hParam (n : ℕ) (ε : ℝ) : ℕ := ⌈Real.logb 2 (20 * (n : ℝ) / ε)⌉₊

/-- Window length `L = n((D+1)h + 3)`. -/
def windowLen (n k Δ h : ℕ) : ℕ := n * ((Dbound k Δ + 1) * h + 3)

/-- The output `Ẑ = ∏ᵢ q̃_i⁻¹`. -/
def estimator (E : Finset (Finset V)) (σ : Fin (Fintype.card V) ≃ V)
    (hn : 0 < Fintype.card V) (k Δ : ℕ) (ε : ℝ) : ℝ :=
  ∏ i : Fin (Fintype.card V),
    (chainAbsentProb E (liveSet σ i) σ hn
      (windowLen (Fintype.card V) k Δ (hParam (Fintype.card V) ε)) (σ i))⁻¹

/-- Numerical consequence of the regime: `2^k ≥ 8 e Δ² k⁴ = 2 e D²`. [TowardsDerandomisingMarkovChain, node_11] -/
theorem param_numeric (k Δ : ℕ) (h : ParamRegime k Δ) :
    8 * Real.exp 1 * (Δ : ℝ) ^ 2 * (k : ℝ) ^ 4 ≤ (2 : ℝ) ^ k := by sorry

/-- Stationarity: the update preserves the uniform distribution on independent sets in
`U`: every independent `Y ⊆ U` has exactly two preimages `(X, b)`. [TowardsDerandomisingMarkovChain, node_11] -/
theorem update_preserves_uniform (E : Finset (Finset V)) (U : Finset V) (v : V)
    (Y : Finset V) (hY : Y ∈ indepSetsIn E U) :
    ((indepSetsIn E U ×ˢ (Finset.univ : Finset Bool)).filter
      (fun p => updateAt E U v p.2 p.1 = Y)).card = 2 := by sorry

/-- Coalescence tail (bound (1) + CFTP reconstruction): with `L = n((D+1)h+3)`, the
fraction of bit strings for which two independent starting sets inside `U` lead to
different final values at a live vertex `u` is at most `2^{-h}`. [TowardsDerandomisingMarkovChain, node_11] -/
theorem coalescence_tail (k Δ : ℕ) (hp : ParamRegime k Δ)
    (E : Finset (Finset V)) (hu : IsUniform E k) (hd : MaxDegreeLE E Δ)
    (σ : Fin (Fintype.card V) ≃ V) (hn : 0 < Fintype.card V)
    (U : Finset V) (u : V) (huU : u ∈ U) (h : ℕ) (hh : 1 ≤ h) :
    ((Finset.univ.filter (fun B : Fin (windowLen (Fintype.card V) k Δ h) → Bool =>
        ∃ X ∈ indepSetsIn E U, ∃ Y ∈ indepSetsIn E U,
          (u ∈ runChain E U σ hn X (extendBits B) (windowLen (Fintype.card V) k Δ h) ↔
            u ∉ runChain E U σ hn Y (extendBits B) (windowLen (Fintype.card V) k Δ h)))).card
      : ℝ) * (2 : ℝ) ^ h ≤ (2 : ℝ) ^ (windowLen (Fintype.card V) k Δ h) := by sorry

/-- Marginal lower bound `q_i ≥ 1/2` (deleting `v` injects sets containing `v` into
sets avoiding `v`). [TowardsDerandomisingMarkovChain, node_11] -/
theorem marginal_absent_ge_half (E : Finset (Finset V)) (U : Finset V) (v : V) :
    (1 : ℝ) / 2 ≤ absMarginal E U v := by sorry

/-- Self-reduction (4): `Z(H) = ∏ᵢ q_i⁻¹`. [TowardsDerandomisingMarkovChain, node_11] -/
theorem count_eq_prod_inv (E : Finset (Finset V)) (σ : Fin (Fintype.card V) ≃ V) :
    (Z E : ℝ) = ∏ i : Fin (Fintype.card V), (absMarginal E (liveSet σ i) (σ i))⁻¹ := by sorry

/-- Additive accuracy of the deterministic marginal estimate: `|q̃_i − q_i| ≤ 2^{-h}`. [TowardsDerandomisingMarkovChain, node_11] -/
theorem chainAbsentProb_close (k Δ : ℕ) (hp : ParamRegime k Δ)
    (E : Finset (Finset V)) (hu : IsUniform E k) (hd : MaxDegreeLE E Δ)
    (σ : Fin (Fintype.card V) ≃ V) (hn : 0 < Fintype.card V)
    (i : Fin (Fintype.card V)) (h : ℕ) (hh : 1 ≤ h) :
    |chainAbsentProb E (liveSet σ i) σ hn (windowLen (Fintype.card V) k Δ h) (σ i)
        - absMarginal E (liveSet σ i) (σ i)| ≤ ((2 : ℝ) ^ h)⁻¹ := by sorry

/-- Main theorem (deterministic FPTAS, value-level): the estimator satisfies
`(1-ε) Z(H) ≤ Ẑ ≤ (1+ε) Z(H)` for every `ε ∈ (0,1)`. [TowardsDerandomisingMarkovChain, node_11] -/
theorem fptas_estimate_correct (k Δ : ℕ) (hp : ParamRegime k Δ)
    (E : Finset (Finset V)) (hu : IsUniform E k) (hd : MaxDegreeLE E Δ)
    (σ : Fin (Fintype.card V) ≃ V) (hn : 0 < Fintype.card V)
    (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1) :
    (1 - ε) * (Z E : ℝ) ≤ estimator E σ hn k Δ ε ∧
      estimator E σ hn k Δ ε ≤ (1 + ε) * (Z E : ℝ) := by sorry

end TCSChallenge.TowardsDerandomisingMarkovChain.node_11
