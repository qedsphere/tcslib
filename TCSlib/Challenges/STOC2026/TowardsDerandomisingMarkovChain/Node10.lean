/-!
## Truncating an exact adaptive sampler: TV error equals the abort probability

The exact procedure `Resolve_∞(t)` explores earlier update times adaptively. At each
visited time `s` it reveals the outcome `ω s` (a lower-bound outcome `r_s` together with
the padding seed `u_s`). Outcomes are indexed by time, so a repeated query gets the
stored value back. Which time is queried next, and when to return a colour, may depend on
the whole revealed history. We model this as a strategy
`S.next : List (ℤ × Ω₀) → ℤ ⊕ Fin q`.

`ApproxResolve(t, K)` runs the same strategy on the same randomness, with one extra guard:
it aborts with output `⊥` once the number `|R|` of distinct queried times has reached `K`
and another query is requested.

Main theorem `dTV_approxResolve_eq_abortProb`: if the exact procedure terminates almost
surely with output law `μ_v` (the permitted background theorem), then
`d_TV(L(Y), μ_v) = Pr[E_trun(K)]`, where `μ_v` is extended by `μ_v(⊥) = 0`.

The proof does not condition on success; that would be biased, because whether the run
succeeds can depend on the output through the amount of exploration. Instead, both
executions run on the same time-indexed randomness:
* (invariant) until the guard fires, the budgeted run has exactly the exact run's history;
* (upper bound) so every non-aborting budgeted output agrees with the exact output, which
  gives `Pr[Y = c] ≤ μ_v(c)`, and the coupling inequality gives `d_TV ≤ Pr[E_trun]`;
* (lower bound) the test set `A = {⊥}` gives `d_TV ≥ Pr[E_trun]`.
-/

namespace TCSChallenge.TowardsDerandomisingMarkovChain.node_10

/-- The variable updated at time `s`: "`i(s) = 1 + (s mod n)`, the remainder in
`{0,…,n-1}`". With 0-based indices this is `s mod n`; `Int.emod` is nonnegative for
`n > 0`, and the outer `% n` only serves to supply the bound proof. -/
def varIndex (n : ℕ) (hn : 0 < n) (s : ℤ) : Fin n :=
  ⟨(s % (n : ℤ)).toNat % n, Nat.mod_lt _ hn⟩

/-- The marginal `μ_v` of a distribution `μ` on `[q]^V` (given by weights) at the variable
`v`: `μ_v(c) = ∑_{σ : σ(v) = c} μ(σ)`. -/
def marginal {n q : ℕ} (μ : (Fin n → Fin q) → ℝ) (v : Fin n) (c : Fin q) : ℝ :=
  ∑ σ ∈ Finset.univ.filter (fun σ : Fin n → Fin q => σ v = c), μ σ

/-- A distribution on `[q]` (weights `w`) seen as a distribution on `[q] ∪ {⊥}` with
"`μ_v(⊥) = 0`". `none` plays the role of `⊥`. -/
def extendBot {q : ℕ} (w : Fin q → ℝ) : Option (Fin q) → ℝ
  | none => 0
  | some c => w c

/-- Total variation distance on the finite alphabet `[q] ∪ {⊥}`:
"`d_TV(ν, η) = max_{A ⊆ [q] ∪ {⊥}} |ν(A) - η(A)|`". The supremum is over a finite type,
so it is a maximum. -/
def dTV {q : ℕ} (ν η : Option (Fin q) → ℝ) : ℝ :=
  ⨆ A : Finset (Option (Fin q)), |∑ a ∈ A, ν a - ∑ a ∈ A, η a|

/-- An adaptive, memoized exploration procedure. Given the revealed history (the list of
queried times with their outcomes, in query order), `next` either asks for the outcome at
another time (`Sum.inl s`) or returns a colour (`Sum.inr c`). Recursive calls, the
boundary subroutine and memoized update values are all functions of the history, so this
covers "the recursive exploration, including the boundary subroutine's choices, may
depend on the entire revealed history". Proof-free data. -/
structure Strategy (Ω₀ : Type) (q : ℕ) where
  next : List (ℤ × Ω₀) → ℤ ⊕ Fin q

/-- State of an execution: still running with a revealed history, or finished with output
`some c` (a colour) or `none` (`⊥`, i.e. aborted). -/
inductive ExecState (Ω₀ : Type) (q : ℕ) where
  | running : List (ℤ × Ω₀) → ExecState Ω₀ q
  | done : Option (Fin q) → ExecState Ω₀ q

/-- The set `R` of distinct queried update times in a history; `|R|` is its card. -/
def queriedTimes {Ω₀ : Type} (h : List (ℤ × Ω₀)) : Finset ℤ :=
  (h.map Prod.fst).toFinset

/-- One step of the exact procedure `Resolve_∞`. A query at time `s` reveals `ω s`. Since
the outcome is read from `ω`, a repeated query returns the same stored value
(memoization). -/
def exactStep {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (ω : ℤ → Ω₀) :
    ExecState Ω₀ q → ExecState Ω₀ q
  | .running h =>
      match S.next h with
      | .inl s => .running (h ++ [(s, ω s)])
      | .inr c => .done (some c)
  | .done o => .done o

/-- One step of `ApproxResolve(t, K)`: the same step as `exactStep`, except that "when the
guard detects `|R| ≥ K` before a successful return, it aborts the entire computation and
returns `⊥`". -/
def budgetStep {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (K : ℕ) (ω : ℤ → Ω₀) :
    ExecState Ω₀ q → ExecState Ω₀ q
  | .running h =>
      match S.next h with
      | .inl s =>
          if K ≤ (queriedTimes h).card then .done none
          else .running (h ++ [(s, ω s)])
      | .inr c => .done (some c)
  | .done o => .done o

/-- The state of the exact execution after `k` steps, starting from the empty history. -/
def exactState {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (ω : ℤ → Ω₀) :
    ℕ → ExecState Ω₀ q
  | 0 => .running []
  | k + 1 => exactStep S ω (exactState S ω k)

/-- The state of the budgeted execution after `k` steps, on the *same* randomness `ω`. -/
def budgetState {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (K : ℕ) (ω : ℤ → Ω₀) :
    ℕ → ExecState Ω₀ q
  | 0 => .running []
  | k + 1 => budgetStep S K ω (budgetState S K ω k)

/-- Event "`Resolve_∞(t)` returns the colour `c`". -/
def exactReturns {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (c : Fin q) : Set (ℤ → Ω₀) :=
  {ω | ∃ k, exactState S ω k = .done (some c)}

/-- Event "`Resolve_∞(t)` terminates". -/
def exactTerminates {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) : Set (ℤ → Ω₀) :=
  {ω | ∃ k c, exactState S ω k = .done (some c)}

/-- Event "`Y = ApproxResolve(t, K)` takes the value `y`" (`y = none` is `⊥`). -/
def budgetReturns {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (K : ℕ) (y : Option (Fin q)) :
    Set (ℤ → Ω₀) :=
  {ω | ∃ k, budgetState S K ω k = .done y}

/-- The truncation event `E_trun(K)`: the guard actually aborts the run. -/
def truncEvent {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (K : ℕ) : Set (ℤ → Ω₀) :=
  budgetReturns S K none

/-- The law `L(Y)` of `Y = ApproxResolve(t, K)` on `[q] ∪ {⊥}`, as a weight function. -/
def lawY {Ω₀ : Type} [MeasurableSpace Ω₀] {q : ℕ} (P : Measure (ℤ → Ω₀))
    (S : Strategy Ω₀ q) (K : ℕ) (y : Option (Fin q)) : ℝ :=
  (P (budgetReturns S K y)).toReal

/-- Measurability of the procedure: after each number of steps, the event "the exact run
is still running and its next action is `x`" is measurable. Without this clause a
non-measurable strategy could make probabilities meaningless. -/
def StrategyMeasurable {Ω₀ : Type} [MeasurableSpace Ω₀] {q : ℕ} (S : Strategy Ω₀ q) :
    Prop :=
  ∀ (k : ℕ) (x : ℤ ⊕ Fin q),
    MeasurableSet {ω : ℤ → Ω₀ | ∃ h, exactState S ω k = .running h ∧ S.next h = x}

/-! ### Rubric stubs -/

/-- Execution-prefix invariant (coupling on common time-indexed randomness). As long as
the budgeted run is still running, its history equals the exact run's history. So both
runs have chosen the same queries, seen the same outcomes and padding seeds, and hold
the same memoized values. [TowardsDerandomisingMarkovChain, node_10] -/
theorem budget_running_eq_exact {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (K : ℕ)
    (ω : ℤ → Ω₀) (k : ℕ) (h : List (ℤ × Ω₀))
    (hk : budgetState S K ω k = .running h) :
    exactState S ω k = .running h := by
  sorry

/-- Agreement before abort: if the budgeted run returns an ordinary colour, the exact run
on the same randomness returns the same colour. [TowardsDerandomisingMarkovChain, node_10] -/
theorem budget_success_subset_exact {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (K : ℕ)
    (c : Fin q) :
    budgetReturns S K (some c) ⊆ exactReturns S c := by
  sorry

/-- If the exact run terminates, the budgeted run on the same randomness terminates too,
either aborting or returning the same colour. [TowardsDerandomisingMarkovChain, node_10] -/
theorem budget_terminates_of_exact {Ω₀ : Type} {q : ℕ} (S : Strategy Ω₀ q) (K : ℕ)
    (ω : ℤ → Ω₀) (hω : ω ∈ exactTerminates S) :
    ω ∈ truncEvent S K ∨ ∃ c, ω ∈ budgetReturns S K (some c) := by
  sorry

/-- Upper bound via the coupling: `d_TV(L(Y), μ_v) ≤ Pr[E_trun(K)]`, using the
permitted exact-sampler theorem (`hterm`, `hcorrect`). [TowardsDerandomisingMarkovChain, node_10] -/
theorem dTV_le_truncProb {Ω₀ : Type} [MeasurableSpace Ω₀] {n q : ℕ}
    (P : Measure (ℤ → Ω₀)) [IsProbabilityMeasure P]
    (μ : (Fin n → Fin q) → ℝ) (v : Fin n) (S : Strategy Ω₀ q) (K : ℕ)
    (hSmeas : StrategyMeasurable S)
    (hterm : P (exactTerminates S) = 1)
    (hcorrect : ∀ c : Fin q, (P (exactReturns S c)).toReal = marginal μ v c) :
    dTV (lawY P S K) (extendBot (marginal μ v)) ≤ (P (truncEvent S K)).toReal := by
  sorry

/-- Sharpness: the test set `A = {⊥}` has probability `Pr[E_trun(K)]` under `L(Y)` and
probability `0` under the extended target, so `d_TV ≥ Pr[E_trun(K)]`. [TowardsDerandomisingMarkovChain, node_10] -/
theorem truncProb_le_dTV {Ω₀ : Type} [MeasurableSpace Ω₀] {n q : ℕ}
    (P : Measure (ℤ → Ω₀)) [IsProbabilityMeasure P]
    (μ : (Fin n → Fin q) → ℝ) (v : Fin n) (S : Strategy Ω₀ q) (K : ℕ) :
    (P (truncEvent S K)).toReal ≤ dTV (lawY P S K) (extendBot (marginal μ v)) := by
  sorry

/-! ### Main theorem -/

/-- **Truncation identity.** Let `-n < t ≤ 0` and `v = v_{i(t)}`. The time-indexed
randomness `ω s` (lower-bound outcome and padding seed at time `s`) is independent across
times with common law `ρ`. Assume the permitted correctness theorem for `Resolve_∞(t)`:
it terminates almost surely (`hterm`) and returns a value with law `μ_v` (`hcorrect`).
Then, for every `K`, `d_TV(L(ApproxResolve(t, K)), μ_v) = Pr[E_trun(K)]`. [TowardsDerandomisingMarkovChain, node_10] -/
theorem dTV_approxResolve_eq_abortProb {Ω₀ : Type} [MeasurableSpace Ω₀] {n q : ℕ}
    (hn : 0 < n) (_hq : 0 < q)
    (t : ℤ) (_ht₁ : -(n : ℤ) < t) (_ht₂ : t ≤ 0)
    (μ : (Fin n → Fin q) → ℝ)
    (ρ : Measure Ω₀) [IsProbabilityMeasure ρ]
    (P : Measure (ℤ → Ω₀)) [IsProbabilityMeasure P]
    (_hind : iIndepFun (fun (s : ℤ) (ω : ℤ → Ω₀) => ω s) P)
    (_hlaw : ∀ s : ℤ, P.map (fun ω : ℤ → Ω₀ => ω s) = ρ)
    (S : Strategy Ω₀ q) (hSmeas : StrategyMeasurable S)
    (hterm : P (exactTerminates S) = 1)
    (hcorrect : ∀ c : Fin q,
      (P (exactReturns S c)).toReal = marginal μ (varIndex n hn t) c)
    (K : ℕ) :
    dTV (lawY P S K) (extendBot (marginal μ (varIndex n hn t)))
      = (P (truncEvent S K)).toReal := by
  sorry

