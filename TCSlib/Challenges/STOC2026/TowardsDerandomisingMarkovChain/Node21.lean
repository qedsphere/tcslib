/-!
## Deterministic counting of colourings of linear hypergraphs

For `δ > 0`, `k ≥ 50(1+δ)²/δ²`, `Δ ≥ 2`, `Δ ≤ (q/50)^{(k-3)/(2+δ)}`, and a `k`-uniform
linear hypergraph `H` of maximum degree `≤ Δ`, the paper approximates `Z(H,q)` within
`(1 ± ε)` deterministically. Colours are grouped into `K = ⌊√q⌋` classes; a projected
heat-bath chain on class assignments has a state-independent lower bound (2) on its
update law, which drives a CFTP-style local evaluation with logarithmically many random
choices; fine-colour marginals are recovered by conditioning on the projected state,
and `Z = q^n ∏ p_i` with `p_i ≥ 1/2`.

Main theorem `fptas_estimate_correct`: there is a constant `C = C(δ,k,Δ,q)` such that,
for windows of `T ≥ C n (⌈log₂((m+1)/ε)⌉ + 1)` updates, the estimator
`q^n ∏ᵢ p̂_i` built from the projected chain is a `(1 ± ε)` approximation of `Z(H,q)`.
-/

namespace TCSChallenge.TowardsDerandomisingMarkovChain.node_21

variable {V : Type} [Fintype V] [DecidableEq V]

/-! ## Hypergraphs and colourings -/

/-- "every edge contains exactly k vertices" -/
def IsUniform {m : ℕ} (edge : Fin m → Finset V) (k : ℕ) : Prop := ∀ j, (edge j).card = k

/-- "any two distinct edges intersect in at most one vertex" -/
def IsLinear {m : ℕ} (edge : Fin m → Finset V) : Prop :=
  ∀ i j : Fin m, i ≠ j → (edge i ∩ edge j).card ≤ 1

/-- `Δ(H) = max_v |{e ∈ E : v ∈ e}| ≤ Δ` -/
def MaxDegreeLE {m : ℕ} (edge : Fin m → Finset V) (Δ : ℕ) : Prop :=
  ∀ v : V, (Finset.univ.filter (fun j : Fin m => v ∈ edge j)).card ≤ Δ

/-- Parameter regime: `δ > 0`, `k ≥ 50(1+δ)²/δ²`, `Δ ≥ 2`, `Δ ≤ (q/50)^{(k−3)/(2+δ)}`,
`k, q` positive. -/
def ParamRegime (δ : ℝ) (k Δ q : ℕ) : Prop :=
  0 < δ ∧ 1 ≤ k ∧ 1 ≤ q ∧ 50 * (1 + δ) ^ 2 / δ ^ 2 ≤ (k : ℝ) ∧ 2 ≤ Δ ∧
    (Δ : ℝ) ≤ ((q : ℝ) / 50) ^ (((k : ℝ) - 3) / (2 + δ))

/-- `σ|_e` is monochromatic. -/
def IsMono {q : ℕ} (e : Finset V) (σ : V → Fin q) : Prop :=
  ∃ c : Fin q, ∀ v ∈ e, σ v = c

/-- `σ` is proper on the edges indexed by `A`. -/
def ProperOn {m q : ℕ} (edge : Fin m → Finset V) (A : Finset (Fin m)) (σ : V → Fin q) : Prop :=
  ∀ j ∈ A, ¬ IsMono (edge j) σ

/-- The first `i` edges: the edge set of `H_i`. -/
def firstEdges (m i : ℕ) : Finset (Fin m) := Finset.univ.filter (fun j : Fin m => j.val < i)

/-- Number of proper colourings w.r.t. the edges in `A`. -/
def Zon {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (A : Finset (Fin m)) : ℕ :=
  (Finset.univ.filter (fun σ : V → Fin q => ProperOn edge A σ)).card

/-- `Z(H, q)`. -/
def Z {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) : ℕ := Zon edge q Finset.univ

/-- `p_i`: probability that `e_i` is not monochromatic under a uniform proper colouring
of `H_{i-1}`. -/
def acceptProb {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (i : Fin m) : ℝ :=
  ((Finset.univ.filter (fun σ : V → Fin q =>
      ProperOn edge (firstEdges m i.val) σ ∧ ¬ IsMono (edge i) σ)).card : ℝ) /
    (Zon edge q (firstEdges m i.val) : ℝ)

/-! ## Colour classes and the projected chain -/

/-- Number of classes `K = ⌊√q⌋`. -/
def numClasses (q : ℕ) : ℕ := ⌊Real.sqrt (q : ℝ)⌋₊

/-- The class map `h`: colour `c` goes to class `c mod K` (class sizes differ by ≤ 1). -/
def cls (q : ℕ) (c : Fin q) : ℕ := c.val % numClasses q

/-- Fine colourings proper on `A` whose projection agrees with `Y` away from `v` and
puts `v` in class `c`. -/
def extCount {m q : ℕ} (edge : Fin m → Finset V) (A : Finset (Fin m)) (Y : V → ℕ) (v : V)
    (c : ℕ) : ℕ :=
  (Finset.univ.filter (fun σ : V → Fin q =>
      ProperOn edge A σ ∧ (∀ u, u ≠ v → cls q (σ u) = Y u) ∧ cls q (σ v) = c)).card

/-- Projected heat-bath conditional `P_v(c)` given the classes `Y` away from `v`. -/
def condClass {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (A : Finset (Fin m)) (Y : V → ℕ)
    (v : V) (c : ℕ) : ℝ :=
  (extCount (q := q) edge A Y v c : ℝ) /
    (∑ c' ∈ Finset.range (numClasses q), (extCount (q := q) edge A Y v c' : ℝ))

/-- State-independent weight `b_c = |h⁻¹(c)|/q · (1 − 1/(4K))`. -/
def baseWeight (q : ℕ) (c : ℕ) : ℝ :=
  ((Finset.univ.filter (fun x : Fin q => cls q x = c)).card : ℝ) / (q : ℝ) *
    (1 - 1 / (4 * (numClasses q : ℝ)))

/-- Slot weights of the grand coupling: slots `0..K-1` carry `b_c` (the variable
`r = c`), slots `K..2K-1` carry the residual mass `P_v(c) − b_c` (the case `r = ⊥`). -/
def slotWeight {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (A : Finset (Fin m)) (Y : V → ℕ)
    (v : V) (s : ℕ) : ℝ :=
  if s < numClasses q then baseWeight q s
  else condClass edge q A Y v (s - numClasses q) - baseWeight q (s - numClasses q)

/-- Inverse-CDF selection: the least slot `s < N` with `x < w 0 + … + w s`
(default `N - 1`). -/
def pick (w : ℕ → ℝ) (N : ℕ) (x : ℝ) : ℕ :=
  ((List.range N).find? (fun s => decide (x < ∑ s' ∈ Finset.range (s + 1), w s'))).getD (N - 1)

/-- One projected heat-bath update at `v` driven by the uniform `x ∈ [0,1)`. -/
def projUpdate {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (A : Finset (Fin m)) (v : V)
    (x : ℝ) (Y : V → ℕ) : V → ℕ :=
  Function.update Y v (pick (slotWeight edge q A Y v) (2 * numClasses q) x % numClasses q)

/-- Cyclic schedule: vertex `σ (t mod n)` is updated at time `t`. -/
def schedule (σ : Fin (Fintype.card V) ≃ V) (hn : 0 < Fintype.card V) (t : ℕ) : V :=
  σ ⟨t % Fintype.card V, Nat.mod_lt _ hn⟩

/-- Forward projected chain from `Y0`, using uniform `u t` at time `t`. -/
def projRun {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (A : Finset (Fin m))
    (σ : Fin (Fintype.card V) ≃ V) (hn : 0 < Fintype.card V) (Y0 : V → ℕ) (u : ℕ → ℝ) :
    ℕ → (V → ℕ)
  | 0 => Y0
  | t + 1 => projUpdate edge q A (schedule σ hn t) (u t) (projRun edge q A σ hn Y0 u t)

/-- Extend a finite tuple of uniforms by `0` (unused). -/
def extendU {T : ℕ} (u : Fin T → ℝ) (t : ℕ) : ℝ := if h : t < T then u ⟨t, h⟩ else 0

/-- The unit cube `[0,1)^T`, carrying Lebesgue measure (a probability measure). -/
def unitCube (T : ℕ) : Set (Fin T → ℝ) := Set.pi Set.univ (fun _ => Set.Ico (0 : ℝ) 1)

/-- Conditional probability, given the class assignment `Y`, that `f` is not
monochromatic under a uniform proper colouring of `A` projecting to `Y`. -/
def condNotMono {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (A : Finset (Fin m)) (Y : V → ℕ)
    (f : Finset V) : ℝ :=
  ((Finset.univ.filter (fun σ : V → Fin q =>
      ProperOn edge A σ ∧ (∀ u, cls q (σ u) = Y u) ∧ ¬ IsMono f σ)).card : ℝ) /
    ((Finset.univ.filter (fun σ : V → Fin q =>
      ProperOn edge A σ ∧ (∀ u, cls q (σ u) = Y u))).card : ℝ)

/-- `p̂_i`: expectation over the window-`T` projected chain on `H_{i-1}` (started from
the all-zero class assignment) of the conditional non-monochromatic probability of `e_i`. -/
def acceptEst {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (σ : Fin (Fintype.card V) ≃ V)
    (hn : 0 < Fintype.card V) (T : ℕ) (i : Fin m) : ℝ :=
  ∫ u in unitCube T,
    condNotMono edge q (firstEdges m i.val)
      (projRun edge q (firstEdges m i.val) σ hn (fun _ => 0) (extendU u) T) (edge i)

/-- `Ẑ = q^n ∏ᵢ p̂_i`. -/
def estimator {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (σ : Fin (Fintype.card V) ≃ V)
    (hn : 0 < Fintype.card V) (T : ℕ) : ℝ :=
  (q : ℝ) ^ Fintype.card V * ∏ i : Fin m, acceptEst edge q σ hn T i

/-! ## Lemma stubs -/

/-- Numerical bound (1): with `s = ⌊q/K⌋`, `s^{k-1}/K ≥ 16 e k Δ`. [TowardsDerandomisingMarkovChain, node_21] -/
theorem param_numeric (δ : ℝ) (k Δ q : ℕ) (hp : ParamRegime δ k Δ q) :
    16 * Real.exp 1 * (k : ℝ) * Δ ≤
      ((q / numClasses q : ℕ) : ℝ) ^ (k - 1) / (numClasses q : ℝ) := by sorry

/-- Feasibility (list local lemma): every class assignment has a proper fine extension. [TowardsDerandomisingMarkovChain, node_21] -/
theorem projected_feasible (δ : ℝ) (k Δ q : ℕ) (hp : ParamRegime δ k Δ q) {m : ℕ}
    (edge : Fin m → Finset V) (hu : IsUniform edge k) (hl : IsLinear edge)
    (hd : MaxDegreeLE edge Δ) (A : Finset (Fin m)) (Y : V → ℕ)
    (hY : ∀ v, Y v < numClasses q) :
    ∃ σ : V → Fin q, ProperOn edge A σ ∧ ∀ v, cls q (σ v) = Y v := by sorry

/-- State-independent lower bound (2): `P_v(c) ≥ b_c` for every class assignment. [TowardsDerandomisingMarkovChain, node_21] -/
theorem projected_lower_bound (δ : ℝ) (k Δ q : ℕ) (hp : ParamRegime δ k Δ q) {m : ℕ}
    (edge : Fin m → Finset V) (hu : IsUniform edge k) (hl : IsLinear edge)
    (hd : MaxDegreeLE edge Δ) (A : Finset (Fin m)) (Y : V → ℕ)
    (hY : ∀ v, Y v < numClasses q) (v : V) (c : ℕ) (hc : c < numClasses q) :
    baseWeight q c ≤ condClass edge q A Y v c := by sorry

/-- Coalescence with logarithmic window (tail bound (5)/(11) and the backward evaluation
with screening of certified crossing edges): there is `C = C(δ,k,Δ,q)`, independent of
the hypergraph, such that for `T ≥ C n (⌈log₂(1/η)⌉ + 1)` the set of uniforms for which
two class-assignment starts lead to different conditional probabilities that `f` is not
monochromatic has measure at most `η`. [TowardsDerandomisingMarkovChain, node_21] -/
theorem coalescence_tail (δ : ℝ) (k Δ q : ℕ) (hp : ParamRegime δ k Δ q) :
    ∃ C : ℕ, ∀ {W : Type} [Fintype W] [DecidableEq W] {m : ℕ} (edge : Fin m → Finset W),
      IsUniform edge k → IsLinear edge →
      MaxDegreeLE edge Δ → ∀ (A : Finset (Fin m)) (f : Fin m), f ∉ A →
      ∀ (σ : Fin (Fintype.card W) ≃ W) (hn : 0 < Fintype.card W) (η : ℝ), 0 < η → η < 1 →
      ∀ T : ℕ, C * Fintype.card W * (⌈Real.logb 2 (1 / η)⌉₊ + 1) ≤ T →
        volume (unitCube T ∩ {u | ∃ Y0 Y1 : W → ℕ, (∀ v, Y0 v < numClasses q) ∧
            (∀ v, Y1 v < numClasses q) ∧
              condNotMono edge q A (projRun edge q A σ hn Y0 (extendU u) T) (edge f) ≠
                condNotMono edge q A (projRun edge q A σ hn Y1 (extendU u) T) (edge f)})
          ≤ ENNReal.ofReal η := by sorry

/-- Fine-marginal recovery: averaging the conditional probability over the projected
law `ψ` of `h(X)` gives back `p_i`. [TowardsDerandomisingMarkovChain, node_21] -/
theorem projection_marginal {m : ℕ} (edge : Fin m → Finset V) (q : ℕ) (i : Fin m)
    (hZ : 0 < Zon edge q (firstEdges m i.val)) :
    acceptProb edge q i =
      ∑ Y ∈ Fintype.piFinset (fun _ : V => Finset.range (numClasses q)),
        ((Finset.univ.filter (fun σ : V → Fin q =>
            ProperOn edge (firstEdges m i.val) σ ∧ ∀ u, cls q (σ u) = Y u)).card : ℝ) /
          (Zon edge q (firstEdges m i.val) : ℝ) *
        condNotMono edge q (firstEdges m i.val) Y (edge i) := by sorry

/-- Acceptance lower bound: `p_i ≥ 1/2` (and `Z(H_{i-1}) > 0`). [TowardsDerandomisingMarkovChain, node_21] -/
theorem acceptProb_ge_half (δ : ℝ) (k Δ q : ℕ) (hp : ParamRegime δ k Δ q) {m : ℕ}
    (edge : Fin m → Finset V) (hu : IsUniform edge k) (hl : IsLinear edge)
    (hd : MaxDegreeLE edge Δ) (i : Fin m) :
    0 < Zon edge q (firstEdges m i.val) ∧ (1 : ℝ) / 2 ≤ acceptProb edge q i := by sorry

/-- Product formula (13): `Z(H, q) = q^n ∏ᵢ p_i`. [TowardsDerandomisingMarkovChain, node_21] -/
theorem count_eq_prod (δ : ℝ) (k Δ q : ℕ) (hp : ParamRegime δ k Δ q) {m : ℕ}
    (edge : Fin m → Finset V) (hu : IsUniform edge k) (hl : IsLinear edge)
    (hd : MaxDegreeLE edge Δ) :
    (Z edge q : ℝ) = (q : ℝ) ^ Fintype.card V * ∏ i : Fin m, acceptProb edge q i := by sorry

/-! ## Main theorem -/

/-- Deterministic FPTAS, value-level: for a constant `C = C(δ,k,Δ,q)` and any window
`T ≥ C n (⌈log₂((m+1)/ε)⌉ + 1)`, the estimator satisfies
`(1−ε) Z(H,q) ≤ Ẑ ≤ (1+ε) Z(H,q)`. [TowardsDerandomisingMarkovChain, node_21] -/
theorem fptas_estimate_correct (δ : ℝ) (k Δ q : ℕ) (hp : ParamRegime δ k Δ q) :
    ∃ C : ℕ, ∀ {W : Type} [Fintype W] [DecidableEq W] {m : ℕ} (edge : Fin m → Finset W),
      IsUniform edge k → IsLinear edge →
      MaxDegreeLE edge Δ → ∀ (σ : Fin (Fintype.card W) ≃ W) (hn : 0 < Fintype.card W)
      (ε : ℝ), 0 < ε → ε < 1 →
      ∀ T : ℕ, C * Fintype.card W * (⌈Real.logb 2 (((m : ℝ) + 1) / ε)⌉₊ + 1) ≤ T →
        (1 - ε) * (Z edge q : ℝ) ≤ estimator edge q σ hn T ∧
          estimator edge q σ hn T ≤ (1 + ε) * (Z edge q : ℝ) := by sorry

end TCSChallenge.TowardsDerandomisingMarkovChain.node_21
