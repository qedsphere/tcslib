/-!
## The Skolem problem in finitely presented rings of positive characteristic

The input is a finitely presented commutative ring
`R ≅ (ℤ/Tℤ)[X_1,…,X_N] / I` with `T > 0` and `I` given by finitely many
generators, together with a linear recurrence
`γ_n = ∑_{j=1}^d a_j γ_{n-j}` (`n ≥ d`), `d ≥ 1`, `a_d ≠ 0`, given by its
coefficients and initial values (all as polynomials representing elements of
`R`). The main theorem `skolem_positive_char_decidable` says that the question
`∃ n, γ_n = 0` is decidable: there is a computable Boolean function on encoded
inputs that answers it correctly on every well-formed input.

Lemma stubs follow the proof strategy:
* `zero_iff_primePower_images` — the ideals `p_i^{e_i} R` intersect in `T R = 0`;
* `zeroSet_eq_iInter` — hence `𝒵(γ) = ⋂_i 𝒵(γ mod p_i^{e_i})`;
* `primePower_zeroSet_pNormal` — each `𝒵(γ mod p_i^{e_i})` is `p_i`-normal;
* `inter_pNormal_qNormal` — synchronization of two independent bases;
* `inter_normalUnion` — the `k`-fold intersection is a finite union of sets,
  each normal in one of the bases.
-/

namespace TCSChallenge.TheSkolemProblemInRingsOfPositiveCharacteristic.node_04

open MvPolynomial

/-! ## Encoded inputs -/

/-- An encoded polynomial: a list of monomials `(exponent list, coefficient)`.
The `i`-th entry of the exponent list is the exponent of `X_i`. -/
abbrev Poly : Type := List (List ℕ × ℕ)

/-- An encoded instance `(T, N, generators of I, [a_1,…,a_d], [γ_0,…,γ_{d-1}])`.
A product of lists and naturals, hence `Primcodable`. -/
abbrev Input : Type := ℕ × ℕ × List Poly × List Poly × List Poly

/-- The characteristic `T`. -/
def Input.T (x : Input) : ℕ := x.1
/-- The number of variables `N`. -/
def Input.N (x : Input) : ℕ := x.2.1
/-- Generators of the ideal `I`. -/
def Input.gens (x : Input) : List Poly := x.2.2.1
/-- Recurrence coefficients `[a_1, …, a_d]`. -/
def Input.coeffs (x : Input) : List Poly := x.2.2.2.1
/-- Initial values `[γ_0, …, γ_{d-1}]`. -/
def Input.init (x : Input) : List Poly := x.2.2.2.2
/-- The order `d` of the recurrence. -/
def Input.d (x : Input) : ℕ := x.coeffs.length

/-- Decoding an encoded polynomial into `(ℤ/Tℤ)[X_1,…,X_N]`. -/
def polyOf (T N : ℕ) (P : Poly) : MvPolynomial (Fin N) (ZMod T) :=
  (P.map fun m => C ((m.2 : ℕ) : ZMod T) * ∏ i : Fin N, X i ^ (m.1.getD i.val 0)).sum

/-- The presented ring `R = (ℤ/Tℤ)[X_1,…,X_N] / I`. -/
abbrev PRing (x : Input) : Type :=
  MvPolynomial (Fin x.N) (ZMod x.T) ⧸
    Ideal.span {g | ∃ P ∈ x.gens, g = polyOf x.T x.N P}

/-- The element of `R` represented by an encoded polynomial. -/
def elemOf (x : Input) (P : Poly) : PRing x :=
  Ideal.Quotient.mk _ (polyOf x.T x.N P)

/-- The recurrence `γ_n = ∑_{j=1}^d a_j γ_{n-j}` written as a Mathlib
`LinearRecurrence`: `γ_{n+d} = ∑_{i<d} c_i γ_{n+i}` with `c_i = a_{d-i}`. -/
def recurrence (x : Input) : LinearRecurrence (PRing x) where
  order := x.d
  coeffs := fun i => elemOf x (x.coeffs.getD (x.d - 1 - i.val) [])

/-- The sequence `γ` determined by the initial values and the recurrence. -/
def seq (x : Input) : ℕ → PRing x :=
  (recurrence x).mkSol fun i => elemOf x (x.init.getD i.val [])

/-- Well-formed inputs: `T > 0`, `d ≥ 1`, `d` initial values, and `a_d ≠ 0` in `R`. -/
def WellFormed (x : Input) : Prop :=
  0 < x.T ∧ 1 ≤ x.d ∧ x.init.length = x.d ∧
    elemOf x (x.coeffs.getD (x.d - 1) []) ≠ 0

/-- The zero set `𝒵(γ) = {n ∈ ℕ : γ_n = 0}`. -/
def zeroSet (x : Input) : Set ℕ := {n | seq x n = 0}

/-- The zero set of `γ mod p^e` with `e = v_p(T)`: indices where `γ_n ∈ p^e R`. -/
def zeroSetMod (x : Input) (p : ℕ) : Set ℕ :=
  {n | seq x n ∈ Ideal.span {(((p ^ x.T.factorization p : ℕ) : PRing x))}}

/-! ## p-normal sets -/

/-- Data of an elementary nested set
`{u_0 + ∑_{j=1}^r p^{ℓ k_j} u_j : k_1,…,k_r ∈ ℕ}`. -/
structure NestedData where
  r : ℕ
  ell : ℕ
  u0 : ℚ
  u : Fin r → ℚ

/-- The value `u_0 + ∑_j p^{ℓ k_j} u_j`. -/
def NestedData.value (D : NestedData) (p : ℕ) (k : Fin D.r → ℕ) : ℚ :=
  D.u0 + ∑ j, ((p : ℚ) ^ (D.ell * k j)) * D.u j

/-- "where `r ≥ 0`, `ℓ ≥ 1`, the `u_j` are rational, and all displayed values are
integral". -/
def NestedData.Valid (D : NestedData) (p : ℕ) : Prop :=
  1 ≤ D.ell ∧ ∀ k : Fin D.r → ℕ, ∃ z : ℤ, D.value p k = z

/-- The elementary `p`-nested subset of `ℤ`. -/
def NestedData.toSet (D : NestedData) (p : ℕ) : Set ℤ :=
  {z | ∃ k : Fin D.r → ℕ, (z : ℚ) = D.value p k}

/-- "A set `S ⊆ ℕ` is `p`-normal if, after changing finitely many initial values,
it is the intersection with `ℕ` of a finite union of elementary `p`-nested sets and
arithmetic progressions." Arithmetic progressions are `{a + b m : m ∈ ℕ}`. -/
def IsPNormal (p : ℕ) (S : Set ℕ) : Prop :=
  ∃ (nested : List NestedData) (aps : List (ℤ × ℕ)),
    (∀ D ∈ nested, D.Valid p) ∧
    ∃ M : ℕ, ∀ n : ℕ, M ≤ n →
      (n ∈ S ↔ ((∃ D ∈ nested, (n : ℤ) ∈ D.toSet p) ∨
                 ∃ ap ∈ aps, ∃ m : ℕ, (n : ℤ) = ap.1 + (ap.2 : ℤ) * m))

/-- A finite union of sets, each normal in one of the bases `p ∈ P`. -/
def IsNormalUnion (P : Finset ℕ) (S : Set ℕ) : Prop :=
  ∃ parts : List (ℕ × Set ℕ),
    (∀ q ∈ parts, q.1 ∈ P ∧ IsPNormal q.1 q.2) ∧
    S = {n | ∃ q ∈ parts, n ∈ q.2}

/-! ## Lemma stubs -/

/-- Composite-characteristic reduction: in a commutative ring with `T = 0`, `T > 0`,
an element is zero iff it lies in every `p^{v_p(T)} R` (these ideals are pairwise
comaximal and intersect in `T R = 0`). [TheSkolemProblemIn, node_04] -/
theorem zero_iff_primePower_images (A : Type) [CommRing A] (T : ℕ) (hT : 0 < T)
    (hTA : (T : A) = 0) (a : A) :
    a = 0 ↔ ∀ p ∈ T.primeFactors, a ∈ Ideal.span {((p ^ T.factorization p : ℕ) : A)} := by
  sorry

/-- `𝒵(γ) = ⋂_i 𝒵(γ mod p_i^{e_i})`. [TheSkolemProblemIn, node_04] -/
theorem zeroSet_eq_iInter (x : Input) (hx : WellFormed x) :
    zeroSet x = {n | ∀ p ∈ x.T.primeFactors, n ∈ zeroSetMod x p} := by
  sorry

/-- Prime-power analysis: for each prime `p ∣ T`, the zero set of `γ mod p^{v_p(T)}`
is `p`-normal (effectively so in the paper; effectiveness not captured here). [TheSkolemProblemIn, node_04] -/
theorem primePower_zeroSet_pNormal (x : Input) (hx : WellFormed x) (p : ℕ)
    (hp : p ∈ x.T.primeFactors) : IsPNormal p (zeroSetMod x p) := by
  sorry

/-- Independent-base synchronization: the intersection of a `p`-normal and a
`q`-normal set (`p ≠ q` primes) is the union of a `p`-normal and a `q`-normal set. [TheSkolemProblemIn, node_04] -/
theorem inter_pNormal_qNormal (p q : ℕ) (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q)
    (S S' : Set ℕ) (hS : IsPNormal p S) (hS' : IsPNormal q S') :
    ∃ A B : Set ℕ, IsPNormal p A ∧ IsPNormal q B ∧ S ∩ S' = A ∪ B := by
  sorry

/-- Extension to `k` bases: an intersection over distinct primes `p ∈ P` of
`p`-normal sets is a finite union of sets each normal in some base `p ∈ P`. [TheSkolemProblemIn, node_04] -/
theorem inter_normalUnion (P : Finset ℕ) (hP : ∀ p ∈ P, p.Prime) (S : ℕ → Set ℕ)
    (hS : ∀ p ∈ P, IsPNormal p (S p)) :
    IsNormalUnion P {n | ∀ p ∈ P, n ∈ S p} := by
  sorry

/-! ## Main theorem -/

/-- **Decidability of the Skolem problem in rings of positive characteristic.**
There is a computable decider which, on every well-formed encoded instance,
answers whether `𝒵(γ) ≠ ∅`, i.e. whether `γ_n = 0` for some `n`. [TheSkolemProblemIn, node_04] -/
theorem skolem_positive_char_decidable :
    ∃ f : Input → Bool, Computable f ∧
      ∀ x : Input, WellFormed x → (f x = true ↔ ∃ n : ℕ, seq x n = 0) := by
  sorry

end TCSChallenge.TheSkolemProblemInRingsOfPositiveCharacteristic.node_04
