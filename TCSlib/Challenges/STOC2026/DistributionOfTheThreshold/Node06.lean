open scoped Classical
open MeasureTheory ProbabilityTheory NNReal
open BooleanAnalysis.ThresholdFunctions

/-!
## The satisfiability threshold of the symmetric binary perceptron is a log-normal Gumbel mixture

Fix `κ > 0`. Let `G_1, G_2, …` be i.i.d. `N(0, I_n)` vectors and
`S^t = {x ∈ {±1}^n : |⟨G_j, x⟩| ≤ κ √n for 1 ≤ j ≤ t}`, `τ = inf {t ≥ 1 : S^t = ∅}`.
With `p = P(|Z| ≤ κ)`, `α_c = -log 2 / log p`, `μ₂ = E[Z² 1{|Z| ≤ κ}]/p`,
`β = -(√α_c / 2)(1 - μ₂)`, the main theorem `threshold_distribution` says: there is
`θ > 0` such that for all large `n` and every real `k` with `k + α_c n ∈ ℤ`,

  `|P(τ ≤ k + α_c n) - E exp(-e^{Z*} p^k / 2)| ≤ n^{-θ}`,
  `Z* ~ N((1/4) log(1 - 4β²), -(1/2) log(1 - 4β²))`.

The supplied overlap estimate and the smooth Gaussian approximation of the cycle
statistics `C_r` (unconditionally and conditionally on `1_n ∈ S^m`) are hypotheses.
-/

namespace TCSChallenge.DistributionOfTheThreshold.node_06

/-! ## Gaussian constants -/

/-- `p = P(|Z| ≤ κ)` for a standard normal `Z`. -/
def pK (κ : ℝ) : ℝ := (standardGaussianMeasure (Set.Icc (-κ) κ)).toReal

/-- `α_c = -log 2 / log p`. -/
def alphaC (κ : ℝ) : ℝ := -Real.log 2 / Real.log (pK κ)

/-- `μ₂ = E[Z² 1{|Z| ≤ κ}] / p`. -/
def mu2 (κ : ℝ) : ℝ := (∫ z in Set.Icc (-κ) κ, z ^ 2 ∂standardGaussianMeasure) / pK κ

/-- `β = -(√α_c / 2)(1 - μ₂)`. -/
def betaK (κ : ℝ) : ℝ := -(Real.sqrt (alphaC κ) / 2) * (1 - mu2 κ)

/-! ## The random constraint satisfaction problem -/

/-- A point of `Σ_n = {-1, 1}^n` is encoded as `Fin n → Bool`; `spin` gives its `±1` value. -/
def spin (b : Bool) : ℝ := if b then 1 else -1

/-- `⟨G_j, x⟩ = ∑_i G_{j,i} x_i` for a realization `G : ℕ → Fin n → ℝ` of the constraints. -/
def pairing {n : ℕ} (G : ℕ → Fin n → ℝ) (j : ℕ) (x : Fin n → Bool) : ℝ :=
  ∑ i, G j i * spin (x i)

/-- `S^t = {x ∈ Σ_n : |⟨G_j, x⟩| ≤ κ√n for the first t constraints}` (constraints are
0-indexed here: the paper's `G_1, …, G_t` are `G 0, …, G (t-1)`); `S^0 = Σ_n`. -/
def survivors (κ : ℝ) {n : ℕ} (G : ℕ → Fin n → ℝ) (t : ℕ) : Finset (Fin n → Bool) :=
  Finset.univ.filter (fun x => ∀ j, j < t → |pairing G j x| ≤ κ * Real.sqrt n)

/-- The event `τ ≤ t` for an integer `t`, where `τ = inf {s ≥ 1 : S^s = ∅}` (`inf ∅ = ∞`). -/
def tauLE (κ : ℝ) {n : ℕ} (G : ℕ → Fin n → ℝ) (t : ℤ) : Prop :=
  ∃ s : ℕ, 1 ≤ s ∧ (s : ℤ) ≤ t ∧ survivors κ G s = ∅

/-- The all-ones configuration `1_n`. -/
def allOnes (n : ℕ) : Fin n → Bool := fun _ => true

/-! ## The supplied analytic overlap estimate -/

/-- `h(u) = -u log u - (1-u) log(1-u)` with `0 log 0 = 0`. -/
def binEntropy (u : ℝ) : ℝ := Real.negMulLog u + Real.negMulLog (1 - u)

/-- `q_κ(ρ) = P(|Z| ≤ κ, |ρZ + √(1-ρ²) Z'| ≤ κ)` for independent standard normals `Z, Z'`. -/
def qOverlap (κ ρ : ℝ) : ℝ :=
  ((standardGaussianMeasure.prod standardGaussianMeasure)
    {z : ℝ × ℝ | |z.1| ≤ κ ∧ |ρ * z.1 + Real.sqrt (1 - ρ ^ 2) * z.2| ≤ κ}).toReal

/-- Supplied estimate 1: some `c_κ > 0` satisfies
`log 2 + h((1+ρ)/2) + α_c log q_κ(ρ) ≤ -c_κ min{ρ², √(1-|ρ|)}` for `-1 ≤ ρ ≤ 1`. -/
def OverlapEstimate (κ : ℝ) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∀ ρ : ℝ, -1 ≤ ρ → ρ ≤ 1 →
    Real.log 2 + binEntropy ((1 + ρ) / 2) + alphaC κ * Real.log (qOverlap κ ρ)
      ≤ -c * min (ρ ^ 2) (Real.sqrt (1 - |ρ|))

/-! ## Cycle statistics and the supplied Gaussian approximation -/

/-- `m = ⌊α_c n - η log n⌋` (natural floor; positive for large `n`). -/
def mNum (κ η : ℝ) (n : ℕ) : ℕ := ⌊alphaC κ * n - η * Real.log n⌋₊

/-- `K = ⌈η log n⌉`. -/
def KNum (η : ℝ) (n : ℕ) : ℕ := ⌈η * Real.log n⌉₊

/-- `C_r = (mn)^{-r/2} ∑_{i distinct, j distinct} ∏_ℓ G_{j_ℓ,i_ℓ} G_{j_ℓ,i_{ℓ+1}} - 1{r=1} √(mn)`,
with `i_{r+1} = i_1` (cyclic successor `finRotate r`), `i_ℓ ∈ [n]`, `j_ℓ ∈ [m]`. -/
def cycleStat {n : ℕ} (m : ℕ) (G : ℕ → Fin n → ℝ) (r : ℕ) : ℝ :=
  ((m : ℝ) * n) ^ (-((r : ℝ) / 2)) *
    (∑ i ∈ Finset.univ.filter (fun i : Fin r → Fin n => Function.Injective i),
      ∑ j ∈ Finset.univ.filter (fun j : Fin r → Fin m => Function.Injective j),
        ∏ ℓ : Fin r, G (j ℓ).val (i ℓ) * G (j ℓ).val (i (finRotate r ℓ)))
    - (if r = 1 then Real.sqrt ((m : ℝ) * n) else 0)

/-- `V = (C_r / √(2r))_{r=1}^K ∈ ℝ^K` (entry `r : Fin K` stands for index `r+1`). -/
def statVec {n : ℕ} (m K : ℕ) (G : ℕ → Fin n → ℝ) : EuclideanSpace ℝ (Fin K) :=
  WithLp.toLp 2 (fun r : Fin K =>
    cycleStat m G ((r : ℕ) + 1) / Real.sqrt (2 * ((r : ℝ) + 1)))

/-- `a_K = ((2β)^r / √(2r))_{r=1}^K`. -/
def shiftVec (κ : ℝ) (K : ℕ) : Fin K → ℝ :=
  fun r => (2 * betaK κ) ^ ((r : ℕ) + 1) / Real.sqrt (2 * ((r : ℝ) + 1))

/-- `E g(W_K + a)` for `W_K ~ N(0, I_K)`. -/
def gaussExp (K : ℕ) (g : EuclideanSpace ℝ (Fin K) → ℝ) (a : Fin K → ℝ) : ℝ :=
  ∫ w, g (WithLp.toLp 2 (fun r => w r + a r)) ∂(Measure.pi fun _ : Fin K => standardGaussianMeasure)

/-- Model hypothesis: for every `n`, the entries `G n j i` are i.i.d. standard Gaussians. -/
def IsGaussianModel {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    (G : (n : ℕ) → ℕ → Fin n → Ω → ℝ) : Prop :=
  (∀ n j i, Measurable (G n j i)) ∧
  (∀ n, iIndepFun (fun q : ℕ × Fin n => G n q.1 q.2) P) ∧
  (∀ n j i, P.map (G n j i) = standardGaussianMeasure)

/-- Supplied estimate 2: for every sufficiently small `η > 0` there are `C, γ > 0` such that for
all large `n`, every bounded `C³` function `g` on `ℝ^K` with `|g| ≤ M0`, `‖D^j g‖_op ≤ M_j`
satisfies `|E g(V) - E g(W_K)| + |E[g(V) | 1_n ∈ S^m] - E g(W_K + a_K)| ≤ C n^{-γ} ∑ M_j`. -/
def GaussianApproxEstimate (κ : ℝ) {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    (G : (n : ℕ) → ℕ → Fin n → Ω → ℝ) : Prop :=
  ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ η : ℝ, 0 < η → η < η₀ →
    ∃ C γ : ℝ, 0 < C ∧ 0 < γ ∧ ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      ∀ g : EuclideanSpace ℝ (Fin (KNum η n)) → ℝ, ContDiff ℝ 3 g →
      ∀ M0 M1 M2 M3 : ℝ,
        (∀ z, |g z| ≤ M0) →
        (∀ z, ‖iteratedFDeriv ℝ 1 g z‖ ≤ M1) →
        (∀ z, ‖iteratedFDeriv ℝ 2 g z‖ ≤ M2) →
        (∀ z, ‖iteratedFDeriv ℝ 3 g z‖ ≤ M3) →
        |(∫ ω, g (statVec (mNum κ η n) (KNum η n) (fun j i => G n j i ω)) ∂P)
            - gaussExp (KNum η n) g 0|
          + |(∫ ω, g (statVec (mNum κ η n) (KNum η n) (fun j i => G n j i ω))
                ∂(ProbabilityTheory.cond P
                  {ω | allOnes n ∈ survivors κ (fun j i => G n j i ω) (mNum κ η n)}))
              - gaussExp (KNum η n) g (shiftVec κ (KNum η n))|
          ≤ C * (n : ℝ) ^ (-γ) * (M0 + M1 + M2 + M3)

/-! ## The limiting law -/

/-- The law of `Z* ~ N((1/4) log(1-4β²), -(1/2) log(1-4β²))`. -/
def zStarLaw (κ : ℝ) : Measure ℝ :=
  gaussianReal ((1 / 4) * Real.log (1 - 4 * betaK κ ^ 2))
    (Real.toNNReal (-(1 / 2) * Real.log (1 - 4 * betaK κ ^ 2)))

/-- `F(k) = E exp(-e^{Z*} p^k / 2)` (real power `p^k`). -/
def limitCDF (κ k : ℝ) : ℝ :=
  ∫ z, Real.exp (-(Real.exp z * pK κ ^ k) / 2) ∂(zStarLaw κ)

/-! ## Lemma stubs (rubric items) -/

/-- Deterministic: by nestedness of `S^t`, for an integer `t ≥ 1`, `τ ≤ t ↔ S^t = ∅`. [DistributionOfTheThreshold, node_06] -/
theorem tauLE_iff (κ : ℝ) {n : ℕ} (G : ℕ → Fin n → ℝ) (t : ℕ) (ht : 1 ≤ t) :
    tauLE κ G t ↔ survivors κ G t = ∅ := by
  sorry

/-- Antipodal symmetry: `x` and `-x` survive together. [DistributionOfTheThreshold, node_06] -/
theorem neg_mem_survivors (κ : ℝ) {n : ℕ} (G : ℕ → Fin n → ℝ) (t : ℕ) (x : Fin n → Bool) :
    (fun i => !x i) ∈ survivors κ G t ↔ x ∈ survivors κ G t := by
  sorry

/-- First moment: `E|S^t| = 2^n p^t`. [DistributionOfTheThreshold, node_06] -/
theorem first_moment (κ : ℝ) (hκ : 0 < κ) {Ω : Type} [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] (G : (n : ℕ) → ℕ → Fin n → Ω → ℝ) (hG : IsGaussianModel P G)
    (n t : ℕ) :
    ∫ ω, ((survivors κ (fun j i => G n j i ω) t).card : ℝ) ∂P = 2 ^ n * pK κ ^ t := by
  sorry

/-- Elementary: `0 ≤ e^{-Nq} - (1-q)^N ≤ 2Nq²` for `0 ≤ q ≤ 1/2`. [DistributionOfTheThreshold, node_06] -/
theorem exp_sub_pow_bound (q : ℝ) (hq0 : 0 ≤ q) (hq : q ≤ 1 / 2) (N : ℕ) :
    0 ≤ Real.exp (-(N * q)) - (1 - q) ^ N ∧
      Real.exp (-(N * q)) - (1 - q) ^ N ≤ 2 * N * q ^ 2 := by
  sorry

/-- `∑_{r ≥ 1} u^r / (4r) = -(1/4) log(1-u)` for `0 < u < 1`. [DistributionOfTheThreshold, node_06] -/
theorem series_b_infty (u : ℝ) (hu0 : 0 < u) (hu1 : u < 1) :
    HasSum (fun r : ℕ => u ^ (r + 1) / (4 * ((r : ℝ) + 1))) (-(1 / 4) * Real.log (1 - u)) := by
  sorry

/-- `E e^{Z*} = 1`. [DistributionOfTheThreshold, node_06] -/
theorem integral_exp_zStar (κ : ℝ) (hβ : 0 < 4 * betaK κ ^ 2 ∧ 4 * betaK κ ^ 2 < 1) :
    ∫ z, Real.exp z ∂(zStarLaw κ) = 1 := by
  sorry

/-- Rubric 1 (count fluctuations): with `X = |S^m|` and `d = E X = 2^n p^m`,
`sup_{a ≥ 0} |E exp(-aX/d) - E exp(-a e^{Z*})| ≤ C n^{-c₀}`. [DistributionOfTheThreshold, node_06] -/
theorem laplace_count_approx (κ : ℝ) (hκ : 0 < κ) {Ω : Type} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (G : (n : ℕ) → ℕ → Fin n → Ω → ℝ)
    (hG : IsGaussianModel P G) (hβ : 0 < 4 * betaK κ ^ 2 ∧ 4 * betaK κ ^ 2 < 1)
    (hOv : OverlapEstimate κ) (hApprox : GaussianApproxEstimate κ P G) :
    ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ η : ℝ, 0 < η → η < η₀ →
      ∃ C c₀ : ℝ, 0 < C ∧ 0 < c₀ ∧ ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ a : ℝ, 0 ≤ a →
        |(∫ ω, Real.exp (-a * ((survivors κ (fun j i => G n j i ω) (mNum κ η n)).card : ℝ)
              / (2 ^ n * pK κ ^ (mNum κ η n))) ∂P)
          - ∫ z, Real.exp (-a * Real.exp z) ∂(zStarLaw κ)| ≤ C * (n : ℝ) ^ (-c₀) := by
  sorry

/-- Rubrics 2–3 (surviving set and conditional decoupling): for `m ≤ t ≤ m + ⌈2η log n⌉ + 3`,
`|P(S^t = ∅) - E (1 - p^{t-m})^{X/2}| ≤ C n^{-c}` with `X = |S^m|` (the exponent is `X/2`
because antipodal pairs survive together; `X` is even). [DistributionOfTheThreshold, node_06] -/
theorem conditional_decoupling (κ : ℝ) (hκ : 0 < κ) {Ω : Type} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (G : (n : ℕ) → ℕ → Fin n → Ω → ℝ)
    (hG : IsGaussianModel P G) (hβ : 0 < 4 * betaK κ ^ 2 ∧ 4 * betaK κ ^ 2 < 1)
    (hOv : OverlapEstimate κ) (hApprox : GaussianApproxEstimate κ P G) :
    ∃ η₀ : ℝ, 0 < η₀ ∧ ∀ η : ℝ, 0 < η → η < η₀ →
      ∃ C c : ℝ, 0 < C ∧ 0 < c ∧ ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ t : ℕ,
        mNum κ η n ≤ t → t ≤ mNum κ η n + ⌈2 * η * Real.log n⌉₊ + 3 →
        |(P {ω | survivors κ (fun j i => G n j i ω) t = ∅}).toReal
          - ∫ ω, (1 - pK κ ^ (t - mNum κ η n)) ^
              ((survivors κ (fun j i => G n j i ω) (mNum κ η n)).card / 2) ∂P|
          ≤ C * (n : ℝ) ^ (-c) := by
  sorry

/-! ## Main theorem -/

/-- **Threshold distribution.** There is `θ > 0` (depending only on `κ`) such that for all
large `n`, simultaneously for every real `k` with `k + α_c n = t ∈ ℤ`,
`|P(τ ≤ k + α_c n) - E exp(-e^{Z*} p^k / 2)| ≤ n^{-θ}`. [DistributionOfTheThreshold, node_06] -/
theorem threshold_distribution (κ : ℝ) (hκ : 0 < κ) {Ω : Type} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P] (G : (n : ℕ) → ℕ → Fin n → Ω → ℝ)
    (hG : IsGaussianModel P G) (hβ : 0 < 4 * betaK κ ^ 2 ∧ 4 * betaK κ ^ 2 < 1)
    (hOv : OverlapEstimate κ) (hApprox : GaussianApproxEstimate κ P G) :
    ∃ θ : ℝ, 0 < θ ∧ ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ k : ℝ, ∀ t : ℤ,
      k + alphaC κ * n = t →
      |(P {ω | tauLE κ (fun j i => G n j i ω) t}).toReal - limitCDF κ k| ≤ (n : ℝ) ^ (-θ) := by
  sorry

end TCSChallenge.DistributionOfTheThreshold.node_06
