/-!
## Completeness of the continuous refutation rules for symmetric formulas

Variables `v₀,…,v_{n-1}` range over compact intervals `[L i, U i]`. A literal is a
variable with a sign. A continuous constraint `x ≤ f(y)` has a continuous strictly
increasing bijection `f : ℝ → ℝ`. Derivations use composition, range refutation
(`f(U_y) < L_x`) and opposite-literal refutation (`x ≤ f(-x)`, `-x ≤ g(x)`, and some
`c` with `f(-c) < c`, `g(c) < -c`).

Main theorem: `symmetric_unsat_refutable` — every unsatisfiable symmetric continuous
formula has a derivation of `∅`.
-/

namespace TCSChallenge.NPMembershipForThe.node_15

/-- A literal over `n` variables: a variable index and a sign
(`true` = `v_i`, `false` = `-v_i`). -/
structure Lit (n : ℕ) where
  var : Fin n
  pos : Bool

/-- The negated literal `-x`. -/
def Lit.neg {n : ℕ} (x : Lit n) : Lit n := ⟨x.var, !x.pos⟩

/-- Value of a literal under an assignment `a`. -/
def Lit.val {n : ℕ} (a : Fin n → ℝ) (x : Lit n) : ℝ :=
  if x.pos then a x.var else -(a x.var)

/-- Lower end of the range of a literal: `L_{v_i} = L i`, `L_{-v_i} = -U i`. -/
def Lit.lo {n : ℕ} (L U : Fin n → ℝ) (x : Lit n) : ℝ :=
  if x.pos then L x.var else -(U x.var)

/-- Upper end of the range of a literal: `U_{v_i} = U i`, `U_{-v_i} = -L i`. -/
def Lit.hi {n : ℕ} (L U : Fin n → ℝ) (x : Lit n) : ℝ :=
  if x.pos then U x.var else -(L x.var)

/-- A continuous constraint `x ≤ f(y)` (as data; the analytic conditions on `f`
are in `Constraint.WellFormed`). -/
structure Constraint (n : ℕ) where
  lhs : Lit n
  rhs : Lit n
  f : ℝ → ℝ

/-- "`f : ℝ → ℝ` is a continuous strictly increasing bijection." -/
def IsCSIB (f : ℝ → ℝ) : Prop :=
  Continuous f ∧ StrictMono f ∧ Function.Surjective f

/-- The constraint's map is a continuous strictly increasing bijection. -/
def Constraint.WellFormed {n : ℕ} (c : Constraint n) : Prop := IsCSIB c.f

/-- `c'` is the dual of `c = (x ≤ f(y))`, i.e. `c' = (-y ≤ f̃(-x))` with
`f̃(t) = -f⁻¹(-t)`. Stated inverse-free: `f(-f̃(t)) = -t` for all `t`
(equivalent for bijective `f`). -/
def IsDualOf {n : ℕ} (c' c : Constraint n) : Prop :=
  c'.lhs = c.rhs.neg ∧ c'.rhs = c.lhs.neg ∧ ∀ t : ℝ, c.f (-(c'.f t)) = -t

/-- "A continuous formula is called symmetric if the presence of every constraint
`x ≤ f(y)` entails the presence of its dual constraint `-y ≤ f̃(-x)`." -/
def Symmetric {n : ℕ} (Γ : List (Constraint n)) : Prop :=
  ∀ c ∈ Γ, ∃ c' ∈ Γ, IsDualOf c' c

/-- An assignment within the prescribed ranges satisfying every constraint. -/
def Satisfies {n : ℕ} (L U : Fin n → ℝ) (Γ : List (Constraint n)) (a : Fin n → ℝ) :
    Prop :=
  (∀ i, L i ≤ a i ∧ a i ≤ U i) ∧ ∀ c ∈ Γ, c.lhs.val a ≤ c.f (c.rhs.val a)

/-- Constraints derivable from `Γ` by the composition rule
`x ≤ f(y), y ≤ g(z) ⊢ x ≤ f(g(z))`. -/
inductive Derivable {n : ℕ} (Γ : List (Constraint n)) : Constraint n → Prop
  | base (c : Constraint n) : c ∈ Γ → Derivable Γ c
  | comp (c₁ c₂ : Constraint n) :
      Derivable Γ c₁ → Derivable Γ c₂ → c₁.rhs = c₂.lhs →
      Derivable Γ ⟨c₁.lhs, c₂.rhs, fun t => c₁.f (c₂.f t)⟩

/-- `∅` is derivable from `Γ`: via the range rule (`f(U_y) < L_x`) or via the
opposite-literal rule (`x ≤ f(-x)`, `-x ≤ g(x)`, `∃ c, f(-c) < c ∧ g(c) < -c`). -/
def RefutesEmpty {n : ℕ} (L U : Fin n → ℝ) (Γ : List (Constraint n)) : Prop :=
  (∃ c, Derivable Γ c ∧ c.f (c.rhs.hi L U) < c.lhs.lo L U) ∨
  (∃ c₁ c₂ : Constraint n, Derivable Γ c₁ ∧ Derivable Γ c₂ ∧
      c₁.rhs = c₁.lhs.neg ∧ c₂.lhs = c₁.lhs.neg ∧ c₂.rhs = c₁.lhs ∧
      ∃ c : ℝ, c₁.f (-c) < c ∧ c₂.f c < -c)

/-- Rubric 1 (faithful discretization, equation (1)): for values in their ranges,
`x ≤ f(y)` holds iff every range-aware clause of `𝒦(P)` holds: the binary clauses
`(x ≤ f(c)) ∨ (y ≥ c)` for `c ∈ I_y` with `f(c) ∈ I_x`, the upper endpoint clause
`x ≤ f(U_y)` if `f(U_y) ∈ I_x`, the lower endpoint clause `y ≥ f⁻¹(L_x)` if
`f⁻¹(L_x) ∈ I_y`, and the empty clause if `f(U_y) < L_x`. [NPMembershipForThe, node_15] -/
theorem discretization_equiv (f : ℝ → ℝ) (hf : IsCSIB f)
    (Lx Ux Ly Uy x y : ℝ) (hx : Lx ≤ x ∧ x ≤ Ux) (hy : Ly ≤ y ∧ y ≤ Uy) :
    x ≤ f y ↔
      ((∀ c : ℝ, Ly ≤ c → c ≤ Uy → Lx ≤ f c → f c ≤ Ux → x ≤ f c ∨ c ≤ y) ∧
       (Lx ≤ f Uy → f Uy ≤ Ux → x ≤ f Uy) ∧
       (∀ r : ℝ, f r = Lx → Ly ≤ r → r ≤ Uy → r ≤ y) ∧
       ¬ (f Uy < Lx)) := by
  sorry

/-- Rubric 5 (symmetry is maintained): if `Γ` is symmetric, every derivable
constraint has a derivable dual (uses `(f ∘ g)~ = g̃ ∘ f̃`). [NPMembershipForThe, node_15] -/
theorem derivable_dual {n : ℕ} (Γ : List (Constraint n))
    (hwf : ∀ c ∈ Γ, c.WellFormed) (hsym : Symmetric Γ) (c : Constraint n)
    (hc : Derivable Γ c) : ∃ c', Derivable Γ c' ∧ IsDualOf c' c := by
  sorry

/-- Derivable constraints are well formed (composition of continuous strictly
increasing bijections). [NPMembershipForThe, node_15] -/
theorem derivable_wellFormed {n : ℕ} (Γ : List (Constraint n))
    (hwf : ∀ c ∈ Γ, c.WellFormed) (c : Constraint n) (hc : Derivable Γ c) :
    c.WellFormed := by
  sorry

/-- **Main theorem.** Every unsatisfiable symmetric continuous formula over compact
ranges has a derivation of `∅` using the three rules. [NPMembershipForThe, node_15] -/
theorem symmetric_unsat_refutable {n : ℕ} (L U : Fin n → ℝ) (hLU : ∀ i, L i ≤ U i)
    (Γ : List (Constraint n)) (hwf : ∀ c ∈ Γ, c.WellFormed) (hsym : Symmetric Γ)
    (hunsat : ¬ ∃ a, Satisfies L U Γ a) :
    RefutesEmpty L U Γ := by
  sorry

end TCSChallenge.NPMembershipForThe.node_15
