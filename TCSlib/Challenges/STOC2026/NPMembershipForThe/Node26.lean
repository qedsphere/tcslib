/-!
## Finite-state computation of tight-walk infima for M-2SAT

Non-loop transfers `F x y` (for `x ≠ y`, when present) and loop transfers `A x`
act on extended reals. A tight walk alternates loop and non-loop transfers; its
composite is `A_x^ε ∘ F_{x z₁} ∘ A_{z₁} ∘ ⋯ ∘ A_{z_{r-1}} ∘ F_{z_{r-1} y} ∘ A_y^δ`
(or the single loop `A_x` when `x = y`). `M x y t` is the infimum over tight walks.

Main theorem: `tightInf_eq_candidates` — `M x y` is the pointwise minimum of the
loop candidate, the one-transfer candidates `A_x^ε ∘ F_xy ∘ A_y^δ`, and the
long-walk candidates obtained from reachability in the finite state graph on
`{(x, a) : a ∈ range (A x)}` with edges `(u, A_u(F_uv(b))) → (v, b)`.
Lemma stubs: `loopMap_range_finite` (each loop map `A_f` of a piecewise
fractional-linear `f` with `P` pieces has at most `2P+2` values) and
`comp_pieces` (composition piece bound).
-/

namespace TCSChallenge.NPMembershipForThe.node_26

/-! ### Piecewise fractional-linear maps -/

/-- A fractional-linear piece `t ↦ (a t + b)/(c t + d)` with integer coefficients
on the domain `[lo, hi]` (`EReal` endpoints). -/
structure Piece where
  a : ℤ
  b : ℤ
  c : ℤ
  d : ℤ
  lo : EReal
  hi : EReal

/-- `t` lies in the domain of the piece. -/
def Piece.Dom (p : Piece) (t : ℝ) : Prop := p.lo ≤ (t : EReal) ∧ (t : EReal) ≤ p.hi

/-- Evaluation of the piece formula. -/
def Piece.eval (p : Piece) (t : ℝ) : ℝ := ((p.a : ℝ) * t + p.b) / ((p.c : ℝ) * t + p.d)

/-- `f` is piecewise fractional-linear with at most `P` pieces. -/
def IsPFL (f : ℝ → ℝ) (P : ℕ) : Prop :=
  ∃ ps : List Piece, ps.length ≤ P ∧ (∀ t : ℝ, ∃ p ∈ ps, p.Dom t) ∧
    ∀ p ∈ ps, ∀ t : ℝ, p.Dom t → ((p.c : ℝ) * t + p.d ≠ 0 ∧ f t = p.eval t)

/-- `s_f(t) = sup {z ≤ t : z ≤ f(z)}` (with `sup ∅ = -∞`). -/
def sMap (f : ℝ → ℝ) (t : EReal) : EReal :=
  sSup ((fun z : ℝ => (z : EReal)) '' {z : ℝ | (z : EReal) ≤ t ∧ z ≤ f z})

/-- The loop map `A_f(t) = inf {y ≥ s_f(t) : y > f(y)}` (with `inf ∅ = +∞`). -/
def loopMap (f : ℝ → ℝ) (t : EReal) : EReal :=
  sInf ((fun y : ℝ => (y : EReal)) '' {y : ℝ | sMap f t ≤ (y : EReal) ∧ f y < y})

/-- Rubric 1 (composition piece bound): composing continuous strictly increasing
piecewise fractional-linear maps with `P₁` and `P₂` pieces gives a piecewise
fractional-linear map with at most `P₁ + P₂ - 1` pieces. [NPMembershipForThe, node_26] -/
theorem comp_pieces (f g : ℝ → ℝ) (P₁ P₂ : ℕ) (hP₁ : 1 ≤ P₁) (hP₂ : 1 ≤ P₂)
    (hf : IsPFL f P₁) (hg : IsPFL g P₂) (hfc : Continuous f) (hfm : StrictMono f)
    (hgc : Continuous g) (hgm : StrictMono g) :
    IsPFL (fun t => f (g t)) (P₁ + P₂ - 1) := by
  sorry

/-- Rubric 2 (finite loop states): for a continuous strictly increasing piecewise
fractional-linear `f` with `P` pieces, the loop map `A_f` takes at most `2P + 2`
values (at most two fixed points per nonidentity piece, plus `±∞`). [NPMembershipForThe, node_26] -/
theorem loopMap_range_finite (f : ℝ → ℝ) (P : ℕ) (hf : IsPFL f P)
    (hfc : Continuous f) (hfm : StrictMono f) :
    (Set.range (loopMap f)).Finite ∧ (Set.range (loopMap f)).ncard ≤ 2 * P + 2 := by
  sorry

/-! ### Tight walks and the finite state graph -/

variable {ι : Type} [DecidableEq ι]

/-- `A^ε`: the identity if `ε = false`, the loop `A x` if `ε = true`. -/
def optLoop (A : ι → EReal → EReal) (x : ι) (ε : Bool) (t : EReal) : EReal :=
  if ε then A x t else t

/-- A chain of non-loop transfers `z₀ → z₁ → ⋯ → z_r` with all `F z_i z_{i+1}`
present and `z_i ≠ z_{i+1}`, given by its vertex list. -/
def ValidPath (F : ι → ι → Option (EReal → EReal)) : List ι → Prop
  | [] => False
  | [_] => True
  | u :: v :: rest => u ≠ v ∧ (F u v).isSome ∧ ValidPath F (v :: rest)

/-- Value of the core of a tight walk along the vertex list `z₀,…,z_r` (r ≥ 1),
with mandatory loops at the internal vertices and no loops at the ends:
`F_{z₀z₁} ∘ A_{z₁} ∘ F_{z₁z₂} ∘ ⋯ ∘ F_{z_{r-1}z_r}`. Absent transfers give `⊤`. -/
def coreVal (F : ι → ι → Option (EReal → EReal)) (A : ι → EReal → EReal) :
    List ι → EReal → EReal
  | [] => fun t => t
  | [_] => fun t => t
  | [u, v] => fun t => match F u v with
      | some g => g t
      | none => ⊤
  | u :: v :: w :: rest => fun t => match F u v with
      | some g => g (A v (coreVal F A (v :: w :: rest) t))
      | none => ⊤

/-- The set of values `p(t)` of tight walks from `x` to `y`: the single loop `A_x`
(when `x = y`), and `A_x^ε ∘ core ∘ A_y^δ` for every valid vertex list of length
at least two from `x` to `y`. -/
def tightValues (F : ι → ι → Option (EReal → EReal)) (A : ι → EReal → EReal)
    (x y : ι) (t : EReal) : Set EReal :=
  {v | (x = y ∧ v = A x t) ∨
       ∃ (zs : List ι) (ε δ : Bool), 2 ≤ zs.length ∧ ValidPath F zs ∧
         zs.head? = some x ∧ zs.getLast? = some y ∧
         v = optLoop A x ε (coreVal F A zs (optLoop A y δ t))}

/-- `M_{x→y}(t) = inf {p(t) : p tight walk from x to y}` (`+∞` if none). -/
def tightInf (F : ι → ι → Option (EReal → EReal)) (A : ι → EReal → EReal)
    (x y : ι) (t : EReal) : EReal :=
  sInf (tightValues F A x y t)

/-- Edge of the state graph `G`: `(u, a) → (v, b)` iff `u ≠ v`, `F_uv` exists,
`b ∈ S_v = range (A v)` and `a = A_u(F_uv(b))`. -/
def StateEdge (F : ι → ι → Option (EReal → EReal)) (A : ι → EReal → EReal)
    (p q : ι × EReal) : Prop :=
  p.1 ≠ q.1 ∧ q.2 ∈ Set.range (A q.1) ∧
    ∃ g, F p.1 q.1 = some g ∧ p.2 = A p.1 (g q.2)

/-- Reachability in `G` (reflexive-transitive closure). -/
def Reaches (F : ι → ι → Option (EReal → EReal)) (A : ι → EReal → EReal)
    (p q : ι × EReal) : Prop :=
  Relation.ReflTransGen (StateEdge F A) p q

/-- The finite set of states `d ∈ S_z` from which `(z, d)` reaches `(w, e)`;
`R_{z,w}(e)` is its minimum. -/
def reachSet (F : ι → ι → Option (EReal → EReal)) (A : ι → EReal → EReal)
    (z w : ι) (e : EReal) : Set EReal :=
  {d | d ∈ Set.range (A z) ∧ Reaches F A (z, d) (w, e)}

/-- The candidate values at `t` (pointwise): loop candidate, one-transfer candidates
`A_x^ε(F_xy(A_y^δ t))`, and long-walk candidates
`A_x^ε(F_xz(d))` for `d ∈ reachSet z w (A_w(F_wy(A_y^δ t)))` — the minimum over
`d` of the latter is `A_x^ε(F_xz(R_{z,w}(e)))` by monotonicity, and an empty
reachability set contributes `+∞`. -/
def candidates (F : ι → ι → Option (EReal → EReal)) (A : ι → EReal → EReal)
    (x y : ι) (t : EReal) : Set EReal :=
  {v | (x = y ∧ v = A x t) ∨
       (∃ (g : EReal → EReal) (ε δ : Bool), x ≠ y ∧ F x y = some g ∧
          v = optLoop A x ε (g (optLoop A y δ t))) ∨
       (∃ (z w : ι) (g h : EReal → EReal) (ε δ : Bool) (d : EReal),
          x ≠ z ∧ w ≠ y ∧ F x z = some g ∧ F w y = some h ∧
          d ∈ reachSet F A z w (A w (h (optLoop A y δ t))) ∧
          v = optLoop A x ε (g d))}

/-- **Main theorem (finite-state invariant, exact infima).** For monotone non-loop
transfers and monotone loop maps, the tight-walk infimum `M_{x→y}(t)` equals the
minimum of the candidates built from the finite reachability tables of `G`. [NPMembershipForThe, node_26] -/
theorem tightInf_eq_candidates (F : ι → ι → Option (EReal → EReal))
    (A : ι → EReal → EReal)
    (hF : ∀ x y g, F x y = some g → Monotone g) (hA : ∀ x, Monotone (A x))
    (x y : ι) (t : EReal) :
    tightInf F A x y t = sInf (candidates F A x y t) := by
  sorry

/-- Finiteness of the state graph: if every loop map has finite image and there are
finitely many literals, `G` has finitely many vertices, so every `reachSet` is
finite and `R_{z,w}(e)` is an attained minimum (or `+∞`). [NPMembershipForThe, node_26] -/
theorem reachSet_finite [Finite ι] (F : ι → ι → Option (EReal → EReal))
    (A : ι → EReal → EReal) (hA : ∀ x, (Set.range (A x)).Finite) (z w : ι)
    (e : EReal) : (reachSet F A z w e).Finite := by
  sorry

