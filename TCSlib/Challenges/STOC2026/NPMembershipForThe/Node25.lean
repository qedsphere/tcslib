/-!
## Small quadratic witnesses for M-2SAT

An M-2SAT instance has variables in rational compact intervals and constraints
`x ≤ f(y)` with `f` a continuous strictly increasing piecewise fractional-linear
bijection with integer coefficients. Main theorem: `small_quadratic_witness` —
every satisfiable instance has a satisfying assignment whose coordinates are of the
form `p + q√r` (`p q r : ℚ`, `r ≥ 0`) of bit length polynomial in `n` and `β`.
This is the certificate-existence half of `M-2SAT ∈ NP`.
-/

namespace TCSChallenge.NPMembershipForThe.node_25

/-- Bit length of an integer: `Nat.size |z|`. -/
def zBits (z : ℤ) : ℕ := Nat.size z.natAbs

/-- Bit length of a rational: bits of numerator plus bits of denominator. -/
def qBits (q : ℚ) : ℕ := zBits q.num + Nat.size q.den

/-- A literal: variable index and sign (`true` = `v_i`, `false` = `-v_i`). -/
structure Lit (n : ℕ) where
  var : Fin n
  pos : Bool

/-- Value of a literal under an assignment. -/
def Lit.val {n : ℕ} (a : Fin n → ℝ) (x : Lit n) : ℝ :=
  if x.pos then a x.var else -(a x.var)

/-- A fractional-linear piece `t ↦ (a t + b)/(c t + d)` with integer coefficients,
valid on the domain `[lo, hi]` (endpoints in `EReal`, so unbounded pieces allowed). -/
structure Piece where
  a : ℤ
  b : ℤ
  c : ℤ
  d : ℤ
  lo : EReal
  hi : EReal

/-- `t` lies in the domain of the piece. -/
def Piece.Dom (p : Piece) (t : ℝ) : Prop := p.lo ≤ (t : EReal) ∧ (t : EReal) ≤ p.hi

/-- Evaluation of the piece formula. -/
def Piece.eval (p : Piece) (t : ℝ) : ℝ := ((p.a : ℝ) * t + p.b) / ((p.c : ℝ) * t + p.d)

/-- "`f` is piecewise fractional-linear with the pieces `ps`, whose integer
coefficients have at most `β` bits": the domains cover `ℝ`, and on each domain the
denominator is nonzero and `f` agrees with the piece formula. -/
def IsPFLWith (f : ℝ → ℝ) (ps : List Piece) (β : ℕ) : Prop :=
  (∀ t : ℝ, ∃ p ∈ ps, p.Dom t) ∧
  (∀ p ∈ ps, ∀ t : ℝ, p.Dom t → ((p.c : ℝ) * t + p.d ≠ 0 ∧ f t = p.eval t)) ∧
  (∀ p ∈ ps, zBits p.a ≤ β ∧ zBits p.b ≤ β ∧ zBits p.c ≤ β ∧ zBits p.d ≤ β)

/-- An M-2SAT constraint `x ≤ f(y)` with the piece description of `f`. -/
structure MConstraint (n : ℕ) where
  lhs : Lit n
  rhs : Lit n
  f : ℝ → ℝ
  pieces : List Piece

/-- An M-2SAT instance with `n` variables, rational ranges `[L i, U i]`. -/
structure Instance (n : ℕ) where
  L : Fin n → ℚ
  U : Fin n → ℚ
  cons : List (MConstraint n)

/-- Well-formedness with bit bound `β`: nonempty rational ranges with `β`-bit
endpoints, and every map a continuous strictly increasing bijection that is
piecewise fractional-linear with `β`-bit integer coefficients. -/
def Instance.WellFormed {n : ℕ} (I : Instance n) (β : ℕ) : Prop :=
  (∀ i, I.L i ≤ I.U i ∧ qBits (I.L i) ≤ β ∧ qBits (I.U i) ≤ β) ∧
  ∀ c ∈ I.cons, Continuous c.f ∧ StrictMono c.f ∧ Function.Surjective c.f ∧
    IsPFLWith c.f c.pieces β

/-- `a` satisfies the instance. -/
def Instance.Sat {n : ℕ} (I : Instance n) (a : Fin n → ℝ) : Prop :=
  (∀ i, ((I.L i : ℚ) : ℝ) ≤ a i ∧ a i ≤ ((I.U i : ℚ) : ℝ)) ∧
  ∀ c ∈ I.cons, c.lhs.val a ≤ c.f (c.rhs.val a)

/-- `v` has a representation `p + q√r`, `p q r ∈ ℚ`, `r ≥ 0`, of total bit length
at most `S`. -/
def HasQuadRep (v : ℝ) (S : ℕ) : Prop :=
  ∃ p q r : ℚ, 0 ≤ r ∧ v = (p : ℝ) + (q : ℝ) * Real.sqrt (r : ℝ) ∧
    qBits p + qBits q + qBits r ≤ S

/-- Rubric 1 (closure coefficient growth): composing two fractional-linear pieces
with `L`-bit coefficients gives coefficients
`(a₁a₂+b₁c₂, a₁b₂+b₁d₂, c₁a₂+d₁c₂, c₁b₂+d₁d₂)` of at most `2L+1` bits. [NPMembershipForThe, node_25] -/
theorem comp_coeff_bits (a₁ b₁ c₁ d₁ a₂ b₂ c₂ d₂ : ℤ) (L : ℕ)
    (h₁ : zBits a₁ ≤ L ∧ zBits b₁ ≤ L ∧ zBits c₁ ≤ L ∧ zBits d₁ ≤ L)
    (h₂ : zBits a₂ ≤ L ∧ zBits b₂ ≤ L ∧ zBits c₂ ≤ L ∧ zBits d₂ ≤ L) :
    zBits (a₁ * a₂ + b₁ * c₂) ≤ 2 * L + 1 ∧ zBits (a₁ * b₂ + b₁ * d₂) ≤ 2 * L + 1 ∧
    zBits (c₁ * a₂ + d₁ * c₂) ≤ 2 * L + 1 ∧ zBits (c₁ * b₂ + d₁ * d₂) ≤ 2 * L + 1 := by
  sorry

/-- Rubric 2 (fractional-linear image of a quadratic number): if
`Aα² + Bα + C = 0` and `z = (aα+b)/(cα+d)` with `cα+d ≠ 0` and `ad - bc ≠ 0`, then
`z` is a root of `A(dz-b)² + B(dz-b)(a-cz) + C(a-cz)²`, a polynomial of degree at
most two which is not identically zero when `(A,B,C) ≠ 0`. [NPMembershipForThe, node_25] -/
theorem fracLin_quadratic (A B C a b c d : ℤ) (α : ℝ)
    (hα : (A : ℝ) * α ^ 2 + B * α + C = 0) (hABC : (A, B, C) ≠ (0, 0, 0))
    (hden : (c : ℝ) * α + d ≠ 0) (hdet : a * d - b * c ≠ 0) :
    let z : ℝ := ((a : ℝ) * α + b) / ((c : ℝ) * α + d)
    (A : ℝ) * (d * z - b) ^ 2 + B * (d * z - b) * (a - c * z) + C * (a - c * z) ^ 2 = 0 ∧
    (A * d ^ 2 - B * d * c + C * c ^ 2,
      -2 * A * d * b + B * (d * a + b * c) - 2 * C * a * c,
      A * b ^ 2 - B * b * a + C * a ^ 2) ≠ ((0 : ℤ), (0 : ℤ), (0 : ℤ)) := by
  sorry

/-- **Main theorem (certificate existence for `M-2SAT ∈ NP`).** There is a constant
`C` such that every satisfiable well-formed instance with `n` variables and bit bound
`β` has a satisfying assignment each of whose coordinates is `p + q√r` with total
bit length at most `C·(β+1)·(n+1)^4`. [NPMembershipForThe, node_25] -/
theorem small_quadratic_witness :
    ∃ C : ℕ, ∀ (n β : ℕ) (I : Instance n), I.WellFormed β → (∃ a, I.Sat a) →
      ∃ a : Fin n → ℝ, I.Sat a ∧ ∀ i, HasQuadRep (a i) (C * (β + 1) * (n + 1) ^ 4) := by
  sorry

end TCSChallenge.NPMembershipForThe.node_25
