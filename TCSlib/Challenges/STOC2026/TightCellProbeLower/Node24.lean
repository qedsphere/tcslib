/-!
## Dynamic succinct dictionaries with redundancy `R < n` need `Ω(n log(n/R))` probes

`U = ⌈n^{1+α}⌉`, `H_n = log₂ binom(U,n)`, space `H_n + R` (rounded up), `1 ≤ R < n`,
`w = Θ(log U)`. Hard distribution: a uniform `n`-set `K` inserted in uniformly random order,
then `n` rounds `Query(d_i), Delete(d_i), Insert(a_i)` with `d_i` uniform among undeleted keys
of `K` and `a_i` uniform among keys outside `K` and outside the current set. Main theorem
`round_cost_lower_bound`: expected probes in the rounds is `Ω(n log(n/R))`; corollary
`amortized_lower_bound`.
-/

namespace TCSChallenge.TightCellProbeLowerBoundsDynamicSuccinctDictionaries.node_24

/-! ## Shared cell-probe model (byte-identical in all three files of this paper) -/

/-- Keys come from `[U]`, modelled 0-indexed as `Fin U`. Memory is a bit string of `S` bits,
`Fin S → Bool`: "all information retained between operations counts toward the space bound",
so the memory is the *only* persistent state. Cell `c` consists of bits
`c*w, …, c*w + w - 1` (the last cell may be partial). A word is `ℕ → Bool`, of which only the
first `w` bits are ever read or written. -/
def readCell {S : ℕ} (w : ℕ) (M : Fin S → Bool) (c : ℕ) : ℕ → Bool :=
  fun j => if h : j < w ∧ c * w + j < S then M ⟨c * w + j, h.2⟩ else false

/-- Overwrite cell `c` with the first `w` bits of `v`. -/
def writeCell {S : ℕ} (w : ℕ) (M : Fin S → Bool) (c : ℕ) (v : ℕ → Bool) : Fin S → Bool :=
  fun i => if c * w ≤ i.val ∧ i.val < c * w + w then v (i.val - c * w) else M i

/-- An adaptive cell-probe program: "computation is free, and reading or writing one w-bit
memory cell costs one probe". A `read c k` probe continues with `k` applied to the contents of
cell `c`; a `write c v k` probe overwrites cell `c` with `v`. -/
inductive Prog (α : Type) : Type where
  | done : α → Prog α
  | read : ℕ → ((ℕ → Bool) → Prog α) → Prog α
  | write : ℕ → (ℕ → Bool) → Prog α → Prog α

/-- Run a program on memory `M`: returns the answer, the new memory and the list of probed
cell addresses (one entry per probe, in order). -/
def Prog.run {α : Type} {S : ℕ} (w : ℕ) : Prog α → (Fin S → Bool) → α × (Fin S → Bool) × List ℕ
  | .done a, M => (a, M, [])
  | .read c k, M =>
      let r := (k (readCell w M c)).run w M
      (r.1, r.2.1, c :: r.2.2)
  | .write c v k, M =>
      let r := k.run w (writeCell w M c v)
      (r.1, r.2.1, c :: r.2.2)

/-- Dictionary operations: insertion, deletion and membership query. -/
inductive Op (U : ℕ) : Type where
  | ins : Fin U → Op U
  | del : Fin U → Op U
  | qry : Fin U → Op U

/-- A (deterministic) cell-probe dictionary over `[U]` with `S` bits of memory and word size
`w`. Each operation is a fixed program depending only on its key; there is no private state
outside the memory. A randomized dictionary is a family `Ω → CellProbeDict U S w` indexed by
its random seed. -/
structure CellProbeDict (U S w : ℕ) where
  init : Fin S → Bool
  insertProg : Fin U → Prog Unit
  deleteProg : Fin U → Prog Unit
  queryProg : Fin U → Prog Bool

variable {U S w : ℕ}

/-- Execute one operation: (query answer if any, new memory, probed addresses). -/
def execOp (D : CellProbeDict U S w) : Op U → (Fin S → Bool) → Option Bool × (Fin S → Bool) × List ℕ
  | .ins x, M => let r := (D.insertProg x).run w M; (none, r.2.1, r.2.2)
  | .del x, M => let r := (D.deleteProg x).run w M; (none, r.2.1, r.2.2)
  | .qry x, M => let r := (D.queryProg x).run w M; (some r.1, r.2.1, r.2.2)

/-- The abstract set after an operation. -/
def applyOp (K : Finset (Fin U)) : Op U → Finset (Fin U)
  | .ins x => insert x K
  | .del x => K.erase x
  | .qry _ => K

/-- The set after a list of operations. -/
def setAfter (K : Finset (Fin U)) (ops : List (Op U)) : Finset (Fin U) := ops.foldl applyOp K

/-- Legality of one operation on a set of at most `n` keys: insert a fresh key while fewer
than `n` keys are stored, delete a present key, query anything. -/
def OpLegal (n : ℕ) (K : Finset (Fin U)) : Op U → Prop
  | .ins x => x ∉ K ∧ K.card < n
  | .del x => x ∈ K
  | .qry _ => True

/-- A legal operation sequence starting from the set `K`. -/
def Legal (n : ℕ) : Finset (Fin U) → List (Op U) → Prop
  | _, [] => True
  | K, op :: rest => OpLegal n K op ∧ Legal n (applyOp K op) rest

/-- Every query along `ops` (started from set `K` stored as memory `M`) answers correctly. -/
def CorrectFrom (D : CellProbeDict U S w) : Finset (Fin U) → (Fin S → Bool) → List (Op U) → Prop
  | _, _, [] => True
  | K, M, op :: rest =>
      (∀ x, op = Op.qry x → (execOp D op M).1 = some (decide (x ∈ K))) ∧
      CorrectFrom D (applyOp K op) (execOp D op M).2.1 rest

/-- Exact (zero-error) correctness on every legal operation sequence from the empty set. -/
def AlwaysCorrect (n : ℕ) (D : CellProbeDict U S w) : Prop :=
  ∀ ops : List (Op U), Legal n ∅ ops → CorrectFrom D ∅ D.init ops

/-- Memory after running `ops` from memory `M`. -/
def finalMem (D : CellProbeDict U S w) (M : Fin S → Bool) (ops : List (Op U)) : Fin S → Bool :=
  ops.foldl (fun M' op => (execOp D op M').2.1) M

/-- Probed addresses (in order) when running `ops` from memory `M`. -/
def probeTrace (D : CellProbeDict U S w) : (Fin S → Bool) → List (Op U) → List ℕ
  | _, [] => []
  | M, op :: rest => (execOp D op M).2.2 ++ probeTrace D (execOp D op M).2.1 rest

/-- Total number of probes when running `ops` from memory `M`. -/
def totalProbes (D : CellProbeDict U S w) (M : Fin S → Bool) (ops : List (Op U)) : ℕ :=
  (probeTrace D M ops).length

/-- Probe trace of a sequence of meta-operations (blocks of operations), each probe tagged with
the index of its meta-operation: entries `(i, address)`. -/
def runTagged (D : CellProbeDict U S w) : (Fin S → Bool) → ℕ → List (List (Op U)) → List (ℕ × ℕ)
  | _, _, [] => []
  | M, i, blk :: rest =>
      (probeTrace D M blk).map (fun c => (i, c)) ++ runTagged D (finalMem D M blk) (i + 1) rest

/-- Hard inputs: pairs `(d, a)` of injective lists of length `n` with disjoint ranges. Choosing
`(d, a)` uniformly is the same as choosing a uniform `n`-set `K = range d`, then independently a
uniform permutation `(d_1,…,d_n)` of `K` and a uniform ordered list `(a_1,…,a_n)` of distinct
elements of `[U] \ K`. -/
def HardInputs (n U : ℕ) : Finset ((Fin n → Fin U) × (Fin n → Fin U)) :=
  Finset.univ.filter (fun p => Function.Injective p.1 ∧ Function.Injective p.2 ∧
    ∀ i j, p.1 i ≠ p.2 j)

/-- The key set `K = {d_1, …, d_n}`. -/
def keySet {n : ℕ} (d : Fin n → Fin U) : Finset (Fin U) := Finset.univ.image d

/-- Initialization by inserting the elements of `K` in increasing order. -/
def initOpsIncreasing (K : Finset (Fin U)) : List (Op U) := (K.sort (· ≤ ·)).map Op.ins

/-- The `i`-th meta-operation is `Query(d_i), Delete(d_i), Insert(a_i)`. -/
def metaOps {n : ℕ} (d a : Fin n → Fin U) : List (List (Op U)) :=
  List.ofFn (fun i : Fin n => [Op.qry (d i), Op.del (d i), Op.ins (a i)])

/-- Tagged probe trace of the `n` meta-operations, after running the initialization `initOps`
from `D.init`. Probes of the initialization are excluded. -/
def metaTrace {n : ℕ} (D : CellProbeDict U S w) (initOps : List (Op U)) (d a : Fin n → Fin U) :
    List (ℕ × ℕ) :=
  runTagged D (finalMem D D.init initOps) 0 (metaOps d a)

/-- Number of probes in the `n` meta-operations (initialization excluded). -/
def metaCost {n : ℕ} (D : CellProbeDict U S w) (initOps : List (Op U)) (d a : Fin n → Fin U) : ℕ :=
  (metaTrace D initOps d a).length

/-- Uniform average of a natural-valued function over a finite set of inputs. -/
noncomputable def avgOver {I : Type} (s : Finset I) (f : I → ℕ) : ℝ :=
  (∑ x ∈ s, (f x : ℝ)) / s.card

/-- Number of insertions / deletions / queries in an operation sequence. -/
def countIns (ops : List (Op U)) : ℕ := (ops.filter (fun o => match o with | .ins _ => true | _ => false)).length
def countDel (ops : List (Op U)) : ℕ := (ops.filter (fun o => match o with | .del _ => true | _ => false)).length
def countQry (ops : List (Op U)) : ℕ := (ops.filter (fun o => match o with | .qry _ => true | _ => false)).length

/-- Expected amortized probe bounds `tI, tD, tQ` for insertion, deletion and query: on every
legal sequence from the empty set, the expected total number of probes (over the seed) is at
most `tI·#ins + tD·#del + tQ·#qry`. -/
def AmortizedBounds {Ω : Type} [Fintype Ω] (n : ℕ) (μ : FinDist Ω) (D : Ω → CellProbeDict U S w)
    (tI tD tQ : ℝ) : Prop :=
  ∀ ops : List (Op U), Legal n ∅ ops →
    ∑ ω, μ ω * (totalProbes (D ω) (D ω).init ops : ℝ) ≤
      tI * countIns ops + tD * countDel ops + tQ * countQry ops

/-- Number of entries of a tagged trace whose meta-operation index lies in `[st, st + len)`
(`probe_u` for the interval `u`). -/
def windowProbes (tr : List (ℕ × ℕ)) (st len : ℕ) : ℕ :=
  (tr.filter (fun e => decide (st ≤ e.1 ∧ e.1 < st + len))).length

/-- `cost_u` for the interval `u = [st, st + lam*m)` split into `lam` consecutive children of
`m` meta-operations: the number of probes (inside `u`) whose immediately preceding probe to the
same cell lies inside `u` but in a different child. -/
def crossCost (tr : List (ℕ × ℕ)) (st m lam : ℕ) : ℕ :=
  ((Finset.range tr.length).filter (fun p =>
    ∃ q < p, (tr.getD q (0, 0)).2 = (tr.getD p (0, 0)).2 ∧
      (∀ r, q < r → r < p → (tr.getD r (0, 0)).2 ≠ (tr.getD p (0, 0)).2) ∧
      st ≤ (tr.getD q (0, 0)).1 ∧ (tr.getD p (0, 0)).1 < st + lam * m ∧
      ((tr.getD q (0, 0)).1 - st) / m ≠ ((tr.getD p (0, 0)).1 - st) / m)).card

/-- Residual-state (Jensen) bound, used by all three rows: if the reachable states representing
the various `n`-sets form disjoint families with `a_T ≥ 1` states for `T`, and there are at most
`2^S` states in total, then the average of `log a_T` over `n`-sets is at most
`S - log binom(U, n)`. [TightCellProbeLower, node_24] -/
theorem residual_state_jensen (n : ℕ) (a : Finset (Fin U) → ℕ)
    (hpos : ∀ T ∈ (Finset.univ : Finset (Fin U)).powersetCard n, 1 ≤ a T)
    (hsum : ∑ T ∈ (Finset.univ : Finset (Fin U)).powersetCard n, a T ≤ 2 ^ S)
    (hn : n ≤ U) :
    (∑ T ∈ (Finset.univ : Finset (Fin U)).powersetCard n, Real.logb 2 (a T)) / (U.choose n) ≤
      (S : ℝ) - Real.logb 2 (U.choose n) := by
  sorry

/-- A correct membership query must probe memory: its program is never `done` immediately
(otherwise it would answer identically on `∅` and on `{x}`). [TightCellProbeLower, node_24] -/
theorem queryProg_not_done (n : ℕ) (hn : 1 ≤ n) (D : CellProbeDict U S w)
    (hD : AlwaysCorrect n D) (x : Fin U) (b : Bool) : D.queryProg x ≠ Prog.done b := by
  sorry

/-! ## Row-specific definitions and statements -/

/-- Hard inputs of this row: `(e, d, a)` where `e` is the (uniformly random) initialization
order of `K = range d`, `d` the deletion order and `a` the insertion list. Uniform `(e,d,a)`
reproduces the round-by-round description: `a_i` uniform outside `K` and outside the current
set (= outside `K ∪ {a_1,…,a_{i-1}}`). -/
def HardInputs1 (n U : ℕ) : Finset ((Fin n → Fin U) × (Fin n → Fin U) × (Fin n → Fin U)) :=
  Finset.univ.filter (fun p => p.2 ∈ HardInputs n U ∧ Function.Injective p.1 ∧
    keySet p.1 = keySet p.2.1)

/-- Initialization: insert `e_1, …, e_n` in order. -/
def initOpsOrder {n : ℕ} (e : Fin n → Fin U) : List (Op U) := List.ofFn (fun i => Op.ins (e i))

/-- Expected number of probes in the `n` rounds (initialization not charged). -/
noncomputable def expectedRoundCost {Ω : Type} [Fintype Ω] (n : ℕ) (μ : FinDist Ω)
    (D : Ω → CellProbeDict U S w) : ℝ :=
  ∑ ω, μ ω * avgOver (HardInputs1 n U)
    (fun p => metaCost (D ω) (initOpsOrder p.1) p.2.1 p.2.2)

/-- Expected statistic of the tagged round trace of a deterministic dictionary. -/
noncomputable def expectedTraceStat {n : ℕ} (D : CellProbeDict U S w)
    (f : List (ℕ × ℕ) → ℕ) : ℝ :=
  avgOver (HardInputs1 n U) (fun p => f (metaTrace D (initOpsOrder p.1) p.2.1 p.2.2))

/-- Section 3, local dichotomy (3), with `Λ = 2^64` segments of `s` rounds each, where
`max(R, n^{1-γ/2}) ≤ s < n/2`: `E[cost_u] ≥ δ m/100` or `E[probe_u] ≥ θ m log U`
(`m = Λ s`; `θ log U` plays the role of `t = ε log U`). [TightCellProbeLower, node_24] -/
theorem local_dichotomy (α cw Cw : ℝ) (hα : 0 < α) (hcw : 0 < cw) (hCw : cw ≤ Cw) :
    ∃ γ δ θ : ℝ, 0 < γ ∧ 0 < δ ∧ 0 < θ ∧ ∃ N0 : ℕ,
      ∀ n U w S R st s : ℕ, N0 ≤ n → U = ⌈(n : ℝ) ^ (1 + α)⌉₊ →
      cw * Real.logb 2 U ≤ w → (w : ℝ) ≤ Cw * Real.logb 2 U →
      1 ≤ R → R < n → S ≤ Nat.clog 2 (U.choose n) + R →
      R ≤ s → (n : ℝ) ^ (1 - γ / 2) ≤ s → 2 * s < n →
      st + 2 ^ 64 * s ≤ n →
      ∀ D : CellProbeDict U S w, AlwaysCorrect n D →
        δ * (2 ^ 64 * s : ℕ) / 100 ≤
            expectedTraceStat (n := n) D (fun tr => crossCost tr st s (2 ^ 64)) ∨
        θ * (2 ^ 64 * s : ℕ) * Real.logb 2 U ≤
          expectedTraceStat (n := n) D (fun tr => windowProbes tr st (2 ^ 64 * s)) := by
  sorry

/-- **Main theorem.** Expected total probes in the `n` rounds is `Ω(n log(n/R))`. [TightCellProbeLower, node_24] -/
theorem round_cost_lower_bound (α cw Cw : ℝ) (hα : 0 < α) (hcw : 0 < cw) (hCw : cw ≤ Cw) :
    ∃ c : ℝ, 0 < c ∧ ∃ N0 : ℕ, ∀ n U w S R : ℕ, N0 ≤ n → U = ⌈(n : ℝ) ^ (1 + α)⌉₊ →
      cw * Real.logb 2 U ≤ w → (w : ℝ) ≤ Cw * Real.logb 2 U →
      1 ≤ R → R < n → S ≤ Nat.clog 2 (U.choose n) + R →
      ∀ (Ω : Type) [Fintype Ω] (μ : FinDist Ω) (D : Ω → CellProbeDict U S w),
        (∀ ω, 0 < μ ω → AlwaysCorrect n (D ω)) →
        c * n * Real.logb 2 ((n : ℝ) / R) ≤ expectedRoundCost n μ D := by
  sorry

/-- **Corollary.** One of insertion, deletion and query has expected amortized probe
complexity `Ω(log(n/R))`. [TightCellProbeLower, node_24] -/
theorem amortized_lower_bound (α cw Cw : ℝ) (hα : 0 < α) (hcw : 0 < cw) (hCw : cw ≤ Cw) :
    ∃ c : ℝ, 0 < c ∧ ∃ N0 : ℕ, ∀ n U w S R : ℕ, N0 ≤ n → U = ⌈(n : ℝ) ^ (1 + α)⌉₊ →
      cw * Real.logb 2 U ≤ w → (w : ℝ) ≤ Cw * Real.logb 2 U →
      1 ≤ R → R < n → S ≤ Nat.clog 2 (U.choose n) + R →
      ∀ (Ω : Type) [Fintype Ω] (μ : FinDist Ω) (D : Ω → CellProbeDict U S w),
        (∀ ω, 0 < μ ω → AlwaysCorrect n (D ω)) →
        ∀ tI tD tQ : ℝ, AmortizedBounds n μ D tI tD tQ →
          c * Real.logb 2 ((n : ℝ) / R) ≤ max tI (max tD tQ) := by
  sorry

end TCSChallenge.TightCellProbeLowerBoundsDynamicSuccinctDictionaries.node_24
