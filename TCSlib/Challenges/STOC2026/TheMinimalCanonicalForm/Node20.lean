/-!
## Minimal canonical form for PEPS-type gauge groups `∏ₖ GL(D_k, ℂ)`

`V = End(H)^d`, `H = ⊗_{k=1}^m ℂ^{D_k}`, `‖T‖₂² = ∑ᵢ tr(T⁽ⁱ⁾ T⁽ⁱ⁾†)`, and
`G = ∏ₖ GL(D_k, ℂ)` acts by conjugation with `g_1 ⊗ ⋯ ⊗ g_m`. With
`|T⟩ = ∑ T⁽ⁱ⁾_{𝐚𝐛} |i⟩|𝐚⟩|𝐛⟩` and `ρ_{k,r}` the partial trace of `|T⟩⟨T|` onto the `k`-th
factor of the `r`-th copy of `H`, the main theorem `argmin_iff_marginals` states: for
`𝒪 = G·T` or `𝒪 = cl(G·T)`, `T` minimizes `‖·‖₂` on `𝒪` iff `ρ_{k,1} = ρ_{k,2}ᵀ` for all `k`.
-/

namespace TCSChallenge.TheMinimalCanonicalForm.node_20

open Matrix

/-- "`H = ⊗_{k=1}^m ℂ^{D_k}`" in its standard product basis: basis vectors are indexed by
multi-indices `𝐚 = (a_1, …, a_m)` with `a_k ∈ {1, …, D_k}` (here `Fin (D k)`). -/
abbrev Idx {m : ℕ} (D : Fin m → ℕ) := (k : Fin m) → Fin (D k)

/-- "`V = End(H)^d`": `d`-tuples of matrices whose rows and columns are indexed by `Idx D`. -/
abbrev Tuple {m : ℕ} (D : Fin m → ℕ) (d : ℕ) := Fin d → Matrix (Idx D) (Idx D) ℂ

/-- The gauge group "`G = ∏_{k=1}^m GL(D_k, ℂ)`". -/
abbrev Gauge {m : ℕ} (D : Fin m → ℕ) :=
  (k : Fin m) → Matrix.GeneralLinearGroup (Fin (D k)) ℂ

/-- "`g_1 ⊗ ⋯ ⊗ g_m`" in the product basis: the `(𝐚, 𝐛)` entry is `∏ₖ (g_k)_{a_k b_k}`. -/
def kron {m : ℕ} {D : Fin m → ℕ} (g : (k : Fin m) → Matrix (Fin (D k)) (Fin (D k)) ℂ) :
    Matrix (Idx D) (Idx D) ℂ :=
  fun a b => ∏ k, g k (a k) (b k)

/-- "`(g·T)⁽ⁱ⁾ = (g_1 ⊗ ⋯ ⊗ g_m) T⁽ⁱ⁾ (g_1 ⊗ ⋯ ⊗ g_m)⁻¹`", using
`(g_1 ⊗ ⋯ ⊗ g_m)⁻¹ = g_1⁻¹ ⊗ ⋯ ⊗ g_m⁻¹`. -/
def act {m d : ℕ} {D : Fin m → ℕ} (g : Gauge D) (T : Tuple D d) : Tuple D d :=
  fun i => kron (fun k => (g k).val) * T i * kron (fun k => (g k)⁻¹.val)

/-- The orbit "`G·T`". -/
def orbit {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) : Set (Tuple D d) :=
  Set.range (fun g : Gauge D => act g T)

/-- "`‖T‖₂² = ∑_{i=1}^d tr(T⁽ⁱ⁾ (T⁽ⁱ⁾)†)`" (real part of a real nonnegative number;
equal to `∑ᵢ tr((T⁽ⁱ⁾)† T⁽ⁱ⁾)`). -/
noncomputable def normSq {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) : ℝ :=
  (∑ i, trace (T i * (T i)ᴴ)).re

/-- "`|T⟩ = ∑_{i,𝐚,𝐛} T⁽ⁱ⁾_{𝐚,𝐛} |i⟩ ⊗ |𝐚⟩ ⊗ |𝐛⟩`", coordinates indexed by `(i, 𝐚, 𝐛)`. -/
def vecT {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) : Fin d × Idx D × Idx D → ℂ :=
  fun x => T x.1 x.2.1 x.2.2

/-- The unnormalized operator "`|T⟩⟨T|`": entry `((i,𝐚,𝐛),(j,𝐜,𝐞))` is
`T⁽ⁱ⁾_{𝐚,𝐛} · conj(T⁽ʲ⁾_{𝐜,𝐞})`. -/
def rho {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) :
    Matrix (Fin d × Idx D × Idx D) (Fin d × Idx D × Idx D) ℂ :=
  fun x y => vecT T x * star (vecT T y)

/-- "`ρ_{k,1}`": partial trace of `|T⟩⟨T|` onto the `k`-th factor of the first copy of `H`
(all indices except `a_k` are traced out). -/
def rhoK1 {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) (k : Fin m) :
    Matrix (Fin (D k)) (Fin (D k)) ℂ :=
  fun x y => ∑ i, ∑ a ∈ Finset.univ.filter (fun a : Idx D => a k = x), ∑ b,
    rho T (i, a, b) (i, Function.update a k y, b)

/-- "`ρ_{k,2}`": partial trace of `|T⟩⟨T|` onto the `k`-th factor of the second copy of `H`
(all indices except `b_k` are traced out). -/
def rhoK2 {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) (k : Fin m) :
    Matrix (Fin (D k)) (Fin (D k)) ℂ :=
  fun x y => ∑ i, ∑ a, ∑ b ∈ Finset.univ.filter (fun b : Idx D => b k = x),
    rho T (i, a, b) (i, a, Function.update b k y)

/-- "`Tr_{k̂}`": partial trace of an operator on `H` over all tensor factors except the `k`-th. -/
def ptrK {m : ℕ} {D : Fin m → ℕ} (k : Fin m) (B : Matrix (Idx D) (Idx D) ℂ) :
    Matrix (Fin (D k)) (Fin (D k)) ℂ :=
  fun x y => ∑ a ∈ Finset.univ.filter (fun a : Idx D => a k = x), B a (Function.update a k y)

/-- `T` minimizes the squared norm on the set `O`. -/
def IsArgminOn {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) (O : Set (Tuple D d)) : Prop :=
  ∀ S ∈ O, normSq T ≤ normSq S

/-- Rubric 1: minimality on the orbit is equivalent to minimality on its closure. [TheMinimalCanonicalForm, node_20] -/
theorem argmin_orbit_iff_closure {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) :
    IsArgminOn T (orbit T) ↔ IsArgminOn T (closure (orbit T)) := by
  sorry

/-- Rubric 2: `ρ_{k,1} = Tr_{k̂} ∑ᵢ T⁽ⁱ⁾ T⁽ⁱ⁾†`. [TheMinimalCanonicalForm, node_20] -/
theorem rhoK1_eq_ptr {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) (k : Fin m) :
    rhoK1 T k = ptrK k (∑ i, T i * (T i)ᴴ) := by
  sorry

/-- Rubric 2: `ρ_{k,2}ᵀ = Tr_{k̂} ∑ᵢ T⁽ⁱ⁾† T⁽ⁱ⁾`. [TheMinimalCanonicalForm, node_20] -/
theorem rhoK2_transpose_eq_ptr {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) (k : Fin m) :
    (rhoK2 T k)ᵀ = ptrK k (∑ i, (T i)ᴴ * T i) := by
  sorry

/-- Rubric 5 (the convexity mechanism after diagonalizing each Hermitian generator):
conjugating by `⊗ₖ diag(e^{tλ_{k,·}})` gives the nonnegative sum of real exponentials
`∑_{i,𝐚,𝐛} |T⁽ⁱ⁾_{𝐚𝐛}|² e^{2t ∑ₖ (λ_{k,a_k} - λ_{k,b_k})}`. [TheMinimalCanonicalForm, node_20] -/
theorem normSq_diag_conj {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d)
    (lam : (k : Fin m) → Fin (D k) → ℝ) (t : ℝ) :
    normSq (fun i =>
        kron (fun k => diagonal (fun a => ((Real.exp (t * lam k a) : ℝ) : ℂ))) * T i *
        kron (fun k => diagonal (fun a => ((Real.exp (-(t * lam k a)) : ℝ) : ℂ)))) =
      ∑ i, ∑ a : Idx D, ∑ b : Idx D, ‖T i a b‖ ^ 2 *
        Real.exp (2 * t * ∑ k, (lam k (a k) - lam k (b k))) := by
  sorry

/-- Rubrics 3–4 (necessity): orbit minimality forces every marginal difference to vanish. [TheMinimalCanonicalForm, node_20] -/
theorem necessity {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d)
    (h : IsArgminOn T (orbit T)) : ∀ k, rhoK1 T k = (rhoK2 T k)ᵀ := by
  sorry

/-- Rubrics 5–6 (sufficiency): the marginal equations imply `‖g·T‖₂ ≥ ‖T‖₂` for all `g ∈ G`. [TheMinimalCanonicalForm, node_20] -/
theorem sufficiency {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d)
    (h : ∀ k, rhoK1 T k = (rhoK2 T k)ᵀ) : IsArgminOn T (orbit T) := by
  sorry

/-- Main theorem: for `𝒪 = G·T` and for `𝒪 = cl(G·T)`,
`T ∈ argmin_{S ∈ 𝒪} ‖S‖₂ ↔ ∀ k, ρ_{k,1} = ρ_{k,2}ᵀ`. [TheMinimalCanonicalForm, node_20] -/
theorem argmin_iff_marginals {m d : ℕ} {D : Fin m → ℕ} (hm : 1 ≤ m) (hd : 1 ≤ d)
    (hD : ∀ k, 1 ≤ D k) (T : Tuple D d) :
    (IsArgminOn T (orbit T) ↔ ∀ k, rhoK1 T k = (rhoK2 T k)ᵀ) ∧
    (IsArgminOn T (closure (orbit T)) ↔ ∀ k, rhoK1 T k = (rhoK2 T k)ᵀ) := by
  sorry

end TCSChallenge.TheMinimalCanonicalForm.node_20
