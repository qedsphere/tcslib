/-!
## Quantitative duality for the minimal canonical form

`V = Mat_{D×D}(ℂ)^d`, `D = ∏ₖ D_k`, `G = ∏ₖ GL(D_k, ℂ)` acting by conjugation with
`g_1 ⊗ ⋯ ⊗ g_m`. `σ(A) = |A⟩⟨A|`, `σ_{k,1}, σ_{k,2}` its partial traces retaining `a_k`, `b_k`,
`ε(A) = (tr σ(A))⁻¹ (∑ₖ ‖σ_{k,1} - σ_{k,2}ᵀ‖₂²)^{1/2}`, and
`γ = D_1^{-3/2}` (`m = 1`), `γ = 1/[(∑D_k)(2m)^{(∑D_k - 1)/2}]` (`m ≥ 2`).
Main theorem `capacity_bounds`: for nonzero `T`, a minimizer `T_min` on `cl(G·T)` and any
`S ∈ G·T`, `1 - ε(S)/γ ≤ ‖T_min‖²/‖S‖² ≤ 1 - ε(S)²/(8m)`; corollary `Tmin_ne_zero`.
-/

namespace TCSChallenge.TheMinimalCanonicalForm.node_34

open Matrix

/-- "`H = ⊗_{k=1}^m ℂ^{D_k}`" in its standard product basis: basis vectors are indexed by
multi-indices `𝐚 = (a_1, …, a_m)` with `a_k ∈ {1, …, D_k}` (here `Fin (D k)`). -/
abbrev Idx {m : ℕ} (D : Fin m → ℕ) := (k : Fin m) → Fin (D k)

/-- "`V = End(H)^d`": `d`-tuples of matrices whose rows and columns are indexed by `Idx D`. -/
abbrev Tuple {m : ℕ} (D : Fin m → ℕ) (d : ℕ) := Fin d → Matrix (Idx D) (Idx D) ℂ

/-- The gauge group "`G = ∏_{k=1}^m GL(D_k, ℂ)`". -/
abbrev Gauge {m : ℕ} (D : Fin m → ℕ) :=
  (k : Fin m) → Matrix.GeneralLinearGroup (Fin (D k)) ℂ

/-- "`g_1 ⊗ ⋯ ⊗ g_m`" in the product basis: the `(𝐚, 𝐛)` entry is `∏ₖ (g_k)_{a_k b_k}`. -/
def kron {m : ℕ} {D : Fin m → ℕ} (g : (k : Fin m) → Matrix (Fin (D k)) (Fin (D k)) ℂ) :
    Matrix (Idx D) (Idx D) ℂ :=
  fun a b => ∏ k, g k (a k) (b k)

/-- "`(g·T)⁽ⁱ⁾ = (g_1 ⊗ ⋯ ⊗ g_m) T⁽ⁱ⁾ (g_1 ⊗ ⋯ ⊗ g_m)⁻¹`", using
`(g_1 ⊗ ⋯ ⊗ g_m)⁻¹ = g_1⁻¹ ⊗ ⋯ ⊗ g_m⁻¹`. -/
def act {m d : ℕ} {D : Fin m → ℕ} (g : Gauge D) (T : Tuple D d) : Tuple D d :=
  fun i => kron (fun k => (g k).val) * T i * kron (fun k => (g k)⁻¹.val)

/-- The orbit "`G·T`". -/
def orbit {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) : Set (Tuple D d) :=
  Set.range (fun g : Gauge D => act g T)

/-- "`‖T‖₂² = ∑_{i=1}^d tr(T⁽ⁱ⁾ (T⁽ⁱ⁾)†)`" (real part of a real nonnegative number;
equal to `∑ᵢ tr((T⁽ⁱ⁾)† T⁽ⁱ⁾)`). -/
noncomputable def normSq {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) : ℝ :=
  (∑ i, trace (T i * (T i)ᴴ)).re

/-- "`|T⟩ = ∑_{i,𝐚,𝐛} T⁽ⁱ⁾_{𝐚,𝐛} |i⟩ ⊗ |𝐚⟩ ⊗ |𝐛⟩`", coordinates indexed by `(i, 𝐚, 𝐛)`. -/
def vecT {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) : Fin d × Idx D × Idx D → ℂ :=
  fun x => T x.1 x.2.1 x.2.2

/-- The unnormalized operator "`|T⟩⟨T|`": entry `((i,𝐚,𝐛),(j,𝐜,𝐞))` is
`T⁽ⁱ⁾_{𝐚,𝐛} · conj(T⁽ʲ⁾_{𝐜,𝐞})`. -/
def rho {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) :
    Matrix (Fin d × Idx D × Idx D) (Fin d × Idx D × Idx D) ℂ :=
  fun x y => vecT T x * star (vecT T y)

/-- "`ρ_{k,1}`": partial trace of `|T⟩⟨T|` onto the `k`-th factor of the first copy of `H`
(all indices except `a_k` are traced out). -/
def rhoK1 {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) (k : Fin m) :
    Matrix (Fin (D k)) (Fin (D k)) ℂ :=
  fun x y => ∑ i, ∑ a ∈ Finset.univ.filter (fun a : Idx D => a k = x), ∑ b,
    rho T (i, a, b) (i, Function.update a k y, b)

/-- "`ρ_{k,2}`": partial trace of `|T⟩⟨T|` onto the `k`-th factor of the second copy of `H`
(all indices except `b_k` are traced out). -/
def rhoK2 {m d : ℕ} {D : Fin m → ℕ} (T : Tuple D d) (k : Fin m) :
    Matrix (Fin (D k)) (Fin (D k)) ℂ :=
  fun x y => ∑ i, ∑ a, ∑ b ∈ Finset.univ.filter (fun b : Idx D => b k = x),
    rho T (i, a, b) (i, a, Function.update b k y)

/-- "`Tr_{k̂}`": partial trace of an operator on `H` over all tensor factors except the `k`-th. -/
def ptrK {m : ℕ} {D : Fin m → ℕ} (k : Fin m) (B : Matrix (Idx D) (Idx D) ℂ) :
    Matrix (Fin (D k)) (Fin (D k)) ℂ :=
  fun x y => ∑ a ∈ Finset.univ.filter (fun a : Idx D => a k = x), B a (Function.update a k y)

/-! ### Definitions specific to this row
In the paper's notation `σ(A) = rho A`, `σ_{k,1}(A) = rhoK1 A k`, `σ_{k,2}(A) = rhoK2 A k`. -/

/-- Squared Hilbert–Schmidt norm "`‖X‖₂² = ∑_{x,y} |X_{xy}|²`". -/
noncomputable def hsSq {n : ℕ} (X : Matrix (Fin n) (Fin n) ℂ) : ℝ :=
  ∑ x, ∑ y, ‖X x y‖ ^ 2

/-- "`ε(A) = (tr σ(A))⁻¹ (∑ₖ ‖σ_{k,1}(A) - σ_{k,2}(A)ᵀ‖₂²)^{1/2}`" (meaningful for `A ≠ 0`). -/
noncomputable def eps {m d : ℕ} {D : Fin m → ℕ} (A : Tuple D d) : ℝ :=
  ((trace (rho A)).re)⁻¹ * Real.sqrt (∑ k, hsSq (rhoK1 A k - (rhoK2 A k)ᵀ))

/-- "`γ = D_1^{-3/2}` if `m = 1`, `γ = 1/[(∑ₖ D_k)(2m)^{(∑ₖ D_k - 1)/2}]` if `m ≥ 2`"
(for `m = 1`, `∑ₖ D_k = D_1`). Exponents are real. -/
noncomputable def gamma {m : ℕ} (D : Fin m → ℕ) : ℝ :=
  if m = 1 then (∑ k, (D k : ℝ)) ^ (-(3 / 2 : ℝ))
  else 1 / ((∑ k, (D k : ℝ)) * (2 * (m : ℝ)) ^ (((∑ k, (D k : ℝ)) - 1) / 2))

/-- The weight vector "`ω = (e_{a_1} - e_{b_1}, …, e_{a_m} - e_{b_m}) ∈ ℝ^n`", `n = ∑ₖ D_k`,
with coordinates indexed by pairs `(k, j)`, `j ∈ Fin (D k)`. -/
def omega {m : ℕ} {D : Fin m → ℕ} (a b : Idx D) : (Σ k : Fin m, Fin (D k)) → ℝ :=
  fun p => (if a p.1 = p.2 then 1 else 0) - (if b p.1 = p.2 then 1 else 0)

/-- Rubrics 2–3 (geometric bound (2)): if a nonempty set `A ⊆ Ω` has `0 ∉ conv(A)`, then
every point of `conv(A)` has Euclidean norm at least `γ`. [TheMinimalCanonicalForm, node_34] -/
theorem dist_zero_convexHull_ge_gamma {m : ℕ} {D : Fin m → ℕ} (hm : 1 ≤ m)
    (hD : ∀ k, 1 ≤ D k) (A : Finset (Idx D × Idx D)) (hA : A.Nonempty)
    (h0 : (0 : (Σ k : Fin m, Fin (D k)) → ℝ) ∉
      convexHull ℝ ((fun p : Idx D × Idx D => omega p.1 p.2) '' (A : Set (Idx D × Idx D))))
    (z : (Σ k : Fin m, Fin (D k)) → ℝ)
    (hz : z ∈
      convexHull ℝ ((fun p : Idx D × Idx D => omega p.1 p.2) '' (A : Set (Idx D × Idx D)))) :
    gamma D ≤ Real.sqrt (∑ j, z j ^ 2) := by
  sorry

/-- Rubric 4 (linear lower bound on the whole orbit): `‖g·S‖₂² ≥ (1 - ε(S)/γ) ‖S‖₂²`. [TheMinimalCanonicalForm, node_34] -/
theorem lower_bound {m d : ℕ} {D : Fin m → ℕ} (hm : 1 ≤ m) (hD : ∀ k, 1 ≤ D k)
    (S : Tuple D d) (hS : S ≠ 0) (g : Gauge D) :
    (1 - eps S / gamma D) * normSq S ≤ normSq (act g S) := by
  sorry

/-- Rubric 5 (quantitative descent): some orbit element has
`‖g·S‖₂² ≤ (1 - ε(S)²/(8m)) ‖S‖₂²`. [TheMinimalCanonicalForm, node_34] -/
theorem upper_bound {m d : ℕ} {D : Fin m → ℕ} (hm : 1 ≤ m) (hD : ∀ k, 1 ≤ D k)
    (S : Tuple D d) (hS : S ≠ 0) :
    ∃ g : Gauge D, normSq (act g S) ≤ (1 - eps S ^ 2 / (8 * m)) * normSq S := by
  sorry

/-- Main theorem: `1 - ε(S)/γ ≤ ‖T_min‖₂²/‖S‖₂² ≤ 1 - ε(S)²/(8m)` for every `S ∈ G·T`. [TheMinimalCanonicalForm, node_34] -/
theorem capacity_bounds {m d : ℕ} {D : Fin m → ℕ} (hm : 1 ≤ m) (hd : 1 ≤ d)
    (hD : ∀ k, 1 ≤ D k) (T : Tuple D d) (hT : T ≠ 0)
    (Tmin : Tuple D d) (hTmin : Tmin ∈ closure (orbit T))
    (hmin : ∀ N ∈ closure (orbit T), normSq Tmin ≤ normSq N)
    (S : Tuple D d) (hS : S ∈ orbit T) :
    1 - eps S / gamma D ≤ normSq Tmin / normSq S ∧
      normSq Tmin / normSq S ≤ 1 - eps S ^ 2 / (8 * m) := by
  sorry

/-- Corollary: `ε(S) < γ` implies `T_min ≠ 0`. [TheMinimalCanonicalForm, node_34] -/
theorem Tmin_ne_zero {m d : ℕ} {D : Fin m → ℕ} (hm : 1 ≤ m) (hd : 1 ≤ d)
    (hD : ∀ k, 1 ≤ D k) (T : Tuple D d) (hT : T ≠ 0)
    (Tmin : Tuple D d) (hTmin : Tmin ∈ closure (orbit T))
    (hmin : ∀ N ∈ closure (orbit T), normSq Tmin ≤ normSq N)
    (S : Tuple D d) (hS : S ∈ orbit T) (hε : eps S < gamma D) :
    Tmin ≠ 0 := by
  sorry

end TCSChallenge.TheMinimalCanonicalForm.node_34
