/-!
## Gauge equivalence of uniform MPS via orbit closures

For `X ∈ V = (Mat_{D×D}(ℂ))^d`, the periodic uniform MPS `|X_n⟩` has coefficients
`⟨i_1 … i_n | X_n⟩ = tr(X^{(i_1)} ⋯ X^{(i_n)})`. `GL_D(ℂ)` acts by simultaneous conjugation.
The main theorem `gauge_equiv_tfae` states that for all `M N ∈ V` the following are
equivalent:
1. the Zariski closures of the orbits `G·M`, `G·N` intersect;
2. `|M_n⟩ = |N_n⟩` for all `n ≥ 1`;
3. `|M_n⟩ = |N_n⟩` for `1 ≤ n ≤ D²`.
-/

namespace TCSChallenge.TheMinimalCanonicalForm.node_13

open MvPolynomial

/-- The space `V = (Mat_{D×D}(ℂ))^d` of `d`-tuples of `D × D` complex matrices. -/
abbrev Tup (D d : ℕ) : Type := Fin d → Matrix (Fin D) (Fin D) ℂ

/-- "The group `G = GL_D(ℂ)` acts on `V` by simultaneous conjugation:
`g · X = (g X^{(1)} g^{-1}, …, g X^{(d)} g^{-1})`." -/
def conj {D d : ℕ} (g : (Matrix (Fin D) (Fin D) ℂ)ˣ) (X : Tup D d) : Tup D d :=
  fun k => (g : Matrix (Fin D) (Fin D) ℂ) * X k * ((g⁻¹ : (Matrix (Fin D) (Fin D) ℂ)ˣ) :
    Matrix (Fin D) (Fin D) ℂ)

/-- The orbit `G · X`. -/
def orbit {D d : ℕ} (X : Tup D d) : Set (Tup D d) :=
  {Y | ∃ g : (Matrix (Fin D) (Fin D) ℂ)ˣ, Y = conj g X}

/-- Polynomial coordinate ring of `V`: variables indexed by (label, row, column). -/
abbrev Coord (D d : ℕ) : Type := Fin d × Fin D × Fin D

/-- The coordinate vector of a tuple, used to evaluate polynomials on `V`. -/
def coords {D d : ℕ} (X : Tup D d) : Coord D d → ℂ := fun c => X c.1 c.2.1 c.2.2

/-- Evaluation of a polynomial function on `V`. -/
def evalAt {D d : ℕ} (X : Tup D d) (p : MvPolynomial (Coord D d) ℂ) : ℂ :=
  MvPolynomial.eval (coords X) p

/-- "Write `\overline{G·X}` for the Zariski closure of the orbit": the Zariski closure of
`S ⊆ V` is the set of points at which every polynomial vanishing on `S` vanishes. -/
def zariskiClosure {D d : ℕ} (S : Set (Tup D d)) : Set (Tup D d) :=
  {Y | ∀ p : MvPolynomial (Coord D d) ℂ, (∀ X ∈ S, evalAt X p = 0) → evalAt Y p = 0}

/-- Orbit closure `\overline{G · X}`. -/
def orbitClosure {D d : ℕ} (X : Tup D d) : Set (Tup D d) := zariskiClosure (orbit X)

/-- "Call two tuples gauge equivalent if their orbit closures intersect." -/
def GaugeEquiv {D d : ℕ} (M N : Tup D d) : Prop :=
  (orbitClosure M ∩ orbitClosure N).Nonempty

/-- The matrix product `X^{(i_1)} ⋯ X^{(i_n)}` of a word `i : Fin n → Fin d`. -/
def wordProd {D d n : ℕ} (X : Tup D d) (i : Fin n → Fin d) : Matrix (Fin D) (Fin D) ℂ :=
  (List.ofFn fun t => X (i t)).prod

/-- "`⟨i_1,…,i_n|X_n⟩ = tr(X^{(i_1)} ⋯ X^{(i_n)})`": the coefficients of the unnormalized
periodic uniform MPS `|X_n⟩ ∈ (ℂ^d)^{⊗ n}`. -/
def mps {D d : ℕ} (X : Tup D d) (n : ℕ) : (Fin n → Fin d) → ℂ :=
  fun i => Matrix.trace (wordProd X i)

/-- Generic matrix `(x_{k,a,b})_{a,b}` with polynomial entries. -/
def genericMatrix {D d : ℕ} (k : Fin d) : Matrix (Fin D) (Fin D) (MvPolynomial (Coord D d) ℂ) :=
  Matrix.of fun a b => MvPolynomial.X (k, a, b)

/-- The trace-word polynomial `X ↦ tr(X^{(i_1)} ⋯ X^{(i_n)})` on `V`. -/
def traceWordPoly {D d n : ℕ} (i : Fin n → Fin d) : MvPolynomial (Coord D d) ℂ :=
  Matrix.trace (List.ofFn fun t => (genericMatrix (D := D) (i t))).prod

/-- The set of trace-word polynomials for words of length `n` with `1 ≤ n ≤ L`. -/
def traceWordsUpTo (D d L : ℕ) : Set (MvPolynomial (Coord D d) ℂ) :=
  {p | ∃ n : ℕ, 1 ≤ n ∧ n ≤ L ∧ ∃ i : Fin n → Fin d, p = traceWordPoly i}

/-- The set of all trace-word polynomials (words of positive length). -/
def allTraceWords (D d : ℕ) : Set (MvPolynomial (Coord D d) ℂ) :=
  {p | ∃ n : ℕ, 1 ≤ n ∧ ∃ i : Fin n → Fin d, p = traceWordPoly i}

/-- The invariant ring `𝓘 = ℂ[V]^G`: polynomials invariant under simultaneous conjugation. -/
def IsInvariant {D d : ℕ} (p : MvPolynomial (Coord D d) ℂ) : Prop :=
  ∀ (g : (Matrix (Fin D) (Fin D) ℂ)ˣ) (X : Tup D d), evalAt (conj g X) p = evalAt X p

/-! ## Lemma stubs (subgoals of the strategy) -/

/-- Translation: the polynomial `traceWordPoly i` evaluates to the MPS coefficient. [TheMinimalCanonicalForm, node_13] -/
theorem evalAt_traceWordPoly {D d n : ℕ} (X : Tup D d) (i : Fin n → Fin d) :
    evalAt X (traceWordPoly (D := D) i) = mps X n i := by
  sorry

/-- Each trace-word coefficient is a polynomial invariant (cancellation of `g⁻¹ g`, cyclicity
of the trace). [TheMinimalCanonicalForm, node_13] -/
theorem traceWordPoly_isInvariant {D d n : ℕ} (i : Fin n → Fin d) :
    IsInvariant (traceWordPoly (D := D) i) := by
  sorry

/-- Polynomial invariants are constant on orbit closures. [TheMinimalCanonicalForm, node_13] -/
theorem invariant_const_on_orbitClosure {D d : ℕ} (p : MvPolynomial (Coord D d) ℂ)
    (hp : IsInvariant p) (X Y : Tup D d) (hY : Y ∈ orbitClosure X) :
    evalAt Y p = evalAt X p := by
  sorry

/-- First fundamental theorem for simultaneous conjugation (Procesi, Sibirskii): every
invariant polynomial lies in the `ℂ`-subalgebra generated by traces of words. [TheMinimalCanonicalForm, node_13] -/
theorem invariants_generated_by_traces {D d : ℕ} (p : MvPolynomial (Coord D d) ℂ)
    (hp : IsInvariant p) : p ∈ Algebra.adjoin ℂ (allTraceWords D d) := by
  sorry

/-- Razmyslov–Procesi bound (characteristic zero): the trace algebra of `D × D` matrices is
generated by traces of words of length at most `D²`, uniformly in the number `d` of labels. [TheMinimalCanonicalForm, node_13] -/
theorem traceWords_bounded_generation {D d : ℕ} (hD : 1 ≤ D) :
    allTraceWords D d ⊆ Algebra.adjoin ℂ (traceWordsUpTo D d (D ^ 2)) := by
  sorry

/-- Separation of orbit closures by invariants (`GL_D(ℂ)` reductive): if every invariant
polynomial takes equal values at `M` and `N`, the orbit closures of `M` and `N` intersect. [TheMinimalCanonicalForm, node_13] -/
theorem invariants_separate_orbitClosures {D d : ℕ} (M N : Tup D d)
    (h : ∀ p : MvPolynomial (Coord D d) ℂ, IsInvariant p → evalAt M p = evalAt N p) :
    GaugeEquiv M N := by
  sorry

/-- Elements of a subalgebra generated by `S` agree at `M` and `N` whenever all elements of `S`
do. [TheMinimalCanonicalForm, node_13] -/
theorem evalAt_eq_of_mem_adjoin {D d : ℕ} (M N : Tup D d) (S : Set (MvPolynomial (Coord D d) ℂ))
    (hS : ∀ q ∈ S, evalAt M q = evalAt N q) (p : MvPolynomial (Coord D d) ℂ)
    (hp : p ∈ Algebra.adjoin ℂ S) : evalAt M p = evalAt N p := by
  sorry

/-! ## Main theorem -/

/-- For all `M, N ∈ V` the three conditions are equivalent:
(1) `\overline{G·M} ∩ \overline{G·N} ≠ ∅`;
(2) `|M_n⟩ = |N_n⟩` for every positive integer `n`;
(3) `|M_n⟩ = |N_n⟩` for `1 ≤ n ≤ D²`. [TheMinimalCanonicalForm, node_13] -/
theorem gauge_equiv_tfae {D d : ℕ} (hD : 1 ≤ D) (hd : 1 ≤ d) (M N : Tup D d) :
    (GaugeEquiv M N ↔ ∀ n : ℕ, 1 ≤ n → mps M n = mps N n) ∧
    ((∀ n : ℕ, 1 ≤ n → mps M n = mps N n) ↔
      ∀ n : ℕ, 1 ≤ n → n ≤ D ^ 2 → mps M n = mps N n) := by
  sorry

end TCSChallenge.TheMinimalCanonicalForm.node_13
