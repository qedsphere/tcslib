/-!
## Minimal canonical form of a matrix product state tensor (single bond)

`𝒱 = (ℂ^{D×D})^d` with `‖M‖₂² = ∑ᵢ tr((M⁽ⁱ⁾)† M⁽ⁱ⁾)`. `GL(D, ℂ)` acts by simultaneous
conjugation `(g·M)⁽ⁱ⁾ = g M⁽ⁱ⁾ g⁻¹`. `M` is in minimal canonical form if
`‖M‖₂ ≤ ‖N‖₂` for every `N` in the Euclidean closure of the orbit.
With `|M⟩ = ∑ M⁽ⁱ⁾_{ab} |a⟩|b⟩|i⟩`, `ρ = |M⟩⟨M|`, `ρ₁ = Tr_{2,3} ρ`, `ρ₂ = Tr_{1,3} ρ`,
the main theorem `minimal_canonical_form_characterization` states:
`M` is minimal on the orbit closure ↔ minimal on the orbit ↔ `ρ₁ = ρ₂ᵀ`
↔ `∑ᵢ M⁽ⁱ⁾ M⁽ⁱ⁾† = ∑ᵢ M⁽ⁱ⁾† M⁽ⁱ⁾`.
-/

namespace TCSChallenge.TheMinimalCanonicalForm.node_11

open Matrix

/-- "`𝒱 = (ℂ^{D×D})^d`": a `d`-tuple of complex `D × D` matrices. -/
abbrev Tuple (D d : ℕ) := Fin d → Matrix (Fin D) (Fin D) ℂ

/-- "`‖M‖₂² = ∑_{i=1}^d tr((M⁽ⁱ⁾)† M⁽ⁱ⁾)`" (the trace is real and nonnegative; we take its
real part). -/
noncomputable def normSq {D d : ℕ} (M : Tuple D d) : ℝ :=
  (∑ i, trace ((M i)ᴴ * M i)).re

/-- "`(g·M)⁽ⁱ⁾ = g M⁽ⁱ⁾ g⁻¹`" for `g ∈ GL(D, ℂ)`. -/
def act {D d : ℕ} (g : Matrix.GeneralLinearGroup (Fin D) ℂ) (M : Tuple D d) : Tuple D d :=
  fun i => g.val * M i * g⁻¹.val

/-- "`𝒪(M) = {g·M : g ∈ GL(D, ℂ)}`". -/
def orbit {D d : ℕ} (M : Tuple D d) : Set (Tuple D d) :=
  Set.range (fun g : Matrix.GeneralLinearGroup (Fin D) ℂ => act g M)

/-- "`M` is in minimal canonical form if `‖M‖₂ ≤ ‖N‖₂` for every `N ∈ cl 𝒪(M)`"
(closure in the Euclidean = product topology). -/
def IsMinimalCanonical {D d : ℕ} (M : Tuple D d) : Prop :=
  ∀ N ∈ closure (orbit M), normSq M ≤ normSq N

/-- Minimality on the orbit itself. -/
def IsOrbitMinimal {D d : ℕ} (M : Tuple D d) : Prop :=
  ∀ N ∈ orbit M, normSq M ≤ normSq N

/-- "`|M⟩ = ∑_{a,b,i} M⁽ⁱ⁾_{ab} |a⟩ ⊗ |b⟩ ⊗ |i⟩`", coordinates indexed by `(a, b, i)`. -/
def vecM {D d : ℕ} (M : Tuple D d) : Fin D × Fin D × Fin d → ℂ :=
  fun x => M x.2.2 x.1 x.2.1

/-- "`ρ = |M⟩⟨M|`" (unnormalized): `ρ_{x,y} = |M⟩_x · conj(|M⟩_y)`. -/
def rho {D d : ℕ} (M : Tuple D d) :
    Matrix (Fin D × Fin D × Fin d) (Fin D × Fin D × Fin d) ℂ :=
  fun x y => vecM M x * star (vecM M y)

/-- "`ρ₁ = Tr_{2,3} ρ`": trace out the second and third tensor factors. -/
def rho1 {D d : ℕ} (M : Tuple D d) : Matrix (Fin D) (Fin D) ℂ :=
  fun a c => ∑ b, ∑ i, rho M (a, b, i) (c, b, i)

/-- "`ρ₂ = Tr_{1,3} ρ`": trace out the first and third tensor factors. -/
def rho2 {D d : ℕ} (M : Tuple D d) : Matrix (Fin D) (Fin D) ℂ :=
  fun b c => ∑ a, ∑ i, rho M (a, b, i) (a, c, i)

/-- Rubric 1: minimality on the orbit is equivalent to minimality on its closure. [TheMinimalCanonicalForm, node_11] -/
theorem orbitMinimal_iff_minimalCanonical {D d : ℕ} (M : Tuple D d) :
    IsOrbitMinimal M ↔ IsMinimalCanonical M := by
  sorry

/-- Rubric 4: `ρ₁ = ∑ᵢ M⁽ⁱ⁾ (M⁽ⁱ⁾)†`. [TheMinimalCanonicalForm, node_11] -/
theorem rho1_eq {D d : ℕ} (M : Tuple D d) :
    rho1 M = ∑ i, M i * (M i)ᴴ := by
  sorry

/-- Rubric 4: `ρ₂ᵀ = ∑ᵢ (M⁽ⁱ⁾)† M⁽ⁱ⁾`. [TheMinimalCanonicalForm, node_11] -/
theorem rho2_transpose_eq {D d : ℕ} (M : Tuple D d) :
    (rho2 M)ᵀ = ∑ i, (M i)ᴴ * M i := by
  sorry

/-- Rubric 3 (key formula after diagonalizing the Hermitian generator): conjugating by
`diag(e^{tλ_a})` gives `∑_{i,a,b} |M⁽ⁱ⁾_{ab}|² e^{2t(λ_a - λ_b)}`, a convex function of `t`. [TheMinimalCanonicalForm, node_11] -/
theorem normSq_diag_conj {D d : ℕ} (M : Tuple D d) (lam : Fin D → ℝ) (t : ℝ) :
    normSq (fun i => diagonal (fun a => ((Real.exp (t * lam a) : ℝ) : ℂ)) * M i *
        diagonal (fun a => ((Real.exp (-(t * lam a)) : ℝ) : ℂ))) =
      ∑ i, ∑ a, ∑ b, ‖M i a b‖ ^ 2 * Real.exp (2 * t * (lam a - lam b)) := by
  sorry

/-- Rubric 2 (necessity): orbit minimality forces `B = ∑ᵢ (M M† - M† M) = 0`. [TheMinimalCanonicalForm, node_11] -/
theorem necessity {D d : ℕ} (M : Tuple D d) (h : IsOrbitMinimal M) :
    ∑ i, M i * (M i)ᴴ = ∑ i, (M i)ᴴ * M i := by
  sorry

/-- Rubric 3 (global sufficiency): `B = 0` implies `‖g·M‖₂ ≥ ‖M‖₂` for every invertible `g`. [TheMinimalCanonicalForm, node_11] -/
theorem sufficiency {D d : ℕ} (M : Tuple D d)
    (h : ∑ i, M i * (M i)ᴴ = ∑ i, (M i)ᴴ * M i) : IsOrbitMinimal M := by
  sorry

/-- Main theorem: the four conditions are equivalent. [TheMinimalCanonicalForm, node_11] -/
theorem minimal_canonical_form_characterization {D d : ℕ} (hD : 1 ≤ D) (hd : 1 ≤ d)
    (M : Tuple D d) :
    (IsMinimalCanonical M ↔ rho1 M = (rho2 M)ᵀ) ∧
    (IsOrbitMinimal M ↔ rho1 M = (rho2 M)ᵀ) ∧
    (IsMinimalCanonical M ↔ ∑ i, M i * (M i)ᴴ = ∑ i, (M i)ᴴ * M i) := by
  sorry

end TCSChallenge.TheMinimalCanonicalForm.node_11
