/-!
## Mixing of general biased adjacent transposition chains, node 05

For a parameter array `p : Fin n → Fin n → ℝ` with `p j i = 1 - p i j` and
`p i j ≥ (1+ε) p j i` for `i < j` (no monotonicity), the chain on `S_n` picks a uniform
adjacent edge `(r, r+1)` and swaps the entries there with probability `p (X r+1) (X r)`.
Its stationary law is `μ(σ) ∝ ∏_{a<b} p (σ a) (σ b)`.

Assuming a uniform localization estimate (stationary and dynamic localization in
`(C₀ log n)`-Loc, and fast mixing `A n (log n)^B` of the chain restricted to it when
`min p ≥ n^{-κ}`, `κ > 3`), the main theorem `biased_adjacent_transposition_mixing` states

* `T_mix(δ) ≤ K n² + O_ε(n (log n)^B log(4/δ))`,
* `T_mix(δ) ≥ n² (1 - o(1))`,
* `T_mix(δ) / T_mix(1-δ)` is eventually bounded by a constant `C(ε)` (pre-cutoff).

Positions and particles are 0-indexed (`Fin n`); a permutation `σ` maps a position to
the particle sitting there, so `σ.symm k` is the position of particle `k`.
-/

namespace TCSChallenge.MixingOfGeneralBiased.node_05

/-! ## Generic finite Markov chains given by a kernel -/

/-- One step of a kernel `K` applied to a (signed) mass vector `ν`: `(νK)(y) = ∑_z ν z K z y`. -/
def stepDist {S : Type} [Fintype S] (K : S → S → ℝ) (ν : S → ℝ) : S → ℝ :=
  fun y => ∑ z, ν z * K z y

/-- `ν K^t`. -/
def iterDist {S : Type} [Fintype S] (K : S → S → ℝ) (ν : S → ℝ) : ℕ → S → ℝ
  | 0 => ν
  | t + 1 => stepDist K (iterDist K ν t)

/-- Point mass at `x`. -/
def dirac {S : Type} [DecidableEq S] (x : S) : S → ℝ :=
  fun y => if y = x then 1 else 0

/-- `P^t(x, ·)`. -/
def transitionPow {S : Type} [Fintype S] [DecidableEq S] (K : S → S → ℝ) (x : S) (t : ℕ) :
    S → ℝ :=
  iterDist K (dirac x) t

/-- Total-variation distance `‖ν - μ‖_TV = ½ ∑_y |ν y - μ y|`. -/
def tvDist {S : Type} [Fintype S] (ν μ : S → ℝ) : ℝ :=
  (1 / 2) * ∑ y, |ν y - μ y|

/-- `ν` is a probability vector.  Kept (instead of `FinDist`) only for the rows of a kernel
`K : S → S → ℝ`, which are given as plain functions. -/
def IsProbVec {S : Type} [Fintype S] (ν : S → ℝ) : Prop :=
  (∀ y, 0 ≤ ν y) ∧ ∑ y, ν y = 1

/-- `K` is a stochastic kernel. -/
def IsStochastic {S : Type} [Fintype S] (K : S → S → ℝ) : Prop :=
  ∀ x, IsProbVec (K x)

/-! ## The biased adjacent transposition chain -/

/-- "`p_{i,j} ∈ [0,1]`, `p_{j,i} = 1 - p_{i,j}`, `p_{i,j} ≥ (1+ε) p_{j,i}` for `i < j`." -/
def Admissible (ε : ℝ) (n : ℕ) (p : Fin n → Fin n → ℝ) : Prop :=
  (∀ i j, 0 ≤ p i j ∧ p i j ≤ 1) ∧
  (∀ i j, i ≠ j → p j i = 1 - p i j) ∧
  (∀ i j, i < j → (1 + ε) * p j i ≤ p i j)

/-- Left position `r` of the adjacent edge `e = (r, r+1)`, `r ∈ {0, …, n-2}`. -/
def leftPos {n : ℕ} (e : Fin (n - 1)) : Fin n :=
  ⟨e.val, by have := e.isLt; omega⟩

/-- Right position `r+1` of the adjacent edge `e`. -/
def rightPos {n : ℕ} (e : Fin (n - 1)) : Fin n :=
  ⟨e.val + 1, by have := e.isLt; omega⟩

/-- "At each step choose `r ∈ [n-1]` uniformly and interchange the entries in positions
`r, r+1` with probability `p_{X_t(r+1), X_t(r)}`."  Interchanging positions is right
multiplication by the transposition of the two positions. -/
def kernel (n : ℕ) (p : Fin n → Fin n → ℝ) (x y : Equiv.Perm (Fin n)) : ℝ :=
  ∑ e : Fin (n - 1),
    (1 / ((n : ℝ) - 1)) *
      ((if y = x * Equiv.swap (leftPos e) (rightPos e)
          then p (x (rightPos e)) (x (leftPos e)) else 0) +
       (if y = x then 1 - p (x (rightPos e)) (x (leftPos e)) else 0))

/-- Unnormalised stationary weight `∏_{1 ≤ a < b ≤ n} p_{σ(a), σ(b)}`. -/
def weight (n : ℕ) (p : Fin n → Fin n → ℝ) (σ : Equiv.Perm (Fin n)) : ℝ :=
  ∏ a : Fin n, ∏ b : Fin n, if a < b then p (σ a) (σ b) else 1

/-- "`μ(σ) = (1/Z) ∏_{a<b} p_{σ(a),σ(b)}`." -/
def stationary (n : ℕ) (p : Fin n → Fin n → ℝ) (σ : Equiv.Perm (Fin n)) : ℝ :=
  weight n p σ / ∑ τ, weight n p τ

/-- "`d_n(t) = max_{x ∈ S_n} ‖P^t(x,·) - μ‖_TV`." -/
def worstTV (n : ℕ) (p : Fin n → Fin n → ℝ) (t : ℕ) : ℝ :=
  Finset.univ.sup' Finset.univ_nonempty
    (fun x : Equiv.Perm (Fin n) => tvDist (transitionPow (kernel n p) x t) (stationary n p))

/-- "`T_mix(δ) = min {t : d_n(t) ≤ δ}`." -/
def mixingTime (n : ℕ) (p : Fin n → Fin n → ℝ) (δ : ℝ) : ℕ :=
  sInf {t : ℕ | worstTV n p t ≤ δ}

/-- "`ℓ-Loc = {σ ∈ S_n : |σ⁻¹(k) - k| ≤ ℓ for every k ∈ [n]}`." -/
def locSet (n : ℕ) (ℓ : ℝ) : Finset (Equiv.Perm (Fin n)) :=
  Finset.univ.filter (fun σ => ∀ k : Fin n, |((σ.symm k : ℕ) : ℝ) - ((k : ℕ) : ℝ)| ≤ ℓ)

/-- Mass of a set under a vector. -/
def massOf {S : Type} [Fintype S] (ν : S → ℝ) (A : Finset S) : ℝ :=
  ∑ y ∈ A, ν y

/-- "The Markov chain on `L` obtained by retaining all transitions within `L` and replacing
every transition out of `L` by a holding transition."  (Off `L` it is the identity.) -/
def restrictedKernel {S : Type} [Fintype S] [DecidableEq S] (K : S → S → ℝ) (L : Finset S)
    (x y : S) : ℝ :=
  if x ∈ L then
    (if y ∈ L then K x y else 0) + (if y = x then ∑ z ∈ Lᶜ, K x z else 0)
  else (if y = x then 1 else 0)

/-- The conditional law `μ(· | L)`. -/
def condOn {S : Type} [Fintype S] (μ : S → ℝ) (L : Finset S) (y : S) : ℝ :=
  if y ∈ L then μ y / massOf μ L else 0

/-- The localized set `L_n = (C₀ log n)-Loc`. -/
def locN (C0 : ℝ) (n : ℕ) : Finset (Equiv.Perm (Fin n)) :=
  locSet n (C0 * Real.log n)

/-- The assumed uniform localization estimate, with constants `C₀, K, A > 0`, `B`, `κ`:
for all large `n` and every admissible array,
`μ(L_nᶜ) ≤ n^{-10}`, `sup_x sup_{u ≥ K n²} P_x(X_u ∉ L_n) ≤ n^{-10}`, and if
`min_{i≠j} p_{i,j} ≥ n^{-κ}` the restricted chain on `L_n` has worst-case 1/4-mixing time
at most `A n (log n)^B`. -/
def LocalizationHypothesis (ε C0 K A B κ : ℝ) : Prop :=
  ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ p : Fin n → Fin n → ℝ, Admissible ε n p →
    massOf (stationary n p) (locN C0 n)ᶜ ≤ (n : ℝ) ^ (-(10 : ℝ)) ∧
    (∀ x : Equiv.Perm (Fin n), ∀ u : ℕ, K * (n : ℝ) ^ 2 ≤ (u : ℝ) →
      massOf (transitionPow (kernel n p) x u) (locN C0 n)ᶜ ≤ (n : ℝ) ^ (-(10 : ℝ))) ∧
    ((∀ i j : Fin n, i ≠ j → (n : ℝ) ^ (-κ) ≤ p i j) →
      ∀ x ∈ locN C0 n,
        tvDist (transitionPow (restrictedKernel (kernel n p) (locN C0 n)) x
                  ⌊A * n * (Real.log n) ^ B⌋₊)
               (condOn (stationary n p) (locN C0 n)) ≤ 1 / 4)

/-- Truncation `p'_{i,j} = min{p_{i,j}, 1 - a}` for `i < j`, `p'_{j,i} = 1 - p'_{i,j}`. -/
def truncate (n : ℕ) (p : Fin n → Fin n → ℝ) (a : ℝ) (i j : Fin n) : ℝ :=
  if i < j then min (p i j) (1 - a)
  else if j < i then 1 - min (p j i) (1 - a)
  else p i j

/-! ## Rubric lemma stubs -/

/-- Rubric 1 (stationarity of the conditional law): `μ(·|L)` is stationary for the
restricted chain on any set `L` of positive `μ`-mass. [MixingOfGeneralBiased, node_05] -/
theorem condOn_stationary_restricted (ε : ℝ) (hε : 0 < ε) (n : ℕ) (hn : 2 ≤ n)
    (p : Fin n → Fin n → ℝ) (hp : Admissible ε n p) (L : Finset (Equiv.Perm (Fin n)))
    (hL : 0 < massOf (stationary n p) L) :
    stepDist (restrictedKernel (kernel n p) L) (condOn (stationary n p) L) =
      condOn (stationary n p) L := by
  sorry

/-- Rubric 1 (amplification): if the restricted chain is `1/4`-mixed from every start in
`L` at time `T`, then it is `2^{-k}`-mixed at time `k T`. [MixingOfGeneralBiased, node_05] -/
theorem restricted_amplification (ε : ℝ) (hε : 0 < ε) (n : ℕ) (hn : 2 ≤ n)
    (p : Fin n → Fin n → ℝ) (hp : Admissible ε n p) (L : Finset (Equiv.Perm (Fin n)))
    (hL : 0 < massOf (stationary n p) L) (T : ℕ)
    (hT : ∀ x ∈ L, tvDist (transitionPow (restrictedKernel (kernel n p) L) x T)
      (condOn (stationary n p) L) ≤ 1 / 4) :
    ∀ k : ℕ, ∀ x ∈ L, tvDist (transitionPow (restrictedKernel (kernel n p) L) x (k * T))
      (condOn (stationary n p) L) ≤ (1 / 2 : ℝ) ^ k := by
  sorry

/-- Rubric 2 (burn-in transfer): conditional vs. full stationary measure,
`‖μ(·|L) - μ‖_TV = μ(Lᶜ)`. [MixingOfGeneralBiased, node_05] -/
theorem tv_condOn_stationary (ε : ℝ) (hε : 0 < ε) (n : ℕ) (hn : 2 ≤ n)
    (p : Fin n → Fin n → ℝ) (hp : Admissible ε n p) (L : Finset (Equiv.Perm (Fin n)))
    (hL : 0 < massOf (stationary n p) L) :
    tvDist (condOn (stationary n p) L) (stationary n p) = massOf (stationary n p) Lᶜ := by
  sorry

/-- Rubric 2 (burn-in transfer): after burn-in `T₀`, the unrestricted chain from `x` is
within (sum of exit probabilities) + (restricted-chain accuracy `α`) of `μ(·|L)`. [MixingOfGeneralBiased, node_05] -/
theorem burnin_transfer (ε : ℝ) (hε : 0 < ε) (n : ℕ) (hn : 2 ≤ n)
    (p : Fin n → Fin n → ℝ) (hp : Admissible ε n p) (L : Finset (Equiv.Perm (Fin n)))
    (hL : 0 < massOf (stationary n p) L) (T₀ s : ℕ) (α : ℝ)
    (hs : ∀ y ∈ L, tvDist (transitionPow (restrictedKernel (kernel n p) L) y s)
      (condOn (stationary n p) L) ≤ α) (x : Equiv.Perm (Fin n)) :
    tvDist (transitionPow (kernel n p) x (T₀ + s)) (condOn (stationary n p) L) ≤
      α + ∑ u ∈ Finset.range (s + 1), massOf (transitionPow (kernel n p) x (T₀ + u)) Lᶜ := by
  sorry

/-- Rubric 3 (truncation preserves positive bias and lower-bounds all probabilities). [MixingOfGeneralBiased, node_05] -/
theorem truncate_admissible (ε : ℝ) (hε : 0 < ε) (κ : ℝ) (hκ : 3 < κ) :
    ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ p : Fin n → Fin n → ℝ, Admissible ε n p →
      Admissible ε n (truncate n p ((n : ℝ) ^ (-κ))) ∧
      (∀ i j : Fin n, i ≠ j → (n : ℝ) ^ (-κ) ≤ truncate n p ((n : ℝ) ^ (-κ)) i j) := by
  sorry

/-- Rubric 3 (finite-time kernel coupling): if one step of two stochastic kernels differs
by at most `a` in TV from every state, then `‖νK^t - νK'^t‖_TV ≤ t a` for every
probability vector `ν`. [MixingOfGeneralBiased, node_05] -/
theorem tv_iterDist_le_of_kernel_close {S : Type} [Fintype S] (K K' : S → S → ℝ)
    (hK : IsStochastic K) (hK' : IsStochastic K') (a : ℝ)
    (hclose : ∀ x, tvDist (K x) (K' x) ≤ a) (ν : FinDist S) (t : ℕ) :
    tvDist (iterDist K (⇑ν) t) (iterDist K' (⇑ν) t) ≤ t * a := by
  sorry

/-- Rubric 4 (Chernoff step): started from the reversed permutation, particle `0` (the
paper's particle 1, starting at position `n`) is, at time `⌊(1 - n^{-1/4}) n²⌋`, at position
`≤ √n` with probability at most `exp(-c √n)`. [MixingOfGeneralBiased, node_05] -/
theorem reversed_start_particle_far (ε : ℝ) (hε : 0 < ε) :
    ∃ c : ℝ, 0 < c ∧ ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ (hn : 0 < n) (p : Fin n → Fin n → ℝ),
      Admissible ε n p →
      massOf (transitionPow (kernel n p) Fin.revPerm
                ⌊(1 - (n : ℝ) ^ (-(1 / 4 : ℝ))) * (n : ℝ) ^ 2⌋₊)
        (Finset.univ.filter (fun σ : Equiv.Perm (Fin n) =>
          (((σ.symm ⟨0, hn⟩ : Fin n) : ℕ) : ℝ) ≤ Real.sqrt n))
        ≤ Real.exp (-c * Real.sqrt n) := by
  sorry

/-! ## Main theorem -/

/-- Under the localization hypothesis:
(1) explicit upper bound `T_mix(δ) ≤ K n² + O_ε(n (log n)^B log(4/δ))`, stated as
    `d_n(⌊K n² + D n (log n)^B log(4/δ)⌋) ≤ δ` with `D` depending only on `ε`;
(2) lower bound `T_mix(δ) ≥ n²(1 - o(1))`: for every `η > 0` eventually `d_n(t) > δ`
    for all `t ≤ (1-η) n²`;
(3) pre-cutoff: for `δ ∈ (0, 1/2)`, eventually `T_mix(δ) ≤ C · T_mix(1-δ)`.
All uniform over admissible parameter arrays. [MixingOfGeneralBiased, node_05] -/
theorem biased_adjacent_transposition_mixing (ε : ℝ) (hε : 0 < ε)
    (C0 K A B κ : ℝ) (hC0 : 0 < C0) (hK : 0 < K) (hA : 0 < A) (hκ : 3 < κ)
    (hloc : LocalizationHypothesis ε C0 K A B κ) :
    (∃ D : ℝ, 0 < D ∧ ∀ δ : ℝ, 0 < δ → δ < 1 →
      ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ p : Fin n → Fin n → ℝ, Admissible ε n p →
        worstTV n p
          ⌊K * (n : ℝ) ^ 2 + D * n * (Real.log n) ^ B * Real.log (4 / δ)⌋₊ ≤ δ) ∧
    (∀ δ : ℝ, 0 < δ → δ < 1 → ∀ η : ℝ, 0 < η →
      ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ p : Fin n → Fin n → ℝ, Admissible ε n p →
        ∀ t : ℕ, (t : ℝ) ≤ (1 - η) * (n : ℝ) ^ 2 → δ < worstTV n p t) ∧
    (∃ C : ℝ, 0 < C ∧ ∀ δ : ℝ, 0 < δ → δ < 1 / 2 →
      ∃ N : ℕ, ∀ n : ℕ, N ≤ n → ∀ p : Fin n → Fin n → ℝ, Admissible ε n p →
        (mixingTime n p δ : ℝ) ≤ C * (mixingTime n p (1 - δ) : ℝ)) := by
  sorry

