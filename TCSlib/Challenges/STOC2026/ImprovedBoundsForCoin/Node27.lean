/-!
## Total influence of a multi-valued function bounds its output entropy

For `f : {0,1}^n → [M]`, `I_i(f) = Pr[f(U_n) ≠ f(U_n^{⊕i})]`, `I(f) = ∑_i I_i(f)`, and
`H(f(U_n)) = ∑_y p_y log₂(1/p_y)`. The main theorem `entropy_le_totalInfluence` states
`I(f) ≥ H(f(U_n))`.

The cube is TCSlib's `BoolCube n`, bit flips are `flipBit`. The law of `f(U_n)` is the
pushforward `FinDist.map f (FinDist.uniform (BoolCube n))`. Influences of the Boolean fibre
indicators are TCSlib's `influence`/`totalInfluence` of the ±1 function `boolToSign ∘ g`,
which equal `Pr[g(x) ≠ g(x^{⊕i})]`. Influences of the multi-valued `f` (`influenceM`,
`totalInfluenceM`) are local, written as counts divided by `2^n`.
-/

namespace TCSChallenge.ImprovedBoundsForCoin.node_27

open BooleanAnalysis TCSlib.InformationTheory

/-- "`I_i(f) = Pr[f(U_n) ≠ f(U_n^{⊕i})]`" for a multi-valued `f` (uniform probability over
`x ∈ {0,1}^n`). -/
noncomputable def influenceM {n : ℕ} {α : Type} [DecidableEq α] (f : BoolCube n → α)
    (i : Fin n) : ℝ :=
  ((Finset.univ.filter (fun x : BoolCube n => f x ≠ f (flipBit x i))).card : ℝ) / (2 : ℝ) ^ n

/-- "`I(f) = ∑_{i=1}^n I_i(f)`" for a multi-valued `f`. -/
noncomputable def totalInfluenceM {n : ℕ} {α : Type} [DecidableEq α] (f : BoolCube n → α) : ℝ :=
  ∑ i : Fin n, influenceM f i

/-- The law of `f(U_n)`; "`p_y = Pr[f(U_n) = y]`" is `outDist f y`. -/
noncomputable def outDist {n : ℕ} {α : Type} [Fintype α] [DecidableEq α]
    (f : BoolCube n → α) : FinDist α :=
  FinDist.map f (FinDist.uniform (BoolCube n))

/-- "`H(f(U_n)) = ∑_{y=1}^M p_y log₂(1/p_y)`, where a term with `p_y = 0` is interpreted as `0`."
With Mathlib's conventions `Real.logb 2 (1/0) = 0`, so the zero term is automatically `0`. -/
noncomputable def entropy {n M : ℕ} (f : BoolCube n → Fin M) : ℝ :=
  ∑ y : Fin M, outDist f y * Real.logb 2 (1 / outDist f y)

/-- The Boolean indicator of the fibre `{f = y}`: "`χ_y(x) = 1{f(x) = y}`". -/
def fiberIndicator {n M : ℕ} (f : BoolCube n → Fin M) (y : Fin M) : BoolCube n → Bool :=
  fun x => decide (f x = y)

/-- Supplied Boolean boundary estimate: a Boolean function with `Pr[g = 1] = p` has
`I(g) ≥ 2 p log₂(1/p)`; `I(g)` is the total influence of the ±1 version `boolToSign ∘ g`. [ImprovedBoundsForCoin, node_27] -/
theorem boolean_edge_isoperimetry {n : ℕ} (g : BoolCube n → Bool) :
    2 * outDist g true * Real.logb 2 (1 / outDist g true) ≤
      totalInfluence (fun x => boolToSign (g x)) := by
  sorry

/-- Rubric 2: exact factor-two identity `∑_y I_i(χ_y) = 2 I_i(f)` for every coordinate `i`. [ImprovedBoundsForCoin, node_27] -/
theorem sum_fiber_influence_eq_two_mul {n M : ℕ} (f : BoolCube n → Fin M) (i : Fin n) :
    ∑ y : Fin M, influence i (fun x => boolToSign (fiberIndicator f y x)) =
      2 * influenceM f i := by
  sorry

/-- Summed version: `I(f) = ½ ∑_y I(χ_y)`. [ImprovedBoundsForCoin, node_27] -/
theorem totalInfluence_eq_half_sum_fiber {n M : ℕ} (f : BoolCube n → Fin M) :
    totalInfluenceM f =
      (1 / 2) * ∑ y : Fin M, totalInfluence (fun x => boolToSign (fiberIndicator f y x)) := by
  sorry

/-- Main theorem: every `f : {0,1}^n → [M]` satisfies `I(f) ≥ H(f(U_n))`. [ImprovedBoundsForCoin, node_27] -/
theorem entropy_le_totalInfluence (n M : ℕ) (_hn : 0 < n) (_hM : 0 < M)
    (f : BoolCube n → Fin M) :
    entropy f ≤ totalInfluenceM f := by
  sorry

end TCSChallenge.ImprovedBoundsForCoin.node_27
