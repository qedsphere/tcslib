/-!
## `k`-round coin flipping against `γℓ / (log ℓ · (log^{(k)} ℓ)²)` full-information corruptions

Synchronous full-information broadcast with `ℓ` players and `k` rounds; in each round every
player broadcasts one bit. Good players broadcast fresh uniform bits; the coalition `B` chooses
its round-`j` bits after seeing the good bits of rounds `≤ j` (hence the whole transcript so
far). The protocol output is a deterministic function of the full transcript.

Main theorem `exists_k_round_coin_flip`: there is an absolute constant `C` such that for
every `k ≥ 2`, `ℓ`, and `0 < γ < 1/2` some protocol has `|Pr[C = 1] − ½| ≤
C (γ + (log^{(k-1)} ℓ)^{-0.2})` against every coalition of size at most
`γ ℓ / (log ℓ (log^{(k)} ℓ)²)`.
-/

namespace TCSChallenge.ImprovedBoundsForCoin.node_18

/-- "`log^{(0)} ℓ = ℓ` and `log^{(i+1)} ℓ = log₂(log^{(i)} ℓ)`", truncated below at the absolute
constant `2` ("Iterated logarithms may be truncated below by an absolute constant"). -/
noncomputable def iterLog : ℕ → ℝ → ℝ
  | 0, x => x
  | i + 1, x => max 2 (Real.logb 2 (iterLog i x))

/-- The honest random tape / transcript: bit of player `i` in round `j`. -/
abbrev Tape (k ℓ : ℕ) : Type := Fin k → Fin ℓ → Bool

/-- A full-information adversary for coalition `B`: its round-`j` bits `A j h i` (`i ∈ B`)
may depend only on the good players' bits in rounds `0, …, j` ("may choose its broadcasts
after seeing all good players' broadcasts in that round"). -/
def Causal {k ℓ : ℕ} (B : Finset (Fin ℓ)) (A : Fin k → Tape k ℓ → Fin ℓ → Bool) : Prop :=
  ∀ (j : Fin k) (h h' : Tape k ℓ),
    (∀ j' : Fin k, j' ≤ j → ∀ i : Fin ℓ, i ∉ B → h j' i = h' j' i) →
    ∀ i : Fin ℓ, i ∈ B → A j h i = A j h' i

/-- The transcript actually broadcast: good players send their tape bits, bad players send
the adversary's choices. -/
def transcript {k ℓ : ℕ} (B : Finset (Fin ℓ)) (A : Fin k → Tape k ℓ → Fin ℓ → Bool)
    (h : Tape k ℓ) : Tape k ℓ :=
  fun j i => if i ∈ B then A j h i else h j i

/-- `Pr[C = 1]` for output `C = out(transcript)`, the honest tape uniform. -/
noncomputable def probOne {k ℓ : ℕ} (out : Tape k ℓ → Bool) (B : Finset (Fin ℓ))
    (A : Fin k → Tape k ℓ → Fin ℓ → Bool) : ℝ :=
  ((Finset.univ.filter (fun h : Tape k ℓ => out (transcript B A h) = true)).card : ℝ) /
    (Fintype.card (Tape k ℓ) : ℝ)

/-- "The distance from uniform of an output bit `C` is `|Pr[C=1] − ½|`." -/
noncomputable def bias {k ℓ : ℕ} (out : Tape k ℓ → Bool) (B : Finset (Fin ℓ))
    (A : Fin k → Tape k ℓ → Fin ℓ → Bool) : ℝ :=
  |probOne out B A - 1 / 2|

/-- Rubric 3 (failure analysis): once `log^{(k-1)} ℓ` exceeds an absolute threshold, the
per-round failure probabilities `exp(−(log^{(i)} ℓ)^{1.49})`, `1 ≤ i ≤ k-1`, sum to at most
twice the last one (no factor of `k`). [ImprovedBoundsForCoin, node_18] -/
theorem failure_sum_le {c₀ : ℝ} (hc₀ : (0 : ℝ) < c₀) :
    ∃ c₁ : ℝ, c₀ ≤ c₁ ∧ ∀ k : ℕ, 2 ≤ k → ∀ ℓ : ℝ, c₁ ≤ iterLog (k - 1) ℓ →
      ∑ i ∈ Finset.Icc 1 (k - 1), Real.exp (-(iterLog i ℓ) ^ (1.49 : ℝ))
        ≤ 2 * Real.exp (-(iterLog (k - 1) ℓ) ^ (1.49 : ℝ)) := by
  sorry

/-- Main theorem: `k`-round coin flipping with one bit per player per round. [ImprovedBoundsForCoin, node_18] -/
theorem exists_k_round_coin_flip :
    ∃ C : ℝ, 0 < C ∧
      ∀ k : ℕ, 2 ≤ k → ∀ ℓ : ℕ, ∀ γ : ℝ, 0 < γ → γ < 1 / 2 →
        ∃ out : Tape k ℓ → Bool,
          ∀ B : Finset (Fin ℓ),
            (B.card : ℝ) ≤ γ * (ℓ : ℝ) / (iterLog 1 (ℓ : ℝ) * (iterLog k (ℓ : ℝ)) ^ 2) →
            ∀ A : Fin k → Tape k ℓ → Fin ℓ → Bool, Causal B A →
              bias out B A ≤ C * (γ + (iterLog (k - 1) (ℓ : ℝ)) ^ (-(0.2 : ℝ))) := by
  sorry

end TCSChallenge.ImprovedBoundsForCoin.node_18
