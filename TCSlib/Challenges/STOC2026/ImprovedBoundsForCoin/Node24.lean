/-!
## One-round random selection of `m` bits against `b ≲ ℓ / max((log ℓ)², m)` corruptions

Players `1,…,ℓ`; honest players broadcast uniform bits; an adversary controlling `B`, after
seeing all honest bits, chooses the bits of `B`; the protocol `π : {0,1}^ℓ → {0,1}^m` is a
deterministic function of the transcript. Assuming the short-output resilient primitive
`F_n : {0,1}^n → {0,1}^{⌊0.49 log n⌋}` (bias `≤ θ`, fixing probability `≤ |T| K_θ (log n)²/n`),
the main theorem `exists_one_round_selection` asserts: for every `0 < ε < 1/4` there is `C₀`
such that whenever `b ≤ min(ℓ/(C₀ (log ℓ)²), ℓ/(C₀ m))` some `π` has output within
statistical distance `ε` of `U_m` against every adversary controlling at most `b` players.

The cube `{0,1}^k` is TCSlib's `BoolCube k`; the law of `g(U_k)` is
`FinDist.map g (FinDist.uniform _)` and distances are TCSlib's `statDist`. The fixing
probability `fixFail` is a count divided by `2^n`; `log = Real.logb 2`.
-/

namespace TCSChallenge.ImprovedBoundsForCoin.node_24

open TCSlib.InformationTheory BooleanAnalysis

/-- "`d_TV(P,Q) = ½ ∑_ω |P(ω) − Q(ω)|`" with `P = g(U_k)` and `Q = U_t`. -/
noncomputable def tvToUniform {k t : ℕ} (g : BoolCube k → BoolCube t) : ℝ :=
  statDist (FinDist.map g (FinDist.uniform (BoolCube k))) (FinDist.uniform (BoolCube t))

/-- "`r_n = ⌊0.49 log n⌋`". -/
noncomputable def rOut (n : ℕ) : ℕ := ⌊(0.49 : ℝ) * Real.logb 2 (n : ℝ)⌋₊

open Classical in
/-- "`Pr_{x ← U_{[n]∖T}}[|{F(x,z) : z ∈ {0,1}^T}| > 1]`". The event depends only on the
coordinates outside `T`, so it is measured under the uniform distribution on all of `{0,1}^n`:
`x` is bad when some `x'` agreeing with `x` off `T` has `F x' ≠ F x`. -/
noncomputable def fixFail {n t : ℕ} (F : BoolCube n → BoolCube t) (T : Finset (Fin n)) : ℝ :=
  ((Finset.univ.filter (fun x : BoolCube n =>
      ∃ x' : BoolCube n, (∀ i, i ∉ T → x' i = x i) ∧ F x' ≠ F x)).card : ℝ) / (2 : ℝ) ^ n

/-- The assumed primitive: "for every `0 < θ < 1/4` there are constants `K_θ` and `n_θ` such
that for every `n ≥ n_θ` there is a function `F_n : {0,1}^n → {0,1}^{r_n}` with
`d_TV(F_n(U_n), U_{r_n}) ≤ θ` and, for every `T ⊆ [n]`, fixing failure `≤ |T| K_θ (log n)²/n`." -/
def ShortOutputPrimitive : Prop :=
  ∀ θ : ℝ, 0 < θ → θ < 1 / 4 → ∃ K : ℝ, ∃ nθ : ℕ, ∀ n : ℕ, nθ ≤ n →
    ∃ F : BoolCube n → BoolCube (rOut n),
      tvToUniform F ≤ θ ∧
      ∀ T : Finset (Fin n),
        fixFail F T ≤ (T.card : ℝ) * K * (Real.logb 2 (n : ℝ)) ^ 2 / (n : ℝ)

/-- A full-information adversary strategy for coalition `B`: the bits it writes on `B`
(`A x i`, `i ∈ B`) may depend on all honest bits but not on the honest tape's entries on `B`
(which are overwritten). -/
def HonestOnly {ℓ : ℕ} (B : Finset (Fin ℓ)) (A : BoolCube ℓ → BoolCube ℓ) : Prop :=
  ∀ x x' : BoolCube ℓ, (∀ i, i ∉ B → x i = x' i) → ∀ i, i ∈ B → A x i = A x' i

/-- The transcript: honest players' uniform bits, the adversary's bits on `B`. -/
def corrupt {ℓ : ℕ} (B : Finset (Fin ℓ)) (A : BoolCube ℓ → BoolCube ℓ) (x : BoolCube ℓ) :
    BoolCube ℓ :=
  fun i => if i ∈ B then A x i else x i

/-- Rubric 1 (amplification): concatenating two functions of disjoint inputs adds their
distances from uniform (product hybrid argument). [ImprovedBoundsForCoin, node_24] -/
theorem tvToUniform_append_le {a c p q : ℕ} (F : BoolCube a → BoolCube p)
    (G : BoolCube c → BoolCube q) :
    tvToUniform (fun x : BoolCube (a + c) =>
        Fin.append (F (fun i => x (Fin.castAdd c i))) (G (fun j => x (Fin.natAdd a j))))
      ≤ tvToUniform F + tvToUniform G := by
  sorry

/-- Main theorem (one-round random selection of `m` bits). [ImprovedBoundsForCoin, node_24] -/
theorem exists_one_round_selection (hprim : ShortOutputPrimitive)
    (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1 / 4) :
    ∃ C₀ : ℝ, 0 < C₀ ∧
      ∀ b ℓ m : ℕ, 1 ≤ b → 1 ≤ ℓ → 1 ≤ m →
        (b : ℝ) ≤ (ℓ : ℝ) / (C₀ * (Real.logb 2 (ℓ : ℝ)) ^ 2) →
        (b : ℝ) ≤ (ℓ : ℝ) / (C₀ * (m : ℝ)) →
        ∃ π : BoolCube ℓ → BoolCube m,
          ∀ B : Finset (Fin ℓ), B.card ≤ b →
            ∀ A : BoolCube ℓ → BoolCube ℓ, HonestOnly B A →
              tvToUniform (fun x => π (corrupt B A x)) ≤ ε := by
  sorry

end TCSChallenge.ImprovedBoundsForCoin.node_24
