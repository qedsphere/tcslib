/-!
## Strong spatial mixing for `q`-colourings of trees with `q ≥ Δ + 3`

Fix `Δ ≥ 3` and `q ≥ Δ + 3`; colours are `Fin q`. For a tree `G` of maximum degree `≤ Δ`, a
finite volume `W` with boundary colours `η` on the outside, a pinning `σ` on `Λ ⊆ W \ {v}`
that extends to a compatible proper colouring, `μ_v^σ` is the conditional law of the colour
of `v` under the uniform measure on compatible proper colourings agreeing with `σ` on `Λ`.

Main theorem `strong_spatial_mixing`: there are `C < ∞`, `r ∈ (0,1)` depending only on
`q, Δ` with `d_TV(μ_v^σ, μ_v^τ) ≤ C r^{dist(v, D(σ,τ))}`, `D(σ,τ) = {u ∈ Λ | σ u ≠ τ u}`.

Lemma stubs follow the reference proof: abstract tree recursion `g`, its one-step bound
`1/(Q-d)`, the sharper two-step bound `B`, the scalar bounds on `x, B, w`, the interpolation
lemma for `ψ = φ⁻¹`, the weighted contraction in `φ = 2 artanh √·` coordinates, the bounded
root step, and the conversion from `φ`-distance to total variation.
-/

namespace TCSChallenge.StrongSpatialMixingForColorings.node04

open Finset

/-! ## The colouring model -/

open Classical in
/-- A configuration on the finite volume `W`, extended to all of `V` by the boundary
condition `η` ("prescribed colors on its external neighbors"; values of `η` elsewhere are
irrelevant). -/
noncomputable def extend {V : Type*} {q : ℕ} (W : Finset V) (η : V → Fin q)
    (X : ↥W → Fin q) : V → Fin q :=
  fun u => if h : u ∈ W then X ⟨u, h⟩ else η u

/-- `X` is a proper colouring of `W` compatible with the boundary `η` ("`X(u) ≠ X(w)` for
every `uw ∈ E`", checked on every edge meeting `W`) and agrees with the pinning `σ` on `Λ`
("`X|_Λ = σ`"). -/
def IsCompatible {V : Type*} {q : ℕ} (G : SimpleGraph V) (W : Finset V) (η : V → Fin q)
    (Λ : Set V) (σ : V → Fin q) (X : ↥W → Fin q) : Prop :=
  (∀ u w : V, G.Adj u w → (u ∈ W ∨ w ∈ W) → extend W η X u ≠ extend W η X w) ∧
  (∀ u : ↥W, (u : V) ∈ Λ → X u = σ (u : V))

/-- "`σ : Λ → [q]` extends to a proper coloring." -/
def Extendible {V : Type*} {q : ℕ} (G : SimpleGraph V) (W : Finset V) (η : V → Fin q)
    (Λ : Set V) (σ : V → Fin q) : Prop :=
  ∃ X : ↥W → Fin q, IsCompatible G W η Λ σ X

/-- "`μ_{T,v}^σ`, the conditional law of `X(v)` given `X|_Λ = σ`" under the uniform measure
on compatible proper colourings: a ratio of counts. -/
noncomputable def condMarginal {V : Type*} {q : ℕ} (G : SimpleGraph V) (W : Finset V)
    (η : V → Fin q) (Λ : Set V) (σ : V → Fin q) (v : V) (c : Fin q) : ℝ :=
  (Nat.card {X : ↥W → Fin q // IsCompatible G W η Λ σ X ∧ extend W η X v = c} : ℝ) /
    (Nat.card {X : ↥W → Fin q // IsCompatible G W η Λ σ X} : ℝ)

/-- Total variation distance `(1/2) ∑_c |μ(c) − ν(c)|`. -/
noncomputable def tvDist {q : ℕ} (μ ν : Fin q → ℝ) : ℝ :=
  (1 / 2 : ℝ) * ∑ c, |μ c - ν c|

/-- "`D(σ,τ) = {u ∈ Λ : σ(u) ≠ τ(u)}`." -/
def disagreement {V : Type*} {q : ℕ} (Λ : Set V) (σ τ : V → Fin q) : Set V :=
  {u | u ∈ Λ ∧ σ u ≠ τ u}

/-- "Maximum degree at most `Δ`" (works for infinite, locally finite trees). -/
def MaxDegreeLE {V : Type*} (G : SimpleGraph V) (Δ : ℕ) : Prop :=
  ∀ u : V, (G.neighborSet u).Finite ∧ (G.neighborSet u).ncard ≤ Δ

/-! ## The abstract tree recursion and its parameters -/

/-- `∏_{i=1}^d (1 − p_i(b))`. -/
noncomputable def childProd {q d : ℕ} (p : Fin d → Fin q → ℝ) (b : Fin q) : ℝ :=
  ∏ i, (1 - p i b)

/-- The recursion (2): `g_c(p) = ∏_i (1 − p_i(c)) / ∑_{b ∈ L} ∏_i (1 − p_i(b))` for `c ∈ L`,
and `0` outside the list `L`. -/
noncomputable def recursion {q d : ℕ} (L : Finset (Fin q)) (p : Fin d → Fin q → ℝ)
    (c : Fin q) : ℝ :=
  if c ∈ L then childProd p c / ∑ b ∈ L, childProd p b else 0

/-- A nonnegative vector of total mass at most one ("subdistribution"). -/
def SubDist {q : ℕ} (p : Fin q → ℝ) : Prop :=
  (∀ c, 0 ≤ p c) ∧ ∑ c, p c ≤ 1

/-- `ξ = (4/3)^{4d/(Q−1)}`. -/
noncomputable def xiP (Q d : ℕ) : ℝ := (4 / 3 : ℝ) ^ ((4 * (d : ℝ)) / ((Q : ℝ) - 1))

/-- `x = ξ/(Q−1)`. -/
noncomputable def xP (Q d : ℕ) : ℝ := xiP Q d / ((Q : ℝ) - 1)

/-- `B = x/(1+x)`, the sharper two-step marginal bound. -/
noncomputable def BP (Q d : ℕ) : ℝ := xP Q d / (1 + xP Q d)

/-- `ζ = (1 + 1/x) log(1+x) − 1`. -/
noncomputable def zetaP (Q d : ℕ) : ℝ := (1 + 1 / xP Q d) * Real.log (1 + xP Q d) - 1

/-- The weight `w = (1 − ζ)^{−1/2}`. -/
noncomputable def wP (Q d : ℕ) : ℝ := (1 - zetaP Q d) ^ (-(1 / 2 : ℝ))

/-- `φ(t) = 2 artanh(√t) = log((1+√t)/(1−√t))`. -/
noncomputable def phi (t : ℝ) : ℝ := Real.log ((1 + Real.sqrt t) / (1 - Real.sqrt t))

/-- `ψ(m) = φ⁻¹(m) = tanh²(m/2) = ((e^m − 1)/(e^m + 1))²`. -/
noncomputable def psi (m : ℝ) : ℝ := ((Real.exp m - 1) / (Real.exp m + 1)) ^ 2

/-- Euclidean norm on `ℝ^q`. -/
noncomputable def l2 {q : ℕ} (h : Fin q → ℝ) : ℝ := Real.sqrt (∑ c, h c ^ 2)

/-- `φ(a) − φ(b)` coordinatewise. -/
noncomputable def phiDiff {q : ℕ} (a b : Fin q → ℝ) : Fin q → ℝ := fun c => phi (a c) - phi (b c)

/-! ## Lemma stubs -/

/-- Rubric 1/6 (one-step bound in the actual model): with `q ≥ Δ + 3`, every conditional
marginal at a free vertex is at most `1/(q − Δ) ≤ 1/3`. [StrongSpatialMixingFor, node_04] -/
theorem condMarginal_le_inv (Δ q : ℕ) (hq : Δ + 3 ≤ q) {V : Type*} (G : SimpleGraph V)
    (hT : G.IsTree) (hdeg : MaxDegreeLE G Δ) (W : Finset V) (η : V → Fin q) (Λ : Set V)
    (σ : V → Fin q) (v : V) (hv : v ∈ W) (hvΛ : v ∉ Λ) (hΛ : Λ ⊆ (W : Set V))
    (hσ : Extendible G W η Λ σ) (c : Fin q) :
    condMarginal G W η Λ σ v c ≤ 1 / ((q : ℝ) - Δ) := by
  sorry

/-- (3): `Z(p) ≥ Q − d`, hence `g_c(p) ≤ 1/(Q − d)` for subdistribution inputs. [StrongSpatialMixingFor, node_04] -/
theorem recursion_le_inv_slack {q d : ℕ} (L : Finset (Fin q)) (hL : d < L.card)
    (p : Fin d → Fin q → ℝ) (hp : ∀ i, SubDist (p i)) (c : Fin q) :
    recursion L p c ≤ 1 / ((L.card : ℝ) - d) := by
  sorry

/-- Rubric 2 (two-step marginal bound): if all children have coordinates at most `1/4` and
`Q = |L| ≥ d + 4`, the output is bounded by `B = x/(1+x)`. [StrongSpatialMixingFor, node_04] -/
theorem recursion_le_B {q d : ℕ} (L : Finset (Fin q)) (hL : d + 4 ≤ L.card)
    (p : Fin d → Fin q → ℝ) (hp : ∀ i, SubDist (p i) ∧ ∀ b, p i b ≤ 1 / 4) (c : Fin q) :
    recursion L p c ≤ BP L.card d := by
  sorry

/-- (5)–(6): for `Q ≥ d + 4`, `0 < x ≤ 1/3`, `B ≤ 1/4`, `0 < ζ` and `1 ≤ w ≤ e^{1/12}`. [StrongSpatialMixingFor, node_04] -/
theorem scalar_bounds (Q d : ℕ) (h : d + 4 ≤ Q) :
    0 < xP Q d ∧ xP Q d ≤ 1 / 3 ∧ BP Q d ≤ 1 / 4 ∧ 0 < zetaP Q d ∧ zetaP Q d < 1 ∧
      1 ≤ wP Q d ∧ wP Q d ≤ Real.exp (1 / 12) := by
  sorry

/-- Rubric 5 (admissible interpolation): straight-line interpolation in `φ`-coordinates of
two values in `[0, B]`, `B ≤ 1/4`, stays in `[0, B]` and lies below the linear interpolation
(convexity of `ψ` on `[0, φ(1/4)]`); in particular masses stay at most one. [StrongSpatialMixingFor, node_04] -/
theorem psi_interpolation (B a a' t : ℝ) (hB : B ≤ 1 / 4) (ha : 0 ≤ a) (haB : a ≤ B)
    (ha' : 0 ≤ a') (ha'B : a' ≤ B) (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    0 ≤ psi ((1 - t) * phi a + t * phi a') ∧
      psi ((1 - t) * phi a + t * phi a') ≤ (1 - t) * a + t * a' ∧
      psi ((1 - t) * phi a + t * phi a') ≤ B := by
  sorry

/-- Rubrics 3–4 (14), weighted strict contraction at a non-root vertex: parent list `L` with
`|L| ≥ d + 4`, children with parameters `Q_i ≥ d_i + 4`, child messages subdistributions
bounded by `B_i`. With `r = exp(−4/(81q))`,
`w ‖φ(g(p)) − φ(g(p'))‖₂ ≤ r · max_i w_i ‖φ(p_i) − φ(p'_i)‖₂`
(the max is encoded by any upper bound `M ≥ 0`). [StrongSpatialMixingFor, node_04] -/
theorem weighted_contraction {q d : ℕ} (L : Finset (Fin q)) (hL : d + 4 ≤ L.card)
    (Qc dc : Fin d → ℕ) (hc : ∀ i, dc i + 4 ≤ Qc i)
    (p p' : Fin d → Fin q → ℝ)
    (hp : ∀ i, SubDist (p i) ∧ ∀ b, p i b ≤ BP (Qc i) (dc i))
    (hp' : ∀ i, SubDist (p' i) ∧ ∀ b, p' i b ≤ BP (Qc i) (dc i))
    (M : ℝ) (hM0 : 0 ≤ M) (hM : ∀ i, wP (Qc i) (dc i) * l2 (phiDiff (p i) (p' i)) ≤ M) :
    wP L.card d * l2 (phiDiff (recursion L p) (recursion L p')) ≤
      Real.exp (-(4 / (81 * (q : ℝ)))) * M := by
  sorry

/-- (15), bounded root step: at the root the slack may only be three (`|L| ≥ d + 3`); with
child coordinates at most `1/4`, the recursion is `(√3 d/4)`-Lipschitz in `φ`-coordinates. [StrongSpatialMixingFor, node_04] -/
theorem root_lipschitz {q d : ℕ} (L : Finset (Fin q)) (hL : d + 3 ≤ L.card)
    (p p' : Fin d → Fin q → ℝ)
    (hp : ∀ i, SubDist (p i) ∧ ∀ b, p i b ≤ 1 / 4)
    (hp' : ∀ i, SubDist (p' i) ∧ ∀ b, p' i b ≤ 1 / 4)
    (M : ℝ) (hM0 : 0 ≤ M) (hM : ∀ i, l2 (phiDiff (p i) (p' i)) ≤ M) :
    l2 (phiDiff (recursion L p) (recursion L p')) ≤ Real.sqrt 3 * (d : ℝ) / 4 * M := by
  sorry

/-- Rubric 6 (conversion to total variation): since `ψ' ≤ 1`, for vectors with coordinates
in `[0, 1/3]`, `‖a − b‖_TV ≤ (√q / 2) ‖φ(a) − φ(b)‖₂`. [StrongSpatialMixingFor, node_04] -/
theorem tv_le_phi_dist {q : ℕ} (a b : Fin q → ℝ) (ha : ∀ c, 0 ≤ a c ∧ a c ≤ 1 / 3)
    (hb : ∀ c, 0 ≤ b c ∧ b c ≤ 1 / 3) :
    tvDist a b ≤ Real.sqrt q / 2 * l2 (phiDiff a b) := by
  sorry

/-! ## Main theorem -/

/-- **Strong spatial mixing for colourings on trees, `q ≥ Δ + 3`.** There exist `C < ∞` and
`r ∈ (0,1)` depending only on `q, Δ` such that for every tree `G` of maximum degree `≤ Δ`,
every finite-volume specification `(W, η)`, every free vertex `v ∈ W`, every `Λ ⊆ W \ {v}`
and extendible `σ, τ` on `Λ`,
`d_TV(μ_v^σ, μ_v^τ) ≤ C r^{dist(v, D(σ,τ))}` (`= 0` when `D = ∅`). [StrongSpatialMixingFor, node_04] -/
theorem strong_spatial_mixing (Δ q : ℕ) (hΔ : 3 ≤ Δ) (hq : Δ + 3 ≤ q) :
    ∃ C r : ℝ, 0 ≤ C ∧ 0 < r ∧ r < 1 ∧
      ∀ (V : Type) (G : SimpleGraph V), G.IsTree → MaxDegreeLE G Δ →
        ∀ (W : Finset V) (η : V → Fin q) (Λ : Set V) (σ τ : V → Fin q) (v : V),
          v ∈ W → v ∉ Λ → Λ ⊆ (W : Set V) →
          Extendible G W η Λ σ → Extendible G W η Λ τ →
          ∀ k : ℕ, (∀ u ∈ disagreement Λ σ τ, k ≤ G.dist v u) →
            tvDist (condMarginal G W η Λ σ v) (condMarginal G W η Λ τ v) ≤ C * r ^ k := by
  sorry

/-- The finite-tree case: `W` is the whole (finite) vertex set, so the boundary `η` is
never read and `μ_T` is the uniform measure on proper `[q]`-colourings of `T`. [StrongSpatialMixingFor, node_04] -/
theorem strong_spatial_mixing_finite_tree (Δ q : ℕ) (hΔ : 3 ≤ Δ) (hq : Δ + 3 ≤ q) :
    ∃ C r : ℝ, 0 ≤ C ∧ 0 < r ∧ r < 1 ∧
      ∀ (V : Type) [Fintype V] (G : SimpleGraph V), G.IsTree → MaxDegreeLE G Δ →
        ∀ (η : V → Fin q) (Λ : Set V) (σ τ : V → Fin q) (v : V), v ∉ Λ →
          Extendible G Finset.univ η Λ σ → Extendible G Finset.univ η Λ τ →
          ∀ k : ℕ, (∀ u ∈ disagreement Λ σ τ, k ≤ G.dist v u) →
            tvDist (condMarginal G Finset.univ η Λ σ v)
              (condMarginal G Finset.univ η Λ τ v) ≤ C * r ^ k := by
  sorry

end TCSChallenge.StrongSpatialMixingForColorings.node04
