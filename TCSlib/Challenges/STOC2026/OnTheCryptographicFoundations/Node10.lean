/-!
## Query sampling for compression unitaries

For distributions `D_x, D'_x` on a finite set `Y`, let `|P⟩ = ∑_y √P(y) |y⟩` and let `C(P)` be
the unitary swapping `|⊥⟩` with `|P⟩` and fixing their orthogonal complement. The oracle
`U = ∑_x |x⟩⟨x|_Q ⊗ C(D_x)_{M_x} ⊗ I` (and `U'` with `D'_x`) is queried `q ≥ 1` times by an
oracle-independent purified algorithm, giving final states `|ψ⟩`, `|ψ'⟩` with
`Δ = TD(|ψ⟩,|ψ'⟩)`. The sampler `𝓑^U` picks `i ∈ {1,…,q}` uniformly, runs the algorithm with `U`
up to just before the `i`-th query, and measures `Q`. Main theorem
`expected_SD_ge` : `𝔼_{x ← 𝓑^U}[SD(D_x, D'_x)] ≥ Δ² / (16 q²)`.

Distributions are TCSlib `FinDist`s and `SD` is TCSlib's `statDist`. The oracle and its
building blocks (`ket`, `compression`, `queryOracle`, `samplerProb`) stay defined on plain
functions `Y → ℝ` and are applied to the coercions `⇑(D x)`.
-/

namespace TCSChallenge.OnTheCryptographicFoundations.node_10

open Matrix
open TCSlib.InformationTheory

/-- The coherent encoding `|P⟩ = ∑_y √P(y) |y⟩`, a vector on `span{|⊥⟩, |y⟩}`, with
`none` playing the role of `|⊥⟩` (so `|P⟩` has zero `⊥`-coordinate). -/
noncomputable def ket {Y : Type} (P : Y → ℝ) : Option Y → ℂ
  | none => 0
  | some y => ((Real.sqrt (P y) : ℝ) : ℂ)

/-- The unit vector `|⊥⟩`, orthogonal to every `|y⟩`. -/
def botKet {Y : Type} : Option Y → ℂ
  | none => 1
  | some _ => 0

/-- The rank-one operator `|a⟩⟨b|`. -/
def outer {ι : Type} (a b : ι → ℂ) : Matrix ι ι ℂ :=
  fun i j => a i * star (b j)

/-- The compression unitary `C(P)`: "the unique unitary that exchanges `|⊥⟩` and `|P⟩` and
acts as the identity on their common orthogonal complement", i.e.
`C(P) = I - |⊥⟩⟨⊥| - |P⟩⟨P| + |⊥⟩⟨P| + |P⟩⟨⊥|`. -/
noncomputable def compression {Y : Type} [DecidableEq Y] (P : Y → ℝ) :
    Matrix (Option Y) (Option Y) ℂ :=
  1 - outer botKet botKet - outer (ket P) (ket P) + outer botKet (ket P) + outer (ket P) botKet

/-- Computational basis of the whole system: address register `Q` (basis `X`), memory
`M = ⊗_{x∈X} M_x` (basis `X → Option Y`), and a workspace `W`. -/
abbrev Idx (X Y W : Type) : Type := X × (X → Option Y) × W

/-- The query oracle `U = ∑_x |x⟩⟨x|_Q ⊗ C(D_x)_{M_x} ⊗ I_{M_{≠x}} ⊗ I_W`. -/
noncomputable def queryOracle {X Y W : Type} [DecidableEq Y] (D : X → Y → ℝ) :
    Matrix (Idx X Y W) (Idx X Y W) ℂ := by
  classical
  exact fun a b =>
    if a.1 = b.1 ∧ a.2.2 = b.2.2 ∧ (∀ z, z ≠ a.1 → a.2.1 z = b.2.1 z) then
      compression (D a.1) (a.2.1 a.1) (b.2.1 a.1)
    else 0

/-- Execution of the purified algorithm with oracle schedule `O` (query number `k`, counted
from `0`, is answered by `O k`): `run 0 = V₀ ψ₀`, `run (k+1) = V_{k+1} (O k) (run k)`.
`run k` for `k < q` is the state immediately before query `k+1`; `run q` is the final state. -/
def run {ι : Type} [Fintype ι] (V : ℕ → Matrix ι ι ℂ) (ψ₀ : ι → ℂ)
    (O : ℕ → Matrix ι ι ℂ) : ℕ → (ι → ℂ)
  | 0 => V 0 *ᵥ ψ₀
  | k + 1 => V (k + 1) *ᵥ (O k *ᵥ run V ψ₀ O k)

/-- Inner product `⟨a|b⟩ = ∑_i conj(a_i) b_i`. -/
def braket {ι : Type} [Fintype ι] (a b : ι → ℂ) : ℂ :=
  ∑ i, star (a i) * b i

/-- Squared Euclidean norm `‖a‖₂²`. -/
noncomputable def normSqVec {ι : Type} [Fintype ι] (a : ι → ℂ) : ℝ :=
  ∑ i, Complex.normSq (a i)

/-- Trace distance between normalized pure states, `TD(|a⟩,|b⟩) = √(1 - |⟨a|b⟩|²)`,
which equals `½‖ |a⟩⟨a| - |b⟩⟨b| ‖₁`. -/
noncomputable def pureTD {ι : Type} [Fintype ι] (a b : ι → ℂ) : ℝ :=
  Real.sqrt (1 - Complex.normSq (braket a b))

/-- Hybrid schedule: the first `i` queries are answered by `U`, the rest by `U'`. -/
def hybrid {ι : Type} (U U' : Matrix ι ι ℂ) (i : ℕ) : ℕ → Matrix ι ι ℂ :=
  fun k => if k < i then U else U'

/-- Output distribution of `𝓑^U`: choose `i` uniformly among the `q` queries, run with `U` up
to just before that query, measure `Q`:
`Pr[𝓑^U = x] = (1/q) ∑_{i<q} ∑_{m,w} |run_i(x,m,w)|²`. -/
noncomputable def samplerProb {X Y W : Type} [Fintype X] [Fintype Y] [Fintype W]
    [DecidableEq X] [DecidableEq Y]
    (V : ℕ → Matrix (Idx X Y W) (Idx X Y W) ℂ) (ψ₀ : Idx X Y W → ℂ)
    (D : X → Y → ℝ) (q : ℕ) (x : X) : ℝ :=
  (1 / (q : ℝ)) * ∑ i ∈ Finset.range q, ∑ m : X → Option Y, ∑ w : W,
    Complex.normSq (run V ψ₀ (fun _ => queryOracle D) i (x, m, w))

variable {X Y W : Type} [Fintype X] [Fintype Y] [Fintype W]
  [DecidableEq X] [DecidableEq Y] [DecidableEq W]

/-- Sanity: `C(P)` is unitary for every distribution `P`. [OnTheCryptographicFoundations, node_10] -/
theorem compression_mem_unitaryGroup (P : FinDist Y) :
    compression ⇑P ∈ Matrix.unitaryGroup (Option Y) ℂ := by
  sorry

/-- Rubric 3 (coherent-encoding distance): `‖|P⟩ - |P'⟩‖² ≤ 2 SD(P,P')`. [OnTheCryptographicFoundations, node_10] -/
theorem ket_dist_le (P P' : FinDist Y) :
    normSqVec (ket ⇑P - ket ⇑P') ≤ 2 * statDist P P' := by
  sorry

/-- Rubric 3 (local estimate): `‖C(P) - C(P')‖_op ≤ 4 √SD(P,P')`, in squared form on vectors. [OnTheCryptographicFoundations, node_10] -/
theorem compression_diff_le (P P' : FinDist Y) (φ : Option Y → ℂ) :
    normSqVec ((compression ⇑P - compression ⇑P') *ᵥ φ) ≤
      16 * statDist P P' * normSqVec φ := by
  sorry

/-- Rubric 1 (telescoping): `Δ ≤ ∑_{i<q} ‖|ψ_{i+1}⟩ - |ψ_i⟩‖₂` over the hybrids. [OnTheCryptographicFoundations, node_10] -/
theorem telescoping (V : ℕ → Matrix (Idx X Y W) (Idx X Y W) ℂ) (ψ₀ : Idx X Y W → ℂ)
    (hV : ∀ n, V n ∈ Matrix.unitaryGroup (Idx X Y W) ℂ) (hψ₀ : normSqVec ψ₀ = 1)
    (D D' : X → FinDist Y) (q : ℕ) :
    pureTD (run V ψ₀ (fun _ => queryOracle (W := W) (fun x => ⇑(D x))) q)
        (run V ψ₀ (fun _ => queryOracle (W := W) (fun x => ⇑(D' x))) q) ≤
      ∑ i ∈ Finset.range q,
        Real.sqrt (normSqVec
          (run V ψ₀ (hybrid (queryOracle (fun x => ⇑(D x))) (queryOracle (fun x => ⇑(D' x)))
              (i + 1)) q -
            run V ψ₀ (hybrid (queryOracle (fun x => ⇑(D x))) (queryOracle (fun x => ⇑(D' x)))
              i) q)) := by
  sorry

/-- Rubric 2 (localization): consecutive hybrids differ by `‖(U - U')|ψ̃_i⟩‖₂`, where
`|ψ̃_i⟩` is the all-`U` state just before query `i+1`. [OnTheCryptographicFoundations, node_10] -/
theorem localization (V : ℕ → Matrix (Idx X Y W) (Idx X Y W) ℂ) (ψ₀ : Idx X Y W → ℂ)
    (hV : ∀ n, V n ∈ Matrix.unitaryGroup (Idx X Y W) ℂ)
    (D D' : X → Y → ℝ) (q i : ℕ) (hi : i < q) :
    normSqVec
        (run V ψ₀ (hybrid (queryOracle D) (queryOracle D') (i + 1)) q -
          run V ψ₀ (hybrid (queryOracle D) (queryOracle D') i) q) =
      normSqVec ((queryOracle D - queryOracle D') *ᵥ
        run V ψ₀ (fun _ => queryOracle (W := W) D) i) := by
  sorry

/-- Rubric 2–3 (address decomposition + local bound):
`‖(U - U')|φ⟩‖² ≤ 16 ∑_x ‖Π_x φ‖² SD(D_x, D'_x)`. [OnTheCryptographicFoundations, node_10] -/
theorem query_diff_le (D D' : X → FinDist Y) (φ : Idx X Y W → ℂ) :
    normSqVec ((queryOracle (fun x => ⇑(D x)) - queryOracle (fun x => ⇑(D' x))) *ᵥ φ) ≤
      16 * ∑ x, (∑ m : X → Option Y, ∑ w : W, Complex.normSq (φ (x, m, w))) *
        statDist (D x) (D' x) := by
  sorry

/-- Rubric 5 (Cauchy–Schwarz): `(∑_{i<q} ε_i)² ≤ q ∑_{i<q} ε_i²`. [OnTheCryptographicFoundations, node_10] -/
theorem sq_sum_le (q : ℕ) (ε : ℕ → ℝ) :
    (∑ i ∈ Finset.range q, ε i) ^ 2 ≤ (q : ℝ) * ∑ i ∈ Finset.range q, ε i ^ 2 := by
  sorry

/-- **Main theorem.** `𝔼_{x ← 𝓑^U}[SD(D_x, D'_x)] ≥ Δ² / (16 q²)` with
`Δ = TD(|ψ⟩, |ψ'⟩)` the distance between the all-`U` and all-`U'` final states. [OnTheCryptographicFoundations, node_10] -/
theorem expected_SD_ge (V : ℕ → Matrix (Idx X Y W) (Idx X Y W) ℂ) (ψ₀ : Idx X Y W → ℂ)
    (hV : ∀ n, V n ∈ Matrix.unitaryGroup (Idx X Y W) ℂ) (hψ₀ : normSqVec ψ₀ = 1)
    (D D' : X → FinDist Y) (q : ℕ) (hq : 1 ≤ q) :
    pureTD (run V ψ₀ (fun _ => queryOracle (W := W) (fun x => ⇑(D x))) q)
        (run V ψ₀ (fun _ => queryOracle (W := W) (fun x => ⇑(D' x))) q) ^ 2 /
        (16 * (q : ℝ) ^ 2) ≤
      ∑ x, samplerProb V ψ₀ (fun x => ⇑(D x)) q x * statDist (D x) (D' x) := by
  sorry

end TCSChallenge.OnTheCryptographicFoundations.node_10
