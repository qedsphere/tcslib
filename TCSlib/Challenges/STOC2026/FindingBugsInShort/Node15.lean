/-!
## Iter reduces to the width refuter by a block-depth-2 decision-tree reduction

Fix an unsatisfiable CNF `F` with `w₀ = width(F)` (maximum axiom width) and assume
`w_Res(F) > w₀`, i.e. `F` has no valid resolution refutation all of whose clauses have width
`≤ w₀`. A purported derivation `Π` is a list of lines, each carrying a clause and a
justification (axiom of `F`, weakening from an earlier line, or resolution of two earlier
lines on a variable `z`). `Refuter_{F,w₀}` receives a purported refutation of width `≤ w₀`
and must return a line at which an axiom, inference, parent-order or final-line requirement
fails.

`Iter`: given `S : [N+1] → [N+1]`, find `x` with `x = 0 ∧ S 0 = 0`, or `S x < x`, or
`S x > x ∧ S (S x) = S x`.

The main theorem `iter_reduces_to_refuter` states that there is a reduction whose line
records and whose decoder are block-depth-2 decision trees with a constant number of
queries, the produced derivation always has width `≤ w₀`, and every refuter answer decodes
to an Iter solution. The explicit construction `bugReduction` (reversed source order, a
two-state clause alphabet {selected nonempty axiom `C₀`, `⊥`}, weakening gadget) is given as
data and its correctness is `bugReduction_isReduction`.
-/

namespace TCSChallenge.FindingBugsInShort.node_15

/-! ## Syntax of CNFs and purported resolution derivations -/

/-- A literal over variables `V`: `(z, true)` is `z`, `(z, false)` is `¬z`. -/
abbrev Lit (V : Type) : Type := V × Bool

/-- A clause is a finite set of literals; its width is its cardinality. `∅` is `⊥`. -/
abbrev Clause (V : Type) : Type := Finset (Lit V)

/-- A CNF formula is a list of axiom clauses (indexed by position). -/
abbrev CNF (V : Type) : Type := List (Clause V)

/-- Justification of a line: "An axiom line must be a clause of `F`. Every other line must cite
earlier parents and be justified either by weakening ... or by a resolution inference from
`A ∨ z` and `B ∨ ¬z` to `A ∨ B`." -/
inductive Rule (V : Type) : Type where
  /-- the line is the `k`-th axiom of `F` -/
  | ax (k : ℕ) : Rule V
  /-- weakening (or repetition) from line `j` -/
  | weaken (j : ℕ) : Rule V
  /-- resolution of line `j` (containing `z`) and line `k` (containing `¬z`) on `z` -/
  | resolve (j k : ℕ) (z : V) : Rule V

/-- A line record: its clause and its justification with cited parents. -/
structure Line (V : Type) : Type where
  clause : Clause V
  rule : Rule V

/-- A purported derivation: a length and the line records (lines `t < len` are meaningful). -/
structure Derivation (V : Type) : Type where
  len : ℕ
  line : ℕ → Line V

/-- Width of a CNF: the maximum width of an axiom clause (`0` for the empty CNF). -/
def cnfWidth {V : Type} (F : CNF V) : ℕ :=
  (F.map Finset.card).foldr max 0

/-- `F` is satisfiable: some assignment satisfies a literal of every clause. -/
def Satisfiable {V : Type} (F : CNF V) : Prop :=
  ∃ α : V → Bool, ∀ C ∈ F, ∃ l ∈ C, α l.1 = l.2

variable {V : Type} [DecidableEq V]

/-- Local validity of line `t` of `P` with respect to `F` (axiom, weakening with an earlier
parent, or resolution with two earlier parents). -/
def LineValid (F : CNF V) (P : Derivation V) (t : ℕ) : Prop :=
  match (P.line t).rule with
  | .ax k => F[k]? = some (P.line t).clause
  | .weaken j => j < t ∧ (P.line j).clause ⊆ (P.line t).clause
  | .resolve j k z =>
      j < t ∧ k < t ∧ (z, true) ∈ (P.line j).clause ∧ (z, false) ∈ (P.line k).clause ∧
        (P.line t).clause = ((P.line j).clause.erase (z, true)) ∪ ((P.line k).clause.erase (z, false))

/-- `P` is a (valid) resolution refutation of `F`: nonempty, every line valid, and the final
line is the empty clause `⊥`. -/
def IsRefutation (F : CNF V) (P : Derivation V) : Prop :=
  1 ≤ P.len ∧ (∀ t, t < P.len → LineValid F P t) ∧ (P.line (P.len - 1)).clause = ∅

/-- All clauses of `P` have width at most `w`. -/
def IsNarrow (P : Derivation V) (w : ℕ) : Prop :=
  ∀ t, t < P.len → (P.line t).clause.card ≤ w

/-- `w_Res(F) > w`: there is no resolution refutation of `F` of width at most `w`. -/
def WidthLowerBound (F : CNF V) (w : ℕ) : Prop :=
  ¬ ∃ P : Derivation V, IsRefutation F P ∧ IsNarrow P w

/-- Valid answers of `Refuter_{F,w₀}` on `P`: a line `t < len` that is locally invalid, or the
final line when it is not `⊥`. -/
def RefuterSol (F : CNF V) (P : Derivation V) (t : ℕ) : Prop :=
  t < P.len ∧ (¬ LineValid F P t ∨ (t = P.len - 1 ∧ (P.line t).clause ≠ ∅))

/-! ## Iter and block-depth-2 locality -/

/-- Valid outputs of `Iter` on `S : [N+1] → [N+1]`. -/
def IterSol {N : ℕ} (S : Fin (N + 1) → Fin (N + 1)) (x : Fin (N + 1)) : Prop :=
  (x = 0 ∧ S 0 = 0) ∨ S x < x ∨ (x < S x ∧ S (S x) = S x)

/-- `f` is computed by a block-depth-2 decision tree with at most `q` queries per block:
a fixed nonadaptive first block `Q1`, then a nonadaptive second block `Q2 S` depending only on
the answers to `Q1`, and the value depends only on the answers to both blocks. -/
def BlockDepth2 {M : ℕ} {α : Type} (q : ℕ) (f : (Fin M → Fin M) → α) : Prop :=
  ∃ Q1 : Finset (Fin M), ∃ Q2 : (Fin M → Fin M) → Finset (Fin M),
    Q1.card ≤ q ∧ (∀ S, (Q2 S).card ≤ q) ∧
    (∀ S S', (∀ x ∈ Q1, S x = S' x) → Q2 S = Q2 S') ∧
    (∀ S S', (∀ x ∈ Q1, S x = S' x) → (∀ x ∈ Q2 S, S x = S' x) → f S = f S')

/-- A reduction from Iter to the refuter, given as data uniformly in `N`: the length of the
produced derivation, its line records, and the decoder of a returned line index. -/
structure Reduction (V : Type) : Type where
  len : ℕ → ℕ
  record : (N : ℕ) → ℕ → (Fin (N + 1) → Fin (N + 1)) → Line V
  decode : (N : ℕ) → ℕ → (Fin (N + 1) → Fin (N + 1)) → Fin (N + 1)

/-- The purported derivation presented by `R` on the oracle `S`. -/
def Reduction.inst (R : Reduction V) (N : ℕ) (S : Fin (N + 1) → Fin (N + 1)) : Derivation V :=
  ⟨R.len N, fun t => R.record N t S⟩

/-- `R` is a block-depth-2 decision-tree reduction from Iter to `Refuter_{F,w₀}`: one query bound
`q` for all `N`; every record and every decoding is block-depth 2 with `≤ q` queries per block;
for every `S` the presented derivation is nonempty and of width `≤ w₀` (the refuter's promise);
and every permitted refuter answer decodes to an Iter solution. -/
def IsBlockDepth2Reduction (F : CNF V) (w₀ : ℕ) (R : Reduction V) : Prop :=
  ∃ q : ℕ, ∀ N : ℕ,
    (∀ t, BlockDepth2 q (R.record N t)) ∧
    (∀ t, BlockDepth2 q (R.decode N t)) ∧
    ∀ S : Fin (N + 1) → Fin (N + 1),
      1 ≤ R.len N ∧ IsNarrow (R.inst N S) w₀ ∧
      ∀ t, RefuterSol F (R.inst N S) t → IterSol S (R.decode N t S)

/-! ## The explicit construction (reversed order, two-state weakening gadget) -/

/-- The source index `N - i` read in reversed order (reduced mod `N+1`, harmless for `i ≤ N`). -/
def revIdx (N i : ℕ) : Fin (N + 1) :=
  ⟨(N - i) % (N + 1), Nat.mod_lt _ (Nat.succ_pos N)⟩

/-- The reversed pointer at reversed position `i`: `N - S(N - i)`. -/
def revPtr (N : ℕ) (S : Fin (N + 1) → Fin (N + 1)) (i : ℕ) : ℕ :=
  N - (S (revIdx N i)).val

/-- Line records: the axioms of `F` first; then dynamic lines `i = t - |F|`, `0 ≤ i ≤ N`.
Boundary branch `S 0 = 0`: every dynamic line is an invalid weakening of `C₀` to `⊥`.
Otherwise: fixed reversed pointer → copy `C₀` from axiom `k₀`; earlier reversed pointer →
`⊥` weakened from dynamic line `revPtr`; later reversed pointer → `⊥` "weakened" from `C₀`. -/
def bugRecord (F : CNF V) (k₀ : ℕ) (C₀ : Clause V) (N t : ℕ)
    (S : Fin (N + 1) → Fin (N + 1)) : Line V :=
  if t < F.length then ⟨F.getD t ∅, .ax t⟩
  else if S 0 = 0 then ⟨∅, .weaken k₀⟩
  else if revPtr N S (t - F.length) = t - F.length then ⟨C₀, .ax k₀⟩
  else if revPtr N S (t - F.length) < t - F.length then
    ⟨∅, .weaken (F.length + revPtr N S (t - F.length))⟩
  else ⟨∅, .weaken k₀⟩

/-- Decoder: `0` in the boundary branch, otherwise the source index `x = N - (t - |F|)`. -/
def bugDecode (F : CNF V) (N t : ℕ) (S : Fin (N + 1) → Fin (N + 1)) : Fin (N + 1) :=
  if S 0 = 0 then 0 else revIdx N (t - F.length)

/-- The reduction: derivation length `|F| + N + 1`. -/
def bugReduction (F : CNF V) (k₀ : ℕ) (C₀ : Clause V) : Reduction V where
  len := fun N => F.length + N + 1
  record := fun N t S => bugRecord F k₀ C₀ N t S
  decode := fun N t S => bugDecode F N t S

/-! ## Lemma stubs -/

/-- The hypotheses supply a nonempty axiom `C₀` (unsatisfiable ⇒ `F ≠ []`; `w_Res(F) > w₀` ⇒
`⊥ ∉ F`), and every axiom has width `≤ cnfWidth F`. [FindingBugsInShort, node_15] -/
theorem exists_nonempty_axiom (F : CNF V) (hunsat : ¬ Satisfiable F)
    (hwidth : WidthLowerBound F (cnfWidth F)) :
    ∃ k₀ : ℕ, ∃ C₀ : Clause V, F[k₀]? = some C₀ ∧ C₀ ≠ ∅ := by
  sorry

theorem axiom_card_le_cnfWidth (F : CNF V) (C : Clause V) (hC : C ∈ F) :
    C.card ≤ cnfWidth F := by
  sorry

/-- Width: every line is an axiom of `F`, `C₀`, or `⊥`. [FindingBugsInShort, node_15] -/
theorem bugReduction_narrow (F : CNF V) (k₀ : ℕ) (C₀ : Clause V) (hk₀ : F[k₀]? = some C₀)
    (N : ℕ) (S : Fin (N + 1) → Fin (N + 1)) :
    IsNarrow ((bugReduction F k₀ C₀).inst N S) (cnfWidth F) := by
  sorry

/-- Records use the first block `{0, N - i}` only. [FindingBugsInShort, node_15] -/
theorem bugRecord_blockDepth2 (F : CNF V) (k₀ : ℕ) (C₀ : Clause V) (N t : ℕ) :
    BlockDepth2 2 (fun S => bugRecord F k₀ C₀ N t S) := by
  sorry

/-- The decoder uses `{0, x}` then `{S x}` (it is in fact one-block). [FindingBugsInShort, node_15] -/
theorem bugDecode_blockDepth2 (F : CNF V) (N t : ℕ) :
    BlockDepth2 2 (fun S => bugDecode F N t S) := by
  sorry

/-- Axiom lines are valid. [FindingBugsInShort, node_15] -/
theorem bugReduction_axiom_valid (F : CNF V) (k₀ : ℕ) (C₀ : Clause V) (N : ℕ)
    (S : Fin (N + 1) → Fin (N + 1)) (t : ℕ) (ht : t < F.length) :
    LineValid F ((bugReduction F k₀ C₀).inst N S) t := by
  sorry

/-- Endpoint: outside the boundary branch the last line (reversed index `N`) is `⊥`. [FindingBugsInShort, node_15] -/
theorem bugReduction_final_empty (F : CNF V) (k₀ : ℕ) (C₀ : Clause V) (N : ℕ)
    (S : Fin (N + 1) → Fin (N + 1)) (hS0 : S 0 ≠ 0) :
    (((bugReduction F k₀ C₀).inst N S).line (F.length + N)).clause = ∅ := by
  sorry

/-- Organizing invariant: outside the boundary branch, dynamic line `i` carries `C₀` iff the
reversed pointer at `i` is fixed (`S (N - i) = N - i`), and `⊥` otherwise. [FindingBugsInShort, node_15] -/
theorem bugReduction_invariant (F : CNF V) (k₀ : ℕ) (C₀ : Clause V) (N : ℕ)
    (S : Fin (N + 1) → Fin (N + 1)) (hS0 : S 0 ≠ 0) (i : ℕ) (hi : i ≤ N) :
    (((bugReduction F k₀ C₀).inst N S).line (F.length + i)).clause =
      if S (revIdx N i) = revIdx N i then C₀ else ∅ := by
  sorry

/-- No spurious outputs: outside the boundary branch, an invalid dynamic line decodes to
`S x < x` (later reversed pointer) or to `S x > x ∧ S (S x) = S x` (earlier reversed pointer
landing on a fixed point). [FindingBugsInShort, node_15] -/
theorem bugReduction_invalid_decodes (F : CNF V) (k₀ : ℕ) (C₀ : Clause V)
    (hk₀ : F[k₀]? = some C₀) (hC₀ : C₀ ≠ ∅) (N : ℕ)
    (S : Fin (N + 1) → Fin (N + 1)) (hS0 : S 0 ≠ 0) (t : ℕ)
    (ht₁ : F.length ≤ t) (ht₂ : t < F.length + N + 1)
    (hinv : ¬ LineValid F ((bugReduction F k₀ C₀).inst N S) t) :
    IterSol S (bugDecode F N t S) := by
  sorry

/-- The explicit construction is a block-depth-2 reduction (with `q = 2`). [FindingBugsInShort, node_15] -/
theorem bugReduction_isReduction (F : CNF V) (k₀ : ℕ) (C₀ : Clause V)
    (hk₀ : F[k₀]? = some C₀) (hC₀ : C₀ ≠ ∅) :
    IsBlockDepth2Reduction F (cnfWidth F) (bugReduction F k₀ C₀) := by
  sorry

/-! ## Main theorem -/

/-- **Main theorem.** For every fixed unsatisfiable CNF `F` with `w_Res(F) > w₀ = width(F)`
there is a block-depth-2 decision-tree reduction from Iter to `Refuter_{F,w₀}`. [FindingBugsInShort, node_15] -/
theorem iter_reduces_to_refuter (F : CNF V) (hunsat : ¬ Satisfiable F)
    (hwidth : WidthLowerBound F (cnfWidth F)) :
    ∃ R : Reduction V, IsBlockDepth2Reduction F (cnfWidth F) R := by
  sorry

end TCSChallenge.FindingBugsInShort.node_15
