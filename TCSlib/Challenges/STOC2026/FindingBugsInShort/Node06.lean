/-!
## A T^1_2 + dwPHP proof yields an rwPHP(PLS) reduction (combinatorial core)

Given `t > 2`, `f : Fin t → Fin (t^2)`, and Iter instances `S v : Fin L → Fin L` with
decoders `D v` whose every Iter solution decodes to either a preimage of `v` under `f` or a
certificate `y < tφ` with `ψ y`, we build the rwPHP(PLS) instance with `M = t`, `N = t²`,
`F = f`, and `G_v a = g (D v a)`. The main theorem `rwPHP_PLS_reduction` asserts that
`M ≤ N/2`, that every valid rwPHP output `(v, a)` has `D v a` a genuine type-1 certificate,
and that a valid output exists (totality).
-/

namespace TCSChallenge.FindingBugsInShortProofs.node_06

/-- "Its valid solutions are the elements `a ∈ [L]` satisfying at least one of
`a = 0 and S(0) = 0`, `S(a) < a`, `S(a) > a and S(S(a)) = S(a)`." -/
def IterSol {L : ℕ} (S : Fin L → Fin L) (a : Fin L) : Prop :=
  (a.val = 0 ∧ S a = a) ∨ S a < a ∨ (a < S a ∧ S (S a) = S a)

/-- Tagged witnesses: type 0 `(0,u)` with `u < t`, or type 1 `(1,y)`. -/
abbrev Tagged (t : ℕ) : Type := Fin t ⊕ ℕ

/-- "type 0: `w = (0,u)`, `u < t`, `f_x(u) = v`; type 1: `w = (1,y)`, `y < t_φ(x)`, `ψ(x,y)`." -/
def TaggedValid {t : ℕ} (f : Fin t → Fin (t ^ 2)) (tphi : ℕ) (ψ : ℕ → Prop)
    (v : Fin (t ^ 2)) : Tagged t → Prop
  | Sum.inl u => f u = v
  | Sum.inr y => y < tphi ∧ ψ y

/-- "A valid output is a pair `(v,a)` such that `a` solves `I_v` and `F(G_v(a)) ≠ v`." -/
def RwSol {t L : ℕ} (F : Fin t → Fin (t ^ 2)) (S : Fin (t ^ 2) → Fin L → Fin L)
    (G : Fin (t ^ 2) → Fin L → Fin t) (v : Fin (t ^ 2)) (a : Fin L) : Prop :=
  IterSol (S v) a ∧ F (G v a) ≠ v

/-- Rubric 3: the size condition `M = t ≤ t²/2 = N/2` (natural division) for `t > 2`. [FindingBugsInShort, node_06] -/
theorem size_condition (t : ℕ) (ht : 2 < t) : t ≤ t ^ 2 / 2 := by sorry

/-- Every Iter instance on a nonempty universe has a solution. [FindingBugsInShort, node_06] -/
theorem iter_total (L : ℕ) (hL : 1 ≤ L) (S : Fin L → Fin L) : ∃ a, IterSol S a := by sorry

/-- Rubric 4: with `G_v(a) := u` on type-0 decodings, any valid rwPHP output decodes to a
genuine certificate. [FindingBugsInShort, node_06] -/
theorem valid_output_gives_certificate (t L tphi : ℕ) (ψ : ℕ → Prop) (ht : 2 < t)
    (f : Fin t → Fin (t ^ 2)) (S : Fin (t ^ 2) → Fin L → Fin L)
    (D : Fin (t ^ 2) → Fin L → Tagged t)
    (hD : ∀ v a, IterSol (S v) a → TaggedValid f tphi ψ v (D v a))
    (v : Fin (t ^ 2)) (a : Fin L)
    (hsol : RwSol f S (fun v a =>
        match D v a with
        | Sum.inl u => u
        | Sum.inr _ => ⟨0, by omega⟩) v a) :
    ∃ y, D v a = Sum.inr y ∧ y < tphi ∧ ψ y := by sorry

/-- Main theorem (combinatorial core of node_06): the rwPHP(PLS) instance with `M = t`,
`N = t²`, `F = f`, Iter instances `S v` and a local `G_v = g ∘ D v` satisfies `M ≤ N/2`,
every valid output yields a certificate read off the decoder, and the instance is total. [FindingBugsInShort, node_06] -/
theorem rwPHP_PLS_reduction (t L tphi : ℕ) (ψ : ℕ → Prop) (ht : 2 < t) (hL : 1 ≤ L)
    (f : Fin t → Fin (t ^ 2)) (S : Fin (t ^ 2) → Fin L → Fin L)
    (D : Fin (t ^ 2) → Fin L → Tagged t)
    (hD : ∀ v a, IterSol (S v) a → TaggedValid f tphi ψ v (D v a)) :
    t ≤ t ^ 2 / 2 ∧
    ∃ g : Tagged t → Fin t,
      (∀ v a, RwSol f S (fun v a => g (D v a)) v a →
          ∃ y, D v a = Sum.inr y ∧ y < tphi ∧ ψ y) ∧
      (∃ v a, RwSol f S (fun v a => g (D v a)) v a) := by sorry

end TCSChallenge.FindingBugsInShortProofs.node_06
