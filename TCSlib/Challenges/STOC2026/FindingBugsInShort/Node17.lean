/-!
## rwPHP(PLS) reduces to refuting short resolution proofs, with block-depth O(n)

For every unsatisfiable CNF `F` on `n` variables without resolution refutations of at most
`s_F ≥ C(nLM + |F|)` clauses, every rwPHP(PLS) instance with parameters `L, M` reduces, by
decision trees of block-depth O(n), to the search problem
`Refuter(s(F ⊢_Res ⊥) ≤ s_F)`: find an illegal record of a purported refutation.
Main theorem: `rwPHP_PLS_reduces_to_refuter`.
-/

namespace TCSChallenge.FindingBugsInShortProofs.node_17

/-! ## rwPHP(PLS) instances -/

/-- "An element `a ∈ [L]` is an Iter solution for `S_y` if `a = 0 ∧ S_y(a) = 0`, or
`S_y(a) < a`, or `S_y(a) > a ∧ S_y(S_y(a)) = S_y(a)`." -/
def IterSol {L : ℕ} (S : Fin L → Fin L) (a : Fin L) : Prop :=
  (a.val = 0 ∧ S a = a) ∨ S a < a ∨ (a < S a ∧ S (S a) = S a)

/-- "oracle access to `f : [M] → [2M]`, `S_y : [L] → [L]` and `g_y : [L] → [M]` for each
`y ∈ [2M]`." -/
structure RwInst (L M : ℕ) where
  f : Fin M → Fin (2 * M)
  S : Fin (2 * M) → Fin L → Fin L
  g : Fin (2 * M) → Fin L → Fin M

/-- "A solution of the rwPHP(PLS) instance is a pair `(y,a)` such that `a` is an Iter
solution for `S_y` and `f(g_y(a)) ≠ y`." Given as natural numbers, it must be in range. -/
def RwInst.IsSol {L M : ℕ} (I : RwInst L M) (y a : ℕ) : Prop :=
  ∃ (hy : y < 2 * M) (ha : a < L),
    IterSol (I.S ⟨y, hy⟩) ⟨a, ha⟩ ∧ I.f (I.g ⟨y, hy⟩ ⟨a, ha⟩) ≠ ⟨y, hy⟩

/-- "A block query reveals one complete value `f(i)`, `S_y(a)`, or `g_y(a)`." -/
inductive BlockQuery where
  | qf : ℕ → BlockQuery
  | qS : ℕ → ℕ → BlockQuery
  | qg : ℕ → ℕ → BlockQuery

/-- Answer to a block query (out-of-range queries answer `0`). -/
def RwInst.answer {L M : ℕ} (I : RwInst L M) : BlockQuery → ℕ
  | BlockQuery.qf i => if h : i < M then (I.f ⟨i, h⟩).val else 0
  | BlockQuery.qS y a =>
      if h : y < 2 * M ∧ a < L then (I.S ⟨y, h.1⟩ ⟨a, h.2⟩).val else 0
  | BlockQuery.qg y a =>
      if h : y < 2 * M ∧ a < L then (I.g ⟨y, h.1⟩ ⟨a, h.2⟩).val else 0

/-- Decision trees making sequentially adaptive block queries, branching on the answer. -/
inductive DT (R : Type) where
  | leaf : R → DT R
  | node : BlockQuery → (ℕ → DT R) → DT R

/-- `T.DepthLE d`: every root-to-leaf path of `T` makes at most `d` block queries. -/
inductive DT.DepthLE {R : Type} : DT R → ℕ → Prop where
  | leaf (r : R) (d : ℕ) : DT.DepthLE (DT.leaf r) d
  | node (q : BlockQuery) (k : ℕ → DT R) (d e : ℕ) (hk : ∀ b, DT.DepthLE (k b) d)
      (hde : d + 1 ≤ e) : DT.DepthLE (DT.node q k) e

/-- Evaluate a decision tree against an rwPHP(PLS) instance. -/
def DT.eval {R : Type} {L M : ℕ} (I : RwInst L M) : DT R → R
  | DT.leaf r => r
  | DT.node q k => DT.eval I (k (I.answer q))

/-! ## CNFs and purported resolution refutations -/

/-- "Clauses are sets of literals." Literals are TCSlib's `Literal n`: `⟨i, false⟩` is `x_i`,
`⟨i, true⟩` is `¬x_i`. Named `RClause` to avoid TCSlib's list-based root `Clause`. -/
abbrev RClause (n : ℕ) : Type := Finset (Literal n)

/-- An assignment satisfies a clause if it makes some literal true (`Literal.eval`). -/
def ClauseSat {n : ℕ} (α : Fin n → Bool) (C : RClause n) : Prop :=
  ∃ l ∈ C, l.eval α = true

/-- `F` is unsatisfiable: every assignment falsifies some clause of `F`. -/
def Unsat {n : ℕ} (F : List (RClause n)) : Prop :=
  ∀ α : Fin n → Bool, ∃ C ∈ F, ¬ ClauseSat α C

/-- Declaration type and source indices of a record. -/
inductive Decl (n : ℕ) where
  | ax : Decl n
  | weaken : ℕ → Decl n
  | resolve : ℕ → ℕ → Fin n → Decl n

/-- A clause record: its clause and its declaration. -/
structure ProofLine (n : ℕ) where
  clause : RClause n
  decl : Decl n

/-- A purported refutation: `Q` records indexed by `ℕ` (only indices `< Q` are used). -/
structure PurportedRef (n : ℕ) where
  Q : ℕ
  line : ℕ → ProofLine n

/-- Legality of record `i`: "a weakening from `B` to `C` is legal if `B ⊆ C`; a resolution
inference from `B` and `D` on `x` is legal if `x ∈ B`, `¬x ∈ D`, and
`(B∖{x}) ∪ (D∖{¬x}) ⊆ C`"; sources must be later records (reverse-topological order);
axioms must be clauses of `F`. -/
def PurportedRef.Legal {n : ℕ} (F : List (RClause n)) (P : PurportedRef n) (i : ℕ) : Prop :=
  match (P.line i).decl with
  | Decl.ax => (P.line i).clause ∈ F
  | Decl.weaken j => i < j ∧ j < P.Q ∧ (P.line j).clause ⊆ (P.line i).clause
  | Decl.resolve j k x =>
      i < j ∧ j < P.Q ∧ i < k ∧ k < P.Q ∧
      (⟨x, false⟩ : Literal n) ∈ (P.line j).clause ∧ (⟨x, true⟩ : Literal n) ∈ (P.line k).clause ∧
      ((P.line j).clause.erase ⟨x, false⟩) ∪ ((P.line k).clause.erase ⟨x, true⟩)
        ⊆ (P.line i).clause

/-- Well-formed input of the refuter problem: nonempty, first clause empty. -/
def PurportedRef.WellFormed {n : ℕ} (P : PurportedRef n) : Prop :=
  1 ≤ P.Q ∧ (P.line 0).clause = ∅

/-- A genuine resolution refutation of `F` with at most `s` clause occurrences. -/
def HasRefutationOfSize {n : ℕ} (F : List (RClause n)) (s : ℕ) : Prop :=
  ∃ P : PurportedRef n, P.WellFormed ∧ P.Q ≤ s ∧ ∀ i, i < P.Q → P.Legal F i

/-- A decision-tree reduction of block-depth `≤ d` from rwPHP(PLS) with parameters `L, M`
to `Refuter(s(F ⊢ ⊥) ≤ s)`: a fixed number `Q ≤ s` of records, each computed by a depth-`d`
tree; a depth-`d` decoder for each record index; the purported refutation is well formed on
every instance, and every illegal record decodes to an rwPHP(PLS) solution. -/
def RefuterReduction {n : ℕ} (F : List (RClause n)) (s L M d : ℕ) : Prop :=
  ∃ (Q : ℕ) (recTree : ℕ → DT (ProofLine n)) (decTree : ℕ → DT (ℕ × ℕ)),
    Q ≤ s ∧
    (∀ i, i < Q → (recTree i).DepthLE d ∧ (decTree i).DepthLE d) ∧
    ∀ I : RwInst L M,
      let P : PurportedRef n := ⟨Q, fun i => (recTree i).eval I⟩
      P.WellFormed ∧
      ∀ i, i < Q → ¬ P.Legal F i →
        I.IsSol ((decTree i).eval I).1 ((decTree i).eval I).2

/-! ## Lemma stubs -/

/-- Rubric 4: a full clause (exactly one literal per variable) contains every axiom falsified
by its unique falsifying assignment. [FindingBugsInShort, node_17] -/
theorem full_clause_weakens_falsified_axiom (n : ℕ) (E A : RClause n)
    (hfull : ∀ x : Fin n,
      ((⟨x, false⟩ : Literal n) ∈ E ∧ (⟨x, true⟩ : Literal n) ∉ E) ∨
      ((⟨x, true⟩ : Literal n) ∈ E ∧ (⟨x, false⟩ : Literal n) ∉ E))
    (hA : ¬ ClauseSat (fun x => decide ((⟨x, true⟩ : Literal n) ∈ E)) A) : A ⊆ E := by sorry

/-- Rubric 2: in a non-solution, non-fixed-point position the pointer target is not a fixed
point, so pointer links between `D_{y,a}` and `D_{y,S_y(a)}` are legal and increasing. [FindingBugsInShort, node_17] -/
theorem iter_link_target_not_fixed (L : ℕ) (S : Fin L → Fin L) (a : Fin L)
    (hns : ¬ IterSol S a) (hfix : S a ≠ a) : a < S a ∧ S (S a) ≠ S a := by sorry

/-- Main theorem (node_17). [FindingBugsInShort, node_17] -/
theorem rwPHP_PLS_reduces_to_refuter :
    ∃ C D : ℕ, 2 ≤ C ∧
      ∀ (L M n : ℕ), 1 ≤ L → 1 ≤ M → 1 ≤ n →
      ∀ (F : List (RClause n)) (s : ℕ), Unsat F →
        C * (n * L * M + F.length) ≤ s →
        ¬ HasRefutationOfSize F s →
        RefuterReduction F s L M (D * n) := by sorry

end TCSChallenge.FindingBugsInShortProofs.node_17
