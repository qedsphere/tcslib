/-!
## Cost-preserving sketches for constrained `k`-clustering in dimension `ε^{-O(z)} log k`

Points `P = (p_j)_{j<n}` in `ℝ^d`; a labeled partition of `[n]` into `k` (possibly empty)
parts is a map `C : Fin n → Fin k`. The partition cost
`PC_z(P,C) = ∑_i min_s ∑_{C j = i} ‖p_j - s‖^z`. For a family `X = ((x_j,t_j))` in `ℝ^m × ℝ`,
`PC⁰_z(X,C) = ∑_i min_u ∑_{C j = i} (‖x_j - u‖² + t_j²)^{z/2}` (centers have last coordinate 0).
A sketch `f : Fin n → ℝ^m × ℝ` is `(k,z,ε)`-cost preserving if
`(1-ε) PC_z(P,C) ≤ PC⁰_z(f(P),C) ≤ (1+ε) PC_z(P,C)` for every `C`.

Main theorem `exists_costPreservingSketch`: given the two supplied facts, there is an absolute
constant `C` such that every `P` has a `(k,z,ε)`-cost preserving sketch with
`m + 1 ≤ C ε^{-Cz} log(max{2,k})`.
-/

namespace TCSChallenge.DeterministicClusteringInHigh.node_20

/-- Euclidean norm `‖v‖₂` on `ℝ^d` (the Pi type carries the sup norm, so we define it). -/
def eucl {d : ℕ} (v : Fin d → ℝ) : ℝ := Real.sqrt (∑ i, v i ^ 2)

/-- "`PC_z(P,C) = ∑_{i=1}^k min_{s ∈ ℝ^d} ∑_{j ∈ C_i} ‖p_j - s‖_2^z`"; empty parts give 0. -/
def PC {n d k : ℕ} (z : ℕ) (P : Fin n → Fin d → ℝ) (C : Fin n → Fin k) : ℝ :=
  ∑ i : Fin k, ⨅ s : Fin d → ℝ,
    ∑ j ∈ Finset.univ.filter (fun j => C j = i), eucl (P j - s) ^ z

/-- "`PC⁰_z(X,C) = ∑_{i=1}^k min_{u ∈ ℝ^m} ∑_{j ∈ C_i} (‖x_j-u‖_2^2 + t_j^2)^{z/2}`":
every center has last coordinate zero. -/
def PC0 {n m k : ℕ} (z : ℕ) (X : Fin n → (Fin m → ℝ) × ℝ) (C : Fin n → Fin k) : ℝ :=
  ∑ i : Fin k, ⨅ u : Fin m → ℝ,
    ∑ j ∈ Finset.univ.filter (fun j => C j = i),
      (eucl ((X j).1 - u) ^ 2 + (X j).2 ^ 2) ^ ((z : ℝ) / 2)

/-- "A map `f` on the indexed family `P`, with values in `ℝ^{m+1}`, is a `(k,z,ε)`-cost
preserving sketch if for every partition `C`,
`(1-ε) PC_z(P,C) ≤ PC⁰_z(f(P),C) ≤ (1+ε) PC_z(P,C)`." -/
def IsCostPreservingSketch {n d m : ℕ} (k z : ℕ) (ε : ℝ) (P : Fin n → Fin d → ℝ)
    (f : Fin n → (Fin m → ℝ) × ℝ) : Prop :=
  ∀ C : Fin n → Fin k,
    (1 - ε) * PC z P C ≤ PC0 z f C ∧ PC0 z f C ≤ (1 + ε) * PC z P C

/-- Supplied fact 1 (with constant `C₁`): for every `0 < ρ ≤ 1/2` there are `a_j ∈ ℝ^d`,
`t_j ≥ 0`, with at most `k ρ^{-C₁ z}` distinct `a_j`, such that for every partition and every
center tuple `s`, `(1-ρ) ∑_j ‖p_j - s_{C j}‖^z ≤ ∑_j (‖a_j - s_{C j}‖² + t_j²)^{z/2}
≤ (1+ρ) ∑_j ‖p_j - s_{C j}‖^z`. -/
def Fact1 (C₁ : ℝ) : Prop :=
  ∀ (n d k z : ℕ) (ρ : ℝ) (P : Fin n → Fin d → ℝ), 1 ≤ k → 1 ≤ z → 0 < ρ → ρ ≤ 1 / 2 →
    ∃ (a : Fin n → Fin d → ℝ) (t : Fin n → ℝ),
      (∀ j, 0 ≤ t j) ∧
      ((Finset.univ.image a).card : ℝ) ≤ (k : ℝ) * ρ ^ (-(C₁ * (z : ℝ))) ∧
      ∀ (C : Fin n → Fin k) (s : Fin k → Fin d → ℝ),
        (1 - ρ) * ∑ j, eucl (P j - s (C j)) ^ z
            ≤ ∑ j, (eucl (a j - s (C j)) ^ 2 + t j ^ 2) ^ ((z : ℝ) / 2) ∧
        ∑ j, (eucl (a j - s (C j)) ^ 2 + t j ^ 2) ^ ((z : ℝ) / 2)
            ≤ (1 + ρ) * ∑ j, eucl (P j - s (C j)) ^ z

/-- Supplied fact 2 (with constant `C₂`): given `M` vectors in `ℝ^d` and `δ, F₀ ∈ (0,1]`,
a linear map `S : ℝ^d → ℝ^m`, `m ≤ C₂ δ^{-2} log(2/F₀)`, preserves `‖v_i‖` within `1 ± δ` for at
least a `(1-F₀)` fraction of the indices. -/
def Fact2 (C₂ : ℝ) : Prop :=
  ∀ (d M : ℕ) (v : Fin M → Fin d → ℝ) (δ F₀ : ℝ), 0 < δ → δ ≤ 1 → 0 < F₀ → F₀ ≤ 1 →
    ∃ m : ℕ, (m : ℝ) ≤ C₂ * δ ^ (-(2 : ℝ)) * Real.log (2 / F₀) ∧
    ∃ S : Matrix (Fin m) (Fin d) ℝ,
      (1 - F₀) * (M : ℝ) ≤
        ((Finset.univ.filter (fun i => (1 - δ) * eucl (v i) ≤ eucl (S.mulVec (v i)) ∧
            eucl (S.mulVec (v i)) ≤ (1 + δ) * eucl (v i))).card : ℝ)

/-- Constrained one-center objective with offsets, powered:
`∑_j (‖x_j - c‖² + t_j²)^{z/2}` (this is `H_X(c)^z` in the reference). -/
def oneCenterCost {q d : ℕ} (z : ℕ) (x : Fin q → Fin d → ℝ) (t : Fin q → ℝ)
    (c : Fin d → ℝ) : ℝ :=
  ∑ j, (eucl (x j - c) ^ 2 + t j ^ 2) ^ ((z : ℝ) / 2)

/-- Optimal powered one-center value `B_X^z = min_c ∑_j (‖x_j-c‖² + t_j²)^{z/2}`. -/
def oneCenterOpt {q d : ℕ} (z : ℕ) (x : Fin q → Fin d → ℝ) (t : Fin q → ℝ) : ℝ :=
  ⨅ c : Fin d → ℝ, oneCenterCost z x t c

/-- Sparse convex-hull approximation (used in Step 2 of the reference, must be proved): some
`≤ α^{-2} 2^{Cz} + 1` indices carry a near-optimal center in the convex hull of their base
points, and those base points have spread `≤ (Cz/α) (B_X^z / q)^{1/z}`. [DeterministicClusteringInHigh, node_20] -/
theorem sparse_center_approx :
    ∃ C : ℝ, 0 < C ∧
    ∀ (q d z : ℕ) (x : Fin q → Fin d → ℝ) (t : Fin q → ℝ) (α : ℝ),
      1 ≤ q → 1 ≤ z → 0 < α → α ≤ 1 / 2 →
      ∃ I : Finset (Fin q), I.Nonempty ∧
        (I.card : ℝ) ≤ α ^ (-(2 : ℝ)) * 2 ^ (C * (z : ℝ)) + 1 ∧
        (∃ c ∈ convexHull ℝ (x '' (↑I : Set (Fin q))),
          oneCenterCost z x t c ≤ (1 + α) * oneCenterOpt z x t) ∧
        ∀ j ∈ I, ∀ j' ∈ I,
          eucl (x j - x j') ≤ (C * (z : ℝ) / α) * (oneCenterOpt z x t / q) ^ (1 / (z : ℝ)) := by
  sorry

/-- Steps 1–2 (rubric items 1–4): for a finite base set `A`, one matrix `Pr` (the paper's `Π`) with
`m ≤ C α^{-Cz} log(|A|+2)` rows preserves, within `1 + 8α`, the constrained one-center optimum
of every indexed family with base points in `A` and arbitrary offsets. [DeterministicClusteringInHigh, node_20] -/
theorem oneCenter_preserving_projection :
    ∃ C : ℝ, 0 < C ∧
    ∀ (d z : ℕ) (α : ℝ) (A : Finset (Fin d → ℝ)), 1 ≤ z → 0 < α → α ≤ 1 / 200 →
      ∃ m : ℕ, (m : ℝ) ≤ C * α ^ (-(C * (z : ℝ))) * Real.log ((A.card : ℝ) + 2) ∧
      ∃ Pr : Matrix (Fin m) (Fin d) ℝ,
        ∀ (q : ℕ) (x : Fin q → Fin d → ℝ) (t : Fin q → ℝ), (∀ j, x j ∈ A) →
          oneCenterOpt z (fun j => Pr.mulVec (x j)) t ≤ (1 + 8 * α) * oneCenterOpt z x t ∧
          oneCenterOpt z x t ≤ (1 + 8 * α) * oneCenterOpt z (fun j => Pr.mulVec (x j)) t := by
  sorry

/-- Step 3, inequality (10): the representative guarantee of fact 1, valid for every center
tuple, transfers to optimized partition costs. [DeterministicClusteringInHigh, node_20] -/
theorem representative_transfer {n d k z : ℕ} (ρ : ℝ) (P a : Fin n → Fin d → ℝ)
    (t : Fin n → ℝ) (C : Fin n → Fin k)
    (h : ∀ s : Fin k → Fin d → ℝ,
        (1 - ρ) * ∑ j, eucl (P j - s (C j)) ^ z
            ≤ ∑ j, (eucl (a j - s (C j)) ^ 2 + t j ^ 2) ^ ((z : ℝ) / 2) ∧
        ∑ j, (eucl (a j - s (C j)) ^ 2 + t j ^ 2) ^ ((z : ℝ) / 2)
            ≤ (1 + ρ) * ∑ j, eucl (P j - s (C j)) ^ z)
    (hρ0 : 0 < ρ) (hρ1 : ρ ≤ 1 / 2) :
    (1 - ρ) * PC z P C ≤ PC0 z (fun j => ((a j : Fin d → ℝ), t j)) C ∧
    PC0 z (fun j => ((a j : Fin d → ℝ), t j)) C ≤ (1 + ρ) * PC z P C := by
  sorry

/-- **Main theorem.** Given the supplied facts, every indexed family `P ⊂ ℝ^d` has a
`(k,z,ε)`-cost preserving sketch with `m + 1 ≤ C ε^{-Cz} log(max{2,k})`. [DeterministicClusteringInHigh, node_20] -/
theorem exists_costPreservingSketch (C₁ C₂ : ℝ) (h1 : Fact1 C₁) (h2 : Fact2 C₂) :
    ∃ C : ℝ, 0 < C ∧
    ∀ (n d k z : ℕ) (ε : ℝ) (P : Fin n → Fin d → ℝ),
      1 ≤ k → 1 ≤ z → 0 < ε → ε ≤ 1 / 2 →
      ∃ (m : ℕ) (f : Fin n → (Fin m → ℝ) × ℝ),
        (m : ℝ) + 1 ≤ C * ε ^ (-(C * (z : ℝ))) * Real.log (max 2 (k : ℝ)) ∧
        IsCostPreservingSketch k z ε P f := by
  sorry

