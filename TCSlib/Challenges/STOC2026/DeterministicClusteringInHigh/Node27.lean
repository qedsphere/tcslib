/-!
## Deterministic `(1+ε)`-approximation for Euclidean `(k,z)`-clustering: combinatorial core

`cost_z(X,S) = ∑_x w_x min_{s∈S} ‖x - s‖^z`, `OPT_z(P,k) = min_{|S| ≤ k} cost_z(P,S)`.
The algorithm sketches `P` into `ℝ^r × ℝ` (tool 1), builds a coreset `W` with offset `F ≥ 0`
(tool 2), enumerates the nearest-center assignments of `W` by constrained centers through the
cells of a hyperplane arrangement in parameter space, fits each part, keeps the best, assigns
`Q` to the resulting centers, and refits original-space centers on the induced partition of `P`.

Main theorems: `card_nearestAssignments_le` (enumeration bound) and `approximation_transfer`
(the `(1+ε)` guarantee of the pipeline).
-/

namespace TCSChallenge.DeterministicClusteringInHigh.node_27

/-- Euclidean norm `‖v‖₂` on `ℝ^d` (the Pi type carries the sup norm, so we define it). -/
def eucl {d : ℕ} (v : Fin d → ℝ) : ℝ := Real.sqrt (∑ i, v i ^ 2)

/-- Euclidean distance on `ℝ^r × ℝ ≅ ℝ^{r+1}`. -/
def pairDist {r : ℕ} (x y : (Fin r → ℝ) × ℝ) : ℝ :=
  Real.sqrt (eucl (x.1 - y.1) ^ 2 + (x.2 - y.2) ^ 2)

/-- "`cost_z(P,S) = ∑_{x∈P} min_{s∈S} ‖x−s‖₂^z`" (unit weights, `S` a `k`-tuple of centers). -/
def cost {n d k : ℕ} (z : ℝ) (P : Fin n → Fin d → ℝ) (S : Fin k → Fin d → ℝ) : ℝ :=
  ∑ j, ⨅ i : Fin k, eucl (P j - S i) ^ z

/-- "`OPT_z(P,k)` is the minimum of `cost_z(P,S)` over sets `S` of at most `k` centers"
(a `k`-tuple may repeat centers, so this is the same quantity). -/
def OPT {n d : ℕ} (z : ℝ) (P : Fin n → Fin d → ℝ) (k : ℕ) : ℝ :=
  ⨅ S : Fin k → Fin d → ℝ, cost z P S

/-- Weighted cost in `ℝ^r × ℝ`: `∑_x w_x min_i ‖x − T_i‖^z`. -/
def costW {N r k : ℕ} (z : ℝ) (w : Fin N → ℝ) (X : Fin N → (Fin r → ℝ) × ℝ)
    (T : Fin k → (Fin r → ℝ) × ℝ) : ℝ :=
  ∑ j, w j * ⨅ i : Fin k, pairDist (X j) (T i) ^ z

/-- Zero extension of constrained centers: `s_i ↦ (s_i, 0) ∈ H = ℝ^r × {0}`. -/
def zeroExt {r k : ℕ} (s : Fin k → Fin r → ℝ) : Fin k → (Fin r → ℝ) × ℝ :=
  fun i => (s i, 0)

/-- Constrained optimum `OPT^H_W`: centers restricted to `H = ℝ^r × {0}`. -/
def OPTH {N r : ℕ} (z : ℝ) (w : Fin N → ℝ) (X : Fin N → (Fin r → ℝ) × ℝ) (k : ℕ) : ℝ :=
  ⨅ s : Fin k → Fin r → ℝ, costW z w X (zeroExt s)

/-- "`Φ_P(C)` is the sum of the minimum one-center costs of its parts"; empty parts give 0. -/
def Phi {n d k : ℕ} (z : ℝ) (P : Fin n → Fin d → ℝ) (C : Fin n → Fin k) : ℝ :=
  ∑ i : Fin k, ⨅ s : Fin d → ℝ, ∑ j ∈ Finset.univ.filter (fun j => C j = i), eucl (P j - s) ^ z

/-- `Φ^H_Q(C)`: as `Φ`, with every center constrained to `H = ℝ^r × {0}`. -/
def PhiH {n r k : ℕ} (z : ℝ) (Q : Fin n → (Fin r → ℝ) × ℝ) (C : Fin n → Fin k) : ℝ :=
  ∑ i : Fin k, ⨅ u : Fin r → ℝ,
    ∑ j ∈ Finset.univ.filter (fun j => C j = i), pairDist (Q j) (u, 0) ^ z

/-- `g` is the nearest-center assignment of the points `a` to the centers `s`, ties broken in
favour of the smaller index. -/
def IsNearestAssign {m r k : ℕ} (a : Fin m → Fin r → ℝ) (s : Fin k → Fin r → ℝ)
    (g : Fin m → Fin k) : Prop :=
  ∀ j i, eucl (a j - s (g j)) ≤ eucl (a j - s i) ∧
    (eucl (a j - s i) = eucl (a j - s (g j)) → g j ≤ i)

/-- All assignments realised by some center tuple. (The extension coordinates `t_j` of the
coreset points do not affect comparisons between zero-extended centers, so they are omitted.) -/
def nearestAssignments {m r : ℕ} (k : ℕ) (a : Fin m → Fin r → ℝ) : Set (Fin m → Fin k) :=
  {g | ∃ s : Fin k → Fin r → ℝ, IsNearestAssign a s g}

/-- Strict sign patterns of `t` affine forms `ℓ_b(x) = ∑_i c_b i x_i + β_b` on `ℝ^h` realised
by points on no hyperplane (= full-dimensional cells of the arrangement). -/
def strictSignPatterns {t h : ℕ} (c : Fin t → Fin h → ℝ) (β : Fin t → ℝ) : Set (Fin t → Bool) :=
  {σ | ∃ x : Fin h → ℝ, ∀ b, (σ b = true → 0 < ∑ i, c b i * x i + β b) ∧
                               (σ b = false → ∑ i, c b i * x i + β b < 0)}

/-- Cell-counting bound: an arrangement of `t` hyperplanes in `ℝ^h` has at most
`∑_{b=0}^h binom(t,b)` full-dimensional cells. [DeterministicClusteringInHigh, node_27] -/
theorem card_strictSignPatterns_le {t h : ℕ} (c : Fin t → Fin h → ℝ) (β : Fin t → ℝ) :
    (strictSignPatterns c β).ncard ≤ ∑ b ∈ Finset.range (h + 1), t.choose b := by
  sorry

/-- **Main theorem 1 (enumeration bound, rubric item 2).** The tie-broken nearest-center
assignments of `m` points in `ℝ^r` by `k` centers number at most
`∑_{b ≤ k(r+1)} binom(m·binom(k,2), b)` (cells of the arrangement of the hyperplanes
`u_i − u_ℓ − 2⟨a_j, v_i − v_ℓ⟩ = 0` in the parameter space `(v, u) ∈ ℝ^{k(r+1)}`). [DeterministicClusteringInHigh, node_27] -/
theorem card_nearestAssignments_le {m r : ℕ} (k : ℕ) (a : Fin m → Fin r → ℝ) :
    (nearestAssignments k a).ncard
      ≤ ∑ b ∈ Finset.range (k * (r + 1) + 1), (m * k.choose 2).choose b := by
  sorry

/-- **Main theorem 2 (approximation transfer, rubric items 1, 3, 4).** Let `δ = ε/100`.
Suppose `Q` satisfies tool 1's partition guarantee for `P`, `(W, w, F)` satisfies tool 2's
coreset guarantee for `Q` with `F ≥ 0`, `T` is a `(1+δ)`-approximate constrained solution on
`W`, `Cl` is a nearest-center partition of `Q` with respect to `T`, and `S` refits each part of
the induced partition of `P` within `1+δ`. Then `cost_z(P,S) ≤ (1+ε) OPT_z(P,k)`. [DeterministicClusteringInHigh, node_27] -/
theorem approximation_transfer {n d r N k : ℕ} (z ε : ℝ) (hz : 1 ≤ z) (hk : 1 ≤ k)
    (hε0 : 0 < ε) (hε1 : ε ≤ 1)
    (P : Fin n → Fin d → ℝ) (Q : Fin n → (Fin r → ℝ) × ℝ)
    (hQ : ∀ C : Fin n → Fin k,
      (1 - ε / 100) * Phi z P C ≤ PhiH z Q C ∧ PhiH z Q C ≤ (1 + ε / 100) * Phi z P C)
    (W : Fin N → (Fin r → ℝ) × ℝ) (w : Fin N → ℝ) (hw : ∀ j, 0 < w j)
    (F : ℝ) (hF : 0 ≤ F)
    (hW : ∀ T : Fin k → (Fin r → ℝ) × ℝ,
      (1 - ε / 100) * costW z (fun _ => 1) Q T ≤ costW z w W T + F ∧
      costW z w W T + F ≤ (1 + ε / 100) * costW z (fun _ => 1) Q T)
    (T : Fin k → Fin r → ℝ)
    (hT : costW z w W (zeroExt T) ≤ (1 + ε / 100) * OPTH z w W k)
    (Cl : Fin n → Fin k)
    (hCl : ∀ j i, pairDist (Q j) (T (Cl j), 0) ≤ pairDist (Q j) (T i, 0))
    (S : Fin k → Fin d → ℝ)
    (hS : ∀ i : Fin k,
      ∑ j ∈ Finset.univ.filter (fun j => Cl j = i), eucl (P j - S i) ^ z
        ≤ (1 + ε / 100) *
          ⨅ s : Fin d → ℝ, ∑ j ∈ Finset.univ.filter (fun j => Cl j = i), eucl (P j - s) ^ z) :
    cost z P S ≤ (1 + ε) * OPT z P k := by
  sorry

end TCSChallenge.DeterministicClusteringInHigh.node_27
