/-!
## Reduction from arbitrary laminar families to aligned ones

`G = (V, E)` is a connected finite simple graph, `x ∈ P_st(G)` (convex hull of spanning-tree
incidence vectors), and `𝓛` is a laminar family of nonempty proper vertex sets. For every
`η > 2` there are a laminar family `𝓛'` and `x' ∈ P_st(G)` with `x'|_{E(S)} ∈ P_st(G[S])` for
all `S ∈ 𝓛'`, `x' ≤ η x`, such that every spanning tree `T` satisfying
`|T ∩ δ(S)| ≤ α x'(δ(S)) + β` on `𝓛'` satisfies
`|T ∩ δ(S)| ≤ (ηα + β)/(1 - 2/η) · x(δ(S))` on `𝓛`.

Main theorem: `TCSChallenge.ThinTreesForLaminar.node_08.laminar_reduction`.
-/

namespace TCSChallenge.ThinTreesForLaminar.node_08

variable {V : Type} [Fintype V] [DecidableEq V]

/-- "`E(S)` is the edge set of the induced subgraph `G[S]`": edges with both ends in `S`. -/
def inducedEdges (G : SimpleGraph V) (S : Finset V) : Finset (Sym2 V) :=
  G.edgeFinset.filter (fun e => ∀ v ∈ e, v ∈ S)

/-- "`δ(S)` is the set of edges with exactly one endpoint in `S`." -/
def cut (G : SimpleGraph V) (S : Finset V) : Finset (Sym2 V) :=
  G.edgeFinset.filter (fun e => ∃ u ∈ e, ∃ w ∈ e, u ∈ S ∧ w ∉ S)

/-- "`z(D) = ∑_{e ∈ D} z_e`." -/
def wt (z : Sym2 V → ℝ) (D : Finset (Sym2 V)) : ℝ :=
  ∑ e ∈ D, z e

/-- Incidence vector `𝟙_T` of an edge set `T`. -/
def incidence (T : Finset (Sym2 V)) : Sym2 V → ℝ :=
  fun e => if e ∈ T then 1 else 0

/-- `T` is a spanning tree of `G[S]`: `T ⊆ E(S)` and `(S, T)` is a tree. -/
def IsSpanningTreeOf (G : SimpleGraph V) (S : Finset V) (T : Finset (Sym2 V)) : Prop :=
  T ⊆ inducedEdges G S ∧
    ((SimpleGraph.fromEdgeSet (T : Set (Sym2 V))).induce (S : Set V)).IsTree

/-- `T` is a spanning tree of `G`: `T ⊆ E` and `(V, T)` is a tree. -/
def IsSpanningTree (G : SimpleGraph V) (T : Finset (Sym2 V)) : Prop :=
  T ⊆ G.edgeFinset ∧ (SimpleGraph.fromEdgeSet (T : Set (Sym2 V))).IsTree

/-- "`P_st(G[S])` is the convex hull of the incidence vectors of the spanning trees of `G[S]`." -/
def Pst (G : SimpleGraph V) (S : Finset V) : Set (Sym2 V → ℝ) :=
  convexHull ℝ {y | ∃ T, IsSpanningTreeOf G S T ∧ y = incidence T}

/-- "`P_st(G)` is the convex hull of the incidence vectors of spanning trees of `G`." -/
def PstG (G : SimpleGraph V) : Set (Sym2 V → ℝ) :=
  convexHull ℝ {y | ∃ T, IsSpanningTree G T ∧ y = incidence T}

/-- Restriction `z|_{E(S)}` (coordinates outside `E(S)` set to `0`). -/
def restrict (G : SimpleGraph V) (S : Finset V) (z : Sym2 V → ℝ) : Sym2 V → ℝ :=
  fun e => if e ∈ inducedEdges G S then z e else 0

/-- "A laminar family of nonempty proper subsets of `V`: any two members are nested or
disjoint." -/
def IsLaminar (L : Finset (Finset V)) : Prop :=
  (∀ S ∈ L, S.Nonempty ∧ S ≠ Finset.univ) ∧
    ∀ S ∈ L, ∀ S' ∈ L, Disjoint S S' ∨ S ⊆ S' ∨ S' ⊆ S

/-- "`x'` is aligned with `𝓛'` if `x'|_{E(S)} ∈ P_st(G[S])` for every `S ∈ 𝓛'`." -/
def IsAligned (G : SimpleGraph V) (z : Sym2 V → ℝ) (L : Finset (Finset V)) : Prop :=
  ∀ S ∈ L, restrict G S z ∈ Pst G S

/-- `P` is a partition of `S` into nonempty pairwise disjoint blocks. -/
def IsPartitionOf (S : Finset V) (P : Finset (Finset V)) : Prop :=
  (∀ B ∈ P, B.Nonempty) ∧ (∀ B ∈ P, ∀ B' ∈ P, B ≠ B' → Disjoint B B') ∧
    ∀ v, v ∈ S ↔ ∃ B ∈ P, v ∈ B

/-- `δ_{G[S]}(P)`: edges of `G[S]` whose endpoints lie in different blocks of `P`. -/
def crossEdges (G : SimpleGraph V) (S : Finset V) (P : Finset (Finset V)) : Finset (Sym2 V) :=
  (inducedEdges G S).filter (fun e => ¬ ∃ B ∈ P, ∀ v ∈ e, v ∈ B)

/-- Every nonempty proper vertex set has boundary weight at least one under `x ∈ P_st(G)`. [ThinTreesForLaminar, node_08] -/
theorem cut_weight_ge_one (G : SimpleGraph V) (x : Sym2 V → ℝ) (hx : x ∈ PstG G)
    (S : Finset V) (hne : S.Nonempty) (hprop : S ≠ Finset.univ) :
    1 ≤ wt x (cut G S) := by sorry

/-- Exact boundary identity: `∑_i z(δ(S_i)) = z(δ(S)) + 2 z(δ_{G[S]}(P))`. [ThinTreesForLaminar, node_08] -/
theorem boundary_identity (G : SimpleGraph V) (z : Sym2 V → ℝ) (S : Finset V)
    (P : Finset (Finset V)) (hP : IsPartitionOf S P) :
    ∑ B ∈ P, wt z (cut G B) = wt z (cut G S) + 2 * wt z (crossEdges G S P) := by sorry

/-- Cut cover: every edge leaving `S` leaves one of the blocks of a partition of `S`. [ThinTreesForLaminar, node_08] -/
theorem cut_cover (G : SimpleGraph V) (S : Finset V) (P : Finset (Finset V))
    (hP : IsPartitionOf S P) :
    cut G S ⊆ P.biUnion (fun B => cut G B) := by sorry

/-- Boundary inflation estimate: comparison with the one-block partition
(`η x(δ_{G[S]}(P)) ≤ |P| - 1`) gives `(1 - 2/η) ∑_i x(δ(S_i)) ≤ x(δ(S))`. [ThinTreesForLaminar, node_08] -/
theorem boundary_inflation (G : SimpleGraph V) (x : Sym2 V → ℝ) (hx : x ∈ PstG G)
    (η : ℝ) (hη : 2 < η) (S : Finset V) (hprop : S ≠ Finset.univ)
    (P : Finset (Finset V)) (hP : IsPartitionOf S P)
    (hcmp : η * wt x (crossEdges G S P) ≤ (P.card : ℝ) - 1) :
    (1 - 2 / η) * ∑ B ∈ P, wt x (cut G B) ≤ wt x (cut G S) := by sorry

/-- Hierarchy-preserving replacement plus gluing: there are a laminar `𝓛'` and an aligned
`x' ∈ P_st(G)` with `x' ≤ η x` such that every original `S ∈ 𝓛` is partitioned by members of
`𝓛'` whose internal boundary satisfies `η x(δ_{G[S]}(P)) ≤ |P| - 1`. [ThinTreesForLaminar, node_08] -/
theorem replacement_exists (G : SimpleGraph V) (hG : G.Connected) (x : Sym2 V → ℝ)
    (hx : x ∈ PstG G) (L : Finset (Finset V)) (hL : IsLaminar L) (η : ℝ) (hη : 2 < η) :
    ∃ (L' : Finset (Finset V)) (x' : Sym2 V → ℝ),
      IsLaminar L' ∧ x' ∈ PstG G ∧ IsAligned G x' L' ∧ (∀ e, x' e ≤ η * x e) ∧
      ∀ S ∈ L, ∃ P ⊆ L', IsPartitionOf S P ∧
        η * wt x (crossEdges G S P) ≤ (P.card : ℝ) - 1 := by sorry

/-- **Main theorem (reduction to aligned laminar families).** [ThinTreesForLaminar, node_08] -/
theorem laminar_reduction (G : SimpleGraph V) (hG : G.Connected) (x : Sym2 V → ℝ)
    (hx : x ∈ PstG G) (L : Finset (Finset V)) (hL : IsLaminar L) (η : ℝ) (hη : 2 < η) :
    ∃ (L' : Finset (Finset V)) (x' : Sym2 V → ℝ),
      IsLaminar L' ∧ x' ∈ PstG G ∧ IsAligned G x' L' ∧ (∀ e, x' e ≤ η * x e) ∧
      ∀ T : Finset (Sym2 V), IsSpanningTree G T →
        ∀ α β : ℝ, 0 ≤ α → 0 ≤ β →
          (∀ S ∈ L', ((T ∩ cut G S).card : ℝ) ≤ α * wt x' (cut G S) + β) →
          ∀ S ∈ L, ((T ∩ cut G S).card : ℝ) ≤
            (η * α + β) / (1 - 2 / η) * wt x (cut G S) := by sorry

end TCSChallenge.ThinTreesForLaminar.node_08
