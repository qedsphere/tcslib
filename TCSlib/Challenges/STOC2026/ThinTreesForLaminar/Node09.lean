/-!
## Thin spanning trees for aligned laminar families

`G = (V, E)` is a connected finite simple graph with rational costs `c`, `𝓛` is a laminar
family of nonempty proper vertex sets and `x ∈ P_st(G)` is rational and `𝓛`-aligned
(`x|_{E(S)} ∈ P_st(G[S])` for all `S ∈ 𝓛`). Then some spanning tree `T` has `c(T) ≤ c(x)` and
`|T ∩ δ(S)| ≤ 2⌈x(δ(S))⌉ + 1 ≤ 2x(δ(S)) + 3` for every `S ∈ 𝓛`.

Main theorem: `TCSChallenge.ThinTreesForLaminar.node_09.aligned_thin_tree`.
-/

namespace TCSChallenge.ThinTreesForLaminar.node_09

variable {V : Type} [Fintype V] [DecidableEq V]

/-- "`E(S)` is the edge set of the induced subgraph `G[S]`": edges with both ends in `S`. -/
def inducedEdges (G : SimpleGraph V) (S : Finset V) : Finset (Sym2 V) :=
  G.edgeFinset.filter (fun e => ∀ v ∈ e, v ∈ S)

/-- "`δ(S)` is the set of edges with exactly one endpoint in `S`." -/
def cut (G : SimpleGraph V) (S : Finset V) : Finset (Sym2 V) :=
  G.edgeFinset.filter (fun e => ∃ u ∈ e, ∃ w ∈ e, u ∈ S ∧ w ∉ S)

/-- "`z(D) = ∑_{e ∈ D} z_e`." -/
def wt (z : Sym2 V → ℝ) (D : Finset (Sym2 V)) : ℝ :=
  ∑ e ∈ D, z e

/-- Incidence vector `𝟙_T` of an edge set `T`. -/
def incidence (T : Finset (Sym2 V)) : Sym2 V → ℝ :=
  fun e => if e ∈ T then 1 else 0

/-- `T` is a spanning tree of `G[S]`: `T ⊆ E(S)` and `(S, T)` is a tree. -/
def IsSpanningTreeOf (G : SimpleGraph V) (S : Finset V) (T : Finset (Sym2 V)) : Prop :=
  T ⊆ inducedEdges G S ∧
    ((SimpleGraph.fromEdgeSet (T : Set (Sym2 V))).induce (S : Set V)).IsTree

/-- `T` is a spanning tree of `G`: `T ⊆ E` and `(V, T)` is a tree. -/
def IsSpanningTree (G : SimpleGraph V) (T : Finset (Sym2 V)) : Prop :=
  T ⊆ G.edgeFinset ∧ (SimpleGraph.fromEdgeSet (T : Set (Sym2 V))).IsTree

/-- "`P_st(G[S])` is the convex hull of the incidence vectors of the spanning trees of `G[S]`." -/
def Pst (G : SimpleGraph V) (S : Finset V) : Set (Sym2 V → ℝ) :=
  convexHull ℝ {y | ∃ T, IsSpanningTreeOf G S T ∧ y = incidence T}

/-- "`P_st(G)` is the convex hull of the incidence vectors of spanning trees of `G`." -/
def PstG (G : SimpleGraph V) : Set (Sym2 V → ℝ) :=
  convexHull ℝ {y | ∃ T, IsSpanningTree G T ∧ y = incidence T}

/-- Restriction `z|_{E(S)}` (coordinates outside `E(S)` set to `0`). -/
def restrict (G : SimpleGraph V) (S : Finset V) (z : Sym2 V → ℝ) : Sym2 V → ℝ :=
  fun e => if e ∈ inducedEdges G S then z e else 0

/-- "A laminar family of nonempty proper subsets of `V`: any two members are nested or
disjoint." -/
def IsLaminar (L : Finset (Finset V)) : Prop :=
  (∀ S ∈ L, S.Nonempty ∧ S ≠ Finset.univ) ∧
    ∀ S ∈ L, ∀ S' ∈ L, Disjoint S S' ∨ S ⊆ S' ∨ S' ⊆ S

/-- "`x'` is aligned with `𝓛'` if `x'|_{E(S)} ∈ P_st(G[S])` for every `S ∈ 𝓛'`." -/
def IsAligned (G : SimpleGraph V) (z : Sym2 V → ℝ) (L : Finset (Finset V)) : Prop :=
  ∀ S ∈ L, restrict G S z ∈ Pst G S

/-- "`c(z) = ∑_{e ∈ E} c_e z_e`." -/
def cost (G : SimpleGraph V) (c z : Sym2 V → ℝ) : ℝ :=
  ∑ e ∈ G.edgeFinset, c e * z e

/-- Alignment gives the integral equalities `x(E(S)) = |S| - 1` for `S ∈ 𝓛`. [ThinTreesForLaminar, node_09] -/
theorem aligned_induced_weight (G : SimpleGraph V) (x : Sym2 V → ℝ)
    (L : Finset (Finset V)) (hL : IsLaminar L) (hal : IsAligned G x L)
    (S : Finset V) (hS : S ∈ L) :
    wt x (inducedEdges G S) = (S.card : ℝ) - 1 := by sorry

/-- Persistent alignment (the alignment face): an aligned `x ∈ P_st(G)` is a convex
combination of spanning trees `T` of `G` such that `T ∩ E(S)` is a spanning tree of `G[S]`
for every `S ∈ 𝓛`. [ThinTreesForLaminar, node_09] -/
theorem aligned_face (G : SimpleGraph V) (hG : G.Connected) (x : Sym2 V → ℝ)
    (hx : x ∈ PstG G) (L : Finset (Finset V)) (hL : IsLaminar L) (hal : IsAligned G x L) :
    x ∈ convexHull ℝ {y | ∃ T, IsSpanningTree G T ∧
      (∀ S ∈ L, IsSpanningTreeOf G S (T ∩ inducedEdges G S)) ∧ y = incidence T} := by sorry

/-- First removal certificate: a tight fractional boundary (`y(D) = b`, all `0 < y_e < 1`)
with deficiency `∑_{e ∈ D} (1 - y_e) < 3` has at most `b + 2` edges. [ThinTreesForLaminar, node_09] -/
theorem removal_single (D : Finset (Sym2 V)) (y : Sym2 V → ℝ) (b : ℕ)
    (hfrac : ∀ e ∈ D, 0 < y e ∧ y e < 1) (htight : wt y D = b)
    (hdef : ∑ e ∈ D, (1 - y e) < 3) :
    D.card ≤ b + 2 := by sorry

/-- Second removal certificate: for tight nested boundaries `D' ⊊ D` (bounds `b'`, `b`) of
fractional edges with `∑_{e ∈ D \ D'} (1 - y_e) < 2`, we get `|D \ D'| ≤ b - b' + 1` and
`b' ≤ b - 1`, so a later `2b' + 1` guarantee for `D'` implies `2b + 1` for `D`. [ThinTreesForLaminar, node_09] -/
theorem removal_nested (D D' : Finset (Sym2 V)) (y : Sym2 V → ℝ) (b b' : ℕ)
    (hsub : D' ⊂ D) (hfrac : ∀ e ∈ D, 0 < y e ∧ y e < 1)
    (htight : wt y D = b) (htight' : wt y D' = b')
    (hdef : ∑ e ∈ D \ D', (1 - y e) < 2) :
    (D \ D').card ≤ b - b' + 1 ∧ b' + 1 ≤ b := by sorry

/-- Final arithmetic: `2⌈r⌉ + 1 ≤ 2r + 3`. [ThinTreesForLaminar, node_09] -/
theorem ceil_slack (r : ℝ) : 2 * ((⌈r⌉ : ℤ) : ℝ) + 1 ≤ 2 * r + 3 := by sorry

/-- **Main theorem (thin spanning tree for an aligned laminar family).** [ThinTreesForLaminar, node_09] -/
theorem aligned_thin_tree (G : SimpleGraph V) (hG : G.Connected) (c x : Sym2 V → ℝ)
    (hc : ∀ e, ∃ q : ℚ, c e = q) (hxq : ∀ e, ∃ q : ℚ, x e = q)
    (hx : x ∈ PstG G) (L : Finset (Finset V)) (hL : IsLaminar L) (hal : IsAligned G x L) :
    ∃ T : Finset (Sym2 V), IsSpanningTree G T ∧ wt c T ≤ cost G c x ∧
      ∀ S ∈ L,
        ((T ∩ cut G S).card : ℝ) ≤ 2 * ((⌈wt x (cut G S)⌉ : ℤ) : ℝ) + 1 ∧
        2 * ((⌈wt x (cut G S)⌉ : ℤ) : ℝ) + 1 ≤ 2 * wt x (cut G S) + 3 := by sorry

end TCSChallenge.ThinTreesForLaminar.node_09
