/-!
## Chasing positive bodies with covering sparsity `d`

Bodies `K_t = {x ≥ 0 : C^t x ≥ 1, P^t x ≤ 1}` with nonnegative `C^t, P^t` arrive online.
There is an absolute constant `A` such that for every `n`, weights `w > 0`, and `ε ∈ (0,1]`
some deterministic online algorithm, starting at `x^0 = 0`, outputs `x^t ≥ 0` with
`C^t x^t ≥ 1`, `P^t x^t ≤ (1+ε)1`, and
* total weighted ℓ₁ movement `≤ A ε⁻¹ max{1, ln(d/ε)} · OPT`,
* total weighted upward movement `≤ A ε⁻¹ max{1, ln(d/ε)} · D*`.

Main theorem: `chasing_positive_bodies`.

Time indexing: bodies are `K : ℕ → Body n`, with `K t` meaningful for `1 ≤ t ≤ T`.
The algorithm `alg t` receives `K 1, …, K (t+1)` and produces `x^{t+1}`.
-/

namespace TCSChallenge.ChasingPositiveBodies.node_04

open Finset

/-- A positive body `{x ∈ ℝ^n_{≥0} : C x ≥ 1, P x ≤ 1}` given by finitely many covering rows
`C : Fin mc → Fin n → ℝ` and packing rows `P : Fin mp → Fin n → ℝ`. -/
structure Body (n : ℕ) where
  mc : ℕ
  mp : ℕ
  C : Fin mc → Fin n → ℝ
  P : Fin mp → Fin n → ℝ

/-- "Each `C^t` and `P^t` has ... nonnegative entries." -/
def Body.Nonneg {n : ℕ} (K : Body n) : Prop :=
  (∀ j i, 0 ≤ K.C j i) ∧ (∀ j i, 0 ≤ K.P j i)

/-- Membership in the `γ`-augmented body: `x ≥ 0`, `C x ≥ 1`, `P x ≤ γ`. (`γ = 1` is `K`.) -/
def Body.MemAug {n : ℕ} (K : Body n) (γ : ℝ) (x : Fin n → ℝ) : Prop :=
  (∀ i, 0 ≤ x i) ∧ (∀ j, 1 ≤ ∑ i, K.C j i * x i) ∧ (∀ j, ∑ i, K.P j i * x i ≤ γ)

/-- `‖v‖_{1,w} = Σ_i w_i |v_i|`. -/
def wNorm {n : ℕ} (w : Fin n → ℝ) (v : Fin n → ℝ) : ℝ := ∑ i, w i * |v i|

/-- Total weighted ℓ₁ movement `Σ_{t=1}^T ‖q^t − q^{t−1}‖_{1,w}`. -/
def movement {n : ℕ} (w : Fin n → ℝ) (T : ℕ) (q : ℕ → Fin n → ℝ) : ℝ :=
  ∑ t ∈ Icc 1 T, wNorm w (fun i => q t i - q (t - 1) i)

/-- Total weighted upward movement `Σ_{t=1}^T Σ_i w_i (q_i^t − q_i^{t−1})_+`. -/
def upMovement {n : ℕ} (w : Fin n → ℝ) (T : ℕ) (q : ℕ → Fin n → ℝ) : ℝ :=
  ∑ t ∈ Icc 1 T, ∑ i, w i * max (q t i - q (t - 1) i) 0

/-- Feasible offline trajectories: `q^0 = 0` and `q^t ∈ K_t` for `1 ≤ t ≤ T`. -/
def FeasibleTraj {n : ℕ} (T : ℕ) (K : ℕ → Body n) (q : ℕ → Fin n → ℝ) : Prop :=
  q 0 = 0 ∧ ∀ t ∈ Icc 1 T, (K t).MemAug 1 (q t)

/-- `OPT = inf {Σ_t ‖q^t − q^{t−1}‖_{1,w} : q^0 = 0, q^t ∈ K_t}`. -/
noncomputable def OPT {n : ℕ} (w : Fin n → ℝ) (T : ℕ) (K : ℕ → Body n) : ℝ :=
  sInf {c | ∃ q, FeasibleTraj T K q ∧ c = movement w T q}

/-- Dual feasibility for the LP
`min Σ_t Σ_i w_i ℓ_i^t` s.t. `q^0 = 0`, `q^t, ℓ^t ≥ 0`, `C^t q^t ≥ 1`, `P^t q^t ≤ 1`,
`q_i^t − q_i^{t−1} ≤ ℓ_i^t`.
Dual variables: `y t j ≥ 0` (covering row `j` of `K_t`), `z t j ≥ 0` (packing row),
`r t i ≥ 0` (movement constraint), with `r_i^{T+1} = 0`. Constraints:
column `ℓ_i^t`: `r_i^t ≤ w_i`; column `q_i^t`:
`Σ_j C^t_{j i} y^t_j − Σ_j P^t_{j i} z^t_j − r_i^t + r_i^{t+1} ≤ 0`. -/
def DualFeasible {n : ℕ} (w : Fin n → ℝ) (T : ℕ) (K : ℕ → Body n)
    (y : (t : ℕ) → Fin (K t).mc → ℝ) (z : (t : ℕ) → Fin (K t).mp → ℝ)
    (r : ℕ → Fin n → ℝ) : Prop :=
  (∀ t ∈ Icc 1 T, ∀ j, 0 ≤ y t j) ∧ (∀ t ∈ Icc 1 T, ∀ j, 0 ≤ z t j) ∧
  (∀ t ∈ Icc 1 T, ∀ i, 0 ≤ r t i ∧ r t i ≤ w i) ∧ (∀ i, r (T + 1) i = 0) ∧
  ∀ t ∈ Icc 1 T, ∀ i,
    (∑ j, (K t).C j i * y t j) - (∑ j, (K t).P j i * z t j) - r t i + r (t + 1) i ≤ 0

/-- Dual objective `Σ_t (Σ_j y^t_j − Σ_j z^t_j)`. -/
def dualObj {n : ℕ} (T : ℕ) (K : ℕ → Body n)
    (y : (t : ℕ) → Fin (K t).mc → ℝ) (z : (t : ℕ) → Fin (K t).mp → ℝ) : ℝ :=
  ∑ t ∈ Icc 1 T, ((∑ j, y t j) - ∑ j, z t j)

/-- `D*`: the optimal value of the dual of the displayed LP. -/
noncomputable def Dstar {n : ℕ} (w : Fin n → ℝ) (T : ℕ) (K : ℕ → Body n) : ℝ :=
  sSup {v | ∃ y z r, DualFeasible w T K y z r ∧ v = dualObj T K y z}

open Classical in
/-- `d`: maximum number of nonzero entries in a covering row of `K_1, …, K_T`
(`d = 1` if there are no covering rows; every covering row of a nonempty body has ≥ 1
nonzero entry, so taking `max 1` is the same convention). -/
noncomputable def sparsity {n : ℕ} (T : ℕ) (K : ℕ → Body n) : ℕ :=
  max 1 ((Icc 1 T).sup fun t =>
    (univ : Finset (Fin (K t).mc)).sup fun j => (univ.filter fun i => (K t).C j i ≠ 0).card)

/-- An online algorithm: `alg t` sees the bodies `K_1, …, K_{t+1}` (as `Fin (t+1) → Body n`)
and returns `x^{t+1}`. -/
def OnlineAlg (n : ℕ) : Type := (t : ℕ) → (Fin (t + 1) → Body n) → (Fin n → ℝ)

/-- The output trajectory: `x^0 = 0`, `x^{t+1} = alg t (K_1, …, K_{t+1})`. -/
def run {n : ℕ} (alg : OnlineAlg n) (K : ℕ → Body n) : ℕ → Fin n → ℝ
  | 0 => 0
  | t + 1 => alg t (fun s => K (s.val + 1))

/-- Weak duality (used to certify the halfspace bound): any dual-feasible point has objective
at most the upward movement of any feasible trajectory. [ChasingPositiveBodies, node_04] -/
theorem weak_duality {n : ℕ} (w : Fin n → ℝ) (T : ℕ) (K : ℕ → Body n)
    (y : (t : ℕ) → Fin (K t).mc → ℝ) (z : (t : ℕ) → Fin (K t).mp → ℝ)
    (r : ℕ → Fin n → ℝ) (hd : DualFeasible w T K y z r)
    (q : ℕ → Fin n → ℝ) (hq : FeasibleTraj T K q) :
    dualObj T K y z ≤ upMovement w T q := by sorry

/-- For a nonnegative trajectory starting at `0`, total movement is at most twice the
upward movement. [ChasingPositiveBodies, node_04] -/
theorem movement_le_two_upMovement {n : ℕ} (w : Fin n → ℝ) (hw : ∀ i, 0 < w i) (T : ℕ)
    (q : ℕ → Fin n → ℝ) (h0 : q 0 = 0) (hnn : ∀ t i, 0 ≤ q t i) :
    movement w T q ≤ 2 * upMovement w T q := by sorry

/-- Main theorem: an online algorithm with `ε`-packing augmentation, exact covering, and
competitive ratio `A ε⁻¹ max{1, ln(d/ε)}` against both `OPT` and `D*`. [ChasingPositiveBodies, node_04] -/
theorem chasing_positive_bodies :
    ∃ A : ℝ, 0 < A ∧
      ∀ (n : ℕ) (w : Fin n → ℝ), (∀ i, 0 < w i) →
      ∀ ε : ℝ, 0 < ε → ε ≤ 1 →
      ∃ alg : OnlineAlg n,
        ∀ (T : ℕ) (K : ℕ → Body n),
          (∀ t ∈ Icc 1 T, (K t).Nonneg) →
          (∀ t ∈ Icc 1 T, ∃ q, (K t).MemAug 1 q) →
          let x := run alg K
          let ρ := A * ε⁻¹ * max 1 (Real.log ((sparsity T K : ℝ) / ε))
          (∀ t ∈ Icc 1 T, (K t).MemAug (1 + ε) (x t)) ∧
          movement w T x ≤ ρ * OPT w T K ∧
          upMovement w T x ≤ ρ * Dstar w T K := by sorry

end TCSChallenge.ChasingPositiveBodies.node_04
