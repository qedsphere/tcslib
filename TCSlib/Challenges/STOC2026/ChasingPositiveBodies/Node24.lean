/-!
## Online rounding of fractional bipartite matchings with low recourse

`V = L ⊔ R`, `n = |L| + |R| ≥ 2`. At each time `t = 0, …, T` the algorithm receives the edge
set `E^t ⊆ L × R` and a fractional matching `x^t` supported on `E^t`, and outputs a matching
`M^t ⊆ E^t`. There is a universal `C > 0` such that for all `δ ∈ (0,1)` and `α ≥ 1` some
randomized online algorithm achieves `E|M^t| ≥ (1-δ) Σ_{e∈E^t} x_e^t` for every `t` and
`E[Σ_{t=1}^T |M^t △ M^{t-1}|] ≤ C (α log n / δ³) Σ_t ‖x^t − x^{t−1}‖₁ + C T / (δ n^α)`.

Main theorem: `online_matching_rounding`.
-/

namespace TCSChallenge.ChasingPositiveBodies.node_24

open Finset MeasureTheory

variable {L R : Type} [Fintype L] [Fintype R] [DecidableEq L] [DecidableEq R]

/-- `x` is a fractional matching supported on `E`: `x ≥ 0`, `x_e = 0` for `e ∉ E`, and
`Σ_{e ∋ v} x_e ≤ 1` for every vertex `v ∈ L ⊔ R`. -/
def IsFracMatching (E : Finset (L × R)) (x : L × R → ℝ) : Prop :=
  (∀ e, 0 ≤ x e) ∧ (∀ e, e ∉ E → x e = 0) ∧
  (∀ l : L, ∑ r : R, x (l, r) ≤ 1) ∧ (∀ r : R, ∑ l : L, x (l, r) ≤ 1)

/-- `M ⊆ E` is a matching: distinct edges share no endpoint. -/
def IsMatchingIn (E M : Finset (L × R)) : Prop :=
  M ⊆ E ∧ ∀ e ∈ M, ∀ e' ∈ M, e ≠ e' → e.1 ≠ e'.1 ∧ e.2 ≠ e'.2

/-- `‖z‖₁ = Σ_{e ∈ L×R} |z_e|`. -/
def l1 (z : L × R → ℝ) : ℝ := ∑ e, |z e|

/-- `|A △ B|`. -/
def symmDiffCard (A B : Finset (L × R)) : ℕ := (A \ B ∪ B \ A).card

/-- A randomized online algorithm with seed space `Ω`: at time `t` it sees the seed and the
inputs `(E^0,x^0), …, (E^t,x^t)` and outputs `M^t`. -/
def RandOnlineAlg (L R Ω : Type) : Type :=
  Ω → (t : ℕ) → (Fin (t + 1) → Finset (L × R) × (L × R → ℝ)) → Finset (L × R)

/-- The output `M^t(ω)` on input sequence `(E, x)`. -/
def outputs {Ω : Type} (alg : RandOnlineAlg L R Ω) (E : ℕ → Finset (L × R))
    (x : ℕ → L × R → ℝ) (ω : Ω) (t : ℕ) : Finset (L × R) :=
  alg ω t (fun s => (E s.val, x s.val))

/-- Short-augmenting-path maintenance invariant: if no matching `M'` of `E` with
`|M △ M'| ≤ 2k − 1` is larger than `M` (in particular, no augmenting path of length
`≤ 2k − 1`), then `|M| ≥ (k/(k+1)) |M*|` for every matching `M*` of `E`. [ChasingPositiveBodies, node_24] -/
theorem no_short_improvement_approx (E M Mstar : Finset (L × R)) (k : ℕ) (hk : 1 ≤ k)
    (hM : IsMatchingIn E M) (hMs : IsMatchingIn E Mstar)
    (hloc : ∀ M' : Finset (L × R), IsMatchingIn E M' →
      symmDiffCard M M' ≤ 2 * k - 1 → M'.card ≤ M.card) :
    k * Mstar.card ≤ (k + 1) * M.card := by sorry

/-- Main theorem. [ChasingPositiveBodies, node_24] -/
theorem online_matching_rounding :
    ∃ C : ℝ, 0 < C ∧
      ∀ (L₀ R₀ : Type) [Fintype L₀] [Fintype R₀] [DecidableEq L₀] [DecidableEq R₀],
      2 ≤ Fintype.card L₀ + Fintype.card R₀ →
      ∀ δ : ℝ, 0 < δ → δ < 1 → ∀ α : ℝ, 1 ≤ α →
      ∃ (Ω : Type) (_ : MeasurableSpace Ω) (μ : Measure Ω) (_ : IsProbabilityMeasure μ)
        (alg : RandOnlineAlg L₀ R₀ Ω),
        ∀ (T : ℕ) (E : ℕ → Finset (L₀ × R₀)) (x : ℕ → L₀ × R₀ → ℝ),
          (∀ t ≤ T, IsFracMatching (E t) (x t)) →
          let n : ℝ := (Fintype.card L₀ + Fintype.card R₀ : ℕ)
          (∀ t ≤ T, ∀ ω, IsMatchingIn (E t) (outputs alg E x ω t)) ∧
          (∀ t ≤ T, ∀ e, MeasurableSet {ω | e ∈ outputs alg E x ω t}) ∧
          (∀ t ≤ T, (1 - δ) * ∑ e ∈ E t, x t e ≤
              ∫ ω, ((outputs alg E x ω t).card : ℝ) ∂μ) ∧
          ∫ ω, (∑ t ∈ Icc 1 T,
                (symmDiffCard (outputs alg E x ω t) (outputs alg E x ω (t - 1)) : ℝ)) ∂μ
            ≤ C * (α * Real.log n / δ ^ 3) *
                (∑ t ∈ Icc 1 T, l1 (fun e => x t e - x (t - 1) e))
              + C * T / (δ * n ^ α) := by sorry

end TCSChallenge.ChasingPositiveBodies.node_24
