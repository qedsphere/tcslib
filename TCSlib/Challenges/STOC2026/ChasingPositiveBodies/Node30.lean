/-!
## Dynamic spanning-tree rounding: the unrestricted-`δ` assertion is false

Vertices `Fin n`; `E` = unordered pairs of distinct vertices (`Sym2 (Fin n)` off the
diagonal). The input is `(G^t, x^t)`, `t = 0, …, T`, with `G^t` connected and `x^t` a
fractional spanning tree supported on `G^t`. The assertion: there are absolute
`C₁, C₂ > 0` such that for all `n ≥ 1`, `δ > 0`, `α ≥ 1` and costs `c ≥ 0`, a randomized
dynamic algorithm maintains spanning trees `A^t ⊆ G^t` with `c(A^t) ≤ (2+δ) c·x^t` a.s. and
`E[Σ_{t=1}^T |A^t △ A^{t−1}|] ≤ C₁ (α log n / δ²) Σ_t ‖x^t − x^{t−1}‖₁ + C₂ T / n^α`.

Main theorem: `not_assertion` (the assertion fails).
-/

namespace TCSChallenge.ChasingPositiveBodies.node_30

open Finset MeasureTheory

open Classical in
/-- `x(E(S)) = Σ_{e ⊆ S} x_e` over unordered pairs with both endpoints in `S`
(diagonal pairs carry `x = 0` for valid inputs, since they are not graph edges). -/
noncomputable def massInside {n : ℕ} (x : Sym2 (Fin n) → ℝ) (S : Finset (Fin n)) : ℝ :=
  ∑ e ∈ (univ : Finset (Sym2 (Fin n))).filter (fun e => ¬ e.IsDiag ∧ ∀ v ∈ e, v ∈ S), x e

/-- Valid input at one time: `G` connected, `x ≥ 0`, `x_e = 0` off `E(G)`,
`Σ_e x_e = n − 1`, and `x(E(S)) ≤ |S| − 1` for every nonempty proper `S ⊂ V`. -/
def ValidInput {n : ℕ} (G : SimpleGraph (Fin n)) (x : Sym2 (Fin n) → ℝ) : Prop :=
  G.Connected ∧ (∀ e, 0 ≤ x e) ∧ (∀ e, e ∉ G.edgeSet → x e = 0) ∧
  (∑ e, x e = (n : ℝ) - 1) ∧
  ∀ S : Finset (Fin n), S.Nonempty → S ≠ univ → massInside x S ≤ (S.card : ℝ) - 1

/-- `A` is (the edge set of) a spanning tree of `G`. -/
def IsSpanningTreeOf {n : ℕ} (G : SimpleGraph (Fin n)) (A : Finset (Sym2 (Fin n))) : Prop :=
  (↑A : Set (Sym2 (Fin n))) ⊆ G.edgeSet ∧ (SimpleGraph.fromEdgeSet (↑A : Set (Sym2 (Fin n)))).IsTree

/-- `‖y‖₁ = Σ_{e} |y_e|` (diagonal entries vanish on valid inputs). -/
def l1 {n : ℕ} (y : Sym2 (Fin n) → ℝ) : ℝ := ∑ e, |y e|

/-- `|A △ B|`. -/
def symmDiffCard {n : ℕ} (A B : Finset (Sym2 (Fin n))) : ℕ := (A \ B ∪ B \ A).card

/-- Randomized dynamic (online) algorithm with seed space `Ω`. -/
def RandDynAlg (n : ℕ) (Ω : Type) : Type :=
  Ω → (t : ℕ) → (Fin (t + 1) → SimpleGraph (Fin n) × (Sym2 (Fin n) → ℝ)) →
    Finset (Sym2 (Fin n))

/-- Output `A^t(ω)` on the input sequence `(G, x)`. -/
def outputs {n : ℕ} {Ω : Type} (alg : RandDynAlg n Ω) (G : ℕ → SimpleGraph (Fin n))
    (x : ℕ → Sym2 (Fin n) → ℝ) (ω : Ω) (t : ℕ) : Finset (Sym2 (Fin n)) :=
  alg ω t (fun s => (G s.val, x s.val))

/-- The assertion of node_30, verbatim with unrestricted `δ > 0`. -/
def Assertion : Prop :=
  ∃ C₁ C₂ : ℝ, 0 < C₁ ∧ 0 < C₂ ∧
    ∀ (n : ℕ), 0 < n → ∀ δ : ℝ, 0 < δ → ∀ α : ℝ, 1 ≤ α →
    ∀ c : Sym2 (Fin n) → ℝ, (∀ e, 0 ≤ c e) →
    ∃ (Ω : Type) (_ : MeasurableSpace Ω) (μ : Measure Ω) (_ : IsProbabilityMeasure μ)
      (alg : RandDynAlg n Ω),
      ∀ (T : ℕ) (G : ℕ → SimpleGraph (Fin n)) (x : ℕ → Sym2 (Fin n) → ℝ),
        (∀ t ≤ T, ValidInput (G t) (x t)) →
        (∀ t ≤ T, ∀ e, MeasurableSet {ω | e ∈ outputs alg G x ω t}) ∧
        (∀ t ≤ T, ∀ᵐ ω ∂μ, IsSpanningTreeOf (G t) (outputs alg G x ω t) ∧
            ∑ e ∈ outputs alg G x ω t, c e ≤ (2 + δ) * ∑ e, c e * x t e) ∧
        ∫ ω, (∑ t ∈ Icc 1 T,
              (symmDiffCard (outputs alg G x ω t) (outputs alg G x ω (t - 1)) : ℝ)) ∂μ
          ≤ C₁ * (α * Real.log n / δ ^ 2) * (∑ t ∈ Icc 1 T, l1 (fun e => x t e - x (t - 1) e))
            + C₂ * T / (n : ℝ) ^ α

/-- Two distinct spanning trees of graphs on `Fin n` differ in at least two edges. [ChasingPositiveBodies, node_30] -/
theorem symmDiffCard_ge_two_of_trees {n : ℕ} (G H : SimpleGraph (Fin n))
    (A B : Finset (Sym2 (Fin n))) (hA : IsSpanningTreeOf G A) (hB : IsSpanningTreeOf H B)
    (hne : A ≠ B) : 2 ≤ symmDiffCard A B := by sorry

/-- The edge-omission sequence `G^0 = K_n`, `G^t = K_n − e_t` with `x^0 ≡ 2/n`,
`x^t ≡ (n−1)/(m−1)` off `e_t` (`m = n(n−1)/2`) is valid for `n ≥ 4`, has total fractional
movement `≤ 2n`, and every sequence of spanning trees `A^t ⊆ G^t` (`t ≤ m`) has recourse
`≥ 2`. [ChasingPositiveBodies, node_30] -/
theorem edge_omission_counterexample (n : ℕ) (hn : 4 ≤ n) :
    ∃ (T : ℕ) (G : ℕ → SimpleGraph (Fin n)) (x : ℕ → Sym2 (Fin n) → ℝ),
      T = n * (n - 1) / 2 ∧
      (∀ t ≤ T, ValidInput (G t) (x t)) ∧
      (∀ t ≤ T, ∑ e, x t e = (n : ℝ) - 1) ∧
      (∑ t ∈ Icc 1 T, l1 (fun e => x t e - x (t - 1) e)) ≤ 2 * n ∧
      ∀ A : ℕ → Finset (Sym2 (Fin n)), (∀ t ≤ T, IsSpanningTreeOf (G t) (A t)) →
        2 ≤ ∑ t ∈ Icc 1 T, symmDiffCard (A t) (A (t - 1)) := by sorry

/-- Main theorem: the unrestricted-`δ` assertion is false. [ChasingPositiveBodies, node_30] -/
theorem not_assertion : ¬ Assertion := by sorry

end TCSChallenge.ChasingPositiveBodies.node_30
