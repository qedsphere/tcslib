/-!
## Symmetric-affine `φ`-regret of OGD with step size `t^{-1/2}`

Projected OGD with subgradients `‖g^t‖ ≤ G` and `η_t = t^{-1/2}` on `𝒳 ⊆ B(0, D)` (compact,
convex, nonempty) is compared against an affine self-map `φ(x) = Ax + b` of `𝒳` with symmetric
`A`. The challenge (`phi_regret_symmetric_affine`) is
`Reg_φ(T) = ∑_{t ≤ T} (ℓ^t(x^t) - ℓ^t(φ(x^t))) ≤ 3(1 + ‖A‖₂)(4D² + D‖b‖ + G²)√T`.
The proof route goes through the interpolated map `p(x) = (1-α)x + αφ(x)`,
`α = 1/(3(1+‖A‖₂))`, which is the proximal map of an explicit quadratic potential.
Rounds are indexed by `t ∈ Finset.Icc 1 T`.
-/

namespace TCSChallenge.ProximalRegretAndProximal.node_15

/-- The ambient Euclidean space `ℝ^d`. -/
abbrev E (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- "`Π_𝒳` is Euclidean projection": `y` is a nearest point of `X` to `z`. -/
def IsProjOnto {d : ℕ} (X : Set (E d)) (z y : E d) : Prop :=
  y ∈ X ∧ ∀ w ∈ X, ‖z - y‖ ≤ ‖z - w‖

/-- "Fix `x^1 ∈ 𝒳` and define `x^{t+1} = Π_𝒳(x^t - η_t g_t)`, `1 ≤ t ≤ T`." -/
def IsProjectedOGD {d : ℕ} (X : Set (E d)) (g : ℕ → E d) (η : ℕ → ℝ) (x : ℕ → E d)
    (T : ℕ) : Prop :=
  x 1 ∈ X ∧ ∀ t ∈ Finset.Icc 1 T, IsProjOnto X (x t - η t • g t) (x (t + 1))

/-- "`η_t = t^{-1/2}`". -/
def stepSize (t : ℕ) : ℝ := 1 / Real.sqrt (t : ℝ)

/-- The affine comparator `φ(x) = Ax + b`. -/
def affineMap {d : ℕ} (A : E d →L[ℝ] E d) (b : E d) (x : E d) : E d := A x + b

/-- The interpolation parameter `α = 1/(3(1 + ‖A‖₂))`. -/
def alpha {d : ℕ} (A : E d →L[ℝ] E d) : ℝ := 1 / (3 * (1 + ‖A‖))

/-- The regularized comparison map `p(x) = (1-α)x + αφ(x) = Mx + c`. -/
def comparisonMap {d : ℕ} (A : E d →L[ℝ] E d) (b : E d) (x : E d) : E d :=
  (1 - alpha A) • x + alpha A • affineMap A b x

/-- "`Reg_φ(T) = ∑_{t=1}^T (ℓ^t(x^t) - ℓ^t(φ(x^t)))`". -/
def phiRegret {d : ℕ} (ℓ : ℕ → E d → ℝ) (x : ℕ → E d) (φ : E d → E d) (T : ℕ) : ℝ :=
  ∑ t ∈ Finset.Icc 1 T, (ℓ t (x t) - ℓ t (φ (x t)))

/-- Rubric 1a: the comparison map sends `𝒳` into itself. [ProximalRegretAndProximal, node_15] -/
theorem comparisonMap_mem {d : ℕ} (X : Set (E d)) (hXcv : Convex ℝ X)
    (A : E d →L[ℝ] E d) (b : E d) (hφ : ∀ x ∈ X, affineMap A b x ∈ X)
    (x : E d) (hx : x ∈ X) : comparisonMap A b x ∈ X := by
  sorry

/-- Rubric 1b: the linear part `M = (1-α)I + αA` is positive definite, with
`⟨Mv, v⟩ ≥ (2/3)‖v‖²`. [ProximalRegretAndProximal, node_15] -/
theorem linearPart_posDef {d : ℕ} (A : E d →L[ℝ] E d)
    (hA : LinearMap.IsSymmetric (A : E d →ₗ[ℝ] E d)) (v : E d) :
    2 / 3 * ‖v‖ ^ 2 ≤ inner ℝ ((1 - alpha A) • v + alpha A • A v) v := by
  sorry

/-- Rubric 2: there is a quadratic potential `q` whose proximal map is the comparison map,
in the sense `‖x - p(x)‖² - ‖x - r‖² ≤ 2(q(r) - q(p(x)))` for `x, r ∈ 𝒳`, and whose range on
`p(𝒳)` is at most `3D² + D‖b‖`. [ProximalRegretAndProximal, node_15] -/
theorem quadratic_potential {d : ℕ} (X : Set (E d)) (D : ℝ)
    (hXball : X ⊆ Metric.closedBall 0 D) (hXcv : Convex ℝ X)
    (A : E d →L[ℝ] E d) (hA : LinearMap.IsSymmetric (A : E d →ₗ[ℝ] E d)) (b : E d)
    (hφ : ∀ x ∈ X, affineMap A b x ∈ X) :
    ∃ q : E d → ℝ,
      (∀ x ∈ X, ∀ r ∈ X,
        ‖x - comparisonMap A b x‖ ^ 2 - ‖x - r‖ ^ 2
          ≤ 2 * (q r - q (comparisonMap A b x))) ∧
      (∀ x ∈ X, ∀ x' ∈ X,
        q (comparisonMap A b x) - q (comparisonMap A b x') ≤ 3 * D ^ 2 + D * ‖b‖) := by
  sorry

/-- Elementary summation estimate `∑_{t=1}^T t^{-1/2} ≤ 2√T`. [ProximalRegretAndProximal, node_15] -/
theorem sum_stepSize_le (T : ℕ) :
    ∑ t ∈ Finset.Icc 1 T, stepSize t ≤ 2 * Real.sqrt (T : ℝ) := by
  sorry

/-- Rubric 3: moving-comparator OGD bound against `p^t = p(x^t)`:
`∑_t ⟨g^t, x^t - p^t⟩ ≤ (4D² + D‖b‖ + G²)√T`. [ProximalRegretAndProximal, node_15] -/
theorem linearized_comparison_regret {d : ℕ} (T : ℕ) (hT : 1 ≤ T)
    (X : Set (E d)) (D G : ℝ) (hXne : X.Nonempty) (hXcpt : IsCompact X)
    (hXcv : Convex ℝ X) (hXball : X ⊆ Metric.closedBall 0 D)
    (g x : ℕ → E d) (hg : ∀ t ∈ Finset.Icc 1 T, ‖g t‖ ≤ G)
    (hx : IsProjectedOGD X g stepSize x T)
    (A : E d →L[ℝ] E d) (hA : LinearMap.IsSymmetric (A : E d →ₗ[ℝ] E d)) (b : E d)
    (hφ : ∀ y ∈ X, affineMap A b y ∈ X) :
    ∑ t ∈ Finset.Icc 1 T, inner ℝ (g t) (x t - comparisonMap A b (x t))
      ≤ (4 * D ^ 2 + D * ‖b‖ + G ^ 2) * Real.sqrt (T : ℝ) := by
  sorry

/-- Main theorem: `Reg_φ(T) ≤ 3(1 + ‖A‖₂)(4D² + D‖b‖ + G²)√T` for every `T ≥ 1`. [ProximalRegretAndProximal, node_15] -/
theorem phi_regret_symmetric_affine {d : ℕ} (T : ℕ) (hT : 1 ≤ T)
    (X : Set (E d)) (D G : ℝ) (hXne : X.Nonempty) (hXcpt : IsCompact X)
    (hXcv : Convex ℝ X) (hXball : X ⊆ Metric.closedBall 0 D)
    (ℓ : ℕ → E d → ℝ) (hconv : ∀ t, 1 ≤ t → ConvexOn ℝ X (ℓ t))
    (hlip : ∀ t, 1 ≤ t → ∀ y ∈ X, ∀ z ∈ X, |ℓ t y - ℓ t z| ≤ G * ‖y - z‖)
    (g x : ℕ → E d)
    (hsub : ∀ t ∈ Finset.Icc 1 T, ∀ y ∈ X, ℓ t (x t) + inner ℝ (g t) (y - x t) ≤ ℓ t y)
    (hg : ∀ t ∈ Finset.Icc 1 T, ‖g t‖ ≤ G)
    (hx : IsProjectedOGD X g stepSize x T)
    (A : E d →L[ℝ] E d) (hA : LinearMap.IsSymmetric (A : E d →ₗ[ℝ] E d)) (b : E d)
    (hφ : ∀ y ∈ X, affineMap A b y ∈ X) :
    phiRegret ℓ x (affineMap A b) T
      ≤ 3 * (1 + ‖A‖) * (4 * D ^ 2 + D * ‖b‖ + G ^ 2) * Real.sqrt (T : ℝ) := by
  sorry

