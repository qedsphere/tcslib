/-!
## Proximal regret of projected online gradient descent

Projected OGD `x^{t+1} = Π_𝒳(x^t - η_t ∇ℓ^t(x^t))` with non-increasing step sizes is run on
convex losses. For a `ρ`-weakly convex `f` (`ρ ∈ [0,1)`), with `p^t = prox_f(x^t)`, the
challenge is the chain
`∑ (ℓ^t(x^t) - ℓ^t(p^t)) ≤ ∑ ⟨∇ℓ^t(x^t), x^t - p^t⟩
  ≤ (D² + 2B_f - ‖x^{T+1} - p^T‖²)/(2η_T) + ∑ η_t/2 ‖∇ℓ^t(x^t)‖²
    - ∑_{t<T} (1-ρ)/(2η_t) ‖p^t - p^{t+1}‖²`
(`proximal_regret_ogd`) and its constant-step refinement (`proximal_regret_ogd_const`).
Rounds are indexed by `t ∈ Finset.Icc 1 T`; the sums over `1 ≤ t ≤ T-1` use `Finset.Ico 1 T`.
-/

namespace TCSChallenge.ProximalRegretAndProximal.node_11

/-- The ambient Euclidean space `ℝ^d`. -/
abbrev E (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- "`Π_𝒳` is Euclidean projection": `y` is a nearest point of `X` to `z`. -/
def IsProjOnto {d : ℕ} (X : Set (E d)) (z y : E d) : Prop :=
  y ∈ X ∧ ∀ w ∈ X, ‖z - y‖ ≤ ‖z - w‖

/-- "Fix `x^1 ∈ 𝒳` and define `x^{t+1} = Π_𝒳(x^t - η_t g_t)`, `1 ≤ t ≤ T`." -/
def IsProjectedOGD {d : ℕ} (X : Set (E d)) (g : ℕ → E d) (η : ℕ → ℝ) (x : ℕ → E d)
    (T : ℕ) : Prop :=
  x 1 ∈ X ∧ ∀ t ∈ Finset.Icc 1 T, IsProjOnto X (x t - η t • g t) (x (t + 1))

/-- "`p = prox_f(x) ∈ argmin_{p ∈ 𝒳} { f(p) + ½‖p - x‖² }`", where `f = +∞` off `dom`. -/
def IsProxPoint {d : ℕ} (X dom : Set (E d)) (f : E d → ℝ) (x p : E d) : Prop :=
  p ∈ X ∩ dom ∧
    ∀ q ∈ X ∩ dom, f p + (1 / 2) * ‖p - x‖ ^ 2 ≤ f q + (1 / 2) * ‖q - x‖ ^ 2

/-- Rubric 1a: convexity linearization, `ℓ(x) - ℓ(p) ≤ ⟨∇ℓ(x), x - p⟩` for `x, p ∈ 𝒳`. [ProximalRegretAndProximal, node_11] -/
theorem convex_linearization {d : ℕ} (X : Set (E d)) (ℓ : E d → ℝ)
    (hℓ : ConvexOn ℝ X ℓ) (x p : E d) (hx : x ∈ X) (hp : p ∈ X)
    (hdiff : DifferentiableAt ℝ ℓ x) :
    ℓ x - ℓ p ≤ inner ℝ (gradient ℓ x) (x - p) := by
  sorry

/-- Rubric 1b: one-step projected-gradient inequality against an arbitrary `u ∈ 𝒳`. [ProximalRegretAndProximal, node_11] -/
theorem ogd_one_step {d : ℕ} (X : Set (E d)) (hX : Convex ℝ X) (x x' g u : E d)
    (η : ℝ) (hη : 0 < η) (hx : x ∈ X) (hproj : IsProjOnto X (x - η • g) x') (hu : u ∈ X) :
    inner ℝ g (x - u) ≤ (‖x - u‖ ^ 2 - ‖x' - u‖ ^ 2) / (2 * η) + η / 2 * ‖g‖ ^ 2 := by
  sorry

/-- Rubric 2: proximal three-point inequality from `(1-ρ)`-strong convexity of the proximal
objective: `‖x - p_x‖² - ‖x - q‖² ≤ 2(f(q) - f(p_x)) - (1-ρ)‖q - p_x‖²`. [ProximalRegretAndProximal, node_11] -/
theorem prox_three_point {d : ℕ} (X dom : Set (E d)) (f : E d → ℝ) (ρ : ℝ)
    (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hweak : ConvexOn ℝ (X ∩ dom) (fun y => f y + ρ / 2 * ‖y‖ ^ 2))
    (x px q : E d) (hpx : IsProxPoint X dom f x px) (hq : q ∈ X ∩ dom) :
    ‖x - px‖ ^ 2 - ‖x - q‖ ^ 2 ≤ 2 * (f q - f px) - (1 - ρ) * ‖q - px‖ ^ 2 := by
  sorry

/-- Rubric 3: moving-comparator reindexing with non-increasing step sizes:
`∑_t (‖x^t-p^t‖² - ‖x^{t+1}-p^t‖²)/(2η_t)
  ≤ (D² - ‖x^{T+1}-p^T‖²)/(2η_T) + ∑_{t<T} (‖x^{t+1}-p^{t+1}‖² - ‖x^{t+1}-p^t‖²)/(2η_t)`. [ProximalRegretAndProximal, node_11] -/
theorem moving_comparator_decomposition {d : ℕ} (T : ℕ) (hT : 1 ≤ T) (η : ℕ → ℝ)
    (hηpos : ∀ t ∈ Finset.Icc 1 T, 0 < η t)
    (hηmono : ∀ s ∈ Finset.Icc 1 T, ∀ t ∈ Finset.Icc 1 T, s ≤ t → η t ≤ η s)
    (x p : ℕ → E d) (D : ℝ) (hD : ∀ t ∈ Finset.Icc 1 T, ‖x t - p t‖ ≤ D) :
    ∑ t ∈ Finset.Icc 1 T, (‖x t - p t‖ ^ 2 - ‖x (t + 1) - p t‖ ^ 2) / (2 * η t)
      ≤ (D ^ 2 - ‖x (T + 1) - p T‖ ^ 2) / (2 * η T)
        + ∑ t ∈ Finset.Ico 1 T,
            (‖x (t + 1) - p (t + 1)‖ ^ 2 - ‖x (t + 1) - p t‖ ^ 2) / (2 * η t) := by
  sorry

/-- Rubric 4: weighted summation by parts,
`∑_{t<T} (a_t - a_{t+1})/η_t ≤ B/η_T` whenever `a_s - a_t ≤ B` on `[1, T]`. [ProximalRegretAndProximal, node_11] -/
theorem weighted_telescope_bound (T : ℕ) (hT : 1 ≤ T) (η : ℕ → ℝ)
    (hηpos : ∀ t ∈ Finset.Icc 1 T, 0 < η t)
    (hηmono : ∀ s ∈ Finset.Icc 1 T, ∀ t ∈ Finset.Icc 1 T, s ≤ t → η t ≤ η s)
    (a : ℕ → ℝ) (B : ℝ) (hB : ∀ s ∈ Finset.Icc 1 T, ∀ t ∈ Finset.Icc 1 T, a s - a t ≤ B) :
    ∑ t ∈ Finset.Ico 1 T, (a t - a (t + 1)) / η t ≤ B / η T := by
  sorry

/-- Main theorem (non-increasing step sizes). `D` bounds `max_t ‖x^t - p^t‖` and `B` bounds
`max_t f(p^t) - min_t f(p^t)`. [ProximalRegretAndProximal, node_11] -/
theorem proximal_regret_ogd {d : ℕ} (T : ℕ) (hT : 1 ≤ T)
    (X : Set (E d)) (hXne : X.Nonempty) (hXcl : IsClosed X) (hXcv : Convex ℝ X)
    (ℓ : ℕ → E d → ℝ) (x : ℕ → E d) (η : ℕ → ℝ)
    (hconv : ∀ t ∈ Finset.Icc 1 T, ConvexOn ℝ X (ℓ t))
    (hdiff : ∀ t ∈ Finset.Icc 1 T, DifferentiableAt ℝ (ℓ t) (x t))
    (hηpos : ∀ t ∈ Finset.Icc 1 T, 0 < η t)
    (hηmono : ∀ s ∈ Finset.Icc 1 T, ∀ t ∈ Finset.Icc 1 T, s ≤ t → η t ≤ η s)
    (hx : IsProjectedOGD X (fun t => gradient (ℓ t) (x t)) η x T)
    (dom : Set (E d)) (f : E d → ℝ) (ρ : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hweak : ConvexOn ℝ (X ∩ dom) (fun y => f y + ρ / 2 * ‖y‖ ^ 2))
    (p : ℕ → E d) (hp : ∀ t ∈ Finset.Icc 1 T, IsProxPoint X dom f (x t) (p t))
    (D B : ℝ) (hD : ∀ t ∈ Finset.Icc 1 T, ‖x t - p t‖ ≤ D)
    (hB : ∀ s ∈ Finset.Icc 1 T, ∀ t ∈ Finset.Icc 1 T, f (p s) - f (p t) ≤ B) :
    (∑ t ∈ Finset.Icc 1 T, (ℓ t (x t) - ℓ t (p t))
        ≤ ∑ t ∈ Finset.Icc 1 T, inner ℝ (gradient (ℓ t) (x t)) (x t - p t)) ∧
    (∑ t ∈ Finset.Icc 1 T, inner ℝ (gradient (ℓ t) (x t)) (x t - p t)
        ≤ (D ^ 2 + 2 * B - ‖x (T + 1) - p T‖ ^ 2) / (2 * η T)
          + ∑ t ∈ Finset.Icc 1 T, η t / 2 * ‖gradient (ℓ t) (x t)‖ ^ 2
          - ∑ t ∈ Finset.Ico 1 T, (1 - ρ) / (2 * η t) * ‖p t - p (t + 1)‖ ^ 2) := by
  sorry

/-- Main theorem (constant step size `η_t = η`): exact telescoping refinement. [ProximalRegretAndProximal, node_11] -/
theorem proximal_regret_ogd_const {d : ℕ} (T : ℕ) (hT : 1 ≤ T)
    (X : Set (E d)) (hXne : X.Nonempty) (hXcl : IsClosed X) (hXcv : Convex ℝ X)
    (ℓ : ℕ → E d → ℝ) (x : ℕ → E d) (η : ℝ) (hη : 0 < η)
    (hconv : ∀ t ∈ Finset.Icc 1 T, ConvexOn ℝ X (ℓ t))
    (hdiff : ∀ t ∈ Finset.Icc 1 T, DifferentiableAt ℝ (ℓ t) (x t))
    (hx : IsProjectedOGD X (fun t => gradient (ℓ t) (x t)) (fun _ => η) x T)
    (dom : Set (E d)) (f : E d → ℝ) (ρ : ℝ) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hweak : ConvexOn ℝ (X ∩ dom) (fun y => f y + ρ / 2 * ‖y‖ ^ 2))
    (p : ℕ → E d) (hp : ∀ t ∈ Finset.Icc 1 T, IsProxPoint X dom f (x t) (p t)) :
    (∑ t ∈ Finset.Icc 1 T, (ℓ t (x t) - ℓ t (p t))
        ≤ ∑ t ∈ Finset.Icc 1 T, inner ℝ (gradient (ℓ t) (x t)) (x t - p t)) ∧
    (∑ t ∈ Finset.Icc 1 T, inner ℝ (gradient (ℓ t) (x t)) (x t - p t)
        ≤ (‖x 1 - p 1‖ ^ 2 + 2 * (f (p 1) - f (p T)) - ‖x (T + 1) - p T‖ ^ 2) / (2 * η)
          + ∑ t ∈ Finset.Icc 1 T, η / 2 * ‖gradient (ℓ t) (x t)‖ ^ 2
          - ∑ t ∈ Finset.Ico 1 T, (1 - ρ) / (2 * η) * ‖p t - p (t + 1)‖ ^ 2) := by
  sorry

