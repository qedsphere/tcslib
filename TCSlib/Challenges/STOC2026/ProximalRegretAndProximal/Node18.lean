/-!
## Proximal regret of Optimistic Gradient Descent

Let `𝒳 ⊆ ℝ^d` be nonempty, closed and convex. Optimistic Gradient Descent (OGD) with
non-increasing step sizes `η_1 ≥ … ≥ η_T > 0`, `w^0 ∈ 𝒳` and `g^0 = 0` plays
`x^t = Π(w^{t-1} - η_t g^{t-1})`, observes `g^t = ∇ℓ^t(x^t)`, and updates
`w^t = Π(w^{t-1} - η_t g^t)`. For a convex lower-semicontinuous `f` put
`p^t = prox_f(x^t) = argmin_{u ∈ 𝒳} f(u) + ½‖u - x^t‖²`.

Main theorem `ogd_proximal_regret`:
  `∑_t ⟨g^t, x^t - p^t⟩ ≤ (D² + 2B_f - ‖w^T - p^T‖²)/(2η_T)
     + ∑_t η_t ‖g^t - g^{t-1}‖² - ∑_t ‖x^t - w^t‖²/(2η_t)`.
`ogd_proximal_regret_const` is the sharper constant-step version, with
`D = ‖w^0 - p^1‖` and `B_f = f(p^1) - f(p^T)`.

The lemma stubs follow the reference strategy: an optimistic one-round inequality against an
arbitrary comparator, the proximal drift bridge, the weighted boundary bound and the weighted
summation by parts for function values.
-/

namespace TCSChallenge.ProximalRegretAndProximal.node_18

open Finset

/-- The ambient space `ℝ^d` with the Euclidean norm and inner product. -/
abbrev E (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- "`z = Π_𝒳(y)`": `z ∈ 𝒳` is a closest point of `𝒳` to `y` (the Euclidean projection). -/
def IsProjOnto {d : ℕ} (X : Set (E d)) (y z : E d) : Prop :=
  z ∈ X ∧ ∀ u ∈ X, ‖y - z‖ ≤ ‖y - u‖

/-- "`p = prox_f(x) := argmin_{u ∈ 𝒳} { f(u) + ½‖u - x‖² }`". -/
def IsProx {d : ℕ} (X : Set (E d)) (f : E d → ℝ) (x p : E d) : Prop :=
  p ∈ X ∧ ∀ u ∈ X, f p + (1 / 2) * ‖p - x‖ ^ 2 ≤ f u + (1 / 2) * ‖u - x‖ ^ 2

/-- The Optimistic Gradient Descent recursion for rounds `1, …, T` (0-based shift: round
`t+1` uses `w t`, `g t`, `η (t+1)`):
`x^{t+1} = Π(w^t - η_{t+1} g^t)`, `g^{t+1} = ∇ℓ^{t+1}(x^{t+1})`,
`w^{t+1} = Π(w^t - η_{t+1} g^{t+1})`, with `w^0 ∈ 𝒳` and `g^0 = 0`. -/
def IsOGDRun {d : ℕ} (X : Set (E d)) (T : ℕ) (η : ℕ → ℝ) (ℓ : ℕ → E d → ℝ)
    (x w g : ℕ → E d) : Prop :=
  w 0 ∈ X ∧ g 0 = 0 ∧
  ∀ t, t < T →
    IsProjOnto X (w t - η (t + 1) • g t) (x (t + 1)) ∧
    HasGradientAt (ℓ (t + 1)) (g (t + 1)) (x (t + 1)) ∧
    IsProjOnto X (w t - η (t + 1) • g (t + 1)) (w (t + 1))

/-- "`η_1 ≥ η_2 ≥ ⋯ ≥ η_T > 0`". -/
def StepSizes (T : ℕ) (η : ℕ → ℝ) : Prop :=
  0 < η T ∧ ∀ s t, 1 ≤ s → s ≤ t → t ≤ T → η t ≤ η s

/-! ## Lemma stubs -/

/-- Shared-anchor stability: `x^t` and `w^t` are projections of points with the same anchor
that differ by `η_t (g^t - g^{t-1})`, so `‖x^t - w^t‖ ≤ η_t ‖g^t - g^{t-1}‖`. [ProximalRegretAndProximal, node_18] -/
theorem proj_shared_anchor {d : ℕ} (X : Set (E d)) (hXc : Convex ℝ X)
    (w₀ g₀ g₁ x₁ w₁ : E d) (η : ℝ) (hη : 0 < η)
    (hx : IsProjOnto X (w₀ - η • g₀) x₁) (hw : IsProjOnto X (w₀ - η • g₁) w₁) :
    ‖x₁ - w₁‖ ≤ η * ‖g₁ - g₀‖ := by
  sorry

/-- Optimistic one-round inequality against an arbitrary comparator `u ∈ 𝒳`:
`⟨g^t, x^t - u⟩ ≤ (‖w^{t-1} - u‖² - ‖w^t - u‖²)/(2η_t) + η_t‖g^t - g^{t-1}‖²
   - (‖x^t - w^t‖² + ‖x^t - w^{t-1}‖²)/(2η_t)`. [ProximalRegretAndProximal, node_18] -/
theorem optimistic_one_round {d : ℕ} (X : Set (E d)) (hXc : Convex ℝ X)
    (w₀ g₀ g₁ x₁ w₁ u : E d) (η : ℝ) (hη : 0 < η)
    (hx : IsProjOnto X (w₀ - η • g₀) x₁) (hw : IsProjOnto X (w₀ - η • g₁) w₁)
    (hu : u ∈ X) :
    inner ℝ g₁ (x₁ - u) ≤
      (‖w₀ - u‖ ^ 2 - ‖w₁ - u‖ ^ 2) / (2 * η) + η * ‖g₁ - g₀‖ ^ 2
        - (‖x₁ - w₁‖ ^ 2 + ‖x₁ - w₀‖ ^ 2) / (2 * η) := by
  sorry

/-- Proximal drift bridge: if `p' = prox_f(x')` and `p ∈ 𝒳`, then for every `w`,
`‖w - p'‖² - ‖w - p‖² ≤ 2(f(p) - f(p')) + ‖w - x'‖²`. [ProximalRegretAndProximal, node_18] -/
theorem prox_drift_bridge {d : ℕ} (X : Set (E d)) (hXc : Convex ℝ X)
    (f : E d → ℝ) (hf : ConvexOn ℝ X f) (x' p' p w : E d)
    (hp' : IsProx X f x' p') (hp : p ∈ X) :
    ‖w - p'‖ ^ 2 - ‖w - p‖ ^ 2 ≤ 2 * (f p - f p') + ‖w - x'‖ ^ 2 := by
  sorry

/-- Weighted boundary bound: for non-increasing step sizes and `0 ≤ a_t ≤ D²`,
`a_0/(2η_1) + ∑_{t=1}^{T-1} (1/(2η_{t+1}) - 1/(2η_t)) a_t ≤ D²/(2η_T)`. [ProximalRegretAndProximal, node_18] -/
theorem weighted_boundary (T : ℕ) (hT : 1 ≤ T) (η : ℕ → ℝ) (hη : StepSizes T η)
    (a : ℕ → ℝ) (D : ℝ) (ha0 : ∀ t, t < T → 0 ≤ a t) (haD : ∀ t, t < T → a t ≤ D ^ 2) :
    a 0 / (2 * η 1) + ∑ t ∈ Ico 1 T, (1 / (2 * η (t + 1)) - 1 / (2 * η t)) * a t
      ≤ D ^ 2 / (2 * η T) := by
  sorry

/-- Weighted summation by parts for function values: if `φ_s - φ_t ≤ B` for all
`s, t ∈ [T]`, then `∑_{t=1}^{T-1} (φ_t - φ_{t+1})/η_t ≤ B/η_T`. [ProximalRegretAndProximal, node_18] -/
theorem weighted_function_values (T : ℕ) (hT : 1 ≤ T) (η : ℕ → ℝ) (hη : StepSizes T η)
    (φ : ℕ → ℝ) (B : ℝ)
    (hB : ∀ s t, 1 ≤ s → s ≤ T → 1 ≤ t → t ≤ T → φ s - φ t ≤ B) :
    ∑ t ∈ Ico 1 T, (φ t - φ (t + 1)) / η t ≤ B / η T := by
  sorry

/-! ## Main theorems -/

/-- **Proximal regret of OGD (non-increasing step sizes).** With `D ≥ ‖w^t - p^{t+1}‖`
for `0 ≤ t ≤ T-1` and `B ≥ f(p^s) - f(p^t)` for `s, t ∈ [T]`:
`∑_t ⟨∇ℓ^t(x^t), x^t - p^t⟩ ≤ (D² + 2B - ‖w^T - p^T‖²)/(2η_T)
   + ∑_t η_t‖g^t - g^{t-1}‖² - ∑_t ‖x^t - w^t‖²/(2η_t)`. [ProximalRegretAndProximal, node_18] -/
theorem ogd_proximal_regret (d : ℕ) (hd : 1 ≤ d) (X : Set (E d)) (hXne : X.Nonempty)
    (hXcl : IsClosed X) (hXc : Convex ℝ X) (T : ℕ) (hT : 1 ≤ T) (η : ℕ → ℝ)
    (hη : StepSizes T η) (ℓ : ℕ → E d → ℝ) (hℓ : ∀ t, ConvexOn ℝ X (ℓ t))
    (x w g p : ℕ → E d) (hrun : IsOGDRun X T η ℓ x w g)
    (f : E d → ℝ) (hfl : LowerSemicontinuousOn f X) (hfc : ConvexOn ℝ X f)
    (hp : ∀ t, 1 ≤ t → t ≤ T → IsProx X f (x t) (p t))
    (D B : ℝ) (hD : ∀ t, t < T → ‖w t - p (t + 1)‖ ≤ D)
    (hB : ∀ s t, 1 ≤ s → s ≤ T → 1 ≤ t → t ≤ T → f (p s) - f (p t) ≤ B) :
    ∑ t ∈ Icc 1 T, inner ℝ (g t) (x t - p t) ≤
      (D ^ 2 + 2 * B - ‖w T - p T‖ ^ 2) / (2 * η T)
        + ∑ t ∈ Icc 1 T, η t * ‖g t - g (t - 1)‖ ^ 2
        - ∑ t ∈ Icc 1 T, ‖x t - w t‖ ^ 2 / (2 * η t) := by
  sorry

/-- **Constant step size.** If `η_t = η > 0` for all `t`, the same bound holds with
`D = ‖w^0 - p^1‖` and `B_f = f(p^1) - f(p^T)`. [ProximalRegretAndProximal, node_18] -/
theorem ogd_proximal_regret_const (d : ℕ) (hd : 1 ≤ d) (X : Set (E d)) (hXne : X.Nonempty)
    (hXcl : IsClosed X) (hXc : Convex ℝ X) (T : ℕ) (hT : 1 ≤ T) (η₀ : ℝ) (hη₀ : 0 < η₀)
    (ℓ : ℕ → E d → ℝ) (hℓ : ∀ t, ConvexOn ℝ X (ℓ t))
    (x w g p : ℕ → E d) (hrun : IsOGDRun X T (fun _ => η₀) ℓ x w g)
    (f : E d → ℝ) (hfl : LowerSemicontinuousOn f X) (hfc : ConvexOn ℝ X f)
    (hp : ∀ t, 1 ≤ t → t ≤ T → IsProx X f (x t) (p t)) :
    ∑ t ∈ Icc 1 T, inner ℝ (g t) (x t - p t) ≤
      (‖w 0 - p 1‖ ^ 2 + 2 * (f (p 1) - f (p T)) - ‖w T - p T‖ ^ 2) / (2 * η₀)
        + ∑ t ∈ Icc 1 T, η₀ * ‖g t - g (t - 1)‖ ^ 2
        - ∑ t ∈ Icc 1 T, ‖x t - w t‖ ^ 2 / (2 * η₀) := by
  sorry

end TCSChallenge.ProximalRegretAndProximal.node_18
