/-!
## Hidden-stable min-ratio cycles: static core

A directed multigraph with edge type `E` and vertex type `V` carries gradients `g`,
positive lengths `ℓ`, and (hidden) a circulation `c` with widths `w` such that
`|ℓ_e c_e| ≤ w_e` and `⟨g, c⟩ ≤ -α ‖w‖₁`. The paper's dynamic data structure returns
a nonzero cycle circulation `Δ` with `⟨g, Δ⟩ / ‖LΔ‖₁ ≤ -κ α`,
`κ = exp(-O(log^{17/18} m · log log m))`.

We state the static combinatorial core (main theorem `exists_kappa_good_cycle`) together
with stubs for the analytic devices of the proof strategy: the edgewise average-stretch
good-branch lemma, the hidden-stability width split at a checkpoint, the ratio transfer
from the hierarchy guarantee plus a propagated-width bound (with orientation), and the
depth choice `d = ⌈log^{1/18} m⌉` giving `log k ≤ log^{17/18} m`.
-/

namespace TCSChallenge.ADeterministicAlmostLinear.node_09

/-- A directed multigraph: each edge `e` has a fixed orientation `tail e → head e`
("Fix orientations for interpreting signed flows"). -/
structure DiGraph (V E : Type) where
  tail : E → V
  head : E → V

/-- Net outflow at `v`, i.e. the `v`-coordinate of `Bᵀ f`. -/
def netOut {V E : Type} [DecidableEq V] [Fintype E] (G : DiGraph V E) (f : E → ℝ)
    (v : V) : ℝ :=
  ∑ e, ((if G.tail e = v then f e else 0) - (if G.head e = v then f e else 0))

/-- "call a vector a circulation if it is annihilated by `Bᵀ`". -/
def IsCirculation {V E : Type} [DecidableEq V] [Fintype E] (G : DiGraph V E)
    (f : E → ℝ) : Prop :=
  ∀ v, netOut G f v = 0

/-- `⟨g, f⟩`. -/
def gdot {E : Type} [Fintype E] (g f : E → ℝ) : ℝ := ∑ e, g e * f e

/-- `‖L f‖₁ = Σ_e |ℓ_e f_e|`. -/
def lenL1 {E : Type} [Fintype E] (ℓ f : E → ℝ) : ℝ := ∑ e, |ℓ e * f e|

/-- Hidden witness: "`|ℓ_e c_e| ≤ w_e`, `⟨g, c⟩ ≤ -α ‖w‖₁`" with `c` a circulation and
`w` positive. -/
def HiddenWitness {V E : Type} [DecidableEq V] [Fintype E] (G : DiGraph V E)
    (g ℓ : E → ℝ) (α : ℝ) (c w : E → ℝ) : Prop :=
  IsCirculation G c ∧ (∀ e, 0 < w e) ∧ (∀ e, |ℓ e * c e| ≤ w e) ∧
    gdot g c ≤ -α * ∑ e, w e

/-- A signed closed walk using `n` distinct edges: edge `es i` is traversed from
`p i.castSucc` to `p i.succ`, forward if `sg i = true` and backward otherwise.
Proof-free data; validity is the separate predicate `CycleWalk.Valid`. -/
structure CycleWalk (V E : Type) where
  n : ℕ
  es : Fin n → E
  sg : Fin n → Bool
  p : Fin (n + 1) → V

/-- Validity of a signed cycle: nonempty, edge-simple, closed, consistently oriented. -/
def CycleWalk.Valid {V E : Type} (G : DiGraph V E) (C : CycleWalk V E) : Prop :=
  1 ≤ C.n ∧ Function.Injective C.es ∧ C.p 0 = C.p (Fin.last C.n) ∧
    ∀ i : Fin C.n,
      if C.sg i = true then
        G.tail (C.es i) = C.p i.castSucc ∧ G.head (C.es i) = C.p i.succ
      else
        G.head (C.es i) = C.p i.castSucc ∧ G.tail (C.es i) = C.p i.succ

/-- The ±1 flow vector of a signed cycle. -/
def CycleWalk.toVec {V E : Type} [DecidableEq E] (C : CycleWalk V E) (e : E) : ℝ :=
  ∑ i : Fin C.n, if C.es i = e then (if C.sg i = true then (1 : ℝ) else -1) else 0

/-- "nonzero cycle circulation": the flow vector of a valid signed cycle. -/
def IsCycleCirculation {V E : Type} [DecidableEq E] (G : DiGraph V E) (Δ : E → ℝ) :
    Prop :=
  ∃ C : CycleWalk V E, C.Valid G ∧ Δ = C.toVec

/-- The paper's approximation factor `κ = exp(-C log^{17/18} m · log log m)` for an
explicit constant `C` (the `O(·)` constant). -/
def kappa (C : ℝ) (m : ℕ) : ℝ :=
  Real.exp (-(C * Real.log (m : ℝ) ^ ((17 : ℝ) / 18) * Real.log (Real.log (m : ℝ))))

