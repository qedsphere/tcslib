/-- A signed cycle's vector is a nonzero circulation. [ADeterministicAlmostLinear, node_09] -/
theorem cycle_toVec_isCirculation {V E : Type} [DecidableEq V] [DecidableEq E]
    [Fintype E] (G : DiGraph V E) (C : CycleWalk V E) (hC : C.Valid G) :
