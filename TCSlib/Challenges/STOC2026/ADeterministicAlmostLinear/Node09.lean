/-- Average stretch gives a good branch for any FIXED (checkpoint) weighting:
"`ρ_{e,j} ≥ 1`, `(1/k) Σ_j ρ_{e,j} ≤ P`" implies some `j` has
`Σ_e ρ_{e,j} w_e ≤ P ‖w‖₁`. (It does not identify `j` observably.) [ADeterministicAlmostLinear, node_09] -/
theorem average_stretch_good_branch {E : Type} [Fintype E] (k : ℕ) (hk : 1 ≤ k)
    (ρ : E → Fin k → ℝ) (P : ℝ) (hP : ∀ e, (1 / (k : ℝ)) * ∑ j, ρ e j ≤ P)
    (w : E → ℝ) (hw : ∀ e, 0 ≤ w e) :
    ∃ j : Fin k, ∑ e, ρ e j * w e ≤ P * ∑ e, w e := by
  sorry

/-- Hidden-stability split at a historical checkpoint `u`: edges surviving since `u`
satisfy `w_e^{(t)} ≤ 2 w_e^{(u)}`, edges inserted later have stretch overestimate one;
so the current weighted stretch is at most twice the checkpoint weighted stretch on
survivors plus the current mass of new edges. [ADeterministicAlmostLinear, node_09] -/
theorem hidden_stability_split {E : Type} [Fintype E]
    (surv : E → Prop) [DecidablePred surv] (ρ wt wu : E → ℝ)
    (hρ : ∀ e, 1 ≤ ρ e) (hnew : ∀ e, ¬ surv e → ρ e = 1)
    (hstab : ∀ e, surv e → wt e ≤ 2 * wu e) (hwt : ∀ e, 0 ≤ wt e) :
    ∑ e, ρ e * wt e ≤
      2 * (∑ e ∈ Finset.univ.filter surv, ρ e * wu e) +
        ∑ e ∈ Finset.univ.filter (fun e => ¬ surv e), wt e := by
  sorry

/-- Ratio transfer with orientation. The hierarchy guarantee
`|⟨g,Δ⟩| / ‖LΔ‖₁ ≥ |⟨g,c⟩| / (K · M)` (with `M = Σ_i ‖w^{G_i}‖₁`), combined with a
propagated-width bound `M ≤ B ‖w‖₁` and the hidden witness, yields an orientation
`s ∈ {1, -1}` with `⟨g, sΔ⟩ ≤ -(α / (K B)) ‖L sΔ‖₁`. [ADeterministicAlmostLinear, node_09] -/
theorem hierarchy_ratio_transfer {V E : Type} [DecidableEq V] [Fintype E]
    (G : DiGraph V E) (g ℓ : E → ℝ) (α : ℝ) (hα : 0 < α) (c w : E → ℝ)
    (hW : HiddenWitness G g ℓ α c w) (Δ : E → ℝ) (K B M : ℝ) (hK : 0 < K) (hB : 0 < B)
    (hMpos : 0 < M) (hM : M ≤ B * ∑ e, w e)
    (hguar : |gdot g c| * lenL1 ℓ Δ ≤ |gdot g Δ| * (K * M)) :
    ∃ s : ℝ, (s = 1 ∨ s = -1) ∧
      gdot g (fun e => s * Δ e) ≤ -(α / (K * B)) * lenL1 ℓ (fun e => s * Δ e) := by
  sorry

/-- Depth choice: with `d = ⌈log^{1/18} m⌉` and `k = m^{1/d}`,
`log k ≤ log^{17/18} m`. [ADeterministicAlmostLinear, node_09] -/
theorem depth_choice (m : ℕ) (hm : 3 ≤ m) :
    Real.log ((m : ℝ) ^ ((1 : ℝ) / (⌈Real.log (m : ℝ) ^ ((1 : ℝ) / 18)⌉₊ : ℝ))) ≤
      Real.log (m : ℝ) ^ ((17 : ℝ) / 18) := by
  sorry

/-! ## Main theorem (static core) -/

/-- Static core of the returned-cycle guarantee: under the hidden-witness promise with
positive lengths, there is a nonzero cycle circulation `Δ` with
`⟨g, Δ⟩ ≤ -κ α ‖LΔ‖₁`, for the paper's `κ = exp(-C log^{17/18} m log log m)` (any
`C ≥ 0`, `|E| ≤ m`, `m ≥ 3`). [ADeterministicAlmostLinear, node_09] -/
theorem exists_kappa_good_cycle {V E : Type} [DecidableEq V] [DecidableEq E] [Fintype E]
    [Nonempty E] (G : DiGraph V E) (m : ℕ) (hm : 3 ≤ m) (hE : Fintype.card E ≤ m)
    (g ℓ : E → ℝ) (hℓ : ∀ e, 0 < ℓ e) (α : ℝ) (hα : 0 < α) (c w : E → ℝ)
    (hW : HiddenWitness G g ℓ α c w) (C : ℝ) (hC : 0 ≤ C) :
    ∃ Δ : E → ℝ, IsCycleCirculation G Δ ∧
      gdot g Δ ≤ -(kappa C m * α) * lenL1 ℓ Δ := by
  sorry

