/-!
## Dyadic-degree expander hierarchies from a partitioning routine

Let `G = (V, E)` be a simple graph with `n = |V| ≥ 2` and `m = |E|`. Using only a routine
that splits any multigraph with `M` edges into `b(M)`-expanders with at most `M/4`
crossing edges, partition `E` into levels `E(G_0), …, E(G_ℓ)`, `ℓ = O(log n)`, with
`|E(G_i)| ≤ 2^i n`, and such that for `i > 0` every connected component `X` of `G_i`
containing an edge induces a `φ`-expander of minimum degree `≥ φ 2^i`, for one common
`φ = Ω̃(exp(-(log(m+2))^{2/3}))`.

Main theorems: `decomposition_with_routine_parameter` (with `φ = b c C (4m)`) and
`expander_hierarchy` (with `φ = b c' C' m` for new constants).
-/

namespace TCSChallenge.ADeterministicAlmostLinear.node_29

/-- An undirected multigraph on vertex type `W`, allowing loops and parallel edges, given
by its edge list (each entry an unordered pair; `s(v, v)` is a loop). -/
abbrev Multigraph (W : Type) := List (Sym2 W)

/-- Number of incidences of the edge `e` at `v`: a loop at `v` counts twice. -/
def incid {W : Type} (v : W) (e : Sym2 W) : ℕ :=
  if e = Sym2.mk (v, v) then 2 else if v ∈ e then 1 else 0

/-- "degrees count edge incidences". -/
def deg {W : Type} (H : Multigraph W) (v : W) : ℕ :=
  (H.map (incid v)).sum

/-- `vol_H(S) = ∑_{v∈S} deg_H(v)`. -/
def vol {W : Type} (H : Multigraph W) (S : Finset W) : ℕ :=
  ∑ v ∈ S, deg H v

/-- The edge `e` has exactly one endpoint in `S`. -/
def Crosses {W : Type} (S : Finset W) (e : Sym2 W) : Prop :=
  ∃ x y : W, e = Sym2.mk (x, y) ∧ x ∈ S ∧ y ∉ S

/-- `|δ_H(S)|`: "the edges with exactly one endpoint in S, counted with multiplicity". -/
def cut {W : Type} (H : Multigraph W) (S : Finset W) : ℕ :=
  H.countP (fun e => decide (Crosses S e))

/-- `H[B]`: the edges of `H` (with multiplicity, loops included) with both endpoints in `B`. -/
def induce {W : Type} (H : Multigraph W) (B : Finset W) : Multigraph W :=
  H.filter (fun e => decide (∀ x : W, x ∈ e → x ∈ B))

/-- `H[B]` is a `φ`-expander: `|δ(S)| ≥ φ min{vol(S), vol(B \ S)}` for every `S ⊆ B`,
degrees and cuts taken in `H[B]`. -/
def IsExpanderOn {W : Type} (H : Multigraph W) (B : Finset W) (φ : ℝ) : Prop :=
  ∀ S : Finset W, S ⊆ B →
    φ * min ((vol (induce H B) S : ℕ) : ℝ) ((vol (induce H B) (B \ S) : ℕ) : ℝ)
      ≤ ((cut (induce H B) S : ℕ) : ℝ)

/-- No isolated vertices (the vertex set of `H` is all of `W`). -/
def NoIsolated {W : Type} (H : Multigraph W) : Prop :=
  ∀ v : W, 0 < deg H v

/-- A vertex partition given by a labelling `p : W → W`; the part containing `w`. -/
def part {W : Type} [Fintype W] (p : W → W) (w : W) : Finset W :=
  Finset.univ.filter (fun v => p v = p w)

/-- The edge `e` joins two distinct parts of the partition `p`. -/
def CrossesPartition {W : Type} (p : W → W) (e : Sym2 W) : Prop :=
  ∃ x y : W, e = Sym2.mk (x, y) ∧ p x ≠ p y

/-- The routine's expansion guarantee, made concrete:
`b(M) = c (log(M+2))^{-C} exp(-(log(M+2))^{2/3})` ("`Ω̃(exp(−(log(M+2))^(2/3)))`"). -/
def b (c C : ℝ) (M : ℕ) : ℝ :=
  c * (Real.log ((M : ℝ) + 2)) ^ (-C) * Real.exp (-((Real.log ((M : ℝ) + 2)) ^ ((2 : ℝ) / 3)))

/-- The allowed partitioning routine (running time dropped): "On any unweighted undirected
multigraph H with M ≥ 1 edges and no isolated vertices, it returns a vertex partition P such
that at most M/4 edges join distinct parts and every H[B], B ∈ P, has expansion at least
`b(M)`." -/
def PartitionSpec (c C : ℝ) : Prop :=
  ∀ (W : Type) [Fintype W] (H : Multigraph W), 1 ≤ H.length → NoIsolated H →
    ∃ p : W → W,
      4 * H.countP (fun e => decide (CrossesPartition p e)) ≤ H.length ∧
      ∀ w : W, IsExpanderOn H (part p w) (b c C H.length)

/-- `s` self-loops at every vertex of `W` (the auxiliary construction). -/
def addLoops {W : Type} [Fintype W] (s : ℕ) : Multigraph W :=
  (Finset.univ : Finset W).toList.flatMap (fun v => List.replicate s (Sym2.mk (v, v)))

/-- The edges of `G` assigned to level `i`, as an edge list. -/
def levelEdges {V : Type} [Fintype V] (G : SimpleGraph V) (level : Sym2 V → ℕ) (i : ℕ) :
    Multigraph V :=
  (G.edgeFinset.filter (fun e => level e = i)).toList

/-- The graph `G_i` on the common vertex set `V`. -/
def levelGraph {V : Type} (G : SimpleGraph V) (level : Sym2 V → ℕ) (i : ℕ) : SimpleGraph V :=
  SimpleGraph.fromEdgeSet {e | e ∈ G.edgeSet ∧ level e = i}

/-- The vertex set of the connected component of `H` containing `u`. -/
def compOf {V : Type} [Fintype V] (H : SimpleGraph V) (u : V) : Finset V :=
  Finset.univ.filter (fun x => H.Reachable u x)

/-- The required decomposition. The map `level` assigns each edge of `G` to exactly one of
`E(G_0), …, E(G_ℓ)` (so the level sets partition `E`), with `|E(G_i)| ≤ 2^i n`, and for
`i > 0`, every component `X` of `G_i` containing an edge satisfies "`G_i[X]` is a
`φ`-expander" and "`min_{x∈X} deg_{G_i}(x) ≥ φ 2^i`". -/
def IsLevelDecomposition {V : Type} [Fintype V] (G : SimpleGraph V) (ℓ : ℕ)
    (level : Sym2 V → ℕ) (φ : ℝ) : Prop :=
  (∀ e ∈ G.edgeSet, level e ≤ ℓ) ∧
  (∀ i, i ≤ ℓ → (G.edgeFinset.filter (fun e => level e = i)).card ≤ 2 ^ i * Fintype.card V) ∧
  (∀ i, 0 < i → i ≤ ℓ → ∀ u v : V, (levelGraph G level i).Adj u v →
    IsExpanderOn (levelEdges G level i) (compOf (levelGraph G level i) u) φ ∧
    ∀ x ∈ compOf (levelGraph G level i) u,
      φ * (2 : ℝ) ^ i ≤ ((deg (levelEdges G level i) x : ℕ) : ℝ))

/-! ## Lemma stubs (rubric items) -/

/-- Loops never cross a cut. [ADeterministicAlmostLinear, node_29] -/
theorem cut_append_loops {W : Type} (H L : Multigraph W) (S : Finset W)
    (hL : ∀ e ∈ L, e.IsDiag) :
    cut (H ++ L) S = cut H S := by
  sorry

/-- Removing only loops preserves the expansion inequality (volumes drop, cuts unchanged). [ADeterministicAlmostLinear, node_29] -/
theorem isExpanderOn_of_remove_loops {W : Type} (H L : Multigraph W) (B : Finset W) (φ : ℝ)
    (hφ : 0 ≤ φ) (hL : ∀ e ∈ L, e.IsDiag) (h : IsExpanderOn (H ++ L) B φ) :
    IsExpanderOn H B φ := by
  sorry

/-- Residual invariant: if `|E(R)| ≤ s n` and the partition of `H = R + (s loops per vertex)`
has at most `|E(H)|/4` crossing edges, then at most `s n / 2` edges of `R` cross it. [ADeterministicAlmostLinear, node_29] -/
theorem residual_bound {W : Type} [Fintype W] (R : Multigraph W) (s : ℕ) (p : W → W)
    (hR : R.length ≤ s * Fintype.card W)
    (hcross : 4 * (R ++ addLoops s).countP (fun e => decide (CrossesPartition p e))
      ≤ (R ++ addLoops s).length) :
    2 * R.countP (fun e => decide (CrossesPartition p e)) ≤ s * Fintype.card W := by
  sorry

/-- Degree from a singleton cut: in a part `B` with `|B| ≥ 2` of the loop-padded graph,
both sides of `{v}` have padded volume `≥ 2s`, so `deg_{R[B]}(v) ≥ 2 s φ`. [ADeterministicAlmostLinear, node_29] -/
theorem degree_lower_bound {W : Type} [Fintype W] (R : Multigraph W) (s : ℕ) (B : Finset W)
    (φ : ℝ) (hφ : 0 ≤ φ) (hR : ∀ e ∈ R, ¬ e.IsDiag)
    (hexp : IsExpanderOn (R ++ addLoops s) B φ) (hB : 2 ≤ B.card) (v : W) (hv : v ∈ B) :
    φ * (2 * s : ℝ) ≤ ((deg (induce R B) v : ℕ) : ℝ) := by
  sorry

/-- Non-singleton parts of the loop-padded graph induce connected graphs: every nonempty
proper subset has a crossing edge of `R[B]`. [ADeterministicAlmostLinear, node_29] -/
theorem part_connected {W : Type} [Fintype W] (R : Multigraph W) (s : ℕ) (B : Finset W)
    (φ : ℝ) (hφ : 0 < φ) (hs : 0 < s) (hexp : IsExpanderOn (R ++ addLoops s) B φ)
    (S : Finset W) (hSB : S ⊆ B) (hS : S.Nonempty) (hSB' : (B \ S).Nonempty) :
    0 < cut (induce R B) S := by
  sorry

/-- Number of levels: with `ℓ = ⌈log₂ ⌈m/n⌉⌉` and `2m ≤ n(n-1)`, `ℓ ≤ ⌈log₂ n⌉`. [ADeterministicAlmostLinear, node_29] -/
theorem levels_le (n m : ℕ) (hn : 2 ≤ n) (hm : 2 * m ≤ n * (n - 1)) :
    Nat.clog 2 ((m + n - 1) / n) ≤ Nat.clog 2 n := by
  sorry

/-- `b(4m) = Ω̃(exp(-(log(m+2))^{2/3}))`, with new universal constants. [ADeterministicAlmostLinear, node_29] -/
theorem b_four_mul_ge (c C : ℝ) (hc : 0 < c) (hC : 0 ≤ C) :
    ∃ c' : ℝ, 0 < c' ∧ ∃ C' : ℝ, 0 ≤ C' ∧ ∀ m : ℕ, b c' C' m ≤ b c C (4 * m) := by
  sorry

/-! ## Main theorems -/

/-- The decomposition exists with the common parameter `φ = b(4m)`. [ADeterministicAlmostLinear, node_29] -/
theorem decomposition_with_routine_parameter (c C : ℝ) (hc : 0 < c) (hC : 0 ≤ C)
    (hprim : PartitionSpec c C) (V : Type) [Fintype V] (G : SimpleGraph V)
    (hn : 2 ≤ Fintype.card V) :
    ∃ (ℓ : ℕ) (level : Sym2 V → ℕ), ℓ ≤ Nat.clog 2 (Fintype.card V) ∧
      IsLevelDecomposition G ℓ level (b c C (4 * G.edgeFinset.card)) := by
  sorry

/-- Main theorem: for universal constants `c' > 0, C' ≥ 0` (depending only on the routine's
constants), every simple graph with `n ≥ 2` has the level decomposition with
`ℓ ≤ ⌈log₂ n⌉` and the common parameter `φ = c' (log(m+2))^{-C'} exp(-(log(m+2))^{2/3})`. [ADeterministicAlmostLinear, node_29] -/
theorem expander_hierarchy (c C : ℝ) (hc : 0 < c) (hC : 0 ≤ C) (hprim : PartitionSpec c C) :
    ∃ c' : ℝ, 0 < c' ∧ ∃ C' : ℝ, 0 ≤ C' ∧
      ∀ (V : Type) [Fintype V] (G : SimpleGraph V), 2 ≤ Fintype.card V →
        ∃ (ℓ : ℕ) (level : Sym2 V → ℕ), ℓ ≤ Nat.clog 2 (Fintype.card V) ∧
          IsLevelDecomposition G ℓ level (b c' C' G.edgeFinset.card) := by
  sorry

