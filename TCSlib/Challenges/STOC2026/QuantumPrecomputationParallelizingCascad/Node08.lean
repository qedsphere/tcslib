/-!
## Parallelizing cascade circuits with clean ancillae (node_08)

Qubits `q_0, …, q_{km}`; block `i` (0-based here, `i : Fin m`) has control `c_i = q_{ik}`
and data `B_i = (q_{ik+1}, …, q_{ik+k})`, and
`V_i = |0⟩⟨0|_{c_i} ⊗ U_0^{(i)} + |1⟩⟨1|_{c_i} ⊗ U_1^{(i)}`; the cascade is
`C(U) = V_{m-1} ⋯ V_0`.

Quantum circuits (QNC) are lists of layers of arbitrary one- and two-qubit unitary gates on
pairwise disjoint qubits (all-to-all connectivity); depth = number of layers. A circuit on
`data ⊕ Fin a` *cleanly implements* `C` if it maps `|ψ⟩|0^a⟩ ↦ (C|ψ⟩)|0^a⟩` for every `ψ`.

Main theorems:
* `cascade_exact_parallelization` (part (a)): depth `O(4^k + m k)`, at most `m 2^{k+1}` ancillae.
* `cascade_approx_parallelization` (part (b)): `ε`-approximation in operator norm with depth
  `O(4^k + m log log(m/ε))` and at most `4 m r` ancillae, `r = Θ(log(m/ε))`.
-/

namespace TCSChallenge.QuantumPrecomputationParallelizingCascad.node_08

/-! ## Linear-algebra preliminaries -/

/-- Euclidean norm of a vector of amplitudes (the Pi-type norm in Mathlib is the sup norm). -/
def vecNorm {ι : Type} [Fintype ι] (v : ι → ℂ) : ℝ :=
  Real.sqrt (∑ x, Complex.normSq (v x))

/-- `‖A‖_∞ ≤ ε` for the operator (spectral) norm: `‖A v‖₂ ≤ ε ‖v‖₂` for every `v`. -/
def OpNormLe {ι : Type} [Fintype ι] (A : Matrix ι ι ℂ) (ε : ℝ) : Prop :=
  ∀ v : ι → ℂ, vecNorm (A *ᵥ v) ≤ ε * vecNorm v

/-- A unitary matrix. -/
def IsUnitary {ι : Type} [Fintype ι] [DecidableEq ι] (A : Matrix ι ι ℂ) : Prop :=
  A ∈ Matrix.unitaryGroup ι ℂ

/-- Ordered product `A_{N-1} ⋯ A_1 A_0` (the factor `A_0` acts first). -/
def orderedProd {ι : Type} [Fintype ι] [DecidableEq ι] {N : ℕ} (A : Fin N → Matrix ι ι ℂ) :
    Matrix ι ι ℂ :=
  (List.ofFn A).foldl (fun acc M => M * acc) 1

/-- Computational basis vector `|y⟩`. -/
def basisVec {ι : Type} [DecidableEq ι] (y : ι) : ι → ℂ :=
  fun z => if z = y then 1 else 0

/-! ## The circuit model (QNC with all-to-all connectivity) -/

/-- A one-qubit operator `u` acting on qubit `a` of a register with qubit set `Q`. -/
def oneQubitOp {Q : Type} (a : Q) (u : Matrix Bool Bool ℂ) :
    Matrix (Q → Bool) (Q → Bool) ℂ :=
  fun x y => if (∀ j, j ≠ a → x j = y j) then u (x a) (y a) else 0

/-- A two-qubit operator `u` acting on qubits `(a, b)`. -/
def twoQubitOp {Q : Type} (a b : Q) (u : Matrix (Bool × Bool) (Bool × Bool) ℂ) :
    Matrix (Q → Bool) (Q → Bool) ℂ :=
  fun x y => if (∀ j, j ≠ a → j ≠ b → x j = y j) then u (x a, x b) (y a, y b) else 0

/-- "arbitrary one- and two-qubit gates". -/
inductive Gate (Q : Type) where
  | one (a : Q) (u : Matrix Bool Bool ℂ)
  | two (a b : Q) (u : Matrix (Bool × Bool) (Bool × Bool) ℂ)

/-- Qubits touched by a gate. -/
def Gate.support {Q : Type} [DecidableEq Q] : Gate Q → Finset Q
  | .one a _ => {a}
  | .two a b _ => {a, b}

/-- A gate is well formed if its matrix is unitary (and a two-qubit gate acts on two distinct qubits). -/
def Gate.WellFormed {Q : Type} : Gate Q → Prop
  | .one _ u => IsUnitary u
  | .two a b u => a ≠ b ∧ IsUnitary u

/-- The matrix of a gate on the whole register. -/
def Gate.mat {Q : Type} : Gate Q → Matrix (Q → Bool) (Q → Bool) ℂ
  | .one a u => oneQubitOp a u
  | .two a b u => twoQubitOp a b u

/-- A layer: gates on pairwise disjoint qubits (depth one). -/
abbrev Layer (Q : Type) := List (Gate Q)

/-- Layer validity: well-formed gates with pairwise disjoint supports. -/
def Layer.Valid {Q : Type} [DecidableEq Q] (L : Layer Q) : Prop :=
  (∀ g ∈ L, g.WellFormed) ∧ L.Pairwise (fun g h => Disjoint g.support h.support)

/-- Matrix of a layer (the gates commute, the order is immaterial). -/
def Layer.mat {Q : Type} [Fintype Q] [DecidableEq Q] (L : Layer Q) :
    Matrix (Q → Bool) (Q → Bool) ℂ :=
  L.foldl (fun acc g => g.mat * acc) 1

/-- A circuit: a list of layers, the head layer applied first. -/
abbrev Circuit (Q : Type) := List (Layer Q)

/-- Every layer is valid. -/
def Circuit.Valid {Q : Type} [DecidableEq Q] (C : Circuit Q) : Prop :=
  ∀ L ∈ C, Layer.Valid L

/-- Depth = number of layers. -/
def Circuit.depth {Q : Type} (C : Circuit Q) : ℕ := C.length

/-- The unitary induced by a circuit. -/
def Circuit.mat {Q : Type} [Fintype Q] [DecidableEq Q] (C : Circuit Q) :
    Matrix (Q → Bool) (Q → Bool) ℂ :=
  C.foldl (fun acc L => Layer.mat L * acc) 1

/-- `|ψ⟩ ⊗ |0^a⟩` on data qubits `D` and `a` ancillae. -/
def withCleanAncilla {D : Type} {a : ℕ} (ψ : (D → Bool) → ℂ) : (D ⊕ Fin a → Bool) → ℂ :=
  fun z => if (∀ j : Fin a, z (Sum.inr j) = false) then ψ (fun d => z (Sum.inl d)) else 0

/-- "every clean ancilla must be returned to `|0⟩`": `W (|ψ⟩|0^a⟩) = (C|ψ⟩)|0^a⟩` for all `ψ`;
then `W` induces the operator `C` on the data qubits. -/
def ImplementsCleanly {D : Type} [Fintype D] [DecidableEq D] {a : ℕ}
    (W : Matrix (D ⊕ Fin a → Bool) (D ⊕ Fin a → Bool) ℂ) (C : Matrix (D → Bool) (D → Bool) ℂ) :
    Prop :=
  ∀ ψ : (D → Bool) → ℂ, W *ᵥ withCleanAncilla ψ = withCleanAncilla (C *ᵥ ψ)

/-! ## The cascade -/

/-- The data qubits `q_0, …, q_{km}`. -/
abbrev Data (k m : ℕ) := Fin (m * k + 1)

/-- Qubit `q_t` (the reduction mod `mk+1` never triggers for the indices used below). -/
def qubit (k m t : ℕ) : Data k m := ⟨t % (m * k + 1), Nat.mod_lt _ (Nat.succ_pos _)⟩

/-- Control `c_i = q_{ik}` of block `i` (0-based). -/
def ctrlQ (k m : ℕ) (i : Fin m) : Data k m := qubit k m (i.val * k)

/-- `j`-th qubit of `B_i`, namely `q_{ik+j+1}` (0-based `i`, `j`). -/
def blockQ (k m : ℕ) (i : Fin m) (j : Fin k) : Data k m := qubit k m (i.val * k + j.val + 1)

/-- Final target qubit `t_i = q_{ik+k}` of block `i` (the control of block `i+1`). -/
def tgtQ (k m : ℕ) (i : Fin m) : Data k m := qubit k m (i.val * k + k)

/-- Connector qubits `q_{jk}`, `j = 0, …, m`. -/
def connQ (k m : ℕ) (j : Fin (m + 1)) : Data k m := qubit k m (j.val * k)

/-- Contents of block `B_i` in a basis state. -/
def blockVal (k m : ℕ) (x : Data k m → Bool) (i : Fin m) : Fin k → Bool :=
  fun j => x (blockQ k m i j)

/-- Contents of the address register `A_i` (first `k-1` qubits of `B_i`). -/
def addrVal (k m : ℕ) (x : Data k m → Bool) (i : Fin m) : Fin (k - 1) → Bool :=
  fun j => x (qubit k m (i.val * k + j.val + 1))

/-- `q` is a qubit of block `B_i`. -/
def InBlock (k m : ℕ) (i : Fin m) (q : Data k m) : Prop :=
  ∃ j : Fin k, q = blockQ k m i j

/-- `V_i = |0⟩⟨0|_{c_i} ⊗ U_0^{(i)} + |1⟩⟨1|_{c_i} ⊗ U_1^{(i)}`, where `Ub b = U_b^{(i)}` acts on `B_i`. -/
def ctrlBlockOp (k m : ℕ) (i : Fin m) (Ub : Bool → Matrix (Fin k → Bool) (Fin k → Bool) ℂ) :
    Matrix (Data k m → Bool) (Data k m → Bool) ℂ :=
  fun x y =>
    if (∀ q, ¬ InBlock k m i q → x q = y q) then
      Ub (x (ctrlQ k m i)) (blockVal k m x i) (blockVal k m y i)
    else 0

/-- The cascade `C(U) = V_{m-1} ⋯ V_0`; `U i b = U_b^{(i)}`. -/
def cascade (k m : ℕ) (U : Fin m → Bool → Matrix (Fin k → Bool) (Fin k → Bool) ℂ) :
    Matrix (Data k m → Bool) (Data k m → Bool) ℂ :=
  orderedProd (fun i : Fin m => ctrlBlockOp k m i (U i))

/-! ## The supplied facts -/

/-- `Λ_{c_i}(D_i)`: the diagonal `D_i = diag(d)` on `B_i`, controlled by `c_i`. -/
def ctrlDiag (k m : ℕ) (i : Fin m) (d : (Fin k → Bool) → ℂ) :
    Matrix (Data k m → Bool) (Data k m → Bool) ℂ :=
  Matrix.diagonal (fun x => if x (ctrlQ k m i) then d (blockVal k m x i) else 1)

/-- One one-qubit gate `w j` on every connector qubit `q_{jk}` (a depth-one layer). -/
def connectorLayer (k m : ℕ) (w : Fin (m + 1) → Matrix Bool Bool ℂ) :
    Matrix (Data k m → Bool) (Data k m → Bool) ℂ :=
  orderedProd (fun j : Fin (m + 1) => oneQubitOp (connQ k m j) (w j))

/-- The middle factor `K = W_m Λ_{c_{m-1}}(D_{m-1}) W_{m-1} ⋯ W_1 Λ_{c_0}(D_0) W_0`:
"an ordered cascade of m controlled diagonal gates interspersed with one-qubit gates on
connector qubits". -/
def middleCascade (k m : ℕ) (d : Fin m → (Fin k → Bool) → ℂ)
    (w : Fin (m + 1) → Fin (m + 1) → Matrix Bool Bool ℂ) :
    Matrix (Data k m → Bool) (Data k m → Bool) ℂ :=
  (List.ofFn (fun i : Fin m => i)).foldl
    (fun acc i => connectorLayer k m (w i.succ) * ctrlDiag k m i (d i) * acc)
    (connectorLayer k m (w 0))

/-- Supplied normal-form theorem: `C(U) = L K R` with ancilla-free `L, R` of depth `O(4^k)`
(constant `κ0`) and `K` a middle cascade of controlled diagonals. -/
def NormalFormFact (κ0 : ℕ) : Prop :=
  ∀ (k m : ℕ), 1 ≤ k → 1 ≤ m →
    ∀ U : Fin m → Bool → Matrix (Fin k → Bool) (Fin k → Bool) ℂ, (∀ i b, IsUnitary (U i b)) →
      ∃ (Lc Rc : Circuit (Data k m)) (d : Fin m → (Fin k → Bool) → ℂ)
        (w : Fin (m + 1) → Fin (m + 1) → Matrix Bool Bool ℂ),
        Lc.Valid ∧ Rc.Valid ∧ Lc.depth ≤ κ0 * 4 ^ k ∧ Rc.depth ≤ κ0 * 4 ^ k ∧
        (∀ i x, ‖d i x‖ = 1) ∧ (∀ j l, IsUnitary (w j l)) ∧
        cascade k m U = Lc.mat * middleCascade k m d w * Rc.mat

/-- Basis-state action `|x⟩|z⟩ ↦ |x⟩|z ⊕ f(x)⟩` (input qubits `inp`, targets `tgt`). -/
def xorMap {Q : Type} {a s : ℕ} (inp : Fin a → Q) (tgt : Fin s → Q)
    (f : (Fin a → Bool) → (Fin s → Bool)) (y : Q → Bool) : Q → Bool :=
  fun q => xor (y q) (decide (∃ j, tgt j = q ∧ f (fun l => y (inp l)) j = true))

/-- Supplied Boolean-map synthesis bound: depth `O(2^a + log(s+1))` (constant `κ1`), using the
`s` targets and `s` clean scratch qubits restored to zero. -/
def SynthesisFact (κ1 : ℕ) : Prop :=
  ∀ (Q : Type) [Fintype Q] [DecidableEq Q] (a s : ℕ) (inp : Fin a → Q) (tgt scr : Fin s → Q)
    (f : (Fin a → Bool) → (Fin s → Bool)),
    Function.Injective (Sum.elim inp (Sum.elim tgt scr)) →
    ∃ circ : Circuit Q, circ.Valid ∧ circ.depth ≤ κ1 * (2 ^ a + Nat.clog 2 (s + 1)) ∧
      ∀ y : Q → Bool, (∀ j, y (scr j) = false) →
        circ.mat *ᵥ basisVec y = basisVec (xorMap inp tgt f y)

/-! ## Rubric lemma stubs -/

/-- Phase multiplexer `M_i(β)|c, x, b⟩ = β_x^{cb} |c, x, b⟩` (with `β_x = e^{2πiα_x}`):
applies `diag(1, β_x)` to `t_i` exactly when `c_i = 1` and `A_i = x`. -/
def phaseMux (k m : ℕ) (i : Fin m) (β : (Fin (k - 1) → Bool) → ℂ) :
    Matrix (Data k m → Bool) (Data k m → Bool) ℂ :=
  Matrix.diagonal (fun x =>
    if (x (ctrlQ k m i) && x (tgtQ k m i)) = true then β (addrVal k m x i) else 1)

/-- Pauli `X`. -/
def pauliX : Matrix Bool Bool ℂ := fun b b' => if b = !b' then 1 else 0

/-- The block value `|x, b⟩` with address `x ∈ {0,1}^{k-1}` and last bit `b`. -/
def joinBlock (k : ℕ) (α : Fin (k - 1) → Bool) (b : Bool) : Fin k → Bool :=
  fun j => if h : j.val < k - 1 then α ⟨j.val, h⟩ else b

/-- Rubric 1 (diagonal reduction): `Λ_{c_i}(D_i) = M_i(θ) X_{t_i} M_i(φ) X_{t_i}`. [QuantumPrecomputationParallelizingCascad, node_08] -/
theorem ctrlDiag_eq_phaseMux (k m : ℕ) (hk : 1 ≤ k) (i : Fin m) (d : (Fin k → Bool) → ℂ) :
    ctrlDiag k m i d =
      phaseMux k m i (fun α => d (joinBlock k α true)) * oneQubitOp (tgtQ k m i) pauliX *
        phaseMux k m i (fun α => d (joinBlock k α false)) * oneQubitOp (tgtQ k m i) pauliX := by
  sorry

/-- Rubric 2/4 (phase gadget): with control `c`, target `t`, a precomputed register `P` and a
clean helper register `H` of size `s`, the phase `β_l` is applied for every `l` with `P_l = 1`
exactly when `c = t = 1`, in depth `O(log s + 1)` (Toffoli, CNOT fanout tree into `H`, parallel
controlled phases, uncomputation). One-hot `P` gives the exact multiplexer, binary `P` with
`β_j = e^{2πi 2^{-j}}` gives the truncated one. [QuantumPrecomputationParallelizingCascad, node_08] -/
theorem phase_gadget :
    ∃ κ : ℕ, ∀ (Q : Type) [Fintype Q] [DecidableEq Q] (s : ℕ) (c t : Q) (P H : Fin s → Q)
      (β : Fin s → ℂ), (∀ l, ‖β l‖ = 1) →
      Function.Injective (Sum.elim (Sum.elim (fun _ : Unit => c) (fun _ : Unit => t))
        (Sum.elim P H)) →
      ∃ circ : Circuit Q, circ.Valid ∧ circ.depth ≤ κ * (Nat.clog 2 s + 1) ∧
        ∀ y : Q → Bool, (∀ l, y (H l) = false) →
          circ.mat *ᵥ basisVec y =
            (if (y c && y t) = true then ∏ l, (if y (P l) = true then β l else 1) else 1) •
              basisVec y := by
  sorry

/-- Rubric 4 (telescoping): `‖A_{N-1}⋯A_0 − B_{N-1}⋯B_0‖ ≤ ∑_j ‖A_j − B_j‖` for unitaries. [QuantumPrecomputationParallelizingCascad, node_08] -/
theorem opNorm_telescope {ι : Type} [Fintype ι] [DecidableEq ι] (N : ℕ)
    (A B : Fin N → Matrix ι ι ℂ) (δ : Fin N → ℝ)
    (hA : ∀ j, IsUnitary (A j)) (hB : ∀ j, IsUnitary (B j))
    (h : ∀ j, OpNormLe (A j - B j) (δ j)) :
    OpNormLe (orderedProd A - orderedProd B) (∑ j, δ j) := by
  sorry

/-- Rubric 4 (diagonal error): `‖diag f − diag g‖ ≤ max_x |f x − g x|`. [QuantumPrecomputationParallelizingCascad, node_08] -/
theorem opNorm_diagonal_sub {ι : Type} [Fintype ι] [DecidableEq ι] (f g : ι → ℂ) (δ : ℝ)
    (h : ∀ x, ‖f x - g x‖ ≤ δ) :
    OpNormLe (Matrix.diagonal f - Matrix.diagonal g) δ := by
  sorry

/-- Rubric 4 (r-bit truncation): `|e^{2πiα} − e^{2πi α̂}| ≤ 2π 2^{-r}` for `α̂ = ⌊2^r α⌋ / 2^r`. [QuantumPrecomputationParallelizingCascad, node_08] -/
theorem phase_truncation (α : ℝ) (r : ℕ) :
    ‖Complex.exp (2 * Real.pi * Complex.I * (α : ℂ)) -
        Complex.exp (2 * Real.pi * Complex.I * (((⌊α * 2 ^ r⌋ : ℝ) / 2 ^ r : ℝ) : ℂ))‖ ≤
      2 * Real.pi / 2 ^ r := by
  sorry

/-! ## Main theorems -/

/-- Part (a): exact QNC implementation of `C(U)` in depth `O(4^k + mk)` with at most
`m 2^{k+1}` clean ancillae. [QuantumPrecomputationParallelizingCascad, node_08] -/
theorem cascade_exact_parallelization (κ0 κ1 : ℕ) (hNF : NormalFormFact κ0)
    (hSyn : SynthesisFact κ1) :
    ∃ κ : ℕ, ∀ (k m : ℕ), 1 ≤ k → 1 ≤ m →
      ∀ U : Fin m → Bool → Matrix (Fin k → Bool) (Fin k → Bool) ℂ, (∀ i b, IsUnitary (U i b)) →
        ∃ (a : ℕ) (circ : Circuit (Data k m ⊕ Fin a)),
          a ≤ m * 2 ^ (k + 1) ∧ circ.Valid ∧ circ.depth ≤ κ * (4 ^ k + m * k) ∧
          ImplementsCleanly circ.mat (cascade k m U) := by
  sorry

/-- Part (b): for every `0 < ε < 1` a clean QNC circuit inducing `C'` with
`‖C' − C(U)‖_∞ ≤ ε`, depth `O(4^k + m log log(m/ε))` and at most `4 m r` ancillae for some
`r = Θ(log(m/ε))`. [QuantumPrecomputationParallelizingCascad, node_08] -/
theorem cascade_approx_parallelization (κ0 κ1 : ℕ) (hNF : NormalFormFact κ0)
    (hSyn : SynthesisFact κ1) :
    ∃ κ : ℝ, 0 < κ ∧ ∀ (k m : ℕ), 1 ≤ k → 1 ≤ m →
      ∀ U : Fin m → Bool → Matrix (Fin k → Bool) (Fin k → Bool) ℂ, (∀ i b, IsUnitary (U i b)) →
        ∀ ε : ℝ, 0 < ε → ε < 1 →
          ∃ (r a : ℕ) (circ : Circuit (Data k m ⊕ Fin a))
            (C' : Matrix (Data k m → Bool) (Data k m → Bool) ℂ),
            Real.logb 2 ((m : ℝ) / ε) ≤ (r : ℝ) ∧
            (r : ℝ) ≤ κ * (1 + Real.logb 2 ((m : ℝ) / ε)) ∧
            a ≤ 4 * m * r ∧ circ.Valid ∧
            (circ.depth : ℝ) ≤
              κ * ((4 : ℝ) ^ k + (m : ℝ) * (1 + Real.logb 2 (1 + Real.logb 2 ((m : ℝ) / ε)))) ∧
            ImplementsCleanly circ.mat C' ∧
            OpNormLe (C' - cascade k m U) ε := by
  sorry

end TCSChallenge.QuantumPrecomputationParallelizingCascad.node_08
