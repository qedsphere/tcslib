/-!
## Bounded absolute influences for uniform fixed-size independent sets

Fix `Δ ≥ 3`, `λ_c = (Δ-1)^{Δ-1}/(Δ-2)^Δ`, `α_c = λ_c / (1 + (Δ+1) λ_c)`. For a graph `G`
of maximum degree `≤ Δ` on `n` vertices, `μ_{G,k}` is the uniform distribution on
independent sets of size `k`. Assuming the uniform multivariate zero-freeness of the
independence polynomial near `[0, b]` for every `b < λ_c`, the main theorem
`TCSChallenge.OptimalMixingOfThe.node_10.fixedSize_influence_bound` states: for every
`δ ∈ (0,1)` and `γ > 0` there is `C` such that for all such `G`, every integer
`γ n ≤ k ≤ (1-δ) α_c n` and every vertex `u`, both conditioning events `u ∈ J`, `u ∉ J`
have positive probability under `μ_{G,k}` and
`∑_v |P_k(v ∈ J | u ∉ J) - P_k(v ∈ J | u ∈ J)| ≤ C`.
-/

namespace TCSChallenge.OptimalMixingOfThe.node_10

/-- The tree-uniqueness threshold `λ_c = (Δ-1)^{Δ-1} / (Δ-2)^Δ`. -/
def lambdaC (Δ : ℕ) : ℝ := ((Δ : ℝ) - 1) ^ (Δ - 1) / ((Δ : ℝ) - 2) ^ Δ

/-- The critical density `α_c = λ_c / (1 + (Δ+1) λ_c)`. -/
def alphaC (Δ : ℕ) : ℝ := lambdaC Δ / (1 + ((Δ : ℝ) + 1) * lambdaC Δ)

/-- "finite simple graph of maximum degree at most Δ". -/
def MaxDegreeLE {V : Type} (G : SimpleGraph V) (Δ : ℕ) : Prop :=
  ∀ v : V, (G.neighborSet v).ncard ≤ Δ

/-- `𝓘(H)`: the independent sets of `H`, as a finset of finsets. -/
def indepSets {V : Type} [Fintype V] (G : SimpleGraph V) : Finset (Finset V) :=
  Finset.univ.filter (fun J : Finset V => G.IsIndepSet (↑J : Set V))

/-- The multivariate independence polynomial `Z_H(z) = ∑_{J ∈ 𝓘(H)} ∏_{v ∈ J} z_v`. -/
def partitionFn {V : Type} [Fintype V] (G : SimpleGraph V) (z : V → ℂ) : ℂ :=
  ∑ J ∈ indepSets G, ∏ v ∈ J, z v

/-- The supplied uniform zero-free property: for each `b ∈ (0, λ_c)` there is an open
`U_b ⊆ ℂ` containing `[0, b]` such that `Z_H(z) ≠ 0` for every finite simple graph `H` of
maximum degree at most `Δ` and all activities `z_v ∈ U_b`. -/
def ZeroFreeProperty (Δ : ℕ) : Prop :=
  ∀ b : ℝ, 0 < b → b < lambdaC Δ →
    ∃ U : Set ℂ, IsOpen U ∧ (∀ x : ℝ, 0 ≤ x → x ≤ b → (x : ℂ) ∈ U) ∧
      ∀ (W : Type) [Fintype W] (H : SimpleGraph W), MaxDegreeLE H Δ →
        ∀ z : W → ℂ, (∀ w, z w ∈ U) → partitionFn H z ≠ 0

/-- Hard-core weight `∑_{J ∈ 𝓘(G), E(J)} λ^{|J|}` of an event `E`. -/
def hcWeight {V : Type} [Fintype V] (G : SimpleGraph V) (lam : ℝ)
    (E : Finset V → Prop) : ℝ :=
  ∑ J ∈ (indepSets G).filter E, lam ^ J.card

/-- Conditional expectation `𝔼_{G,λ}[f(J) | E]` under `μ_{G,λ}(J) = λ^{|J|} / Z_G(λ)`. -/
def hcCondExp {V : Type} [Fintype V] (G : SimpleGraph V) (lam : ℝ)
    (f : Finset V → ℝ) (E : Finset V → Prop) : ℝ :=
  (∑ J ∈ (indepSets G).filter E, lam ^ J.card * f J) / hcWeight G lam E

/-- Conditional probability `ℙ_{G,λ}(A | E)`. -/
def hcCondProb {V : Type} [Fintype V] (G : SimpleGraph V) (lam : ℝ)
    (A E : Finset V → Prop) : ℝ :=
  hcWeight G lam (fun J => A J ∧ E J) / hcWeight G lam E

/-- Expected size `M_G(λ) = 𝔼_{G,λ} |J|`. -/
def hcMean {V : Type} [Fintype V] (G : SimpleGraph V) (lam : ℝ) : ℝ :=
  hcCondExp G lam (fun J => (J.card : ℝ)) (fun _ => True)

/-- Conditional variance of `|J|` under `μ_{G,λ}` given `E`. -/
def hcCondVarSize {V : Type} [Fintype V] (G : SimpleGraph V) (lam : ℝ)
    (E : Finset V → Prop) : ℝ :=
  hcCondExp G lam (fun J => (J.card : ℝ) ^ 2) E -
    (hcCondExp G lam (fun J => (J.card : ℝ)) E) ^ 2

/-- Number of independent sets of size `k` satisfying `E`. -/
def fixedCount {V : Type} [Fintype V] (G : SimpleGraph V) (k : ℕ)
    (E : Finset V → Prop) : ℕ :=
  ((indepSets G).filter (fun J => J.card = k ∧ E J)).card

/-- `ℙ_k(A | E)` under the uniform distribution `μ_{G,k}` on size-`k` independent sets. -/
def fixedCondProb {V : Type} [Fintype V] (G : SimpleGraph V) (k : ℕ)
    (A E : Finset V → Prop) : ℝ :=
  (fixedCount G k (fun J => A J ∧ E J) : ℝ) / (fixedCount G k E : ℝ)

/-- Rubric 1 (feasibility): for `k ≥ 1` and `k ≤ (1-δ) α_c n`, independent sets of size `k`
both containing and avoiding `u` exist. [OptimalMixingOfThe, node_10] -/
theorem conditioning_events_possible (Δ : ℕ) (hΔ : 3 ≤ Δ) (δ : ℝ) (hδ0 : 0 < δ)
    (hδ1 : δ < 1) {V : Type} [Fintype V] (G : SimpleGraph V) (hG : MaxDegreeLE G Δ)
    (k : ℕ) (hk1 : 1 ≤ k) (hk : (k : ℝ) ≤ (1 - δ) * alphaC Δ * (Fintype.card V : ℝ))
    (u : V) :
    0 < fixedCount G k (fun J => u ∈ J) ∧ 0 < fixedCount G k (fun J => u ∉ J) := by
  sorry

/-- Rubric 1 (activity selection): there are `0 < a ≤ b < λ_c`, depending only on
`Δ, δ, γ`, such that every admissible `(G, k)` has an activity `λ ∈ [a, b]` with
`𝔼_{G,λ}|J| = k`. [OptimalMixingOfThe, node_10] -/
theorem activity_selection (Δ : ℕ) (hΔ : 3 ≤ Δ) (δ γ : ℝ) (hδ0 : 0 < δ) (hδ1 : δ < 1)
    (hγ : 0 < γ) :
    ∃ a b : ℝ, 0 < a ∧ a ≤ b ∧ b < lambdaC Δ ∧
      ∀ (V : Type) [Fintype V] (G : SimpleGraph V), MaxDegreeLE G Δ →
        ∀ k : ℕ, γ * (Fintype.card V : ℝ) ≤ k →
          (k : ℝ) ≤ (1 - δ) * alphaC Δ * (Fintype.card V : ℝ) →
          ∃ lam : ℝ, a ≤ lam ∧ lam ≤ b ∧ hcMean G lam = k := by
  sorry

/-- Rubrics 2–3 (hard-core absolute influence bound, eq. (8)): uniformly for `λ` in a compact
subinterval of `(0, λ_c)`, the absolute influences of `u` in the hard-core model are bounded. [OptimalMixingOfThe, node_10] -/
theorem hardcore_influence_bound (Δ : ℕ) (hΔ : 3 ≤ Δ) (hZF : ZeroFreeProperty Δ)
    (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) (hb : b < lambdaC Δ) :
    ∃ B : ℝ, ∀ (V : Type) [Fintype V] (G : SimpleGraph V), MaxDegreeLE G Δ →
      ∀ (u : V) (lam : ℝ), a ≤ lam → lam ≤ b →
        ∑ v : V, |hcCondProb G lam (fun J => v ∈ J) (fun J => u ∈ J) -
                  hcCondProb G lam (fun J => v ∈ J) (fun J => u ∉ J)| ≤ B := by
  sorry

/-- Rubric 3 (conditional moments, eq. (9)): the conditional means and variances of `|J|`
given `u ∈ J` and given `u ∉ J` differ by `O(1)`. [OptimalMixingOfThe, node_10] -/
theorem conditional_moment_bounds (Δ : ℕ) (hΔ : 3 ≤ Δ) (hZF : ZeroFreeProperty Δ)
    (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) (hb : b < lambdaC Δ) :
    ∃ B₁ B₂ : ℝ, ∀ (V : Type) [Fintype V] (G : SimpleGraph V), MaxDegreeLE G Δ →
      ∀ (u : V) (lam : ℝ), a ≤ lam → lam ≤ b →
        |hcCondExp G lam (fun J => (J.card : ℝ)) (fun J => u ∈ J) -
          hcCondExp G lam (fun J => (J.card : ℝ)) (fun J => u ∉ J)| ≤ B₁ ∧
        |hcCondVarSize G lam (fun J => u ∈ J) -
          hcCondVarSize G lam (fun J => u ∉ J)| ≤ B₂ := by
  sorry

/-- Rubric 4 (point-probability stability, eqs. (10)–(11)): for `|r - 𝔼|J|| ≤ L` and `m`
large, `ℙ(|J| = r) = Θ(m^{-1/2})` and conditioning on the status of one vertex changes it by
`O(m^{-3/2})`. [OptimalMixingOfThe, node_10] -/
theorem point_probability_stability (Δ : ℕ) (hΔ : 3 ≤ Δ) (hZF : ZeroFreeProperty Δ)
    (a b L : ℝ) (ha : 0 < a) (hab : a ≤ b) (hb : b < lambdaC Δ) (hL : 0 ≤ L) :
    ∃ c C : ℝ, ∃ N : ℕ, 0 < c ∧
      ∀ (V : Type) [Fintype V] (G : SimpleGraph V), MaxDegreeLE G Δ →
        N ≤ Fintype.card V →
        ∀ (lam : ℝ), a ≤ lam → lam ≤ b → ∀ r : ℕ, |(r : ℝ) - hcMean G lam| ≤ L →
          c / Real.sqrt (Fintype.card V) ≤ hcCondProb G lam (fun J => J.card = r) (fun _ => True) ∧
          hcCondProb G lam (fun J => J.card = r) (fun _ => True) ≤
            C / Real.sqrt (Fintype.card V) ∧
          ∀ u : V,
            |hcCondProb G lam (fun J => J.card = r) (fun J => u ∈ J) -
              hcCondProb G lam (fun J => J.card = r) (fun _ => True)| ≤
                C / ((Fintype.card V : ℝ) * Real.sqrt (Fintype.card V)) ∧
            |hcCondProb G lam (fun J => J.card = r) (fun J => u ∉ J) -
              hcCondProb G lam (fun J => J.card = r) (fun _ => True)| ≤
                C / ((Fintype.card V : ℝ) * Real.sqrt (Fintype.card V)) := by
  sorry

/-- Rubrics 5–6 (fixed-size transfer, eq. (15)): at an activity whose mean size is `k`, the
fixed-size conditional marginals differ from the hard-core ones by `O(1/n)`, uniformly in
`u, v` and the conditioning event. [OptimalMixingOfThe, node_10] -/
theorem fixedSize_marginal_transfer (Δ : ℕ) (hΔ : 3 ≤ Δ) (hZF : ZeroFreeProperty Δ)
    (a b : ℝ) (ha : 0 < a) (hab : a ≤ b) (hb : b < lambdaC Δ) :
    ∃ C : ℝ, ∃ N : ℕ, ∀ (V : Type) [Fintype V] (G : SimpleGraph V), MaxDegreeLE G Δ →
      N ≤ Fintype.card V →
      ∀ (lam : ℝ), a ≤ lam → lam ≤ b → ∀ k : ℕ, hcMean G lam = k →
        ∀ u v : V,
          |fixedCondProb G k (fun J => v ∈ J) (fun J => u ∈ J) -
            hcCondProb G lam (fun J => v ∈ J) (fun J => u ∈ J)| ≤
              C / (Fintype.card V : ℝ) ∧
          |fixedCondProb G k (fun J => v ∈ J) (fun J => u ∉ J) -
            hcCondProb G lam (fun J => v ∈ J) (fun J => u ∉ J)| ≤
              C / (Fintype.card V : ℝ) := by
  sorry

/-- Main theorem: bounded absolute influences for the uniform distribution on independent
sets of a given size `γ n ≤ k ≤ (1-δ) α_c n`, together with well-definedness of both
conditioning events. [OptimalMixingOfThe, node_10] -/
theorem fixedSize_influence_bound (Δ : ℕ) (hΔ : 3 ≤ Δ) (hZF : ZeroFreeProperty Δ)
    (δ γ : ℝ) (hδ0 : 0 < δ) (hδ1 : δ < 1) (hγ : 0 < γ) :
    ∃ C : ℝ, ∀ (V : Type) [Fintype V] (G : SimpleGraph V), MaxDegreeLE G Δ →
      ∀ k : ℕ, γ * (Fintype.card V : ℝ) ≤ k →
        (k : ℝ) ≤ (1 - δ) * alphaC Δ * (Fintype.card V : ℝ) →
        ∀ u : V,
          0 < fixedCount G k (fun J => u ∈ J) ∧
          0 < fixedCount G k (fun J => u ∉ J) ∧
          ∑ v : V, |fixedCondProb G k (fun J => v ∈ J) (fun J => u ∉ J) -
                    fixedCondProb G k (fun J => v ∈ J) (fun J => u ∈ J)| ≤ C := by
  sorry

end TCSChallenge.OptimalMixingOfThe.node_10
