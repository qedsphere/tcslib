theorem su_turingReducible_le (T : ℕ) (hT : 1 < T) :
    chi (SU T) ≤ᵀ chi (LE T) := by
  sorry

/-- `LE_T ≤_T SU_T` (in fact a many-one reduction). [SUnitEquationsIn, node_06] -/
theorem le_turingReducible_su (T : ℕ) (hT : 1 < T) :
    chi (LE T) ≤ᵀ chi (SU T) := by
  sorry

/-- Main theorem: `SU_T ≡_T LE_T` for every modulus `T > 1`. [SUnitEquationsIn, node_06] -/
theorem su_turingEquivalent_le (T : ℕ) (hT : 1 < T) :
    chi (SU T) ≡ᵀ chi (LE T) := by
  sorry

