/-!
## S-unit equations over `(ℤ/Tℤ)[X₁^{±1},…,X_N^{±1}]` vs linear-exponential systems

Fix `T > 1`. The Laurent polynomial ring `R_{T,N}` is modelled as the additive monoid algebra
`AddMonoidAlgebra (ZMod T) (Fin N → ℤ)`; the monomial `X^z` is `single z 1`.
A finitely presented `R_{T,N}`-module is `M = R^g / span(relations)`, so an equation
`∑ᵢ X^{zᵢ} mᵢ = m₀` holds in `M` iff `∑ᵢ X^{zᵢ} mᵢ - m₀ ∈ span(relations)` in `R^g`.

`SU T` and `LE T` are predicates on finitary (Primcodable) instance encodings, turned into
characteristic functions `ℕ →. ℕ`; the main theorem `su_turingEquivalent_le` states
`SU_T ≡_T LE_T` using Mathlib's oracle-computability `TuringEquivalent`.
-/

namespace TCSChallenge.SUnitEquationsIn.node_06

/-! ## Encodings -/

/-- Data of a Laurent polynomial: a list of monomials (exponent list, integer coefficient).
Exponent lists are padded with `0` / truncated to length `N`; coefficients are read mod `T`. -/
abbrev LPData : Type := List (List ℤ × ℤ)

/-- An `SU_T` instance: `(N, g, relations, m₀, [m₁,…,m_K])`. `N` is the number of Laurent
variables, `g` the number of generators of the free module; each relation and each `mᵢ` is a
vector of `g` Laurent polynomials (list padded with `0`). -/
abbrev SUInstance : Type := ℕ × ℕ × List (List LPData) × List LPData × List (List LPData)

/-- An `LE_T` instance: `(d, D, [q₁,…,q_d], rows c, right-hand sides b)`; row `i` is a list
`[c_{i,1},…,c_{i,D}]` (padded with `0`), `L` is the number of rows. -/
abbrev LEInstance : Type := ℕ × ℕ × List ℕ × List (List ℤ) × List ℤ

/-- The Laurent polynomial ring `R_{T,N} = (ℤ/Tℤ)[X₁^{±1},…,X_N^{±1}]`. -/
abbrev LRing (T N : ℕ) : Type := AddMonoidAlgebra (ZMod T) (Fin N → ℤ)

/-- The Laurent monomial `X₁^{z₁}⋯X_N^{z_N}`. -/
def mono (T N : ℕ) (z : Fin N → ℤ) : LRing T N := AddMonoidAlgebra.single z 1

/-- Interpretation of Laurent polynomial data in `R_{T,N}`. -/
def interpLP (T N : ℕ) (p : LPData) : LRing T N :=
  (p.map fun mc => AddMonoidAlgebra.single (fun i : Fin N => mc.1.getD i.val 0)
    ((mc.2 : ℤ) : ZMod T)).sum

/-- Interpretation of a vector of Laurent polynomials as an element of `R_{T,N}^g`. -/
def interpVec (T N g : ℕ) (v : List LPData) : Fin g → LRing T N :=
  fun j => interpLP T N (v.getD j.val [])

/-- The relation submodule of `R^g`; the presented module is `R^g ⧸ relSubmodule`. -/
def relSubmodule (T N g : ℕ) (rels : List (List LPData)) : Submodule (LRing T N) (Fin g → LRing T N) :=
  Submodule.span (LRing T N) {x | ∃ r ∈ rels, x = interpVec T N g r}

/-- `SU_T`: "determine whether there exists `(z_{ir}) ∈ ℤ^{KN}` such that
`∑_{i=1}^K X_1^{z_{i1}}⋯X_N^{z_{iN}} mᵢ = m₀`" in the finitely presented module `M`. -/
def SU (T : ℕ) (I : SUInstance) : Prop :=
  let N := I.1
  let g := I.2.1
  let rels := I.2.2.1
  let m0 := I.2.2.2.1
  let ms := I.2.2.2.2
  ∃ z : Fin ms.length → Fin N → ℤ,
    (∑ i : Fin ms.length, mono T N (z i) • interpVec T N g (ms.get i)) - interpVec T N g m0
      ∈ relSubmodule T N g rels

/-- `LE_T`: given `d ≤ D`, primes `q₁,…,q_d` among the prime divisors of `T` (repetitions
allowed), and integers `c_{i,j}, b_i`, "determine whether the system
`∑_{j≤d} c_{i,j} q_j^{n_j} + ∑_{j>d} c_{i,j} z_j = b_i` (`1 ≤ i ≤ L`) has a solution with
`n_j ∈ ℕ`, `z_j ∈ ℤ`". The unknowns are packed into `x : Fin D → ℤ` with `x_j = q_j^{n_j}`
for `j < d`. -/
def LE (T : ℕ) (I : LEInstance) : Prop :=
  let d := I.1
  let D := I.2.1
  let qs := I.2.2.1
  let c := I.2.2.2.1
  let b := I.2.2.2.2
  d ≤ D ∧ qs.length = d ∧ (∀ q ∈ qs, q.Prime ∧ q ∣ T) ∧
  ∃ x : Fin D → ℤ,
    (∀ j : Fin D, j.val < d → ∃ n : ℕ, x j = ((qs.getD j.val 0 : ℕ) : ℤ) ^ n) ∧
    ∀ i : Fin c.length,
      ∑ j : Fin D, ((c.get i).getD j.val 0) * x j = b.getD i.val 0

/-- Characteristic function of a predicate on a `Primcodable` type, as a total element of
`ℕ →. ℕ` (codes that do not decode are mapped to `0`). -/
def chi {α : Type} [Primcodable α] (P : α → Prop) : ℕ →. ℕ :=
  fun n => Part.some
    (match Encodable.decode (α := α) n with
      | none => 0
      | some a => if P a then 1 else 0)

/-! ## Rubric lemma stubs -/

/-- Rubric 1 (prime-primary decomposition): in any `ℤ/Tℤ`-module (`T • m = 0`),
`⋂_j p_j^{e_j} M = 0`, where `T = ∏ p_j^{e_j}`. [SUnitEquationsIn, node_06] -/
theorem inter_primePower_multiples_eq_zero (T : ℕ) (hT : 1 < T)
    {M : Type} [AddCommGroup M] (hM : ∀ m : M, T • m = 0) (x : M)
    (hx : ∀ p ∈ T.primeFactors, ∃ y : M, x = (p ^ T.factorization p) • y) :
    x = 0 := by
  sorry

/-- Rubric 1, module form: the S-unit equation holds in `M` iff it holds in every
`M / p_j^{e_j} M` (membership modulo `relations + p_j^{e_j} R^g`). [SUnitEquationsIn, node_06] -/
theorem mem_rel_iff_forall_primePower (T N g : ℕ) (hT : 1 < T)
    (rels : List (List LPData)) (f : Fin g → LRing T N) :
    f ∈ relSubmodule T N g rels ↔
      ∀ p ∈ T.primeFactors,
        f ∈ relSubmodule T N g rels ⊔
          Submodule.span (LRing T N)
            {x | ∃ y : Fin g → LRing T N, x = (p ^ T.factorization p) • y} := by
  sorry

/-- Rubric 2 (divisibility encoding): for `n ∈ ℕ`, `ℓ ∣ n ⟺ p^ℓ - 1 ∣ p^n - 1`, expressed as
the linear-exponential equation `p^n - 1 + (p^ℓ - 1) y = 0` with `y ∈ ℤ`. [SUnitEquationsIn, node_06] -/
theorem dvd_iff_exists_linExp (p ℓ n : ℕ) (hp : p.Prime) (hℓ : 1 ≤ ℓ) :
    ℓ ∣ n ↔ ∃ y : ℤ, (p : ℤ) ^ n - 1 + ((p : ℤ) ^ ℓ - 1) * y = 0 := by
  sorry

/-- Rubric 3 (linear row encoding): with `g > 0`, `g ∣ c_h`, `∑ a_h c_h = g`, `g ∣ b`,
`ω = ∏ U_h^{a_h}`, in `R / (U_h - ω^{c_h/g})` one has `U^α = ω^{b/g}` iff `∑ c_h α_h = b`.
(The auxiliary variables `V_s`, set to `1` in the paper, are omitted here.) [SUnitEquationsIn, node_06] -/
theorem row_encoding (T D : ℕ) (hT : 1 < T) (c a α : Fin D → ℤ) (g b : ℤ)
    (hg : 0 < g) (hgc : ∀ h, g ∣ c h) (hbez : ∑ h, a h * c h = g) (hgb : g ∣ b) :
    (mono T D α - mono T D ((b / g) • a) ∈
        Ideal.span {x : LRing T D | ∃ h : Fin D,
          x = mono T D (Pi.single h 1) - mono T D ((c h / g) • a)}) ↔
      ∑ h, c h * α h = b := by
  sorry

/-- Rubric 4 (prime-power gadget, eq. (7)): in `𝔽_p[U^{±1},V^{±1}]/(V - U - 1)`,
`V^z - U^z = 1` iff `z ∈ p^ℕ`. Here `U = X₀`, `V = X₁` in `LRing p 2`. [SUnitEquationsIn, node_06] -/
theorem frobenius_gadget (p : ℕ) (hp : p.Prime) (z : ℤ) :
    (mono p 2 (Pi.single 1 z) - mono p 2 (Pi.single 0 z) - 1 ∈
        Ideal.span {mono p 2 (Pi.single 1 1) - mono p 2 (Pi.single 0 1) - 1}) ↔
      ∃ n : ℕ, z = (p : ℤ) ^ n := by
  sorry

