/-!
## Outerplanar DAGs have stack number at most 24776

A stack layout of a finite DAG `G` is a topological ordering `≺` of `V(G)` together with an
edge colouring in which no two edges of the same colour cross; edges `ab`, `cd` cross if
`a ≺ c ≺ b ≺ d` or `c ≺ a ≺ d ≺ b`. `sn(G)` is the least number of colours. The challenge
(`outerplanar_dag_stack_number_le`) is: every finite simple outerplanar DAG has
`sn(G) ≤ 24776 = 8 · 3097`.

A directed graph is a relation `adj : V → V → Prop` on a finite type; acyclicity forbids
loops and 2-cycles, so it is simple.
-/

namespace TCSChallenge.DirectedAcyclicOuterplanarGraphs.node_05

/-- `Crosses σ a b c d`: in the linear order given by the positions `σ`, the edges `ab` and
`cd` cross, i.e. `a ≺ c ≺ b ≺ d`. Quantifying over both ordered pairs `(ab, cd)` and
`(cd, ab)` covers the paper's second case `c ≺ a ≺ d ≺ b`. The strict inequalities force
the four endpoints to be distinct. -/
def Crosses {V : Type*} {N : ℕ} (σ : V ≃ Fin N) (a b c d : V) : Prop :=
  σ a < σ c ∧ σ c < σ b ∧ σ b < σ d

/-- A directed graph on `V` is *acyclic* if no vertex reaches itself by a nonempty directed
walk. -/
def IsAcyclic {V : Type*} (adj : V → V → Prop) : Prop :=
  ∀ v : V, ¬ Relation.TransGen adj v v

/-- "A stack layout of G consists of a topological ordering ≺ of V(G) and an edge coloring in
which no two edges of the same color cross." `HasStackLayout adj s` says such a layout with
at most `s` colors exists; `sn(G) ≤ s` is `HasStackLayout adj s`. The ordering is a
bijection `σ : V ≃ Fin |V|`; colors are assigned to edges only. -/
def HasStackLayout {V : Type*} [Fintype V] (adj : V → V → Prop) (s : ℕ) : Prop :=
  ∃ σ : V ≃ Fin (Fintype.card V),
    (∀ u v : V, adj u v → σ u < σ v) ∧
    ∃ col : (a b : V) → adj a b → Fin s,
      ∀ (a b c d : V) (hab : adj a b) (hcd : adj c d),
        col a b hab = col c d hcd → ¬ Crosses σ a b c d

/-- "A directed graph is outerplanar if its underlying undirected graph has a plane embedding
with every vertex on the outer face." We use the standard equivalent combinatorial form
(Bernhart–Kainen: outerplanar ⇔ book thickness ≤ 1): there is a linear (equivalently,
circular) order of the vertices in which no two edges of the underlying undirected graph
cross. -/
def IsOuterplanar {V : Type*} [Fintype V] (adj : V → V → Prop) : Prop :=
  ∃ σ : V ≃ Fin (Fintype.card V),
    ∀ a b c d : V, (adj a b ∨ adj b a) → (adj c d ∨ adj d c) → ¬ Crosses σ a b c d

/-- A *stacking construction history* of a monotone directed 2-tree on vertex set `Fin n`.
Vertices `0, 1` form the initial directed edge `0 → 1`; every vertex `v ≥ 2` is stacked onto
the directed edge `p v → q v` of the graph built so far. If `sink v = true` the two new edges
are `p v → v` and `q v → v`; otherwise they are `v → p v` and `v → q v` ("both directed
toward the new vertex or both directed away from it"). -/
structure StackingHistory (n : ℕ) where
  p : Fin n → Fin n
  q : Fin n → Fin n
  sink : Fin n → Bool

/-- The directed edge relation of the graph produced by a stacking history. -/
def StackingHistory.adj {n : ℕ} (H : StackingHistory n) (u w : Fin n) : Prop :=
  (u.val = 0 ∧ w.val = 1) ∨
  (2 ≤ w.val ∧ H.sink w = true ∧ (u = H.p w ∨ u = H.q w)) ∨
  (2 ≤ u.val ∧ H.sink u = false ∧ (w = H.p u ∨ w = H.q u))

/-- Validity: every stacked vertex `v ≥ 2` is stacked onto an edge `p v → q v` between
earlier vertices. Since every edge is created when its younger endpoint is stacked, the edges
among vertices `< v` are exactly the edges present before `v` is added. -/
def StackingHistory.Valid {n : ℕ} (H : StackingHistory n) : Prop :=
  2 ≤ n ∧ ∀ v : Fin n, 2 ≤ v.val → H.p v < v ∧ H.q v < v ∧ H.adj (H.p v) (H.q v)

/-- The number of vertices stacked onto the (undirected) edge `{x, y}` in the history. -/
def StackingHistory.stackCount {n : ℕ} (H : StackingHistory n) (x y : Fin n) : ℕ :=
  (Finset.univ.filter fun v : Fin n =>
    2 ≤ v.val ∧ ((H.p v = x ∧ H.q v = y) ∨ (H.p v = y ∧ H.q v = x))).card

/-- The base edge `{0, 1}` of a history on `Fin n` with `2 ≤ n`. -/
def baseCount {n : ℕ} (H : StackingHistory n) (hn : 2 ≤ n) : ℕ :=
  H.stackCount ⟨0, by omega⟩ ⟨1, by omega⟩

/-- Rubric 5 (subgraph monotonicity): restricting a stack layout to a subgraph on the same
vertex set preserves topological validity and the absence of monochromatic crossings. [DirectedAcyclicOuterplanarGraphs, node_05] -/
theorem hasStackLayout_mono {V : Type*} [Fintype V] (adj adj' : V → V → Prop)
    (hsub : ∀ u v : V, adj' u v → adj u v) (s : ℕ) (h : HasStackLayout adj s) :
    HasStackLayout adj' s := by sorry

/-- Permitted background result: an outerplanar graph built from a single edge by monotone
stackings, with at most one vertex adjoined directly to the initial edge, has `sn ≤ 64`. [DirectedAcyclicOuterplanarGraphs, node_05] -/
theorem monotone_stacked_le_64 (n : ℕ) (H : StackingHistory n) (hH : H.Valid)
    (hout : IsOuterplanar H.adj) (hbase : baseCount H hH.1 ≤ 1) :
    HasStackLayout H.adj 64 := by sorry

/-- Rubric 1: a monotone stacked outerplanar DAG (any number of vertices on the base edge
allowed) has stack number at most `128`. [DirectedAcyclicOuterplanarGraphs, node_05] -/
theorem monotone_stacked_le_128 (n : ℕ) (H : StackingHistory n) (hH : H.Valid)
    (hout : IsOuterplanar H.adj) :
    HasStackLayout H.adj 128 := by sorry

/-- Main theorem: every finite simple outerplanar directed acyclic graph satisfies
`sn(G) ≤ 24776`. [DirectedAcyclicOuterplanarGraphs, node_05] -/
theorem outerplanar_dag_stack_number_le {V : Type*} [Fintype V] (adj : V → V → Prop)
    (hacyc : IsAcyclic adj) (hout : IsOuterplanar adj) :
    HasStackLayout adj 24776 := by sorry

end TCSChallenge.DirectedAcyclicOuterplanarGraphs.node_05
