/-!
## The stack number of treewidth-2 DAGs is unbounded

For a DAG `G`, `sn(G)` is the least `s` such that for some topological ordering, `E(G)`
splits into `s` sets with no crossing pair (`a ≺ c ≺ b ≺ d` or `c ≺ a ≺ d ≺ b`).
A monotone directed 2-tree is built from a directed edge by repeatedly stacking a vertex onto
an existing edge `x → y`, the two new edges both entering or both leaving the new vertex.

Main theorem (`exists_monotone_two_tree_large_stack_number`): for every `k ≥ 1` there is an
acyclic monotone directed 2-tree `G` of treewidth 2, with a construction history stacking at
most two vertices onto each edge, such that `sn(G) ≥ k`, i.e. every stack layout of `G`
uses at least `k` colours.
-/

namespace TCSChallenge.DirectedAcyclicOuterplanarGraphs.node_06

/-- `Crosses σ a b c d`: in the linear order given by the positions `σ`, the edges `ab` and
`cd` cross, i.e. `a ≺ c ≺ b ≺ d`. Quantifying over both ordered pairs `(ab, cd)` and
`(cd, ab)` covers the paper's second case `c ≺ a ≺ d ≺ b`. The strict inequalities force
the four endpoints to be distinct. -/
def Crosses {V : Type*} {N : ℕ} (σ : V ≃ Fin N) (a b c d : V) : Prop :=
  σ a < σ c ∧ σ c < σ b ∧ σ b < σ d

/-- A directed graph on `V` is *acyclic* if no vertex reaches itself by a nonempty directed
walk. -/
def IsAcyclic {V : Type*} (adj : V → V → Prop) : Prop :=
  ∀ v : V, ¬ Relation.TransGen adj v v

/-- "A stack layout of G consists of a topological ordering ≺ of V(G) and an edge coloring in
which no two edges of the same color cross." `HasStackLayout adj s` says such a layout with
at most `s` colors exists; `sn(G) ≤ s` is `HasStackLayout adj s`. The ordering is a
bijection `σ : V ≃ Fin |V|`; colors are assigned to edges only. -/
def HasStackLayout {V : Type*} [Fintype V] (adj : V → V → Prop) (s : ℕ) : Prop :=
  ∃ σ : V ≃ Fin (Fintype.card V),
    (∀ u v : V, adj u v → σ u < σ v) ∧
    ∃ col : (a b : V) → adj a b → Fin s,
      ∀ (a b c d : V) (hab : adj a b) (hcd : adj c d),
        col a b hab = col c d hcd → ¬ Crosses σ a b c d

/-- "A directed graph is outerplanar if its underlying undirected graph has a plane embedding
with every vertex on the outer face." We use the standard equivalent combinatorial form
(Bernhart–Kainen: outerplanar ⇔ book thickness ≤ 1): there is a linear (equivalently,
circular) order of the vertices in which no two edges of the underlying undirected graph
cross. -/
def IsOuterplanar {V : Type*} [Fintype V] (adj : V → V → Prop) : Prop :=
  ∃ σ : V ≃ Fin (Fintype.card V),
    ∀ a b c d : V, (adj a b ∨ adj b a) → (adj c d ∨ adj d c) → ¬ Crosses σ a b c d

/-- A *stacking construction history* of a monotone directed 2-tree on vertex set `Fin n`.
Vertices `0, 1` form the initial directed edge `0 → 1`; every vertex `v ≥ 2` is stacked onto
the directed edge `p v → q v` of the graph built so far. If `sink v = true` the two new edges
are `p v → v` and `q v → v`; otherwise they are `v → p v` and `v → q v` ("both directed
toward the new vertex or both directed away from it"). -/
structure StackingHistory (n : ℕ) where
  p : Fin n → Fin n
  q : Fin n → Fin n
  sink : Fin n → Bool

/-- The directed edge relation of the graph produced by a stacking history. -/
def StackingHistory.adj {n : ℕ} (H : StackingHistory n) (u w : Fin n) : Prop :=
  (u.val = 0 ∧ w.val = 1) ∨
  (2 ≤ w.val ∧ H.sink w = true ∧ (u = H.p w ∨ u = H.q w)) ∨
  (2 ≤ u.val ∧ H.sink u = false ∧ (w = H.p u ∨ w = H.q u))

/-- Validity: every stacked vertex `v ≥ 2` is stacked onto an edge `p v → q v` between
earlier vertices. Since every edge is created when its younger endpoint is stacked, the edges
among vertices `< v` are exactly the edges present before `v` is added. -/
def StackingHistory.Valid {n : ℕ} (H : StackingHistory n) : Prop :=
  2 ≤ n ∧ ∀ v : Fin n, 2 ≤ v.val → H.p v < v ∧ H.q v < v ∧ H.adj (H.p v) (H.q v)

/-- The number of vertices stacked onto the (undirected) edge `{x, y}` in the history. -/
def StackingHistory.stackCount {n : ℕ} (H : StackingHistory n) (x y : Fin n) : ℕ :=
  (Finset.univ.filter fun v : Fin n =>
    2 ≤ v.val ∧ ((H.p v = x ∧ H.q v = y) ∨ (H.p v = y ∧ H.q v = x))).card

/-- "A tree decomposition consists of a tree T and sets B_t ⊆ V(H) … such that every vertex
belongs to a bag, the endpoints of every edge belong to a common bag, and {t : v ∈ B_t}
induces a connected subtree of T for every vertex v. Its width is max_t |B_t| − 1."
`HasTreeDecompOfWidth adj w`: the underlying undirected graph of `adj` has a tree
decomposition of width at most `w`. Treewidth `= w` is `HasTreeDecompOfWidth adj w ∧
¬ HasTreeDecompOfWidth adj (w - 1)`. -/
def HasTreeDecompOfWidth {V : Type*} (adj : V → V → Prop) (w : ℕ) : Prop :=
  ∃ (m : ℕ) (T : SimpleGraph (Fin m)) (B : Fin m → Finset V),
    T.IsTree ∧
    (∀ v : V, ∃ t, v ∈ B t) ∧
    (∀ u v : V, adj u v → ∃ t, u ∈ B t ∧ v ∈ B t) ∧
    (∀ v : V, (T.induce {t | v ∈ B t}).Connected) ∧
    (∀ t, (B t).card ≤ w + 1)

/-- Positions `x i < y i` of `k` edges form a *`k`-twist*: they are pairwise crossing. -/
def IsTwistPos {k : ℕ} (x y : Fin k → ℕ) : Prop :=
  ∀ i j : Fin k, i < j →
    (x i < x j ∧ x j < y i ∧ y i < y j) ∨ (x j < x i ∧ x i < y j ∧ y j < y i)

/-- Rubric 2 (Erdős–Szekeres): a sequence of distinct numbers of length greater than
`(p-1)(q-1)` has an increasing subsequence of length `p` or a decreasing one of length `q`. [DirectedAcyclicOuterplanarGraphs, node_06] -/
theorem erdos_szekeres (p q N : ℕ) (f : Fin N → ℕ) (hf : Function.Injective f)
    (hN : (p - 1) * (q - 1) < N) :
    (∃ g : Fin p → Fin N, StrictMono g ∧ StrictMono (f ∘ g)) ∨
    (∃ g : Fin q → Fin N, StrictMono g ∧ StrictAnti (f ∘ g)) := by sorry

/-- Rubric 2 (triangle obstruction): `k³` vertex-disjoint triangles with positions
`u i < v i < w i`, all `u`'s before all `v`'s before all `w`'s, contain a `k`-twist among
their `uv`-, `uw`- or `vw`-edges. [DirectedAcyclicOuterplanarGraphs, node_06] -/
theorem twist_of_separated_triangles (k : ℕ) (u v w : Fin (k ^ 3) → ℕ)
    (hu : Function.Injective u) (hv : Function.Injective v) (hw : Function.Injective w)
    (huv : ∀ i j, u i < v j) (hvw : ∀ i j, v i < w j) :
    ∃ g : Fin k → Fin (k ^ 3), Function.Injective g ∧
      (IsTwistPos (u ∘ g) (v ∘ g) ∨ IsTwistPos (u ∘ g) (w ∘ g) ∨
        IsTwistPos (v ∘ g) (w ∘ g)) := by sorry

/-- Main theorem: for every `k ≥ 1` there is an acyclic monotone directed 2-tree of treewidth
2, with a construction history in which at most two vertices are stacked onto each edge,
whose stack number is at least `k`. [DirectedAcyclicOuterplanarGraphs, node_06] -/
theorem exists_monotone_two_tree_large_stack_number (k : ℕ) (hk : 1 ≤ k) :
    ∃ (n : ℕ) (H : StackingHistory n),
      H.Valid ∧
      (∀ x y : Fin n, H.stackCount x y ≤ 2) ∧
      IsAcyclic H.adj ∧
      HasTreeDecompOfWidth H.adj 2 ∧ ¬ HasTreeDecompOfWidth H.adj 1 ∧
      ∀ s : ℕ, HasStackLayout H.adj s → k ≤ s := by sorry

end TCSChallenge.DirectedAcyclicOuterplanarGraphs.node_06
