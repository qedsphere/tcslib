/-!
## A 0.87414-approximation for MAX 2-AND from an additive rounding certificate

A constraint `D(sX_i, tX_j)` is satisfied iff `sX_i = +1` and `tX_j = −1`.  The SDP
relaxation over unit vectors uses `a_C = ⟨v_0, s v_i⟩`, `b_C = ⟨v_0, t v_j⟩`,
`d_C = ⟨s v_i, t v_j⟩`, objective `S = Σ w_C c_C` with
`c_C = (1 + a_C − b_C − d_C)/4`.  Given `R` (returning a `FinDist` on assignments) with
`Pr[R satisfies C] ≥ 0.87415 c_C − 10⁻⁶`, the combined algorithm `mixAlg R`
(one global coin: `R` with probability `1 − 10⁻⁵`, otherwise `FinDist.uniform`, i.e.
uniform independent values of the original variables) has expected value at least
`0.87414 · OPT` on every instance (`main_approx`), given an SDP solution with
`S ≥ S* − 10⁻⁶ W`.
-/

namespace TCSChallenge.SeparatingMAX2AND.node_33

/-- A weighted MAX 2-AND instance on variable type `V` with `m` constraints
`D(s_k X_{i_k}, t_k X_{j_k})`; signs are Booleans with `true = +1`. -/
structure TwoAndInst (V : Type) (m : ℕ) where
  var1 : Fin m → V
  var2 : Fin m → V
  sgn1 : Fin m → Bool
  sgn2 : Fin m → Bool
  w : Fin m → ℝ

/-- Nonnegative weights, and no identically false constraint remains
(a constraint `D(sX_i, tX_i)` with `s = t` is identically false). -/
def TwoAndInst.IsValid {V : Type} {m : ℕ} (I : TwoAndInst V m) : Prop :=
  ∀ k, 0 ≤ I.w k ∧ (I.var1 k = I.var2 k → I.sgn1 k ≠ I.sgn2 k)

/-- An assignment `X ∈ {−1,+1}^V`, with `true` standing for `+1`. -/
abbrev Assignment (V : Type) := V → Bool

/-- `D(sX_i, tX_j) = 1` iff `sX_i = +1` and `tX_j = −1`. -/
def sat {V : Type} {m : ℕ} (I : TwoAndInst V m) (x : Assignment V) (k : Fin m) : ℝ :=
  if x (I.var1 k) = I.sgn1 k ∧ x (I.var2 k) ≠ I.sgn2 k then 1 else 0

/-- Value of an assignment: total weight of satisfied constraints. -/
def val {V : Type} {m : ℕ} (I : TwoAndInst V m) (x : Assignment V) : ℝ :=
  ∑ k, I.w k * sat I x k

/-- `OPT` = maximum assignment value. -/
def OPT {V : Type} [Fintype V] {m : ℕ} (I : TwoAndInst V m) : ℝ :=
  ⨆ x : Assignment V, val I x

/-- `W` = total weight of the (remaining) constraints. -/
def totalW {V : Type} {m : ℕ} (I : TwoAndInst V m) : ℝ := ∑ k, I.w k

/-- A vector solution: `none ↦ v_0`, `some i ↦ v_i`, in `ℝ^N`. -/
abbrev VecSol (V : Type) (N : ℕ) := Option V → EuclideanSpace ℝ (Fin N)

/-- Sign of a Boolean: `true ↦ 1`, `false ↦ −1`. -/
def sgn (s : Bool) : ℝ := if s then 1 else -1

/-- `a_C = ⟨v_0, s v_i⟩`. -/
def aC {V : Type} {m N : ℕ} (I : TwoAndInst V m) (v : VecSol V N) (k : Fin m) : ℝ :=
  sgn (I.sgn1 k) * inner ℝ (v none) (v (some (I.var1 k)))

/-- `b_C = ⟨v_0, t v_j⟩`. -/
def bC {V : Type} {m N : ℕ} (I : TwoAndInst V m) (v : VecSol V N) (k : Fin m) : ℝ :=
  sgn (I.sgn2 k) * inner ℝ (v none) (v (some (I.var2 k)))

/-- `d_C = ⟨s v_i, t v_j⟩`. -/
def dC {V : Type} {m N : ℕ} (I : TwoAndInst V m) (v : VecSol V N) (k : Fin m) : ℝ :=
  sgn (I.sgn1 k) * sgn (I.sgn2 k) * inner ℝ (v (some (I.var1 k))) (v (some (I.var2 k)))

/-- Feasibility: unit vectors and
"1 + ε a_C + η b_C + εη d_C ≥ 0 for every constraint C and every ε, η ∈ {−1,+1}." -/
def IsFeasible {V : Type} {m N : ℕ} (I : TwoAndInst V m) (v : VecSol V N) : Prop :=
  (∀ o, ‖v o‖ = 1) ∧
    ∀ k, ∀ ε η : Bool,
      0 ≤ 1 + sgn ε * aC I v k + sgn η * bC I v k + sgn ε * sgn η * dC I v k

/-- "c_C = (1 + a_C − b_C − d_C)/4." -/
def cC {V : Type} {m N : ℕ} (I : TwoAndInst V m) (v : VecSol V N) (k : Fin m) : ℝ :=
  (1 + aC I v k - bC I v k - dC I v k) / 4

/-- "S = Σ_C w_C c_C." -/
def sdpVal {V : Type} {m N : ℕ} (I : TwoAndInst V m) (v : VecSol V N) : ℝ :=
  ∑ k, I.w k * cC I v k

/-- `S*`: the supremum of `S` over feasible tuples in `ℝ^N`. -/
def sdpOpt {V : Type} {m : ℕ} (I : TwoAndInst V m) (N : ℕ) : ℝ :=
  ⨆ v : {v : VecSol V N // IsFeasible I v}, sdpVal I v.1

/-- A weight function on assignments (the type of the computed mixture `mixAlg`;
`FinDist`s coerce to it). -/
abbrev AssignDist (V : Type) := Assignment V → ℝ

/-- `P` is a probability vector (kept only for the computed mixture `mixAlg R v`;
input distributions are bundled `FinDist`s). -/
def IsProbVec {V : Type} [Fintype V] (P : AssignDist V) : Prop :=
  (∀ x, 0 ≤ P x) ∧ ∑ x, P x = 1

/-- `Pr_{x∼P}[x satisfies C_k]`. -/
def satProb {V : Type} [Fintype V] {m : ℕ} (I : TwoAndInst V m) (P : AssignDist V)
    (k : Fin m) : ℝ :=
  ∑ x, P x * sat I x k

/-- Expected assignment value under `P`. -/
def expVal {V : Type} [Fintype V] {m : ℕ} (I : TwoAndInst V m) (P : AssignDist V) : ℝ :=
  ∑ x, P x * val I x

/-- The combined algorithm: one global coin; with probability `1 − 10⁻⁵` run `R` on
the vector solution, with probability `10⁻⁵` run `U = FinDist.uniform (Assignment V)`
(each original variable independently uniform in `{−1,+1}`). -/
def mixAlg {V : Type} [Fintype V] {N : ℕ} (R : VecSol V N → FinDist (Assignment V))
    (v : VecSol V N) : AssignDist V :=
  fun x => (1 - 1 / 10 ^ 5) * R v x + (1 / 10 ^ 5) * FinDist.uniform (Assignment V) x

/-- The assumed rounding certificate for `R`. -/
def IsCertifiedRounding {V : Type} [Fintype V] {m N : ℕ} (I : TwoAndInst V m)
    (R : VecSol V N → FinDist (Assignment V)) : Prop :=
  ∀ v, IsFeasible I v →
    ∀ k, 0.87415 * cC I v k - 1 / 10 ^ 6 ≤ satProb I (R v) k

/-- Rubric 1: Boolean assignments embed into feasible vector solutions with
`S = val`. [SeparatingMAX2AND, node_33] -/
theorem integral_embedding {V : Type} {m N : ℕ} (hN : 1 ≤ N) (I : TwoAndInst V m)
    (x : Assignment V) : ∃ v : VecSol V N, IsFeasible I v ∧ sdpVal I v = val I x := by
  sorry

/-- Rubric 1: `OPT ≤ S*`. [SeparatingMAX2AND, node_33] -/
theorem OPT_le_sdpOpt {V : Type} [Fintype V] {m N : ℕ} (hN : 1 ≤ N)
    (I : TwoAndInst V m) (hI : I.IsValid) : OPT I ≤ sdpOpt I N := by
  sorry

/-- Rubric 4: uniform rounding of the original variables satisfies every remaining
constraint with probability at least `1/4` (exactly `1/4` on two distinct
variables, `1/2` for a single-variable literal constraint). [SeparatingMAX2AND, node_33] -/
theorem uniform_satProb {V : Type} [Fintype V] {m : ℕ} (I : TwoAndInst V m)
    (hI : I.IsValid) (k : Fin m) : 1 / 4 ≤ satProb I (FinDist.uniform (Assignment V)) k := by
  sorry

/-- `mixAlg R v` is a probability vector. [SeparatingMAX2AND, node_33] -/
theorem mixAlg_isProbVec {V : Type} [Fintype V] {N : ℕ}
    (R : VecSol V N → FinDist (Assignment V)) (v : VecSol V N) :
    IsProbVec (mixAlg R v) := by
  sorry

/-- Rubric 2–3: `E[V] ≥ (1−p)(a S − δ W) + p W/4 = r S + B W` with
`r = (1 − 10⁻⁵)·0.87415`, `B = 10⁻⁵/4 − (1 − 10⁻⁵)·10⁻⁶`. [SeparatingMAX2AND, node_33] -/
theorem mixAlg_expVal_ge {V : Type} [Fintype V] {m N : ℕ} (I : TwoAndInst V m)
    (hI : I.IsValid) (R : VecSol V N → FinDist (Assignment V))
    (hR : IsCertifiedRounding I R)
    (v : VecSol V N) (hv : IsFeasible I v) :
    (1 - 1 / 10 ^ 5) * 0.87415 * sdpVal I v
        + (1 / 10 ^ 5 / 4 - (1 - 1 / 10 ^ 5) * (1 / 10 ^ 6)) * totalW I
      ≤ expVal I (mixAlg R v) := by
  sorry

/-- Main theorem: applied to any feasible tuple with `S ≥ S* − 10⁻⁶ W`, the
combined algorithm has expected value at least `0.87414 · OPT`. [SeparatingMAX2AND, node_33] -/
theorem main_approx {V : Type} [Fintype V] {m N : ℕ} (hN : 1 ≤ N) (I : TwoAndInst V m)
    (hI : I.IsValid) (R : VecSol V N → FinDist (Assignment V))
    (hR : IsCertifiedRounding I R)
    (v : VecSol V N) (hv : IsFeasible I v)
    (hopt : sdpOpt I N - 1 / 10 ^ 6 * totalW I ≤ sdpVal I v) :
    0.87414 * OPT I ≤ expVal I (mixAlg R v) := by
  sorry

end TCSChallenge.SeparatingMAX2AND.node_33
