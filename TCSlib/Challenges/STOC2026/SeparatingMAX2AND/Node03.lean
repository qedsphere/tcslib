/-!
## Separating MAX DI-CUT from MAX 2-AND and MAX CUT: the directed-cut core

The target `α_2AND < α_DI-CUT < α_CUT` follows (given `α_2AND ≤ 0.87435` under UGC and
`α_CUT ≥ 0.8785`) from two new directed-cut bounds:

* **Algorithm** (`exists_rounding_scheme`): a finite mixture of (not necessarily odd)
  Gaussian threshold roundings, plus an independent fair assignment with small
  probability, satisfies `E[sat] ≥ 0.87446 · q(θ)` on every feasible SDP configuration
  `θ = (a, b, d)`, where `q(θ) = (1 + a - b - d)/4` is the relaxed contribution. Summing
  over weighted edges (`instance_guarantee`) and using that the SDP is a relaxation
  (`sdp_relaxation`) gives an approximation guarantee 0.87446.
* **Hardness witness** (`exists_hardness_witness`): a finite distribution of feasible
  configurations with nonpositive normalized correlation on which *every* threshold
  function `f` has mean satisfaction at most `0.87461 ·` mean relaxed contribution. Via a
  UG reduction (not formalized) this gives `α_DI-CUT ≤ 0.87461` under UGC.

Threshold rounding: given SDP vectors `u_0, u_i`, with bias `a_i = ⟨u_0, u_i⟩` and the
normalized component `v_i` of `u_i` orthogonal to `u_0`, sample a standard Gaussian `g`
and set `x_i = +1` iff `⟨g, v_i⟩ ≤ f(a_i)`. For an edge `(i, j)` the pair
`(⟨g, v_i⟩, ⟨g, v_j⟩)` is standard bivariate normal with correlation
`ρ = (d - ab)/√((1-a²)(1-b²))` (set to `0` in the degenerate case `|a| = 1` or `|b| = 1`,
corresponding to padding a zero orthogonal component with a fresh coordinate).
-/

namespace TCSChallenge.SeparatingMAX2AND.node_03

open MeasureTheory ProbabilityTheory BooleanAnalysis.ThresholdFunctions
open scoped NNReal

/-- A local SDP configuration of a directed edge `(i, j)`:
"`a = ⟨u_0,u_i⟩`, `b = ⟨u_0,u_j⟩`, `d = ⟨u_i,u_j⟩`". -/
structure Config where
  a : ℝ
  b : ℝ
  d : ℝ

/-- Feasibility of a configuration: it is the Gram data of three unit vectors
(entries in `[-1,1]` and the Gram matrix `[[1,a,b],[a,1,d],[b,d,1]]` has nonnegative
determinant, which with the unit diagonal and `|·| ≤ 1` entries is PSD), and it satisfies
the triangle constraints "`1 + s a + t b + s t d ≥ 0` for `s, t ∈ {-1,+1}`". -/
def Feasible (θ : Config) : Prop :=
  |θ.a| ≤ 1 ∧ |θ.b| ≤ 1 ∧ |θ.d| ≤ 1 ∧
  0 ≤ 1 - θ.a ^ 2 - θ.b ^ 2 - θ.d ^ 2 + 2 * θ.a * θ.b * θ.d ∧
  (∀ s t : ℝ, (s = 1 ∨ s = -1) → (t = 1 ∨ t = -1) → 0 ≤ 1 + s * θ.a + t * θ.b + s * t * θ.d)

/-- Relaxed contribution of a directed edge: "the weighted sum of `(1 + a - b - d)/4`". -/
def relaxedValue (θ : Config) : ℝ := (1 + θ.a - θ.b - θ.d) / 4

/-- Normalized correlation of the components orthogonal to `u_0`:
`ρ = (d - ab)/√((1-a²)(1-b²))`, and `0` when an orthogonal component vanishes. -/
def rho (θ : Config) : ℝ :=
  if (1 - θ.a ^ 2) * (1 - θ.b ^ 2) = 0 then 0
  else (θ.d - θ.a * θ.b) / Real.sqrt ((1 - θ.a ^ 2) * (1 - θ.b ^ 2))

/-- Standard two-dimensional Gaussian on `ℝ × ℝ` (product of TCSlib's
`standardGaussianMeasure` with itself). -/
abbrev stdGauss2 : Measure (ℝ × ℝ) := standardGaussianMeasure.prod standardGaussianMeasure

/-- Probability that threshold rounding with threshold function `f` satisfies the directed
edge with configuration `θ`, i.e. `x_i = +1` and `x_j = -1`:
`Pr[Z₁ ≤ f(a), Z₂ > f(b)]` for `(Z₁, Z₂)` standard bivariate normal with correlation
`ρ(θ)`, realized as `Z₁ = g₁`, `Z₂ = ρ g₁ + √(1-ρ²) g₂`. -/
def edgeSat (θ : Config) (f : ℝ → ℝ) : ℝ :=
  (stdGauss2 {g : ℝ × ℝ | g.1 ≤ f θ.a ∧
      f θ.b < rho θ * g.1 + Real.sqrt (1 - rho θ ^ 2) * g.2}).toReal

/-- A rounding scheme: a finite mixture of threshold functions (deliberately *not*
required to be odd, since directed cut has no negated literals), plus an independent
fair assignment used with probability `indep`. Data only; axioms in `Scheme.Valid`. -/
structure Scheme where
  m : ℕ
  weight : Fin m → ℝ
  thr : Fin m → ℝ → ℝ
  indep : ℝ

/-- The weights form a probability distribution. -/
def Scheme.Valid (R : Scheme) : Prop :=
  (∀ k, 0 ≤ R.weight k) ∧ 0 ≤ R.indep ∧ (∑ k, R.weight k) + R.indep = 1

/-- Expected satisfaction of an edge with configuration `θ` under the scheme; an
independent fair assignment satisfies a directed edge with probability `1/4`. -/
def schemeValue (R : Scheme) (θ : Config) : ℝ :=
  (∑ k, R.weight k * edgeSat θ (R.thr k)) + R.indep / 4

/-! ### Instances and the SDP -/

/-- A weighted MAX DI-CUT instance on `n` vertices: nonnegative weights, no loops. -/
def ValidInstance {n : ℕ} (w : Fin n → Fin n → ℝ) : Prop :=
  (∀ i j, 0 ≤ w i j) ∧ ∀ i, w i i = 0

/-- Value of an assignment (`true` ↔ `+1`): weight of directed edges with `x = +1`,
`y = -1` in that order. -/
def diCutValue {n : ℕ} (w : Fin n → Fin n → ℝ) (x : Fin n → Bool) : ℝ :=
  ∑ i, ∑ j, if x i = true ∧ x j = false then w i j else 0

/-- The configuration of the pair `(i, j)` in a vector solution. -/
def configOf {n N : ℕ} (u0 : Fin N → ℝ) (u : Fin n → Fin N → ℝ) (i j : Fin n) : Config :=
  ⟨dotProduct u0 (u i), dotProduct u0 (u j), dotProduct (u i) (u j)⟩

/-- Feasible SDP vector solution: unit reference vector and unit vertex vectors, with the
triangle constraints on every pair. -/
def SDPFeasible {n N : ℕ} (u0 : Fin N → ℝ) (u : Fin n → Fin N → ℝ) : Prop :=
  dotProduct u0 u0 = 1 ∧ (∀ i, dotProduct (u i) (u i) = 1) ∧
  ∀ i j, ∀ s t : ℝ, (s = 1 ∨ s = -1) → (t = 1 ∨ t = -1) →
    0 ≤ 1 + s * (configOf u0 u i j).a + t * (configOf u0 u i j).b +
      s * t * (configOf u0 u i j).d

/-- SDP objective of a vector solution. -/
def sdpValue {n N : ℕ} (w : Fin n → Fin n → ℝ) (u0 : Fin N → ℝ)
    (u : Fin n → Fin N → ℝ) : ℝ :=
  ∑ i, ∑ j, w i j * relaxedValue (configOf u0 u i j)

/-- Expected value of the scheme's output on the vector solution (by linearity of
expectation, the weighted sum of per-edge satisfaction probabilities). -/
def roundedValue {n N : ℕ} (R : Scheme) (w : Fin n → Fin n → ℝ) (u0 : Fin N → ℝ)
    (u : Fin n → Fin N → ℝ) : ℝ :=
  ∑ i, ∑ j, w i j * schemeValue R (configOf u0 u i j)

/-! ### Lemma stubs -/

/-- Configurations coming from a feasible vector solution are feasible. [SeparatingMAX2AND, node_03] -/
theorem configOf_feasible {n N : ℕ} (u0 : Fin N → ℝ) (u : Fin n → Fin N → ℝ)
    (h : SDPFeasible u0 u) (i j : Fin n) : Feasible (configOf u0 u i j) := by sorry

/-- The SDP is a relaxation: every assignment is matched by a feasible one-dimensional
vector solution of the same value. [SeparatingMAX2AND, node_03] -/
theorem sdp_relaxation {n : ℕ} (w : Fin n → Fin n → ℝ) (x : Fin n → Bool) :
    ∃ (u0 : Fin 1 → ℝ) (u : Fin n → Fin 1 → ℝ),
      SDPFeasible u0 u ∧ sdpValue w u0 u = diCutValue w x := by sorry

/-- Certified region (rubric: continuous certification): a pure threshold mixture with
`E[sat] ≥ 0.87447 q(θ)` on all feasible `θ` with `q(θ) ≥ 10⁻⁶`. [SeparatingMAX2AND, node_03] -/
theorem certified_threshold_mixture :
    ∃ R : Scheme, R.Valid ∧ R.indep = 0 ∧
      ∀ θ : Config, Feasible θ → (1 / 1000000 : ℝ) ≤ relaxedValue θ →
        (87447 / 100000 : ℝ) * relaxedValue θ ≤ schemeValue R θ := by sorry

/-- Small-contribution repair: mixing a pure threshold mixture certified at `0.87447` on
`q ≥ 10⁻⁶` with an independent fair assignment of probability `10⁻⁵` gives `0.87446`
on every feasible configuration. [SeparatingMAX2AND, node_03] -/
theorem small_contribution_repair (R : Scheme) (hR : R.Valid) (h0 : R.indep = 0)
    (hcert : ∀ θ : Config, Feasible θ → (1 / 1000000 : ℝ) ≤ relaxedValue θ →
        (87447 / 100000 : ℝ) * relaxedValue θ ≤ schemeValue R θ) :
    ∀ θ : Config, Feasible θ →
      (87446 / 100000 : ℝ) * relaxedValue θ ≤
        schemeValue ⟨R.m, fun k => (1 - 1 / 100000) * R.weight k, R.thr, 1 / 100000⟩ θ := by
  sorry

/-- Weighted summation: a local guarantee gives the instance-level guarantee against the
SDP value, hence (with `sdp_relaxation`) against the optimum. [SeparatingMAX2AND, node_03] -/
theorem instance_guarantee {n N : ℕ} (R : Scheme) (c : ℝ)
    (hloc : ∀ θ : Config, Feasible θ → c * relaxedValue θ ≤ schemeValue R θ)
    (w : Fin n → Fin n → ℝ) (hw : ValidInstance w)
    (u0 : Fin N → ℝ) (u : Fin n → Fin N → ℝ) (hu : SDPFeasible u0 u) :
    c * sdpValue w u0 u ≤ roundedValue R w u0 u := by sorry

/-! ### Main theorems -/

/-- **Algorithmic side.** Some threshold-mixture scheme satisfies
`E[sat] ≥ 0.87446 · q(θ)` on every feasible configuration. [SeparatingMAX2AND, node_03] -/
theorem exists_rounding_scheme :
    ∃ R : Scheme, R.Valid ∧
      ∀ θ : Config, Feasible θ → (87446 / 100000 : ℝ) * relaxedValue θ ≤ schemeValue R θ := by
  sorry

/-- **Algorithmic side, instance level.** For that scheme, on every instance and every
feasible SDP solution, the expected rounded value is at least `0.87446 ·` the value of
every assignment whenever the SDP solution is optimal (stated against all assignments of
SDP value at most the solution's). [SeparatingMAX2AND, node_03] -/
theorem exists_rounding_scheme_instance :
    ∃ R : Scheme, R.Valid ∧
      ∀ (n N : ℕ) (w : Fin n → Fin n → ℝ), ValidInstance w →
        ∀ (u0 : Fin N → ℝ) (u : Fin n → Fin N → ℝ), SDPFeasible u0 u →
          ∀ x : Fin n → Bool, diCutValue w x ≤ sdpValue w u0 u →
            (87446 / 100000 : ℝ) * diCutValue w x ≤ roundedValue R w u0 u := by sorry

/-- **Hardness witness (Gaussian threshold ceiling).** A finite distribution of feasible
configurations, all with `ρ(θ) ≤ 0` and positive mean relaxed contribution, on which
every threshold function `f` (arbitrary, including limits to `±∞` approached by real
values) has mean satisfaction at most `0.87461 ·` mean relaxed contribution. Combined
with a UG reduction (not formalized) this yields `α_DI-CUT ≤ 0.87461` under UGC. [SeparatingMAX2AND, node_03] -/
theorem exists_hardness_witness :
    ∃ (K : ℕ) (μ : Fin K → ℝ) (θ : Fin K → Config),
      (∀ k, 0 ≤ μ k) ∧ (∑ k, μ k) = 1 ∧
      (∀ k, Feasible (θ k)) ∧ (∀ k, rho (θ k) ≤ 0) ∧
      0 < ∑ k, μ k * relaxedValue (θ k) ∧
      ∀ f : ℝ → ℝ,
        (∑ k, μ k * edgeSat (θ k) f) ≤
          (87461 / 100000 : ℝ) * ∑ k, μ k * relaxedValue (θ k) := by sorry

/-- Both directed-cut milestones together, with the margins against the supplied
constants `0.87435` and `0.8785` built in. [SeparatingMAX2AND, node_03] -/
theorem dicut_separation_core :
    (87435 / 100000 : ℝ) < 87446 / 100000 ∧ (87461 / 100000 : ℝ) < 8785 / 10000 ∧
    (∃ R : Scheme, R.Valid ∧
      ∀ θ : Config, Feasible θ → (87446 / 100000 : ℝ) * relaxedValue θ ≤ schemeValue R θ) ∧
    (∃ (K : ℕ) (μ : Fin K → ℝ) (θ : Fin K → Config),
      (∀ k, 0 ≤ μ k) ∧ (∑ k, μ k) = 1 ∧
      (∀ k, Feasible (θ k)) ∧ (∀ k, rho (θ k) ≤ 0) ∧
      0 < ∑ k, μ k * relaxedValue (θ k) ∧
      ∀ f : ℝ → ℝ,
        (∑ k, μ k * edgeSat (θ k) f) ≤
          (87461 / 100000 : ℝ) * ∑ k, μ k * relaxedValue (θ k)) := by sorry

end TCSChallenge.SeparatingMAX2AND.node_03
