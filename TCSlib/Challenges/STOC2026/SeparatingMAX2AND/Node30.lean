/-!
## A 0.87446-approximation for MAX DI-CUT from an additive rounding certificate

A loopless weighted digraph has `val_G(x) = Σ w_ij 1{x_i = 1, x_j = −1}`.  The SDP
relaxation over unit vectors `v_0, (v_i)` uses `b_i = ⟨v_0, v_i⟩`,
`b_ij = ⟨v_i, v_j⟩`, objective `Σ w_ij C_ij` with `C_ij = (1 + b_i − b_j − b_ij)/4`
and triangle constraints `1 + s b_i + t b_j + st b_ij ≥ 0`.  Given a rounding `R`
with `Pr[R(v) cuts (i,j)] ≥ 0.87447 C_ij − 10⁻⁶`, the explicit rounding `mixA R`
(run `R` with probability `1 − 10⁻⁵`, otherwise a uniformly random labeling)
satisfies `Pr[mixA R v cuts (i,j)] ≥ 0.87446 C_ij` (`mixA_edgewise`), and applied
to any SDP solution within `10⁻⁶ W` of optimal it has expected value at least
`0.87446 · OPT(G)` (`main_approx`).
-/

namespace TCSChallenge.SeparatingMAX2AND.node_30

/-- A weighted directed graph on vertex type `V`: a finite edge set of ordered
pairs and edge weights. -/
structure DiGraphInst (V : Type) where
  edges : Finset (V × V)
  w : V × V → ℝ

/-- "A loopless directed graph with nonnegative edge weights." -/
def DiGraphInst.IsValid {V : Type} (G : DiGraphInst V) : Prop :=
  (∀ e ∈ G.edges, e.1 ≠ e.2) ∧ ∀ e ∈ G.edges, 0 ≤ G.w e

/-- A labeling `x ∈ {−1,1}^V`, with `true` standing for `+1`. -/
abbrev Labeling (V : Type) := V → Bool

/-- `1{x_i = 1, x_j = −1}`. -/
def cuts {V : Type} (x : Labeling V) (e : V × V) : ℝ :=
  if x e.1 = true ∧ x e.2 = false then 1 else 0

/-- "val_G(x) = Σ_{(i,j)∈E} w_ij 1{x_i = 1, x_j = −1}." -/
def val {V : Type} (G : DiGraphInst V) (x : Labeling V) : ℝ :=
  ∑ e ∈ G.edges, G.w e * cuts x e

/-- "OPT(G) = max_x val_G(x)." -/
def OPT {V : Type} [Fintype V] (G : DiGraphInst V) : ℝ :=
  ⨆ x : Labeling V, val G x

/-- "W = Σ_{(i,j)∈E} w_ij." -/
def totalW {V : Type} (G : DiGraphInst V) : ℝ := ∑ e ∈ G.edges, G.w e

/-- A vector solution: `none ↦ v_0`, `some i ↦ v_i`, in `ℝ^N`. -/
abbrev VecSol (V : Type) (N : ℕ) := Option V → EuclideanSpace ℝ (Fin N)

/-- `b_i = ⟨v_0, v_i⟩`. -/
def bi {V : Type} {N : ℕ} (v : VecSol V N) (i : V) : ℝ := inner ℝ (v none) (v (some i))

/-- `b_ij = ⟨v_i, v_j⟩`. -/
def bij {V : Type} {N : ℕ} (v : VecSol V N) (i j : V) : ℝ :=
  inner ℝ (v (some i)) (v (some j))

/-- Sign of a Boolean: `true ↦ 1`, `false ↦ −1`. -/
def sgn (s : Bool) : ℝ := if s then 1 else -1

/-- Feasibility: all vectors are unit and
"1 + s b_i + t b_j + st b_ij ≥ 0 for all (i,j) ∈ E and s,t ∈ {−1,1}." -/
def IsFeasible {V : Type} {N : ℕ} (G : DiGraphInst V) (v : VecSol V N) : Prop :=
  (∀ o, ‖v o‖ = 1) ∧
    ∀ e ∈ G.edges, ∀ s t : Bool,
      0 ≤ 1 + sgn s * bi v e.1 + sgn t * bi v e.2 + sgn s * sgn t * bij v e.1 e.2

/-- "C_ij = (1 + b_i − b_j − b_ij)/4." -/
def Cij {V : Type} {N : ℕ} (v : VecSol V N) (e : V × V) : ℝ :=
  (1 + bi v e.1 - bi v e.2 - bij v e.1 e.2) / 4

/-- "L = Σ_{(i,j)∈E} w_ij C_ij." -/
def sdpVal {V : Type} {N : ℕ} (G : DiGraphInst V) (v : VecSol V N) : ℝ :=
  ∑ e ∈ G.edges, G.w e * Cij v e

/-- The SDP optimum (supremum of `L` over feasible vector solutions in `ℝ^N`). -/
def sdpOpt {V : Type} (G : DiGraphInst V) (N : ℕ) : ℝ :=
  ⨆ v : {v : VecSol V N // IsFeasible G v}, sdpVal G v.1

/-- A weight function on labelings (used for the computed mixture `mixA R v`;
given distributions are bundled as `FinDist (Labeling V)`). -/
abbrev LabelDist (V : Type) := Labeling V → ℝ

/-- `P` is a probability vector (kept only for the computed mixture `mixA R v`). -/
def IsProbVec {V : Type} [Fintype V] (P : LabelDist V) : Prop :=
  (∀ x, 0 ≤ P x) ∧ ∑ x, P x = 1

/-- `Pr_{x∼P}[x_i = 1, x_j = −1]`. -/
def edgeProb {V : Type} [Fintype V] (P : LabelDist V) (e : V × V) : ℝ :=
  ∑ x, P x * cuts x e

/-- `E_{x∼P}[val_G(x)]`. -/
def expVal {V : Type} [Fintype V] (G : DiGraphInst V) (P : LabelDist V) : ℝ :=
  ∑ x, P x * val G x

/-- The constructed rounding `A`: one global coin; with probability `1 − 10⁻⁵`
output `R(v)`, with probability `10⁻⁵` an independent uniform labeling
(`FinDist.uniform`). -/
def mixA {V : Type} [Fintype V] {N : ℕ} (R : VecSol V N → FinDist (Labeling V))
    (v : VecSol V N) : LabelDist V :=
  fun x => (1 - 1 / 10 ^ 5) * R v x + (1 / 10 ^ 5) * FinDist.uniform (Labeling V) x

/-- The assumed rounding certificate for `R` (each `R v` is a distribution on
labelings by its type `FinDist`). -/
def IsCertifiedRounding {V : Type} [Fintype V] {N : ℕ} (G : DiGraphInst V)
    (R : VecSol V N → FinDist (Labeling V)) : Prop :=
  ∀ v, IsFeasible G v →
    ∀ e ∈ G.edges, 0.87447 * Cij v e - 1 / 10 ^ 6 ≤ edgeProb (R v).prob e

/-- Feasible edge contributions are nonnegative (the `s = 1, t = −1` constraint). [SeparatingMAX2AND, node_30] -/
theorem Cij_nonneg {V : Type} {N : ℕ} (G : DiGraphInst V) (v : VecSol V N)
    (hv : IsFeasible G v) (e : V × V) (he : e ∈ G.edges) : 0 ≤ Cij v e := by
  sorry

/-- `mixA R v` is a probability vector (each `R v` is a distribution). [SeparatingMAX2AND, node_30] -/
theorem mixA_isProbVec {V : Type} [Fintype V] {N : ℕ}
    (R : VecSol V N → FinDist (Labeling V)) (v : VecSol V N) :
    IsProbVec (mixA R v) := by
  sorry

/-- A uniform labeling cuts a fixed non-loop directed edge with probability `1/4`. [SeparatingMAX2AND, node_30] -/
theorem uniform_edgeProb {V : Type} [Fintype V] (e : V × V) (he : e.1 ≠ e.2) :
    edgeProb (FinDist.uniform (Labeling V)).prob e = 1 / 4 := by
  sorry

/-- Rubric 1–2: the edgewise guarantee `Pr[A(v) cuts (i,j)] ≥ 0.87446 C_ij`,
uniformly, including `C_ij = 0`. [SeparatingMAX2AND, node_30] -/
theorem mixA_edgewise {V : Type} [Fintype V] {N : ℕ} (G : DiGraphInst V)
    (hG : G.IsValid) (R : VecSol V N → FinDist (Labeling V)) (hR : IsCertifiedRounding G R)
    (v : VecSol V N) (hv : IsFeasible G v) (e : V × V) (he : e ∈ G.edges) :
    0.87446 * Cij v e ≤ edgeProb (mixA R v) e := by
  sorry

/-- Rubric 3: integral labelings embed into the relaxation with the same
objective. [SeparatingMAX2AND, node_30] -/
theorem integral_embedding {V : Type} {N : ℕ} (hN : 1 ≤ N) (G : DiGraphInst V)
    (x : Labeling V) : ∃ v : VecSol V N, IsFeasible G v ∧ sdpVal G v = val G x := by
  sorry

/-- Rubric 3: the SDP is a relaxation, `OPT(G) ≤ sdpOpt`. [SeparatingMAX2AND, node_30] -/
theorem OPT_le_sdpOpt {V : Type} [Fintype V] {N : ℕ} (hN : 1 ≤ N) (G : DiGraphInst V)
    (hG : G.IsValid) : OPT G ≤ sdpOpt G N := by
  sorry

/-- Main theorem (rubrics 3–4): applied to any feasible solution within `10⁻⁶ W`
of the SDP optimum, the explicit rounding `mixA R` has expected directed-cut
value at least `0.87446 · OPT(G)`. [SeparatingMAX2AND, node_30] -/
theorem main_approx {V : Type} [Fintype V] {N : ℕ} (hN : 1 ≤ N) (G : DiGraphInst V)
    (hG : G.IsValid) (R : VecSol V N → FinDist (Labeling V)) (hR : IsCertifiedRounding G R)
    (v : VecSol V N) (hv : IsFeasible G v)
    (hopt : sdpOpt G N - 1 / 10 ^ 6 * totalW G ≤ sdpVal G v) :
    0.87446 * OPT G ≤ expVal G (mixA R v) := by
  sorry

end TCSChallenge.SeparatingMAX2AND.node_30
