/-!
## UGC-hardness gap for MAX DI-CUT at 0.87461

A configuration `θ = (u, v, w)` is feasible if `|u|, |v| < 1` and
`1 + σu + τv + στw ≥ 0` for all signs `σ, τ`. Its completeness is
`C(θ) = (1 + u - v - w)/4` and its relative correlation is
`ρ(θ) = (w - uv)/√((1-u²)(1-v²))`; it is positive if `-1 < ρ(θ) ≤ 0`.
For a finitely supported rational distribution `D` on positive feasible
configurations, `C_D = E[C(θ)]` and
`S_D = sup_h E[Φ_{-ρ(θ)}(h(u), -h(v))]`, where `Φ_r` is the bivariate normal CDF
with correlation `r`.

The main theorem `exists_hardness_gap` states that some such `D` has
`S_D < 0.87461 · C_D`, and that the gap survives fixed positive completeness and
soundness errors `η, ε`, which is exactly what the supplied reduction and UGC need
to make a 0.87461-approximation NP-hard.
-/

namespace TCSChallenge.SeparatingMAX2AND.node_19

open MeasureTheory ProbabilityTheory
open scoped NNReal
open BooleanAnalysis.ThresholdFunctions

/-- Standard normal CDF `Φ(z) = Pr[Z ≤ z]`. -/
def stdCDF (z : ℝ) : ℝ := (standardGaussianMeasure (Set.Iic z)).toReal

/-- Standard normal density `φ(z)`. -/
def stdPDF (z : ℝ) : ℝ := gaussianPDFReal 0 1 z

/-- "`Φ_r(x,y) = Pr[Z₁ ≤ x, Z₂ ≤ y]` for a centered bivariate normal vector
`(Z₁, Z₂)` with unit variances and correlation `r`."  We realize `(Z₁, Z₂)` as
`(G₁, r G₁ + √(1-r²) G₂)` with `G₁, G₂` independent standard normals
(faithful for `r ∈ [-1, 1]`). -/
def bivarCDF (r x y : ℝ) : ℝ :=
  ((standardGaussianMeasure.prod standardGaussianMeasure)
    {g : ℝ × ℝ | g.1 ≤ x ∧ r * g.1 + Real.sqrt (1 - r ^ 2) * g.2 ≤ y}).toReal

/-- A configuration `θ = (u, v, w)`. -/
abbrev Config := ℝ × ℝ × ℝ

/-- Sign of a Boolean: `true ↦ 1`, `false ↦ -1`. -/
def sgn (s : Bool) : ℝ := if s then 1 else -1

/-- "θ = (u,v,w) is feasible if |u|,|v| < 1 and 1 + σu + τv + στw ≥ 0 for every
σ, τ ∈ {−1, 1}." -/
def IsFeasible (θ : Config) : Prop :=
  |θ.1| < 1 ∧ |θ.2.1| < 1 ∧
    ∀ σ τ : Bool, 0 ≤ 1 + sgn σ * θ.1 + sgn τ * θ.2.1 + sgn σ * sgn τ * θ.2.2

/-- "C(θ) = (1 + u − v − w)/4." -/
def compl (θ : Config) : ℝ := (1 + θ.1 - θ.2.1 - θ.2.2) / 4

/-- "ρ(θ) = (w − uv)/√((1 − u²)(1 − v²))." -/
def relCorr (θ : Config) : ℝ :=
  (θ.2.2 - θ.1 * θ.2.1) / Real.sqrt ((1 - θ.1 ^ 2) * (1 - θ.2.1 ^ 2))

/-- "A feasible configuration is positive if −1 < ρ(θ) ≤ 0." -/
def IsPositive (θ : Config) : Prop :=
  IsFeasible θ ∧ -1 < relCorr θ ∧ relCorr θ ≤ 0

/-- A finitely supported distribution on configurations with rational weights. -/
structure ConfigDist where
  supp : Finset Config
  wt : Config → ℚ

/-- `D` is a rational probability distribution supported on positive feasible
configurations. -/
def ConfigDist.IsValid (D : ConfigDist) : Prop :=
  (∀ θ ∈ D.supp, 0 < D.wt θ ∧ IsPositive θ) ∧ ∑ θ ∈ D.supp, D.wt θ = 1

/-- "C_D = E_{θ∼D}[C(θ)]." -/
def ConfigDist.completeness (D : ConfigDist) : ℝ :=
  ∑ θ ∈ D.supp, (D.wt θ : ℝ) * compl θ

/-- "S_D = sup_{h : B → ℝ} E_{(u,v,w)∼D}[Φ_{−ρ(θ)}(h(u), −h(v))]."  Only the
values of `h` on the first/second coordinates of the support matter, so we take
`h : ℝ → ℝ`. -/
def ConfigDist.soundness (D : ConfigDist) : ℝ :=
  ⨆ h : ℝ → ℝ, ∑ θ ∈ D.supp,
    (D.wt θ : ℝ) * bivarCDF (-relCorr θ) (h θ.1) (-h θ.2.1)

/-! ### The three-point witness family -/

/-- The reference witness: mass `p, q, p` (with `q = 1 − 2p`) on
`θ₁ = (−b, −b, −1+2b)`, `θ₂ = (b, −b, c)`, `θ₃ = (b, b, −1+2b)`. -/
def theta1 (b : ℚ) : Config := (((-b : ℚ) : ℝ), ((-b : ℚ) : ℝ), ((-1 + 2 * b : ℚ) : ℝ))
/-- `θ₂ = (b, −b, c)`. -/
def theta2 (b c : ℚ) : Config := ((b : ℝ), ((-b : ℚ) : ℝ), (c : ℝ))
/-- `θ₃ = (b, b, −1+2b)`. -/
def theta3 (b : ℚ) : Config := ((b : ℝ), (b : ℝ), ((-1 + 2 * b : ℚ) : ℝ))

/-- The distribution with masses `p, 1−2p, p` on `θ₁, θ₂, θ₃`. -/
def threePoint (p b c : ℚ) : ConfigDist where
  supp := {theta1 b, theta2 b c, theta3 b}
  wt := fun θ => if θ = theta2 b c then 1 - 2 * p else p

/-- The value `q = 1 − 2p = 0.2458839410` used in the reference witness. -/
def pRef : ℚ := (1 - 0.2458839410) / 2

/-- Rubric 1: under the sign-probability conditions the three-point family is a
valid distribution on positive feasible configurations, with
`C_D = p(1−b) + q(1+2b−c)/4`. [SeparatingMAX2AND, node_19] -/
theorem threePoint_valid (p b c : ℚ) (hp : 0 < p) (hq : 0 < 1 - 2 * p)
    (hb0 : 0 < b) (hb1 : b < 1)
    (hc1 : 0 ≤ 1 + c) (hc2 : 0 ≤ 1 + 2 * b - c) (hc3 : 0 ≤ 1 - 2 * b - c)
    (hρ₂ : -1 < (c + b ^ 2) / (1 - b ^ 2) ∧ (c + b ^ 2) / (1 - b ^ 2) < 0) :
    (threePoint p b c).IsValid ∧
      (threePoint p b c).completeness =
        (p : ℝ) * (1 - b) + ((1 - 2 * p : ℚ) : ℝ) * (1 + 2 * b - c) / 4 := by
  sorry

/-- The conditional-density identity
`∂Φ_R(u,v)/∂u = φ(u) Φ((v − R u)/√(1 − R²))` for `|R| < 1`. [SeparatingMAX2AND, node_19] -/
theorem hasDerivAt_bivarCDF (R u v : ℝ) (hR : |R| < 1) :
    HasDerivAt (fun x => bivarCDF R x v)
      (stdPDF u * stdCDF ((v - R * u) / Real.sqrt (1 - R ^ 2))) u := by
  sorry

/-- Rubric 2: the critical equations (divided by `φ`) of
`s(x,y) = pA(x) + qΦ_{R₂}(y,−x) + pA(y)` force every finite critical point to
be of the form `(−t, t)` with `t > 0`, without assuming symmetry.  Here
`a = 1/√b > 0`, `ρ₂ ∈ (−1, 0)`, `D₂ = √(1 − ρ₂²)`. [SeparatingMAX2AND, node_19] -/
theorem critical_point_antidiagonal (p q a ρ₂ x y : ℝ)
    (hp : 0 < p) (hq : 0 < q) (ha : 0 < a) (hρ₂ : -1 < ρ₂ ∧ ρ₂ < 0)
    (h1 : p * (1 - 2 * stdCDF (a * x)) =
      q * stdCDF ((y - ρ₂ * x) / Real.sqrt (1 - ρ₂ ^ 2)))
    (h2 : p * (1 - 2 * stdCDF (a * y)) =
      -(q * stdCDF ((-x + ρ₂ * y) / Real.sqrt (1 - ρ₂ ^ 2)))) :
    x < 0 ∧ y = -x := by
  sorry

/-- Rubric 3: `H(t) = p(2Φ(at) − 1) − qΦ(dt)` has exactly one root on `t ≥ 0`
when `0 < q < p`, `0 < d < 1 < a` and `2pa > qd`. [SeparatingMAX2AND, node_19] -/
theorem unique_root (p q a d : ℝ) (hq : 0 < q) (hqp : q < p)
    (hd0 : 0 < d) (hd1 : d < 1) (ha : 1 < a) (hpa : q * d < 2 * p * a) :
    ∃! t : ℝ, 0 ≤ t ∧ p * (2 * stdCDF (a * t) - 1) - q * stdCDF (d * t) = 0 := by
  sorry

/-- Rubrics 1, 4, 5: some finitely supported rational distribution on positive
feasible configurations satisfies `S_D < 0.87461 · C_D` (in the reference
answer, the three-point family with `p = pRef`). [SeparatingMAX2AND, node_19] -/
theorem exists_gap_distribution :
    ∃ D : ConfigDist, D.IsValid ∧ D.soundness < 0.87461 * D.completeness := by
  sorry

/-- Main theorem (rubric 6, numerical core of the hardness transfer): there are a
valid `D` and fixed `η, ε > 0` such that, for any instance values produced by the
supplied reduction, a 0.87461-approximation distinguishes the promise cases:
if the YES-instance optimum is at least `(1 − 2η) C_D` and the algorithm's output
is at least `0.87461` times it, then the output strictly exceeds every NO-instance
optimum (which is at most `S_D + ε`). [SeparatingMAX2AND, node_19] -/
theorem exists_hardness_gap :
    ∃ D : ConfigDist, D.IsValid ∧ ∃ η ε : ℝ, 0 < η ∧ 0 < ε ∧
      ∀ optYes out optNo : ℝ,
        (1 - 2 * η) * D.completeness ≤ optYes →
        0.87461 * optYes ≤ out →
        optNo ≤ D.soundness + ε →
        optNo < out := by
  sorry

end TCSChallenge.SeparatingMAX2AND.node_19
