/-!
## Lower bound for Steiner `(√2 - ε)`-spanners of points on the sphere

There is an absolute `c > 0` such that for every `ε ∈ (0, √2 - 1)` there is `n₀(ε)` with: for
every `n ≥ n₀` there are `d ≥ 1` and an `n`-point `P ⊂ S^{d-1}` such that every finite graph
`H = (P ∪ S, E)`, `S ⊂ ℝ^d`, with Euclidean edge weights and
`‖u - v‖ ≤ d_H(u,v) ≤ (√2 - ε)‖u - v‖` for `u, v ∈ P`, has `|E| ≥ c n² ε⁴ / (log n)²`.

Main theorem: `sphere_steiner_spanner_lower_bound`.
-/

namespace TCSChallenge.SubQuadratic1epsApproximate.node_08

/-! ## Steiner graphs with metric edge weights (shared with node_06) -/

/-- Weighted length `∑_{i<m} w(p_i, p_{i+1})` of the walk `p 0, …, p m`. -/
def walkLength {X : Type*} (w : X → X → ℝ) {m : ℕ} (p : Fin (m + 1) → X) : ℝ :=
  ∑ i : Fin m, w (p i.castSucc) (p i.succ)

/-- `p 0, …, p m` is a walk from `u` to `v` using only edges of `E`. -/
def IsWalk {X : Type*} (E : Finset (Sym2 X)) {m : ℕ} (p : Fin (m + 1) → X) (u v : X) : Prop :=
  p 0 = u ∧ p (Fin.last m) = v ∧ ∀ i : Fin m, Sym2.mk (p i.castSucc, p i.succ) ∈ E

/-- `d_H(u,v) ≤ L`: "d_H is weighted shortest-path distance, taken to be +∞ when no path
exists"; the shortest path distance is `≤ L` iff some walk has length `≤ L`. -/
def DistLE {X : Type*} (w : X → X → ℝ) (E : Finset (Sym2 X)) (u v : X) (L : ℝ) : Prop :=
  ∃ m : ℕ, ∃ p : Fin (m + 1) → X, IsWalk E p u v ∧ walkLength w p ≤ L

/-- "`w(u,v) ≤ d_H(u,v) ≤ s · w(u,v)` for every `u, v ∈ P`", where `H` has edge set `E` and
edge weights `w(a,b)`. -/
def IsSteinerSpanner {X : Type*} (w : X → X → ℝ) (E : Finset (Sym2 X)) (P : Finset X)
    (s : ℝ) : Prop :=
  (∀ u ∈ P, ∀ v ∈ P, DistLE w E u v (s * w u v)) ∧
  (∀ u ∈ P, ∀ v ∈ P, ∀ m : ℕ, ∀ p : Fin (m + 1) → X, IsWalk E p u v → w u v ≤ walkLength w p)

/-- `E` is the edge set of a simple undirected graph: no loops. -/
def NoLoops {X : Type*} (E : Finset (Sym2 X)) : Prop :=
  ∀ e ∈ E, ¬ e.IsDiag

/-- `l` is a simple path from `x` to `y` in the graph with edge set `E`. -/
def IsPrescribedPath {X : Type*} (E : Finset (Sym2 X)) (x y : X) (l : List X) : Prop :=
  l.head? = some x ∧ l.getLast? = some y ∧ l.Nodup ∧
  ∀ i : ℕ, ∀ h : i + 1 < l.length, Sym2.mk (l[i]'(Nat.lt_of_succ_lt h), l[i + 1]'h) ∈ E

/-- Some vertex `v` lies on `k` prescribed paths `Q x_i y_i` with `x_i ∈ A` pairwise distinct
and `y_i ∈ B` pairwise distinct. -/
def HasKSharedPaths {X : Type*} (Q : X → X → List X) (A B : Finset X) (k : ℕ) : Prop :=
  ∃ v : X, ∃ f : Fin k → X × X,
    (∀ i, (f i).1 ∈ A ∧ (f i).2 ∈ B ∧ v ∈ Q (f i).1 (f i).2) ∧
    Function.Injective (fun i => (f i).1) ∧ Function.Injective (fun i => (f i).2)

/-! ## Euclidean space -/

/-- `ℝ^d` with the Euclidean norm. -/
abbrev Rd (d : ℕ) : Type := EuclideanSpace ℝ (Fin d)

/-- Euclidean edge weight `w({a,b}) = ‖a - b‖₂`. -/
def ew {d : ℕ} (a b : Rd d) : ℝ := ‖a - b‖

/-- A pair is good: `|‖x - y‖ - √2| ≤ η` with `η = ε/100`. -/
def GoodPair {d : ℕ} (ε : ℝ) (x y : Rd d) : Prop :=
  |‖x - y‖ - Real.sqrt 2| ≤ ε / 100

/-- Nearest-point projection onto the closed unit ball. -/
def ballProj {d : ℕ} (a : Rd d) : Rd d :=
  if ‖a‖ ≤ 1 then a else ‖a‖⁻¹ • a

/-- `k = ⌈1000 ε⁻² log n⌉`. -/
def kParam (ε : ℝ) (n : ℕ) : ℕ := ⌈1000 * ε⁻¹ ^ 2 * Real.log n⌉₊

/-! ## Rubric items -/

/-- Combinatorial assertion (rubric 1): for `2 ≤ k ≤ q`, either some vertex lies on `k`
prescribed paths with distinct endpoints on both sides, or `q² ≤ 8 m (k-1)²`. [SubQuadratic1epsApproximate, node_08] -/
theorem combinatorial_assertion {X : Type*} (E : Finset (Sym2 X)) (A B : Finset X) (q k : ℕ)
    (hk : 2 ≤ k) (hkq : k ≤ q) (hA : A.card = q) (hB : B.card = q) (hAB : Disjoint A B)
    (Q : X → X → List X) (hQ : ∀ x ∈ A, ∀ y ∈ B, IsPrescribedPath E x y (Q x y)) :
    HasKSharedPaths Q A B k ∨ ((q : ℝ)) ^ 2 ≤ 8 * (E.card : ℝ) * ((k : ℝ) - 1) ^ 2 := by
  sorry

/-- Geometric restriction (rubric 2, (3)–(4)): for unit vectors `x, y` forming a good pair and
`p` in the closed unit ball with `‖x - p‖ + ‖y - p‖ ≤ (√2 - ε/2)‖x - y‖`, the point `p` has
`⟨p, (x+y)/‖x+y‖⟩ ≥ ε/3`. [SubQuadratic1epsApproximate, node_08] -/
theorem detour_forces_cap {d : ℕ} (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < Real.sqrt 2 - 1)
    (x y p : Rd d) (hx : ‖x‖ = 1) (hy : ‖y‖ = 1) (hgood : GoodPair ε x y) (hp : ‖p‖ ≤ 1)
    (hdet : ‖x - p‖ + ‖y - p‖ ≤ (Real.sqrt 2 - ε / 2) * ‖x - y‖) :
    ε / 3 ≤ inner ℝ p (‖x + y‖⁻¹ • (x + y)) := by
  sorry

/-- Net (rubric 3): for `ρ > 0` the closed unit ball of `ℝ^d` has a `ρ`-net inside the ball of
cardinality at most `(1 + 2/ρ)^d`. [SubQuadratic1epsApproximate, node_08] -/
theorem unit_ball_net (d : ℕ) (ρ : ℝ) (hρ : 0 < ρ) :
    ∃ N : Finset (Rd d), (∀ p ∈ N, ‖p‖ ≤ 1) ∧
      (∀ v : Rd d, ‖v‖ ≤ 1 → ∃ p ∈ N, ‖v - p‖ ≤ ρ) ∧
      (N.card : ℝ) ≤ (1 + 2 / ρ) ^ d := by
  sorry

/-- Projection onto the unit ball is 1-Lipschitz (rubric 5). [SubQuadratic1epsApproximate, node_08] -/
theorem ballProj_lipschitz {d : ℕ} (a b : Rd d) :
    ‖ballProj a - ballProj b‖ ≤ ‖a - b‖ := by
  sorry

/-- Uniformly good terminal set (rubric 4): for `n ≥ n₀(ε)` there are `d ≥ 1` and `n` unit
vectors, pairwise good, such that no point `v` of the unit ball and `2k` distinct terminals
`x_1, y_1, …, x_k, y_k` (`k = ⌈1000 ε⁻² log n⌉`) satisfy
`‖x_i - v‖ + ‖y_i - v‖ ≤ (√2 - ε)‖x_i - y_i‖` for all `i`. [SubQuadratic1epsApproximate, node_08] -/
theorem good_terminal_set (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < Real.sqrt 2 - 1) :
    ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
      ∃ d : ℕ, 1 ≤ d ∧ ∃ P : Finset (Rd d), P.card = n ∧ (∀ x ∈ P, ‖x‖ = 1) ∧
        (∀ x ∈ P, ∀ y ∈ P, x ≠ y → GoodPair ε x y) ∧
        ¬ ∃ v : Rd d, ‖v‖ ≤ 1 ∧ ∃ f : Fin (kParam ε n) → Rd d × Rd d,
            (∀ i, (f i).1 ∈ P ∧ (f i).2 ∈ P ∧
              ‖(f i).1 - v‖ + ‖(f i).2 - v‖ ≤ (Real.sqrt 2 - ε) * ‖(f i).1 - (f i).2‖) ∧
            Function.Injective (Sum.elim (fun i => (f i).1) (fun i => (f i).2)) := by
  sorry

/-! ## Main theorem -/

/-- There is an absolute `c > 0` such that for every `ε ∈ (0, √2 - 1)` there is `n₀(ε)` with:
for every `n ≥ n₀` there are `d ≥ 1` and an `n`-point `P ⊂ S^{d-1}` such that every finite
Steiner graph `H = (P ∪ S, E)` with Euclidean edge weights and terminal stretch `≤ √2 - ε`
has `|E| ≥ c n² ε⁴ / (log n)²`. [SubQuadratic1epsApproximate, node_08] -/
theorem sphere_steiner_spanner_lower_bound :
    ∃ c : ℝ, 0 < c ∧ ∀ ε : ℝ, 0 < ε → ε < Real.sqrt 2 - 1 →
      ∃ n₀ : ℕ, ∀ n : ℕ, n₀ ≤ n →
        ∃ d : ℕ, 1 ≤ d ∧ ∃ P : Finset (Rd d), P.card = n ∧ (∀ x ∈ P, ‖x‖ = 1) ∧
          ∀ E : Finset (Sym2 (Rd d)), NoLoops E →
            IsSteinerSpanner ew E P (Real.sqrt 2 - ε) →
              c * ((n : ℝ) ^ 2 * ε ^ 4 / (Real.log n) ^ 2) ≤ (E.card : ℝ) := by
  sorry

end TCSChallenge.SubQuadratic1epsApproximate.node_08
