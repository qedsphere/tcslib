/-!
## EMD via min-cost flow on a sparse directed Euclidean spanner

Point sets `A = {a i}`, `B = {b j}` (`n` points each, given as families so that
repetitions and points shared between `A` and `B` are allowed) in `ℝ^d`.
`EMD(A,B) = min_σ ∑ᵢ ‖a i - b (σ i)‖₂` over permutations `σ`.

A directed graph `H` on a finite vertex type `W` (terminals plus auxiliary
vertices with no geometric meaning) is given by an arc set and nonnegative arc
lengths, together with a map `loc : E → W` placing the terminals.  It satisfies
the terminal-stretch guarantee: for terminals `x, y`,
`‖x - y‖ ≤ d_H(loc x, loc y) ≤ (1+η)‖x - y‖`.

The transport network puts net supply `#{i | loc (a i) = v} - #{j | loc (b j) = v}`
at every vertex `v` (so auxiliary vertices and shared terminals are neutral),
uncapacitated nonnegative arc flows, and objective `∑ len(e)·f(e)`.

Main theorem `emd_approx_via_spanner_flow`: with `η = ε/3`, any optimal flow
value `OPT_H` satisfies `EMD ≤ OPT_H ≤ (1+ε/3)·EMD`, and any `V` with
`OPT_H ≤ V ≤ (1+ε/3)·OPT_H` satisfies `EMD ≤ V ≤ (1+ε)·EMD`.
-/

namespace TCSChallenge.SubQuadratic1epsApproximate.node_15

/-- Euclidean space `ℝ^d` with the `ℓ₂` norm. -/
abbrev E (d : ℕ) := EuclideanSpace ℝ (Fin d)

/-- "EMD(A,B) = min over bijections π : A → B of ∑_{a∈A} ‖a − π(a)‖₂", with the
bijection encoded as a permutation of the index set `Fin n`. -/
def emd {d n : ℕ} (a b : Fin n → E d) : ℝ :=
  Finset.univ.inf' Finset.univ_nonempty
    (fun σ : Equiv.Perm (Fin n) => ∑ i, ‖a i - b (σ i)‖)

/-- A directed walk with `m` arcs, encoded as its vertex sequence
`p : Fin (m+1) → W`, from `u` to `v` using only arcs of `arcs`. -/
def IsArcWalk {W : Type} (arcs : Finset (W × W)) (u v : W) {m : ℕ}
    (p : Fin (m + 1) → W) : Prop :=
  p 0 = u ∧ p (Fin.last m) = v ∧ ∀ i : Fin m, (p i.castSucc, p i.succ) ∈ arcs

/-- Length of a walk: sum of the arc lengths along it. -/
def walkLen {W : Type} (len : W × W → ℝ) {m : ℕ} (p : Fin (m + 1) → W) : ℝ :=
  ∑ i : Fin m, len (p i.castSucc, p i.succ)

/-- The terminal set `P = A ∪ B`. -/
def terminals {d n : ℕ} (a b : Fin n → E d) : Set (E d) :=
  Set.range a ∪ Set.range b

/-- The distance-preservation primitive: "for every ordered pair p, q ∈ P,
‖p − q‖₂ ≤ d⃗_H(p,q) ≤ (1+η)‖p − q‖₂". Lower bound: every directed walk from
`loc p` to `loc q` is at least `‖p − q‖`; upper bound: some walk has length at
most `(1+η)‖p − q‖`. Nothing is said about individual arcs. -/
def TerminalStretch {d : ℕ} {W : Type} (P : Set (E d)) (arcs : Finset (W × W))
    (len : W × W → ℝ) (loc : E d → W) (η : ℝ) : Prop :=
  ∀ x ∈ P, ∀ y ∈ P,
    (∀ (m : ℕ) (p : Fin (m + 1) → W), IsArcWalk arcs (loc x) (loc y) p →
        ‖x - y‖ ≤ walkLen len p) ∧
    (∃ (m : ℕ) (p : Fin (m + 1) → W), IsArcWalk arcs (loc x) (loc y) p ∧
        walkLen len p ≤ (1 + η) * ‖x - y‖)

/-- Net supply at a vertex: number of `A`-points placed there minus number of
`B`-points placed there. Auxiliary vertices and points in `A ∩ B` (with equal
multiplicity) get net supply zero. -/
def supply {d n : ℕ} {W : Type} (a b : Fin n → E d) (loc : E d → W) (v : W) : ℝ :=
  ((Finset.univ.filter fun i => loc (a i) = v).card : ℝ) -
    ((Finset.univ.filter fun j => loc (b j) = v).card : ℝ)

/-- Feasible uncapacitated transport flow on `H`: nonnegative, supported on
arcs, and out-flow minus in-flow equals the net supply at every vertex. -/
def IsFeasibleFlow {d n : ℕ} {W : Type} (a b : Fin n → E d) (arcs : Finset (W × W))
    (loc : E d → W) (f : W × W → ℝ) : Prop :=
  (∀ e, 0 ≤ f e) ∧ (∀ e, e ∉ arcs → f e = 0) ∧
  ∀ v : W,
    (∑ e ∈ arcs.filter (fun e => e.1 = v), f e) -
      (∑ e ∈ arcs.filter (fun e => e.2 = v), f e) = supply a b loc v

/-- Length-weighted objective `∑_e len(e) · f(e)`. -/
def flowCost {W : Type} (arcs : Finset (W × W)) (len : W × W → ℝ)
    (f : W × W → ℝ) : ℝ :=
  ∑ e ∈ arcs, len e * f e

/-- `f` is an optimal feasible flow (its cost is `OPT_H`). -/
def IsOptimalFlow {d n : ℕ} {W : Type} (a b : Fin n → E d) (arcs : Finset (W × W))
    (len : W × W → ℝ) (loc : E d → W) (f : W × W → ℝ) : Prop :=
  IsFeasibleFlow a b arcs loc f ∧
  ∀ g, IsFeasibleFlow a b arcs loc g → flowCost arcs len f ≤ flowCost arcs len g

/-- Upper comparison (routing a matching): routing one unit from each `a i` to
`b (σ i)` along a shortest directed walk, for an optimal `σ`, and summing the
(possibly overlapping) routes gives a feasible flow of cost
`≤ (1+η)·EMD(A,B)`. [SubQuadratic1epsApproximate, node_15] -/
theorem route_matching_upper {d n : ℕ} {W : Type} [Fintype W]
    (a b : Fin n → E d) (arcs : Finset (W × W)) (len : W × W → ℝ)
    (loc : E d → W) (η : ℝ) (hη : 0 < η)
    (hlen : ∀ e, 0 ≤ len e)
    (hH : TerminalStretch (terminals a b) arcs len loc η) :
    ∃ f, IsFeasibleFlow a b arcs loc f ∧
      flowCost arcs len f ≤ (1 + η) * emd a b := by
  sorry

/-- Flow decomposition with integrality: every feasible flow costs at least the
total length of some family of directed walks from `loc (a i)` to
`loc (b (σ i))` for a permutation `σ` (integral optimum, cycle cancelling with
nonnegative lengths, unit path decomposition). [SubQuadratic1epsApproximate, node_15] -/
theorem feasible_flow_decomposes {d n : ℕ} {W : Type} [Fintype W]
    (a b : Fin n → E d) (arcs : Finset (W × W)) (len : W × W → ℝ)
    (loc : E d → W) (hlen : ∀ e, 0 ≤ len e) (f : W × W → ℝ)
    (hf : IsFeasibleFlow a b arcs loc f) :
    ∃ (σ : Equiv.Perm (Fin n)) (m : Fin n → ℕ) (p : (i : Fin n) → Fin (m i + 1) → W),
      (∀ i, IsArcWalk arcs (loc (a i)) (loc (b (σ i))) (p i)) ∧
      ∑ i, walkLen len (p i) ≤ flowCost arcs len f := by
  sorry

/-- Lower comparison: by decomposition and terminal noncontraction applied to
complete terminal-to-terminal walks, every feasible flow costs at least
`EMD(A,B)`. [SubQuadratic1epsApproximate, node_15] -/
theorem feasible_flow_lower {d n : ℕ} {W : Type} [Fintype W]
    (a b : Fin n → E d) (arcs : Finset (W × W)) (len : W × W → ℝ)
    (loc : E d → W) (η : ℝ)
    (hlen : ∀ e, 0 ≤ len e)
    (hH : TerminalStretch (terminals a b) arcs len loc η)
    (f : W × W → ℝ) (hf : IsFeasibleFlow a b arcs loc f) :
    emd a b ≤ flowCost arcs len f := by
  sorry

/-- The sparse linear program attains its optimum (it is feasible by
`route_matching_upper` and bounded below by `0`). [SubQuadratic1epsApproximate, node_15] -/
theorem optimal_flow_exists {d n : ℕ} {W : Type} [Fintype W]
    (a b : Fin n → E d) (arcs : Finset (W × W)) (len : W × W → ℝ)
    (loc : E d → W) (η : ℝ) (hη : 0 < η)
    (hlen : ∀ e, 0 ≤ len e)
    (hH : TerminalStretch (terminals a b) arcs len loc η) :
    ∃ f, IsOptimalFlow a b arcs len loc f := by
  sorry

/-- Main theorem (correctness core of the EMD algorithm). Build `H` with internal
accuracy `η = ε/3`. Then the optimum `OPT_H` of the sparse transport problem
satisfies `EMD ≤ OPT_H ≤ (1+ε/3)·EMD`, and every value `V` with
`OPT_H ≤ V ≤ (1+ε/3)·OPT_H` (in particular `V = OPT_H`) satisfies
`EMD(A,B) ≤ V ≤ (1+ε)·EMD(A,B)`. [SubQuadratic1epsApproximate, node_15] -/
theorem emd_approx_via_spanner_flow {d n : ℕ} {W : Type} [Fintype W]
    (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1)
    (a b : Fin n → E d) (arcs : Finset (W × W)) (len : W × W → ℝ)
    (loc : E d → W) (hlen : ∀ e, 0 ≤ len e)
    (hH : TerminalStretch (terminals a b) arcs len loc (ε / 3))
    (f : W × W → ℝ) (hf : IsOptimalFlow a b arcs len loc f) :
    (emd a b ≤ flowCost arcs len f ∧
      flowCost arcs len f ≤ (1 + ε / 3) * emd a b) ∧
    ∀ V : ℝ, flowCost arcs len f ≤ V → V ≤ (1 + ε / 3) * flowCost arcs len f →
      emd a b ≤ V ∧ V ≤ (1 + ε) * emd a b := by
  sorry

end TCSChallenge.SubQuadratic1epsApproximate.node_15
