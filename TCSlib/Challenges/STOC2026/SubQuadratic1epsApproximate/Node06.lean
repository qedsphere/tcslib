/-!
## Quadratic lower bound for Steiner `(1+ε)`-spanners of the Hamming cube

On `{0,1}^d` (here TCSlib's `BoolCube d = Fin d → Bool`) with Hamming distance `h`, there is an absolute `c > 0`
such that for every `ε ∈ (0,1)` and `n ≥ 2` some `n`-point set `P ⊆ {0,1}^d` has the property:
every graph `H = (P ∪ S, E)`, `S ⊆ {0,1}^d`, with edge weights `h(a,b)` and
`h(u,v) ≤ d_H(u,v) ≤ (1+ε) h(u,v)` for `u, v ∈ P`, has `|E| ≥ c n² (1-ε)⁴`.

Main theorem: `hamming_steiner_spanner_lower_bound`.
-/

namespace TCSChallenge.SubQuadratic1epsApproximate.node_06

/-! ## Steiner graphs with metric edge weights (shared with node_08) -/

/-- Weighted length `∑_{i<m} w(p_i, p_{i+1})` of the walk `p 0, …, p m`. -/
def walkLength {X : Type*} (w : X → X → ℝ) {m : ℕ} (p : Fin (m + 1) → X) : ℝ :=
  ∑ i : Fin m, w (p i.castSucc) (p i.succ)

/-- `p 0, …, p m` is a walk from `u` to `v` using only edges of `E`. -/
def IsWalk {X : Type*} (E : Finset (Sym2 X)) {m : ℕ} (p : Fin (m + 1) → X) (u v : X) : Prop :=
  p 0 = u ∧ p (Fin.last m) = v ∧ ∀ i : Fin m, Sym2.mk (p i.castSucc, p i.succ) ∈ E

/-- `d_H(u,v) ≤ L`: "d_H is weighted shortest-path distance, taken to be +∞ when no path
exists"; the shortest path distance is `≤ L` iff some walk has length `≤ L`. -/
def DistLE {X : Type*} (w : X → X → ℝ) (E : Finset (Sym2 X)) (u v : X) (L : ℝ) : Prop :=
  ∃ m : ℕ, ∃ p : Fin (m + 1) → X, IsWalk E p u v ∧ walkLength w p ≤ L

/-- "`w(u,v) ≤ d_H(u,v) ≤ s · w(u,v)` for every `u, v ∈ P`", where `H` has edge set `E` and
edge weights `w(a,b)`. -/
def IsSteinerSpanner {X : Type*} (w : X → X → ℝ) (E : Finset (Sym2 X)) (P : Finset X)
    (s : ℝ) : Prop :=
  (∀ u ∈ P, ∀ v ∈ P, DistLE w E u v (s * w u v)) ∧
  (∀ u ∈ P, ∀ v ∈ P, ∀ m : ℕ, ∀ p : Fin (m + 1) → X, IsWalk E p u v → w u v ≤ walkLength w p)

/-- `E` is the edge set of a simple undirected graph: no loops. -/
def NoLoops {X : Type*} (E : Finset (Sym2 X)) : Prop :=
  ∀ e ∈ E, ¬ e.IsDiag

/-- `l` is a simple path from `x` to `y` in the graph with edge set `E`. -/
def IsPrescribedPath {X : Type*} (E : Finset (Sym2 X)) (x y : X) (l : List X) : Prop :=
  l.head? = some x ∧ l.getLast? = some y ∧ l.Nodup ∧
  ∀ i : ℕ, ∀ h : i + 1 < l.length, Sym2.mk (l[i]'(Nat.lt_of_succ_lt h), l[i + 1]'h) ∈ E

/-- Some vertex `v` lies on `k` prescribed paths `Q x_i y_i` with `x_i ∈ A` pairwise distinct
and `y_i ∈ B` pairwise distinct. -/
def HasKSharedPaths {X : Type*} (Q : X → X → List X) (A B : Finset X) (k : ℕ) : Prop :=
  ∃ v : X, ∃ f : Fin k → X × X,
    (∀ i, (f i).1 ∈ A ∧ (f i).2 ∈ B ∧ v ∈ Q (f i).1 (f i).2) ∧
    Function.Injective (fun i => (f i).1) ∧ Function.Injective (fun i => (f i).2)

/-! ## The Hamming cube -/

/-! The Hamming cube `{0,1}^d` is TCSlib's `BooleanAnalysis.BoolCube d =Fin d → Bool`. -/

/-- Hamming distance `h(x,y) = ∑_j |x_j - y_j|`, as a real number. -/
def hd {d : ℕ} (x y : BoolCube d) : ℝ := (hammingDist x y : ℝ)

/-- The excess `h(x,p) + h(y,p) - h(x,y)`. -/
def excess {d : ℕ} (x y p : BoolCube d) : ℝ := hd x p + hd y p - hd x y

/-- `A_{x,y} = {p : h(x,p) + h(y,p) - h(x,y) ≤ δ d / 2}` with `δ = (1+ε)/2`. -/
def InA {d : ℕ} (ε : ℝ) (x y p : BoolCube d) : Prop :=
  excess x y p ≤ ((1 + ε) / 2) * d / 2

/-! ## Rubric items -/

/-- Graph fact (rubric 1–2): if no `k` prescribed paths with distinct left and distinct right
endpoints share a vertex, then `q² ≤ 2 m k²`. [SubQuadratic1epsApproximate, node_06] -/
theorem graph_fact {X : Type*} (E : Finset (Sym2 X)) (A B : Finset X) (q k : ℕ)
    (hk : 1 ≤ k) (hA : A.card = q) (hB : B.card = q) (hAB : Disjoint A B)
    (Q : X → X → List X) (hQ : ∀ x ∈ A, ∀ y ∈ B, IsPrescribedPath E x y (Q x y))
    (hno : ¬ HasKSharedPaths Q A B k) :
    ((q : ℝ)) ^ 2 ≤ 2 * (E.card : ℝ) * (k : ℝ) ^ 2 := by
  sorry

/-- Excess identity (rubric 3): `h(x,p) + h(y,p) - h(x,y)` is twice the number of coordinates
with `x_j = y_j ≠ p_j`. [SubQuadratic1epsApproximate, node_06] -/
theorem excess_eq {d : ℕ} (x y p : BoolCube d) :
    hammingDist x p + hammingDist y p =
      hammingDist x y + 2 * (Finset.univ.filter (fun j => x j = y j ∧ p j ≠ x j)).card := by
  sorry

/-- Cube probability estimate (rubric 3): for fixed `p` and uniform `x, y`,
`Pr[p ∈ A_{x,y}] ≤ exp(-t² d / 32)` with `t = 1 - ε`, stated by counting the `4^d` pairs. [SubQuadratic1epsApproximate, node_06] -/
theorem cube_prob_bound (d : ℕ) (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1) (p : BoolCube d) :
    ((Finset.univ.filter (fun xy : BoolCube d × BoolCube d => InA ε xy.1 xy.2 p)).card : ℝ) ≤
      Real.exp (-((1 - ε) ^ 2 * d / 32)) * (4 : ℝ) ^ d := by
  sorry

/-- Uniformly good terminal set (rubric 4): with `t = 1 - ε` and `k = ⌈128 / t²⌉`, there is
`P ⊆ {0,1}^d` of exactly `n` points whose pairwise distances lie in `[d/2 - td/4, d/2 + td/4]`
and such that no cube point `p` lies in `A_{x_r,y_r}` for `k` pairs with `2k` distinct
endpoints in `P`. [SubQuadratic1epsApproximate, node_06] -/
theorem good_terminal_set (ε : ℝ) (hε0 : 0 < ε) (hε1 : ε < 1) (n : ℕ) (hn : 2 ≤ n) :
    ∃ d : ℕ, ∃ P : Finset (BoolCube d), P.card = n ∧
      (∀ x ∈ P, ∀ y ∈ P, x ≠ y →
        (d : ℝ) / 2 - (1 - ε) * d / 4 ≤ hd x y ∧ hd x y ≤ (d : ℝ) / 2 + (1 - ε) * d / 4) ∧
      ¬ ∃ p : BoolCube d, ∃ f : Fin ⌈128 / (1 - ε) ^ 2⌉₊ → BoolCube d × BoolCube d,
          (∀ i, (f i).1 ∈ P ∧ (f i).2 ∈ P ∧ InA ε (f i).1 (f i).2 p) ∧
          Function.Injective (Sum.elim (fun i => (f i).1) (fun i => (f i).2)) := by
  sorry

/-- Geometry to paths (rubric 5): every vertex `v` on a walk from `x` to `y` of length
`≤ (1+ε) h(x,y)` satisfies `h(x,v) + h(v,y) ≤ (1+ε) h(x,y)`. [SubQuadratic1epsApproximate, node_06] -/
theorem vertex_on_short_walk {d : ℕ} (E : Finset (Sym2 (BoolCube d))) (x y : BoolCube d) (ε : ℝ)
    (m : ℕ) (p : Fin (m + 1) → BoolCube d) (hp : IsWalk E p x y)
    (hlen : walkLength hd p ≤ (1 + ε) * hd x y) (i : Fin (m + 1)) :
    hd x (p i) + hd (p i) y ≤ (1 + ε) * hd x y := by
  sorry

/-! ## Main theorem -/

/-- There is an absolute `c > 0` such that for every `ε ∈ (0,1)` and `n ≥ 2` there are `d`
and an `n`-point `P ⊆ {0,1}^d` such that every Steiner `(1+ε)`-spanner `H = (P ∪ S, E)` of
`P` with Hamming edge weights has `|E| ≥ c n² (1-ε)⁴`. [SubQuadratic1epsApproximate, node_06] -/
theorem hamming_steiner_spanner_lower_bound :
    ∃ c : ℝ, 0 < c ∧ ∀ ε : ℝ, 0 < ε → ε < 1 → ∀ n : ℕ, 2 ≤ n →
      ∃ d : ℕ, ∃ P : Finset (BoolCube d), P.card = n ∧
        ∀ E : Finset (Sym2 (BoolCube d)), NoLoops E → IsSteinerSpanner hd E P (1 + ε) →
          c * (n : ℝ) ^ 2 * (1 - ε) ^ 4 ≤ (E.card : ℝ) := by
  sorry

end TCSChallenge.SubQuadratic1epsApproximate.node_06
