/-!
## Exact linear sections of a variety cut by degree-`d` equations (node_15)

`X ⊆ 𝕜^n` is irreducible, the zero set of `p = δ binom(n+d-1,d)` linearly independent degree-`d`
forms `f_j`, and `K = span{f_j}^⊥ ⊆ S^d V`. If `0 ≤ s ≤ R ≤ δ(n+d-1)/d!` and (`s = 0` or `X` is
non-degenerate of order `d-1`), then for generic `(v_1,…,v_R) ∈ X^s × V^{R-s}` the `v_i` are
independent, `U ∩ X = ⋃_{i ≤ s} 𝕜 v_i` for `U = span v`, and `S^d U ∩ K = span{v_i^d : i ≤ s}`.
Main theorem: `exact_linear_section`. (Indices 0-based: `i.val < s` means `i ≤ s`.)
-/

namespace TCSChallenge.ComputingLinearSectionsOf.node_15

variable {𝕜 : Type} [RCLike 𝕜]

/-- The symmetrisation of `v_1 ⊗ ⋯ ⊗ v_d` (without the factor `1/d!`), as an element of the
full tensor space `(𝕜^n)^{⊗ d} ≅ (Fin d → Fin n) → 𝕜`. -/
def symProd {n d : ℕ} (v : Fin d → Fin n → 𝕜) : (Fin d → Fin n) → 𝕜 :=
  fun idx => ∑ σ : Equiv.Perm (Fin d), ∏ j : Fin d, v (σ j) (idx j)

variable (𝕜) in
/-- `S^d(V)`: the span of all symmetrised pure tensors (equal to the symmetric tensors in
characteristic zero). -/
def symTensors (n d : ℕ) : Submodule 𝕜 ((Fin d → Fin n) → 𝕜) :=
  Submodule.span 𝕜 (Set.range (fun v : Fin d → Fin n → 𝕜 => symProd v))

/-- `codim_{S^d(V)} K` for a subspace `K ≤ S^d(V)`. -/
def symCodim {n d : ℕ} (K : Submodule 𝕜 ((Fin d → Fin n) → 𝕜)) : ℕ :=
  Module.finrank 𝕜 (symTensors 𝕜 n d) - Module.finrank 𝕜 K

/-- "A conic variety in `V` is a nonempty algebraic set defined by homogeneous polynomials." -/
def IsConicVariety {n : ℕ} (X : Set (Fin n → 𝕜)) : Prop :=
  X.Nonempty ∧ ∃ S : Set (MvPolynomial (Fin n) 𝕜),
    (∀ f ∈ S, ∃ t : ℕ, f.IsHomogeneous t) ∧
    X = {x | ∀ f ∈ S, MvPolynomial.eval x f = 0}

/-- "Non-degenerate of order `t`: on each irreducible component no nonzero homogeneous
polynomial of degree `t` vanishes identically." Stated equivalently: no nonzero degree-`t`
homogeneous polynomial vanishes on a nonempty relatively open set `X ∩ {g ≠ 0}`. -/
def IsNondegOfOrder {n : ℕ} (X : Set (Fin n → 𝕜)) (t : ℕ) : Prop :=
  ∀ g : MvPolynomial (Fin n) 𝕜, (∃ x ∈ X, MvPolynomial.eval x g ≠ 0) →
    ∀ f : MvPolynomial (Fin n) 𝕜, f.IsHomogeneous t →
      (∀ x ∈ X, MvPolynomial.eval x g ≠ 0 → MvPolynomial.eval x f = 0) → f = 0

/-- Evaluate a polynomial in the `R · n` coordinates of a tuple `(v_1, …, v_R) ∈ V^R`. -/
def tupleEval {R n : ℕ} (g : MvPolynomial (Fin R × Fin n) 𝕜) (v : Fin R → Fin n → 𝕜) : 𝕜 :=
  MvPolynomial.eval (fun p : Fin R × Fin n => v p.1 p.2) g

/-- "`P` holds for a generic tuple of `Y`": `P` holds on a Zariski-open set `Y ∩ {g ≠ 0}`
which is dense in `Y` (every polynomial vanishing on it vanishes on `Y`). -/
def GenericOn {R n : ℕ} (Y : Set (Fin R → Fin n → 𝕜)) (P : (Fin R → Fin n → 𝕜) → Prop) :
    Prop :=
  ∃ g : MvPolynomial (Fin R × Fin n) 𝕜,
    (∀ h : MvPolynomial (Fin R × Fin n) 𝕜,
      (∀ v ∈ Y, tupleEval g v ≠ 0 → tupleEval h v = 0) → ∀ v ∈ Y, tupleEval h v = 0) ∧
    (∀ v ∈ Y, tupleEval g v ≠ 0 → P v)

/-- `a ∈ [R]^{∨d} \ Δ_s`: `a` is nondecreasing and not a pure tuple `(i,…,i)` with `i < s`. -/
def IsAdmissibleIndex {R d : ℕ} (s : ℕ) (a : Fin d → Fin R) : Prop :=
  Monotone a ∧ ¬ (∃ i : Fin R, i.val < s ∧ ∀ j, a j = i)

/-- The span `span{v_{a_1} ∨ ⋯ ∨ v_{a_d} : a ∈ [R]^{∨d} \ Δ_s}`. -/
def admissibleSpan {R n : ℕ} (d s : ℕ) (v : Fin R → Fin n → 𝕜) :
    Submodule 𝕜 ((Fin d → Fin n) → 𝕜) :=
  Submodule.span 𝕜
    {T : (Fin d → Fin n) → 𝕜 | ∃ a : Fin d → Fin R, IsAdmissibleIndex s a ∧
      T = symProd (fun j => v (a j))}

/-- The exponent vector of the monomial `x_{idx 1} ⋯ x_{idx d}`. -/
def monoOf {n d : ℕ} (idx : Fin d → Fin n) : Fin n →₀ ℕ :=
  ∑ j : Fin d, Finsupp.single (idx j) 1

/-- The pairing `⟨f, T⟩` of a polynomial with a tensor, normalised so that
`⟨f, v^{⊗d}⟩ = f(v)` for `f` homogeneous of degree `d`: the coefficient of a monomial is spread
evenly over the index tuples `idx` realising it. -/
def polyPairing {n d : ℕ} (f : MvPolynomial (Fin n) 𝕜) : ((Fin d → Fin n) → 𝕜) →ₗ[𝕜] 𝕜 :=
  ∑ idx : Fin d → Fin n,
    (MvPolynomial.coeff (monoOf idx) f /
      ((Finset.univ.filter (fun idx' : Fin d → Fin n => monoOf idx' = monoOf idx)).card : 𝕜)) •
      LinearMap.proj idx

/-- `K = (span{f_1, …, f_p})^⊥ ⊆ S^d V`. -/
def eqAnnihilator {n p : ℕ} (d : ℕ) (f : Fin p → MvPolynomial (Fin n) 𝕜) :
    Submodule 𝕜 ((Fin d → Fin n) → 𝕜) :=
  symTensors 𝕜 n d ⊓ ⨅ j : Fin p, LinearMap.ker (polyPairing (d := d) (f j))

/-- `S^d(U)` for `U = span{v_1, …, v_R}`: the span of all degree-`d` symmetric products. -/
def liftedSym {R n : ℕ} (d : ℕ) (v : Fin R → Fin n → 𝕜) : Submodule 𝕜 ((Fin d → Fin n) → 𝕜) :=
  Submodule.span 𝕜 (Set.range (fun a : Fin d → Fin R => symProd (fun j => v (a j))))

/-- Irreducibility of an algebraic set: its vanishing ideal is prime. -/
def IsIrreducibleAlg {n : ℕ} (X : Set (Fin n → 𝕜)) : Prop :=
  X.Nonempty ∧ ∀ g h : MvPolynomial (Fin n) 𝕜,
    (∀ x ∈ X, MvPolynomial.eval x (g * h) = 0) →
      (∀ x ∈ X, MvPolynomial.eval x g = 0) ∨ (∀ x ∈ X, MvPolynomial.eval x h = 0)

/-- Auxiliary generic-independence statement (Step 2 of the reference proof; identical to the
main theorem of node_14). [ComputingLinearSectionsOf, node_15] -/
theorem generic_independence (n d R s : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) (hR : 1 ≤ R) (hs : s ≤ R)
    (K : Submodule 𝕜 ((Fin d → Fin n) → 𝕜)) (hK : K ≤ symTensors 𝕜 n d)
    (X : Fin R → Set (Fin n → 𝕜)) (hX : ∀ i, IsConicVariety (X i))
    (hlow : ∀ i : Fin R, i.val < s → IsNondegOfOrder (X i) (d - 1))
    (hhigh : ∀ i : Fin R, s ≤ i.val → IsNondegOfOrder (X i) d)
    (hcodim : R * (d - 1).factorial * (n + d - 2).choose (d - 1) ≤ symCodim K) :
    GenericOn {v : Fin R → Fin n → 𝕜 | ∀ i, v i ∈ X i}
      (fun v => LinearIndependent 𝕜
        (fun a : {a : Fin d → Fin R // IsAdmissibleIndex s a} =>
          K.mkQ (symProd (fun j => v (a.1 j))))) := by
  sorry

/-- `codim K = p` for linearly independent degree-`d` forms. [ComputingLinearSectionsOf, node_15] -/
theorem symCodim_eqAnnihilator (n d p : ℕ) (f : Fin p → MvPolynomial (Fin n) 𝕜)
    (hf_hom : ∀ j, (f j).IsHomogeneous d) (hf_li : LinearIndependent 𝕜 f) :
    symCodim (eqAnnihilator d f) = p := by
  sorry

/-- The numerical check (8): `p ≥ R (d-1)! binom(n+d-2, d-1)`. [ComputingLinearSectionsOf, node_15] -/
theorem codim_check (n d p R : ℕ) (δ : ℝ) (hn : 1 ≤ n) (hd : 2 ≤ d)
    (hp : (p : ℝ) = δ * ((n + d - 1).choose d : ℝ))
    (hR : (R : ℝ) ≤ δ * ((n + d - 1 : ℕ) : ℝ) / (d.factorial : ℝ)) :
    R * (d - 1).factorial * (n + d - 2).choose (d - 1) ≤ p := by
  sorry

/-- Pure powers of points of `X` lie in `K`: `x ∈ X ↔ x^d ∈ K`. [ComputingLinearSectionsOf, node_15] -/
theorem pure_power_mem_iff (n d p : ℕ) (f : Fin p → MvPolynomial (Fin n) 𝕜)
    (hf_hom : ∀ j, (f j).IsHomogeneous d) (x : Fin n → 𝕜) :
    (∀ j, MvPolynomial.eval x (f j) = 0) ↔
      symProd (fun _ : Fin d => x) ∈ eqAnnihilator d f := by
  sorry

/-- **Main theorem (node_15).** For generic `(v_1,…,v_R) ∈ X^s × V^{R-s}`: the `v_i` are
linearly independent, `U ∩ X = ⋃_{i ≤ s} 𝕜 v_i` (just `{0}` when `s = 0`), and the lifted
intersection `M = S^d U ∩ K` is exactly `span{v_1^d, …, v_s^d}`. [ComputingLinearSectionsOf, node_15] -/
theorem exact_linear_section (n d p R s : ℕ) (δ : ℝ) (hn : 1 ≤ n) (hd : 2 ≤ d)
    (hδ0 : 0 < δ) (hδ1 : δ < 1) (hp : (p : ℝ) = δ * ((n + d - 1).choose d : ℝ))
    (f : Fin p → MvPolynomial (Fin n) 𝕜) (hf_hom : ∀ j, (f j).IsHomogeneous d)
    (hf_li : LinearIndependent 𝕜 f)
    (X : Set (Fin n → 𝕜)) (hXdef : X = {x | ∀ j, MvPolynomial.eval x (f j) = 0})
    (hirr : IsIrreducibleAlg X)
    (hsR : s ≤ R) (hR : (R : ℝ) ≤ δ * ((n + d - 1 : ℕ) : ℝ) / (d.factorial : ℝ))
    (hnd : s = 0 ∨ IsNondegOfOrder X (d - 1)) :
    GenericOn {v : Fin R → Fin n → 𝕜 | ∀ i : Fin R, i.val < s → v i ∈ X}
      (fun v => LinearIndependent 𝕜 v ∧
        ((Submodule.span 𝕜 (Set.range v) : Set (Fin n → 𝕜)) ∩ X =
          {0} ∪ ⋃ (i : Fin R) (_ : i.val < s),
            ((Submodule.span 𝕜 {v i} : Submodule 𝕜 (Fin n → 𝕜)) : Set (Fin n → 𝕜))) ∧
        liftedSym d v ⊓ eqAnnihilator d f =
          Submodule.span 𝕜
            {T : (Fin d → Fin n) → 𝕜 | ∃ i : Fin R, i.val < s ∧ T = symProd (fun _ : Fin d => v i)}) := by
  sorry

end TCSChallenge.ComputingLinearSectionsOf.node_15
