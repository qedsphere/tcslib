/-!
## Generic avoidance of a subspace by symmetric products (node_14)

Let `V = 𝕜^n`, `K ⊆ S^d(V)` with `codim K ≥ R (d-1)! binom(n+d-2, d-1)`, and let
`X_1, …, X_R` be conic varieties, `X_i` non-degenerate of order `d-1` for `i ≤ s` and of
order `d` for `i > s`. Then for a generic `(v_1, …, v_R) ∈ X_1 × ⋯ × X_R` the span of the
products `v_{a_1} ∨ ⋯ ∨ v_{a_d}`, `a` nondecreasing and not a pure tuple `(i,…,i)` with
`i ≤ s`, meets `K` only in `0`. Main theorem: `span_symProducts_inf_K_eq_bot`.
(Indices are 0-based in Lean: `i.val < s` plays the role of `1 ≤ i ≤ s`.)
-/

namespace TCSChallenge.ComputingLinearSectionsOf.node_14

variable {𝕜 : Type} [RCLike 𝕜]

/-- The symmetrisation of `v_1 ⊗ ⋯ ⊗ v_d` (without the factor `1/d!`), as an element of the
full tensor space `(𝕜^n)^{⊗ d} ≅ (Fin d → Fin n) → 𝕜`. -/
def symProd {n d : ℕ} (v : Fin d → Fin n → 𝕜) : (Fin d → Fin n) → 𝕜 :=
  fun idx => ∑ σ : Equiv.Perm (Fin d), ∏ j : Fin d, v (σ j) (idx j)

variable (𝕜) in
/-- `S^d(V)`: the span of all symmetrised pure tensors (equal to the symmetric tensors in
characteristic zero). -/
def symTensors (n d : ℕ) : Submodule 𝕜 ((Fin d → Fin n) → 𝕜) :=
  Submodule.span 𝕜 (Set.range (fun v : Fin d → Fin n → 𝕜 => symProd v))

/-- `codim_{S^d(V)} K` for a subspace `K ≤ S^d(V)`. -/
def symCodim {n d : ℕ} (K : Submodule 𝕜 ((Fin d → Fin n) → 𝕜)) : ℕ :=
  Module.finrank 𝕜 (symTensors 𝕜 n d) - Module.finrank 𝕜 K

/-- "A conic variety in `V` is a nonempty algebraic set defined by homogeneous polynomials." -/
def IsConicVariety {n : ℕ} (X : Set (Fin n → 𝕜)) : Prop :=
  X.Nonempty ∧ ∃ S : Set (MvPolynomial (Fin n) 𝕜),
    (∀ f ∈ S, ∃ t : ℕ, f.IsHomogeneous t) ∧
    X = {x | ∀ f ∈ S, MvPolynomial.eval x f = 0}

/-- "Non-degenerate of order `t`: on each irreducible component no nonzero homogeneous
polynomial of degree `t` vanishes identically." Stated equivalently: no nonzero degree-`t`
homogeneous polynomial vanishes on a nonempty relatively open set `X ∩ {g ≠ 0}`. -/
def IsNondegOfOrder {n : ℕ} (X : Set (Fin n → 𝕜)) (t : ℕ) : Prop :=
  ∀ g : MvPolynomial (Fin n) 𝕜, (∃ x ∈ X, MvPolynomial.eval x g ≠ 0) →
    ∀ f : MvPolynomial (Fin n) 𝕜, f.IsHomogeneous t →
      (∀ x ∈ X, MvPolynomial.eval x g ≠ 0 → MvPolynomial.eval x f = 0) → f = 0

/-- Evaluate a polynomial in the `R · n` coordinates of a tuple `(v_1, …, v_R) ∈ V^R`. -/
def tupleEval {R n : ℕ} (g : MvPolynomial (Fin R × Fin n) 𝕜) (v : Fin R → Fin n → 𝕜) : 𝕜 :=
  MvPolynomial.eval (fun p : Fin R × Fin n => v p.1 p.2) g

/-- "`P` holds for a generic tuple of `Y`": `P` holds on a Zariski-open set `Y ∩ {g ≠ 0}`
which is dense in `Y` (every polynomial vanishing on it vanishes on `Y`). -/
def GenericOn {R n : ℕ} (Y : Set (Fin R → Fin n → 𝕜)) (P : (Fin R → Fin n → 𝕜) → Prop) :
    Prop :=
  ∃ g : MvPolynomial (Fin R × Fin n) 𝕜,
    (∀ h : MvPolynomial (Fin R × Fin n) 𝕜,
      (∀ v ∈ Y, tupleEval g v ≠ 0 → tupleEval h v = 0) → ∀ v ∈ Y, tupleEval h v = 0) ∧
    (∀ v ∈ Y, tupleEval g v ≠ 0 → P v)

/-- `a ∈ [R]^{∨d} \ Δ_s`: `a` is nondecreasing and not a pure tuple `(i,…,i)` with `i < s`. -/
def IsAdmissibleIndex {R d : ℕ} (s : ℕ) (a : Fin d → Fin R) : Prop :=
  Monotone a ∧ ¬ (∃ i : Fin R, i.val < s ∧ ∀ j, a j = i)

/-- The span `span{v_{a_1} ∨ ⋯ ∨ v_{a_d} : a ∈ [R]^{∨d} \ Δ_s}`. -/
def admissibleSpan {R n : ℕ} (d s : ℕ) (v : Fin R → Fin n → 𝕜) :
    Submodule 𝕜 ((Fin d → Fin n) → 𝕜) :=
  Submodule.span 𝕜
    {T : (Fin d → Fin n) → 𝕜 | ∃ a : Fin d → Fin R, IsAdmissibleIndex s a ∧
      T = symProd (fun j => v (a j))}

/-- Non-degeneracy passes to lower orders. [ComputingLinearSectionsOf, node_14] -/
theorem nondeg_mono {n : ℕ} (X : Set (Fin n → 𝕜)) (t u : ℕ) (hut : u ≤ t)
    (hX : IsNondegOfOrder X t) : IsNondegOfOrder X u := by
  sorry

/-- If `X` is non-degenerate of order `u`, its `u`-th powers span `S^u(V)`. [ComputingLinearSectionsOf, node_14] -/
theorem span_powers_eq {n : ℕ} (X : Set (Fin n → 𝕜)) (u : ℕ) (hX : IsNondegOfOrder X u) :
    Submodule.span 𝕜 {T : (Fin u → Fin n) → 𝕜 | ∃ x ∈ X, T = symProd (fun _ : Fin u => x)} =
      symTensors 𝕜 n u := by
  sorry

/-- The binomial comparison (8): `B_d binom(d-1, ℓ) ≥ B_m N_ℓ` with `m = d - ℓ`,
`B_q = binom(n+q-2, q-1)`, `N_ℓ = binom(n+ℓ-1, ℓ)`. [ComputingLinearSectionsOf, node_14] -/
theorem binom_comparison (n d ℓ : ℕ) (hn : 1 ≤ n) (hl : 1 ≤ ℓ) (hld : ℓ < d) :
    (n + (d - ℓ) - 2).choose (d - ℓ - 1) * (n + ℓ - 1).choose ℓ ≤
      (n + d - 2).choose (d - 1) * (d - 1).choose ℓ := by
  sorry

/-- Stronger form: generically the classes of the admissible products are linearly
independent in `(V^{⊗d}) / K`. [ComputingLinearSectionsOf, node_14] -/
theorem independent_mod_K (n d R s : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) (hR : 1 ≤ R) (hs : s ≤ R)
    (K : Submodule 𝕜 ((Fin d → Fin n) → 𝕜)) (hK : K ≤ symTensors 𝕜 n d)
    (X : Fin R → Set (Fin n → 𝕜)) (hX : ∀ i, IsConicVariety (X i))
    (hlow : ∀ i : Fin R, i.val < s → IsNondegOfOrder (X i) (d - 1))
    (hhigh : ∀ i : Fin R, s ≤ i.val → IsNondegOfOrder (X i) d)
    (hcodim : R * (d - 1).factorial * (n + d - 2).choose (d - 1) ≤ symCodim K) :
    GenericOn {v : Fin R → Fin n → 𝕜 | ∀ i, v i ∈ X i}
      (fun v => LinearIndependent 𝕜
        (fun a : {a : Fin d → Fin R // IsAdmissibleIndex s a} =>
          K.mkQ (symProd (fun j => v (a.1 j))))) := by
  sorry

/-- **Main theorem (node_14).** Under the codimension bound, for a generic tuple
`(v_1,…,v_R) ∈ X_1 × ⋯ × X_R`, `span{v_{a_1} ∨ ⋯ ∨ v_{a_d} : a ∈ [R]^{∨d} \ Δ_s} ∩ K = {0}`. [ComputingLinearSectionsOf, node_14] -/
theorem span_symProducts_inf_K_eq_bot (n d R s : ℕ) (hn : 1 ≤ n) (hd : 1 ≤ d) (hR : 1 ≤ R)
    (hs : s ≤ R)
    (K : Submodule 𝕜 ((Fin d → Fin n) → 𝕜)) (hK : K ≤ symTensors 𝕜 n d)
    (X : Fin R → Set (Fin n → 𝕜)) (hX : ∀ i, IsConicVariety (X i))
    (hlow : ∀ i : Fin R, i.val < s → IsNondegOfOrder (X i) (d - 1))
    (hhigh : ∀ i : Fin R, s ≤ i.val → IsNondegOfOrder (X i) d)
    (hcodim : R * (d - 1).factorial * (n + d - 2).choose (d - 1) ≤ symCodim K) :
    GenericOn {v : Fin R → Fin n → 𝕜 | ∀ i, v i ∈ X i}
      (fun v => admissibleSpan d s v ⊓ K = ⊥) := by
  sorry

end TCSChallenge.ComputingLinearSectionsOf.node_14
