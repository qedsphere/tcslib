/-!
## Fixed-set uniformity of tornado tabulation hashing

Characters are `Σ = {0,1}^w` (here `Ch w = Fin w → ZMod 2`, so `⊕` is `+`), `s = 2^w`.
Derivation tables `T i` (`i = 0..d`) define simple tabulation functions
`h̃_i : Σ^{c+i-1} → Σ`; the derived key `x̃ ∈ Σ^{c+d}` keeps `x_1..x_{c-1}`, twists the
last character `x̃_c = x_c ⊕ h̃_0(x_1..x_{c-1})`, and appends
`x̃_j = h̃_{j-c}(x̃_1..x̃_{j-1})`. A final simple tabulation `ĥ : Σ^{c+d} → R` is applied.

Main theorem `tornado_fixed_set_uniform`: for every fixed key set `X` with `|X| = n ≤ s/2`
there is an event `G` on the derivation tables with
`Pr[G] ≥ 1 - 7 n³ (3/s)^{d+1} - 2^{-s/2}` such that for every derivation realization in `G`
the vector `(h(x))_{x∈X}` is uniform on `R^X` over the final tables.
-/

namespace TCSChallenge.LocallyUniformHashing.node_06

/-- A character of `Σ = {0,1}^w`; addition is bitwise exclusive-or. -/
abbrev Ch (w : ℕ) := Fin w → ZMod 2

/-- An output value in `R = {0,1}^r`. -/
abbrev Out (r : ℕ) := Fin r → ZMod 2

/-- Derivation tables: stage `i ∈ {0,…,d}`, position `j`, character ↦ character.
Stage `i` reads only positions `j < c + i - 1`. -/
abbrev DerivTables (w c d : ℕ) := Fin (d + 1) → Fin (c + d) → Ch w → Ch w

/-- Final tables of `ĥ : Σ^{c+d} → R`. -/
abbrev FinalTables (w r c d : ℕ) := Fin (c + d) → Ch w → Out r

/-- Simple tabulation applied to a string `y` (a list of length `≤ m`):
`y ↦ ⊕_{j < |y|} U_j[y_j]`; the empty xor is `0`. -/
def tab {w m : ℕ} {α : Type} [AddCommMonoid α] (U : Fin m → Ch w → α) (y : List (Ch w)) : α :=
  ∑ j : Fin m, if j.val < y.length then U j (y.getD j.val 0) else 0

/-- The derived prefix after stage `k`, a list of length `c + k`.
Stage 0: `x_1..x_{c-1}` followed by `x_c ⊕ h̃_0(x_1..x_{c-1})`.
Stage `k+1 ≤ d`: append `h̃_{k+1}` of the current prefix. -/
def derivePrefix {w c d : ℕ} (T : DerivTables w c d) (x : Fin c → Ch w) : ℕ → List (Ch w)
  | 0 =>
      let pre := (List.ofFn x).take (c - 1)
      pre ++ [(List.ofFn x).getD (c - 1) 0 + tab (T 0) pre]
  | k + 1 =>
      let L := derivePrefix T x k
      L ++ [if hk : k + 1 < d + 1 then tab (T ⟨k + 1, hk⟩) L else 0]

/-- The derived key `x̃ = h̃(x) ∈ Σ^{c+d}`. -/
def derivedKey {w c d : ℕ} (T : DerivTables w c d) (x : Fin c → Ch w) : Fin (c + d) → Ch w :=
  fun j => (derivePrefix T x d).getD j.val 0

/-- The full hash `h(x) = ĥ(h̃(x))`. -/
def hash {w r c d : ℕ} (T : DerivTables w c d) (F : FinalTables w r c d)
    (x : Fin c → Ch w) : Out r :=
  ∑ j : Fin (c + d), F j (derivedKey T x j)

/-- Incidence vector of a string `y ∈ Σ^m` over position-characters `(j, a)`. -/
def incidence {w m : ℕ} (y : Fin m → Ch w) : Fin m × Ch w → ZMod 2 :=
  fun p => if y p.1 = p.2 then 1 else 0

/-- The structural good event: the incidence vectors of the derived keys of `X` are linearly
independent over `𝔽₂`. -/
def DerivedIndependent {w c d : ℕ} (X : Finset (Fin c → Ch w)) (T : DerivTables w c d) : Prop :=
  LinearIndependent (ZMod 2) (fun x : ↥X => incidence (derivedKey T x.1))

/-- Probability of an event on the (uniform) derivation tables. -/
def probDeriv {w c d : ℕ} (G : DerivTables w c d → Prop) : ℝ :=
  ((Finset.univ.filter G).card : ℝ) / (Fintype.card (DerivTables w c d) : ℝ)

/-- For a fixed derivation realization `T`, the vector `(h(x))_{x∈X}` is uniform on `R^X`
over uniformly random final tables: every target `v : X → R` is hit by exactly
`|FinalTables| / |R|^{|X|}` final tables. -/
def FinalUniformOn {w r c d : ℕ} (X : Finset (Fin c → Ch w)) (T : DerivTables w c d) : Prop :=
  ∀ v : ↥X → Out r,
    (Finset.univ.filter (fun F : FinalTables w r c d => ∀ x : ↥X, hash T F x.1 = v x)).card
        * (2 ^ r) ^ X.card = Fintype.card (FinalTables w r c d)

/-! ## Lemma stubs -/

/-- The derivation is injective: the unchanged prefix determines the twist, so `x_c` can be
recovered, and appending characters preserves distinctness. [LocallyUniformHashing, node_06] -/
theorem derivedKey_injective {w c d : ℕ} (hc : 1 ≤ c) (T : DerivTables w c d) :
    Function.Injective (derivedKey T) := by sorry

/-- Even-multiplicity certificates: a binary dependence among the derived incidence vectors
is the same as a nonempty subset of keys in which every position-character occurs an even
number of times. [LocallyUniformHashing, node_06] -/
theorem not_independent_iff_even_certificate {w c d : ℕ}
    (X : Finset (Fin c → Ch w)) (T : DerivTables w c d) :
    ¬ DerivedIndependent X T ↔
      ∃ Y : Finset (Fin c → Ch w), Y ⊆ X ∧ Y.Nonempty ∧
        ∀ (j : Fin (c + d)) (a : Ch w),
          (Y.filter (fun x => derivedKey T x j = a)).card % 2 = 0 := by sorry

/-- Algebraic transfer: for a fixed derivation realization, independence of the derived
incidence vectors makes `(h(x))_{x∈X}` uniform on `R^X` over the final tables. [LocallyUniformHashing, node_06] -/
theorem finalUniform_of_independent {w r c d : ℕ} (hc : 1 ≤ c)
    (X : Finset (Fin c → Ch w)) (T : DerivTables w c d) (hT : DerivedIndependent X T) :
    FinalUniformOn (r := r) X T := by sorry

/-- The quantitative bottleneck: the derived incidence vectors of a fixed key set of size
`n ≤ s/2` are dependent with probability at most `7 n³ (3/s)^{d+1} + 2^{-s/2}`. [LocallyUniformHashing, node_06] -/
theorem prob_dependent_le {w c d : ℕ} (hw : 1 ≤ w) (hc : 1 ≤ c)
    (X : Finset (Fin c → Ch w)) (hn : 2 * X.card ≤ 2 ^ w) :
    probDeriv (fun T : DerivTables w c d => ¬ DerivedIndependent X T) ≤
      7 * (X.card : ℝ) ^ 3 * (3 / (2 ^ w : ℝ)) ^ (d + 1)
        + (2 : ℝ) ^ (-((2 ^ w : ℕ) : ℝ) / 2) := by sorry

/-! ## Main theorem -/

/-- Fixed-set uniformity of tornado tabulation hashing: there is an event `G` determined by
the derivation tables only, with `Pr[G] ≥ 1 - 7 n³ (3/s)^{d+1} - 2^{-s/2}`, on which the
final tables make `(h(x))_{x∈X}` uniform on `R^X`. [LocallyUniformHashing, node_06] -/
theorem tornado_fixed_set_uniform (w r c d : ℕ) (hw : 1 ≤ w) (hr : 1 ≤ r) (hc : 1 ≤ c)
    (X : Finset (Fin c → Ch w)) (hn : 2 * X.card ≤ 2 ^ w) :
    ∃ G : DerivTables w c d → Prop,
      1 - 7 * (X.card : ℝ) ^ 3 * (3 / (2 ^ w : ℝ)) ^ (d + 1)
          - (2 : ℝ) ^ (-((2 ^ w : ℕ) : ℝ) / 2) ≤ probDeriv G ∧
      ∀ T, G T → FinalUniformOn (r := r) X T := by sorry

end TCSChallenge.LocallyUniformHashing.node_06
