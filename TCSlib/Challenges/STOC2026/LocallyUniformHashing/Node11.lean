/-!
## Local uniformity of tabulation hashing with derived characters (node_11)

Let `Σ = 𝔽₂^a`, `q = 2^a`.  Keys `x ∈ U = Σ^c` are mapped to derived keys
`x̃ ∈ Σ^(c+d)` by random simple-tabulation functions `g_i`, and hashed by
`h(x) = ⊕_j T_j[x̃_j] ∈ 𝔽₂^(s+t)`, split into the first `s` bits `h^(s)` and the
last `t` bits `h^(t)`.  A selector `f` picks the set
`X = {x : f(x, h^(s)(x), h^(s)|_Q) = 1}`.

Main theorem `TCSChallenge.LocallyUniformHashing.node_11.local_uniformity`:
there are random data `D` (a function of all tables) determining `X`, and an event
`G` on the values of `D` with `Pr(D ∈ G) ≥ 1 - B(μ,d,q)`, such that on every
positive-probability `δ ∈ G` the free bits `h^(t)` are uniform on `X(δ)`.

The probability space is the finite set of all table assignments with the uniform
(counting) measure.
-/

namespace TCSChallenge.LocallyUniformHashing.node_11

/-- The alphabet `Σ = 𝔽₂^a`; addition is bitwise XOR. -/
abbrev Sig (a : ℕ) : Type := Fin a → ZMod 2

/-- Uniform (counting) probability of an event on a finite sample space. -/
def prob {Ω : Type} [Fintype Ω] (E : Ω → Prop) : ℝ :=
  ((Finset.univ.filter E).card : ℝ) / (Fintype.card Ω : ℝ)

/-- All random tables: the derived-character tables `A_{i,j} : Σ → Σ`
(`0 ≤ i ≤ d`, only `j < c+i-1` used, 0-indexed) and the final tables
`T_j : Σ → 𝔽₂^(s+t)` (`1 ≤ j ≤ c+d`, here 0-indexed). -/
abbrev Tables (a c d w : ℕ) : Type :=
  (Fin (d + 1) → Fin (c + d) → Sig a → Sig a) × (Fin (c + d) → Sig a → Fin w → ZMod 2)

instance instFintypeTables (a c d w : ℕ) : Fintype (Tables a c d w) := by
  haveI h1 : Fintype (ZMod 2) := ZMod.fintype 2
  haveI h2 : Fintype (Sig a) := Pi.instFintype
  haveI h3 : DecidableEq (Sig a) := Classical.decEq _
  haveI h4 : Fintype (Sig a → Sig a) := Pi.instFintype
  haveI h5 : Fintype (Fin (c + d) → Sig a → Sig a) := Pi.instFintype
  haveI h6 : Fintype (Fin (d + 1) → Fin (c + d) → Sig a → Sig a) := Pi.instFintype
  haveI h7 : Fintype (Fin w → ZMod 2) := Pi.instFintype
  haveI h8 : Fintype (Sig a → Fin w → ZMod 2) := Pi.instFintype
  haveI h9 : Fintype (Fin (c + d) → Sig a → Fin w → ZMod 2) := Pi.instFintype
  exact inferInstanceAs (Fintype (_ × _))

/-- Access to the derived table `A_{i,j}` by natural-number indices (zero outside the
array, never used). -/
def Aat {a c d : ℕ} (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a) (i j : ℕ) :
    Sig a → Sig a :=
  if hi : i < d + 1 then (if hj : j < c + d then A ⟨i, hi⟩ ⟨j, hj⟩ else fun _ => 0)
  else fun _ => 0

/-- Extension of a key `x ∈ Σ^c` by zeros to `ℕ → Σ`. -/
def keyExt {a c : ℕ} (x : Fin c → Sig a) (j : ℕ) : Sig a :=
  if h : j < c then x ⟨j, h⟩ else 0

/-- The `k`-th (0-indexed) derived character, given the previous ones `p 0, …, p (k-1)`:
* `x̃_{k} = x_k` for `k+1 < c`;
* `x̃_{c-1} = x_{c-1} ⊕ g_0(x_0,…,x_{c-2})`, `g_0(z) = ⊕_{j < c-1} A_{0,j}[z_j]`;
* `x̃_{c-1+i} = g_i(x̃_0,…,x̃_{c+i-2}) = ⊕_{j < c+i-1} A_{i,j}[x̃_j]` for `1 ≤ i ≤ d`. -/
def nextChar {a c d : ℕ} (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a)
    (x : Fin c → Sig a) (k : ℕ) (p : ℕ → Sig a) : Sig a :=
  if k + 1 < c then keyExt x k
  else if k + 1 = c then keyExt x k + ∑ j ∈ Finset.range k, Aat A 0 j (p j)
  else ∑ j ∈ Finset.range k, Aat A (k + 1 - c) j (p j)

/-- The first `k` derived characters (entries at positions `≥ k` are zero). -/
def derivedPrefix {a c d : ℕ} (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a)
    (x : Fin c → Sig a) : ℕ → ℕ → Sig a
  | 0 => fun _ => 0
  | k + 1 => fun j =>
      if j < k then derivedPrefix A x k j
      else if j = k then nextChar A x k (derivedPrefix A x k) else 0

/-- The derived key `x̃ ∈ Σ^(c+d)`. -/
def derived {a c d : ℕ} (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a)
    (x : Fin c → Sig a) : Fin (c + d) → Sig a :=
  fun j => derivedPrefix A x (c + d) j.val

/-- `h(x) = ⊕_{j} T_j[x̃_j] ∈ 𝔽₂^(s+t)`. -/
def hashFull {a c d s t : ℕ} (ω : Tables a c d (s + t)) (x : Fin c → Sig a) :
    Fin (s + t) → ZMod 2 :=
  ∑ j : Fin (c + d), ω.2 j (derived ω.1 x j)

/-- The selection bits `h^(s)(x)`: the first `s` output bits. -/
def hashS {a c d s t : ℕ} (ω : Tables a c d (s + t)) (x : Fin c → Sig a) :
    Fin s → ZMod 2 :=
  fun k => hashFull ω x (Fin.castAdd t k)

/-- The free bits `h^(t)(x)`: the last `t` output bits. -/
def hashT {a c d s t : ℕ} (ω : Tables a c d (s + t)) (x : Fin c → Sig a) :
    Fin t → ZMod 2 :=
  fun k => hashFull ω x (Fin.natAdd s k)

/-- The selected set `X = {x ∈ U : f(x, h^(s)(x), h^(s)|_Q) = 1}`. -/
def selected {a c d s t : ℕ} (Q : Finset (Fin c → Sig a))
    (f : (Fin c → Sig a) → (Fin s → ZMod 2) → (↥Q → Fin s → ZMod 2) → Bool)
    (ω : Tables a c d (s + t)) : Finset (Fin c → Sig a) :=
  Finset.univ.filter (fun x => f x (hashS ω x) (fun q => hashS ω q.1) = true)

/-- `p_x = max_φ 2^{-s} |{r : f(x,r,φ) = 1}|`. -/
def px {a c s : ℕ} (Q : Finset (Fin c → Sig a))
    (f : (Fin c → Sig a) → (Fin s → ZMod 2) → (↥Q → Fin s → ZMod 2) → Bool)
    (x : Fin c → Sig a) : ℝ :=
  (((Finset.univ : Finset (↥Q → Fin s → ZMod 2)).sup' Finset.univ_nonempty
      (fun φ => (Finset.univ.filter (fun r => f x r φ = true)).card) : ℕ) : ℝ) /
    (2 : ℝ) ^ s

/-- `μ = ∑_{x ∈ U} p_x`. -/
def mu {a c s : ℕ} (Q : Finset (Fin c → Sig a))
    (f : (Fin c → Sig a) → (Fin s → ZMod 2) → (↥Q → Fin s → ZMod 2) → Bool) : ℝ :=
  ∑ x : Fin c → Sig a, px Q f x

/-- `B(μ,d,q) = 7 μ³ (3/q)^(d+1) + 2^(-q/2)`. -/
def Bbound (μ : ℝ) (d q : ℕ) : ℝ :=
  7 * μ ^ 3 * (3 / (q : ℝ)) ^ (d + 1) + (2 : ℝ) ^ (-(q : ℝ) / 2)

/-- The parity obstruction of the supplied estimate: a nonempty `S ⊆ X` such that, for each
position `j`, `S` can be partitioned into pairs agreeing in derived position `j`;
equivalently every character occurs an even number of times at position `j`. -/
def ParityObstruction {a c d : ℕ} (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a)
    (X : Finset (Fin c → Sig a)) : Prop :=
  ∃ S ⊆ X, S.Nonempty ∧
    ∀ (j : Fin (c + d)) (α : Sig a), Even (S.filter (fun x => derived A x j = α)).card

/-- Position-character incidence vector `v(y) ∈ 𝔽₂^{[c+d] × Σ}`,
`v(y)_{(j,α)} = 1[y_j = α]`. -/
def incid {a c d : ℕ} (y : Fin (c + d) → Sig a) : Fin (c + d) × Sig a → ZMod 2 :=
  fun p => if y p.1 = p.2 then 1 else 0

/-! ## Rubric lemma stubs -/

/-- Rubric 1: over `𝔽₂`, the incidence vectors of the derived keys of `X` are linearly
independent iff there is no parity obstruction. [LocallyUniformHashing, node_11] -/
theorem linIndep_iff_not_parityObstruction {a c d : ℕ}
    (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a) (X : Finset (Fin c → Sig a)) :
    LinearIndependent (ZMod 2) (fun x : ↥X => incid (derived A x.1)) ↔
      ¬ ParityObstruction A X := by
  sorry

/-- Rubric 2 (uniform-image fact): if `v_1,…,v_k ∈ 𝔽₂^I` are linearly independent and the
`Z_i ∈ 𝔽₂^t` are independent uniform, then `(⊕_i (v_ℓ)_i Z_i)_ℓ` is uniform on
`(𝔽₂^t)^k`: every target `b` has exactly `|(𝔽₂^t)^I| / 2^{tk}` preimages. [LocallyUniformHashing, node_11] -/
theorem uniform_image_of_linIndep {I : Type} [Fintype I] {k t : ℕ}
    (v : Fin k → I → ZMod 2) (hv : LinearIndependent (ZMod 2) v)
    (b : Fin k → Fin t → ZMod 2) :
    ((Finset.univ.filter (fun Z : I → Fin t → ZMod 2 =>
        ∀ ℓ, ∑ i, v ℓ i • Z i = b ℓ)).card : ℝ) * (2 : ℝ) ^ (t * k) =
      (Fintype.card (I → Fin t → ZMod 2) : ℝ) := by
  sorry

/-! ## Main theorem -/

/-- Local uniformity (node_11).  Given the supplied estimate
`Pr[parity obstruction in X] ≤ B(μ,d,q)`, there are random data `D` (any function of the
tables) determining `X`, and a good event `G` on the values of `D` with
`Pr(D ∈ G) ≥ 1 - B(μ,d,q)`, such that for every `δ ∈ G` with `Pr(D = δ) > 0` and every
assignment `b`, `Pr[h^(t)(x) = b(x) ∀ x ∈ X(δ) | D = δ] = 2^{-t|X(δ)|}`. [LocallyUniformHashing, node_11] -/
theorem local_uniformity (a c d s t : ℕ) (hc : 1 ≤ c) (hd : 1 ≤ d) (hs : 1 ≤ s)
    (ht : 1 ≤ t)
    (Q : Finset (Fin c → Sig a))
    (f : (Fin c → Sig a) → (Fin s → ZMod 2) → (↥Q → Fin s → ZMod 2) → Bool)
    (hfQ : ∀ q₀ ∈ Q, ∀ r φ, f q₀ r φ = true)
    (hmu : mu Q f ≤ ((2 ^ a : ℕ) : ℝ) / 2)
    (hEst : prob (fun ω : Tables a c d (s + t) =>
        ParityObstruction ω.1 (selected Q f ω)) ≤ Bbound (mu Q f) d (2 ^ a)) :
    ∃ (Δ : Type) (D : Tables a c d (s + t) → Δ) (Xδ : Δ → Finset (Fin c → Sig a))
      (G : Set Δ),
      (∀ ω, selected Q f ω = Xδ (D ω)) ∧
      1 - Bbound (mu Q f) d (2 ^ a) ≤ prob (fun ω => D ω ∈ G) ∧
      ∀ δ ∈ G, 0 < prob (fun ω => D ω = δ) →
        ∀ b : (Fin c → Sig a) → Fin t → ZMod 2,
          prob (fun ω => D ω = δ ∧ ∀ x ∈ Xδ δ, hashT ω x = b x) =
            ((2 : ℝ) ^ (t * (Xδ δ).card))⁻¹ * prob (fun ω => D ω = δ) := by
  sorry

end TCSChallenge.LocallyUniformHashing.node_11
