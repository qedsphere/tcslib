/-!
## Linear probing with locally uniform hashing is dominated by fully random hashing (node_27)

Keys `y ∈ Σ^c` (`Σ = 𝔽₂^a`, `q = 2^a`) are hashed by `h(y) = H(z(y))`, where `z(y)` is the
derived key built by simple tabulation functions `G_0, …, G_d` and `H` is simple tabulation
into `[m]`, `m = 2^r`.  Inserting a fixed set `S` (`|S| = n`) by linear probing and then `x`
costs `X`; inserting `S*` (`|S*| = n* = (1 + 15√(log(1/δ)/q)) n`) with a fully random hash and
then `x` costs `X*`.

Main theorem `TCSChallenge.LocallyUniformHashing.node_27.linear_probing_domination`: there is a
coupling of the two experiments and an event `E` with
`Pr[E] ≥ 1 - (1/q + 6δ + 61 log n · D)` such that, conditioned on `E`, `X ≤_st X*`.
-/

namespace TCSChallenge.LocallyUniformHashing.node_27

/-- The alphabet `Σ = 𝔽₂^a`; addition is bitwise XOR. -/
abbrev Sig (a : ℕ) : Type := Fin a → ZMod 2

/-- Uniform (counting) probability of an event on a finite sample space. -/
def prob {Ω : Type} [Fintype Ω] (E : Ω → Prop) : ℝ :=
  ((Finset.univ.filter E).card : ℝ) / (Fintype.card Ω : ℝ)

/-- All random tables: the derived-character tables `A_{i,j} : Σ → Σ`
(`0 ≤ i ≤ d`, only `j < c+i-1` used, 0-indexed) and the final tables
`T_j : Σ → 𝔽₂^(s+t)` (`1 ≤ j ≤ c+d`, here 0-indexed). -/
abbrev Tables (a c d w : ℕ) : Type :=
  (Fin (d + 1) → Fin (c + d) → Sig a → Sig a) × (Fin (c + d) → Sig a → Fin w → ZMod 2)

instance instFintypeTables (a c d w : ℕ) : Fintype (Tables a c d w) := by
  haveI h1 : Fintype (ZMod 2) := ZMod.fintype 2
  haveI h2 : Fintype (Sig a) := Pi.instFintype
  haveI h3 : DecidableEq (Sig a) := Classical.decEq _
  haveI h4 : Fintype (Sig a → Sig a) := Pi.instFintype
  haveI h5 : Fintype (Fin (c + d) → Sig a → Sig a) := Pi.instFintype
  haveI h6 : Fintype (Fin (d + 1) → Fin (c + d) → Sig a → Sig a) := Pi.instFintype
  haveI h7 : Fintype (Fin w → ZMod 2) := Pi.instFintype
  haveI h8 : Fintype (Sig a → Fin w → ZMod 2) := Pi.instFintype
  haveI h9 : Fintype (Fin (c + d) → Sig a → Fin w → ZMod 2) := Pi.instFintype
  exact inferInstanceAs (Fintype (_ × _))

/-- Access to the derived table `A_{i,j}` by natural-number indices (zero outside the
array, never used). -/
def Aat {a c d : ℕ} (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a) (i j : ℕ) :
    Sig a → Sig a :=
  if hi : i < d + 1 then (if hj : j < c + d then A ⟨i, hi⟩ ⟨j, hj⟩ else fun _ => 0)
  else fun _ => 0

/-- Extension of a key `x ∈ Σ^c` by zeros to `ℕ → Σ`. -/
def keyExt {a c : ℕ} (x : Fin c → Sig a) (j : ℕ) : Sig a :=
  if h : j < c then x ⟨j, h⟩ else 0

/-- The `k`-th (0-indexed) derived character, given the previous ones `p 0, …, p (k-1)`:
* `x̃_{k} = x_k` for `k+1 < c`;
* `x̃_{c-1} = x_{c-1} ⊕ g_0(x_0,…,x_{c-2})`, `g_0(z) = ⊕_{j < c-1} A_{0,j}[z_j]`;
* `x̃_{c-1+i} = g_i(x̃_0,…,x̃_{c+i-2}) = ⊕_{j < c+i-1} A_{i,j}[x̃_j]` for `1 ≤ i ≤ d`. -/
def nextChar {a c d : ℕ} (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a)
    (x : Fin c → Sig a) (k : ℕ) (p : ℕ → Sig a) : Sig a :=
  if k + 1 < c then keyExt x k
  else if k + 1 = c then keyExt x k + ∑ j ∈ Finset.range k, Aat A 0 j (p j)
  else ∑ j ∈ Finset.range k, Aat A (k + 1 - c) j (p j)

/-- The first `k` derived characters (entries at positions `≥ k` are zero). -/
def derivedPrefix {a c d : ℕ} (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a)
    (x : Fin c → Sig a) : ℕ → ℕ → Sig a
  | 0 => fun _ => 0
  | k + 1 => fun j =>
      if j < k then derivedPrefix A x k j
      else if j = k then nextChar A x k (derivedPrefix A x k) else 0

/-- The derived key `x̃ ∈ Σ^(c+d)`. -/
def derived {a c d : ℕ} (A : Fin (d + 1) → Fin (c + d) → Sig a → Sig a)
    (x : Fin c → Sig a) : Fin (c + d) → Sig a :=
  fun j => derivedPrefix A x (c + d) j.val

/-- Position-character incidence vector `v(y) ∈ 𝔽₂^{[c+d] × Σ}`,
`v(y)_{(j,α)} = 1[y_j = α]`. -/
def incid {a c d : ℕ} (y : Fin (c + d) → Sig a) : Fin (c + d) × Sig a → ZMod 2 :=
  fun p => if y p.1 = p.2 then 1 else 0

/-- `D(a,d,q) = 7 a³ (3/q)^(d+1) + 2^(-q/2)`. -/
def Dfun (μ : ℝ) (d q : ℕ) : ℝ :=
  7 * μ ^ 3 * (3 / (q : ℝ)) ^ (d + 1) + (2 : ℝ) ^ (-(q : ℝ) / 2)

/-- The cyclic address in `[m] = {0,…,2^r-1}` of an `r`-bit vector: `∑_i w_i 2^i`. -/
def toAddr {r : ℕ} (w : Fin r → ZMod 2) : ℕ :=
  ∑ i : Fin r, (w i).val * 2 ^ i.val

/-- The hash address `h(y) = H(z(y))`, `H(z) = ⊕_j T_j[z_j] ∈ 𝔽₂^r`. -/
def hashAddr {a c d r : ℕ} (ω : Tables a c d r) (y : Fin c → Sig a) : ℕ :=
  toAddr (∑ j : Fin (c + d), ω.2 j (derived ω.1 y j))

/-- The event `B_Y`: the incidence vectors `v(z(y))`, `y ∈ Y`, are linearly independent. -/
def BEvent {a c d r : ℕ} (Y : Finset (Fin c → Sig a)) (ω : Tables a c d r) : Prop :=
  LinearIndependent (ZMod 2) (fun y : ↥Y => incid (derived ω.1 y.1))

/-- The supplied structural estimate: for every fixed finite `T`, `y ∉ T`, and every
deterministic `J` assigning to each `p ∈ [m]` a subset `J(p) ⊆ [m]` of size `ℓ`, with
`Y = {y} ∪ {t ∈ T : h(t) ∈ J(h(y))}`: if `1 + |T|ℓ/m ≤ q/2` then
`Pr[B_Y^c] ≤ D(1 + |T|ℓ/m, d, q)`. -/
def StructuralEstimate (a c d r : ℕ) : Prop :=
  ∀ (T : Finset (Fin c → Sig a)) (y : Fin c → Sig a), y ∉ T →
    ∀ (ℓ : ℕ) (J : ℕ → Finset ℕ),
      (∀ p, p < 2 ^ r → J p ⊆ Finset.range (2 ^ r) ∧ (J p).card = ℓ) →
      1 + (T.card : ℝ) * ℓ / (2 ^ r : ℕ) ≤ ((2 ^ a : ℕ) : ℝ) / 2 →
      prob (fun ω : Tables a c d r =>
          ¬ BEvent (insert y (T.filter (fun t => hashAddr ω t ∈ J (hashAddr ω y)))) ω) ≤
        Dfun (1 + (T.card : ℝ) * ℓ / (2 ^ r : ℕ)) d (2 ^ a)

/-- One linear-probing insertion with home address `p` into a table of `m` cells with
occupied set `occ`: scan `p, p+1, … (mod m)` for the first empty cell; the cost is the number
of inspected cells including the empty one, or `⊤` if all cells are occupied. -/
def insertOne (m : ℕ) (occ : Finset ℕ) (p : ℕ) : Finset ℕ × ℕ∞ :=
  match (List.range m).find? (fun k => decide ((p + k) % m ∉ occ)) with
  | some k => (insert ((p + k) % m) occ, ((k + 1 : ℕ) : ℕ∞))
  | none => (occ, ⊤)

/-- Occupied cells after inserting the home addresses `ps` in order into an empty table. -/
def occAfter (m : ℕ) (ps : List ℕ) : Finset ℕ :=
  ps.foldl (fun occ p => (insertOne m occ p).1) ∅

/-- Cost of inserting a key with home address `p` after inserting `ps`. -/
def queryCost (m : ℕ) (ps : List ℕ) (p : ℕ) : ℕ∞ :=
  (insertOne m (occAfter m ps) p).2

/-- Source cost `X`: insert `S` (in the fixed order `ord`) using `h`, then query `x`. -/
def costSrc {a c d r : ℕ} (ord : List (Fin c → Sig a)) (x : Fin c → Sig a)
    (ω : Tables a c d r) : ℕ∞ :=
  queryCost (2 ^ r) (ord.map (hashAddr ω)) (hashAddr ω x)

/-- Comparison cost `X*`: insert `S*` (in order `ordStar`) using a fully random `h*`. -/
def costCmp {a c r : ℕ} (ordStar : List (Fin c → Sig a)) (x : Fin c → Sig a)
    (η : (Fin c → Sig a) → Fin r → ZMod 2) : ℕ∞ :=
  queryCost (2 ^ r) (ordStar.map (fun y => toAddr (η y))) (toAddr (η x))

/-- A coupling of the uniform distributions on two finite sample spaces. -/
def IsCoupling {Ω Ω' : Type} [Fintype Ω] [Fintype Ω'] (w : Ω × Ω' → ℝ) : Prop :=
  (∀ z, 0 ≤ w z) ∧
  (∀ ω, ∑ η : Ω', w (ω, η) = 1 / (Fintype.card Ω : ℝ)) ∧
  (∀ η, ∑ ω : Ω, w (ω, η) = 1 / (Fintype.card Ω' : ℝ))

/-- Probability of an event under a coupling weight. -/
def probW {Ω Ω' : Type} [Fintype Ω] [Fintype Ω'] (w : Ω × Ω' → ℝ)
    (E : Ω × Ω' → Prop) : ℝ :=
  ∑ z ∈ Finset.univ.filter E, w z

/-! ## Rubric lemma stubs (linear-probing invariants) -/

/-- Order independence: the final occupied set depends only on the multiset of home
addresses. [LocallyUniformHashing, node_27] -/
theorem occAfter_perm (m : ℕ) (ps ps' : List ℕ) (h : ps.Perm ps') :
    occAfter m ps = occAfter m ps' := by
  sorry

/-- Monotonicity: inserting additional keys cannot decrease the query cost. [LocallyUniformHashing, node_27] -/
theorem queryCost_mono_append (m : ℕ) (ps qs : List ℕ) (p : ℕ) :
    queryCost m ps p ≤ queryCost m (ps ++ qs) p := by
  sorry

/-- Cyclic translation invariance of the query cost. [LocallyUniformHashing, node_27] -/
theorem queryCost_translate (m e : ℕ) (ps : List ℕ) (p : ℕ) (hp : p < m)
    (hps : ∀ u ∈ ps, u < m) :
    queryCost m (ps.map (fun u => (u + e) % m)) ((p + e) % m) = queryCost m ps p := by
  sorry

/-! ## Main theorem -/

/-- Linear probing domination (node_27). [LocallyUniformHashing, node_27] -/
theorem linear_probing_domination (a c d r : ℕ) (hc : 1 ≤ c)
    (hEst : StructuralEstimate a c d r)
    (S Sstar : Finset (Fin c → Sig a)) (ord ordStar : List (Fin c → Sig a))
    (hord : ord.Nodup) (hordS : ord.toFinset = S)
    (hordStar : ordStar.Nodup) (hordStarS : ordStar.toFinset = Sstar)
    (x : Fin c → Sig a) (hxS : x ∉ S) (hxSstar : x ∉ Sstar)
    (δ : ℝ) (hδ0 : 0 < δ) (hδ1 : δ < 1 / 6)
    (hn : 1 ≤ S.card)
    (hnstar : (Sstar.card : ℝ) =
      (1 + 15 * Real.sqrt (Real.logb 2 (1 / δ) / ((2 ^ a : ℕ) : ℝ))) * S.card)
    (hload : (S.card : ℝ) / ((2 ^ r : ℕ) : ℝ) ≤ 4 / 5)
    (hq16 : (2 : ℝ) ^ 16 ≤ ((2 ^ a : ℕ) : ℝ))
    (hqlog : 30 * Real.logb 2 S.card ≤ ((2 ^ a : ℕ) : ℝ))
    (hbeta : Real.sqrt (Real.logb 2 (1 / δ) / ((2 ^ a : ℕ) : ℝ)) ≤ 1 / 18) :
    ∃ (w : Tables a c d r × ((Fin c → Sig a) → Fin r → ZMod 2) → ℝ)
      (E : Tables a c d r × ((Fin c → Sig a) → Fin r → ZMod 2) → Prop),
      IsCoupling w ∧
      1 - (1 / ((2 ^ a : ℕ) : ℝ) + 6 * δ +
          61 * Real.logb 2 S.card * Dfun (((2 ^ a : ℕ) : ℝ) / 2) d (2 ^ a)) ≤ probW w E ∧
      ∀ k : ℕ∞,
        probW w (fun z => E z ∧ k < costSrc ord x z.1) ≤
          probW w (fun z => E z ∧ k < costCmp ordStar x z.2) := by
  sorry

end TCSChallenge.LocallyUniformHashing.node_27
