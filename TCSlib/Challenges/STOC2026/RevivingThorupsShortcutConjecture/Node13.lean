/-!
## Non-Steiner shortcut lower bound from unique, limited-overlap critical paths

`G` is layered with layers `L_0, …, L_{kℓ}`, every edge advancing one layer. Critical pairs
`(s,t) ∈ P` go from `L_0` to `L_{kℓ}` along a unique path, and two distinct critical paths
sharing vertices in `L_i` and `L_j` (`i < j`) have `j - i < k`. A non-Steiner shortcut set is
`E₊ ⊆ E*` (transitive closure).

Main theorem `shortcut_dichotomy`: `|E₊| ≥ |P|`, or some `(s,t) ∈ P` has
`dist_{G⁺}(s,t) ≥ ℓ + 1`. Exponent bookkeeping: `parameter_balance`.
-/

namespace TCSChallenge.RevivingThorupsShortcutConjecture.node_13

/-! ## Shared definitions (identical across the rows of this paper) -/

/-- A walk `p 0 → p 1 → ⋯ → p j` of length `j` (number of edges) in the relation `adj`. -/
def IsWalk {α : Type} (adj : α → α → Prop) {j : ℕ} (p : Fin (j + 1) → α) : Prop :=
  ∀ i : Fin j, adj (p i.castSucc) (p i.succ)

/-- `dist(x, y) ≤ h`: some walk from `x` to `y` has at most `h` edges. -/
def HopWithin {α : Type} (adj : α → α → Prop) (x y : α) (h : ℝ) : Prop :=
  ∃ (j : ℕ) (p : Fin (j + 1) → α), IsWalk adj p ∧ p 0 = x ∧ p (Fin.last j) = y ∧ (j : ℝ) ≤ h

/-- `dist(x, y) ≥ h`: every walk from `x` to `y` has at least `h` edges. -/
def HopAtLeast {α : Type} (adj : α → α → Prop) (x y : α) (h : ℝ) : Prop :=
  ∀ (j : ℕ) (p : Fin (j + 1) → α), IsWalk adj p → p 0 = x → p (Fin.last j) = y → h ≤ (j : ℝ)

/-- "every original edge advances by one layer". -/
def IsLayered {V : Type} (adj : V → V → Prop) (layer : V → ℕ) : Prop :=
  ∀ u v, adj u v → layer v = layer u + 1

/-- `v` lies on some `s`–`t` path: `s ⇝ v ⇝ t`. -/
def OnPath {V : Type} (adj : V → V → Prop) (s t v : V) : Prop :=
  Relation.ReflTransGen adj s v ∧ Relation.ReflTransGen adj v t

/-- Critical pairs: every `(s,t) ∈ P` has `s ∈ L_0`, `t ∈ L_L`, `s ⇝ t`, and a *unique*
`s`–`t` path (in a layered graph: at most one on-path vertex per layer); and the overlap
property "if two critical paths share vertices in `L_i` and `L_j`, `i < j`, then `j - i < k`". -/
def IsCriticalSystem {V : Type} (adj : V → V → Prop) (layer : V → ℕ) (L k : ℕ)
    (P : Finset (V × V)) : Prop :=
  (∀ p ∈ P, layer p.1 = 0 ∧ layer p.2 = L ∧ Relation.ReflTransGen adj p.1 p.2 ∧
      ∀ v w, OnPath adj p.1 p.2 v → OnPath adj p.1 p.2 w → layer v = layer w → v = w) ∧
  (∀ p ∈ P, ∀ q ∈ P, p ≠ q → ∀ u v, OnPath adj p.1 p.2 u → OnPath adj p.1 p.2 v →
      OnPath adj q.1 q.2 u → OnPath adj q.1 q.2 v → layer u < layer v → layer v - layer u < k)

/-! ## Row-specific definitions -/

/-- Adjacency of `G⁺ = (V, E ∪ E₊)`. -/
def ShortcutAdj {V : Type} (adj : V → V → Prop) (Eplus : Finset (V × V)) (u v : V) : Prop :=
  adj u v ∨ (u, v) ∈ Eplus

/-- Non-Steiner shortcut set: `E₊ ⊆ E*`, the (strict) transitive closure of `G`. -/
def InClosure {V : Type} (adj : V → V → Prop) (Eplus : Finset (V × V)) : Prop :=
  ∀ e ∈ Eplus, Relation.TransGen adj e.1 e.2

/-- Exponent of `r` in `n = (kℓ+1)·(2(r+1)rℓ)^{kd}` with `ℓ = r^c` (up to `o(1)`). -/
def expN (c : ℝ) (d k : ℕ) : ℝ := (2 + c) * k * d + c

/-- Exponent of `r` in `Δ = Θ(r^{d(d-1)/(d+1)})`. -/
def expDelta (d : ℕ) : ℝ := (d : ℝ) * ((d : ℝ) - 1) / ((d : ℝ) + 1)

/-- Exponent of `r` in `|P| = N Δ^k (r/(r+1))^{dk}` (up to `o(1)`). -/
def expP (c : ℝ) (d k : ℕ) : ℝ := (2 + c) * k * d + k * expDelta d

/-! ## Lemma stubs (rubric items) -/

/-- Route canonicalisation: expanding shortcut edges, `G⁺`-reachability implies
`G`-reachability. [RevivingThorupsShortcutConjecture, node_13] -/
theorem closure_reach {V : Type} (adj : V → V → Prop) (Eplus : Finset (V × V))
    (hcl : InClosure adj Eplus) (u v : V)
    (h : Relation.ReflTransGen (ShortcutAdj adj Eplus) u v) :
    Relation.ReflTransGen adj u v := by
  sorry

/-- Bounded reuse: a shortcut whose endpoints are `≥ k` layers apart and lie on the critical
paths of two critical pairs forces the two pairs to coincide. [RevivingThorupsShortcutConjecture, node_13] -/
theorem long_shortcut_unique_pair {V : Type} (adj : V → V → Prop) (layer : V → ℕ) (L k : ℕ)
    (P : Finset (V × V)) (hP : IsCriticalSystem adj layer L k P) (u v : V)
    (hspan : layer u + k ≤ layer v) (p q : V × V) (hp : p ∈ P) (hq : q ∈ P)
    (hpu : OnPath adj p.1 p.2 u) (hpv : OnPath adj p.1 p.2 v)
    (hqu : OnPath adj q.1 q.2 u) (hqv : OnPath adj q.1 q.2 v) :
    p = q := by
  sorry

/-- Layer-progress potential: if every hop of a walk advances at most `k - 1` layers, then a
walk of length `j` advances at most `j (k - 1)` layers. [RevivingThorupsShortcutConjecture, node_13] -/
theorem hop_progress {V : Type} (R : V → V → Prop) (layer : V → ℕ) (k j : ℕ)
    (p : Fin (j + 1) → V) (hp : IsWalk R p)
    (hstep : ∀ i : Fin j, layer (p i.succ) ≤ layer (p i.castSucc) + (k - 1)) :
    layer (p (Fin.last j)) ≤ layer (p 0) + j * (k - 1) := by
  sorry

/-- Exponent bookkeeping: `c` small and `d` large (depending only on `ε`) give, for every
`k ≥ 2`, `|P| ≥ n^{1.5-ε}`, `m = nΔ ≤ n^{1+1/k}`, and `ℓ = r^c ≥ n^{δ/k}` at the level of
`r`-exponents. [RevivingThorupsShortcutConjecture, node_13] -/
theorem parameter_balance (ε : ℝ) (hε : 0 < ε) :
    ∃ c : ℝ, 0 < c ∧ ∃ d : ℕ, 1 ≤ d ∧ ∃ δ : ℝ, 0 < δ ∧ ∀ k : ℕ, 2 ≤ k →
      (3 / 2 - ε) * expN c d k ≤ expP c d k ∧
      expN c d k + expDelta d ≤ (1 + 1 / (k : ℝ)) * expN c d k ∧
      δ / (k : ℝ) * expN c d k ≤ c := by
  sorry

/-! ## Main theorem -/

/-- **Dichotomy.** For a layered graph with layers `L_0, …, L_{kℓ}` and a critical-pair system
with unique paths and limited overlap, every non-Steiner shortcut set satisfies `|E₊| ≥ |P|`,
or some critical pair `(s,t)` has `dist_{G⁺}(s,t) ≥ ℓ + 1` (`> ℓ = n^{Ω(1/k)}`). [RevivingThorupsShortcutConjecture, node_13] -/
theorem shortcut_dichotomy {V : Type} (adj : V → V → Prop) (layer : V → ℕ) (k ℓ : ℕ)
    (hk : 1 < k) (hℓ : 1 ≤ ℓ) (P : Finset (V × V)) (hlay : IsLayered adj layer)
    (hP : IsCriticalSystem adj layer (k * ℓ) k P) (Eplus : Finset (V × V))
    (hcl : InClosure adj Eplus) :
    P.card ≤ Eplus.card ∨
      ∃ p ∈ P, HopAtLeast (ShortcutAdj adj Eplus) p.1 p.2 ((ℓ : ℝ) + 1) := by
  sorry

end TCSChallenge.RevivingThorupsShortcutConjecture.node_13
