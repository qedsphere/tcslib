/-!
## Size–diameter tradeoff for `t`-thick Steiner shortcuts on the layered hard family

A directed graph is a relation `adj : V → V → Prop`. A reachability-preserving Steiner shortcut
graph adds Steiner vertices `W` and a finite set `E₊` of edges on `V ⊕ W` without changing
reachability between original vertices. It is `t`-thick if no directed path has more than
`t - 1` consecutive Steiner vertices.

Main theorem `steiner_tradeoff_family`: there is `ε₀ > 0` (depending only on `c = 3`,
`d = 20000` and the family constants) such that for every `k ≥ 2`, `1 ≤ t ≤ (1-η)k`
(`η = 0.01`) and every large enough member of `𝒢_k`, no valid `t`-thick Steiner shortcut has
both `h ≤ m^{ε₀/k}` and `M ≤ m^{1+ε₀²/k}`. Corollary `steiner_tradeoff_general`: the
`m^{Ω(1/t)}` / `m^{1+Ω(1/t)}` dichotomy for every `t ≥ 1`.
-/

namespace TCSChallenge.RevivingThorupsShortcutConjecture.node_07

/-! ## Shared definitions (identical across the rows of this paper) -/

/-- A walk `p 0 → p 1 → ⋯ → p j` of length `j` (number of edges) in the relation `adj`. -/
def IsWalk {α : Type} (adj : α → α → Prop) {j : ℕ} (p : Fin (j + 1) → α) : Prop :=
  ∀ i : Fin j, adj (p i.castSucc) (p i.succ)

/-- `dist(x, y) ≤ h`: some walk from `x` to `y` has at most `h` edges. -/
def HopWithin {α : Type} (adj : α → α → Prop) (x y : α) (h : ℝ) : Prop :=
  ∃ (j : ℕ) (p : Fin (j + 1) → α), IsWalk adj p ∧ p 0 = x ∧ p (Fin.last j) = y ∧ (j : ℝ) ≤ h

/-- `dist(x, y) ≥ h`: every walk from `x` to `y` has at least `h` edges. -/
def HopAtLeast {α : Type} (adj : α → α → Prop) (x y : α) (h : ℝ) : Prop :=
  ∀ (j : ℕ) (p : Fin (j + 1) → α), IsWalk adj p → p 0 = x → p (Fin.last j) = y → h ≤ (j : ℝ)

/-- "every original edge advances by one layer". -/
def IsLayered {V : Type} (adj : V → V → Prop) (layer : V → ℕ) : Prop :=
  ∀ u v, adj u v → layer v = layer u + 1

/-- `v` lies on some `s`–`t` path: `s ⇝ v ⇝ t`. -/
def OnPath {V : Type} (adj : V → V → Prop) (s t v : V) : Prop :=
  Relation.ReflTransGen adj s v ∧ Relation.ReflTransGen adj v t

/-- Critical pairs: every `(s,t) ∈ P` has `s ∈ L_0`, `t ∈ L_L`, `s ⇝ t`, and a *unique*
`s`–`t` path (in a layered graph: at most one on-path vertex per layer); and the overlap
property "if two critical paths share vertices in `L_i` and `L_j`, `i < j`, then `j - i < k`". -/
def IsCriticalSystem {V : Type} (adj : V → V → Prop) (layer : V → ℕ) (L k : ℕ)
    (P : Finset (V × V)) : Prop :=
  (∀ p ∈ P, layer p.1 = 0 ∧ layer p.2 = L ∧ Relation.ReflTransGen adj p.1 p.2 ∧
      ∀ v w, OnPath adj p.1 p.2 v → OnPath adj p.1 p.2 w → layer v = layer w → v = w) ∧
  (∀ p ∈ P, ∀ q ∈ P, p ≠ q → ∀ u v, OnPath adj p.1 p.2 u → OnPath adj p.1 p.2 v →
      OnPath adj q.1 q.2 u → OnPath adj q.1 q.2 v → layer u < layer v → layer v - layer u < k)

/-- Steiner vertices are the right summand of `V ⊕ W`. -/
def IsSteiner {V W : Type} : V ⊕ W → Prop
  | Sum.inl _ => False
  | Sum.inr _ => True

/-- Adjacency of `G⁺ = (V ∪ V₊, E ∪ E₊)`. -/
def plusAdj {V W : Type} (adj : V → V → Prop) (Eplus : Finset ((V ⊕ W) × (V ⊕ W)))
    (x y : V ⊕ W) : Prop :=
  (∃ u v : V, adj u v ∧ x = Sum.inl u ∧ y = Sum.inl v) ∨ (x, y) ∈ Eplus

/-- Reachability preserving: `u ⇝_G v ↔ u ⇝_{G⁺} v` for all `u v ∈ V`. -/
def ValidSteiner {V W : Type} (adj : V → V → Prop) (Eplus : Finset ((V ⊕ W) × (V ⊕ W))) :
    Prop :=
  ∀ u v : V, Relation.ReflTransGen adj u v ↔
    Relation.ReflTransGen (plusAdj adj Eplus) (Sum.inl u) (Sum.inl v)

/-- `t`-thick: every directed path (injective walk) consisting only of Steiner vertices has at
most `t - 1` vertices. -/
def IsThick {V W : Type} (adj : V → V → Prop) (Eplus : Finset ((V ⊕ W) × (V ⊕ W))) (t : ℕ) :
    Prop :=
  ∀ (j : ℕ) (p : Fin (j + 1) → V ⊕ W), IsWalk (plusAdj adj Eplus) p → Function.Injective p →
    (∀ i, IsSteiner (p i)) → j + 1 ≤ t - 1

/-- Reachable-pair diameter `h ≤ H`: every `G`-reachable pair of original vertices is at
`G⁺`-distance at most `H`. -/
def DiamWithin {V W : Type} (adj : V → V → Prop) (Eplus : Finset ((V ⊕ W) × (V ⊕ W)))
    (H : ℝ) : Prop :=
  ∀ u v : V, Relation.ReflTransGen adj u v →
    HopWithin (plusAdj adj Eplus) (Sum.inl u) (Sum.inl v) H

/-! ## Row-specific definitions -/

/-- Edge relation of a graph given by its edge set. -/
def edgeRel {V : Type} (E : Finset (V × V)) (u v : V) : Prop := (u, v) ∈ E

/-- `η = 0.01`. -/
def eta : ℝ := 1 / 100

/-- `c = 3`. -/
def cExp : ℕ := 3

/-- `d = 20000`. -/
def dExp : ℕ := 20000

/-- "For any subcollection of critical pairs and any choice of one corresponding `G⁺` route per
pair, a fixed Steiner vertex lies on the selected routes of at most `Δ^k` pairs."
(A route of `(s,z)` through `w` exists iff `s ⇝ w ⇝ z` in `G⁺`.) -/
def SteinerCapacity {V : Type} (adj : V → V → Prop) (P : Finset (V × V)) (k : ℕ) (Δ : ℝ) :
    Prop :=
  ∀ (W : Type) [Fintype W] (Eplus : Finset ((V ⊕ W) × (V ⊕ W))), ValidSteiner adj Eplus →
    ∀ w : W,
      ((P.filter (fun p =>
          Relation.ReflTransGen (plusAdj adj Eplus) (Sum.inl p.1) (Sum.inr w) ∧
          Relation.ReflTransGen (plusAdj adj Eplus) (Sum.inr w) (Sum.inl p.2))).card : ℝ)
        ≤ Δ ^ k

/-- A member of the hard family `𝒢_k(c,d)` with size parameter `r`, `ℓ = r^c`, layers
`L_0, …, L_{kℓ}` of `N` vertices each, and the supplied properties:
`Δ = Θ(r^{d(d-1)/(d+1)})`, `m = O(N k ℓ Δ)`, `m ≤ r^{kf}`, `|P| = Ω(m Δ^{k-1-2c/d})`,
unique critical paths with the separated-layer intersection property, and the Steiner
incidence bound. -/
def HardInstance (aΔ bΔ Cm Cp f : ℝ) (k r ℓ N : ℕ) (Δ : ℝ) {V : Type} [Fintype V]
    (E : Finset (V × V)) (layer : V → ℕ) (P : Finset (V × V)) : Prop :=
  ℓ = r ^ cExp ∧
  IsLayered (edgeRel E) layer ∧
  (∀ v, layer v ≤ k * ℓ) ∧
  (∀ i, i ≤ k * ℓ → (Finset.univ.filter (fun v => layer v = i)).card = N) ∧
  aΔ * (r : ℝ) ^ ((dExp : ℝ) * ((dExp : ℝ) - 1) / ((dExp : ℝ) + 1)) ≤ Δ ∧
  Δ ≤ bΔ * (r : ℝ) ^ ((dExp : ℝ) * ((dExp : ℝ) - 1) / ((dExp : ℝ) + 1)) ∧
  (E.card : ℝ) ≤ Cm * N * k * ℓ * Δ ∧
  (E.card : ℝ) ≤ (r : ℝ) ^ ((k : ℝ) * f) ∧
  Cp * (E.card : ℝ) * Δ ^ ((k : ℝ) - 1 - 2 * (cExp : ℝ) / (dExp : ℝ)) ≤ (P.card : ℝ) ∧
  IsCriticalSystem (edgeRel E) layer (k * ℓ) k P ∧
  SteinerCapacity (edgeRel E) P k Δ

/-- Arbitrarily large members of `𝒢_k` exist for every `k ≥ 2`. -/
def FamilyExists (aΔ bΔ Cm Cp f : ℝ) : Prop :=
  ∀ k : ℕ, 2 ≤ k → ∀ (R : ℕ) (M0 : ℝ),
    ∃ (r : ℕ) (V : Type) (_ : Fintype V) (E : Finset (V × V)) (layer : V → ℕ)
      (P : Finset (V × V)) (N : ℕ) (Δ : ℝ),
      R ≤ r ∧ M0 ≤ (E.card : ℝ) ∧ HardInstance aΔ bΔ Cm Cp f k r (r ^ cExp) N Δ E layer P

/-! ## Lemma stubs (rubric items) -/

/-- Where the strict margin is used: `t ≤ (1-η)k` gives `(t-1)(1+η) < k - 1 - η`, so the
number of bounded-degree route signatures `Δ^{(t-1)(1+η)}` is below the load `Δ^{k-1-η}`. [RevivingThorupsShortcutConjecture, node_07] -/
theorem thickness_margin (k t : ℕ) (hk : 2 ≤ k) (ht : (t : ℝ) ≤ (1 - eta) * k) :
    ((t : ℝ) - 1) * (1 + eta) < (k : ℝ) - 1 - eta := by
  sorry

/-- Pruning step: deleting a part (pairs `a'`, edges `b'`) whose local ratio is at most the
global load `a / b` cannot decrease the load. [RevivingThorupsShortcutConjecture, node_07] -/
theorem ratio_deletion (a b a' b' : ℝ) (hb' : 0 < b') (hbb : b' < b) (ha' : 0 ≤ a')
    (hratio : a' * b ≤ a * b') :
    a / b ≤ (a - a') / (b - b') := by
  sorry

/-- Route canonicalisation: in a valid Steiner shortcut, any original vertex visited by a
`G⁺`-route of a critical pair lies on its unique critical path. [RevivingThorupsShortcutConjecture, node_07] -/
theorem steiner_route_on_path {V W : Type} (E : Finset (V × V))
    (Eplus : Finset ((V ⊕ W) × (V ⊕ W))) (hval : ValidSteiner (edgeRel E) Eplus)
    (s z v : V)
    (h1 : Relation.ReflTransGen (plusAdj (edgeRel E) Eplus) (Sum.inl s) (Sum.inl v))
    (h2 : Relation.ReflTransGen (plusAdj (edgeRel E) Eplus) (Sum.inl v) (Sum.inl z)) :
    OnPath (edgeRel E) s z v := by
  sorry

/-- Layer localisation: a `G⁺`-walk of length `j` from `L_0` to `L_L` with `j (k-1) < L`
contains a Steiner excursion (consecutive original vertices `u, v` with only Steiner vertices
between them) spanning at least `k` layers. [RevivingThorupsShortcutConjecture, node_07] -/
theorem long_excursion_exists {V W : Type} (E : Finset (V × V)) (layer : V → ℕ)
    (Eplus : Finset ((V ⊕ W) × (V ⊕ W))) (hlay : IsLayered (edgeRel E) layer)
    (hval : ValidSteiner (edgeRel E) Eplus) (k L : ℕ) (s z : V) (hs : layer s = 0)
    (hz : layer z = L) (j : ℕ) (p : Fin (j + 1) → V ⊕ W)
    (hp : IsWalk (plusAdj (edgeRel E) Eplus) p) (h0 : p 0 = Sum.inl s)
    (h1 : p (Fin.last j) = Sum.inl z) (hj : j * (k - 1) < L) :
    ∃ (a b : Fin (j + 1)) (u v : V), a < b ∧ p a = Sum.inl u ∧ p b = Sum.inl v ∧
      (∀ i : Fin (j + 1), a < i → i < b → IsSteiner (p i)) ∧ layer u + k ≤ layer v := by
  sorry

/-- Route-signature count: if every Steiner vertex has fewer than `D` Steiner out-neighbours,
then from a fixed Steiner vertex there are at most `D^j` Steiner walks with `j` edges. [RevivingThorupsShortcutConjecture, node_07] -/
theorem steiner_path_count {W : Type} [Fintype W] (adjW : W → W → Prop) (D : ℕ)
    (hdeg : ∀ x : W, (Finset.univ.filter (fun y => adjW x y)).card ≤ D) (w : W) (j : ℕ) :
    (Finset.univ.filter (fun p : Fin (j + 1) → W =>
        p 0 = w ∧ ∀ i : Fin j, adjW (p i.castSucc) (p i.succ))).card ≤ D ^ j := by
  sorry

/-! ## Main theorems -/

/-- **Family statement.** There is `ε₀ > 0` such that for every `k ≥ 2`, every
`1 ≤ t ≤ (1-η)k`, and every sufficiently large `G ∈ 𝒢_k` with `m = 2^{ω(k log k)}`, no
reachability-preserving `t`-thick Steiner shortcut has both `h ≤ m^{ε₀/k}` and
`M ≤ m^{1+ε₀²/k}`. [RevivingThorupsShortcutConjecture, node_07] -/
theorem steiner_tradeoff_family (aΔ bΔ Cm Cp f : ℝ) (haΔ : 0 < aΔ) (hbΔ : 0 < bΔ)
    (hCm : 0 < Cm) (hCp : 0 < Cp) (hf : 0 < f) :
    ∃ ε0 : ℝ, 0 < ε0 ∧ ∃ A : ℝ, 0 < A ∧ ∀ k : ℕ, 2 ≤ k → ∃ r0 : ℕ, ∀ r : ℕ, r0 ≤ r →
      ∀ t : ℕ, 1 ≤ t → (t : ℝ) ≤ (1 - eta) * k →
      ∀ (V : Type) [Fintype V] (E : Finset (V × V)) (layer : V → ℕ) (P : Finset (V × V))
        (N : ℕ) (Δ : ℝ),
        HardInstance aΔ bΔ Cm Cp f k r (r ^ cExp) N Δ E layer P →
        (2 : ℝ) ^ (A * (k : ℝ) * Real.logb 2 (k : ℝ)) ≤ (E.card : ℝ) →
        ∀ (W : Type) [Fintype W] (Eplus : Finset ((V ⊕ W) × (V ⊕ W))),
          ValidSteiner (edgeRel E) Eplus → IsThick (edgeRel E) Eplus t →
          ¬ (DiamWithin (edgeRel E) Eplus ((E.card : ℝ) ^ (ε0 / (k : ℝ))) ∧
             (Eplus.card : ℝ) ≤ (E.card : ℝ) ^ (1 + ε0 ^ 2 / (k : ℝ))) := by
  sorry

/-- **Consequence.** For every `t ≥ 1` there are arbitrarily large `m`-edge graphs on which
every valid `t`-thick Steiner shortcut has `h ≥ m^{δ/t}` or `M ≥ m^{1+δ/t}`. [RevivingThorupsShortcutConjecture, node_07] -/
theorem steiner_tradeoff_general (aΔ bΔ Cm Cp f : ℝ) (haΔ : 0 < aΔ) (hbΔ : 0 < bΔ)
    (hCm : 0 < Cm) (hCp : 0 < Cp) (hf : 0 < f) (hfam : FamilyExists aΔ bΔ Cm Cp f) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ t : ℕ, 1 ≤ t → ∀ M0 : ℝ,
      ∃ (V : Type) (_ : Fintype V) (E : Finset (V × V)), M0 ≤ (E.card : ℝ) ∧
        ∀ (W : Type) [Fintype W] (Eplus : Finset ((V ⊕ W) × (V ⊕ W))),
          ValidSteiner (edgeRel E) Eplus → IsThick (edgeRel E) Eplus t →
          (∀ H : ℝ, DiamWithin (edgeRel E) Eplus H → (E.card : ℝ) ^ (δ / (t : ℝ)) ≤ H) ∨
          (E.card : ℝ) ^ (1 + δ / (t : ℝ)) ≤ (Eplus.card : ℝ) := by
  sorry

