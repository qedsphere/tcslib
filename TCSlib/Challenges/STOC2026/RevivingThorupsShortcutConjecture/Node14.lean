/-!
## A sparse `k`-thick Steiner shortcut with hop distance exactly `k` on critical pairs

Vertices of `G` are `(layer, p)` with layer index `i·k + j ∈ {0, …, kℓ}` (standing for
`L_{i,j}`; index `kℓ` is `L_{ℓ,0}`) and `p ∈ Q^k`, each coordinate of `Q ⊆ ℤ^d` encoded by
`Fin (2(r+1)rℓ)` with value `x - (r+1)rℓ + 1`. An edge out of layer `t` adds some `u ∈ B` to
coordinate `t mod k` and advances one layer.

The Steiner network `stagedNet` has Steiner states `(a, p)`, `a ∈ {0, …, k-2}` ("coordinates
`0..a` have received their displacement `ℓ·u`"): sources in `S ⊆ L_{0,0}` enter stage `0`,
stage `a` goes to stage `a+1`, stage `k-2` exits to `L_{ℓ,0}`, each step adding `ℓ·u`,
`u ∈ B`, to the next coordinate.

Main theorem `staged_shortcut`: `|E₊| ≤ k·N·Δ`, reachability is preserved, `G⁺` is `k`-thick,
and `dist_{G⁺}(s,t) = k` for every critical pair.
-/

namespace TCSChallenge.RevivingThorupsShortcutConjecture.node_14

/-! ## Shared definitions (identical across the rows of this paper) -/

/-- A walk `p 0 → p 1 → ⋯ → p j` of length `j` (number of edges) in the relation `adj`. -/
def IsWalk {α : Type} (adj : α → α → Prop) {j : ℕ} (p : Fin (j + 1) → α) : Prop :=
  ∀ i : Fin j, adj (p i.castSucc) (p i.succ)

/-- `dist(x, y) ≤ h`: some walk from `x` to `y` has at most `h` edges. -/
def HopWithin {α : Type} (adj : α → α → Prop) (x y : α) (h : ℝ) : Prop :=
  ∃ (j : ℕ) (p : Fin (j + 1) → α), IsWalk adj p ∧ p 0 = x ∧ p (Fin.last j) = y ∧ (j : ℝ) ≤ h

/-- `dist(x, y) ≥ h`: every walk from `x` to `y` has at least `h` edges. -/
def HopAtLeast {α : Type} (adj : α → α → Prop) (x y : α) (h : ℝ) : Prop :=
  ∀ (j : ℕ) (p : Fin (j + 1) → α), IsWalk adj p → p 0 = x → p (Fin.last j) = y → h ≤ (j : ℝ)

/-- Steiner vertices are the right summand of `V ⊕ W`. -/
def IsSteiner {V W : Type} : V ⊕ W → Prop
  | Sum.inl _ => False
  | Sum.inr _ => True

/-- Adjacency of `G⁺ = (V ∪ V₊, E ∪ E₊)`. -/
def plusAdj {V W : Type} (adj : V → V → Prop) (Eplus : Finset ((V ⊕ W) × (V ⊕ W)))
    (x y : V ⊕ W) : Prop :=
  (∃ u v : V, adj u v ∧ x = Sum.inl u ∧ y = Sum.inl v) ∨ (x, y) ∈ Eplus

/-- Reachability preserving: `u ⇝_G v ↔ u ⇝_{G⁺} v` for all `u v ∈ V`. -/
def ValidSteiner {V W : Type} (adj : V → V → Prop) (Eplus : Finset ((V ⊕ W) × (V ⊕ W))) :
    Prop :=
  ∀ u v : V, Relation.ReflTransGen adj u v ↔
    Relation.ReflTransGen (plusAdj adj Eplus) (Sum.inl u) (Sum.inl v)

/-- `t`-thick: every directed path (injective walk) consisting only of Steiner vertices has at
most `t - 1` vertices. -/
def IsThick {V W : Type} (adj : V → V → Prop) (Eplus : Finset ((V ⊕ W) × (V ⊕ W))) (t : ℕ) :
    Prop :=
  ∀ (j : ℕ) (p : Fin (j + 1) → V ⊕ W), IsWalk (plusAdj adj Eplus) p → Function.Injective p →
    (∀ i, IsSteiner (p i)) → j + 1 ≤ t - 1

/-! ## Row-specific definitions -/

/-- Side length `2(r+1)rℓ` of the box `Q = (-(r+1)rℓ, (r+1)rℓ]^d`. -/
def side (r ℓ : ℕ) : ℕ := 2 * (r + 1) * r * ℓ

/-- A point of `Q^k` (each of the `k` subvectors lies in `Q ⊆ ℤ^d`, encoded coordinatewise). -/
abbrev Pos (k d r ℓ : ℕ) : Type := Fin k → Fin d → Fin (side r ℓ)

/-- Original vertices: layer index in `{0, …, kℓ}` and a point of `Q^k`. -/
abbrev Vtx (k d r ℓ : ℕ) : Type := Fin (k * ℓ + 1) × Pos k d r ℓ

/-- Steiner states: stage `a ∈ {0, …, k-2}` and a point of `Q^k`. -/
abbrev Stg (k d r ℓ : ℕ) : Type := Fin (k - 1) × Pos k d r ℓ

/-- Integer value `x - (r+1)rℓ + 1 ∈ (-(r+1)rℓ, (r+1)rℓ]` of an encoded coordinate. -/
def cval (r ℓ : ℕ) (x : Fin (side r ℓ)) : ℤ :=
  (x.val : ℤ) - (((r + 1) * r * ℓ : ℕ) : ℤ) + 1

/-- `y = x + scale·u` in subvector `j` (other subvectors unchanged) for some `u ∈ B`. -/
def Shifted {k d : ℕ} (r ℓ : ℕ) (B : Finset (Fin d → ℤ)) (scale j : ℕ)
    (x y : Pos k d r ℓ) : Prop :=
  ∃ u ∈ B, ∀ (j' : Fin k) (i : Fin d),
    cval r ℓ (y j' i) = cval r ℓ (x j' i) + if j'.val = j then (scale : ℤ) * u i else 0

/-- Edges of `G`: out of layer `t`, add some `u ∈ B(r,d)` to subvector `t mod k` and advance one
layer (updates leaving `Q^k` are absent because positions live in `Q^k`). -/
def gEdge (k d r ℓ : ℕ) (B : Finset (Fin d → ℤ)) (x y : Vtx k d r ℓ) : Prop :=
  y.1.val = x.1.val + 1 ∧ Shifted r ℓ B 1 (x.1.val % k) x.2 y.2

/-- Admissible sources: all coordinates in `(-r²ℓ, r²ℓ]`. -/
def InS {k d : ℕ} (r ℓ : ℕ) (p : Pos k d r ℓ) : Prop :=
  ∀ (j : Fin k) (i : Fin d),
    -((r * r * ℓ : ℕ) : ℤ) < cval r ℓ (p j i) ∧ cval r ℓ (p j i) ≤ ((r * r * ℓ : ℕ) : ℤ)

/-- Critical pairs `P`: `s = ((0,0), p)` with `p ∈ S` and `t = ((ℓ,0), p + ℓ·v)` with
`v ∈ B(r,d)^k`. -/
def IsCritical (k d r ℓ : ℕ) (B : Finset (Fin d → ℤ)) (s t : Vtx k d r ℓ) : Prop :=
  s.1.val = 0 ∧ InS r ℓ s.2 ∧ t.1.val = k * ℓ ∧
    ∃ v : Fin k → Fin d → ℤ, (∀ j, v j ∈ B) ∧
      ∀ (j : Fin k) (i : Fin d), cval r ℓ (t.2 j i) = cval r ℓ (s.2 j i) + (ℓ : ℤ) * v j i

/-- Added edges of the staged network: entry from `S` into stage `0` (update subvector `0`),
stage `a → a+1` (update subvector `a+1`), exit from stage `k-2` into `L_{ℓ,0}` (update
subvector `k-1`); each update adds `ℓ·u`, `u ∈ B`. -/
def stagedEdge (k d r ℓ : ℕ) (B : Finset (Fin d → ℤ)) :
    Vtx k d r ℓ ⊕ Stg k d r ℓ → Vtx k d r ℓ ⊕ Stg k d r ℓ → Prop
  | Sum.inl x, Sum.inr y => x.1.val = 0 ∧ y.1.val = 0 ∧ InS r ℓ x.2 ∧ Shifted r ℓ B ℓ 0 x.2 y.2
  | Sum.inr x, Sum.inr y => y.1.val = x.1.val + 1 ∧ Shifted r ℓ B ℓ (x.1.val + 1) x.2 y.2
  | Sum.inr x, Sum.inl y =>
      x.1.val + 2 = k ∧ y.1.val = k * ℓ ∧ Shifted r ℓ B ℓ (x.1.val + 1) x.2 y.2
  | Sum.inl _, Sum.inl _ => False

/-- The added edge set `E₊`. -/
def stagedNet (k d r ℓ : ℕ) (B : Finset (Fin d → ℤ)) :
    Finset ((Vtx k d r ℓ ⊕ Stg k d r ℓ) × (Vtx k d r ℓ ⊕ Stg k d r ℓ)) :=
  Finset.univ.filter (fun e => stagedEdge k d r ℓ B e.1 e.2)

/-! ## Lemma stubs (rubric items) -/

/-- Edge count: at most `N·Δ` edges per stage transition, `k` transitions, `N = |Q|^k`. [RevivingThorupsShortcutConjecture, node_14] -/
theorem stagedNet_card (k d r ℓ : ℕ) (hk : 2 ≤ k) (B : Finset (Fin d → ℤ)) :
    (stagedNet k d r ℓ B).card ≤ k * side r ℓ ^ (d * k) * B.card := by
  sorry

/-- Every critical pair is reachable in `G` (the coordinate-cyclic route stays in `Q^k`). [RevivingThorupsShortcutConjecture, node_14] -/
theorem critical_reachable (k d r ℓ : ℕ) (hk : 2 ≤ k) (hℓ : 1 ≤ ℓ) (B : Finset (Fin d → ℤ))
    (hB : ∀ u ∈ B, ∀ i, |u i| ≤ (r : ℤ)) (s t : Vtx k d r ℓ) (h : IsCritical k d r ℓ B s t) :
    Relation.ReflTransGen (gEdge k d r ℓ B) s t := by
  sorry

/-- Soundness of shared recombination: every `G⁺`-route between original vertices decodes to
an original route (entries only from `S`, exits only into `L_{ℓ,0}`, every complete staged
path realises some `v ∈ B^k`). [RevivingThorupsShortcutConjecture, node_14] -/
theorem staged_sound (k d r ℓ : ℕ) (hk : 2 ≤ k) (hℓ : 1 ≤ ℓ) (B : Finset (Fin d → ℤ))
    (hB : ∀ u ∈ B, ∀ i, |u i| ≤ (r : ℤ)) (u v : Vtx k d r ℓ)
    (h : Relation.ReflTransGen (plusAdj (gEdge k d r ℓ B) (stagedNet k d r ℓ B))
      (Sum.inl u) (Sum.inl v)) :
    Relation.ReflTransGen (gEdge k d r ℓ B) u v := by
  sorry

/-- Completeness: every critical pair has a staged route with exactly `k` added edges. [RevivingThorupsShortcutConjecture, node_14] -/
theorem staged_complete (k d r ℓ : ℕ) (hk : 2 ≤ k) (hℓ : 1 ≤ ℓ) (B : Finset (Fin d → ℤ))
    (hB : ∀ u ∈ B, ∀ i, |u i| ≤ (r : ℤ)) (s t : Vtx k d r ℓ) (h : IsCritical k d r ℓ B s t) :
    HopWithin (plusAdj (gEdge k d r ℓ B) (stagedNet k d r ℓ B)) (Sum.inl s) (Sum.inl t) k := by
  sorry

/-- Stage-rank invariant, lower bound: no `G⁺`-walk between a critical pair has fewer than `k`
edges. [RevivingThorupsShortcutConjecture, node_14] -/
theorem staged_no_shorter (k d r ℓ : ℕ) (hk : 2 ≤ k) (hℓ : 1 ≤ ℓ) (B : Finset (Fin d → ℤ))
    (s t : Vtx k d r ℓ) (h : IsCritical k d r ℓ B s t) :
    HopAtLeast (plusAdj (gEdge k d r ℓ B) (stagedNet k d r ℓ B)) (Sum.inl s) (Sum.inl t) k := by
  sorry

/-! ## Main theorem -/

/-- **Staged Steiner shortcut.** For `k ≥ 2`, `r, ℓ ≥ 1` and critical subdirections
`B ⊆ [-r, r]^d`, the staged network adds at most `k·N·Δ` edges (`N = |Q|^k`, `Δ = |B|`;
`= O(m/ℓ)`), preserves reachability, is `k`-thick, and gives `dist_{G⁺}(s,t) = k` for every
critical pair. [RevivingThorupsShortcutConjecture, node_14] -/
theorem staged_shortcut (k d r ℓ : ℕ) (hk : 2 ≤ k) (hr : 1 ≤ r) (hℓ : 1 ≤ ℓ)
    (B : Finset (Fin d → ℤ)) (hB : ∀ u ∈ B, ∀ i, |u i| ≤ (r : ℤ)) :
    (stagedNet k d r ℓ B).card ≤ k * side r ℓ ^ (d * k) * B.card ∧
    ValidSteiner (gEdge k d r ℓ B) (stagedNet k d r ℓ B) ∧
    IsThick (gEdge k d r ℓ B) (stagedNet k d r ℓ B) k ∧
    ∀ s t : Vtx k d r ℓ, IsCritical k d r ℓ B s t →
      HopWithin (plusAdj (gEdge k d r ℓ B) (stagedNet k d r ℓ B)) (Sum.inl s) (Sum.inl t) k ∧
      HopAtLeast (plusAdj (gEdge k d r ℓ B) (stagedNet k d r ℓ B)) (Sum.inl s) (Sum.inl t) k := by
  sorry

end TCSChallenge.RevivingThorupsShortcutConjecture.node_14
