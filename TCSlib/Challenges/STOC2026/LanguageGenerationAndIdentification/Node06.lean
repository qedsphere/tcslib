/-!
## Generation in the limit from partial enumeration

Let `α` be a countable universe of strings and `L : ℕ → Set α` a listed family of infinite
languages. An adversary picks a target index `z`, an infinite subset `C ⊆ L z`, and an
enumeration `w : ℕ → α` of `C`. At round `t` the learner sees only `S_t = {w 0, …, w t}` and
outputs a string. We show that there is a learner (depending only on `L`) whose outputs
eventually always lie in `L z \ S_t`.

The concrete learner (`reservoirLearner`) keeps the candidates `L i` that contain `S_t`
("survivors"), forms the common part of the survivors with index `< k`, and takes as reservoir
the last infinite common part before the first finite one; if no finite cutoff exists it uses
depth `S_t.card + 1`. It outputs an element of the reservoir not in `S_t`.

Main theorems: `reservoirLearner_generates` (explicit rule) and `exists_generator_in_limit`.
-/

namespace TCSChallenge.LanguageGenerationAndIdentification.node_06

variable {α : Type}

/-- "`S_t = {w_1, …, w_t}`": the set of strings revealed up to round `t`
(enumeration indexed from 0, so this is `{w 0, …, w t}`). -/
def observed (w : ℕ → α) (t : ℕ) : Finset α :=
  (Finset.range (t + 1)).image w

/-- "Retain exactly those candidate languages that contain `S_t`": index `i` survives `S`. -/
def Survives (L : ℕ → Set α) (S : Finset α) (i : ℕ) : Prop :=
  (↑S : Set α) ⊆ L i

/-- The common part of the surviving candidates among the first `k` indices
(`⋂ {L i | i < k, L i ⊇ S}`, equal to the whole universe when there is none). -/
def commonUpTo (L : ℕ → Set α) (S : Finset α) (k : ℕ) : Set α :=
  {a | ∀ i, i < k → Survives L S i → a ∈ L i}

/-- "If adding surviving candidates eventually makes their common part finite, stop
immediately before the first such addition and use the resulting infinite common part.
If every finite initial segment has an infinite common part, use the common part of the
first `t` surviving candidates" (here depth `S.card + 1`). -/
def reservoir (L : ℕ → Set α) (S : Finset α) : Set α :=
  if h : ∃ k, (commonUpTo L S k).Finite then
    commonUpTo L S (Nat.find h - 1)
  else
    commonUpTo L S (S.card + 1)

/-- The concrete round-by-round rule: "choose `a_t` from the selected infinite set outside
`S_t`". The fallback `a0` is never used (by `reservoir_infinite`); it only makes the rule
total without a choice principle on `α`. -/
def reservoirLearner (L : ℕ → Set α) (a0 : α) (S : Finset α) : α :=
  if h : ∃ a, a ∈ reservoir L S ∧ a ∉ S then Classical.choose h else a0

/-! ## Lemma stubs (rubric items) -/

/-- Availability invariant: the selected reservoir is always infinite (this uses that every
`L i` is infinite, so the universe is infinite and the first finite cutoff is at `k ≥ 1`,
including the case where all finite common parts are infinite but the full countable
intersection is finite or empty). [LanguageGenerationAndIdentification, node_06] -/
theorem reservoir_infinite (L : ℕ → Set α) (hL : ∀ i, (L i).Infinite) (S : Finset α) :
    (reservoir L S).Infinite := by
  sorry

/-- Consequently the learner always outputs a reservoir element outside `S`. [LanguageGenerationAndIdentification, node_06] -/
theorem reservoirLearner_spec (L : ℕ → Set α) (hL : ∀ i, (L i).Infinite) (a0 : α)
    (S : Finset α) :
    reservoirLearner L a0 S ∈ reservoir L S ∧ reservoirLearner L a0 S ∉ S := by
  sorry

/-- The true target is never eliminated. [LanguageGenerationAndIdentification, node_06] -/
theorem target_survives (L : ℕ → Set α) (z : ℕ) (C : Set α) (hC : C ⊆ L z)
    (w : ℕ → α) (hw : Set.range w = C) (t : ℕ) :
    Survives L (observed w t) z := by
  sorry

/-- Finite-predecessor stabilization: after one finite stage, every surviving candidate with
index `< z` contains all of `C`. [LanguageGenerationAndIdentification, node_06] -/
theorem predecessor_stabilization (L : ℕ → Set α) (z : ℕ) (C : Set α)
    (w : ℕ → α) (hw : Set.range w = C) :
    ∃ t0, ∀ t, t0 ≤ t → ∀ i, i < z → Survives L (observed w t) i → C ⊆ L i := by
  sorry

/-- The observed sets grow without bound since `C` is infinite (so the no-cutoff depth
eventually passes `z`). [LanguageGenerationAndIdentification, node_06] -/
theorem observed_card_unbounded (C : Set α) (hCinf : C.Infinite)
    (w : ℕ → α) (hw : Set.range w = C) (N : ℕ) :
    ∃ t0, ∀ t, t0 ≤ t → N ≤ (observed w t).card := by
  sorry

/-- After stabilization the selected segment reaches the target: the reservoir is
eventually contained in `K = L z`. [LanguageGenerationAndIdentification, node_06] -/
theorem reservoir_eventually_subset_target (L : ℕ → Set α) (hL : ∀ i, (L i).Infinite)
    (z : ℕ) (C : Set α) (hC : C ⊆ L z) (hCinf : C.Infinite)
    (w : ℕ → α) (hw : Set.range w = C) :
    ∃ t1, ∀ t, t1 ≤ t → reservoir L (observed w t) ⊆ L z := by
  sorry

/-! ## Main theorems -/

/-- The explicit reservoir learner generates in the limit from partial enumeration. [LanguageGenerationAndIdentification, node_06] -/
theorem reservoirLearner_generates [Countable α] (L : ℕ → Set α) (hL : ∀ i, (L i).Infinite)
    (a0 : α) (z : ℕ) (C : Set α) (hC : C ⊆ L z) (hCinf : C.Infinite)
    (w : ℕ → α) (hw : Set.range w = C) :
    ∃ tstar, ∀ t, tstar ≤ t →
      reservoirLearner L a0 (observed w t) ∈ L z ∧
      reservoirLearner L a0 (observed w t) ∉ observed w t := by
  sorry

/-- For every countable listed family of infinite languages there is a learner (depending only
on the family) such that, for every target `K = L z`, infinite `C ⊆ K` and enumeration of `C`,
eventually `a_t ∈ K \ S_t`. [LanguageGenerationAndIdentification, node_06] -/
theorem exists_generator_in_limit [Countable α] (L : ℕ → Set α) (hL : ∀ i, (L i).Infinite) :
    ∃ G : Finset α → α, ∀ (z : ℕ) (C : Set α), C ⊆ L z → C.Infinite →
      ∀ w : ℕ → α, Set.range w = C →
        ∃ tstar, ∀ t, tstar ≤ t → G (observed w t) ∈ L z ∧ G (observed w t) ∉ observed w t := by
  sorry

end TCSChallenge.LanguageGenerationAndIdentification.node_06
