/-!
## Generation by finite conjunctions from a partial enumeration

Let `U` be countable and `X : ℕ → Set U` a fixed family `𝒳 = (L_i)`. We ask for maps
`Φ : List U → Finset ℕ` (the online rule; `Φ` applied to a list of length `t` is `Φ_t`),
always outputting a nonempty finite set of indices, such that for every `q`, every infinite
`C ⊆ L_q` and every enumeration `w : ℕ → U` with range exactly `C`, writing
`S_t = {w₁,…,w_t}`, `F_t = Φ_t(w₁,…,w_t)`, `H_t = ⋂_{i ∈ F_t} L_i`:
* every `i ∈ F_t` is consistent: `S_t ⊆ L_i`;
* eventually `H_t` is infinite and `H_t ⊆ L_q`;
* `C ⊆ H_t` for infinitely many `t`.

Main theorem: `exists_universal_rule`. Corollary: `eventually_exists_unseen` (for large `t`
there is `a_t ∈ H_t \ S_t`).
-/

namespace TCSChallenge.LanguageGenerationAndIdentification.node_12

variable {U : Type} [Countable U]

/-- The observed prefix `(w₁, …, w_t)` with `t = n + 1` (Lean indices `w 0, …, w n`). -/
def prefixList (w : ℕ → U) (n : ℕ) : List U :=
  List.ofFn (fun i : Fin (n + 1) => w i)

/-- `S_t = {w₁, …, w_t}` with `t = n + 1`. -/
def seen (w : ℕ → U) (n : ℕ) : Set U :=
  {u | ∃ i : Fin (n + 1), w i = u}

/-- `F_t = Φ_t(w₁, …, w_t)`. -/
def outIdx (Φ : List U → Finset ℕ) (w : ℕ → U) (n : ℕ) : Finset ℕ :=
  Φ (prefixList w n)

/-- `H_t = ⋂_{i ∈ F_t} L_i`. -/
def hyp (X : ℕ → Set U) (Φ : List U → Finset ℕ) (w : ℕ → U) (n : ℕ) : Set U :=
  ⋂ i ∈ outIdx Φ w n, X i

/-- The universal property demanded of the maps `Φ_t : U^t → [ℕ]^{<ω}_+` (`t ≥ 1`):
nonempty finite outputs, and for every `q`, every infinite `C ⊆ L_q` and every sequence
with range exactly `C`: consistency at all times, eventual validity (`|H_t| = ∞`,
`H_t ⊆ L_q`), and infinitely many times with `C ⊆ H_t`. -/
def UniversalRule (X : ℕ → Set U) (Φ : List U → Finset ℕ) : Prop :=
  (∀ s : List U, s ≠ [] → (Φ s).Nonempty) ∧
  ∀ (q : ℕ) (C : Set U), C ⊆ X q → Set.Infinite C →
    ∀ w : ℕ → U, Set.range w = C →
      (∀ n, ∀ i ∈ outIdx Φ w n, seen w n ⊆ X i) ∧
      (∃ T, ∀ n, T ≤ n → Set.Infinite (hyp X Φ w n) ∧ hyp X Φ w n ⊆ X q) ∧
      Set.Infinite {n : ℕ | C ⊆ hyp X Φ w n}

/-- Index `i` is consistent at time `t = n + 1`: `S_t ⊆ L_i`. -/
def Consistent (X : ℕ → Set U) (w : ℕ → U) (n i : ℕ) : Prop :=
  seen w n ⊆ X i

/-- Rubric 2 (stable prefix): eventually every index `i ≤ q` that is still consistent
contains all of `C`, and the indices `≤ q` whose languages contain `C` stay consistent
forever. [LanguageGenerationAndIdentification, node_12] -/
theorem eventually_consistent_below_full (X : ℕ → Set U) (q : ℕ) (C : Set U)
    (hCq : C ⊆ X q) (w : ℕ → U) (hw : Set.range w = C) :
    ∃ T, ∀ n, T ≤ n → ∀ i, i ≤ q → (Consistent X w n i ↔ C ⊆ X i) := by
  sorry

/-- An index whose language contains `C` is consistent at every time. [LanguageGenerationAndIdentification, node_12] -/
theorem consistent_of_full (X : ℕ → Set U) (C : Set U) (w : ℕ → U)
    (hw : Set.range w = C) (i : ℕ) (hi : C ⊆ X i) (n : ℕ) : Consistent X w n i := by
  sorry

/-- Main theorem: an online finite-conjunction rule with the universal property exists. [LanguageGenerationAndIdentification, node_12] -/
theorem exists_universal_rule (X : ℕ → Set U) :
    ∃ Φ : List U → Finset ℕ, UniversalRule X Φ := by
  sorry

/-- Deduction: for every sufficiently large `t` there is an unseen element
`a_t ∈ H_t \ S_t ⊆ L_q \ S_t`. [LanguageGenerationAndIdentification, node_12] -/
theorem eventually_exists_unseen (X : ℕ → Set U) (Φ : List U → Finset ℕ)
    (hΦ : UniversalRule X Φ) (q : ℕ) (C : Set U) (hCq : C ⊆ X q) (hC : Set.Infinite C)
    (w : ℕ → U) (hw : Set.range w = C) :
    ∃ T, ∀ n, T ≤ n → ∃ a, a ∈ hyp X Φ w n ∧ a ∉ seen w n ∧ a ∈ X q := by
  sorry

end TCSChallenge.LanguageGenerationAndIdentification.node_12
