/-!
## Identification in the limit from full positive enumeration is countable + T_D

Let `A` (the paper's `Σ`) be countable; symbols are `Option A` with `none` the pause `#`.
A learner is any `M : List (Option A) → Set A`. `M` identifies `𝒞 ⊆ 𝒫(A)` in the limit if
for every `L ∈ 𝒞` and every full text `T` for `L` (non-pause range exactly `L`), the
outputs `M(T↾n)` are eventually always `L`.

On `𝒞` (as the subtype `↥𝒞`) put the topology `𝒯_full` generated by
`V_a = {K ∈ 𝒞 | a ∈ K}`. The space is `T_D` if `cl({x}) \ {x}` is closed for every `x`.

Main theorem `identifiable_iff`: `𝒞` is identifiable iff `𝒞` is countable and
`(𝒞, 𝒯_full)` is `T_D`.
-/

namespace TCSChallenge.LanguageGenerationAndIdentification.node_31

variable {A : Type} [Countable A]

/-- `cont(σ)`: the symbols from `Σ` occurring in `σ` (pauses `none` ignored). -/
def cont (σ : List (Option A)) : Set A :=
  {a | some a ∈ σ}

/-- `T` is a full text for `L`: its non-pause symbols have range exactly `L`. -/
def IsFullText (L : Set A) (T : ℕ → Option A) : Prop :=
  ∀ a, a ∈ L ↔ ∃ n, T n = some a

/-- The prefix `T↾n = (T 0, …, T (n-1))`. -/
def textPrefix (T : ℕ → Option A) (n : ℕ) : List (Option A) :=
  List.ofFn (fun i : Fin n => T i)

/-- `M` identifies `𝒞` in the limit from full positive enumeration. -/
def Identifies (M : List (Option A) → Set A) (𝒞 : Set (Set A)) : Prop :=
  ∀ L ∈ 𝒞, ∀ T : ℕ → Option A, IsFullText L T →
    ∃ n₀, ∀ n, n₀ ≤ n → M (textPrefix T n) = L

/-- `𝒞` is identifiable: some (arbitrary, non-computable) learner identifies it. -/
def Identifiable (𝒞 : Set (Set A)) : Prop :=
  ∃ M : List (Option A) → Set A, Identifies M 𝒞

/-- `V_a = {K ∈ 𝒞 : a ∈ K}`, as a subset of the subtype `↥𝒞`. -/
def basicV (𝒞 : Set (Set A)) (a : A) : Set ↥𝒞 :=
  {K | a ∈ K.1}

/-- `𝒯_full`: the smallest topology on `𝒞` containing every `V_a`. -/
def fullTop (𝒞 : Set (Set A)) : TopologicalSpace ↥𝒞 :=
  TopologicalSpace.generateFrom (Set.range (basicV 𝒞))

/-- `(𝒞, 𝒯_full)` is `T_D`: `cl({x}) \ {x}` is closed for every `x`. -/
def IsTD (𝒞 : Set (Set A)) : Prop :=
  ∀ x : ↥𝒞, @IsClosed ↥𝒞 (fullTop 𝒞) (@closure ↥𝒞 (fullTop 𝒞) {x} \ {x})

/-- Rubric 1: `K ∈ cl({L})` iff `K ⊆ L`. [LanguageGenerationAndIdentification, node_31] -/
theorem mem_closure_singleton_iff (𝒞 : Set (Set A)) (K L : ↥𝒞) :
    K ∈ @closure ↥𝒞 (fullTop 𝒞) {L} ↔ K.1 ⊆ L.1 := by
  sorry

/-- Rubric 1: `cl({L}) \ {L}` is closed iff some finite `D ⊆ L` is contained in no proper
sublanguage `K ⊊ L` of the family. [LanguageGenerationAndIdentification, node_31] -/
theorem td_at_iff_finite_witness (𝒞 : Set (Set A)) (L : ↥𝒞) :
    @IsClosed ↥𝒞 (fullTop 𝒞) (@closure ↥𝒞 (fullTop 𝒞) {L} \ {L}) ↔
      ∃ D : Set A, D.Finite ∧ D ⊆ L.1 ∧ ∀ K ∈ 𝒞, K ⊂ L.1 → ¬ D ⊆ K := by
  sorry

/-- Rubric 2: an identifiable family is countable. [LanguageGenerationAndIdentification, node_31] -/
theorem countable_of_identifiable (𝒞 : Set (Set A)) (h : Identifiable 𝒞) :
    𝒞.Countable := by
  sorry

/-- Rubric 3 (locking sequence): if `M` identifies `𝒞` and `L ∈ 𝒞`, there is a finite `σ`
with `cont σ ⊆ L` such that `M(σ ⌢ ρ) = L` for every finite `ρ` with `cont ρ ⊆ L`. [LanguageGenerationAndIdentification, node_31] -/
theorem exists_locking_sequence (M : List (Option A) → Set A) (𝒞 : Set (Set A))
    (hM : Identifies M 𝒞) (L : Set A) (hL : L ∈ 𝒞) :
    ∃ σ : List (Option A), cont σ ⊆ L ∧
      ∀ ρ : List (Option A), cont ρ ⊆ L → M (σ ++ ρ) = L := by
  sorry

/-- Rubric 4 (sufficiency core): a countable family in which every member has a finite
witness against its proper sublanguages is identifiable. [LanguageGenerationAndIdentification, node_31] -/
theorem identifiable_of_witnesses (𝒞 : Set (Set A)) (hc : 𝒞.Countable)
    (hD : ∀ L ∈ 𝒞, ∃ D : Set A, D.Finite ∧ D ⊆ L ∧ ∀ K ∈ 𝒞, K ⊂ L → ¬ D ⊆ K) :
    Identifiable 𝒞 := by
  sorry

/-- Main theorem: `𝒞` is identifiable in the limit from full positive enumeration iff `𝒞`
is countable and `(𝒞, 𝒯_full)` is `T_D`. [LanguageGenerationAndIdentification, node_31] -/
theorem identifiable_iff (𝒞 : Set (Set A)) :
    Identifiable 𝒞 ↔ 𝒞.Countable ∧ IsTD 𝒞 := by
  sorry

