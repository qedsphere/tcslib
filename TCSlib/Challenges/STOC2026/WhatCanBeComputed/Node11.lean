/-!
## Local FO formulas on bounded-expansion graphs are decidable in `O(log n)` CONGEST rounds

For every fixed local first-order formula `φ(x)` over a finite label alphabet `Λ` and every
bounded-expansion class `𝒢`, there is a deterministic `CONGEST` algorithm that, within
`O(log n)` rounds and with `O(log n)`-bit messages, marks exactly the vertices `v` with
`(G, ℓ) ⊨ φ(v)`. The distributed computation of low-treedepth colorings is a supplied
hypothesis (`ColoringFact`). Main theorem: `local_fo_congest_log_rounds`.
-/

namespace TCSChallenge.WhatCanBeComputedLocallyRevisited.node_11

/-! ### Shared definitions (byte-identical in S00 and S01) -/

/-- First-order formulas over `FO[Λ]`: equality, adjacency, unary label predicates,
negation, conjunction and existential quantification. Variables are natural numbers;
the distinguished free variable `x` of a unary formula is variable `0`. -/
inductive FOFormula (Λ : Type) : Type
  | eq (i j : ℕ) : FOFormula Λ
  | adj (i j : ℕ) : FOFormula Λ
  | lab (a : Λ) (i : ℕ) : FOFormula Λ
  | neg (φ : FOFormula Λ) : FOFormula Λ
  | conj (φ ψ : FOFormula Λ) : FOFormula Λ
  | ex (i : ℕ) (φ : FOFormula Λ) : FOFormula Λ

/-- Satisfaction `(G, ℓ) ⊨ φ[s]` for a labeled graph, `ℓ : V → 2^Λ`. -/
def Sat {Λ V : Type} (G : SimpleGraph V) (ℓ : V → Finset Λ) :
    (ℕ → V) → FOFormula Λ → Prop
  | s, .eq i j => s i = s j
  | s, .adj i j => G.Adj (s i) (s j)
  | s, .lab a i => a ∈ ℓ (s i)
  | s, .neg φ => ¬ Sat G ℓ s φ
  | s, .conj φ ψ => Sat G ℓ s φ ∧ Sat G ℓ s ψ
  | s, .ex i φ => ∃ v : V, Sat G ℓ (Function.update s i v) φ

/-- Free variables of a formula. -/
def freeVars {Λ : Type} : FOFormula Λ → Finset ℕ
  | .eq i j => {i, j}
  | .adj i j => {i, j}
  | .lab _ i => {i}
  | .neg φ => freeVars φ
  | .conj φ ψ => freeVars φ ∪ freeVars ψ
  | .ex i φ => (freeVars φ).erase i

/-- Quantifier-free formulas. -/
def IsQF {Λ : Type} : FOFormula Λ → Prop
  | .eq _ _ => True
  | .adj _ _ => True
  | .lab _ _ => True
  | .neg φ => IsQF φ
  | .conj φ ψ => IsQF φ ∧ IsQF ψ
  | .ex _ _ => False

/-- `(G, ℓ) ⊨ φ(v)`: the unary formula `φ(x)` holds at `v` (all variables are set to `v`;
for a formula whose only free variable is `0` this is the usual semantics). -/
def HoldsAt {Λ V : Type} (G : SimpleGraph V) (ℓ : V → Finset Λ) (φ : FOFormula Λ)
    (v : V) : Prop :=
  Sat G ℓ (fun _ => v) φ

/-- "`B_G(v,r) = {u ∈ V : dist_G(u,v) ≤ r}`", with the distance bound stated as the
existence of a walk of length `≤ r` (so unreachable vertices are excluded). -/
def ball {V : Type} (G : SimpleGraph V) (v : V) (r : ℕ) : Set V :=
  {u | ∃ p : G.Walk u v, p.length ≤ r}

/-- "A formula `φ(x)` is `r`-local if its truth at `v` is determined by the rooted labeled
isomorphism type of `B_G(v,r)`, and it is local if such an `r` exists independently of `n`."
The isomorphism is between the induced labeled balls and maps the root to the root. -/
def IsLocal {Λ : Type} (φ : FOFormula Λ) : Prop :=
  ∃ r : ℕ, ∀ (V W : Type) [Fintype V] [Fintype W] (G : SimpleGraph V) (H : SimpleGraph W)
    (ℓ : V → Finset Λ) (ℓ' : W → Finset Λ) (v : V) (w : W)
    (e : ↥(ball G v r) ≃ ↥(ball H w r)),
    (∀ a b : ↥(ball G v r), G.Adj a.1 b.1 ↔ H.Adj (e a).1 (e b).1) →
    (∀ a : ↥(ball G v r), ℓ a.1 = ℓ' (e a).1) →
    (∀ a : ↥(ball G v r), a.1 = v → (e a).1 = w) →
    (HoldsAt G ℓ φ v ↔ HoldsAt H ℓ' φ w)

/-- A graph class: a predicate on simple graphs over arbitrary vertex types. -/
abbrev GraphClass : Type 1 := (V : Type) → SimpleGraph V → Prop

/-- `a` is an ancestor of `b` (or equal to it) in the forest given by the parent map. -/
def IsAnc {V : Type} (par : V → V) (a b : V) : Prop :=
  ∃ k : ℕ, par^[k] b = a

/-- A rooted forest on `U` of depth at most `q` (depths `1..q`, roots are fixed points of
`par`, every non-root has its parent in `U` one level up) such that "the endpoints of every
graph edge are comparable in the ancestor relation". -/
def ForestWitness {V : Type} (G : SimpleGraph V) (U : Set V) (q : ℕ) (par : V → V)
    (d : V → ℕ) : Prop :=
  (∀ u ∈ U, 1 ≤ d u ∧ d u ≤ q ∧ (d u = 1 → par u = u) ∧
      (d u ≠ 1 → par u ∈ U ∧ d (par u) + 1 = d u)) ∧
    ∀ u ∈ U, ∀ w ∈ U, G.Adj u w → (IsAnc par u w ∨ IsAnc par w u)

/-- "`G[U]` has treedepth at most `q`." -/
def TreedepthLE {V : Type} (G : SimpleGraph V) (U : Set V) (q : ℕ) : Prop :=
  ∃ (par : V → V) (d : V → ℕ), ForestWitness G U q par d

/-- "A proper coloring `c : V → [k]` for which the union of any at most `q` color classes
induces a graph of treedepth at most `q`." -/
def IsLowTDColoring {V : Type} (G : SimpleGraph V) (q : ℕ) {k : ℕ} (c : V → Fin k) : Prop :=
  (∀ u v, G.Adj u v → c u ≠ c v) ∧
    ∀ S : Finset (Fin k), S.card ≤ q → TreedepthLE G {v | c v ∈ S} q

/-- Bounded expansion with witness function `f`: "for every fixed `q > 0`, every `G ∈ 𝒢`
has a proper coloring `c : V → [f(q)]` for which the union of any at most `q` color classes
induces a graph of treedepth at most `q`." -/
def BoundedExpansionWith (cls : GraphClass) (f : ℕ → ℕ) : Prop :=
  ∀ q : ℕ, 0 < q → ∀ (V : Type) [Fintype V] (G : SimpleGraph V), cls V G →
    ∃ c : V → Fin (f q), IsLowTDColoring G q c

/-- A deterministic synchronous message-passing algorithm (`CONGEST` once message sizes are
bounded, see `CongestionOK`). A vertex starts from `n`, its identifier, its labels and the
identifiers of its neighbours; in each round it sends `send s j` to the neighbour with
identifier `j` and updates its state from the received messages (indexed by sender id;
non-neighbours contribute `0`). `output = none` means "not decided yet". Local state and
computation are unbounded, as in `CONGEST`. -/
structure CongestAlg (Λ Out : Type) : Type 1 where
  State : Type
  init : ℕ → ℕ → Finset Λ → Finset ℕ → State
  send : State → ℕ → ℕ
  update : State → (ℕ → ℕ) → State
  output : State → Option Out

/-- States of all vertices after `t` synchronous rounds. -/
def run {Λ Out V : Type} [Fintype V] (A : CongestAlg Λ Out) (G : SimpleGraph V)
    (ids : V → ℕ) (ℓ : V → Finset Λ) : ℕ → V → A.State
  | 0, v => A.init (Fintype.card V) (ids v) (ℓ v) ((Finset.univ.filter (G.Adj v)).image ids)
  | t + 1, v => A.update (run A G ids ℓ t v)
      (fun i => ∑ u ∈ Finset.univ.filter (fun u => G.Adj u v ∧ ids u = i),
        A.send (run A G ids ℓ t u) (ids v))

/-- Bandwidth: every message sent across an edge in any round is a number `< n^C`, i.e. has
`O(log n)` bits. -/
def CongestionOK {Λ Out V : Type} [Fintype V] (A : CongestAlg Λ Out) (G : SimpleGraph V)
    (ids : V → ℕ) (ℓ : V → Finset Λ) (C : ℕ) : Prop :=
  ∀ (t : ℕ) (u v : V), G.Adj u v → A.send (run A G ids ℓ t u) (ids v) < Fintype.card V ^ C

/-- "Unique `O(log n)`-bit identifiers": injective, below `n^cid`. -/
def ValidIds {V : Type} [Fintype V] (ids : V → ℕ) (cid : ℕ) : Prop :=
  Function.Injective ids ∧ ∀ v, ids v < Fintype.card V ^ cid

/-- Every vertex `v` never outputs anything but `ans v`, and has output `ans v` from round
`T` on. -/
def DecidesBy {Λ Out V : Type} [Fintype V] (A : CongestAlg Λ Out) (G : SimpleGraph V)
    (ids : V → ℕ) (ℓ : V → Finset Λ) (T : ℕ) (ans : V → Out) : Prop :=
  ∀ v : V, (∀ t : ℕ, A.output (run A G ids ℓ t v) = none ∨
      A.output (run A G ids ℓ t v) = some (ans v)) ∧
    ∀ t : ℕ, T ≤ t → A.output (run A G ids ℓ t v) = some (ans v)

/-- Diameter at most `D`. -/
def DiamLE {V : Type} (G : SimpleGraph V) (D : ℕ) : Prop :=
  ∀ u v : V, ∃ p : G.Walk u v, p.length ≤ D

/-- Supplied structural input (used without proof): "for every fixed `q`, a coloring with
the bounded-treedepth property and a class-dependent constant number of colors can be
computed deterministically in `O(log n)` rounds on `𝒢`." -/
def ColoringFact (Λ : Type) (cls : GraphClass) (f : ℕ → ℕ) : Prop :=
  ∀ q : ℕ, 0 < q → ∀ cid : ℕ, ∃ (A : CongestAlg Λ (Fin (f q))) (K C : ℕ),
    ∀ (V : Type) [Fintype V] (G : SimpleGraph V) (ℓ : V → Finset Λ) (ids : V → ℕ),
      cls V G → ValidIds ids cid →
        CongestionOK A G ids ℓ C ∧ ∃ c : V → Fin (f q), IsLowTDColoring G q c ∧
          DecidesBy A G ids ℓ (K * (Nat.log 2 (Fintype.card V) + 1)) c

/-- Supplied structural input, forest version: the coloring together with, for every set `S`
of at most `q` colors, a rooted-forest witness of depth `≤ q` for `G[c⁻¹(S)]`; each vertex
learns its color and, for every `S`, its parent's identifier and its depth. -/
def ColoringForestFact (Λ : Type) (cls : GraphClass) (f : ℕ → ℕ) : Prop :=
  ∀ q : ℕ, 0 < q → ∀ cid : ℕ,
    ∃ (A : CongestAlg Λ (Fin (f q) × (Finset (Fin (f q)) → ℕ × ℕ))) (K C : ℕ),
    ∀ (V : Type) [Fintype V] (G : SimpleGraph V) (ℓ : V → Finset Λ) (ids : V → ℕ),
      cls V G → ValidIds ids cid →
        CongestionOK A G ids ℓ C ∧
        ∃ (c : V → Fin (f q)) (par : Finset (Fin (f q)) → V → V)
          (d : Finset (Fin (f q)) → V → ℕ),
          (∀ u v, G.Adj u v → c u ≠ c v) ∧
          (∀ S : Finset (Fin (f q)), S.card ≤ q →
            ForestWitness G {v | c v ∈ S} q (par S) (d S)) ∧
          DecidesBy A G ids ℓ (K * (Nat.log 2 (Fintype.card V) + 1))
            (fun v => (c v, fun S => (ids (par S v), d S v)))

/-! ### Shared lemma stubs -/

/-- Induced pieces are sound: a quantifier-free formula has the same truth value under an
assignment into `U` in `G[U]` and in `G` (labels, equalities, adjacencies and
non-adjacencies are inherited). [WhatCanBeComputed, node_11] -/
theorem qf_induced_iff {Λ V : Type} (G : SimpleGraph V) (ℓ : V → Finset Λ) (U : Set V)
    (φ : FOFormula Λ) (hqf : IsQF φ) (s : ℕ → U) :
    Sat (G.induce U) (fun u => ℓ u.1) s φ ↔ Sat G ℓ (fun i => (s i).1) φ := by
  sorry

/-- Bounded parent-chain certificates: in a forest witness of depth `≤ q`, ancestry of a
vertex of `U` is witnessed by fewer than `q` parent steps, so ancestor tests are expressible
with a formula-dependent number of existential variables. [WhatCanBeComputed, node_11] -/
theorem isAnc_iff_bounded {V : Type} (G : SimpleGraph V) (U : Set V) (q : ℕ)
    (par : V → V) (d : V → ℕ) (hF : ForestWitness G U q par d) (a u : V) (hu : u ∈ U) :
    IsAnc par a u ↔ ∃ k : ℕ, k < q ∧ par^[k] u = a := by
  sorry

/-! ### Row-specific lemma stubs and main theorem -/

/-- Witnesses together with their distance paths fit into few colors: `m` vertices, each
joined to `v` by a walk of length `≤ r`, use at most `m (r + 1)` colors, so one set of at
most `q = m (r + 1)` color classes contains the whole witness configuration. [WhatCanBeComputed, node_11] -/
theorem colors_cover_walks {V : Type} (G : SimpleGraph V) {k : ℕ} (c : V → Fin k) (v : V)
    (m r : ℕ) (us : Fin m → V) (ps : (i : Fin m) → G.Walk (us i) v)
    (hps : ∀ i, (ps i).length ≤ r) :
    ∃ S : Finset (Fin k), S.card ≤ m * (r + 1) ∧ ∀ i, ∀ x ∈ (ps i).support, c x ∈ S := by
  sorry

/-- **Main theorem.** For every fixed local `FO` formula `φ(x)` and bounded-expansion class
`𝒢` (given the supplied distributed coloring input), there is a deterministic
`O(log n)`-round `CONGEST` algorithm marking exactly those `v` with `(G, ℓ) ⊨ φ(v)`. [WhatCanBeComputed, node_11] -/
theorem local_fo_congest_log_rounds {Λ : Type} [Fintype Λ] (φ : FOFormula Λ)
    (hfv : freeVars φ ⊆ {0}) (hloc : IsLocal φ) (cls : GraphClass) (f : ℕ → ℕ)
    (hbe : BoundedExpansionWith cls f) (hcol : ColoringFact Λ cls f) :
    ∀ cid : ℕ, ∃ (A : CongestAlg Λ Bool) (K C : ℕ),
      ∀ (V : Type) [Fintype V] (G : SimpleGraph V) (ℓ : V → Finset Λ) (ids : V → ℕ),
        cls V G → ValidIds ids cid →
          CongestionOK A G ids ℓ C ∧
          ∃ b : V → Bool, (∀ v, b v = true ↔ HoldsAt G ℓ φ v) ∧
            DecidesBy A G ids ℓ (K * (Nat.log 2 (Fintype.card V) + 1)) b := by
  sorry

