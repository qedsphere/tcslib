/-!
## Zero-freeness of mixed p-spin partition functions below the second-moment threshold

For the mixed p-spin Hamiltonian
`H_G(σ) = ∑_{p=2}^{pmax} γ_p n^{-(p-1)/2} ∑_{i_1..i_p} G_{i_1..i_p} σ_{i_1}⋯σ_{i_p}`
with i.i.d. standard Gaussian disorder, and spins drawn from the uniform measure on the
hypercube `{±1}^n` or on the sphere `‖σ‖² = n`, the partition function
`Z_G(β) = E_σ exp(β H_G(σ))` (β ∈ ℂ) is shown to be zero-free on the disk
`D(0, (1-ε) β_2nd)` with probability `1 - δ(ε,n) → 1`, given the model-specific
second-moment input (an analytic multiplier `A_G` with `A_G(0) = 1` and the decomposition of
`E_G |A_G Z_G|²` as an overlap expectation with the stated error bounds).

Main theorem: `zeroFree_whp`.
-/

namespace TCSChallenge.OnZerosAndAlgorithms.node_06

open MeasureTheory ProbabilityTheory Filter Metric Real
open BooleanAnalysis.ThresholdFunctions (standardGaussianMeasure)
open scoped NNReal Topology

/-- The two spin priors: `cube` = Unif({±1}^n), `sphere` = Unif({σ : ‖σ‖₂² = n}). -/
inductive SpinModel
  | cube
  | sphere
  deriving DecidableEq

/-- The disorder: for each `p ≤ pmax`, a tensor `G_p : [n]^p → ℝ`
("the entries of G are independent standard Gaussians"). Only `2 ≤ p` is used. -/
abbrev Disorder (n pmax : ℕ) : Type :=
  (p : Fin (pmax + 1)) → (Fin (p : ℕ) → Fin n) → ℝ

/-- Law of the disorder: all entries i.i.d. `N(0,1)` (TCSlib's `standardGaussianMeasure`). -/
def disorderMeasure (n pmax : ℕ) : Measure (Disorder n pmax) :=
  Measure.pi (fun p : Fin (pmax + 1) =>
    Measure.pi (fun _ : Fin (p : ℕ) → Fin n => standardGaussianMeasure))

/-- `H_G(σ) = ∑_{p=2}^{pmax} γ_p / n^{(p-1)/2} ∑_{i_1,…,i_p} G_{i_1…i_p} ∏_j σ_{i_j}`. -/
def hamiltonian (n pmax : ℕ) (γ : ℕ → ℝ) (G : Disorder n pmax) (σ : Fin n → ℝ) : ℝ :=
  ∑ p : Fin (pmax + 1),
    if 2 ≤ (p : ℕ) then
      γ p / (n : ℝ) ^ ((((p : ℕ) : ℝ) - 1) / 2) *
        ∑ i : Fin (p : ℕ) → Fin n, G p i * ∏ j, σ (i j)
    else 0

/-- `±1` spin vector attached to a Boolean vector. -/
def spinOfBool {n : ℕ} (s : Fin n → Bool) : Fin n → ℝ :=
  fun i => if s i then 1 else -1

/-- The (unnormalised) surface measure on the unit sphere of `ℝ^n`. -/
def unitSphereMeasure (n : ℕ) : Measure (sphere (0 : EuclideanSpace ℝ (Fin n)) 1) :=
  (volume : Measure (EuclideanSpace ℝ (Fin n))).toSphere

/-- `Z_G(β) = E_{σ∼ϱ} e^{β H_G(σ)}` for `β ∈ ℂ`. In the spherical case the uniform measure
on `{‖σ‖₂² = n}` is the normalised surface measure on the unit sphere pushed by `x ↦ √n x`. -/
def partitionFn (model : SpinModel) (n pmax : ℕ) (γ : ℕ → ℝ) (G : Disorder n pmax)
    (β : ℂ) : ℂ :=
  match model with
  | SpinModel.cube =>
      ((2 : ℂ) ^ n)⁻¹ *
        ∑ s : Fin n → Bool, Complex.exp (β * (hamiltonian n pmax γ G (spinOfBool s) : ℂ))
  | SpinModel.sphere =>
      (((unitSphereMeasure n) Set.univ).toReal : ℂ)⁻¹ *
        ∫ x, Complex.exp (β * (hamiltonian n pmax γ G
          (fun i => Real.sqrt n * ((x : EuclideanSpace ℝ (Fin n)).ofLp i)) : ℂ))
          ∂(unitSphereMeasure n)

/-- `ξ(m) = ∑_{p=2}^{pmax} γ_p² m^p`. -/
def xi (pmax : ℕ) (γ : ℕ → ℝ) (m : ℝ) : ℝ :=
  ∑ p ∈ Finset.Icc 2 pmax, γ p ^ 2 * m ^ p

/-- The entropy function `h(m)`: hypercube
`-(1/2)((1-m)log(1-m) + (1+m)log(1+m))` (with `0 log 0 = 0`, automatic since `Real.log 0 = 0`),
sphere `(1/2) log(1-m²)` (the value `-∞` at `m = ±1` is handled in `Admissible`). -/
def hEnt (model : SpinModel) (m : ℝ) : ℝ :=
  match model with
  | SpinModel.cube => -(1 / 2) * ((1 - m) * Real.log (1 - m) + (1 + m) * Real.log (1 + m))
  | SpinModel.sphere => (1 / 2) * Real.log (1 - m ^ 2)

/-- `φ_s(m) = s² ξ(m) + h(m)`. -/
def phi (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ) (s m : ℝ) : ℝ :=
  s ^ 2 * xi pmax γ m + hEnt model m

/-- `s` is admissible: `φ_s(m) < 0` for all `m ∈ [-1,1] \ {0}` and `φ_s''(0) < 0`.
In the spherical case `φ_s(±1) = -∞ < 0` holds by convention, so `m = ±1` is skipped. -/
def Admissible (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ) (s : ℝ) : Prop :=
  (∀ m ∈ Set.Icc (-1 : ℝ) 1, m ≠ 0 → (model = SpinModel.sphere → |m| < 1) →
      phi model pmax γ s m < 0) ∧
    iteratedDeriv 2 (phi model pmax γ s) 0 < 0

/-- The set `{s ≥ 0 : s admissible}`. -/
def admissibleSet (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ) : Set ℝ :=
  {s | 0 ≤ s ∧ Admissible model pmax γ s}

/-- `β_2nd = sup {s ≥ 0 : φ_s(m) < 0 ∀ m ∈ [-1,1]\{0}, φ_s''(0) < 0}`. -/
def beta2nd (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ) : ℝ :=
  sSup (admissibleSet model pmax γ)

/-- Normalising constant `Γ(n/2) / (√π Γ((n-1)/2))` of the spherical overlap density. -/
def sphereOverlapConst (n : ℕ) : ℝ :=
  Real.Gamma ((n : ℝ) / 2) / (Real.sqrt Real.pi * Real.Gamma (((n : ℝ) - 1) / 2))

/-- `E_q[f(q)]` for the overlap `q = ⟨σ,τ⟩/n` of two independent samples of `ϱ`, using the
laws given in the problem: `P(q = (2k-n)/n) = 2^{-n} C(n,k)` (cube) and density
`Γ(n/2)/(√π Γ((n-1)/2)) (1-m²)^{(n-3)/2} 1_{(-1,1)}(m)` (sphere). -/
def overlapExp (model : SpinModel) (n : ℕ) (f : ℝ → ℂ) : ℂ :=
  match model with
  | SpinModel.cube =>
      ∑ k ∈ Finset.range (n + 1),
        ((2 : ℂ) ^ n)⁻¹ * (n.choose k : ℂ) * f ((2 * (k : ℝ) - n) / n)
  | SpinModel.sphere =>
      ∫ m in Set.Ioo (-1 : ℝ) 1,
        ((sphereOverlapConst n * (1 - m ^ 2) ^ (((n : ℝ) - 3) / 2) : ℝ) : ℂ) * f m

/-- `K = ⌊log log n⌋`. -/
def Kn (n : ℕ) : ℕ := ⌊Real.log (Real.log n)⌋₊

/-- `α = 0.01`. -/
def alphaSmall : ℝ := 1 / 100

/-- The model-specific input. With `b = β_2nd`, `R = (1-ε/2) b`, `t = ξ''(0)`:
for every `n ≥ 2` there is a random `A_G` analytic near `closedBall 0 R` with `A_G(0) = 1`, and
uniformly for `|β| ≤ R`:
`E_G |A_G(β) Z_G(β)|² = E_q[e^{n|β|² ξ(q)} V_n(β,q)]`,
`sup_{|q| ≤ n^{-1/2+α}} |V_n(β,q) - (1-|β|² t)^{1/2}| ≤ u_n`, `sup_q |V_n(β,q)| ≤ C 2^{4K}`,
with `u_n → 0` deterministic. -/
def ModelInput (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ) (ε : ℝ)
    (A : (n : ℕ) → Disorder n pmax → ℂ → ℂ) (V : ℕ → ℂ → ℝ → ℂ) (C : ℝ) (u : ℕ → ℝ) :
    Prop :=
  Tendsto u atTop (𝓝 0) ∧
  ∀ n : ℕ, 2 ≤ n →
    (∀ G : Disorder n pmax, ∃ ρ : ℝ, (1 - ε / 2) * beta2nd model pmax γ < ρ ∧
        DifferentiableOn ℂ (A n G) (ball 0 ρ)) ∧
    (∀ G : Disorder n pmax, A n G 0 = 1) ∧
    (∀ β : ℂ, Measurable (fun G : Disorder n pmax => A n G β)) ∧
    (∀ β : ℂ, ‖β‖ ≤ (1 - ε / 2) * beta2nd model pmax γ →
      Integrable (fun G => ‖A n G β * partitionFn model n pmax γ G β‖ ^ 2)
        (disorderMeasure n pmax) ∧
      (((∫ G, ‖A n G β * partitionFn model n pmax γ G β‖ ^ 2 ∂(disorderMeasure n pmax)) : ℝ)
          : ℂ) =
        overlapExp model n
          (fun q => Complex.exp (((n : ℝ) * ‖β‖ ^ 2 * xi pmax γ q : ℝ) : ℂ) * V n β q)) ∧
    (∀ β : ℂ, ‖β‖ ≤ (1 - ε / 2) * beta2nd model pmax γ →
      ∀ q : ℝ, |q| ≤ (n : ℝ) ^ (-(1 / 2 : ℝ) + alphaSmall) →
        ‖V n β q -
            ((Real.sqrt (1 - ‖β‖ ^ 2 * iteratedDeriv 2 (xi pmax γ) 0) : ℝ) : ℂ)‖ ≤ u n) ∧
    (∀ β : ℂ, ‖β‖ ≤ (1 - ε / 2) * beta2nd model pmax γ →
      ∀ q ∈ Set.Icc (-1 : ℝ) 1, ‖V n β q‖ ≤ C * 2 ^ (4 * Kn n))

/-- Number of zeros of `f` in the open disk `D(0,r)`, counted with multiplicity
(`finsum` of analytic orders; meaningful when the zero set there is finite). -/
def zeroCount (f : ℂ → ℂ) (r : ℝ) : ℕ :=
  ∑ᶠ z ∈ ball (0 : ℂ) r, analyticOrderNatAt f z

/-! ## Rubric lemma stubs -/

/-- Rubric 1: `β_2nd² ξ''(0) ≤ 1`, hence `1 - |β|² ξ''(0) ≥ 1 - (1-ε/2)²` on `|β| ≤ R`. [OnZerosAndAlgorithms, node_06] -/
theorem threshold_curvature (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ)
    (hpmax : 2 ≤ pmax) (hγ : ∀ p, 0 ≤ γ p)
    (hbdd : BddAbove (admissibleSet model pmax γ)) (hpos : 0 < beta2nd model pmax γ) :
    beta2nd model pmax γ ^ 2 * iteratedDeriv 2 (xi pmax γ) 0 ≤ 1 := by
  sorry

theorem analytic_gap (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ) (ε : ℝ)
    (hpmax : 2 ≤ pmax) (hγ : ∀ p, 0 ≤ γ p)
    (hbdd : BddAbove (admissibleSet model pmax γ)) (hpos : 0 < beta2nd model pmax γ)
    (hε0 : 0 < ε) (hε1 : ε < 1) (β : ℂ)
    (hβ : ‖β‖ ≤ (1 - ε / 2) * beta2nd model pmax γ) :
    1 - (1 - ε / 2) ^ 2 ≤ 1 - ‖β‖ ^ 2 * iteratedDeriv 2 (xi pmax γ) 0 := by
  sorry

/-- Rubric 2: uniform second moment `E_G |X_G(β)|² ≤ 1 + η_n` on `|β| ≤ R`, `η_n → 0`. [OnZerosAndAlgorithms, node_06] -/
theorem uniform_second_moment (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ) (ε : ℝ)
    (hpmax : 2 ≤ pmax) (hγ : ∀ p, 0 ≤ γ p)
    (hbdd : BddAbove (admissibleSet model pmax γ)) (hpos : 0 < beta2nd model pmax γ)
    (hε0 : 0 < ε) (hε1 : ε < 1)
    (A : (n : ℕ) → Disorder n pmax → ℂ → ℂ) (V : ℕ → ℂ → ℝ → ℂ) (C : ℝ) (u : ℕ → ℝ)
    (hin : ModelInput model pmax γ ε A V C u) :
    ∃ η : ℕ → ℝ, Tendsto η atTop (𝓝 0) ∧ ∀ n : ℕ, 2 ≤ n → ∀ β : ℂ,
      ‖β‖ ≤ (1 - ε / 2) * beta2nd model pmax γ →
      ∫ G, ‖A n G β * partitionFn model n pmax γ G β‖ ^ 2 ∂(disorderMeasure n pmax)
        ≤ 1 + η n := by
  sorry

/-- Rubric 4 (part 1): `Z_G` is entire for every realisation. [OnZerosAndAlgorithms, node_06] -/
theorem partitionFn_differentiable (model : SpinModel) (n pmax : ℕ) (γ : ℕ → ℝ)
    (G : Disorder n pmax) :
    Differentiable ℂ (partitionFn model n pmax γ G) := by
  sorry

/-- Rubric 4 (part 2): multiplying by an analytic factor can only add zeros:
`N_Z(r) ≤ N_{AZ}(r)` with multiplicities. [OnZerosAndAlgorithms, node_06] -/
theorem zeroCount_le_mul (Afn Zfn : ℂ → ℂ) (ρ r : ℝ) (hr : 0 < r) (hrρ : r < ρ)
    (hA : DifferentiableOn ℂ Afn (ball 0 ρ)) (hZ : Differentiable ℂ Zfn)
    (h0 : Afn 0 * Zfn 0 ≠ 0) :
    zeroCount Zfn r ≤ zeroCount (fun z => Afn z * Zfn z) r := by
  sorry

/-- Rubric 3 (deterministic part): Jensen's formula gives
`N_X(r) log(R/r) ≤ (1/2π) ∫ log |X(R e^{iθ})| dθ` when `X(0) = 1`. [OnZerosAndAlgorithms, node_06] -/
theorem jensen_zeroCount_bound (X : ℂ → ℂ) (ρ r R : ℝ) (hr : 0 < r) (hrR : r < R)
    (hRρ : R < ρ) (hX : DifferentiableOn ℂ X (ball 0 ρ)) (hX0 : X 0 = 1) :
    (zeroCount X r : ℝ) * Real.log (R / r) ≤
      Real.circleAverage (fun z => Real.log ‖X z‖) 0 R := by
  sorry

/-- Rubric 3 (averaged part): `E_G N_X(r) ≤ log(1+η_n) / (2 log(R/r))`. [OnZerosAndAlgorithms, node_06] -/
theorem expected_zeroCount_bound (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ) (ε : ℝ)
    (hpmax : 2 ≤ pmax) (hγ : ∀ p, 0 ≤ γ p)
    (hbdd : BddAbove (admissibleSet model pmax γ)) (hpos : 0 < beta2nd model pmax γ)
    (hε0 : 0 < ε) (hε1 : ε < 1)
    (A : (n : ℕ) → Disorder n pmax → ℂ → ℂ) (V : ℕ → ℂ → ℝ → ℂ) (C : ℝ) (u : ℕ → ℝ)
    (hin : ModelInput model pmax γ ε A V C u) (η : ℕ → ℝ) (n : ℕ) (hn : 2 ≤ n)
    (hη : ∀ β : ℂ, ‖β‖ ≤ (1 - ε / 2) * beta2nd model pmax γ →
      ∫ G, ‖A n G β * partitionFn model n pmax γ G β‖ ^ 2 ∂(disorderMeasure n pmax)
        ≤ 1 + η n) :
    ∫ G, (zeroCount (fun z => A n G z * partitionFn model n pmax γ G z)
        ((1 - ε) * beta2nd model pmax γ) : ℝ) ∂(disorderMeasure n pmax) ≤
      Real.log (1 + η n) / (2 * Real.log ((1 - ε / 2) / (1 - ε))) := by
  sorry

/-! ## Main theorem -/

/-- Rubric 5 / main statement: there is a deterministic `δ(ε,n) → 0` such that with probability
at least `1 - δ(ε,n)` over `G`, `Z_G(β) ≠ 0` for every `β ∈ D(0, (1-ε) β_2nd)`. [OnZerosAndAlgorithms, node_06] -/
theorem zeroFree_whp (model : SpinModel) (pmax : ℕ) (γ : ℕ → ℝ) (ε : ℝ)
    (hpmax : 2 ≤ pmax) (hγ : ∀ p, 0 ≤ γ p)
    (hbdd : BddAbove (admissibleSet model pmax γ)) (hpos : 0 < beta2nd model pmax γ)
    (hε0 : 0 < ε) (hε1 : ε < 1)
    (A : (n : ℕ) → Disorder n pmax → ℂ → ℂ) (V : ℕ → ℂ → ℝ → ℂ) (C : ℝ) (u : ℕ → ℝ)
    (hin : ModelInput model pmax γ ε A V C u) :
    ∃ δ : ℕ → ℝ, Tendsto δ atTop (𝓝 0) ∧ ∀ n : ℕ, 2 ≤ n →
      1 - δ n ≤ (disorderMeasure n pmax
        {G | ∀ β ∈ ball (0 : ℂ) ((1 - ε) * beta2nd model pmax γ),
          partitionFn model n pmax γ G β ≠ 0}).toReal := by
  sorry

end TCSChallenge.OnZerosAndAlgorithms.node_06
