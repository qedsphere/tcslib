/-!
## OMv-hardness of approximate online projection: the reduction core

The paper reduces online Boolean matrix–vector multiplication (OMv) to answering online
queries `z ↦ y ≈ H z` with `‖y − Hz‖ ≤ (1/3)‖Hz‖ + β(d)`, with `H` an orthogonal projection.
The reduction:

1. encodes `B ∈ {0,1}^{n×n}` in `M = (1/3)[[2I, B/n],[Bᵀ/n, 2I]]` (eigenvalues in `[1/3,1]`)
   and the query `v` as the unit vector `q = (0, v/‖v‖)`, so that `3n‖v‖·(Mq)_{inl}` is the
   integer vector `Bv`;
2. writes `M ≈ ∑_{j<s} 2^{-(j+1)} P_j` with orthogonal projections `P_j` (binary expansion of
   the eigenvalues), `s = ⌈2 log₂ m⌉`, `m = 2n`;
3. boosts the constant-relative-error oracles for `P` and `Q = I − P` to additive accuracy
   `O(log m / m³)` with an explicit iterative refinement procedure (`refineSeq`);
4. recombines and rounds.

The main theorem `omv_reduction_recovers_boolean_product` states that, for all sufficiently
large `n`, the output of the reduction recovers the Boolean product exactly, for every
family of oracles meeting the pointwise guarantee.
-/

namespace TCSChallenge.TheComplexityOfDynamicLeastSquaresRegression.node_18

/-! ## Approximate oracles and the refinement procedure (abstract inner product space) -/

/-- "an orthogonal projection, namely a matrix satisfying `Hᵀ = H` and `H² = H`". -/
def IsOrthProj {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (P : E →ₗ[ℝ] E) : Prop :=
  P.IsSymmetric ∧ P ∘ₗ P = P

/-- Inequality (2): `‖O_F(x) − F x‖ ≤ (1/3)‖F x‖ + b‖x‖` for every `x` (pointwise; `O` need
not be linear). -/
def ApproxOracleFor {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (F : E →ₗ[ℝ] E) (b : ℝ) (O : E → E) : Prop :=
  ∀ x : E, ‖O x - F x‖ ≤ (1 / 3) * ‖F x‖ + b * ‖x‖

/-- Simulation of a general query from unit-vector queries:
"If `x = 0`, return zero. Otherwise ... query `x/‖x‖` ... and multiply it by `‖x‖`." -/
def normalizedOracle {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (A : E → E) (x : E) : E :=
  if x = 0 then 0 else ‖x‖ • A (‖x‖⁻¹ • x)

/-- Inner loop of one refinement round `r` on input `x`:
"`w₀ = O_Q(x)`; for `k = 1,…,K`: `y_k = O_P(w_{k−1})`, `w_k = w_{k−1} − y_k`."
The oracle answers are indexed by the call position (`r`, `k`). -/
def innerW {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (OP : ℕ → ℕ → E → E) (OQ : ℕ → E → E) (r : ℕ) (x : E) : ℕ → E
  | 0 => OQ r x
  | k + 1 => innerW OP OQ r x k - OP r (k + 1) (innerW OP OQ r x k)

/-- The errors `δ₀ = Qx − w₀` and `δ_k = y_k − P w_{k−1}` of the inner loop. -/
def innerDelta {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (P : E →ₗ[ℝ] E) (OP : ℕ → ℕ → E → E) (OQ : ℕ → E → E) (r : ℕ) (x : E) : ℕ → E
  | 0 => ((LinearMap.id : E →ₗ[ℝ] E) - P) x - innerW OP OQ r x 0
  | k + 1 => OP r (k + 1) (innerW OP OQ r x k) - P (innerW OP OQ r x k)

/-- One round: "`x_{r+1} = x − w_K`". -/
def roundStep {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (OP : ℕ → ℕ → E → E) (OQ : ℕ → E → E) (K r : ℕ) (x : E) : E :=
  x - innerW OP OQ r x K

/-- The sequence of round inputs: `refineSeq 0 = q` (the paper's `x₁`), and the procedure
returns `refineSeq R` (the paper's `x_{R+1}`). -/
def refineSeq {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (OP : ℕ → ℕ → E → E) (OQ : ℕ → E → E) (K : ℕ) (q : E) : ℕ → E
  | 0 => q
  | r + 1 => roundStep OP OQ K r (refineSeq OP OQ K q r)

/-- `K = ⌈3 log₃ m⌉`. -/
def innerSteps (m : ℕ) : ℕ := ⌈3 * Real.logb 3 (m : ℝ)⌉₊

/-- `R = ⌈3 log₂ m⌉`. -/
def outerRounds (m : ℕ) : ℕ := ⌈3 * Real.logb 2 (m : ℝ)⌉₊

/-- Additive error parameter `b = (C+1) m^{-3}`. -/
def addErr (C : ℝ) (m : ℕ) : ℝ := (C + 1) / (m : ℝ) ^ 3

/-! ## Rubric item 5: normalisation (unit-vector queries suffice) -/

/-- If `A` meets the guarantee `‖A z − F z‖ ≤ (1/3)‖F z‖ + β` on unit vectors, then the
normalised simulation meets inequality (2) with `b = β` for every `x`. [TheComplexityOfDynamic, node_18] -/
theorem normalized_oracle_spec {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (F : E →ₗ[ℝ] E) (β : ℝ) (A : E → E)
    (hA : ∀ z : E, ‖z‖ = 1 → ‖A z - F z‖ ≤ (1 / 3) * ‖F z‖ + β) :
    ApproxOracleFor F β (normalizedOracle A) := by
  sorry

/-! ## Rubric items 3–4: the refinement invariant and its consequences -/

/-- Rubric item 3, invariants (3) and (4): for an input with `‖x‖ ≤ 2` and `a = ‖Qx‖`, for all
`k ≤ K`, `w_k = Qx − ∑_{ℓ<k} Qδ_ℓ − δ_k` and `‖δ_k‖ ≤ 3^{−(k+1)} a + 6b`. The smallness
hypothesis `6(K+1)b ≤ 1` replaces "for sufficiently large m". [TheComplexityOfDynamic, node_18] -/
theorem inner_loop_invariant {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (P : E →ₗ[ℝ] E) (hP : IsOrthProj P) (b : ℝ) (hb : 0 ≤ b) (K : ℕ)
    (hKb : 6 * ((K : ℝ) + 1) * b ≤ 1)
    (OP : ℕ → ℕ → E → E) (OQ : ℕ → E → E)
    (hOP : ∀ r k, ApproxOracleFor P b (OP r k))
    (hOQ : ∀ r, ApproxOracleFor (LinearMap.id - P) b (OQ r))
    (r : ℕ) (x : E) (hx : ‖x‖ ≤ 2) :
    ∀ k : ℕ, k ≤ K →
      innerW OP OQ r x k =
          ((LinearMap.id : E →ₗ[ℝ] E) - P) x
            - ∑ l ∈ Finset.range k, ((LinearMap.id : E →ₗ[ℝ] E) - P) (innerDelta P OP OQ r x l)
            - innerDelta P OP OQ r x k ∧
        ‖innerDelta P OP OQ r x k‖ ≤
          ((1 : ℝ) / 3) ^ (k + 1) * ‖((LinearMap.id : E →ₗ[ℝ] E) - P) x‖ + 6 * b := by
  sorry

/-- Rubric item 4, one round, (6) and (7): the `P` component moves by at most
`3^{−(K+1)} a + 6b` and the `Q` component shrinks to at most `a/2 + 6(K+1)b`. [TheComplexityOfDynamic, node_18] -/
theorem one_round_progress {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (P : E →ₗ[ℝ] E) (hP : IsOrthProj P) (b : ℝ) (hb : 0 ≤ b) (K : ℕ)
    (hKb : 6 * ((K : ℝ) + 1) * b ≤ 1)
    (OP : ℕ → ℕ → E → E) (OQ : ℕ → E → E)
    (hOP : ∀ r k, ApproxOracleFor P b (OP r k))
    (hOQ : ∀ r, ApproxOracleFor (LinearMap.id - P) b (OQ r))
    (r : ℕ) (x : E) (hx : ‖x‖ ≤ 2) :
    ‖P (roundStep OP OQ K r x) - P x‖ ≤
        ((1 : ℝ) / 3) ^ (K + 1) * ‖((LinearMap.id : E →ₗ[ℝ] E) - P) x‖ + 6 * b ∧
      ‖((LinearMap.id : E →ₗ[ℝ] E) - P) (roundStep OP OQ K r x)‖ ≤
        ‖((LinearMap.id : E →ₗ[ℝ] E) - P) x‖ / 2 + 6 * ((K : ℝ) + 1) * b := by
  sorry

/-- Rubric item 4, bounded norms: `‖x_r‖ ≤ 2` for every round `r ≤ R`, for large `m`. [TheComplexityOfDynamic, node_18] -/
theorem refine_norm_bounded (C : ℝ) (hC : 0 ≤ C) :
    ∃ m0 : ℕ, ∀ m : ℕ, m0 ≤ m →
      ∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
        (P : E →ₗ[ℝ] E), IsOrthProj P →
      ∀ (OP : ℕ → ℕ → E → E) (OQ : ℕ → E → E),
        (∀ r k, ApproxOracleFor P (addErr C m) (OP r k)) →
        (∀ r, ApproxOracleFor (LinearMap.id - P) (addErr C m) (OQ r)) →
      ∀ q : E, ‖q‖ = 1 →
      ∀ r : ℕ, r ≤ outerRounds m →
        ‖refineSeq OP OQ (innerSteps m) q r‖ ≤ 2 := by
  sorry

/-- Rubric items 3–4, accuracy (8): the refinement output satisfies
`‖x_{R+1} − Pq‖ ≤ m^{−3} + 8Rb + 12(K+1)b` for all sufficiently large `m`. [TheComplexityOfDynamic, node_18] -/
theorem refine_accuracy (C : ℝ) (hC : 0 ≤ C) :
    ∃ m0 : ℕ, ∀ m : ℕ, m0 ≤ m →
      ∀ (E : Type) [NormedAddCommGroup E] [InnerProductSpace ℝ E]
        (P : E →ₗ[ℝ] E), IsOrthProj P →
      ∀ (OP : ℕ → ℕ → E → E) (OQ : ℕ → E → E),
        (∀ r k, ApproxOracleFor P (addErr C m) (OP r k)) →
        (∀ r, ApproxOracleFor (LinearMap.id - P) (addErr C m) (OQ r)) →
      ∀ q : E, ‖q‖ = 1 →
        ‖refineSeq OP OQ (innerSteps m) q (outerRounds m) - P q‖ ≤
          1 / (m : ℝ) ^ 3 + 8 * (outerRounds m : ℝ) * addErr C m
            + 12 * ((innerSteps m : ℝ) + 1) * addErr C m := by
  sorry

/-! ## Rubric items 1–2: the Boolean encoding and the projection decomposition -/

/-- The ambient space `ℝ^{2n}`, coordinates `inl i` (first block) and `inr j` (second). -/
abbrev Vec (n : ℕ) : Type := EuclideanSpace ℝ (Fin n ⊕ Fin n)

/-- "`M = (1/3) [[2I_n, B/n], [Bᵀ/n, 2I_n]]`". -/
def encMatrix (n : ℕ) (B : Fin n → Fin n → Bool) :
    Matrix (Fin n ⊕ Fin n) (Fin n ⊕ Fin n) ℝ :=
  Matrix.of fun a c =>
    match a, c with
    | Sum.inl i, Sum.inl i' => if i = i' then 2 / 3 else 0
    | Sum.inl i, Sum.inr j => (if B i j then (1 : ℝ) else 0) / (3 * (n : ℝ))
    | Sum.inr j, Sum.inl i => (if B i j then (1 : ℝ) else 0) / (3 * (n : ℝ))
    | Sum.inr j, Sum.inr j' => if j = j' then 2 / 3 else 0

/-- The linear map `x ↦ M x` on Euclidean space. -/
def encOp (n : ℕ) (B : Fin n → Fin n → Bool) : Vec n →ₗ[ℝ] Vec n :=
  Matrix.toEuclideanLin (encMatrix n B)

/-- `‖v‖₂` of a Boolean vector: the square root of its number of ones. -/
def boolNorm (n : ℕ) (v : Fin n → Bool) : ℝ :=
  Real.sqrt ((Finset.univ.filter (fun j => v j = true)).card : ℝ)

/-- The unit query "`q = (0, v/‖v‖₂)`". -/
def queryVec (n : ℕ) (v : Fin n → Bool) : Vec n :=
  WithLp.toLp 2 (fun a : Fin n ⊕ Fin n =>
    match a with
    | Sum.inl _ => 0
    | Sum.inr j => (if v j then (1 : ℝ) else 0) / boolNorm n v)

/-- The Boolean product: "the ith coordinate is 1 iff `B_{ij} = v_j = 1` for some `j`". -/
def boolProduct (n : ℕ) (B : Fin n → Fin n → Bool) (v : Fin n → Bool) (i : Fin n) : Prop :=
  ∃ j : Fin n, B i j = true ∧ v j = true

/-- Decoding: round `3n‖v‖₂ · h_{inl i}` to the nearest integer and test positivity. -/
def decode (n : ℕ) (v : Fin n → Bool) (h : Vec n) (i : Fin n) : Prop :=
  0 < round (3 * (n : ℝ) * boolNorm n v * WithLp.ofLp h (Sum.inl i))

/-- Number of projections `s = ⌈2 log₂ m⌉`, `m = 2n`. -/
def numProj (n : ℕ) : ℕ := ⌈2 * Real.logb 2 ((2 * n : ℕ) : ℝ)⌉₊

/-- Decomposition (1): `‖(M − ∑_{j<s} 2^{−(j+1)} P_j) x‖ ≤ 2^{−s}‖x‖` for every `x`. -/
def IsProjDecomposition (n : ℕ) (B : Fin n → Fin n → Bool) (s : ℕ)
    (P : Fin s → (Vec n →ₗ[ℝ] Vec n)) : Prop :=
  (∀ j, IsOrthProj (P j)) ∧
    ∀ x : Vec n,
      ‖encOp n B x - ∑ j : Fin s, ((1 : ℝ) / 2) ^ (j.val + 1) • P j x‖ ≤
        ((1 : ℝ) / 2) ^ s * ‖x‖

/-- Rubric item 1, encoding accuracy: an approximation `h` of `Mq` with additive error
`c/m²` decodes to the Boolean product, for all sufficiently large `n`. [TheComplexityOfDynamic, node_18] -/
theorem encoding_decodes (c : ℝ) (hc : 0 ≤ c) :
    ∃ n0 : ℕ, ∀ n : ℕ, n0 ≤ n →
      ∀ (B : Fin n → Fin n → Bool) (v : Fin n → Bool), (∃ j, v j = true) →
      ∀ h : Vec n, ‖h - encOp n B (queryVec n v)‖ ≤ c / ((2 * n : ℕ) : ℝ) ^ 2 →
        ∀ i : Fin n, (decode n v h i ↔ boolProduct n B v i) := by
  sorry

/-- The query vector is a unit vector. [TheComplexityOfDynamic, node_18] -/
theorem queryVec_norm (n : ℕ) (v : Fin n → Bool) (hv : ∃ j, v j = true) :
    ‖queryVec n v‖ = 1 := by
  sorry

/-- Rubric item 2: the binary-expansion decomposition into `s = ⌈2 log₂ m⌉` orthogonal
projections exists. [TheComplexityOfDynamic, node_18] -/
theorem proj_decomposition_exists (n : ℕ) (hn : 1 ≤ n) (B : Fin n → Fin n → Bool) :
    ∃ P : Fin (numProj n) → (Vec n →ₗ[ℝ] Vec n), IsProjDecomposition n B (numProj n) P := by
  sorry

/-! ## Main theorem (rubric item 6, correctness core) -/

/-- **Reduction correctness.** For every `C ≥ 0` and all sufficiently large `n`: for every
`B`, every nonzero Boolean query `v`, every projection decomposition (1) of `M`, and every
family of (call-indexed, possibly adaptive and nonlinear) approximate oracles for `P_j` and
`I − P_j` meeting inequality (2) with `b = (C+1)m^{−3}`, `m = 2n`, the vector
`h = ∑_j 2^{−(j+1)} h_j`, with `h_j` the output of the refinement procedure for `P_j` on `q`,
decodes to the exact Boolean product `Bv`. [TheComplexityOfDynamic, node_18] -/
theorem omv_reduction_recovers_boolean_product (C : ℝ) (hC : 0 ≤ C) :
    ∃ n0 : ℕ, ∀ n : ℕ, n0 ≤ n →
      ∀ (B : Fin n → Fin n → Bool) (v : Fin n → Bool), (∃ j, v j = true) →
      ∀ P : Fin (numProj n) → (Vec n →ₗ[ℝ] Vec n),
        IsProjDecomposition n B (numProj n) P →
      ∀ (OP : Fin (numProj n) → ℕ → ℕ → Vec n → Vec n)
        (OQ : Fin (numProj n) → ℕ → Vec n → Vec n),
        (∀ j r k, ApproxOracleFor (P j) (addErr C (2 * n)) (OP j r k)) →
        (∀ j r, ApproxOracleFor (LinearMap.id - P j) (addErr C (2 * n)) (OQ j r)) →
        ∀ i : Fin n,
          (decode n v
              (∑ j : Fin (numProj n), ((1 : ℝ) / 2) ^ (j.val + 1) •
                refineSeq (OP j) (OQ j) (innerSteps (2 * n)) (queryVec n v)
                  (outerRounds (2 * n)))
              i ↔ boolProduct n B v i) := by
  sorry

end TCSChallenge.TheComplexityOfDynamicLeastSquaresRegression.node_18
