open TCSlib.InformationTheory

/-!
## Relaxed local decoders with small soundness error yield ordinary local decoders

Let `C : 𝔽₂^k → 𝔽₂^n` be linear, `C(b)_j = ⟨v_j, b⟩`. A possibly adaptive randomized
`q`-query algorithm is modelled as a finitely supported distribution over depth-`≤ q`
decision trees querying coordinates of the received word.

With `s(q) = 2^{-⌊q/2⌋}`, `δ > 0`, `0 < α ≤ 1`: if `C` has a `(q, δ, 1, s)`-relaxed local
decoder (resp. corrector) with `s ≤ (1 - α) s(q)`, then for every `ε > 0` it has an ordinary
`(q, αδε/q, 1, ε)`-local decoder (resp. corrector).

Main theorems: `rldc_to_ldc` and `rlcc_to_lcc`.
-/

namespace TCSChallenge.RelaxedVsFullLocal.node_08

/-- The linear code `C(b)_j = ⟨v_j, b⟩` over `𝔽₂` given by vectors `v_1, …, v_n ∈ 𝔽₂^k`. -/
def codeword {k n : ℕ} (v : Fin n → Fin k → ZMod 2) (b : Fin k → ZMod 2) : Fin n → ZMod 2 :=
  fun j => dotProduct (v j) b

/-- A deterministic adaptive query algorithm: a binary decision tree whose internal nodes query
a coordinate `j ∈ [n]` of the received word and branch on the answer bit. -/
inductive DTree (n : ℕ) (α : Type) : Type
  | leaf : α → DTree n α
  | query : Fin n → DTree n α → DTree n α → DTree n α

/-- Run a decision tree on oracle `y`: at `query j t₀ t₁` go to `t₀` if `y j = 0`, else `t₁`. -/
def DTree.eval {n : ℕ} {α : Type} : DTree n α → (Fin n → ZMod 2) → α
  | .leaf a, _ => a
  | .query j t0 t1, y => if y j = 0 then t0.eval y else t1.eval y

/-- Number of queries along the longest root-to-leaf path. -/
def DTree.depth {n : ℕ} {α : Type} : DTree n α → ℕ
  | .leaf _ => 0
  | .query _ t0 t1 => max t0.depth t1.depth + 1

/-- A "possibly adaptive randomized algorithm": seeds `ω ∈ Fin r` drawn from the distribution
`μ`, the algorithm running the decision tree `t ω` on seed `ω`. -/
structure RandTree (n : ℕ) (α : Type) where
  r : ℕ
  μ : FinDist (Fin r)
  t : Fin r → DTree n α

/-- "It makes at most `q` queries" (on every seed and every oracle). -/
def RandTree.QueryBound {n : ℕ} {α : Type} (D : RandTree n α) (q : ℕ) : Prop :=
  ∀ ω, (D.t ω).depth ≤ q

/-- `Pr[P(Dec^y)]`. -/
def RandTree.prob {n : ℕ} {α : Type} (D : RandTree n α) (y : Fin n → ZMod 2)
    (P : α → Prop) : ℝ :=
  ∑ ω, if P ((D.t ω).eval y) then D.μ ω else 0

/-- A nonadaptive randomized algorithm whose distribution on queried sets is independent of
the received word: seed `ω` (drawn from `μ`) queries the set `Q ω` and outputs `f ω y`, which
depends only on `y` restricted to `Q ω` (validity in `NARand.IsValid`). -/
structure NARand (n : ℕ) (α : Type) where
  r : ℕ
  μ : FinDist (Fin r)
  Q : Fin r → Finset (Fin n)
  f : Fin r → (Fin n → ZMod 2) → α

/-- Query bound `|Q ω| ≤ q` and locality of `f ω` to `Q ω` (the seed law is `D.μ`). -/
def NARand.IsValid {n : ℕ} {α : Type} (D : NARand n α) (q : ℕ) : Prop :=
  (∀ ω, (D.Q ω).card ≤ q) ∧
    ∀ ω (y y' : Fin n → ZMod 2), (∀ j ∈ D.Q ω, y j = y' j) → D.f ω y = D.f ω y'

/-- `Pr[P(Dec^y)]` for a nonadaptive algorithm. -/
def NARand.prob {n : ℕ} {α : Type} (D : NARand n α) (y : Fin n → ZMod 2)
    (P : α → Prop) : ℝ :=
  ∑ ω, if P (D.f ω y) then D.μ ω else 0

/-- `p_j = Pr_{Q ← 𝒬}[j ∈ Q]`. -/
def NARand.queryProb {n : ℕ} {α : Type} (D : NARand n α) (j : Fin n) : ℝ :=
  ∑ ω, if j ∈ D.Q ω then D.μ ω else 0

/-- The light coordinates `L = {j : p_j ≤ q / (δ n)}` (complement of the heavy set `H`). -/
def NARand.lightSet {n : ℕ} {α : Type} (D : NARand n α) (q : ℕ) (δ : ℝ) : Finset (Fin n) :=
  Finset.univ.filter (fun j => D.queryProb j ≤ (q : ℝ) / (δ * n))

/-- `(q, δ, 1, s)`-relaxed local algorithm for targets `x : T` with desired output `goal x b`
(`goal i b = b_i` for decoders, `goal u b = C(b)_u` for correctors); `none` encodes `⊥`.
Perfect completeness: `Pr[Dec^{C(b)}(x) = goal x b] = 1`; relaxed soundness: whenever
`Δ(y, C(b)) ≤ δ n`, `Pr[Dec^y(x) ∉ {goal x b, ⊥}] ≤ s`. -/
def IsRelaxedLocal {k n : ℕ} (v : Fin n → Fin k → ZMod 2) {T : Type}
    (goal : T → (Fin k → ZMod 2) → ZMod 2) (q : ℕ) (δ s : ℝ)
    (Dec : T → RandTree n (Option (ZMod 2))) : Prop :=
  ∀ x, (Dec x).QueryBound q ∧
    (∀ b, (Dec x).prob (codeword v b) (fun o => o = some (goal x b)) = 1) ∧
    ∀ (b : Fin k → ZMod 2) (y : Fin n → ZMod 2),
      (hammingDist y (codeword v b) : ℝ) ≤ δ * n →
        (Dec x).prob y (fun o => o ≠ some (goal x b) ∧ o ≠ none) ≤ s

/-- The same notion for nonadaptive algorithms with word-independent query distribution. -/
def IsNARelaxedLocal {k n : ℕ} (v : Fin n → Fin k → ZMod 2) {T : Type}
    (goal : T → (Fin k → ZMod 2) → ZMod 2) (q : ℕ) (δ s : ℝ)
    (Dec : T → NARand n (Option (ZMod 2))) : Prop :=
  ∀ x, (Dec x).IsValid q ∧
    (∀ b, (Dec x).prob (codeword v b) (fun o => o = some (goal x b)) = 1) ∧
    ∀ (b : Fin k → ZMod 2) (y : Fin n → ZMod 2),
      (hammingDist y (codeword v b) : ℝ) ≤ δ * n →
        (Dec x).prob y (fun o => o ≠ some (goal x b) ∧ o ≠ none) ≤ s

/-- Ordinary `(q, δ, 1, s)`-local algorithm: always outputs a bit, perfect completeness, and
`Pr[Dec^y(x) ≠ goal x b] ≤ s` whenever `Δ(y, C(b)) ≤ δ n`. -/
def IsOrdinaryLocal {k n : ℕ} (v : Fin n → Fin k → ZMod 2) {T : Type}
    (goal : T → (Fin k → ZMod 2) → ZMod 2) (q : ℕ) (δ s : ℝ)
    (Dec : T → RandTree n (ZMod 2)) : Prop :=
  ∀ x, (Dec x).QueryBound q ∧
    (∀ b, (Dec x).prob (codeword v b) (fun o => o = goal x b) = 1) ∧
    ∀ (b : Fin k → ZMod 2) (y : Fin n → ZMod 2),
      (hammingDist y (codeword v b) : ℝ) ≤ δ * n →
        (Dec x).prob y (fun o => o ≠ goal x b) ≤ s

/-- Decoder target: `b ↦ b_i`. -/
def decGoal {k : ℕ} : Fin k → (Fin k → ZMod 2) → ZMod 2 := fun i b => b i

/-- Corrector target: `b ↦ C(b)_u`. -/
def corrGoal {k n : ℕ} (v : Fin n → Fin k → ZMod 2) : Fin n → (Fin k → ZMod 2) → ZMod 2 :=
  fun u b => codeword v b u

/-- The permitted normalization fact (used without proof): for the linear code `C`, a
perfectly complete relaxed local algorithm may be replaced, with the same query bound, radius
and relaxed soundness error, by a nonadaptive one whose query-set distribution is independent
of the received word. -/
def NormalizationFact {k n : ℕ} (v : Fin n → Fin k → ZMod 2) {T : Type}
    (goal : T → (Fin k → ZMod 2) → ZMod 2) : Prop :=
  ∀ (q : ℕ) (δ s : ℝ) (Dec : T → RandTree n (Option (ZMod 2))),
    IsRelaxedLocal v goal q δ s Dec → ∃ NDec, IsNARelaxedLocal v goal q δ s NDec

/-- `s(q) = 2^{-⌊q/2⌋}` (natural-number division is the floor). -/
def sq (q : ℕ) : ℝ := (1 / 2 : ℝ) ^ (q / 2)

/-! ## Rubric lemmas -/

/-- (Rubric 1) Under perfect completeness for the target functional `b ↦ ⟨φ, b⟩`, every
query set in the support determines the target: `φ ∈ span {v_j : j ∈ Q}`. [RelaxedVsFullLocal, node_08] -/
theorem target_in_span_of_complete {k n : ℕ} (v : Fin n → Fin k → ZMod 2) (q : ℕ)
    (φ : Fin k → ZMod 2) (D : NARand n (Option (ZMod 2))) (hD : D.IsValid q)
    (hcompl : ∀ b, D.prob (codeword v b) (fun o => o = some (dotProduct φ b)) = 1)
    (ω : Fin D.r) (hω : 0 < D.μ ω) :
    φ ∈ Submodule.span (ZMod 2) (v '' (↑(D.Q ω) : Set (Fin n))) := by
  sorry

/-- (Rubric 2) The heavy set `H = {j : p_j > q/(δn)}` has at most `δ n` elements. [RelaxedVsFullLocal, node_08] -/
theorem heavy_card_le {n : ℕ} {α : Type} (q : ℕ) (δ : ℝ) (hδ : 0 < δ) (D : NARand n α)
    (hD : D.IsValid q) :
    ((Finset.univ.filter (fun j => (q : ℝ) / (δ * n) < D.queryProb j)).card : ℝ) ≤ δ * n := by
  sorry

/-- (Rubric 3) Sharp fooling estimate (1): for disjoint `H, L` and `φ ∉ span {v_j : j ∈ L}`,
a uniform `b'` with `⟨φ,b'⟩ = 1` admits, with probability `≥ 2^{-min(|H|,|L|)}`, some `b''`
with `⟨φ,b''⟩ = 1`, `A_L b'' = 0` and `A_H b'' = A_H b'`. Stated by counting. [RelaxedVsFullLocal, node_08] -/
theorem fooling_estimate {k n : ℕ} (v : Fin n → Fin k → ZMod 2) (φ : Fin k → ZMod 2)
    (H L : Finset (Fin n)) (hHL : Disjoint H L)
    (hφ : φ ∉ Submodule.span (ZMod 2) (v '' (↑L : Set (Fin n)))) :
    (1 / 2 : ℝ) ^ (min H.card L.card) *
        ((Finset.univ.filter (fun b' : Fin k → ZMod 2 => dotProduct φ b' = 1)).card : ℝ) ≤
      ((Finset.univ.filter (fun b' : Fin k → ZMod 2 => dotProduct φ b' = 1 ∧
          ∃ b'' : Fin k → ZMod 2, dotProduct φ b'' = 1 ∧
            (∀ j ∈ L, dotProduct (v j) b'' = 0) ∧
            (∀ j ∈ H, dotProduct (v j) b'' = dotProduct (v j) b'))).card : ℝ) := by
  sorry

/-- (Rubric 4) Good-set mass: for a nonadaptive perfectly complete relaxed algorithm for
the target `b ↦ ⟨φ, b⟩` with soundness `s ≤ (1-α) s(q)` at radius `δ`, the query sets `Q`
with `φ ∈ span {v_j : j ∈ Q ∩ L}` have total probability at least `α`. [RelaxedVsFullLocal, node_08] -/
theorem good_mass_ge {k n : ℕ} (v : Fin n → Fin k → ZMod 2) (q : ℕ) (hq : 1 ≤ q)
    (δ α s : ℝ) (hδ : 0 < δ) (hα0 : 0 < α) (hα1 : α ≤ 1) (hs : s ≤ (1 - α) * sq q)
    (φ : Fin k → ZMod 2) (D : NARand n (Option (ZMod 2))) (hD : D.IsValid q)
    (hcompl : ∀ b, D.prob (codeword v b) (fun o => o = some (dotProduct φ b)) = 1)
    (hsound : ∀ (b : Fin k → ZMod 2) (y : Fin n → ZMod 2),
      (hammingDist y (codeword v b) : ℝ) ≤ δ * n →
        D.prob y (fun o => o ≠ some (dotProduct φ b) ∧ o ≠ none) ≤ s) :
    α ≤ ∑ ω, if φ ∈ Submodule.span (ZMod 2)
        (v '' (↑(D.Q ω ∩ D.lightSet q δ) : Set (Fin n))) then D.μ ω else 0 := by
  sorry

/-- (Rubric 5) Ordinary algorithm construction: if good sets have mass `≥ α`, conditioning on
them and outputting `∑ λ_j y_j` gives a perfectly complete bit-valued algorithm for
`b ↦ ⟨φ, b⟩` with at most `q` queries and error `≤ ε` up to radius `αδε/q`. [RelaxedVsFullLocal, node_08] -/
theorem ordinary_of_good_mass {k n : ℕ} (v : Fin n → Fin k → ZMod 2) (q : ℕ) (hq : 1 ≤ q)
    (δ α ε : ℝ) (hδ : 0 < δ) (hα0 : 0 < α) (hε : 0 < ε)
    (φ : Fin k → ZMod 2) (D : NARand n (Option (ZMod 2))) (hD : D.IsValid q)
    (hgood : α ≤ ∑ ω, if φ ∈ Submodule.span (ZMod 2)
        (v '' (↑(D.Q ω ∩ D.lightSet q δ) : Set (Fin n))) then D.μ ω else 0) :
    ∃ D' : RandTree n (ZMod 2),
      IsOrdinaryLocal v (fun (_ : Unit) b => dotProduct φ b) q (α * δ * ε / q) ε
        (fun _ => D') := by
  sorry

/-! ## Main theorems -/

/-- RLDC ⇒ LDC: a possibly adaptive `(q, δ, 1, s)`-relaxed local decoder with
`s ≤ (1-α) s(q)` yields, for every `ε > 0`, an ordinary `(q, αδε/q, 1, ε)`-local decoder. [RelaxedVsFullLocal, node_08] -/
theorem rldc_to_ldc {k n : ℕ} (v : Fin n → Fin k → ZMod 2)
    (hnorm : NormalizationFact v (decGoal (k := k)))
    (q : ℕ) (hq : 1 ≤ q) (δ α s : ℝ) (hδ : 0 < δ) (hα0 : 0 < α) (hα1 : α ≤ 1)
    (hs : s ≤ (1 - α) * sq q)
    (Dec : Fin k → RandTree n (Option (ZMod 2))) (hDec : IsRelaxedLocal v decGoal q δ s Dec)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ Dec' : Fin k → RandTree n (ZMod 2),
      IsOrdinaryLocal v decGoal q (α * δ * ε / q) ε Dec' := by
  sorry

/-- RLCC ⇒ LCC: a possibly adaptive `(q, δ, 1, s)`-relaxed local corrector with
`s ≤ (1-α) s(q)` yields, for every `ε > 0`, an ordinary `(q, αδε/q, 1, ε)`-local corrector. [RelaxedVsFullLocal, node_08] -/
theorem rlcc_to_lcc {k n : ℕ} (v : Fin n → Fin k → ZMod 2)
    (hnorm : NormalizationFact v (corrGoal v))
    (q : ℕ) (hq : 1 ≤ q) (δ α s : ℝ) (hδ : 0 < δ) (hα0 : 0 < α) (hα1 : α ≤ 1)
    (hs : s ≤ (1 - α) * sq q)
    (Dec : Fin n → RandTree n (Option (ZMod 2)))
    (hDec : IsRelaxedLocal v (corrGoal v) q δ s Dec)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ Dec' : Fin n → RandTree n (ZMod 2),
      IsOrdinaryLocal v (corrGoal v) q (α * δ * ε / q) ε Dec' := by
  sorry

end TCSChallenge.RelaxedVsFullLocal.node_08
